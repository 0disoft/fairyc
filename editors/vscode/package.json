{
  "name": "fairyc",
  "displayName": "Fairy C",
  "description": "Fairy C syntax and language tools",
  "version": "0.1.1",
  "publisher": "0disoft",

  "main": "./extension.js",
  "activationEvents": ["onLanguage:fairyc"],
  "capabilities": {"untrustedWorkspaces": {"supported": "limited", "description": "Syntax support works; the language server runs only in a trusted workspace."}},
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/0disoft/fairyc"
  },
  "contributes": {
    "configuration": {
      "title": "Fairy C",
      "properties": {
        "fairyc.server.path": {"type": "string", "default": "fairyc-lsp", "scope": "machine", "description": "Path to the Fairy C language server executable."}
      }
    },
    "languages": [
      {
        "id": "fairyc",
        "aliases": [
          "Fairy C",
          "fairyc"
        ],
        "extensions": [
          ".fy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fairyc",
        "scopeName": "source.fairyc",
        "path": "./syntaxes/fairyc.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "fairyc",
        "path": "./snippets/fairyc.json"
      }
    ]
  },
  "dependencies": {"vscode-languageclient": "^9"},
  "devDependencies": {
    "vscode-textmate": "^9",
    "vscode-oniguruma": "^2"
  }
}
