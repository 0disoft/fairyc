{
  "Module": {
    "prefix": "module",
    "body": [
      "module ${1:main};"
    ],
    "description": "Declare the module matching the source path"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "fn ${1:i32} ${2:main}(${3}) {",
      "  ${0:return 0;}",
      "}"
    ],
    "description": "Declare a Fairy C function (result type precedes name)"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "  $0",
      "}"
    ]
  },
  "Counter loop": {
    "prefix": "for",
    "body": [
      "for (var i32 ${1:i} = 0; ${1:i} < ${2:count}; ${1:i} += 1) {",
      "  $0",
      "}"
    ]
  }
}
