{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:test-list:v2",
  "title": "Fairy C stable workspace test list report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tests", "count", "lock"],
  "properties": {
    "schemaVersion": {
      "const": "fairyc.test-list/v2"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "lock": {
      "enum": ["updated", "unchanged", "verified"]
    }
  }
}
