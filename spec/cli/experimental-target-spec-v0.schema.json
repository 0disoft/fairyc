{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:target-spec:v0",
  "title": "Fairy C target specification v0",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "id": { "const": "x86_64-linux-gnu" },
        "operatingSystem": { "const": "linux" },
        "environment": { "const": "gnu" },
        "dataModel": { "const": "lp64" },
        "callingConvention": { "const": "sysv-amd64" },
        "aggregateLayout": { "const": "sysv-amd64-lp64" },
        "returnClassifier": { "const": "sysv-amd64" },
        "objectFormat": { "const": "elf64" },
        "symbolModel": { "const": "elf" },
        "unwindModel": { "const": "dwarf-cfi" },
        "debugContract": { "const": "generated-c-dwarf" },
        "evidence": {
          "properties": { "emissionSubset": { "const": "scalar-and-flat-i32-resource-tagged-c11" } }
        }
      }
    },
    {
      "properties": {
        "id": { "const": "x86_64-windows-msvc" },
        "operatingSystem": { "const": "windows" },
        "environment": { "const": "msvc" },
        "dataModel": { "const": "llp64" },
        "callingConvention": { "const": "microsoft-x64" },
        "aggregateLayout": { "const": "msvc-x64-llp64" },
        "returnClassifier": { "const": "microsoft-x64" },
        "objectFormat": { "const": "coff-x86-64" },
        "symbolModel": { "const": "coff" },
        "unwindModel": { "const": "windows-x64-pdata-xdata" },
        "debugContract": { "const": "generated-c-codeview-pdb" },
        "evidence": {
          "properties": { "emissionSubset": { "const": "scalar-and-llp64-c-scalar-c11" } }
        }
      }
    }
  ],
  "required": [
    "schemaVersion",
    "id",
    "architecture",
    "operatingSystem",
    "environment",
    "endianness",
    "dataModel",
    "pointer",
    "functionPointer",
    "languageScalars",
    "cScalars",
    "stack",
    "callingConvention",
    "aggregateLayout",
    "returnClassifier",
    "objectFormat",
    "symbolModel",
    "unwindModel",
    "debugContract",
    "reprCFeatures",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": "fairyc.target-spec/v0" },
    "id": { "enum": ["x86_64-linux-gnu", "x86_64-windows-msvc"] },
    "architecture": { "const": "x86_64" },
    "operatingSystem": { "enum": ["linux", "windows"] },
    "environment": { "enum": ["gnu", "msvc"] },
    "endianness": { "const": "little" },
    "dataModel": { "enum": ["lp64", "llp64"] },
    "pointer": { "$ref": "#/$defs/layout" },
    "functionPointer": { "$ref": "#/$defs/layout" },
    "languageScalars": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scalar" }
    },
    "cScalars": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scalar" }
    },
    "stack": { "$ref": "#/$defs/stack" },
    "callingConvention": { "enum": ["sysv-amd64", "microsoft-x64"] },
    "aggregateLayout": { "enum": ["sysv-amd64-lp64", "msvc-x64-llp64"] },
    "returnClassifier": { "enum": ["sysv-amd64", "microsoft-x64"] },
    "objectFormat": { "enum": ["elf64", "coff-x86-64"] },
    "symbolModel": { "enum": ["elf", "coff"] },
    "unwindModel": { "enum": ["dwarf-cfi", "windows-x64-pdata-xdata"] },
    "debugContract": { "enum": ["generated-c-dwarf", "generated-c-codeview-pdb"] },
    "reprCFeatures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": { "$ref": "#/$defs/evidence" }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizeBytes", "alignmentBytes"],
      "properties": {
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "alignmentBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "scalar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "layout", "signedness"],
      "dependentRequired": {
        "header": ["availability"],
        "availability": ["header"]
      },
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "layout": { "$ref": "#/$defs/layout" },
        "signedness": { "enum": ["signed", "unsigned", "not-applicable"] },
        "header": { "type": "string", "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*\\.h$" },
        "availability": { "enum": ["iso-c11", "posix.1-2008"] }
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callAlignmentBytes", "redZoneBytes", "shadowSpaceBytes"],
      "properties": {
        "callAlignmentBytes": { "type": "integer", "minimum": 1 },
        "redZoneBytes": { "type": "integer", "minimum": 0 },
        "shadowSpaceBytes": { "type": "integer", "minimum": 0, "multipleOf": 8 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["emissionSubset", "emittable", "conformant", "supported", "missing"],
      "properties": {
        "emissionSubset": { "enum": ["scalar-and-flat-i32-resource-tagged-c11", "scalar-and-llp64-c-scalar-c11"] },
        "emittable": { "const": false },
        "conformant": { "const": false },
        "supported": { "const": false },
        "missing": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
