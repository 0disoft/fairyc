{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:interpreter-fixtures:v0",
  "title": "Fairy C MIR interpreter fixture manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deferred", "contracts", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "fairyc.interpreter-fixtures/v0" },
    "deferred": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.fy$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "startByte", "endByte"],
      "properties": {
        "source": { "$ref": "#/$defs/sourcePath" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 }
      }
    },
    "dropEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceType", "binding"],
      "properties": {
        "resourceType": { "type": "string", "minLength": 1 },
        "binding": { "$ref": "#/$defs/span" }
      }
    },
    "regionEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["region", "exitKind", "placements", "dropCountBeforeReset"],
      "properties": {
        "region": { "$ref": "#/$defs/span" },
        "exitKind": { "enum": ["fallthrough", "return", "propagate"] },
        "placements": { "type": "integer", "minimum": 0 },
        "dropCountBeforeReset": { "type": "integer", "minimum": 0 }
      }
    },
    "byte": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "testIntrinsic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "kind"],
      "properties": {
        "function": { "$ref": "#/$defs/functionName" },
        "kind": { "enum": ["write-stdout-byte", "write-stderr-byte"] }
      }
    },
    "ioEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream", "byte"],
      "properties": {
        "stream": { "enum": ["stdout", "stderr"] },
        "byte": { "$ref": "#/$defs/byte" }
      }
    },
    "functionName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRoot", "sources", "entry", "expect"],
      "dependentRequired": {
        "testIntrinsics": ["outputLimit"],
        "outputLimit": ["testIntrinsics"]
      },
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pass\\.interpreter\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourcePath" }
        },
        "entry": { "$ref": "#/$defs/functionName" },
        "testIntrinsics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/testIntrinsic" }
        },
        "outputLimit": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "expect": {
          "oneOf": [
            { "$ref": "#/$defs/returnExpectation" },
            { "$ref": "#/$defs/trapExpectation" },
            { "$ref": "#/$defs/limitExpectation" }
          ]
        }
      }
    },
    "returnExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough", "outcome", "value"],
      "properties": {
        "status": { "const": "pass" },
        "completedThrough": { "const": "interpret" },
        "outcome": { "const": "return" },
        "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "drops": {
          "type": "array",
          "items": { "$ref": "#/$defs/dropEvent" }
        },
        "regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/regionEvent" }
        },
        "stdoutBytes": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/byte" }
        },
        "stderrBytes": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/byte" }
        },
        "ioTrace": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/ioEvent" }
        }
      }
    },
    "trapExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough", "outcome", "category"],
      "properties": {
        "status": { "const": "pass" },
        "completedThrough": { "const": "interpret" },
        "outcome": { "const": "trap" },
        "category": {
          "enum": [
            "assertion-failed",
            "bounds",
            "division-by-zero",
            "integer-overflow",
            "invalid-shift",
            "signed-division-overflow",
            "unreachable"
          ]
        }
      }
    },
    "limitExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough", "outcome", "category"],
      "properties": {
        "status": { "const": "pass" },
        "completedThrough": { "const": "interpret" },
        "outcome": { "const": "limit" },
        "category": { "enum": ["step-limit", "output-limit"] },
        "stdoutBytes": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/byte" }
        },
        "stderrBytes": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/byte" }
        },
        "ioTrace": {
          "type": "array",
          "maxItems": 1048576,
          "items": { "$ref": "#/$defs/ioEvent" }
        }
      }
    }
  }
}
