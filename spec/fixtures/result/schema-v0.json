{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:result-fixtures:v0",
  "title": "Fairy C Result fixture manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deferred", "contracts", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "fairyc.result-fixtures/v0" },
    "deferred": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.fy$"
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "startByte", "endByte"],
      "properties": {
        "source": { "$ref": "#/$defs/sourcePath" },
        "startByte": { "type": "integer", "minimum": 0 },
        "endByte": { "type": "integer", "minimum": 0 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRoot", "sources", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^(pass|fail)\\.(type|flow)\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sourceRoot": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sourcePath" }
        },
        "expect": {
          "oneOf": [
            { "$ref": "#/$defs/passExpectation" },
            { "$ref": "#/$defs/failExpectation" }
          ]
        }
      }
    },
    "passExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough", "handling"],
      "properties": {
        "status": { "const": "pass" },
        "completedThrough": { "const": "flow" },
        "handling": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/handlingAssertion" }
        }
      }
    },
    "handlingAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "mode", "resultType", "successType", "errorType", "evaluationCount"],
      "properties": {
        "expression": { "$ref": "#/$defs/span" },
        "mode": { "enum": ["return", "discard", "propagate", "match"] },
        "resultType": { "type": "string", "minLength": 1 },
        "successType": { "type": "string", "minLength": 1 },
        "errorType": { "type": "string", "minLength": 1 },
        "evaluationCount": { "const": 1 }
      }
    },
    "failExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "diagnostics"],
      "properties": {
        "status": { "const": "fail" },
        "phase": { "enum": ["type", "flow"] },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/diagnostic" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "primary", "related"],
      "properties": {
        "code": { "type": "string", "pattern": "^E41[0-9]{2}$" },
        "primary": { "$ref": "#/$defs/span" },
        "related": {
          "type": "array",
          "items": { "$ref": "#/$defs/relatedSpan" }
        }
      }
    },
    "relatedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "span"],
      "properties": {
        "role": { "enum": ["actual-error", "enclosing-return", "expected-error", "result-expression"] },
        "span": { "$ref": "#/$defs/span" }
      }
    }
  }
}
