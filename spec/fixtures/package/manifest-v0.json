          "packageUid": "fixture.app.stdlib",
          "sourceIdentity": "fixture-source:app-stdlib",
          "versionIdentity": "fixture-version:workspace",
          "features": [],
          "sourceRoot": "packages/app/src",
          "sources": ["main.fy"]
        },
        {
          "node": "stdlib",
          "role": "standard-library",
          "packageUid": "fixture.fairyc.std",
          "sourceIdentity": "fixture-source:stdlib-v0",
          "versionIdentity": "fixture-version:stdlib-v0",
          "features": [],
          "sourceRoot": "packages/stdlib/src",
          "sources": ["std/alloc.fy"]
        }
      ],
      "dependencies": [
        { "owner": "app", "binding": "stdlib", "target": "stdlib" }
      ],
      "expect": {
        "status": "pass",
        "instanceClasses": [
          { "label": "app-instance", "members": ["app"] },
          { "label": "stdlib-instance", "members": ["stdlib"] }
        ],
        "lookups": [
          {
            "from": "app",
            "importPath": "std::alloc",
            "providerClass": "stdlib-instance",
            "modulePath": "std::alloc"
          }
        ]
      }
