{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:c-emission-fixtures:v0",
  "title": "Fairy C constrained C emission fixtures v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deferred", "contracts", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "fairyc.c-emission-fixtures/v0" },
    "deferred": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "portablePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$"
    },
    "functionName": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*(?:::[a-z_][a-z0-9_]*)+$"
    },
    "feature": {
      "enum": [
        "array-byte-view-borrow",
        "array-index",
        "array-index-store",
        "array-length",
        "mutable-array-byte-view-borrow",
        "mutable-view-index-store",
        "assert",
        "checked-arithmetic",
        "checked-division",
        "checked-shift",
        "copy-result",
        "flat-copy-resource",
        "flat-i32-resource",
        "inert-enum",
        "inert-struct",
        "non-empty-resource-drop",
        "resource-option",
        "resource-result",
        "scalar-bitwise",
        "scalar-call",
        "scalar-cast",
        "scalar-comparison",
        "scalar-control-flow",
        "scalar-fixed-array",
        "scalar-option",
        "scalar-result",
        "static-byte-string",
        "static-utf8-string",
        "trap",
        "view-empty",
        "view-index",
        "view-length",
        "view-slice"
      ]
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough", "outcome", "target", "dialect", "functions", "features"],
      "properties": {
        "status": { "const": "pass" },
        "completedThrough": { "const": "c-emission" },
        "outcome": { "enum": ["return", "trap"] },
        "value": { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
        "category": {
          "enum": [
            "bounds",
            "integer-overflow",
            "division-by-zero",
            "signed-division-overflow",
            "invalid-shift",
            "assertion-failed",
            "unreachable"
          ]
        },
        "target": { "const": "x86_64-linux-gnu" },
        "dialect": { "const": "c11" },
        "functions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/functionName" }
        },
        "features": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/feature" }
        }
      },
      "oneOf": [
        {
          "properties": { "outcome": { "const": "return" } },
          "required": ["value"],
          "not": { "required": ["category"] }
        },
        {
          "properties": { "outcome": { "const": "trap" } },
          "required": ["category"],
          "not": { "required": ["value"] }
        }
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRoot", "sources", "entry", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^pass\\.c-emission\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceRoot": { "$ref": "#/$defs/portablePath" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/portablePath" }
        },
        "entry": { "$ref": "#/$defs/functionName" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    }
  }
}
