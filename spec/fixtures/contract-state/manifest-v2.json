  "mutations": [
    { "id": "reject-cycle", "case": "cell-read-branch-join", "kind": "cycle", "errorContains": "entry block has a predecessor" },
    { "id": "reject-join-type", "case": "cell-read-branch-join", "kind": "join-type", "errorContains": "edge argument type" },
    { "id": "reject-missing-cost", "case": "map-read-found-branch", "kind": "missing-cost", "errorContains": "explicit canonical cost" },
    { "id": "reject-unknown-value", "case": "cell-read-branch-join", "kind": "unknown-value", "errorContains": "available bool condition" }
