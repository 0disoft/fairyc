{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:contract-state-fixtures:v1",
  "title": "Fairy C contract-state transaction fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "deferred", "contracts", "layout", "limits", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "fairyc.contract-state-fixtures/v1" },
    "deferred": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "contracts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "layout": { "$ref": "#/$defs/layout" },
    "limits": { "$ref": "#/$defs/limits" },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "hex": { "type": "string", "pattern": "^(?:[0-9a-f]{2})*$" },
    "storageKeyHex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operationKind": { "enum": ["cell-delete", "cell-read", "cell-write", "map-delete", "map-read", "map-write"] },
    "exitKind": { "enum": ["commit", "reject", "trap"] },
    "status": { "enum": ["commit", "error", "reject", "trap"] },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "valueTypeID"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["cell", "map"] },
        "keyTypeID": { "type": "string", "minLength": 1 },
        "valueTypeID": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractUID", "fields"],
      "properties": {
        "contractUID": { "type": "string", "minLength": 1 },
        "fields": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/field" } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWrites", "maxWriteBytes", "maxValueBytes", "maxMapKeyBytes"],
      "properties": {
        "maxWrites": { "type": "integer", "minimum": 1 },
        "maxWriteBytes": { "type": "integer", "minimum": 1 },
        "maxValueBytes": { "type": "integer", "minimum": 1 },
        "maxMapKeyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field"],
      "properties": {
        "kind": { "$ref": "#/$defs/operationKind" },
        "field": { "$ref": "#/$defs/id" },
        "keyTypeID": { "type": "string", "minLength": 1 },
        "keyHex": { "$ref": "#/$defs/hex" },
        "valueTypeID": { "type": "string", "minLength": 1 },
        "valueHex": { "$ref": "#/$defs/hex" }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "found", "typeID", "valueHex"],
      "properties": {
        "operation": { "type": "integer", "minimum": 0 },
        "found": { "type": "boolean" },
        "typeID": { "type": "string", "minLength": 1 },
        "valueHex": { "$ref": "#/$defs/hex" }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "valueHex"],
      "properties": {
        "field": { "$ref": "#/$defs/id" },
        "storageKeyHex": { "$ref": "#/$defs/storageKeyHex" },
        "valueHex": { "$ref": "#/$defs/hex" }
      }
    },
    "expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "version", "writes", "reads", "store"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "exit": { "$ref": "#/$defs/exitKind" },
        "trapCategory": { "type": "string", "minLength": 1 },
        "errorContains": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 0 },
        "writes": { "type": "integer", "minimum": 0 },
        "reads": { "type": "array", "items": { "$ref": "#/$defs/read" } },
        "store": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "operations", "exit", "expect"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
        "exit": { "$ref": "#/$defs/exitKind" },
        "trapCategory": { "type": "string", "minLength": 1 },
        "limits": { "$ref": "#/$defs/limits" },
        "expect": { "$ref": "#/$defs/expectation" }
      }
    }
  }
}
