{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairyc.dev/spec/fixtures/contract-state-retry/schema-v0.json",
  "title": "Fairy C contract-state caller-visible retry fixtures v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contracts", "limits", "cases"],
  "properties": {
    "$schema": { "const": "./schema-v0.json" },
    "schemaVersion": { "const": "fairyc.contract-state-retry-fixtures/v0" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWrites", "maxWriteBytes", "maxValueBytes", "maxMapKeyBytes"],
      "properties": {
        "maxWrites": { "type": "integer", "minimum": 1 },
        "maxWriteBytes": { "type": "integer", "minimum": 1 },
        "maxValueBytes": { "type": "integer", "minimum": 1 },
        "maxMapKeyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "maxAttempts", "injectedConflicts", "expect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "maxAttempts": { "type": "integer", "minimum": 1 },
          "injectedConflicts": { "type": "integer", "minimum": 0 },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "attempts", "version", "value"],
            "properties": {
              "status": { "enum": ["commit", "exhausted"] },
              "attempts": { "type": "integer", "minimum": 1 },
              "version": { "type": "integer", "minimum": 0 },
              "value": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
