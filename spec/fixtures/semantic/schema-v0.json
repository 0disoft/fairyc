{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:semantic-fixtures:v0",
  "title": "Fairy C semantic fixture manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contracts", "cases"],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "const": "fairyc.semantic-fixtures/v0"
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceRoot", "sources", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(pass|fail)\\.(resolve|type|flow)\\.[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "sourceRoot": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourcePath"
          }
        },
        "expect": {
          "oneOf": [
            {
              "$ref": "#/$defs/passExpectation"
            },
            {
              "$ref": "#/$defs/failExpectation"
            }
          ]
        }
      }
    },
    "sourcePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_-]+(?:/[A-Za-z0-9_-]+)*\\.fy$"
    },
    "phase": {
      "enum": ["resolve", "type", "flow"]
    },
    "passExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "completedThrough"],
      "properties": {
        "status": {
          "const": "pass"
        },
        "completedThrough": {
          "$ref": "#/$defs/phase"
        },
        "resolutions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resolutionAssertion"
          }
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typeAssertion"
          }
        },
        "borrows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/borrowAssertion"
          }
        }
      }
    },
    "resolutionAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use", "target"],
      "properties": {
        "use": {
          "$ref": "#/$defs/span"
        },
        "target": {
          "$ref": "#/$defs/symbolCoordinate"
        }
      }
    },
    "symbolCoordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module", "name", "kind", "declaration"],
      "properties": {
        "module": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "kind": {
          "enum": ["const", "struct", "resource", "enum", "function", "foreign-function", "parameter", "local"]
        },
        "declaration": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "typeAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "canonicalType"],
      "properties": {
        "expression": {
          "$ref": "#/$defs/span"
        },
        "canonicalType": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "borrowAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["borrow", "kind", "origin", "escapes"],
      "properties": {
        "borrow": {
          "$ref": "#/$defs/span"
        },
        "kind": {
          "enum": ["shared", "mutable"]
        },
        "origin": {
          "type": "string",
          "pattern": "^(Static|Param\\([0-9]+\\)|RegionParam\\([0-9]+\\)|Local\\([A-Za-z_][A-Za-z0-9_]*\\)|RawUnknown)$"
        },
        "lastUse": {
          "$ref": "#/$defs/span"
        },
        "escapes": {
          "type": "boolean"
        }
      }
    },
    "failExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "phase", "diagnostics"],
      "properties": {
        "status": {
          "const": "fail"
        },
        "phase": {
          "$ref": "#/$defs/phase"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "primary", "related"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^E(?:01|10|11|21|31|41|51)[0-9]{2}$"
        },
        "primary": {
          "$ref": "#/$defs/span"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedSpan"
          }
        }
      }
    },
    "relatedSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "span"],
      "properties": {
        "role": {
          "enum": [
            "declaration",
            "previous-declaration",
            "expected-type",
            "actual-type",
            "loan",
            "origin",
            "candidate-origin",
            "conflict",
            "last-use",
            "owner",
            "move",
            "return"
          ]
        },
        "span": {
          "$ref": "#/$defs/span"
        }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "startByte", "endByte"],
      "properties": {
        "source": {
          "$ref": "#/$defs/sourcePath"
        },
        "startByte": {
          "type": "integer",
          "minimum": 0
        },
        "endByte": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
