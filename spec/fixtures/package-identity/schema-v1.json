{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:package-identity-fixtures:v1",
  "title": "Fairy C PackageInstanceId fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contracts", "cases"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "fairyc.package-identity-fixtures/v1" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageUid", "sourceIdentity", "versionIdentity", "features"],
      "properties": {
        "packageUid": { "type": "string" },
        "sourceIdentity": { "type": "string" },
        "versionIdentity": { "type": "string" },
        "features": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "passExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "encodingHex", "instanceId"],
      "properties": {
        "status": { "const": "pass" },
        "encodingHex": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "instanceId": { "type": "string", "pattern": "^fypi1-sha256-[0-9a-f]{64}$" }
      }
    },
    "rejectExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "reject" },
        "reason": {
          "enum": ["empty-component", "invalid-utf8", "empty-feature", "features-not-sorted-unique"]
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "identity", "expect"],
      "properties": {
        "id": { "type": "string", "pattern": "^(pass|fail)\\.identity\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "identity": { "$ref": "#/$defs/identity" },
        "expect": {
          "oneOf": [
            { "$ref": "#/$defs/passExpectation" },
            { "$ref": "#/$defs/rejectExpectation" }
          ]
        }
      }
    }
  }
}
