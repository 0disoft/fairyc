{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairyc.dev/spec/fixtures/contract-state-layout/schema-v0.json",
  "title": "Fairy C contract-state layout publication fixtures v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "contracts",
    "limits",
    "baseLayout",
    "seed",
    "pending",
    "cases"
  ],
  "properties": {
    "$schema": { "const": "./schema-v0.json" },
    "schemaVersion": { "const": "fairyc.contract-state-layout-fixtures/v0" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": { "$ref": "#/$defs/limits" },
    "baseLayout": { "$ref": "#/$defs/layout" },
    "seed": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/write" }
    },
    "pending": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/write" }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "candidate", "expect"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "candidate": { "$ref": "#/$defs/layout" },
          "expect": { "enum": ["accepted", "rejected"] }
        }
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxWrites", "maxWriteBytes", "maxValueBytes", "maxMapKeyBytes"],
      "properties": {
        "maxWrites": { "type": "integer", "minimum": 1 },
        "maxWriteBytes": { "type": "integer", "minimum": 1 },
        "maxValueBytes": { "type": "integer", "minimum": 1 },
        "maxMapKeyBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contractUID", "fields"],
      "properties": {
        "contractUID": { "type": "string", "minLength": 1 },
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "valueTypeID"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["cell", "map"] },
        "keyTypeID": { "type": "string", "minLength": 1 },
        "valueTypeID": { "type": "string", "minLength": 1 }
      }
    },
    "write": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "valueHex"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "keyHex": { "type": "string", "pattern": "^[0-9a-f]*$" },
        "valueHex": { "type": "string", "minLength": 2, "pattern": "^(?:[0-9a-f]{2})+$" }
      }
    }
  }
}
