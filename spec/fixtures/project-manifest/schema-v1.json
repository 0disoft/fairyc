{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fairyc:project-manifest-fixtures:v1",
  "title": "Fairy C project manifest fixture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contracts", "cases"],
  "properties": {
    "$schema": { "const": "./schema-v1.json" },
    "schemaVersion": { "const": "fairyc.project-manifest-fixtures/v1" },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "expect"],
        "properties": {
          "id": { "type": "string", "pattern": "^(pass|reject)-[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "file": { "type": "string", "pattern": "^cases/(?:pass|reject)-[a-z0-9-]+/fairy\\.toml$" },
          "expect": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "enum": ["pass", "reject"] },
              "reason": { "type": "string", "minLength": 1 },
              "field": { "type": "string", "minLength": 1 },
              "packageUid": { "type": "string", "minLength": 1 },
              "members": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
