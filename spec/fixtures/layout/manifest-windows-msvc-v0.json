      "type": {
        "kind": "struct",
        "name": "WindowsRecord",
        "fields": [
          { "name": "marker", "type": { "kind": "language-scalar", "name": "u8" } },
          { "name": "count", "type": { "kind": "c-scalar", "name": "c.long" } },
          { "name": "data", "type": { "kind": "pointer" } },
          { "name": "length", "type": { "kind": "c-scalar", "name": "c.size_t" } },
