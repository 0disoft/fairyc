          "sizeBytes": 32,
          "alignmentBytes": 8,
          "fields": [
            { "name": "marker", "offsetBytes": 0, "sizeBytes": 1, "alignmentBytes": 1 },
            { "name": "count", "offsetBytes": 4, "sizeBytes": 4, "alignmentBytes": 4 },
            { "name": "data", "offsetBytes": 8, "sizeBytes": 8, "alignmentBytes": 8 },
            { "name": "length", "offsetBytes": 16, "sizeBytes": 8, "alignmentBytes": 8 },
            { "name": "tail", "offsetBytes": 24, "sizeBytes": 4, "alignmentBytes": 4 }
          ],
          "padding": [
            { "offsetBytes": 1, "sizeBytes": 3 },
            { "offsetBytes": 28, "sizeBytes": 4 }
