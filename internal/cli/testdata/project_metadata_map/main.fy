module main;
import module_project_compile as compile;
import module_signatures as signatures;
import module_types as descriptors;
import syntax as syntax;
import scanner as scanner;
import sha256 as sha;
import std::io as io;

fn clean::Problem baseline_layout(ref ir::Program input,ref types::Plan graph,usize unit,usize index,usize map_start,ref mut v::Vec<ir::Layout> layouts,ref mut v::Vec<interfaces::Field> fields,ref mut bytes::Buffer names,ref mut v::Vec<usize> maps,ref mut v::Vec<Choice> choices,ref mut usize work){
    let original=ir::layout_at(input,index);var s=original.value;s.type=types::mapped(graph,unit,s.type);if(s.type==0){return fail(1001,s.module_index);}if(!budget::charge(work,1)){return fail(1002,s.module_index);}let selected=v::at<Choice>(choices,s.type-1).layout;var usize i=0;
    if(selected!=0){let old=*v::at<ir::Layout>(layouts,selected-1);if(!shape(old.value,s) || !bytes::equal(bytes::view(names)[old.name_start..old.name_end],ir::layout_name(input,index))){return fail(1001,s.module_index);}s.field_start=old.value.field_start;}
    else{if(v::len<ir::Layout>(layouts)>=1024 || s.field_count>limits::project_fields()-v::len<interfaces::Field>(fields)){return fail(1002,s.module_index);}s.field_start=v::len<interfaces::Field>(fields);let start=switch(name(names,work,ir::layout_name(input,index))){case .ok(n):{n}case .err(e):{return e;}};if(!v::push<ir::Layout>(layouts,ir::Layout{.value=s,.name_start=start,.name_end=bytes::len(names)}).is_ok){return fail(1003,s.module_index);}let pick=v::at_mut<Choice>(choices,s.type-1);*pick=Choice{.unit,.type=original.value.type,.layout=v::len<ir::Layout>(layouts)};}
    i=0;while(i<s.field_count){if(!budget::charge(work,1)){return fail(1002,s.module_index);}let source=original.value.field_start+i;var f=ir::field_at(input,source);f.type=types::mapped(graph,unit,f.type);if(f.payload_count!=0){f.payload_start=s.field_start+f.payload_start-original.value.field_start;}
        if(selected!=0){let old=*v::at<interfaces::Field>(fields,s.field_start+i);if(!field(old,f) || !bytes::equal(bytes::view(names)[old.name_start..old.name_end],ir::field_name(input,source))){return fail(1001,s.module_index);}}
        else{f.name_start=switch(name(names,work,ir::field_name(input,source))){case .ok(n):{n}case .err(e):{return e;}};f.name_end=bytes::len(names);if(!v::push<interfaces::Field>(fields,f).is_ok){return fail(1003,s.module_index);}}
        let slot=v::at_mut<usize>(maps,map_start+source);if(*slot!=0 && *slot!=s.field_start+i+1){return fail(1001,s.module_index);};*slot=s.field_start+i+1;i+=1;
    }return fail(0,0);
}
fn Result<Plan,clean::Problem> baseline_build(ref v::Vec<ir::Program> inputs,ref named_units::Plan identified_inputs,ref types::Plan graph){var v::Vec<ir::Layout> layouts=v::empty<ir::Layout>();var v::Vec<interfaces::Field> fields=v::empty<interfaces::Field>();var v::Vec<interfaces::Callable> callables=v::empty<interfaces::Callable>();var v::Vec<usize> parameters=v::empty<usize>();var bytes::Buffer names=bytes::empty();var v::Vec<Range> ranges=v::empty<Range>();var v::Vec<usize> maps=v::empty<usize>();var v::Vec<Choice> choices=v::empty<Choice>();var v::Vec<usize> indexes=v::empty<usize>();var usize work=0;if(inputs_view::count(inputs,identified_inputs)!=types::unit_count(graph)){return .err(fail(1001,0));}var usize i=0;
    while(i<8192){if(!budget::charge(ref mut work,1)){return .err(fail(1002,0));}if(!v::push<usize>(ref mut indexes,0).is_ok){return .err(fail(1003,0));}i+=1;}i=0;
    while(i<types::type_count(graph)){if(!v::push<Choice>(ref mut choices,Choice{.unit=0,.type=0,.layout=0}).is_ok){return .err(fail(1003,0));}i+=1;}
    var usize unit=0;while(unit<inputs_view::count(inputs,identified_inputs)){let input=if(named_units::count(identified_inputs)==0){v::at<ir::Program>(inputs,unit)}else{inputs_view::source_at(identified_inputs,unit)};let start=v::len<usize>(ref maps);i=0;while(i<ir::field_count(input)){if(!budget::charge(ref mut work,1)){return .err(fail(1002,0));}if(!v::push<usize>(ref mut maps,0).is_ok){return .err(fail(1003,0));}i+=1;}if(!v::push<Range>(ref mut ranges,Range{.start,.count=ir::field_count(input)}).is_ok){return .err(fail(1003,0));}
        i=0;while(i<ir::layout_count(input)){let e=baseline_layout(input,graph,unit,i,start,ref mut layouts,ref mut fields,ref mut names,ref mut maps,ref mut choices,ref mut work);if(e.code!=0){return .err(e);}i+=1;}i=0;while(i<ir::callable_count(input)){let e=callable(input,graph,unit,i,ref mut callables,ref mut indexes,ref mut parameters,ref mut names,ref mut work);if(e.code!=0){return .err(e);}i+=1;}unit+=1;
    }return .ok(Plan{.layouts,.fields,.callables,.parameters,.names,.ranges,.maps,.choices,.work});
}
struct Stamp {u32[8] digest;}
fn void text(ref mut bytes::Buffer raw,ref u8[] part){assert(bytes::append(raw,part).is_ok);}
fn void number(ref mut bytes::Buffer raw,usize n){assert(bytes::append_usize(raw,n).is_ok);}
fn syntax::Parsed parsed(bytes::Buffer raw){let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(bytes::empty());}};return switch(syntax::parse(tokens,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(bytes::empty())}};}
fn clean::Problem classic_store(ref mut v::Vec<usize> maps,usize start,usize source,usize target){let ref mut usize slot=v::at_mut<usize>(maps,start+source);if(*slot!=0 && *slot!=target){return fail(1001,7);};*slot=target;return fail(0,0);}
fn void same_error(clean::Problem a,clean::Problem b){assert(a.code==b.code && a.module_index==b.module_index && a.start==b.start && a.end==b.end);}
@effects(console) fn void map_case(usize count,u32 mode){
 var v::Vec<usize> old=v::empty<usize>();var v::Vec<usize> current=v::empty<usize>();assert(v::push<usize>(ref mut old,77).is_ok && v::push<usize>(ref mut current,77).is_ok);let usize start=1;var usize before=0;var usize after=0;var usize i=0;
 while(i<count){assert(budget::charge(ref mut before,1) && v::push<usize>(ref mut old,0).is_ok);i+=1;}
 let usize visits=if(mode==2){2}else if(mode==3){0}else if(mode==4 || mode==5 || mode==6){2}else{count};i=0;var bool conflict=false;
 while(i<visits){let usize source=if(mode==1){count-i-1}else if(mode==2){i*2}else if(mode>=4){0}else{i};let usize target=if(mode==5 && i==1){999}else if(mode==6 && i==0){0}else{source+1};assert(budget::charge(ref mut before,1) && budget::charge(ref mut after,1));let a=classic_store(ref mut old,start,source,target);let b=store_map(ref mut current,start,count,source,target,7,ref mut after);same_error(a,b);if(a.code!=0){assert(a.code==1001 && mode==5);conflict=true;break;}i+=1;}
 if(!conflict){assert(finish_map(ref mut current,start,count,ref mut after).code==0 && v::len<usize>(ref current)==v::len<usize>(ref old));i=0;while(i<v::len<usize>(ref old)){assert(*v::at<usize>(ref old,i)==*v::at<usize>(ref current,i));i+=1;}assert(after<=before);}
 discard io::write("map count=");discard io::write_usize(count);discard io::write(" mode=");discard io::write_u32(mode);discard io::write(" work=");discard io::write_usize(before);discard io::write("->");discard io::write_usize(after);discard io::write("\n");
}
fn void bounded(){var v::Vec<usize> maps=v::empty<usize>();var usize work=0;assert(store_map(ref mut maps,0,8,8,1,7,ref mut work).code==1001 && v::len<usize>(ref maps)==0);assert(store_map(ref mut maps,18446744073709551615,8,0,1,7,ref mut work).code==1001 && v::len<usize>(ref maps)==0);assert(store_map(ref mut maps,0,8,18446744073709551615,1,7,ref mut work).code==1001 && v::len<usize>(ref maps)==0);work=1048576;assert(finish_map(ref mut maps,0,18446744073709551615,ref mut work).code==1002 && v::len<usize>(ref maps)==0 && work==1048576);work=1048574;assert(finish_map(ref mut maps,0,2,ref mut work).code==0 && work==1048576 && v::len<usize>(ref maps)==2);assert(finish_map(ref mut maps,0,3,ref mut work).code==1002 && v::len<usize>(ref maps)==2);}
fn v::Vec<syntax::Parsed> source_inputs(usize fields,bool changed){var v::Vec<syntax::Parsed> result=v::empty<syntax::Parsed>();var usize provider=0;while(provider<2){var bytes::Buffer raw=bytes::empty();text(ref mut raw,b"module p");number(ref mut raw,provider);text(ref mut raw,b";");var usize r=0;while(r<4){text(ref mut raw,b"pub resource R");number(ref mut raw,r);text(ref mut raw,b"{");var usize f=0;while(f<fields){text(ref mut raw,if(changed && f==0){b"i32 z"}else{b"i32 n"});number(ref mut raw,f);text(ref mut raw,b";");f+=1;}text(ref mut raw,b"cleanup{}}pub fn void use");number(ref mut raw,r);text(ref mut raw,b"(ref R");number(ref mut raw,r);text(ref mut raw,b" x){");if(fields!=0){text(ref mut raw,if(changed){b"discard x.z0;"}else{b"discard x.n0;"});}text(ref mut raw,b"}");r+=1;}assert(v::push<syntax::Parsed>(ref mut result,parsed(raw)).is_ok);provider+=1;}return result;}
fn bool same_callable(interfaces::Callable a,interfaces::Callable b){return a.module_index==b.module_index && a.declaration==b.declaration && a.template==b.template && a.result==b.result && a.parameter_start==b.parameter_start && a.parameter_count==b.parameter_count && a.effects==b.effects && a.must_use==b.must_use && a.unsafe_call==b.unsafe_call && a.foreign==b.foreign && a.link_start==b.link_start && a.link_end==b.link_end;}
fn void same(ref Plan a,ref Plan b){assert(layout_count(a)==layout_count(b) && field_count(a)==field_count(b) && callable_count(a)==callable_count(b) && parameter_count(a)==parameter_count(b) && bytes::equal(names(a),names(b)) && v::len<Range>(ref a.ranges)==v::len<Range>(ref b.ranges) && v::len<usize>(ref a.maps)==v::len<usize>(ref b.maps) && v::len<Choice>(ref a.choices)==v::len<Choice>(ref b.choices));var usize i=0;
 while(i<layout_count(a)){let x=layout_at(a,i);let y=layout_at(b,i);assert(shape(x.value,y.value) && x.value.field_start==y.value.field_start && x.name_start==y.name_start && x.name_end==y.name_end);i+=1;}i=0;
 while(i<field_count(a)){let x=field_at(a,i);let y=field_at(b,i);assert(field(x,y) && x.name_start==y.name_start && x.name_end==y.name_end);i+=1;}i=0;
 while(i<callable_count(a)){assert(same_callable(callable_at(a,i),callable_at(b,i)));i+=1;}i=0;while(i<parameter_count(a)){assert(parameter_at(a,i)==parameter_at(b,i));i+=1;}i=0;
 while(i<v::len<usize>(ref a.maps)){assert(*v::at<usize>(ref a.maps,i)==*v::at<usize>(ref b.maps,i));i+=1;}i=0;while(i<v::len<Choice>(ref a.choices)){let x=*v::at<Choice>(ref a.choices,i);let y=*v::at<Choice>(ref b.choices,i);assert(x.unit==y.unit && x.type==y.type && x.layout==y.layout);i+=1;}i=0;
 while(i<v::len<Range>(ref a.ranges)){let x=*v::at<Range>(ref a.ranges,i);let y=*v::at<Range>(ref b.ranges,i);assert(x.start==y.start && x.count==y.count && mapped_field(a,i,0)==0 && mapped_field(a,i,x.count+1)==0);var usize j=1;while(j<=x.count){assert(mapped_field(a,i,j)==mapped_field(b,i,j));j+=1;}i+=1;}assert(mapped_field(a,i,1)==0);
}
fn void stamp_number(ref mut bytes::Buffer raw,usize n){number(raw,n);text(raw,b",");}
fn u32[8] stamp(ref ir::Program p){var bytes::Buffer raw=bytes::empty();var usize i=0;stamp_number(ref mut raw,ir::layout_count(p));while(i<ir::layout_count(p)){let x=ir::layout_at(p,i);stamp_number(ref mut raw,x.value.type);stamp_number(ref mut raw,x.value.field_start);stamp_number(ref mut raw,x.value.field_count);stamp_number(ref mut raw,x.value.module_index);stamp_number(ref mut raw,x.value.declaration);text(ref mut raw,ir::layout_name(p,i));i+=1;}i=0;while(i<ir::field_count(p)){let x=ir::field_at(p,i);stamp_number(ref mut raw,x.kind as usize);stamp_number(ref mut raw,x.type);stamp_number(ref mut raw,x.source_index);stamp_number(ref mut raw,x.module_index);stamp_number(ref mut raw,x.declaration);stamp_number(ref mut raw,x.start);stamp_number(ref mut raw,x.end);stamp_number(ref mut raw,x.name_start);stamp_number(ref mut raw,x.name_end);stamp_number(ref mut raw,x.payload_start);stamp_number(ref mut raw,x.payload_count);text(ref mut raw,ir::field_name(p,i));i+=1;}i=0;while(i<ir::callable_count(p)){let x=ir::callable_at(p,i);stamp_number(ref mut raw,x.module_index);stamp_number(ref mut raw,x.declaration);stamp_number(ref mut raw,x.effects as usize);stamp_number(ref mut raw,x.result);stamp_number(ref mut raw,x.parameter_start);stamp_number(ref mut raw,x.parameter_count);text(ref mut raw,ir::linker_name(p,i));i+=1;}i=0;while(i<ir::parameter_count(p)){stamp_number(ref mut raw,ir::parameter_at(p,i));i+=1;}return sha::digest(bytes::view(ref raw));}
fn clean::Problem refused(Result<Plan,clean::Problem> result){return switch(result){case .ok(_):{assert(false);fail(0,0)}case .err(e):{e}};}
@effects(console) fn void real_case(usize written_fields,bool reverse,bool bad){
 let sources=source_inputs(written_fields,false);let changed=source_inputs(written_fields,true);let changed_metadata=switch(signatures::build(ref changed)){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<ir::Program> inputs=v::empty<ir::Program>();var v::Vec<descriptors::Graph> graphs=v::empty<descriptors::Graph>();var v::Vec<Stamp> before=v::empty<Stamp>();var usize unit=0;
 while(unit<8){var p=switch(if(bad && unit==7){compile::range(ref changed,ref changed_metadata,unit%2,unit%2+1)}else{compile::range(ref sources,ref metadata,unit%2,unit%2+1)}){case .ok(p):{p}case .err(_):{assert(false);return;}};if(reverse){assert(ir::layout_count(ref p)==4 && ir::layout_at(ref p,0).value.field_start>ir::layout_at(ref p,3).value.field_start);}let g=switch(types::from_ir(ref metadata,ref p)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(v::push<Stamp>(ref mut before,Stamp{.digest=stamp(ref p)}).is_ok);assert(v::push<descriptors::Graph>(ref mut graphs,g).is_ok);assert(v::push<ir::Program>(ref mut inputs,p).is_ok);unit+=1;}
 let graph=switch(types::build(ref metadata,ref graphs)){case .ok(p):{p}case .err(_):{assert(false);return;}};let empty=named_units::empty();
 if(bad){let a=refused(baseline_build(ref inputs,ref empty,ref graph));let b=refused(build_inputs(ref inputs,ref empty,ref graph));same_error(a,b);assert(a.code==1001 && a.module_index==1);}else{
 let a=switch(baseline_build(ref inputs,ref empty,ref graph)){case .ok(p):{p}case .err(_):{assert(false);return;}};let b=switch(build_inputs(ref inputs,ref empty,ref graph)){case .ok(p):{p}case .err(_):{assert(false);return;}};same(ref a,ref b);assert(work(ref b)<=work(ref a));if(written_fields!=0){assert(work(ref a)>work(ref b));}
 discard io::write("real fields=");discard io::write_usize(written_fields);discard io::write(" reversed=");discard io::write_usize(if(reverse){1}else{0});discard io::write(" work=");discard io::write_usize(work(ref a));discard io::write("->");discard io::write_usize(work(ref b));discard io::write(" saved=");discard io::write_usize(work(ref a)-work(ref b));discard io::write("\n");}
 unit=0;while(unit<8){let old=v::at<Stamp>(ref before,unit).digest;let after=stamp(v::at<ir::Program>(ref inputs,unit));var usize i=0;while(i<8){assert(old[i]==after[i]);i+=1;}unit+=1;}
}
@effects(console) fn i32 main(){var u32 mode=0;while(mode<7){map_case(8,mode);mode+=1;}map_case(0,0);map_case(8192,0);map_case(8192,1);bounded();real_case(64,false,false);real_case(32,true,false);real_case(0,false,false);real_case(8,false,true);discard io::write("metadata=equal maps=equal conflict=refused inputs=unchanged\n");return 0;}
