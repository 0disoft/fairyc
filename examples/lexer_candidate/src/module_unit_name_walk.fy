module module_unit_name_walk;
import module_unit_name_model as m;
import module_unit_body_ast as ast;
import module_signatures as signatures;
import module_ast_join as join;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;

fn join::Problem local(ref ast::Ast a,ref scanner::Stream source,usize entry,ref v::Vec<usize> annotations,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<usize> entries){
    let e=ast::entry_at(a,entry-1);let usize type=if(e.type_root==0){0}else{*v::at<usize>(annotations,e.type_root-1)};let bound_symbol=m::Symbol{.kind=if(e.kind==1){1}else if(e.kind==2){2}else{3},.type,.entry,.pattern=0,.scope=c.scope,.start=e.name_start,.end=e.name_end};let id=switch(m::add(source,c,symbols,bound_symbol)){case .ok(id):{id}case .err(p):{return p;}};let slot=v::at_mut<usize>(entries,entry-1);*slot=id;return m::fail(c,0,0,0);
}
fn join::Problem pattern(ref ast::Ast a,ref scanner::Stream source,usize id,u32 kind,usize type,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<usize> patterns){
    let n=ast::expression_at(a,id);let name=m::spelling(a,source,id);if(bytes::equal(name,b"_")){return m::fail(c,0,0,0);}let bound_symbol=m::Symbol{.kind,.type,.entry=0,.pattern=id,.scope=c.scope,.start=n.start,.end=n.end};let symbol=switch(m::add(source,c,symbols,bound_symbol)){case .ok(id):{id}case .err(p):{return p;}};let slot=v::at_mut<usize>(patterns,id-1);*slot=symbol;return m::fail(c,0,0,0);
}
fn join::Problem bind_pattern(ref ast::Ast a,ref scanner::Stream source,usize id,u32 kind,usize type,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<usize> patterns){
    if(id==0){return m::fail(c,0,0,0);}let p=ast::expression_at(a,id);if(p.kind==17){return pattern(a,source,id,kind,type,c,symbols,patterns);}if(p.kind==16){return if(p.left==0){m::fail(c,0,0,0)}else{pattern(a,source,p.left,kind,type,c,symbols,patterns)};}
    if(p.kind!=32){return m::fail(c,3,p.start,p.end);}var usize link=p.right;while(link!=0){if(!m::charge(c,1)){return m::fail(c,10,p.start,p.end);}let field=ast::expression_at(a,link);let result=pattern(a,source,field.left,kind,type,c,symbols,patterns);if(result.code!=0){return result;}link=field.right;}return m::fail(c,0,0,0);
}
fn join::Problem expression(ref ast::Ast a,ref scanner::Stream source,ref signatures::Program metadata,usize id,usize depth,ref v::Vec<usize> annotations,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<m::Reference> references,ref mut v::Vec<usize> uses,ref mut v::Vec<usize> entries,ref mut v::Vec<usize> patterns){
    if(id==0){return m::fail(c,0,0,0);}let n=ast::expression_at(a,id);if(depth>=64 || !m::charge(c,1)){return m::fail(c,10,n.start,n.end);}if(n.kind==1 || n.kind==28){return m::fail(c,0,0,0);}if(n.kind==2){return m::reference(a,source,metadata,id,c,symbols,references,uses);}
    if(n.kind==12 || n.kind==31){let usize old=c.unsafe_depth;if(n.kind==31){c.unsafe_depth+=1;}let p=block(a,source,metadata,n.left,depth+1,0,0,0,annotations,c,symbols,references,uses,entries,patterns);c.unsafe_depth=old;return p;}
    if(n.kind==13){let p=expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}let branches=ast::expression_at(a,n.right);let q=block(a,source,metadata,branches.left,depth+1,0,0,0,annotations,c,symbols,references,uses,entries,patterns);if(q.code!=0){return q;}return expression(a,source,metadata,branches.right,depth+1,annotations,c,symbols,references,uses,entries,patterns);}
    if(n.kind==15){let p=expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}var usize link=n.right;while(link!=0){if(!m::charge(c,1)){return m::fail(c,10,n.start,n.end);}let row=ast::expression_at(a,link);let arm=ast::expression_at(a,row.left);let q=block(a,source,metadata,arm.right,depth+1,arm.left,4,0,annotations,c,symbols,references,uses,entries,patterns);if(q.code!=0){return q;}link=row.right;}return m::fail(c,0,0,0);}
    if(n.kind==10 || n.kind==6 || n.kind==24){if(n.kind!=24){let p=expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}}var usize link=n.right;while(link!=0){if(!m::charge(c,1)){return m::fail(c,10,n.start,n.end);}let row=ast::expression_at(a,link);let q=expression(a,source,metadata,row.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(q.code!=0){return q;}link=row.right;}return m::fail(c,0,0,0);}
    if(n.kind==23){let p=m::operation(a,id,c,references,uses);if(p.code!=0){return p;}return expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);}
    if(n.kind==3 || n.kind==4 || n.kind==8 || n.kind==20 || n.kind==21 || n.kind==22 || n.kind==30){return expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);}
    if(n.kind==5 || n.kind==9 || n.kind==26 || n.kind==27 || n.kind==29){let p=expression(a,source,metadata,n.left,depth+1,annotations,c,symbols,references,uses,entries,patterns);return if(p.code!=0){p}else{expression(a,source,metadata,n.right,depth+1,annotations,c,symbols,references,uses,entries,patterns)};}
    return m::fail(c,3,n.start,n.end);
}
fn join::Problem statement(ref ast::Ast a,ref scanner::Stream source,ref signatures::Program metadata,usize id,usize depth,ref v::Vec<usize> annotations,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<m::Reference> references,ref mut v::Vec<usize> uses,ref mut v::Vec<usize> entries,ref mut v::Vec<usize> patterns){
    if(id==0){return m::fail(c,0,0,0);}let s=ast::statement_at(a,id);if(depth>=64 || !m::charge(c,1)){return m::fail(c,10,s.start,s.end);}if(s.kind==9 || s.kind==10){return m::fail(c,0,0,0);}
    if(s.kind==2){let p=expression(a,source,metadata,s.expression,depth+1,annotations,c,symbols,references,uses,entries,patterns);return if(p.code!=0){p}else{local(a,source,s.entry,annotations,c,symbols,entries)};}
    if(s.kind==3 || s.kind==4 || s.kind==6 || s.kind==11 || s.kind==12 || s.kind==13 || s.kind==16){if(s.kind==4){let p=expression(a,source,metadata,s.target,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}}return expression(a,source,metadata,s.expression,depth+1,annotations,c,symbols,references,uses,entries,patterns);}
    if(s.kind==8 || s.kind==17 || s.kind==18){let p=expression(a,source,metadata,s.expression,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}let usize type=if(s.kind==18){*v::at<usize>(annotations,s.second-1)}else{0};return block(a,source,metadata,s.first,depth+1,if(s.kind==8){0}else{s.target},if(s.kind==18){5}else{6},type,annotations,c,symbols,references,uses,entries,patterns);}
    if(s.kind==14){let usize active=c.active;let usize scope=c.scope;c.scope=c.next_scope;c.next_scope+=1;let header=ast::statement_at(a,s.second);let p=statement(a,source,metadata,header.first,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}let q=expression(a,source,metadata,s.expression,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(q.code!=0){return q;}let post=statement(a,source,metadata,header.second,depth+1,annotations,c,symbols,references,uses,entries,patterns);if(post.code!=0){return post;}let result=block(a,source,metadata,s.first,depth+1,0,0,0,annotations,c,symbols,references,uses,entries,patterns);c.active=active;c.scope=scope;return result;}
    return m::fail(c,3,s.start,s.end);
}
fn join::Problem block(ref ast::Ast a,ref scanner::Stream source,ref signatures::Program metadata,usize id,usize depth,usize binding,u32 kind,usize type,ref v::Vec<usize> annotations,ref mut m::Context c,ref mut v::Vec<m::Symbol> symbols,ref mut v::Vec<m::Reference> references,ref mut v::Vec<usize> uses,ref mut v::Vec<usize> entries,ref mut v::Vec<usize> patterns){
    let b=ast::statement_at(a,id);if(depth>=64 || b.kind!=1 || !m::charge(c,1)){return m::fail(c,if(b.kind!=1){9}else{10},b.start,b.end);}let usize active=c.active;let usize scope=c.scope;c.scope=c.next_scope;c.next_scope+=1;
    if(binding!=0){let p=bind_pattern(a,source,binding,kind,type,c,symbols,patterns);if(p.code!=0){return p;}}
    // Reverse the linked list once, keeping source evaluation order linear.
    var v::Vec<usize> order=v::empty<usize>();var usize link=b.first;while(link!=0){if(!m::charge(c,1)){return m::fail(c,10,b.start,b.end);}let row=ast::statement_at(a,link);if(row.kind!=7 || v::len<usize>(ref order)>=b.second){return m::fail(c,9,row.start,row.end);}if(!v::push<usize>(ref mut order,row.first).is_ok){return m::fail(c,11,row.start,row.end);}link=row.second;}if(v::len<usize>(ref order)!=b.second){return m::fail(c,9,b.start,b.end);}
    var usize i=v::len<usize>(ref order);while(i>0){i-=1;let p=statement(a,source,metadata,*v::at<usize>(ref order,i),depth+1,annotations,c,symbols,references,uses,entries,patterns);if(p.code!=0){return p;}}let result=expression(a,source,metadata,b.expression,depth+1,annotations,c,symbols,references,uses,entries,patterns);c.active=active;c.scope=scope;return result;
}
pub fn Result<m::Resolved,join::Problem> resolve(ref ast::Ast a,ref scanner::Stream source,ref signatures::Program metadata,m::Frame frame,ref v::Vec<usize> annotations){
    var c=m::context(frame);var v::Vec<m::Symbol> symbols=v::empty<m::Symbol>();var v::Vec<m::Reference> references=v::empty<m::Reference>();var v::Vec<usize> uses=v::empty<usize>();var v::Vec<usize> entries=v::empty<usize>();var v::Vec<usize> patterns=v::empty<usize>();var usize i=0;
    if(v::len<usize>(annotations)!=ast::type_count(a)){return .err(m::fail(ref c,9,0,0));}while(i<ast::expression_count(a)){if(!m::charge(ref mut c,1)){return .err(m::fail(ref c,10,0,0));}if(!v::push<usize>(ref mut uses,0).is_ok || !v::push<usize>(ref mut patterns,0).is_ok){return .err(m::fail(ref c,11,0,0));}i+=1;}
    i=0;while(i<ast::entry_count(a)){if(!m::charge(ref mut c,1)){return .err(m::fail(ref c,10,0,0));}if(!v::push<usize>(ref mut entries,0).is_ok){return .err(m::fail(ref c,11,0,0));}i+=1;}
    let d=ast::declaration(a);if(frame.kind==2){let receiver=m::Symbol{.kind=10,.type=frame.receiver_type,.entry=0,.pattern=0,.scope=c.scope,.start=d.cleanup_start,.end=d.cleanup_start+7};let id=switch(m::add(source,ref mut c,ref mut symbols,receiver)){case .ok(id):{id}case .err(p):{return .err(p);}};assert(id==1);}
    else{i=0;while(i<ast::entry_count(a)){if(ast::entry_at(a,i).kind==1){let p=local(a,source,i+1,annotations,ref mut c,ref mut symbols,ref mut entries);if(p.code!=0){return .err(p);}}i+=1;}}
    let p=block(a,source,metadata,if(frame.kind==2){d.cleanup_body}else{d.body},0,0,0,0,annotations,ref mut c,ref mut symbols,ref mut references,ref mut uses,ref mut entries,ref mut patterns);if(p.code!=0){return .err(p);}return .ok(m::assemble(frame,symbols,references,uses,entries,patterns,c.work));
}
