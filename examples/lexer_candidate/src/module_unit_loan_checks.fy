module module_unit_loan_checks;
import module_unit_loan_model as loan;
import module_unit_loan_live_model as live;
import module_unit_origin_flow_model as g;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_value_model as m;
import module_unit_values as values;
import module_unit_value_builtin as borrows;
import std::vec as v;

pub fn bool needed(ref m::Values body){var usize local=1;while(local<=m::local_count(body)){if(m::local_at(body,local).kind==5){return true;}local+=1;}var usize i=1;while(i<=m::expression_count(body)){let e=m::expression_at(body,i);if(e.kind==21 || e.kind==22){return true;}i+=1;}return false;}
pub fn Result<usize,m::Problem> root(ref inputs::Inputs input,ref m::Values body,usize original,ref mut g::Context c){var usize id=original;var usize depth=0;while(id!=0){if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,0,0));}let e=switch(g::expression(body,id,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(e.kind==2){return inputs::storage_owner(input,c.frame,e);}if(e.kind!=3 && e.kind!=8 && e.kind!=9 && e.kind!=26 && !(e.kind==4 && e.place.kind==3)){return .ok(0);}id=e.left;depth+=1;}return .ok(0);}
pub fn Result<usize,m::Problem> create(usize owner,bool mutable,usize start,usize end,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c){if(owner==0){return .ok(0);}var usize i=0;while(i<v::len<loan::Loan>(loan_records)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,start,end));}let old=*v::at<loan::Loan>(loan_records,i);if(old.owner==owner && old.mutable==mutable && old.start==start && old.end==end){return .ok(i+3);}i+=1;}if(v::len<loan::Loan>(loan_records)>=16384){return .err(g::fail(c,10,start,end));}if(!v::push<loan::Loan>(loan_records,loan::Loan{.owner,.start,.end,.mutable}).is_ok){return .err(g::fail(c,11,start,end));}return .ok(v::len<loan::Loan>(loan_records)+2);}
fn m::Problem report(loan::Loan prior,bool write,usize start,usize end,usize use_start,usize use_end,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c){if(c.probes!=0){return g::fail(c,0,0,0);}var usize i=0;while(i<v::len<loan::Conflict>(loan_conflicts)){if(!m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}let old=*v::at<loan::Conflict>(loan_conflicts,i);if(old.frame==c.frame && old.start==start && old.end==end && (write || old.borrow_start==prior.start && old.borrow_end==prior.end)){return g::fail(c,0,0,0);}i+=1;}if(v::len<loan::Conflict>(loan_conflicts)>=8192){return g::fail(c,10,start,end);}return if(v::push<loan::Conflict>(loan_conflicts,loan::Conflict{.frame=c.frame,.start,.end,.borrow_start=prior.start,.borrow_end=prior.end,.use_start,.use_end}).is_ok){g::fail(c,0,0,0)}else{g::fail(c,11,start,end)};}
fn m::Problem selected(usize value,usize owner,bool mutable,bool write,usize start,usize end,usize use_start,usize use_end,ref v::Vec<sets::Entry> entries,ref v::Vec<usize> members,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c){var usize i=0;while(i<sets::count(entries,members,value)){if(!m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}let leaf=sets::member(entries,members,value,i);if(leaf<3 || leaf-2>v::len<loan::Loan>(loan_records)){return g::fail(c,12,start,end);}let prior=*v::at<loan::Loan>(loan_records,leaf-3);if(prior.owner==owner && (write || mutable || prior.mutable)){let p=report(prior,write,start,end,use_start,use_end,loan_records,held_loans,loan_conflicts,c);if(p.code!=0){return p;}}i+=1;}return g::fail(c,0,0,0);}
pub fn m::Problem check(ref inputs::Inputs input,ref v::Vec<g::Value> env,ref v::Vec<sets::Entry> entries,ref v::Vec<usize> members,usize original,bool statement,usize owner,bool mutable,bool write,usize start,usize end,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c){if(owner==0 || c.probes!=0){return g::fail(c,0,0,0);}let p=inputs::liveness(input,c.frame);var usize i=0;let count=if(statement){live::statement_count(p)}else{live::expression_count(p)};var live::Point at=live::Point{.source_index=0,.start=0,.end=0,.map=0,.checked=false};var usize low=0;var usize high=count;while(low<high){if(!m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}let mid=low+(high-low)/2;let next=if(statement){live::statement_at(p,mid)}else{live::expression_at(p,mid)};if(next.source_index<original){low=mid+1;}else{high=mid;}}if(low<count){let next=if(statement){live::statement_at(p,low)}else{live::expression_at(p,low)};if(next.source_index==original){at=next;}}if(at.checked){while(i<live::use_count(p,at)){if(!m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}let use=live::use_at(p,at,i);if(use.local==0 || use.local>v::len<g::Value>(env)){return g::fail(c,12,start,end);}let value=v::at<g::Value>(env,use.local-1).loan;let checked=selected(value,owner,mutable,write,start,end,use.start,use.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return checked;}i+=1;}}i=0;while(i<v::len<loan::Held>(held_loans)){let value=v::at<loan::Held>(held_loans,i).loan;let checked=selected(value,owner,mutable,write,start,end,start,end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return checked;}i+=1;}return g::fail(c,0,0,0);}
pub fn usize held_count(ref v::Vec<loan::Held> held_loans){return v::len<loan::Held>(held_loans);}
pub fn m::Problem hold(g::Value value,bool mutable,bool argument,ref mut v::Vec<loan::Held> held_loans,ref mut g::Context c,usize start,usize end){if(v::len<loan::Held>(held_loans)>=16384 || !m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}return if(v::push<loan::Held>(held_loans,loan::Held{.loan=value.loan,.origin=value.origin,.start,.end,.mutable,.argument}).is_ok){g::fail(c,0,0,0)}else{g::fail(c,11,start,end)};}

pub fn void release(usize base,ref mut v::Vec<loan::Held> held_loans){while(v::len<loan::Held>(held_loans)>base){discard v::pop<loan::Held>(held_loans);}}

fn Result<bool,m::Problem> overlap(usize a,usize b,ref v::Vec<sets::Entry> entries,ref v::Vec<usize> members,ref mut g::Context c,usize start,usize end){var usize i=0;while(i<sets::count(entries,members,a)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,start,end));}let leaf=sets::member(entries,members,a,i);let found=switch(sets::contains(entries,members,b,leaf,ref mut c.work)){case .ok(b):{b}case .err(code):{return .err(g::fail(c,code,start,end));}};if(found){return .ok(true);}i+=1;}return .ok(false);}
pub fn Result<u32,m::Problem> argument_kind(ref inputs::Inputs input,ref values::Plan primary,ref m::Values body,usize original,usize ordinal,ref mut g::Context c){var usize i=0;while(i<m::call_count(body)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,0,0));}let call=m::call_at(body,i);if(call.source_index==original){if(call.kind!=1 && call.kind!=2 || ordinal>=call.argument_count){return .ok(0);}let argument=m::argument_at(body,call.argument_start+ordinal);let type=inputs::type_at(input,primary,c.frame,argument.expected);return .ok(if(borrows::borrowed(type)){if(borrows::mutable(type)){2}else{1}}else{0});}i+=1;}return .ok(0);}
pub fn m::Problem access(g::Value value,bool mutable,usize start,usize end,ref v::Vec<sets::Entry> entries,ref v::Vec<usize> members,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c){if(c.probes!=0 || value.origin<=1){return g::fail(c,0,0,0);}var usize i=0;while(i<v::len<loan::Held>(held_loans)){let prior=*v::at<loan::Held>(held_loans,i);let same=switch(overlap(value.origin,prior.origin,entries,members,c,start,end)){case .ok(b):{b}case .err(p):{return p;}};if(prior.argument && same && (mutable || prior.mutable)){var usize j=0;var bool explained=false;while(j<v::len<loan::Conflict>(loan_conflicts)){if(!m::charge(ref mut c.work,1)){return g::fail(c,10,start,end);}let old=*v::at<loan::Conflict>(loan_conflicts,j);if(old.frame==c.frame && (old.start==start && old.end==end || old.start==prior.start && old.end==prior.end)){explained=true;}j+=1;}if(!explained){let p=report(loan::Loan{.owner=0,.start=prior.start,.end=prior.end,.mutable=prior.mutable},false,start,end,start,end,loan_records,held_loans,loan_conflicts,c);if(p.code!=0){return p;}}}i+=1;}return g::fail(c,0,0,0);}
