module copied_closure_lower;
import copied_closure_admission as admission;
import copied_closure_tables as tables;
import generic_source_function_json as functions;
import static_operation_declarations as operations;
import syntax as syntax;
import scanner as scanner;
import body_state as ast;
import bodies as entries;
import std::bytes as bytes;
import std::vec as v;

struct Binding{usize start;usize end;usize helper;usize count;usize[4] snapshots;usize scope;}
struct State{u32 code;usize work;usize scope;usize owner;usize ordinal;usize seen;}
fn bool charge(ref mut State c){if(c.code!=0){return false;}if(c.work>=1048576){c.code=10;return false;}c.work+=1;return true;}
fn usize expression_add(ref mut v::Vec<ast::Node> out,ast::Node n,ref mut State c){if(!charge(c)){return 0;}if(v::len<ast::Node>(out)>=16384){c.code=10;return 0;}if(!v::push<ast::Node>(out,n).is_ok){c.code=11;return 0;}return v::len<ast::Node>(out);}
fn usize statement_add(ref mut v::Vec<ast::Statement> out,ast::Statement n,ref mut State c){if(!charge(c)){return 0;}if(v::len<ast::Statement>(out)>=8192){c.code=10;return 0;}if(!v::push<ast::Statement>(out,n).is_ok){c.code=11;return 0;}return v::len<ast::Statement>(out);}
fn usize entry_add(ref mut v::Vec<entries::Entry> out,entries::Entry n,ref mut State c){if(!charge(c)){return 0;}if(v::len<entries::Entry>(out)>=4096){c.code=10;return 0;}var row=n;row.id=v::len<entries::Entry>(out)+1;if(!v::push<entries::Entry>(out,row).is_ok){c.code=11;return 0;}return row.id;}
fn usize token(ref syntax::Parsed p,usize start){var usize i=0;while(i<syntax::source_token_count(p)){if(scanner::token_info(syntax::source_stream(p),i).start==start){return i;}i+=1;}return 0;}
fn usize find(ref syntax::Parsed p,ref v::Vec<Binding> env,ref u8[] name){var usize i=v::len<Binding>(env);while(i>0){i-=1;let b=*v::at<Binding>(env,i);if(bytes::equal(syntax::source_view(p)[b.start..b.end],name)){return i+1;}}return 0;}
fn bool bind(ref mut v::Vec<Binding> env,Binding b,ref mut State c){if(v::len<Binding>(env)>=1024 || !v::push<Binding>(env,b).is_ok){c.code=11;return false;}return true;}
fn void restore(ref mut v::Vec<Binding> env,usize length){while(v::len<Binding>(env)>length){discard v::pop<Binding>(env);}}
fn bool number(ref mut bytes::Buffer out,usize value){var u8[20] digits=[0;20];var usize used=0;var usize n=value;while(true){var u8 digit=48;var usize rem=n%10;while(rem>0){digit+=1;rem-=1;}digits[used]=digit;used+=1;n/=10;if(n==0){break;}}while(used>0){used-=1;let ref u8[] raw=ref digits;if(!bytes::append(out,raw[used..used+1]).is_ok){return false;}}return true;}
fn usize link(ref mut v::Vec<ast::Statement> statements,usize first,usize previous,ref mut State c){if(first==0){return previous;}let s=*v::at<ast::Statement>(statements,first-1);return statement_add(statements,ast::Statement{.kind=7,.start=s.start,.end=s.end,.expression=0,.target=0,.first,.second=previous,.entry=0,.operator=0},c);}

fn usize literal(ref syntax::Parsed p,syntax::Statement binding,ref mut v::Vec<syntax::Declaration> declarations,ref mut v::Vec<ast::Node> expressions,ref mut v::Vec<entries::Entry> locals,ref mut v::Vec<ast::Statement> statements,ref mut bytes::Buffer private_data,ref mut v::Vec<tables::Row> private_rows,ref mut v::Vec<Binding> env,ref mut State c,ref mut usize tail){
    let entry=syntax::entry_at(p,binding.entry-1);let name=syntax::source_view(p)[entry.name_start..entry.name_end];let old=find(p,env,name);if(c.scope!=1 || entry.kind!=2 || entry.type_root!=0 || admission::reserved(name) || old!=0 && v::at<Binding>(env,old-1).scope==c.scope){c.code=3;return 0;}
    let code=admission::validate(p,binding.expression);if(code!=0){c.code=code;return 0;}let n=syntax::expression_at(p,binding.expression);let h=syntax::expression_at(p,n.right);let count=h.right/129;let parameters=h.right%129;c.ordinal+=1;c.seen+=1;var Binding info=Binding{.start=entry.name_start,.end=entry.name_end,.helper=v::len<syntax::Declaration>(declarations)+1,.count,.snapshots=[0;4],.scope=c.scope};
    var usize i=0;while(i<count){let cap=syntax::entry_at(p,h.left+i-1);let captured=find(p,env,syntax::source_view(p)[cap.name_start..cap.name_end]);if(captured!=0 && v::at<Binding>(env,captured-1).helper!=0){c.code=3;return 0;}let value=expression_add(expressions,ast::node_value(2,cap.name_start,cap.name_end,token(p,cap.name_start),0,0),c);var snapshot=entries::Entry{.kind=102,.start=cap.start,.end=cap.end,.name_start=cap.name_start,.name_end=cap.name_end,.type_start=cap.type_start,.type_end=cap.type_end,.type_root=cap.type_root,.expression=value,.id=0};let id=entry_add(locals,snapshot,c);info.snapshots[i]=id;
        let statement=statement_add(statements,ast::Statement{.kind=2,.start=cap.start,.end=cap.end,.expression=value,.target=0,.first=0,.second=0,.entry=id,.operator=0},c);*tail=link(statements,statement,*tail,c);i+=1;
    }
    var d=syntax::declaration_at(p,c.owner-1);var bytes::Buffer helper=bytes::empty();if(!bytes::append(ref mut helper,b"_fy_closure_").is_ok || !bytes::append(ref mut helper,syntax::source_view(p)[d.name_start..d.name_end]).is_ok || !bytes::append(ref mut helper,b"_").is_ok || !number(ref mut helper,c.ordinal)){c.code=11;return 0;}
    d.kind=3;d.start=n.start;d.end=n.end;d.name_start=entry.name_start;d.name_end=entry.name_end;d.public=false;d.public_start=0;d.public_end=0;d.unsafe_start=0;d.unsafe_end=0;d.owner_start=0;d.owner_end=0;d.generic_parameters=0;d.generic_start=0;d.generic_end=0;d.attribute_start=0;d.attribute_count=0;d.cleanup_attribute_start=0;d.cleanup_attribute_count=0;d.cleanup_start=0;d.cleanup_end=0;d.cleanup_body=0;d.field_start=0;d.field_count=0;d.expression=0;d.result_type=h.token;d.entry_start=v::len<entries::Entry>(locals);d.entry_count=count+parameters;d.body=n.left;
    i=0;while(i<count+parameters){let e=syntax::entry_at(p,h.left+i-1);let id=entry_add(locals,entries::Entry{.kind=1,.start=e.start,.end=e.end,.name_start=e.name_start,.name_end=e.name_end,.type_start=e.type_start,.type_end=e.type_end,.type_root=e.type_root,.expression=0,.id=0},c);if(id==0){return 0;}i+=1;}
    let body=syntax::statement_at(p,n.left);if(body.expression!=0){
        // Original local statements retain their original entry/expression IDs:
        // preparation appends to, rather than replaces, those source tables.
        // Keep every initializer in source order, including unused trapping ones.
        var usize items=0;let count=syntax::block_statement_count(p,n.left);i=0;while(i<count){items=link(statements,syntax::block_statement(p,n.left,i),items,c);i+=1;}
        let ret=statement_add(statements,ast::Statement{.kind=3,.start=body.start,.end=body.end,.expression=body.expression,.target=0,.first=0,.second=0,.entry=0,.operator=0},c);items=link(statements,ret,items,c);d.body=statement_add(statements,ast::Statement{.kind=1,.start=body.start,.end=body.end,.expression=0,.target=0,.first=items,.second=count+1,.entry=0,.operator=0},c);
    }
    if(!v::push<syntax::Declaration>(declarations,d).is_ok){c.code=11;return 0;}let stored=tables::add(private_data,private_rows,info.helper,bytes::view(ref helper),b"");if(stored!=0){c.code=stored;return 0;}if(!bind(env,info,c)){return 0;}return count;
}

fn usize expression(ref syntax::Parsed p,ref mut v::Vec<syntax::Declaration> declarations,ref mut v::Vec<ast::Node> expressions,ref mut v::Vec<entries::Entry> locals,ref mut v::Vec<ast::Statement> statements,ref mut bytes::Buffer private_data,ref mut v::Vec<tables::Row> private_rows,ref mut v::Vec<Binding> env,ref mut State c,usize id,usize depth){
    if(id==0 || c.code!=0){return 0;}if(depth>=64 || !charge(c)){c.code=10;return 0;}let n=syntax::expression_at(p,id);var row=ast::node_value(n.kind,n.start,n.end,n.token,n.left,n.right);
    if(n.kind==34){c.code=3;return 0;}if(n.kind==2){let name=syntax::expression_text(p,id);let found=find(p,env,name);if(admission::reserved(name) || found!=0 && v::at<Binding>(env,found-1).helper!=0){c.code=3;return 0;}}
    if(n.kind==6 && n.left!=0){let callee=syntax::expression_at(p,n.left);if(callee.kind==2){let found=find(p,env,syntax::expression_text(p,n.left));if(found!=0){let binding=*v::at<Binding>(env,found-1);if(binding.helper!=0){
        row.left=expression_add(expressions,ast::node_value(2,callee.start,callee.end,tables::helper_flag()+binding.helper,0,0),c);var usize args=0;var usize i=0;
        while(i<binding.count){let value=expression_add(expressions,ast::node_value(2,n.start,n.end,tables::snapshot_flag()+binding.snapshots[i],0,0),c);args=expression_add(expressions,ast::node_value(7,syntax::token_info(p,n.token).start,n.end,n.token,value,args),c);i+=1;}
        let count=syntax::call_argument_count(p,id);i=0;while(i<count){let entry=syntax::expression_at(p,syntax::call_argument_entry(p,id,i));let t=syntax::token_info(p,entry.token);if(t.start!=entry.start){c.code=3;return 0;}let value=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,entry.left,depth+1);args=expression_add(expressions,ast::node_value(7,entry.start,entry.end,entry.token,value,args),c);i+=1;}row.right=args;return expression_add(expressions,row,c);
    }}}}
    if(n.kind==7 || n.kind==11 || n.kind==19 || n.kind==25 || n.kind==33){row.right=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.right,depth+1);row.left=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.left,depth+1);return expression_add(expressions,row,c);}
    if(n.kind==12 || n.kind==14 || n.kind==31){row.left=block(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.left,depth+1);}else{row.left=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.left,depth+1);}
    if(n.kind==18){row.right=block(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.right,depth+1);}else if(n.kind!=20 && n.kind!=23){row.right=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,n.right,depth+1);}return expression_add(expressions,row,c);
}
fn usize statement(ref syntax::Parsed p,ref mut v::Vec<syntax::Declaration> declarations,ref mut v::Vec<ast::Node> expressions,ref mut v::Vec<entries::Entry> locals,ref mut v::Vec<ast::Statement> statements,ref mut bytes::Buffer private_data,ref mut v::Vec<tables::Row> private_rows,ref mut v::Vec<Binding> env,ref mut State c,usize id,usize depth){
    if(id==0 || c.code!=0){return 0;}if(depth>=64 || !charge(c)){c.code=10;return 0;}let s=syntax::statement_at(p,id);if(s.kind==1){return block(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,id,depth);}
    var row=ast::Statement{.kind=s.kind,.start=s.start,.end=s.end,.expression=s.expression,.target=s.target,.first=s.first,.second=s.second,.entry=s.entry,.operator=s.operator};
    if(s.kind==14){let length=v::len<Binding>(env);let scope=c.scope;c.scope+=1;let h=syntax::statement_at(p,s.second);let initial=statement(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,h.first,depth+1);row.expression=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.expression,depth+1);let post=statement(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,h.second,depth+1);row.first=block(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.first,depth+1);row.second=statement_add(statements,ast::Statement{.kind=15,.start=h.start,.end=h.end,.expression=0,.target=0,.first=initial,.second=post,.entry=0,.operator=0},c);restore(env,length);c.scope=scope;return statement_add(statements,row,c);}
    if(s.kind==18){
        // Evaluate the iterable in the enclosing scope; the item shadows an
        // outer closure only while rewriting the loop body.
        row.expression=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.expression,depth+1);row.target=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.target,depth+1);
        let length=v::len<Binding>(env);let scope=c.scope;c.scope+=1;let item=syntax::expression_at(p,s.target);
        if(!bind(env,Binding{.start=item.start,.end=item.end,.helper=0,.count=0,.snapshots=[0;4],.scope=c.scope},c)){return 0;}
        row.first=block(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.first,depth+1);restore(env,length);c.scope=scope;return statement_add(statements,row,c);
    }
    row.expression=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.expression,depth+1);row.target=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.target,depth+1);if(s.first!=0){row.first=statement(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.first,depth+1);}if(s.kind==7 || s.kind==15){row.second=statement(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,s.second,depth+1);}
    if(s.kind==2){let e=syntax::entry_at(p,s.entry-1);let name=syntax::source_view(p)[e.name_start..e.name_end];let old=find(p,env,name);if(admission::reserved(name) || old!=0 && v::at<Binding>(env,old-1).scope==c.scope && v::at<Binding>(env,old-1).helper!=0){c.code=3;return 0;}row.entry=entry_add(locals,entries::Entry{.kind=e.kind,.start=e.start,.end=e.end,.name_start=e.name_start,.name_end=e.name_end,.type_start=e.type_start,.type_end=e.type_end,.type_root=e.type_root,.expression=row.expression,.id=0},c);discard bind(env,Binding{.start=e.name_start,.end=e.name_end,.helper=0,.count=0,.snapshots=[0;4],.scope=c.scope},c);}
    if(s.kind!=2 && s.entry!=0){let e=syntax::entry_at(p,s.entry-1);row.entry=entry_add(locals,entries::Entry{.kind=e.kind,.start=e.start,.end=e.end,.name_start=e.name_start,.name_end=e.name_end,.type_start=e.type_start,.type_end=e.type_end,.type_root=e.type_root,.expression=row.expression,.id=0},c);}
    return statement_add(statements,row,c);
}
fn usize block(ref syntax::Parsed p,ref mut v::Vec<syntax::Declaration> declarations,ref mut v::Vec<ast::Node> expressions,ref mut v::Vec<entries::Entry> locals,ref mut v::Vec<ast::Statement> statements,ref mut bytes::Buffer private_data,ref mut v::Vec<tables::Row> private_rows,ref mut v::Vec<Binding> env,ref mut State c,usize id,usize depth){
    if(id==0 || c.code!=0){return 0;}if(depth>=64 || !charge(c)){c.code=10;return 0;}let b=syntax::statement_at(p,id);if(b.kind!=1){c.code=9;return 0;}let length=v::len<Binding>(env);let scope=c.scope;c.scope+=1;var usize tail=0;var usize count=0;var usize i=0;
    while(i<b.second && c.code==0){let selected=syntax::block_statement(p,id,i);let s=syntax::statement_at(p,selected);if(s.kind==2 && s.expression!=0 && syntax::expression_at(p,s.expression).kind==34){let added=literal(p,s,declarations,expressions,locals,statements,private_data,private_rows,env,c,ref mut tail);count+=added;}else{let value=statement(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,selected,depth+1);tail=link(statements,value,tail,c);count+=1;}i+=1;}
    let value=expression(p,declarations,expressions,locals,statements,private_data,private_rows,env,c,b.expression,depth+1);restore(env,length);c.scope=scope;return statement_add(statements,ast::Statement{.kind=1,.start=b.start,.end=b.end,.expression=value,.target=0,.first=tail,.second=count,.entry=0,.operator=0},c);
}
pub fn u32 prepare(ref syntax::Parsed p,ref mut v::Vec<syntax::Declaration> declarations,ref mut v::Vec<ast::Node> expressions,ref mut v::Vec<entries::Entry> locals,ref mut v::Vec<ast::Statement> statements,ref mut bytes::Buffer private_data,ref mut v::Vec<tables::Row> private_rows){
    if(!admission::needed(p) || syntax::problem_count(p)!=0){return 0;}var State c=State{.code=0,.work=0,.scope=0,.owner=0,.ordinal=0,.seen=0};var v::Vec<Binding> env=v::empty<Binding>();var usize i=1;
    while(i<syntax::declaration_count(p)){let d=syntax::declaration_at(p,i);if(d.kind==3){if(admission::reserved(syntax::source_view(p)[d.name_start..d.name_end])){return 3;}if(operations::operation(p,i+1).kind==1){i+=1;continue;}if(admission::function(p,d)){var usize work=0;let written=switch(functions::encode(p,i,ref mut work)){case .ok(p):{p}case .err(code):{return code;}};let code=tables::add(private_data,private_rows,i+1,b"",bytes::view(ref written));if(code!=0){return code;}}
        discard v::clear<Binding>(ref mut env);c.owner=i+1;var usize j=d.entry_start;while(j<d.entry_start+d.entry_count){let e=syntax::entry_at(p,j);if(e.kind==1){discard bind(ref mut env,Binding{.start=e.name_start,.end=e.name_end,.helper=0,.count=0,.snapshots=[0;4],.scope=1},ref mut c);}j+=1;}
        let body=block(p,declarations,expressions,locals,statements,private_data,private_rows,ref mut env,ref mut c,d.body,0);if(c.code!=0){return c.code;}{let changed=v::at_mut<syntax::Declaration>(declarations,i);changed.body=body;changed.expression=0;}
    }i+=1;}var usize expected=0;i=1;while(i<=syntax::expression_count(p)){if(syntax::expression_at(p,i).kind==34){expected+=1;}i+=1;}return if(expected==c.seen){0}else{3};
}
