module linux_cli_data;

pub fn ref str help() { return "usage: lexer-candidate-linux --help | --version | targets\n       lexer-candidate-linux new <package-name> --uid <package-uid>\n       lexer-candidate-linux check [--locked] [--cache-root <existing directory>] [--cache-status]\n       lexer-candidate-linux build [--release] [--locked] [--cache-root <existing directory>] [--cache-status]\n       lexer-candidate-linux run [--release] [--locked] [--cache-root <existing directory>] [--cache-status] [-- <program args>]\n       lexer-candidate-linux test [--list] [--json] [--locations] [--workspace | --package <uid>] [--dir <path> | --file <path> | --exact <identity>]... [--locked] [--cache-root <existing directory>] [--cache-status]\n       lexer-candidate-linux test --native [--release] [--stdin | --stdin-file <path>] [--timeout-seconds <1..60>] [--json --capture-output] [--cache-root <existing directory>] [--cache-status] [-- <program args>]\n       lexer-candidate-linux experimental fetch-packages [--offline]\n       lexer-candidate-linux experimental atlas-symbols list --catalog-version <1|2|3> --package-uid <uid> --max-symbols <n> --max-selection-bytes <n> --max-output-bytes <n> [--module <module>] [--name <name>] [--kind <kind>]... [--after <symbol-id>] [--locked]\n       lexer-candidate-linux experimental atlas-mcp --allow-impact --max-packages <n> --max-calls <n> --max-depth <n> --max-symbols <n> --max-output-bytes <n> --max-requests <n>\n       lexer-candidate-linux experimental atlas-impact --package-uid <uid> --symbol <symbol-id> --max-packages <n> --max-calls <n> --max-depth <n> --max-symbols <n> --max-output-bytes <n> [--locked]\n       lexer-candidate-linux --tokens-file <path>\n       lexer-candidate-linux --declarations-file <path>\n       lexer-candidate-linux --check-names-file <path>\n       lexer-candidate-linux --bindings-file <path>\n       lexer-candidate-linux --check-types-file <path>\n       lexer-candidate-linux --hir-file <path>\n       lexer-candidate-linux --mir-file <path>\n       lexer-candidate-linux --c-file <path>\n       lexer-candidate-linux --c-workspace <root> [--locked]\nNo arguments: private binary stdin protocol.\nC output is private compiler-debug transport. Workspace packets target x86_64-linux-gnu.\n"; }
