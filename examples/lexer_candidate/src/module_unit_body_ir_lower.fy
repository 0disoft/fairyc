module module_unit_body_ir_lower;
import module_unit_body_ir_model as ir;
import module_unit_cleanup_mir_model as clean_ir;
import module_unit_cleanup_mir_lower as cleaning;
import module_unit_values as values;
import module_unit_value_model as m;
import module_unit_interfaces as interfaces;
import module_unit_region_model as regions;
import module_unit_moves as moves;
import syntax as syntax;
import literal_types as literals;
import std::bytes as bytes;
import std::vec as v;

fn clean_ir::Problem fail(u32 code,usize module_index,usize start,usize end){return clean_ir::Problem{.code,.module_index,.start,.end};}
fn Result<ir::Body,clean_ir::Problem> body(ref syntax::Parsed source,ref m::Values typed,ref mut usize work){
    let f=m::frame(typed);let d=syntax::declaration_at(source,f.declaration-1);let root=if(f.kind==2){d.cleanup_body}else{d.body};let start=if(f.kind==2){d.cleanup_start}else{d.start};let end=if(f.kind==2){d.cleanup_end}else{d.end};
    var v::Vec<ir::Node> nodes=v::empty<ir::Node>();var v::Vec<ir::Statement> statements=v::empty<ir::Statement>();var v::Vec<m::Local> locals=v::empty<m::Local>();var v::Vec<m::Invocation> calls=v::empty<m::Invocation>();var v::Vec<m::Argument> arguments=v::empty<m::Argument>();var v::Vec<regions::Scope> regions=v::empty<regions::Scope>();var v::Vec<regions::Exit> resets=v::empty<regions::Exit>();var bytes::Buffer text=bytes::empty();var usize i=1;
    while(i<=m::expression_count(typed)){let e=m::expression_at(typed,i);let tree=syntax::expression_at(source,e.source_index);let raw=syntax::expression_text(source,e.source_index);if(!m::charge(work,raw.len+1)){return .err(fail(1002,f.module_index,e.start,e.end));}let text_start=bytes::len(ref text);if(!bytes::append(ref mut text,raw).is_ok){return .err(fail(1003,f.module_index,e.start,e.end));}let text_end=bytes::len(ref text);let cooked_start=text_end;var u32 literal_kind=0;if(e.kind==1){literal_kind=syntax::literal_kind(source,e.source_index);let cooked=syntax::literal_cooked(source,e.source_index);if(!m::charge(work,cooked.len)){return .err(fail(1002,f.module_index,e.start,e.end));}if(literal_kind>=7 && literal_kind<=9){let code=literals::decode(ref mut text,cooked);if(code!=0){return .err(fail(if(code==3){1003}else{1001},f.module_index,e.start,e.end));}}else if(!bytes::append(ref mut text,cooked).is_ok){return .err(fail(1003,f.module_index,e.start,e.end));}}if(!v::push<ir::Node>(ref mut nodes,ir::Node{.value=e,.syntax=tree,.literal_kind,.text_start,.text_end,.cooked_start,.cooked_end=bytes::len(ref text)}).is_ok){return .err(fail(1003,f.module_index,e.start,e.end));}i+=1;}
    i=1;while(i<=syntax::statement_count(source)){let s=syntax::statement_at(source,i);if(!m::charge(work,1)){return .err(fail(1002,f.module_index,s.start,s.end));}if(s.start>=start && s.end<=end){let operator_start=bytes::len(ref text);if(s.kind==4){let op=syntax::assignment_operator(source,i);if(!m::charge(work,op.len)){return .err(fail(1002,f.module_index,s.start,s.end));}if(!bytes::append(ref mut text,op).is_ok){return .err(fail(1003,f.module_index,s.start,s.end));}}if(!v::push<ir::Statement>(ref mut statements,ir::Statement{.source_index=i,.value=s,.operator_start,.operator_end=bytes::len(ref text)}).is_ok){return .err(fail(1003,f.module_index,s.start,s.end));}}i+=1;}
    i=1;while(i<=m::local_count(typed)){if(!m::charge(work,1)){return .err(fail(1002,f.module_index,d.start,d.end));}if(!v::push<m::Local>(ref mut locals,m::local_at(typed,i)).is_ok){return .err(fail(1003,f.module_index,d.start,d.end));}i+=1;}
    i=0;while(i<m::call_count(typed)){if(!m::charge(work,1)){return .err(fail(1002,f.module_index,d.start,d.end));}if(!v::push<m::Invocation>(ref mut calls,m::call_at(typed,i)).is_ok){return .err(fail(1003,f.module_index,d.start,d.end));}i+=1;}
    i=0;while(i<m::argument_count(typed)){if(!m::charge(work,1)){return .err(fail(1002,f.module_index,d.start,d.end));}if(!v::push<m::Argument>(ref mut arguments,m::argument_at(typed,i)).is_ok){return .err(fail(1003,f.module_index,d.start,d.end));}i+=1;}
    i=0;while(i<m::region_count(typed)){if(!m::charge(work,1)){return .err(fail(1002,f.module_index,d.start,d.end));}if(!v::push<regions::Scope>(ref mut regions,m::region_at(typed,i)).is_ok){return .err(fail(1003,f.module_index,d.start,d.end));}i+=1;}
    i=0;while(i<m::region_exit_count(typed)){if(!m::charge(work,1)){return .err(fail(1002,f.module_index,d.start,d.end));}if(!v::push<regions::Exit>(ref mut resets,m::region_exit_at(typed,i)).is_ok){return .err(fail(1003,f.module_index,d.start,d.end));}i+=1;}
    return .ok(ir::assemble_body(root,syntax::source_view(source).len,start,end,nodes,statements,locals,calls,arguments,regions,resets,text));
}
pub fn Result<ir::Program,clean_ir::Problem> lower(ref v::Vec<syntax::Parsed> sources,ref values::Plan typed,ref interfaces::Interfaces imported,ref moves::Plan moved){
    let cleaned=switch(cleaning::lower(sources,typed,imported,moved)){case .ok(p):{p}case .err(p):{return .err(p);}};var usize work=clean_ir::work(ref cleaned);var v::Vec<ir::Body> bodies=v::empty<ir::Body>();var v::Vec<ir::Layout> layouts=v::empty<ir::Layout>();var v::Vec<interfaces::Field> fields=v::empty<interfaces::Field>();var v::Vec<interfaces::Callable> callables=v::empty<interfaces::Callable>();var v::Vec<usize> parameters=v::empty<usize>();var bytes::Buffer names=bytes::empty();var usize i=0;
    while(i<values::count(typed)){let value=values::at(typed,i);let f=m::frame(value);let owned=switch(body(v::at<syntax::Parsed>(sources,f.module_index),value,ref mut work)){case .ok(p):{p}case .err(p):{return .err(p);}};if(!v::push<ir::Body>(ref mut bodies,owned).is_ok){return .err(fail(1003,f.module_index,0,0));}i+=1;}
    i=0;while(i<interfaces::shape_count(imported)){let s=interfaces::shape_at(imported,i);let source=v::at<syntax::Parsed>(sources,s.module_index);let d=syntax::declaration_at(source,s.declaration-1);let name=syntax::source_view(source)[d.name_start..d.name_end];let name_start=bytes::len(ref names);if(!m::charge(ref mut work,name.len+1)){return .err(fail(1002,s.module_index,s.start,s.end));}if(!bytes::append(ref mut names,name).is_ok || !v::push<ir::Layout>(ref mut layouts,ir::Layout{.value=s,.name_start,.name_end=bytes::len(ref names)}).is_ok){return .err(fail(1003,s.module_index,s.start,s.end));}i+=1;}
    i=0;while(i<interfaces::field_count(imported)){var f=interfaces::field_at(imported,i);let name=interfaces::field_name(imported,i);f.name_start=bytes::len(ref names);if(!m::charge(ref mut work,name.len+1)){return .err(fail(1002,f.module_index,f.start,f.end));}if(!bytes::append(ref mut names,name).is_ok){return .err(fail(1003,f.module_index,f.start,f.end));}f.name_end=bytes::len(ref names);if(!v::push<interfaces::Field>(ref mut fields,f).is_ok){return .err(fail(1003,f.module_index,f.start,f.end));}i+=1;}
    i=0;while(i<interfaces::callable_count(imported)){var c=interfaces::callable_at(imported,i);let link=interfaces::linker_name(imported,i);c.link_start=bytes::len(ref names);let parameter_start=v::len<usize>(ref parameters);var usize j=0;while(j<c.parameter_count){if(!m::charge(ref mut work,1)){return .err(fail(1002,c.module_index,0,0));}if(!v::push<usize>(ref mut parameters,interfaces::parameter_at(imported,c.parameter_start+j)).is_ok){return .err(fail(1003,c.module_index,0,0));}j+=1;}c.parameter_start=parameter_start;
        if(!m::charge(ref mut work,link.len+1)){return .err(fail(1002,c.module_index,0,0));}if(!bytes::append(ref mut names,link).is_ok){return .err(fail(1003,c.module_index,0,0));}c.link_end=bytes::len(ref names);if(!v::push<interfaces::Callable>(ref mut callables,c).is_ok){return .err(fail(1003,c.module_index,0,0));}i+=1;
    }return ir::assemble(cleaned,bodies,layouts,fields,callables,parameters,names,work);
}
