module module_unit_move_control;
import module_unit_move_model as g;
import module_unit_move_walk as walk;
import module_unit_value_model as m;
import module_unit_values as values;
import syntax as syntax;
import std::vec as v;

pub fn Result<bool,m::Problem> block(ref v::Vec<syntax::Parsed> sources,ref values::Plan primary,ref m::Values body,ref v::Vec<u8> owners,ref mut v::Vec<g::Cell> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<g::Diagnostic> diagnostics,ref mut v::Vec<g::Fact> facts,usize id,bool consuming,usize depth,ref mut g::Context c){
    if(id==0){return .ok(true);}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let b=syntax::statement_at(source,id);if(depth>=64 || b.kind!=1 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,if(b.kind!=1){12}else{10},b.start,b.end));}let before=switch(g::copy(env,c)){case .ok(v):{v}case .err(p):{return .err(p);}};var bool reachable=true;var usize i=0;
    while(i<syntax::block_statement_count(source,id) && reachable){reachable=switch(statement(sources,primary,body,owners,env,edges,diagnostics,facts,syntax::block_statement(source,id,i),depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};i+=1;}
    if(reachable){reachable=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,b.expression,consuming,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};}
    i=0;while(i<v::len<g::Cell>(env)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,b.start,b.end));}let old=*v::at<g::Cell>(ref before,i);let now=*v::at<g::Cell>(env,i);if(old.state==0 && now.state!=0){if(reachable && now.state==1){let dropped=g::schedule(i+1,m::local_at(body,i+1).type,1,b.start,b.end,facts,c);if(dropped.code!=0){return .err(dropped);}}let p=g::fact(i+1,4,now,old,b.start,b.end,facts,c);if(p.code!=0){return .err(p);}let slot=v::at_mut<g::Cell>(env,i);*slot=old;}i+=1;}return .ok(reachable);
}
fn m::Problem pattern(ref m::Values body,ref values::Plan primary,usize original,ref mut v::Vec<g::Cell> env,ref mut v::Vec<g::Fact> facts,ref mut g::Context c){let binding=switch(g::local(body,original,4,c)){case .ok(n):{n}case .err(p):{return p;}};if(binding==0){return g::fail(c,0,0,0);}let n=m::local_at(body,binding);let owned=switch(g::owned(primary,n.type,c,0)){case .ok(b):{b}case .err(p):{return p;}};return if(owned){g::produce(body,binding,n.start,n.end,env,facts,c)}else{g::fail(c,0,0,0)};}
pub fn Result<bool,m::Problem> branch(ref v::Vec<syntax::Parsed> sources,ref values::Plan primary,ref m::Values body,ref v::Vec<u8> owners,ref mut v::Vec<g::Cell> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<g::Diagnostic> diagnostics,ref mut v::Vec<g::Fact> facts,m::Expression e,bool consuming,usize depth,ref mut g::Context c){
    let source=v::at<syntax::Parsed>(sources,c.value.module_index);let live=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,e.left,e.kind==15,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!live){return .ok(false);}let base=switch(g::copy(env,c)){case .ok(v):{v}case .err(p):{return .err(p);}};var bool first=true;var v::Vec<usize> arms=v::empty<usize>();
    if(e.kind==15){var usize link=e.right;while(link!=0){if(!m::charge(ref mut c.work,1) || v::len<usize>(ref arms)>=1024){return .err(g::fail(c,10,e.start,e.end));}let pair=syntax::expression_at(source,link);if(!v::push<usize>(ref mut arms,pair.left).is_ok){return .err(g::fail(c,11,e.start,e.end));}link=pair.right;}}
    var usize i=0;let usize count=if(e.kind==13){2}else{v::len<usize>(ref arms)};while(i<count){var current=switch(g::copy(ref base,c)){case .ok(v):{v}case .err(p):{return .err(p);}};var bool reachable=true;
        if(e.kind==13){let pair=syntax::expression_at(source,e.right);reachable=if(i==0){switch(block(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,pair.left,consuming,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}}}else{switch(walk::expression(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,pair.right,consuming,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}}};}
        else{let arm=syntax::expression_at(source,*v::at<usize>(ref arms,count-1-i));let capture=syntax::expression_at(source,arm.left);if(capture.left!=0){let p=pattern(body,primary,capture.left,ref mut current,facts,c);if(p.code!=0){return .err(p);}}reachable=switch(block(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,arm.right,consuming,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(capture.left!=0){let binding=switch(g::local(body,capture.left,4,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(binding!=0){let cell=*v::at<g::Cell>(ref current,binding-1);if(cell.state!=0){if(reachable && cell.state==1){let dropped=g::schedule(binding,m::local_at(body,binding).type,9,arm.start,arm.end,facts,c);if(dropped.code!=0){return .err(dropped);}}let killed=g::fact(binding,4,cell,g::empty(),arm.start,arm.end,facts,c);if(killed.code!=0){return .err(killed);}let slot=v::at_mut<g::Cell>(ref mut current,binding-1);*slot=g::empty();}}}}
        if(reachable){let p=g::merge(body,ref base,ref current,env,first,e.start,e.end,diagnostics,c);if(p.code!=0){return .err(p);}first=false;}i+=1;
    }return .ok(!first);
}
fn Result<bool,m::Problem> validate_edge(ref m::Values body,ref v::Vec<g::Cell> base,ref v::Vec<g::Cell> actual,syntax::Statement s,usize header_end,ref mut v::Vec<g::Diagnostic> diagnostics,ref mut g::Context c){var bool equal=true;var usize i=0;while(i<v::len<g::Cell>(base)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}let before=*v::at<g::Cell>(base,i);let after=*v::at<g::Cell>(actual,i);if(before.state!=0 && before.state!=after.state){equal=false;let p=g::report(body,i+1,1105,s.start,s.end,after,s.start,header_end,diagnostics,c);if(p.code!=0){return .err(p);}}i+=1;}return .ok(equal);}
fn Result<bool,m::Problem> repeated(ref v::Vec<syntax::Parsed> sources,ref values::Plan primary,ref m::Values body,ref v::Vec<u8> owners,ref mut v::Vec<g::Cell> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<g::Diagnostic> diagnostics,ref mut v::Vec<g::Fact> facts,syntax::Statement s,usize depth,ref mut g::Context c){
    let source=v::at<syntax::Parsed>(sources,c.value.module_index);var usize post=0;var usize initial_binding=0;var usize header_end=if(s.expression==0){s.end}else{syntax::expression_at(source,s.expression).end};
    if(s.kind==14){let header=syntax::statement_at(source,s.second);post=header.second;header_end=if(s.expression==0){s.end}else{syntax::expression_at(source,s.expression).end};if(header.first!=0){let initial=syntax::statement_at(source,header.first);if(initial.kind==2){initial_binding=switch(g::local(body,initial.entry,2,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}}let live=switch(statement(sources,primary,body,owners,env,edges,diagnostics,facts,header.first,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!live){return .ok(false);}}
    let live=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,s.expression,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!live){return .ok(false);}let base=switch(g::copy(env,c)){case .ok(v):{v}case .err(p):{return .err(p);}};var current=switch(g::copy(env,c)){case .ok(v):{v}case .err(p):{return .err(p);}};let edge_start=v::len<g::Edge>(edges);let parent=c.loop;if(parent>=64){return .err(g::fail(c,10,s.start,s.end));}c.loop=parent+1;
    let body_live=switch(block(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,s.first,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};
    if(body_live){let after=switch(statement(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,post,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(after){let equal=switch(validate_edge(body,ref base,ref current,s,header_end,diagnostics,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(equal && s.kind!=18){discard switch(walk::expression(sources,primary,body,owners,ref mut current,edges,diagnostics,facts,s.expression,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};}}}
    var usize at=edge_start;while(at<v::len<g::Edge>(edges)){let edge=v::at<g::Edge>(edges,at);if(g::edge_loop(edge)!=parent+1){return .err(g::fail(c,12,s.start,s.end));}var selected=switch(g::copy(g::edge_cells(edge),c)){case .ok(v):{v}case .err(p):{return .err(p);}};let back=g::edge_back(edge);let dropped=g::cleanup_new(body,ref base,ref selected,if(back){4}else{3},g::edge_start(edge),g::edge_end(edge),facts,c);if(dropped.code!=0){return .err(dropped);}
        if(back && post!=0){discard switch(statement(sources,primary,body,owners,ref mut selected,edges,diagnostics,facts,post,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};}
        let equal=switch(validate_edge(body,ref base,ref selected,s,header_end,diagnostics,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(equal && back && s.kind!=18){discard switch(walk::expression(sources,primary,body,owners,ref mut selected,edges,diagnostics,facts,s.expression,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};}at+=1;
    }while(v::len<g::Edge>(edges)>edge_start){discard v::pop<g::Edge>(edges);}c.loop=parent;
    if(initial_binding!=0){let slot=v::at_mut<g::Cell>(env,initial_binding-1);*slot=g::empty();}return .ok(true);
}
pub fn Result<bool,m::Problem> statement(ref v::Vec<syntax::Parsed> sources,ref values::Plan primary,ref m::Values body,ref v::Vec<u8> owners,ref mut v::Vec<g::Cell> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<g::Diagnostic> diagnostics,ref mut v::Vec<g::Fact> facts,usize id,usize depth,ref mut g::Context c){
    if(id==0){return .ok(true);}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let s=syntax::statement_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}
    if(s.kind==8 || s.kind==14 || s.kind==18){return repeated(sources,primary,body,owners,env,edges,diagnostics,facts,s,depth+1,c);}
    if(s.kind==9 || s.kind==10){if(c.loop==0){return .err(g::fail(c,12,s.start,s.end));}let cells=switch(g::copy(env,c)){case .ok(v):{v}case .err(p):{return .err(p);}};if(v::len<g::Edge>(edges)>=1024 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}if(!v::push<g::Edge>(edges,g::edge(c.loop,s.kind==10,s.start,s.end,cells)).is_ok){return .err(g::fail(c,11,s.start,s.end));}return .ok(false);}
    if(s.kind==17){let live=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,s.expression,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};return if(live){block(sources,primary,body,owners,env,edges,diagnostics,facts,s.first,false,depth+1,c)}else{.ok(false)};}
    var usize binding=0;var usize after_target=0;var bool consuming=s.kind==3 || s.kind==4 || s.kind==16;
    if(s.kind==2){binding=switch(g::local(body,s.entry,2,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(binding==0){return .err(g::fail(c,12,s.start,s.end));}consuming=*v::at<u8>(owners,binding-1)!=0;}
    if(s.kind==4){let target=switch(g::expression(body,s.target,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(target.kind==2){binding=target.binding;}else if(target.kind==9){let live=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,s.target,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!live){return .ok(false);}consuming=false;}else{after_target=s.target;}}
    let live=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,s.expression,consuming,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!live){return .ok(false);}if(after_target!=0){let selected=switch(walk::expression(sources,primary,body,owners,env,edges,diagnostics,facts,after_target,false,depth+1,c)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!selected){return .ok(false);}}if(binding!=0 && *v::at<u8>(owners,binding-1)!=0){let before=*v::at<g::Cell>(env,binding-1);if(before.state!=3){if(s.kind==4 && before.state==1){let target=syntax::expression_at(source,s.target);let dropped=g::schedule(binding,m::local_at(body,binding).type,5,target.start,target.end,facts,c);if(dropped.code!=0){return .err(dropped);}}let p=g::produce(body,binding,s.start,s.end,env,facts,c);if(p.code!=0){return .err(p);}}}if(s.kind==3){let dropped=g::cleanup_live(body,env,2,s.start,s.end,facts,c);if(dropped.code!=0){return .err(dropped);}}
    if((s.kind==5 || s.kind==12) && s.expression!=0){let e=switch(g::expression(body,s.expression,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let owned=switch(g::owned(primary,e.type,c,0)){case .ok(b):{b}case .err(p):{return .err(p);}};if(owned){var selected=e;var usize groups=0;while(selected.kind==3){if(groups>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}selected=switch(g::expression(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};groups+=1;}if(selected.kind!=2){let dropped=g::schedule(0,e.type,8,e.start,e.end,facts,c);if(dropped.code!=0){return .err(dropped);}}}}
    return .ok(s.kind!=3);
}
