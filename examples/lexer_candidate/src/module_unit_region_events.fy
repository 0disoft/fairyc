module module_unit_region_events;
import module_unit_region_model as r;
import module_unit_region_walk as walk;
import module_unit_value_model as m;
import module_types as types;
import module_unit_interfaces as interfaces;
import syntax as syntax;
import std::vec as v;

pub fn Result<m::Expression,m::Problem> typed(ref v::Vec<m::Expression> expressions,usize original,ref mut r::Context c){let id=m::index(expressions,original);if(id==0 || !m::charge(ref mut c.work,1)){return .err(r::fail(c,if(id==0){12}else{10},0,0));}return .ok(*v::at<m::Expression>(expressions,id-1));}
pub fn Result<usize,m::Problem> binding(ref v::Vec<m::Expression> expressions,usize original,ref mut r::Context c){var usize id=original;var usize depth=0;while(id!=0 && depth<64){let e=switch(typed(expressions,id,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(e.kind==2){return .ok(e.binding);}if(e.kind!=3){return .ok(0);}id=e.left;depth+=1;}return .err(r::fail(c,10,0,0));}
pub fn m::Problem placement(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,m::Expression e,ref v::Vec<usize> active,ref v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut r::Context c){
    let field=switch(typed(expressions,e.left,c)){case .ok(e):{e}case .err(p):{return p;}};let capability=switch(binding(expressions,field.left,c)){case .ok(n):{n}case .err(p):{return p;}};if(capability==0 || capability>v::len<m::Local>(locals) || e.type==0 || e.type>types::count(graph)){return r::fail(c,12,e.start,e.end);}let local=*v::at<m::Local>(locals,capability-1);if(local.type==0 || types::at(graph,local.type).kind!=19){return r::fail(c,12,e.start,e.end);}var usize region_id=0;var usize i=v::len<usize>(active);while(i>0){i-=1;if(!m::charge(ref mut c.work,1)){return r::fail(c,10,e.start,e.end);}let id=*v::at<usize>(active,i);if(v::at<r::Scope>(regions,id-1).capability==capability){region_id=id;break;}}if(local.kind!=1 && (local.kind!=6 || region_id==0)){return r::fail(c,12,e.start,e.end);}
    let result=types::at(graph,e.type);if(result.kind!=6 || result.first==0 || result.first>types::count(graph) || result.second!=interfaces::region_error(imported)){return r::fail(c,12,e.start,e.end);}let borrow=types::at(graph,result.first);if(borrow.kind!=7 || borrow.first==0){return r::fail(c,12,e.start,e.end);}let argument=syntax::call_argument(source,e.source_index,0);let value=switch(typed(expressions,argument,c)){case .ok(e):{e}case .err(p):{return p;}};if(value.type!=borrow.first || v::len<r::Placement>(placements)>=16384){return r::fail(c,if(value.type!=borrow.first){12}else{10},e.start,e.end);}if(!m::charge(ref mut c.work,1)){return r::fail(c,10,e.start,e.end);}return if(v::push<r::Placement>(placements,r::Placement{.region_id=region_id,.capability,.expression=e.source_index,.argument,.owner_type=borrow.first,.borrow_type=result.first,.result_type=e.type,.error_type=result.second,.start=e.start,.end=e.end}).is_ok){r::fail(c,0,0,0)}else{r::fail(c,11,e.start,e.end)};
}
pub fn Result<usize,m::Problem> enter(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,syntax::Statement s,usize statement,usize depth,ref mut v::Vec<usize> active,ref mut v::Vec<r::Loop> loops,ref mut v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut v::Vec<r::Exit> exits,ref mut r::Context c){
    let input=switch(walk::expression(source,imported,graph,locals,expressions,s.expression,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((input&1)==0){return .ok(input);}let value=switch(typed(expressions,s.expression,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(value.type==0 || value.type>types::count(graph)){return .err(r::fail(c,12,value.start,value.end));}let source_type=types::at(graph,value.type);let arena=interfaces::region_arena(imported);if(source_type.kind!=8 || source_type.first!=arena || arena==0){return .err(r::fail(c,12,value.start,value.end));}var usize capability=1;while(capability<=v::len<m::Local>(locals)){if(!m::charge(ref mut c.work,1)){return .err(r::fail(c,10,s.start,s.end));}let local=*v::at<m::Local>(locals,capability-1);if(local.kind==6 && local.source_index==s.target){break;}capability+=1;}if(capability>v::len<m::Local>(locals)){return .err(r::fail(c,12,s.start,s.end));}let local=*v::at<m::Local>(locals,capability-1);let source_binding=switch(binding(expressions,s.expression,c)){case .ok(n):{n}case .err(p):{return .err(p);}};var usize owner=0;let root=value.place.root;if(root!=0 && root<=v::len<m::Local>(locals) && v::at<m::Local>(locals,root-1).type==arena){owner=root;}var u32 mode=if(source_binding!=0){2}else{3};if(value.kind==22){let inner=switch(typed(expressions,value.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(inner.kind==2 && owner!=0 && inner.binding==owner){mode=1;}}
    if(v::len<r::Scope>(regions)>=4096 || v::len<usize>(active)>=64 || !m::charge(ref mut c.work,1)){return .err(r::fail(c,10,s.start,s.end));}let body=syntax::statement_at(source,s.first);let usize parent=if(v::len<usize>(active)==0){0}else{*v::at<usize>(active,v::len<usize>(active)-1)};if(!v::push<r::Scope>(regions,r::Scope{.parent,.capability,.scope=local.scope,.statement,.body=s.first,.source=s.expression,.source_binding,.arena_owner=owner,.arena_type=arena,.source_type=value.type,.source_mode=mode,.start=s.start,.end=s.end,.body_start=body.start,.body_end=body.end}).is_ok){return .err(r::fail(c,11,s.start,s.end));}let id=v::len<r::Scope>(regions);if(!v::push<usize>(active,id).is_ok){return .err(r::fail(c,11,s.start,s.end));}let outcomes=switch(walk::block(source,imported,graph,locals,expressions,s.first,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((outcomes&1)!=0){let reset=r::resets(1,v::len<usize>(active)-1,0,s.start,s.end,active,exits,c);switch(reset){case .ok(_):{}case .err(p):{return .err(p);}};}switch(v::pop<usize>(active)){case .some(last):{if(last!=id){return .err(r::fail(c,12,s.start,s.end));}}case .none:{return .err(r::fail(c,12,s.start,s.end));}};return .ok((input&14)|outcomes);
}
