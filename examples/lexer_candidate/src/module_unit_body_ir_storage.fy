module module_unit_body_ir_storage;
import module_unit_body_ir_model as ir;
import module_unit_cleanup_mir_model as clean;
import module_unit_body_ir_verify as unsafe_proof;
import module_unit_value_model as m;
import module_unit_value_place as places;
import module_unit_value_storage as storage_value;
import module_unit_sdk_sources as sources;
import storage_intrinsics as storage;
import scalar_views as views;
import pointer_types as pointers;
import std::bytes as bytes;
import std::vec as v;

pub struct Arguments {bool valid;usize count;usize first;usize second;usize third;}
fn Arguments invalid(){return Arguments{.valid=false,.count=0,.first=0,.second=0,.third=0};}
pub fn Arguments arguments(ref ir::Body b,m::Expression e,ref mut usize work){var usize[3] ids=[0;3];var usize count=0;var usize link=e.right;while(link!=0){if(count>=3 || !m::charge(work,1)){return invalid();}let row=ir::node(b,link);if(row==0){return invalid();}let pair=ir::node_at(b,row-1).value;let child=ir::node(b,pair.left);if(pair.kind!=7 || child==0 || ir::node_at(b,child-1).value.state!=1){return invalid();}ids[count]=child;count+=1;link=pair.right;}return Arguments{.valid=true,.count,.first=if(count==0){0}else{ids[count-1]},.second=if(count<2){0}else{ids[count-2]},.third=if(count<3){0}else{ids[0]}};}
fn clean::Problem fail(clean::Frame f,u32 code,m::Expression e){return clean::Problem{.code,.module_index=f.module_index,.start=e.start,.end=e.end};}
fn bool pointer(ref ir::Program p,usize type){let t=clean::type_at(ir::cleanup_ir(p),type);return t.kind==12 && t.first==0 && t.scalar==pointers::make(7,true);}
fn usize element(ref ir::Program p,usize type){if(type==0){return 0;}let t=clean::type_at(ir::cleanup_ir(p),type);if(t.kind==13){return t.first;}if(t.kind==7 || t.kind==8){let inner=clean::type_at(ir::cleanup_ir(p),t.first);return if(inner.kind==13){inner.first}else{t.first};}if(t.kind==5 || t.kind==6){let inner=clean::type_at(ir::cleanup_ir(p),t.first);return if(inner.kind==13){inner.first}else{t.first};}return 0;}
// The pinned Vec destructor folds its private take_slot<T> leaf to storage_take.
// Only that receiver-specialized destructor inherits the leaf unsafe scope.
fn clean::Problem scoped_check(ref ir::Program p,ref ir::Body b,usize frame,bool cached,bool allowed,ref v::Vec<usize> blocks,ref mut usize work){let f=clean::frame_at(ir::cleanup_ir(p),frame);var usize i=0;while(i<ir::node_count(b)){if(!m::charge(work,1)){return clean::Problem{.code=1002,.module_index=f.module_index,.start=0,.end=0};}let e=ir::node_at(b,i).value;let code=e.builtin.kind;if(e.kind==6 && code>=101 && code<=107){let unit=sources::find(ir::sdk_units(p),f.module_index);let callee=ir::node(b,e.left);if(unit==0 || sources::at(ir::sdk_units(p),unit-1).sdk_id!=8 || e.state!=1 || callee==0 || e.builtin.element==0 || e.builtin.element>clean::type_count(ir::cleanup_ir(p))){return fail(f,1001,e);}let g=ir::node_at(b,callee-1).value;let base=ir::node(b,g.left);let receiver=clean::type_at(ir::cleanup_ir(p),if(f.receiver_type==0){e.builtin.element}else{f.receiver_type});let inline_take=code==103 && f.kind==2 && receiver.kind==13 && receiver.module_index==f.module_index && receiver.declaration==f.declaration && receiver.first==e.builtin.element && !e.builtin.slice && base!=0 && bytes::equal(ir::node_text(b,base-1),b"take_slot");if(g.kind!=20 || base==0 || ir::node_at(b,base-1).value.kind!=2 || !inline_take && storage::named(ir::node_text(b,base-1))+100!=code || g.builtin.kind!=code || g.builtin.element!=e.builtin.element || g.builtin.slice!=e.builtin.slice){return fail(f,1001,e);}
        let original=sources::source_at(ir::sdk_units(p),unit-1);let name=ir::node_text(b,base-1);if(g.start>=g.end || g.end>original.len || name.len>=g.end-g.start || !bytes::equal(original[g.start..g.start+name.len],name) || original[g.start+name.len]!=60){return fail(f,1001,e);}let t=clean::type_at(ir::cleanup_ir(p),e.builtin.element);if(!(t.kind==1 && t.scalar>=1 && t.scalar<=6 || t.kind>=2 && t.kind<=4)){return fail(f,1001,e);}
        let args=arguments(b,e,work);let usize count=if(code<=102){0}else if(code==103){1}else if(e.builtin.slice){3}else{2};if(!args.valid || args.count!=count || e.builtin.slice && (code<106 || code>107) || code>102 && (!e.builtin.unsafe_context || !inline_take && !if(cached){allowed || unsafe_proof::unsafe_in(b,blocks,e,work)}else{unsafe_proof::unsafe_scope(p,b,frame,e,work)})){return fail(f,if(*work>=1048576){1002}else{1001},e);}let result=clean::type_at(ir::cleanup_ir(p),e.type);
        if(code<=102){if(result.kind!=1 || result.scalar!=5 || element(p,f.result)!=e.builtin.element){return fail(f,1001,e);}}
        else if(code<=105){if(!pointer(p,ir::node_at(b,args.first-1).value.type)){return fail(f,1001,e);}if(code==103 && e.type!=e.builtin.element || code==104 && (result.kind!=1 || result.scalar!=7 || ir::node_at(b,args.second-1).value.type!=e.builtin.element) || code==105 && (!pointer(p,e.type) || element(p,f.result)!=e.builtin.element || clean::type_at(ir::cleanup_ir(p),ir::node_at(b,args.second-1).value.type).scalar!=5)){return fail(f,1001,e);}}
        else{let owner=ir::node_at(b,args.first-1).value;let ot=clean::type_at(ir::cleanup_ir(p),owner.type);let dt=clean::type_at(ir::cleanup_ir(p),ir::node_at(b,args.second-1).value.type);let exclusive=code==107;if((ot.kind!=7 && ot.kind!=8) || (ot.kind==8)!=exclusive || element(p,owner.type)!=e.builtin.element || dt.kind!=12 || dt.first!=0 || pointers::inner(dt.scalar)!=7 || exclusive && !pointers::mutable(dt.scalar) || !places::same(e.place,storage_value::projected(e,owner.place))){return fail(f,1001,e);}if(e.builtin.slice){let length=clean::type_at(ir::cleanup_ir(p),ir::node_at(b,args.third-1).value.type);if(length.kind!=1 || length.scalar!=5){return fail(f,1001,e);}if(t.kind==2){if(result.kind!=if(exclusive){18}else{17} || result.first!=e.builtin.element){return fail(f,1001,e);}}else{let expected=views::make(t.scalar,exclusive);if(result.kind!=if(expected==10){10}else if(expected==11){11}else{15} || result.scalar!=if(views::extended(expected)){expected}else{0}){return fail(f,1001,e);}}}else if(result.kind!=if(exclusive){8}else{7} || result.first!=e.builtin.element){return fail(f,1001,e);}}
    }i+=1;}return clean::Problem{.code=0,.module_index=0,.start=0,.end=0};
}

pub fn clean::Problem check(ref ir::Program p,ref ir::Body b,usize frame,ref mut usize work){let blocks=v::empty<usize>();return scoped_check(p,b,frame,false,false,ref blocks,work);}
pub fn clean::Problem check_scopes(ref ir::Program p,ref ir::Body b,usize frame,bool allowed,ref v::Vec<usize> blocks,ref mut usize work){return scoped_check(p,b,frame,true,allowed,blocks,work);}
