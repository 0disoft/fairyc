module module_constant_types;
import module_unit_value_model as m;
import module_constant_model as model;
import syntax as syntax;
import type_state as scalars;
import std::bytes as bytes;
import std::vec as v;
import c_abi_types as casts;
// All branches are type checked even when evaluation will short circuit.
pub fn Result<u32,m::Problem> expression(ref v::Vec<syntax::Parsed> sources,ref v::Vec<model::Entry> entries,ref v::Vec<model::Parameter> parameters,usize module_index,usize id,u32 expected,usize context,ref mut usize work,usize depth){
    let source=v::at<syntax::Parsed>(sources,module_index);let e=syntax::expression_at(source,id);if(depth>=64 || !model::charge(work)){return .err(model::fail(module_index,4304,e.start,e.end));}let raw=syntax::expression_text(source,id);
    if(e.kind==1){if(bytes::equal(raw,b"true") || bytes::equal(raw,b"false")){return .ok(6);}let u32 scalar=if(model::admitted(expected) && expected!=6){expected}else{1};return if(scalars::fits(raw,scalar,false)){.ok(scalar)}else{.err(model::fail(module_index,1013,e.start,e.end))};}
    if(e.kind==2){let parameter=switch(model::parameter(source,entries,parameters,context,raw,e.start,e.end,work)){case .ok(n):{n}case .err(p):{return .err(p);}};if(parameter!=0){return .ok(v::at<model::Parameter>(parameters,parameter-1).scalar);}let target=switch(model::find(sources,entries,module_index,raw,e.start,e.end,work)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok(v::at<model::Entry>(entries,target-1).value.scalar);}
    if(e.kind==3){return expression(sources,entries,parameters,module_index,e.left,expected,context,work,depth+1);}
    if(e.kind==4){if(bytes::equal(raw,b"-")){let u32 signed=if(expected==2){2}else{1};let minimum=switch(model::signed_minimum(source,module_index,e.left,signed,work)){case .ok(v):{v}case .err(p):{return .err(p);}};if(minimum){return .ok(signed);}}
        let scalar=switch(expression(sources,entries,parameters,module_index,e.left,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};if(bytes::equal(raw,b"!")){let child=syntax::expression_at(source,e.left);return if(scalar==6){.ok(6)}else{.err(model::fail(module_index,1007,child.start,child.end))};}let valid=if(bytes::equal(raw,b"~")){scalar!=6}else{scalar==1 || scalar==2};return if(valid){.ok(scalar)}else{.err(model::fail(module_index,1006,e.start,e.end))};
    }
    if(e.kind==5){var u32 left=0;var u32 right=0;let logical=bytes::equal(raw,b"&&") || bytes::equal(raw,b"||");let a=switch(model::flexible(source,module_index,e.left,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};let b=switch(model::flexible(source,module_index,e.right,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};
        if(!logical && a && !b){right=switch(expression(sources,entries,parameters,module_index,e.right,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};left=switch(expression(sources,entries,parameters,module_index,e.left,right,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}else{left=switch(expression(sources,entries,parameters,module_index,e.left,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};right=switch(expression(sources,entries,parameters,module_index,e.right,left,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}
        if(logical){let bad=syntax::expression_at(source,if(left!=6){e.left}else{e.right});return if(left==6 && right==6){.ok(6)}else{.err(model::fail(module_index,1007,bad.start,bad.end))};}if(left!=right){let bad=syntax::expression_at(source,e.right);return .err(model::fail(module_index,1006,bad.start,bad.end));}if(scalars::comparison(raw)){return if(left!=6 || scalars::equal(raw)){.ok(6)}else{.err(model::fail(module_index,1006,e.start,e.end))};}return if(left!=6){.ok(left)}else{.err(model::fail(module_index,1006,e.start,e.end))};
    }
    if(e.kind==6){let target=switch(model::callee(sources,entries,parameters,module_index,id,context,work)){case .ok(n):{n}case .err(p):{return .err(p);}};let row=*v::at<model::Entry>(entries,target-1);var usize i=0;while(i<row.parameter_count){let argument=syntax::call_argument(source,id,i);let expected=v::at<model::Parameter>(parameters,row.parameter_start+i).scalar;let scalar=switch(expression(sources,entries,parameters,module_index,argument,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};if(scalar!=expected){let e=syntax::expression_at(source,argument);return .err(model::fail(module_index,1006,e.start,e.end));}i+=1;}return .ok(row.value.scalar);}
    if(e.kind==23){let target=scalars::primitive(source,e.right);let actual=switch(expression(sources,entries,parameters,module_index,e.left,0,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};return if(casts::allowed(actual,target)){.ok(target)}else{.err(model::fail(module_index,4303,e.start,e.end))};}
    if(e.kind==12){let tail=switch(model::tail(source,module_index,e.left)){case .ok(n):{n}case .err(p):{return .err(p);}};return expression(sources,entries,parameters,module_index,tail,expected,context,work,depth+1);}
    if(e.kind==13){let branch=syntax::expression_at(source,e.right);let condition=switch(expression(sources,entries,parameters,module_index,e.left,6,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};if(condition!=6){let e=syntax::expression_at(source,e.left);return .err(model::fail(module_index,1007,e.start,e.end));}let tail=switch(model::tail(source,module_index,branch.left)){case .ok(n):{n}case .err(p):{return .err(p);}};
        let a=switch(model::flexible(source,module_index,tail,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};let b=switch(model::flexible(source,module_index,branch.right,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};var u32 left=0;var u32 right=0;
        if(a && !b){right=switch(expression(sources,entries,parameters,module_index,branch.right,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};left=switch(expression(sources,entries,parameters,module_index,tail,right,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}else{left=switch(expression(sources,entries,parameters,module_index,tail,expected,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};right=switch(expression(sources,entries,parameters,module_index,branch.right,left,context,work,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}
        return if(left==right){.ok(left)}else{.err(model::fail(module_index,1006,e.start,e.end))};
    }
return .err(model::fail(module_index,4302,e.start,e.end));
}
