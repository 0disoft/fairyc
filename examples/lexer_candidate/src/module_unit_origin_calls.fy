module module_unit_origin_calls;
import module_unit_origin_flow as flow;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_origin_flow_model as g;
import module_unit_values as values;
import module_unit_value_model as m;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;
import module_unit_origin_provenance as p;
import module_unit_loan_checks as loans;
import module_unit_loan_model as loan;
import module_unit_loan_reference as references;
import module_unit_loan_generations as generations;
import module_unit_loan_facts as facts;
import module_unit_loan_owner_reads as owner_reads;

// Argument snapshots retain both origin identity and each Region allocation.
fn Result<g::Value,m::Problem> substitute(ref inputs::Inputs input,ref m::Values body,usize target,m::Invocation call,ref v::Vec<g::Value> arguments,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut g::Context c){
    if(target==0){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}let summary=*v::at<g::Value>(summaries,target-1);if(summary.origin<=1){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}if(summary.origin==sets::empty()){return .ok(summary);}let f=inputs::frame(input,target);if(f.parameter_count!=call.argument_count || v::len<g::Value>(arguments)!=call.argument_count){return .err(g::fail(c,12,call.start,call.end));}var g::Value result=g::Value{.subview=false,.loan=0,.origin=0,.allocation=0};var usize i=0;
    while(i<sets::count(entries,members,summary.origin)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,call.start,call.end));}let leaf=sets::member(entries,members,summary.origin,i);var g::Value actual=g::Value{.subview=false,.loan=0,.origin=2,.allocation=0};if(leaf!=2){let owner=sets::owner_id(leaf);if(owner==0 || owner>inputs::owner_count(input)){return .err(g::fail(c,12,call.start,call.end));}let local=inputs::owner(input,owner);if(local.kind==11){actual.origin=leaf;}else{if(local.frame!=target || (local.kind!=1 && local.kind!=13) || !local.borrowed){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}var usize ordinal=0;var bool found=false;while(ordinal<f.parameter_count){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,call.start,call.end));}if(inputs::parameter(input,target,ordinal)==owner){found=true;break;}ordinal+=1;}if(!found){return .err(g::fail(c,12,call.start,call.end));}actual=*v::at<g::Value>(arguments,ordinal);if(actual.origin==0){actual=g::Value{.subview=false,.loan=0,.origin=1,.allocation=0};}if(local.kind==13){let site=switch(p::lookup(allocations,summary.allocation,leaf,ref mut c.work)){case .ok(n):{n}case .err(code):{return .err(g::fail(c,code,call.start,call.end));}};if(site==0){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}actual=switch(g::allocated(allocations,c,actual.origin,site,call.start,call.end)){case .ok(n):{n}case .err(p):{return .err(p);}};}}}
        result=switch(g::join_value(entries,members,allocations,c,result,actual,call.start,call.end)){case .ok(n):{n}case .err(p):{return .err(p);}};i+=1;
    }return .ok(result);
}
pub fn Result<g::Flow,m::Problem> evaluate(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize original,usize depth,ref syntax::Parsed source,ref m::Values body,m::Expression e,bool descriptor,g::Flow left){let held_base=loans::held_count(held_loans);var v::Vec<usize> order=v::empty<usize>();var v::Vec<g::Value> arguments=v::empty<g::Value>();var usize link=e.right;let u32 kind=if(e.kind==6){7}else if(e.kind==10){11}else{25};
        while(link!=0){let row=syntax::expression_at(source,link);if(!m::charge(ref mut c.work,1) || v::len<usize>(ref order)>=1024){return .err(g::fail(c,10,row.start,row.end));}if(row.kind!=kind){return .err(g::fail(c,12,row.start,row.end));}if(!v::push<usize>(ref mut order,row.left).is_ok){return .err(g::fail(c,11,row.start,row.end));}link=row.right;}
        var usize outcomes=left.outcomes;var usize i=v::len<usize>(ref order);while(i>0 && (outcomes & 1)!=0){i-=1;if(e.kind==6){let argument=*v::at<usize>(ref order,i);let checked=loans::moved(input,primary,body,argument,c.statement,env,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let prior_place=c.place_root;if(e.kind==6 && v::len<g::Value>(ref arguments)!=0 && (e.builtin.kind>=9 && e.builtin.kind<=12 || e.builtin.kind==106 || e.builtin.kind==107)){let selected=switch(owner_reads::metadata_root(body,syntax::call_argument(source,original,0),*v::at<usize>(ref order,i),c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(selected!=0){c.place_root=selected;}}let evaluated=flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,*v::at<usize>(ref order,i),depth+1);c.place_root=prior_place;let next=switch(evaluated){case .ok(f):{f}case .err(p):{return .err(p);}};outcomes=(outcomes & 14) | next.outcomes;if(!v::push<g::Value>(ref mut arguments,g::value(next)).is_ok){return .err(g::fail(c,11,e.start,e.end));}if(e.kind==6){let argument=syntax::expression_at(source,*v::at<usize>(ref order,i));let kind=switch(loans::argument_kind(input,primary,body,original,v::len<g::Value>(ref arguments)-1,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(kind==1){let actual=switch(g::expression(body,*v::at<usize>(ref order,i),c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(actual.type!=0 && inputs::type_at(input,primary,c.frame,actual.type).kind==8){let root=switch(references::root(body,actual.source_index,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};let seeded=switch(facts::seed(g::value(next),false,parent,argument.start,argument.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};let argument_index=v::len<g::Value>(ref arguments)-1;let slot=v::at_mut<g::Value>(ref mut arguments,argument_index);*slot=seeded;}}if(kind!=0){let checked=references::access(input,primary,body,env,*v::at<usize>(ref order,i),g::value(next),kind==2,argument.start,argument.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let held=loans::hold(g::value(next),kind==2,kind!=0,held_loans,c,argument.start,argument.end);if(held.code!=0){return .err(held);}}}
        var usize allocation=0;var usize origin=0;var usize loan_set=0;if(descriptor && (outcomes & 1)!=0){origin=1;if(e.kind==6 && syntax::expression_at(source,e.left).kind==28){let name=syntax::expression_text(source,e.left);let t=inputs::type_at(input,primary,c.frame,e.type);if(!(t.kind==5 && bytes::equal(name,b"some") || t.kind==6 && (bytes::equal(name,b"ok") || bytes::equal(name,b"err"))) || v::len<g::Value>(ref arguments)!=1){return .err(g::fail(c,12,e.start,e.end));}let value=*v::at<g::Value>(ref arguments,0);origin=if(value.origin==0){sets::empty()}else{value.origin};allocation=value.allocation;loan_set=value.loan;}else if(e.kind==6 && e.builtin.kind==200){origin=switch(inputs::static_owner(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n+2}case .err(p):{return .err(p);}};let seeded=switch(facts::seed(g::Value{.subview=false,.loan=0,.origin,.allocation=0},false,0,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};loan_set=seeded.loan;}else if(e.kind==6 && (e.builtin.kind>=9 && e.builtin.kind<=12 || e.builtin.kind==106 || e.builtin.kind==107)){if(v::len<g::Value>(ref arguments)==0){return .err(g::fail(c,12,e.start,e.end));}var value=*v::at<g::Value>(ref arguments,0);if(e.builtin.kind==107 && e.builtin.slice){let argument=syntax::call_argument(source,original,0);let root=switch(references::root(body,argument,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};value=switch(generations::child(value,parent,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}origin=value.origin;allocation=value.allocation;loan_set=value.loan;}else if(e.kind==6){let position=switch(g::invocation(body,original,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(position!=0){i=position-1;let call=m::call_at(body,i);if(!call.checked){return .err(g::fail(c,12,e.start,e.end));}let value=switch(substitute(input,body,inputs::target(input,c.frame,i),call,ref arguments,summaries,entries,members,allocations,c)){case .ok(n):{n}case .err(p):{return .err(p);}};var selected=value;let target=inputs::target(input,c.frame,i);if(target!=0 && v::at<g::Value>(summaries,target-1).subview){selected=switch(generations::child(value,0,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}origin=selected.origin;allocation=selected.allocation;loan_set=selected.loan;}}}loans::release(held_base,held_loans);return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes});
}
