module generic_source_view_loop_json;
import generic_source_json as json;
import syntax as syntax;
import std::bytes as bytes;

fn ref u8[] bound_name(){return b"\x00fairyc_byte_for_bound";}
fn ref u8[] index_name(){return b"\x00fairyc_byte_for_index";}
pub struct Context{usize start;usize end;usize name_start;usize name_end;usize view_start;usize view_end;}
pub fn Context context(ref syntax::Parsed p,syntax::Statement s){let name=syntax::expression_at(p,s.target);let view=syntax::expression_at(p,s.expression);return Context{.start=s.start,.end=s.end,.name_start=name.start,.name_end=name.end,.view_start=view.start,.view_end=view.end};}
pub fn bool valid(ref syntax::Parsed p,syntax::Statement s,ref mut json::Ledger work){if(!json::charge(work,1)){return false;}if(s.kind!=18 || s.target==0 || s.target>syntax::expression_count(p) || s.expression==0 || s.expression>syntax::expression_count(p) || s.second==0 || s.second>syntax::type_count(p) || s.first==0 || s.first>syntax::statement_count(p)){return json::reject(work,9);}let name=syntax::expression_at(p,s.target);let view=syntax::expression_at(p,s.expression);return if(syntax::statement_at(p,s.first).kind==1 && name.kind==17 && name.start<=name.end && name.end<=syntax::source_view(p).len && view.start<=view.end && view.end<=syntax::source_view(p).len){true}else{json::reject(work,9)};}
pub fn bool admitted(ref syntax::Parsed p,syntax::Statement s,ref mut json::Ledger work){if(!valid(p,s,work)){return false;}var usize item=s.second;let written=syntax::type_at(p,item);
    if(written.kind==3){item=written.left;if(item==0 || item>=s.second){discard json::reject(work,9);return false;}}if(syntax::type_at(p,item).kind!=1){return false;}
    var usize view=s.expression;if(syntax::expression_at(p,view).kind==26){view=syntax::expression_at(p,view).left;if(view==0 || view>=s.expression){discard json::reject(work,9);return false;}}
    let first=syntax::expression_at(p,view);if(first.kind==2 || first.kind==28){return true;}
    while(syntax::expression_at(p,view).kind==3){if(!json::charge(work,1)){return false;}let next=syntax::expression_at(p,view).left;if(next==0 || next>=view){discard json::reject(work,9);return false;}view=next;}
    if(syntax::expression_at(p,view).kind!=8){return false;}
    while(true){if(!json::charge(work,1)){return false;}let n=syntax::expression_at(p,view);if(n.kind==2 || n.kind==28){return true;}if(n.kind!=3 && n.kind!=8){return false;}if(n.left==0 || n.left>=view){discard json::reject(work,9);return false;}view=n.left;}return false;
}
fn bool prefix(ref u8[] kind,usize start,usize end,ref u8[] text,ref u8[] cooked,ref mut bytes::Buffer out,ref mut json::Ledger work){return json::raw(out,b"{\"TypeArguments\":null,\"Kind\":",work) && json::quoted(out,kind,work) && json::raw(out,b",\"Span\":",work) && json::span(out,start,end,work) && json::raw(out,b",\"Text\":",work) && json::quoted(out,text,work) && json::raw(out,b",\"Cooked\":",work) && json::quoted(out,cooked,work) && json::raw(out,b",\"Type\":null,\"Children\":",work);}
fn bool leaf(ref u8[] kind,Context c,ref u8[] name,ref mut bytes::Buffer out,ref mut json::Ledger work){return prefix(kind,c.name_start,c.name_end,name,if(bytes::equal(kind,b"literal")){name}else{b""},out,work) && json::raw(out,b"null,\"Block\":null}",work);}
fn bool usize_type(Context c,ref mut bytes::Buffer out,ref mut json::Ledger work){return json::raw(out,b"{\"Kind\":\"named\",\"Text\":\"usize\",\"Span\":",work) && json::span(out,c.name_start,c.name_end,work) && json::raw(out,b",\"Path\":\"usize\",\"Mutable\":false,\"Element\":null,\"Arguments\":null,\"Parameters\":null,\"Result\":null,\"Length\":null,\"ABI\":\"\"}",work);}
fn bool statement_prefix(ref u8[] kind,usize start,usize end,ref u8[] operator,ref mut bytes::Buffer out,ref mut json::Ledger work){return json::raw(out,b"{\"Kind\":",work) && json::quoted(out,kind,work) && json::raw(out,b",\"Span\":",work) && json::span(out,start,end,work) && json::raw(out,b",\"Operator\":",work) && json::quoted(out,operator,work) && json::raw(out,b",\"Binding\":",work);}
fn bool binding_prefix(ref u8[] name,bool mutable,Context c,bool loop_span,ref mut bytes::Buffer out,ref mut json::Ledger work){return json::raw(out,b"{\"Name\":",work) && json::quoted(out,name,work) && json::raw(out,b",\"Mutable\":",work) && json::flag(out,mutable,work) && json::raw(out,b",\"Span\":",work) && json::span(out,if(loop_span){c.start}else{c.name_start},if(loop_span){c.end}else{c.name_end},work) && json::raw(out,b",\"NameSpan\":",work) && json::span(out,c.name_start,c.name_end,work) && json::raw(out,b",\"Type\":",work);}
fn bool binding_tail(ref mut bytes::Buffer out,ref mut json::Ledger work){return json::raw(out,b"},\"Target\":null,\"Expression\":null,\"For\":null,\"ByteFor\":null}",work);}
pub fn bool item(ref syntax::Parsed p,syntax::Statement s,ref u8[] view,ref u8[] type,ref mut bytes::Buffer out,ref mut json::Ledger work){if(!valid(p,s,work)){return false;}let c=context(p,s);let mutable=syntax::type_at(p,s.second).kind==3;
    var bytes::Buffer name=bytes::empty();if(!json::raw(ref mut name,syntax::source_view(p)[c.name_start..c.name_end],work)){return false;}
    if(!statement_prefix(b"binding",c.name_start,c.name_end,b"",out,work) || !binding_prefix(bytes::view(ref name),false,c,false,out,work) || !json::raw(out,type,work) || !json::raw(out,b",\"Expression\":",work)){return false;}
    if(mutable && (!prefix(b"prefix",c.name_start,c.name_end,b"&mut",b"",out,work) || !json::raw(out,b"[",work))){return false;}
    if(!prefix(b"index",c.view_start,c.view_end,b"",b"",out,work) || !json::raw(out,b"[",work) || !json::raw(out,view,work) || !json::raw(out,b",",work) || !leaf(b"path",c,index_name(),out,work) || !json::raw(out,b"],\"Block\":null}",work)){return false;}
    if(mutable && !json::raw(out,b"],\"Block\":null}",work)){return false;}return binding_tail(out,work);
}
fn bool bound(Context c,ref u8[] view,ref mut bytes::Buffer out,ref mut json::Ledger work){return statement_prefix(b"binding",c.name_start,c.name_end,b"",out,work) && binding_prefix(bound_name(),false,c,true,out,work) && usize_type(c,out,work) && json::raw(out,b",\"Expression\":",work) && prefix(b"field-expression",c.view_start,c.view_end,b"len",b"",out,work) && json::raw(out,b"[",work) && json::raw(out,view,work) && json::raw(out,b"],\"Block\":null}",work) && binding_tail(out,work);}
fn bool initializer(Context c,ref mut bytes::Buffer out,ref mut json::Ledger work){return statement_prefix(b"binding",c.name_start,c.name_end,b"",out,work) && binding_prefix(index_name(),true,c,true,out,work) && usize_type(c,out,work) && json::raw(out,b",\"Expression\":",work) && leaf(b"literal",c,b"0",out,work) && binding_tail(out,work);}
fn bool condition(Context c,ref mut bytes::Buffer out,ref mut json::Ledger work){return prefix(b"binary",c.view_start,c.view_end,b"<",b"",out,work) && json::raw(out,b"[",work) && leaf(b"path",c,index_name(),out,work) && json::raw(out,b",",work) && leaf(b"path",c,bound_name(),out,work) && json::raw(out,b"],\"Block\":null}",work);}
fn bool post(Context c,ref mut bytes::Buffer out,ref mut json::Ledger work){return statement_prefix(b"assignment",c.name_start,c.name_end,b"+=",out,work) && json::raw(out,b"null,\"Target\":",work) && leaf(b"path",c,index_name(),out,work) && json::raw(out,b",\"Expression\":",work) && leaf(b"literal",c,b"1",out,work) && json::raw(out,b",\"For\":null,\"ByteFor\":null}",work);}
pub fn bool synthetic(ref syntax::Parsed p,syntax::Statement s,ref u8[] view,ref u8[] body,ref mut bytes::Buffer out,ref mut json::Ledger work){if(!valid(p,s,work)){return false;}let c=context(p,s);
    if(!prefix(b"block",c.start,c.end,b"",b"",out,work) || !json::raw(out,b"null,\"Block\":{\"Span\":",work) || !json::span(out,c.start,c.end,work) || !json::raw(out,b",\"Statements\":[",work) || !bound(c,view,out,work) || !json::raw(out,b",",work) || !statement_prefix(b"for",c.start,c.end,b"",out,work) || !json::raw(out,b"null,\"Target\":null,\"Expression\":null,\"For\":{\"Span\":",work) || !json::span(out,c.start,c.end,work) || !json::raw(out,b",\"Initializer\":",work) || !initializer(c,out,work) || !json::raw(out,b",\"Condition\":",work) || !condition(c,out,work) || !json::raw(out,b",\"Post\":",work) || !post(c,out,work) || !json::raw(out,b",\"Body\":",work) || !json::raw(out,body,work)){return false;}
    return json::raw(out,b"},\"ByteFor\":null}],\"Tail\":null}}",work);
}
