module module_body_artifact_encode;
import module_unit_body_ir_model as ir;
import module_unit_body_ir_verify as proof;
import module_unit_cleanup_mir_model as clean;
import module_body_artifact_wire as wire;
import candidate_artifact_wire as common;
// FYBODY00: frame, body/source-byte/start/end header; eight ordered tables;
// exact byte text. Only a verified Program supplies the immutable body owner.
pub fn Result<common::Payload,u32> encode(ref ir::Program p,usize frame,ref mut usize work){
    if(!wire::charge(work,0)){return .err(1002);}if(frame==0 || frame>ir::count(p)){return .err(1001);}let b=ir::at(p,frame);var usize measured=0;let checked=proof::check_body(b,ir::cleanup_ir(p),frame,ref mut measured);if(!wire::charge(work,measured)){return .err(1002);}if(checked.code!=0){return .err(checked.code);}var wire::Status status=wire::Status{.code=0};var out=wire::writer(b"FYBODY00",ref mut status,work);wire::number(ref mut out,frame,ref mut status,work);
    wire::number(ref mut out,ir::body(b),ref mut status,work);
    wire::number(ref mut out,ir::source_bytes(b),ref mut status,work);
    wire::number(ref mut out,ir::start(b),ref mut status,work);
    wire::number(ref mut out,ir::end(b),ref mut status,work);
    var usize i=0;
    wire::number(ref mut out,ir::node_count(b),ref mut status,work);i=0;while(i<ir::node_count(b)){let row=ir::node_at(b,i);
        wire::number(ref mut out,row.value.constant,ref mut status,work);
        wire::number(ref mut out,row.value.constant_bits,ref mut status,work);
        wire::number(ref mut out,row.value.source_index,ref mut status,work);
        wire::number(ref mut out,row.value.binding,ref mut status,work);
        wire::number(ref mut out,row.value.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.value.start,ref mut status,work);
        wire::number(ref mut out,row.value.end,ref mut status,work);
        wire::number(ref mut out,row.value.left,ref mut status,work);
        wire::number(ref mut out,row.value.right,ref mut status,work);
        wire::number(ref mut out,row.value.target,ref mut status,work);
        wire::number(ref mut out,row.value.field.id,ref mut status,work);
        wire::number(ref mut out,row.value.field.owner,ref mut status,work);
        wire::number(ref mut out,row.value.field.module_index,ref mut status,work);
        wire::number(ref mut out,row.value.field.declaration,ref mut status,work);
        wire::number(ref mut out,row.value.field.source_index,ref mut status,work);
        wire::number(ref mut out,row.value.place.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.value.place.root,ref mut status,work);
        wire::number(ref mut out,row.value.place.scope,ref mut status,work);
        wire::number(ref mut out,row.value.place.projection,ref mut status,work);
        wire::number(ref mut out,if(row.value.place.mutable){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.value.place.indirect){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.value.place.resource_field){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.value.place.borrowable){1}else{0},ref mut status,work);
        wire::number(ref mut out,row.value.builtin.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.value.builtin.element,ref mut status,work);
        wire::number(ref mut out,if(row.value.builtin.slice){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.value.builtin.unsafe_context){1}else{0},ref mut status,work);
        wire::number(ref mut out,row.value.expected,ref mut status,work);
        wire::number(ref mut out,row.value.type,ref mut status,work);
        wire::number(ref mut out,row.value.state as usize,ref mut status,work);
        wire::number(ref mut out,if(row.value.flexible){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.value.minimum){1}else{0},ref mut status,work);
        wire::number(ref mut out,row.syntax.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.syntax.start,ref mut status,work);
        wire::number(ref mut out,row.syntax.end,ref mut status,work);
        wire::number(ref mut out,row.syntax.token,ref mut status,work);
        wire::number(ref mut out,row.syntax.left,ref mut status,work);
        wire::number(ref mut out,row.syntax.right,ref mut status,work);
        wire::number(ref mut out,row.literal_kind as usize,ref mut status,work);
        wire::number(ref mut out,row.text_start,ref mut status,work);
        wire::number(ref mut out,row.text_end,ref mut status,work);
        wire::number(ref mut out,row.cooked_start,ref mut status,work);
        wire::number(ref mut out,row.cooked_end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::statement_count(b),ref mut status,work);i=0;while(i<ir::statement_count(b)){let row=ir::statement_at(b,i);
        wire::number(ref mut out,row.source_index,ref mut status,work);
        wire::number(ref mut out,row.value.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.value.start,ref mut status,work);
        wire::number(ref mut out,row.value.end,ref mut status,work);
        wire::number(ref mut out,row.value.expression,ref mut status,work);
        wire::number(ref mut out,row.value.target,ref mut status,work);
        wire::number(ref mut out,row.value.first,ref mut status,work);
        wire::number(ref mut out,row.value.second,ref mut status,work);
        wire::number(ref mut out,row.value.entry,ref mut status,work);
        wire::number(ref mut out,row.value.operator,ref mut status,work);
        wire::number(ref mut out,row.operator_start,ref mut status,work);
        wire::number(ref mut out,row.operator_end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::local_count(b),ref mut status,work);i=0;while(i<ir::local_count(b)){let row=ir::local_at(b,i+1);
        wire::number(ref mut out,row.header_start,ref mut status,work);
        wire::number(ref mut out,row.header_end,ref mut status,work);
        wire::number(ref mut out,row.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.source_index,ref mut status,work);
        wire::number(ref mut out,row.initializer,ref mut status,work);
        wire::number(ref mut out,row.expected,ref mut status,work);
        wire::number(ref mut out,row.type,ref mut status,work);
        wire::number(ref mut out,row.scope,ref mut status,work);
        wire::number(ref mut out,row.origin.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.origin.root,ref mut status,work);
        wire::number(ref mut out,row.origin.scope,ref mut status,work);
        wire::number(ref mut out,row.origin.projection,ref mut status,work);
        wire::number(ref mut out,if(row.origin.mutable){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.origin.indirect){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.origin.resource_field){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.origin.borrowable){1}else{0},ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::call_count(b),ref mut status,work);i=0;while(i<ir::call_count(b)){let row=ir::call_at(b,i);
        wire::number(ref mut out,row.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.expression,ref mut status,work);
        wire::number(ref mut out,row.source_index,ref mut status,work);
        wire::number(ref mut out,row.target_module,ref mut status,work);
        wire::number(ref mut out,row.target_declaration,ref mut status,work);
        wire::number(ref mut out,row.instance,ref mut status,work);
        wire::number(ref mut out,row.argument_start,ref mut status,work);
        wire::number(ref mut out,row.argument_count,ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        wire::number(ref mut out,if(row.checked){1}else{0},ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::argument_count(b),ref mut status,work);i=0;while(i<ir::argument_count(b)){let row=ir::argument_at(b,i);
        wire::number(ref mut out,row.invocation,ref mut status,work);
        wire::number(ref mut out,row.position,ref mut status,work);
        wire::number(ref mut out,row.expression,ref mut status,work);
        wire::number(ref mut out,row.source_index,ref mut status,work);
        wire::number(ref mut out,row.expected,ref mut status,work);
        wire::number(ref mut out,row.actual,ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        wire::number(ref mut out,row.label_start,ref mut status,work);
        wire::number(ref mut out,row.label_end,ref mut status,work);
        wire::number(ref mut out,if(row.checked){1}else{0},ref mut status,work);
        wire::number(ref mut out,if(row.shared){1}else{0},ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::region_count(b),ref mut status,work);i=0;while(i<ir::region_count(b)){let row=ir::region_at(b,i);
        wire::number(ref mut out,row.parent,ref mut status,work);
        wire::number(ref mut out,row.capability,ref mut status,work);
        wire::number(ref mut out,row.scope,ref mut status,work);
        wire::number(ref mut out,row.statement,ref mut status,work);
        wire::number(ref mut out,row.body,ref mut status,work);
        wire::number(ref mut out,row.source,ref mut status,work);
        wire::number(ref mut out,row.source_binding,ref mut status,work);
        wire::number(ref mut out,row.arena_owner,ref mut status,work);
        wire::number(ref mut out,row.arena_type,ref mut status,work);
        wire::number(ref mut out,row.source_type,ref mut status,work);
        wire::number(ref mut out,row.source_mode as usize,ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        wire::number(ref mut out,row.body_start,ref mut status,work);
        wire::number(ref mut out,row.body_end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::placement_count(b),ref mut status,work);i=0;while(i<ir::placement_count(b)){let row=ir::placement_at(b,i);
        wire::number(ref mut out,row.region_id,ref mut status,work);
        wire::number(ref mut out,row.capability,ref mut status,work);
        wire::number(ref mut out,row.expression,ref mut status,work);
        wire::number(ref mut out,row.argument,ref mut status,work);
        wire::number(ref mut out,row.owner_type,ref mut status,work);
        wire::number(ref mut out,row.borrow_type,ref mut status,work);
        wire::number(ref mut out,row.result_type,ref mut status,work);
        wire::number(ref mut out,row.error_type,ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,ir::reset_count(b),ref mut status,work);i=0;while(i<ir::reset_count(b)){let row=ir::reset_at(b,i);
        wire::number(ref mut out,row.region_id,ref mut status,work);
        wire::number(ref mut out,row.kind as usize,ref mut status,work);
        wire::number(ref mut out,row.group,ref mut status,work);
        wire::number(ref mut out,row.order,ref mut status,work);
        wire::number(ref mut out,row.loop,ref mut status,work);
        wire::number(ref mut out,row.start,ref mut status,work);
        wire::number(ref mut out,row.end,ref mut status,work);
        if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::blob(ref mut out,ir::text_view(b),ref mut status,work);return wire::finish(out,status);
}
