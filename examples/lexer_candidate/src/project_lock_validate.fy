module project_lock_validate;
import project_lock_fields as draft;
import project_instance_identity as identity;
import project_manifest_values as order;
import project_sdk_bundle as sdk;
import project_path as work;
import std::bytes as bytes;
import std::vec as v;

pub struct Edge{usize owner;usize target;}
pub struct Problem{u32 code;usize node;usize edge;}
// 1 work/bound, 2 allocation, 3 header, 4 package order/identity/features,
// 5 source/path/origin, 6 roles/root, 7 dependency/order/binding, 8 cycle,
// 9 null collection. Success retains the owned draft and resolved endpoints.
pub resource Validated{draft::Fields fields;v::Vec<Edge> edges;usize root;cleanup{}}
pub fn ref draft::Fields fields(ref Validated input){return ref input.fields;}
pub fn usize root(ref Validated input){return input.root;}
pub fn usize edge_count(ref Validated input){return v::len<Edge>(ref input.edges);}
pub fn Edge edge(ref Validated input,usize at){assert(at<edge_count(input));return *v::at<Edge>(ref input.edges,at);}
fn Problem fail(u32 code,usize node,usize edge){return Problem{.code,.node,.edge};}
fn Result<u32,u32> compare(ref u8[] a,ref u8[] b,ref mut usize meter){if(!work::charge(meter,a.len+b.len+1)){return .err(1);}return .ok(if(bytes::equal(a,b)){0}else if(order::before(a,b)){1}else{2});}
fn Result<bool,u32> equal(ref u8[] a,ref u8[] b,ref mut usize meter){return switch(compare(a,b,meter)){case .ok(value):{.ok(value==0)}case .err(code):{.err(code)}};}
fn bool digest(ref u8[] value){if(value.len!=78 || !bytes::equal(value[..14],b"fysrc1-sha256-")){return false;}var usize at=14;while(at<value.len){let u8 c=value[at];if(!(c>=48 && c<=57 || c>=97 && c<=102)){return false;}at+=1;}return true;}
fn Result<bool,u32> local_path(ref u8[] path,ref mut usize meter){if(!work::charge(meter,path.len+1)){return .err(1);}if(bytes::equal(path,b".")){return .ok(true);}if(path.len==0 || path[0]==47){return .ok(false);}var usize at=0;var usize start=0;while(at<=path.len){if(at==path.len || path[at]==47){let segment=path[start..at];if(segment.len==0 || bytes::equal(segment,b".") || bytes::equal(segment,b"..")){return .ok(false);}start=at+1;}else if(path[at]==92 || path[at]==58){return .ok(false);}at+=1;}return .ok(true);}
fn Result<bool,u32> sdk_source(ref u8[] value,ref u8[] source_digest,ref mut usize meter){let prefix=sdk::public_identity();let abi=sdk::runtime_abi();if(!work::charge(meter,value.len+source_digest.len+prefix.len+abi.len+1)){return .err(1);}if(value.len!=prefix.len+abi.len+source_digest.len+2){return .ok(false);}let usize first=prefix.len;let usize second=first+1+abi.len;return .ok(bytes::equal(value[..first],prefix) && value[first]==59 && bytes::equal(value[first+1..second],abi) && value[second]==59 && bytes::equal(value[second+1..],source_digest));}
fn u32 package_identity(ref draft::Fields input,usize at,ref mut usize meter){let id=draft::package_field(input,at,0);if(!work::charge(meter,id.len+1)){return 1;}if(!identity::valid_text(id)){return 4;}if(draft::null_features(input,at)){return 9;}var v::Vec<bytes::Buffer> features=v::empty<bytes::Buffer>();var usize index=0;while(index<draft::feature_count(input,at)){let value=draft::feature(input,at,index);if(!work::charge(meter,value.len+1)){return 1;}let bytes::Buffer owned=switch(bytes::copy(value)){case .ok(value):{value}case .err(_):{return 2;}};if(!v::push<bytes::Buffer>(ref mut features,owned).is_ok){return 2;}index+=1;}
    let known=switch(identity::compute(draft::package_field(input,at,2),draft::package_field(input,at,7),draft::package_field(input,at,9),ref features,meter)){case .ok(value):{value}case .err(code):{return if(code==5){2}else if(code==6){1}else{4};}};
    return switch(equal(id,identity::digest(ref known),meter)){case .ok(value):{if(value){0}else{4}}case .err(code):{code}};
}
fn u32 source(ref draft::Fields input,usize at,ref mut usize meter){let value=draft::package_field(input,at,8);if(!work::charge(meter,value.len+1)){return 1;}if(!digest(value)){return 5;}let kind=draft::package_field(input,at,3);if(!work::charge(meter,kind.len+1)){return 1;}
    if(bytes::equal(kind,b"local")){let bool same=switch(equal(value,draft::package_field(input,at,7),meter)){case .ok(value):{value}case .err(code):{return code;}};let bool path=switch(local_path(draft::package_field(input,at,4),meter)){case .ok(value):{value}case .err(code):{return code;}};if(!same || !path || draft::package_field(input,at,5).len!=0 || draft::package_field(input,at,6).len!=0 || bytes::equal(draft::package_field(input,at,1),b"standard-library")){return 5;}return 0;}
    if(!bytes::equal(kind,b"sdk") || draft::package_field(input,at,4).len!=0 || draft::feature_count(input,at)!=0){return 5;}
    var usize field=0;while(field<7){let actual=if(field==0){draft::package_field(input,at,1)}else if(field==1){draft::package_field(input,at,2)}else if(field==2){draft::package_field(input,at,9)}else if(field==3){draft::package_field(input,at,5)}else if(field==4){draft::package_field(input,at,6)}else if(field==5){draft::header(input,3)}else{draft::package_field(input,at,7)};
        if(field==6){let bool same=switch(sdk_source(actual,value,meter)){case .ok(value):{value}case .err(code):{return code;}};if(!same){return 5;}}
        else{let expected=if(field==0){b"standard-library"}else if(field==1){sdk::uid()}else if(field==2){sdk::version()}else if(field==3){sdk::public_identity()}else if(field==4){sdk::runtime_abi()}else{sdk::language()};let bool same=switch(equal(actual,expected,meter)){case .ok(value):{value}case .err(code):{return code;}};if(!same){return 5;}}field+=1;
    }return 0;
}
fn Result<usize,u32> find(ref draft::Fields input,ref u8[] id,ref mut usize meter){var usize low=0;var usize high=draft::package_count(input);while(low<high){let usize middle=low+(high-low)/2;let u32 comparison=switch(compare(draft::package_field(input,middle,0),id,meter)){case .ok(value):{value}case .err(code):{return .err(code);}};if(comparison==0){return .ok(middle);}if(comparison==1){low=middle+1;}else{high=middle;}}return .ok(draft::package_count(input));}
fn Result<u32,u32> edge_order(ref draft::Fields input,usize at,ref mut usize meter){var usize field=0;while(field<3){let u32 value=switch(compare(draft::dependency_field(input,at-1,field),draft::dependency_field(input,at,field),meter)){case .ok(value):{value}case .err(code):{return .err(code);}};if(value!=0){return .ok(value);}field+=1;}return .ok(0);}
fn u32 acyclic(usize count,ref v::Vec<Edge> edges,ref mut usize meter){var v::Vec<usize> degree=v::empty<usize>();var v::Vec<usize> starts=v::empty<usize>();var v::Vec<usize> queue=v::empty<usize>();var usize at=0;while(at<count){if(!work::charge(meter,1)){return 1;}if(!v::push<usize>(ref mut degree,0).is_ok){return 2;}at+=1;}at=0;while(at<v::len<Edge>(edges)){if(!work::charge(meter,1)){return 1;}let e=*v::at<Edge>(edges,at);let ref mut usize slot=v::at_mut<usize>(ref mut degree,e.target);*slot+=1;at+=1;}
    at=0;var usize cursor=0;while(at<count){if(!work::charge(meter,1)){return 1;}if(!v::push<usize>(ref mut starts,cursor).is_ok){return 2;}while(cursor<v::len<Edge>(edges) && v::at<Edge>(edges,cursor).owner==at){if(!work::charge(meter,1)){return 1;}cursor+=1;}if(*v::at<usize>(ref degree,at)==0 && !v::push<usize>(ref mut queue,at).is_ok){return 2;}at+=1;}if(!v::push<usize>(ref mut starts,cursor).is_ok){return 2;}assert(cursor==v::len<Edge>(edges));
    cursor=0;while(cursor<v::len<usize>(ref queue)){if(!work::charge(meter,1)){return 1;}let usize owner=*v::at<usize>(ref queue,cursor);var usize edge=*v::at<usize>(ref starts,owner);let usize end=*v::at<usize>(ref starts,owner+1);while(edge<end){if(!work::charge(meter,1)){return 1;}let usize target=v::at<Edge>(edges,edge).target;let usize remaining=*v::at<usize>(ref degree,target)-1;{let ref mut usize slot=v::at_mut<usize>(ref mut degree,target);*slot=remaining;}if(remaining==0 && !v::push<usize>(ref mut queue,target).is_ok){return 2;}edge+=1;}cursor+=1;}return if(cursor==count){0}else{8};
}
pub fn Result<Validated,Problem> validate(draft::Fields input,ref mut usize meter){var usize field=0;while(field<3){let expected=if(field==0){b"fairyc.lock/v1"}else if(field==1){b"fairyc.package-instance/v1"}else{b"fairyc.package-source/v1"};let bool same=switch(equal(draft::header(ref input,field),expected,meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,0));}};if(!same){return .err(fail(3,0,0));}field+=1;}if(draft::header(ref input,3).len==0){return .err(fail(3,0,0));}if(draft::null_dependencies(ref input) || draft::null_packages(ref input)){return .err(fail(9,0,0));}let usize count=draft::package_count(ref input);if(count==0){return .err(fail(4,0,0));}
    var usize at=0;var usize root=0;var usize roots=0;var usize libraries=0;while(at<count){if(!work::charge(meter,1)){return .err(fail(1,at,0));}if(at>0){let u32 comparison=switch(compare(draft::package_field(ref input,at-1,0),draft::package_field(ref input,at,0),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,at,0));}};if(comparison!=1){return .err(fail(4,at,0));}}
        var u32 code=package_identity(ref input,at,meter);if(code!=0){return .err(fail(code,at,0));}code=source(ref input,at,meter);if(code!=0){return .err(fail(code,at,0));}let role=draft::package_field(ref input,at,1);if(!work::charge(meter,role.len+1)){return .err(fail(1,at,0));}
        if(bytes::equal(role,b"root")){roots+=1;root=at;let bool same=switch(equal(draft::package_field(ref input,at,0),draft::header(ref input,4),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,at,0));}};if(!same || !bytes::equal(draft::package_field(ref input,at,4),b".")){return .err(fail(6,at,0));}}
        else if(!bytes::equal(role,b"dependency") && !bytes::equal(role,b"standard-library")){return .err(fail(6,at,0));}if(bytes::equal(draft::package_field(ref input,at,3),b"sdk")){libraries+=1;}at+=1;
    }if(roots!=1 || libraries>1){return .err(fail(6,root,0));}
    var v::Vec<Edge> edges=v::empty<Edge>();at=0;while(at<draft::dependency_count(ref input)){if(!work::charge(meter,1)){return .err(fail(1,0,at));}if(at>0){let u32 comparison=switch(edge_order(ref input,at,meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,at));}};if(comparison==2){return .err(fail(7,0,at));}let bool same_owner=switch(equal(draft::dependency_field(ref input,at-1,0),draft::dependency_field(ref input,at,0),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,at));}};if(same_owner){let bool same_binding=switch(equal(draft::dependency_field(ref input,at-1,1),draft::dependency_field(ref input,at,1),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,at));}};if(same_binding){return .err(fail(7,0,at));}}}
        let usize owner=switch(find(ref input,draft::dependency_field(ref input,at,0),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,at));}};let usize target=switch(find(ref input,draft::dependency_field(ref input,at,2),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0,at));}};if(owner==count || target==count || draft::dependency_field(ref input,at,1).len==0){return .err(fail(7,0,at));}if(!v::push<Edge>(ref mut edges,Edge{.owner,.target}).is_ok){return .err(fail(2,0,at));}at+=1;
    }let u32 code=acyclic(count,ref edges,meter);if(code!=0){return .err(fail(code,0,0));}return .ok(Validated{.fields=input,.edges,.root});
}
