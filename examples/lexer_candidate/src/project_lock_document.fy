module project_lock_document;
import project_module_visibility as visibility;
import project_workspace_graph as graph;
import project_instance_graph as local;
import project_workspace_input as workspace;
import project_workspace_catalog as catalog;
import project_manifest as manifest;
import project_manifest_values as rules;
import project_sdk_bundle as sdk;
import project_path as work;
import std::bytes as bytes;
import std::vec as v;

struct Span{usize start;usize end;}
struct Package{usize first;usize feature_first;usize feature_count;}
struct Dependency{usize owner;Span binding;usize target;}
// Own all retained lock values. Graph/source lifetimes and physical host paths
// do not escape projection. Header and package fields use fixed contract order.
pub resource Document{bytes::Buffer text;v::Vec<Span> fields;v::Vec<Package> packages;v::Vec<Span> features;v::Vec<Dependency> dependencies;cleanup{}}
// 1 work/text bound, 2 allocation, 3 private vector-candidate SDK not lockable.
pub struct Problem{u32 code;usize node;}
fn Problem fail(u32 code,usize node){return Problem{.code,.node};}
fn ref u8[] value(ref bytes::Buffer text,Span span){return bytes::view(text)[span.start..span.end];}
pub fn ref u8[] header(ref Document document,usize field){assert(field<5);return value(ref document.text,*v::at<Span>(ref document.fields,field));}
pub fn usize package_count(ref Document document){return v::len<Package>(ref document.packages);}
pub fn ref u8[] package_field(ref Document document,usize at,usize field){assert(at<package_count(document) && field<10);let p=*v::at<Package>(ref document.packages,at);return value(ref document.text,*v::at<Span>(ref document.fields,p.first+field));}
pub fn usize feature_count(ref Document document,usize at){assert(at<package_count(document));return v::at<Package>(ref document.packages,at).feature_count;}
pub fn ref u8[] feature(ref Document document,usize at,usize index){assert(index<feature_count(document,at));let p=*v::at<Package>(ref document.packages,at);return value(ref document.text,*v::at<Span>(ref document.features,p.feature_first+index));}
pub fn usize dependency_count(ref Document document){return v::len<Dependency>(ref document.dependencies);}
pub fn usize owner(ref Document document,usize at){assert(at<dependency_count(document));return v::at<Dependency>(ref document.dependencies,at).owner;}
pub fn usize target(ref Document document,usize at){assert(at<dependency_count(document));return v::at<Dependency>(ref document.dependencies,at).target;}
pub fn ref u8[] binding(ref Document document,usize at){assert(at<dependency_count(document));return value(ref document.text,v::at<Dependency>(ref document.dependencies,at).binding);}
fn Result<Span,u32> append(ref mut bytes::Buffer text,ref u8[] input,ref mut usize meter){if(!work::charge(meter,input.len+1) || bytes::len(text)>8388608 || input.len>8388608-bytes::len(text)){return .err(1);}let usize start=bytes::len(text);if(!bytes::append(text,input).is_ok){return .err(2);}return .ok(Span{.start,.end=bytes::len(text)});}
fn u32 field(ref mut bytes::Buffer text,ref mut v::Vec<Span> fields,ref u8[] input,ref mut usize meter){let Span span=switch(append(text,input,meter)){case .ok(value):{value}case .err(code):{return code;}};return if(v::push<Span>(fields,span).is_ok){0}else{2};}
fn void number(ref mut v::Vec<usize> indices,usize at,usize value){let ref mut usize slot=v::at_mut<usize>(indices,at);*slot=value;}
fn void swap(ref mut v::Vec<usize> indices,usize a,usize b){let usize left=*v::at<usize>(indices,a);let usize right=*v::at<usize>(indices,b);number(indices,a,right);number(indices,b,left);}
// One metered heap sort orders either nodes or edge indices by exact lock keys.
fn Result<bool,u32> before(ref graph::Graph graph,usize a,usize b,bool dependencies,ref mut usize meter){
    if(!dependencies){let ref u8[] x=graph::node_id(graph,a);let ref u8[] y=graph::node_id(graph,b);if(!work::charge(meter,x.len+y.len+1)){return .err(1);}return .ok(rules::before(x,y));}
    let x=graph::edge(graph,a);let y=graph::edge(graph,b);let ref u8[] left=graph::node_id(graph,x.owner);let ref u8[] right=graph::node_id(graph,y.owner);if(!work::charge(meter,left.len+right.len+1)){return .err(1);}if(!bytes::equal(left,right)){return .ok(rules::before(left,right));}
    let ref u8[] first=graph::binding(graph,a);let ref u8[] second=graph::binding(graph,b);if(!work::charge(meter,first.len+second.len+1)){return .err(1);}if(!bytes::equal(first,second)){return .ok(rules::before(first,second));}let ref u8[] target_a=graph::node_id(graph,x.target);let ref u8[] target_b=graph::node_id(graph,y.target);if(!work::charge(meter,target_a.len+target_b.len+1)){return .err(1);}return .ok(rules::before(target_a,target_b));
}
fn u32 sift(ref graph::Graph graph,ref mut v::Vec<usize> indices,usize root,usize size,bool dependencies,ref mut usize meter){var usize cursor=root;while(cursor<size/2){var usize child=cursor*2+1;if(child+1<size){let bool smaller=switch(before(graph,*v::at<usize>(indices,child),*v::at<usize>(indices,child+1),dependencies,meter)){case .ok(value):{value}case .err(code):{return code;}};if(smaller){child+=1;}}let bool smaller=switch(before(graph,*v::at<usize>(indices,cursor),*v::at<usize>(indices,child),dependencies,meter)){case .ok(value):{value}case .err(code):{return code;}};if(!smaller){break;}swap(indices,cursor,child);cursor=child;}return 0;}
fn Result<v::Vec<usize>,u32> sorted(ref graph::Graph graph,bool dependencies,ref mut usize meter){let usize count=if(dependencies){graph::edge_count(graph)}else{graph::node_count(graph)};if(!work::charge(meter,count+1)){return .err(1);}var v::Vec<usize> indices=v::empty<usize>();var usize at=0;while(at<count){if(!v::push<usize>(ref mut indices,at).is_ok){return .err(2);}at+=1;}at=count/2;while(at>0){at-=1;let u32 code=sift(graph,ref mut indices,at,count,dependencies,meter);if(code!=0){return .err(code);}}var usize end=count;while(end>1){swap(ref mut indices,0,end-1);end-=1;let u32 code=sift(graph,ref mut indices,0,end,dependencies,meter);if(code!=0){return .err(code);}}return .ok(indices);}
fn u32 package_fields(ref graph::Graph graph,usize node,ref mut bytes::Buffer text,ref mut v::Vec<Span> fields,ref mut usize meter){
    var u32 code=field(text,fields,graph::node_id(graph,node),meter);if(code!=0){return code;}code=field(text,fields,if(graph::is_sdk(graph,node)){b"standard-library"}else if(node==0){b"root"}else{b"dependency"},meter);if(code!=0){return code;}
    if(graph::is_sdk(graph,node)){let library=graph::standard_library(graph);code=field(text,fields,sdk::uid(),meter);if(code!=0){return code;}code=field(text,fields,b"sdk",meter);if(code!=0){return code;}code=field(text,fields,b"",meter);if(code!=0){return code;}code=field(text,fields,sdk::sdk_identity(library),meter);if(code!=0){return code;}code=field(text,fields,sdk::runtime_abi(),meter);if(code!=0){return code;}code=field(text,fields,sdk::source_identity(library),meter);if(code!=0){return code;}code=field(text,fields,sdk::digest(library),meter);if(code!=0){return code;}return field(text,fields,sdk::version(),meter);}
    let local=catalog::package(workspace::local_catalog(local::input(graph::local_graph(graph))),graph::node(graph,node).package_index);let catalog=workspace::local_catalog(local::input(graph::local_graph(graph)));let usize index=graph::node(graph,node).package_index;code=field(text,fields,manifest::package_value(local,b"uid"),meter);if(code!=0){return code;}code=field(text,fields,b"local",meter);if(code!=0){return code;}code=field(text,fields,catalog::path(catalog,index),meter);if(code!=0){return code;}code=field(text,fields,b"",meter);if(code!=0){return code;}code=field(text,fields,b"",meter);if(code!=0){return code;}code=field(text,fields,catalog::digest(catalog,index),meter);if(code!=0){return code;}code=field(text,fields,catalog::digest(catalog,index),meter);if(code!=0){return code;}return field(text,fields,manifest::package_value(local,b"version"),meter);
}
pub fn Result<Document,Problem> project(ref visibility::Resolved input,ref mut usize meter){let graph=visibility::workspace_graph(input);if(graph::has_sdk(graph) && sdk::candidate(graph::standard_library(graph))){return .err(fail(3,graph::local_node_count(graph)));}let v::Vec<usize> nodes=switch(sorted(graph,false,meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0));}};let v::Vec<usize> edges=switch(sorted(graph,true,meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,0));}};
    var bytes::Buffer text=bytes::empty();var v::Vec<Span> fields=v::empty<Span>();var v::Vec<Package> packages=v::empty<Package>();var v::Vec<Span> features=v::empty<Span>();var v::Vec<Dependency> dependencies=v::empty<Dependency>();var v::Vec<usize> positions=v::empty<usize>();var u32 code=field(ref mut text,ref mut fields,b"fairyc.lock/v1",meter);if(code!=0){return .err(fail(code,0));}code=field(ref mut text,ref mut fields,b"fairyc.package-instance/v1",meter);if(code!=0){return .err(fail(code,0));}code=field(ref mut text,ref mut fields,b"fairyc.package-source/v1",meter);if(code!=0){return .err(fail(code,0));}let root=catalog::package(workspace::local_catalog(local::input(graph::local_graph(graph))),0);code=field(ref mut text,ref mut fields,manifest::package_value(root,b"language"),meter);if(code!=0){return .err(fail(code,0));}code=field(ref mut text,ref mut fields,graph::node_id(graph,0),meter);if(code!=0){return .err(fail(code,0));}var usize at=0;while(at<graph::node_count(graph)){if(!v::push<usize>(ref mut positions,0).is_ok){return .err(fail(2,at));}at+=1;}at=0;
    while(at<v::len<usize>(ref nodes)){let usize node=*v::at<usize>(ref nodes,at);number(ref mut positions,node,at);let usize first=v::len<Span>(ref fields);code=package_fields(graph,node,ref mut text,ref mut fields,meter);if(code!=0){return .err(fail(code,node));}let usize feature_first=v::len<Span>(ref features);if(!graph::is_sdk(graph,node)){let usize feature_edge=graph::node(graph,node).feature_edge;if(feature_edge!=0){let workspace=local::input(graph::local_graph(graph));var usize id=workspace::feature_first(workspace,feature_edge-1);while(id!=0){let Span span=switch(append(ref mut text,workspace::feature(workspace,feature_edge-1,id),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,node));}};if(!v::push<Span>(ref mut features,span).is_ok){return .err(fail(2,node));}id=workspace::next_feature(workspace,feature_edge-1,id);}}}if(!v::push<Package>(ref mut packages,Package{.first,.feature_first,.feature_count=v::len<Span>(ref features)-feature_first}).is_ok){return .err(fail(2,node));}at+=1;
    }at=0;while(at<v::len<usize>(ref edges)){let usize edge_index=*v::at<usize>(ref edges,at);let e=graph::edge(graph,edge_index);let Span binding=switch(append(ref mut text,graph::binding(graph,edge_index),meter)){case .ok(value):{value}case .err(code):{return .err(fail(code,e.owner));}};if(!v::push<Dependency>(ref mut dependencies,Dependency{.owner=*v::at<usize>(ref positions,e.owner),.binding,.target=*v::at<usize>(ref positions,e.target)}).is_ok){return .err(fail(2,e.owner));}at+=1;}
    return .ok(Document{.text,.fields,.packages,.features,.dependencies});
}
