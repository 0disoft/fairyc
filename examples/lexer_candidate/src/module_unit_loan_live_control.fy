module module_unit_loan_live_control;
import module_unit_loan_live_model as l;
import module_unit_loan_live_maps as table;
import module_unit_loan_live_walk as walk;
import module_unit_value_model as m;
import syntax as syntax;
import std::vec as v;

fn m::Problem kill_binding(ref m::Values body,usize original,u32 kind,ref mut v::Vec<l::Use> env,ref v::Vec<l::Local> locals,ref mut l::Context c){var usize i=1;while(i<=m::local_count(body)){if(!m::charge(ref mut c.work,1)){return l::fail(c,10,0,0);}let local=m::local_at(body,i);if(local.source_index==original && (kind==2 && (local.kind==2 || local.kind==3) || kind!=2 && local.kind!=1)){return l::kill(env,i,locals,c);}i+=1;}return l::fail(c,0,0,0);}
pub fn m::Problem branch(syntax::Expression e,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){
    let base=switch(l::copy(env,c)){case .ok(v):{v}case .err(p):{return p;}};var merged=switch(l::empty(v::len<l::Local>(locals),c)){case .ok(v):{v}case .err(p):{return p;}};
    if(e.kind==13){let arms=syntax::expression_at(source,e.right);if(arms.kind!=14){return l::fail(c,12,e.start,e.end);}var yes=switch(l::copy(ref base,c)){case .ok(v):{v}case .err(p):{return p;}};let p=block(arms.left,source,body,locals,loop,depth+1,ref mut yes,expressions,statements,maps,rows,c);if(p.code!=0){return p;}let a=l::merge(ref mut merged,ref yes,c);if(a.code!=0){return a;}var no=switch(l::copy(ref base,c)){case .ok(v):{v}case .err(p):{return p;}};let q=walk::expression(arms.right,source,body,locals,loop,depth+1,ref mut no,expressions,statements,maps,rows,c);if(q.code!=0){return q;}let b=l::merge(ref mut merged,ref no,c);if(b.code!=0){return b;}}
    else{var v::Vec<usize> arms=v::empty<usize>();var usize link=e.right;while(link!=0){if(!m::charge(ref mut c.work,1) || v::len<usize>(ref arms)>=1024){return l::fail(c,10,e.start,e.end);}let row=syntax::expression_at(source,link);if(row.kind!=19){return l::fail(c,12,row.start,row.end);}if(!v::push<usize>(ref mut arms,row.left).is_ok){return l::fail(c,11,row.start,row.end);}link=row.right;}var usize i=v::len<usize>(ref arms);while(i>0){i-=1;let arm=syntax::expression_at(source,*v::at<usize>(ref arms,i));var selected=switch(l::copy(ref base,c)){case .ok(v):{v}case .err(p):{return p;}};let p=block(arm.right,source,body,locals,loop,depth+1,ref mut selected,expressions,statements,maps,rows,c);if(p.code!=0){return p;}let pattern=syntax::expression_at(source,arm.left);if(pattern.kind==32){var usize link=pattern.right;while(link!=0){if(!m::charge(ref mut c.work,1)){return l::fail(c,10,pattern.start,pattern.end);}let row=syntax::expression_at(source,link);if(row.kind!=33){return l::fail(c,12,row.start,row.end);}let binding=switch(walk::typed(body,row.left,c)){case .ok(e):{e}case .err(p):{return p;}};let killed=l::kill(ref mut selected,binding.place.root,locals,c);if(killed.code!=0){return killed;}link=row.right;}}if(pattern.left!=0){let binding=switch(walk::typed(body,pattern.left,c)){case .ok(e):{e}case .err(p):{return p;}};let killed=l::kill(ref mut selected,binding.place.root,locals,c);if(killed.code!=0){return killed;}}let joined=l::merge(ref mut merged,ref selected,c);if(joined.code!=0){return joined;}}}
    let replaced=l::replace(env,ref merged,c);if(replaced.code!=0){return replaced;}return walk::expression(e.left,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);
}
fn m::Problem repeated(syntax::Statement s,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){
    let base=switch(l::copy(env,c)){case .ok(v):{v}case .err(p):{return p;}};var header=switch(l::copy(env,c)){case .ok(v):{v}case .err(p):{return p;}};let break_live=switch(table::intern(ref base,maps,rows,c)){case .ok(n):{n}case .err(p):{return p;}};var bool converged=false;var usize iteration=0;
    while(iteration<=m::expression_count(body) && !converged){iteration+=1;c.rounds+=1;let continue_live=switch(table::intern(ref header,maps,rows,c)){case .ok(n):{n}case .err(p):{return p;}};let nested=l::Loop{.break_live,.continue_live};var current=switch(l::copy(ref header,c)){case .ok(v):{v}case .err(p):{return p;}};let p=block(s.first,source,body,locals,nested,depth+1,ref mut current,expressions,statements,maps,rows,c);if(p.code!=0){return p;}if(s.kind==18){let killed=kill_binding(body,s.target,18,ref mut current,locals,c);if(killed.code!=0){return killed;}}let joined=l::merge(ref mut current,ref base,c);if(joined.code!=0){return joined;}if(s.kind!=18){let q=walk::expression(s.expression,source,body,locals,loop,depth+1,ref mut current,expressions,statements,maps,rows,c);if(q.code!=0){return q;}}converged=switch(l::same(ref header,ref current,c)){case .ok(b):{b}case .err(p):{return p;}};let advanced=l::merge(ref mut header,ref current,c);if(advanced.code!=0){return advanced;}}
    if(!converged){return l::fail(c,10,s.start,s.end);}let joined=l::merge(env,ref header,c);if(joined.code!=0){return joined;}if(s.kind==18){let killed=kill_binding(body,s.target,18,env,locals,c);if(killed.code!=0){return killed;}return walk::expression(s.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}return l::fail(c,0,0,0);
}
pub fn m::Problem statement(usize id,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){
    if(id==0){return l::fail(c,0,0,0);}let s=syntax::statement_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return l::fail(c,10,s.start,s.end);}let recorded=table::save(id,env,statements,maps,rows,c);if(recorded.code!=0){return recorded;}
    if(s.kind==9 || s.kind==10 || s.kind==3){let cleared=switch(table::restore(if(s.kind==3){0}else if(s.kind==9){loop.break_live}else{loop.continue_live},v::len<l::Local>(locals),maps,rows,c)){case .ok(v):{v}case .err(p):{return p;}};var usize i=0;while(i<v::len<l::Use>(env)){if(!m::charge(ref mut c.work,1)){return l::fail(c,10,s.start,s.end);}let slot=v::at_mut<l::Use>(env,i);*slot=*v::at<l::Use>(ref cleared,i);i+=1;}return walk::expression(s.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}
    if(s.kind==8 || s.kind==14 || s.kind==18){let p=repeated(s,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(p.code!=0){return p;}if(s.kind==14){let h=syntax::statement_at(source,s.second);return statement(h.first,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}return l::fail(c,0,0,0);}
    if(s.kind==17){let p=block(s.first,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(p.code!=0){return p;}return walk::expression(s.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}
    if(s.kind==2){let killed=kill_binding(body,s.entry,2,env,locals,c);if(killed.code!=0){return killed;}}
    if(s.kind==4){let target=switch(walk::typed(body,s.target,c)){case .ok(e):{e}case .err(p):{return p;}};if(target.kind==2){let killed=l::kill(env,target.binding,locals,c);if(killed.code!=0){return killed;}}let p=walk::expression(s.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(p.code!=0){return p;}return if(target.kind==9 || target.kind==8 || target.kind==4){walk::expression(s.target,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c)}else{l::fail(c,0,0,0)};}
    return walk::expression(s.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);
}
pub fn m::Problem block(usize id,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){
    if(id==0){return l::fail(c,0,0,0);}let b=syntax::statement_at(source,id);if(b.kind!=1 || depth>=64 || !m::charge(ref mut c.work,1)){return l::fail(c,if(b.kind!=1){12}else{10},b.start,b.end);}let tail=walk::expression(b.expression,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(tail.code!=0){return tail;}var usize link=b.first;var usize count=0;while(link!=0){if(!m::charge(ref mut c.work,1) || count>=b.second){return l::fail(c,10,b.start,b.end);}let row=syntax::statement_at(source,link);if(row.kind!=7){return l::fail(c,12,row.start,row.end);}let p=statement(row.first,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(p.code!=0){return p;}link=row.second;count+=1;}return if(count==b.second){l::fail(c,0,0,0)}else{l::fail(c,12,b.start,b.end)};
}
