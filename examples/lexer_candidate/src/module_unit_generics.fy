module module_unit_generics;
import module_unit_bind as binding;
import module_signatures as signatures;
import module_types as types;
import module_ast_join as join;
import syntax as syntax;
import effect_declarations as effects;
import storage_intrinsics as storage;
import std::bytes as bytes;
import std::vec as v;
import resource_abilities as abilities;

pub struct Instance {usize module_index;usize declaration;usize argument_start;usize argument_count;usize result;usize parameter_start;usize parameter_count;u32 effects;bool must_use;bool unsafe_call;}
pub struct Call {usize instance;u32 intrinsic;bool deferred;}
pub struct Dependency {usize owner;usize source_index;usize instance;usize aggregate_type;u32 intrinsic;usize intrinsic_type;bool slice;usize inline_declaration;bool inline_unsafe;}
pub struct SourceStamp {usize length;u32[8] digest;}
pub struct Cleanup {usize type;usize module_index;usize declaration;usize argument_start;usize argument_count;usize start;usize end;u32 effects;u32 abilities;u32 receiver_kind;}
pub resource Plan {v::Vec<Instance> instances;v::Vec<usize> arguments;v::Vec<usize> parameters;v::Vec<Call> calls;v::Vec<Dependency> dependencies;v::Vec<Cleanup> cleanups;v::Vec<Dependency> cleanup_dependencies;v::Vec<SourceStamp> stamps;v::Vec<types::Type> prefix;usize work;cleanup{}}
struct Budget {usize work;}
// Imported ordinary bodies do not consume the generic specialization budget.
// The shared retained-body table and traversal marks stay independently bounded.
pub fn usize instance_limit(){return 256;}
fn join::Problem fail(u32 code,usize module_index,usize start,usize end){return join::Problem{.code,.module_index,.start,.end};}
fn bool charge(ref mut Budget work,usize amount){if(work.work>1048576 || amount>1048576-work.work){return false;}work.work+=amount;return true;}
fn usize owner(ref syntax::Parsed p,usize start,usize end,ref mut Budget work){var usize i=0;while(i<syntax::declaration_count(p)){if(!charge(work,1)){return 0;}let d=syntax::declaration_at(p,i);if(d.kind!=1 && start>=d.start && end<=d.end){return i+1;}i+=1;}return 0;}
fn bool shadow(ref syntax::Parsed p,usize caller,ref u8[] name,ref mut Budget work){let d=syntax::declaration_at(p,caller-1);var usize i=0;while(i<syntax::entry_count(p)){if(!charge(work,1)){return true;}let e=syntax::entry_at(p,i);if(e.start>=d.start && e.end<=d.end && bytes::equal(syntax::source_view(p)[e.name_start..e.name_end],name)){return true;}i+=1;}return false;}
fn Result<usize,join::Problem> instantiate(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize module_index,usize declaration,ref v::Vec<usize> args,ref mut v::Vec<types::Type> graph,ref mut v::Vec<Instance> instances,ref mut v::Vec<usize> arguments,ref mut v::Vec<usize> parameters,ref mut Budget work,usize caller,usize start,usize end){
    let source=v::at<syntax::Parsed>(sources,module_index);let d=syntax::declaration_at(source,declaration-1);let usize count=v::len<usize>(args);
    if(d.kind!=3 || d.generic_parameters==0 || d.owner_end!=0 || count==0 || count>8 || count!=syntax::generic_parameter_count(source,declaration-1)){return .err(fail(4501,caller,start,end));}
    var usize i=0;while(i<count){let a=syntax::generic_parameter_at(source,declaration-1,i);var usize j=0;while(j<i){let b=syntax::generic_parameter_at(source,declaration-1,j);if(bytes::equal(syntax::source_view(source)[a.start..a.end],syntax::source_view(source)[b.start..b.end])){return .err(fail(4501,module_index,a.start,a.end));}j+=1;}i+=1;}
    let bool vector=signatures::sdk_vector_source(metadata,module_index);i=0;while(i<count){let t=types::at(graph,*v::at<usize>(args,i));if(!(t.kind==1 && t.scalar>=1 && t.scalar<=6) && !(vector && (t.kind==2 || t.kind==3))){return .err(fail(4502,caller,start,end));}i+=1;}
    i=0;var usize per=0;var usize generic=0;while(i<v::len<Instance>(instances)){if(!charge(work,count+1)){return .err(fail(4503,caller,start,end));}let old=*v::at<Instance>(instances,i);if(old.argument_count!=0){generic+=1;}if(old.module_index==module_index && old.declaration==declaration){per+=1;var bool same=old.argument_count==count;var usize j=0;while(j<count && same){same=*v::at<usize>(arguments,old.argument_start+j)==*v::at<usize>(args,j);j+=1;}if(same){return .ok(i+1);}}i+=1;}
    if(v::len<Instance>(instances)>=instance_limit() || generic>=64 || per>=16){return .err(fail(4503,caller,start,end));}
    let result=signatures::specialize_type(metadata,source,module_index,declaration,d.result_type,args,graph);if(result.problem.code!=0){return .err(fail(result.problem.code,module_index,result.problem.start,result.problem.end));}
    let contract=effects::read(source,declaration-1);if(contract.code!=0){return .err(fail(contract.code,module_index,contract.start,contract.end));}
    let t=types::at(graph,result.type);if(contract.must_use && (t.kind==1 && t.scalar==7 || t.kind!=1 && t.kind!=2 && t.kind!=4 && t.kind!=12)){return .err(fail(4201,module_index,contract.must_start,contract.must_end));}
    let usize parameter_start=v::len<usize>(parameters);i=d.entry_start;while(i<d.entry_start+d.entry_count){if(!charge(work,1)){return .err(fail(4503,caller,start,end));}let e=syntax::entry_at(source,i);if(e.kind==1){let r=signatures::specialize_type(metadata,source,module_index,declaration,e.type_root,args,graph);if(r.problem.code!=0){return .err(fail(r.problem.code,module_index,r.problem.start,r.problem.end));}let t=types::at(graph,r.type);if(t.kind==1 && t.scalar==7){return .err(fail(9,module_index,e.type_start,e.type_end));}if(v::len<usize>(parameters)>=32768 || !v::push<usize>(parameters,r.type).is_ok){return .err(fail(if(v::len<usize>(parameters)>=32768){4503}else{11},caller,start,end));}}i+=1;}
    let usize argument_start=v::len<usize>(arguments);i=0;while(i<count){if(!v::push<usize>(arguments,*v::at<usize>(args,i)).is_ok){return .err(fail(11,caller,start,end));}i+=1;}
    if(!v::push<Instance>(instances,Instance{.module_index,.declaration,.argument_start,.argument_count=count,.result=result.type,.parameter_start,.parameter_count=v::len<usize>(parameters)-parameter_start,.effects=contract.bits,.must_use=contract.must_use,.unsafe_call=d.unsafe_end!=0}).is_ok){return .err(fail(11,caller,start,end));}return .ok(v::len<Instance>(instances));
}
fn join::Problem forward(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref mut v::Vec<types::Type> graph,ref mut v::Vec<Instance> instances,ref mut v::Vec<usize> arguments,ref mut v::Vec<usize> parameters,ref mut v::Vec<Dependency> dependencies,ref mut v::Vec<u8> states,ref mut Budget work,usize id,usize depth){
    let item=*v::at<Instance>(instances,id-1);let source=v::at<syntax::Parsed>(sources,item.module_index);let d=syntax::declaration_at(source,item.declaration-1);
    if(depth>=32){return fail(4503,item.module_index,d.start,d.end);}if(*v::at<u8>(states,id-1)==2){return fail(0,0,0,0);}if(*v::at<u8>(states,id-1)==1){return fail(4503,item.module_index,d.start,d.end);}{let slot=v::at_mut<u8>(states,id-1);*slot=1;}
    var v::Vec<usize> parent=v::empty<usize>();var usize i=0;while(i<item.argument_count){if(!v::push<usize>(ref mut parent,*v::at<usize>(arguments,item.argument_start+i)).is_ok){return fail(11,item.module_index,d.start,d.end);}i+=1;}
    let bool vector=signatures::sdk_vector_source(metadata,item.module_index);i=1;
    while(i<=syntax::expression_count(source)){if(!charge(work,1)){return fail(4503,item.module_index,d.start,d.end);}let e=syntax::expression_at(source,i);
        if(e.kind==20 && e.start>=d.start && e.end<=d.end){let base=syntax::expression_at(source,e.left);if(base.kind!=2){return fail(4501,item.module_index,e.start,e.end);}let name=syntax::expression_text(source,e.left);let u32 intrinsic=if(vector){storage::named(name)}else{0};var usize target=0;var usize aggregate_type=0;var usize intrinsic_type=0;var bool slice=false;
            if(intrinsic!=0){if(syntax::specialization_argument_count(source,i)!=1){return fail(4501,item.module_index,e.start,e.end);}var usize root=syntax::specialization_argument(source,i,0);let n=syntax::type_at(source,root);if(n.kind==4){slice=true;root=n.left;}let r=if(v::len<usize>(ref parent)==0){signatures::resolve_type(metadata,source,item.module_index,root,graph)}else{signatures::specialize_type(metadata,source,item.module_index,item.declaration,root,ref parent,graph)};if(r.problem.code!=0){return fail(r.problem.code,item.module_index,r.problem.start,r.problem.end);}intrinsic_type=r.type;}
            else{if(shadow(source,item.declaration,name,work)){return fail(if(work.work>=1048576){4503}else{4501},item.module_index,base.start,base.end);}let found=signatures::declaration_lookup(metadata,item.module_index,name);if(found.code!=0){return fail(found.code,item.module_index,base.start,base.end);}let callee=signatures::declaration_at(metadata,found.item);var v::Vec<usize> args=v::empty<usize>();var usize j=0;
                while(j<syntax::specialization_argument_count(source,i)){let r=if(v::len<usize>(ref parent)==0){signatures::resolve_type(metadata,source,item.module_index,syntax::specialization_argument(source,i,j),graph)}else{signatures::specialize_type(metadata,source,item.module_index,item.declaration,syntax::specialization_argument(source,i,j),ref parent,graph)};if(r.problem.code!=0){return fail(r.problem.code,item.module_index,r.problem.start,r.problem.end);}if(!v::push<usize>(ref mut args,r.type).is_ok){return fail(11,item.module_index,e.start,e.end);}j+=1;}
                if(vector && callee.kind==6 && callee.module_index==item.module_index && bytes::equal(name,b"Vec")){if(v::len<usize>(ref args)!=1){return fail(4501,item.module_index,e.start,e.end);}aggregate_type=types::canonical(graph,types::Type{.kind=13,.scalar=0,.module_index=callee.module_index,.declaration=callee.declaration,.first=*v::at<usize>(ref args,0),.second=0});if(aggregate_type==0){return fail(if(types::count(graph)>=4096){4503}else{11},item.module_index,e.start,e.end);}}
                else{target=switch(instantiate(sources,metadata,callee.module_index,callee.declaration,ref args,graph,instances,arguments,parameters,work,item.module_index,e.start,e.end)){case .ok(n):{n}case .err(p):{return p;}};
                    if(*v::at<u8>(states,target-1)==1){return fail(4503,item.module_index,e.start,e.end);}let p=forward(sources,metadata,graph,instances,arguments,parameters,dependencies,states,work,target,depth+1);if(p.code!=0){return p;}
                }
            }
            if(v::len<Dependency>(dependencies)>=16384 || !v::push<Dependency>(dependencies,Dependency{.owner=id,.source_index=i,.instance=target,.aggregate_type,.intrinsic,.intrinsic_type,.slice,.inline_declaration=0,.inline_unsafe=false}).is_ok){return fail(if(v::len<Dependency>(dependencies)>=16384){4503}else{11},item.module_index,e.start,e.end);}
        }i+=1;
    }{let slot=v::at_mut<u8>(states,id-1);*slot=2;}return fail(0,0,0,0);
}
fn Result<Plan,join::Problem> collect(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref binding::Bound bound,ref mut v::Vec<types::Type> graph){
    let valid=binding::validate(bound,sources,metadata);if(valid.code!=0){return .err(valid);}var v::Vec<Instance> instances=v::empty<Instance>();var v::Vec<usize> arguments=v::empty<usize>();var v::Vec<usize> parameters=v::empty<usize>();var v::Vec<Call> calls=v::empty<Call>();var Budget budget=Budget{.work=0};var usize module_index=binding::first(bound);
    while(module_index<binding::stop(bound)){let source=v::at<syntax::Parsed>(sources,module_index);var usize i=1;while(i<=syntax::expression_count(source)){let e=syntax::expression_at(source,i);var Call call=Call{.instance=0,.intrinsic=0,.deferred=false};if(!charge(ref mut budget,1)){return .err(fail(4503,module_index,e.start,e.end));}
        if(e.kind==20){let usize caller=owner(source,e.start,e.end,ref mut budget);if(caller==0){return .err(fail(if(budget.work>=1048576){4503}else{4501},module_index,e.start,e.end));}let d=syntax::declaration_at(source,caller-1);
            if(d.generic_parameters!=0 || d.kind==12){call.deferred=true;}
            else{let base=syntax::expression_at(source,e.left);if(base.kind!=2){return .err(fail(4501,module_index,e.start,e.end));}let name=syntax::expression_text(source,e.left);let u32 intrinsic=storage::named(name);
                if(intrinsic!=0 && signatures::sdk_vector_source(metadata,module_index)){call.intrinsic=intrinsic;}
                else{if(shadow(source,caller,name,ref mut budget)){return .err(fail(if(budget.work>=1048576){4503}else{4501},module_index,base.start,base.end));}let found=signatures::declaration_lookup(metadata,module_index,name);if(found.code!=0){return .err(fail(found.code,module_index,base.start,base.end));}let target=signatures::declaration_at(metadata,found.item);var v::Vec<usize> args=v::empty<usize>();var usize j=0;
                    while(j<syntax::specialization_argument_count(source,i)){let r=signatures::resolve_type(metadata,source,module_index,syntax::specialization_argument(source,i,j),graph);if(r.problem.code!=0){return .err(fail(r.problem.code,module_index,r.problem.start,r.problem.end));}if(!v::push<usize>(ref mut args,r.type).is_ok){return .err(fail(11,module_index,e.start,e.end));}j+=1;}
                    call.instance=switch(instantiate(sources,metadata,target.module_index,target.declaration,ref args,graph,ref mut instances,ref mut arguments,ref mut parameters,ref mut budget,module_index,e.start,e.end)){case .ok(id):{id}case .err(p):{return .err(p);}};
                }
            }
        }if(!v::push<Call>(ref mut calls,call).is_ok){return .err(fail(11,module_index,e.start,e.end));}i+=1;
    }module_index+=1;}
    var v::Vec<u8> states=v::empty<u8>();var v::Vec<Dependency> dependencies=v::empty<Dependency>();var usize i=0;while(i<instance_limit()){if(!v::push<u8>(ref mut states,0).is_ok){return .err(fail(11,0,0,0));}i+=1;}i=1;
    while(i<=v::len<Instance>(ref instances)){let p=forward(sources,metadata,graph,ref mut instances,ref mut arguments,ref mut parameters,ref mut dependencies,ref mut states,ref mut budget,i,0);if(p.code!=0){return .err(p);}i+=1;}
    var v::Vec<SourceStamp> stamps=v::empty<SourceStamp>();i=0;while(i<v::len<syntax::Parsed>(sources)){let text=syntax::source_view(v::at<syntax::Parsed>(sources,i));if(!v::push<SourceStamp>(ref mut stamps,SourceStamp{.length=text.len,.digest=signatures::source_digest(metadata,i)}).is_ok){return .err(fail(11,i,0,0));}i+=1;}
    var v::Vec<types::Type> prefix=v::empty<types::Type>();i=1;while(i<=types::count(graph)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<types::Type>(ref mut prefix,types::at(graph,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    return .ok(Plan{.instances,.arguments,.parameters,.calls,.dependencies,.cleanups=v::empty<Cleanup>(),.cleanup_dependencies=v::empty<Dependency>(),.stamps,.prefix,.work=budget.work});
}
// Materialize ordinary calls outside the selected source range with the same
// owned body projection as concrete templates; zero arguments marks this lane.
fn Result<Plan,join::Problem> expand_imports(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref binding::Bound bound,ref v::Vec<binding::Coordinate> seeds,Plan input,ref mut v::Vec<types::Type> graph){
    var Budget budget=Budget{.work=input.work};var usize i=0;
    var v::Vec<Instance> instances=v::empty<Instance>();i=0;while(i<v::len<Instance>(ref input.instances)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Instance>(ref mut instances,*v::at<Instance>(ref input.instances,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<usize> arguments=v::empty<usize>();i=0;while(i<v::len<usize>(ref input.arguments)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<usize>(ref mut arguments,*v::at<usize>(ref input.arguments,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<usize> parameters=v::empty<usize>();i=0;while(i<v::len<usize>(ref input.parameters)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<usize>(ref mut parameters,*v::at<usize>(ref input.parameters,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Call> calls=v::empty<Call>();i=0;while(i<v::len<Call>(ref input.calls)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Call>(ref mut calls,*v::at<Call>(ref input.calls,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Dependency> dependencies=v::empty<Dependency>();i=0;while(i<v::len<Dependency>(ref input.dependencies)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Dependency>(ref mut dependencies,*v::at<Dependency>(ref input.dependencies,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Cleanup> cleanups=v::empty<Cleanup>();i=0;while(i<v::len<Cleanup>(ref input.cleanups)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Cleanup>(ref mut cleanups,*v::at<Cleanup>(ref input.cleanups,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Dependency> cleanup_dependencies=v::empty<Dependency>();i=0;while(i<v::len<Dependency>(ref input.cleanup_dependencies)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Dependency>(ref mut cleanup_dependencies,*v::at<Dependency>(ref input.cleanup_dependencies,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<SourceStamp> stamps=v::empty<SourceStamp>();i=0;while(i<v::len<SourceStamp>(ref input.stamps)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<SourceStamp>(ref mut stamps,*v::at<SourceStamp>(ref input.stamps,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    let usize before=v::len<Instance>(ref instances);i=0;let usize total=binding::target_count(bound)+v::len<binding::Coordinate>(seeds);
    while(i<total){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}let c=if(i<binding::target_count(bound)){binding::target_at(bound,i+1)}else{*v::at<binding::Coordinate>(seeds,i-binding::target_count(bound))};i+=1;
        if(c.module_index>=v::len<syntax::Parsed>(sources) || c.declaration==0 || c.declaration>syntax::declaration_count(v::at<syntax::Parsed>(sources,c.module_index))){return .err(fail(12,c.module_index,c.start,c.end));}let original=v::at<syntax::Parsed>(sources,c.module_index);let d=syntax::declaration_at(original,c.declaration-1);
        if(d.kind!=c.kind || d.start!=c.start || d.end!=c.end || !signatures::source_matches(metadata,c.module_index,original)){return .err(fail(12,c.module_index,c.start,c.end));}
        if(d.kind!=3 || d.generic_parameters!=0 || d.body==0 || c.module_index>=binding::first(bound) && c.module_index<binding::stop(bound)){continue;}
        var bool found=false;var usize j=0;while(j<v::len<Instance>(ref instances)){if(!charge(ref mut budget,1)){return .err(fail(4503,c.module_index,d.start,d.end));}let old=*v::at<Instance>(ref instances,j);if(old.module_index==c.module_index && old.declaration==c.declaration){if(old.argument_count!=0){return .err(fail(12,c.module_index,d.start,d.end));}found=true;}j+=1;}if(found){continue;}
        let id=signatures::identity(metadata,c.module_index,c.declaration);if(id==0 || v::len<Instance>(ref instances)>=instance_limit()){return .err(fail(if(id==0){12}else{4503},c.module_index,d.start,d.end));}let sig=signatures::at(metadata,id);if(sig.foreign || sig.result==0 || sig.result>types::count(graph)){return .err(fail(12,c.module_index,d.start,d.end));}
        let usize parameter_start=v::len<usize>(ref parameters);j=0;while(j<sig.parameter_count){if(!charge(ref mut budget,1)){return .err(fail(4503,c.module_index,d.start,d.end));}let t=signatures::parameter_at(metadata,sig.parameter_start+j);if(t==0 || t>types::count(graph)){return .err(fail(12,c.module_index,d.start,d.end));}if(!v::push<usize>(ref mut parameters,t).is_ok){return .err(fail(11,c.module_index,d.start,d.end));}j+=1;}
        if(!v::push<Instance>(ref mut instances,Instance{.module_index=c.module_index,.declaration=c.declaration,.argument_start=v::len<usize>(ref arguments),.argument_count=0,.result=sig.result,.parameter_start,.parameter_count=sig.parameter_count,.effects=sig.effects,.must_use=sig.must_use,.unsafe_call=sig.unsafe_call}).is_ok){return .err(fail(11,c.module_index,d.start,d.end));}
    }
    var v::Vec<u8> states=v::empty<u8>();i=0;while(i<instance_limit()){if(!v::push<u8>(ref mut states,if(i<before){2}else{0}).is_ok){return .err(fail(11,0,0,0));}i+=1;}i=before+1;
    while(i<=v::len<Instance>(ref instances)){let checked=forward(sources,metadata,graph,ref mut instances,ref mut arguments,ref mut parameters,ref mut dependencies,ref mut states,ref mut budget,i,0);if(checked.code!=0){return .err(checked);}i+=1;}var v::Vec<types::Type> prefix=v::empty<types::Type>();i=1;while(i<=types::count(graph)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<types::Type>(ref mut prefix,types::at(graph,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    return .ok(Plan{.instances,.arguments,.parameters,.calls,.dependencies,.cleanups,.cleanup_dependencies,.stamps,.prefix,.work=budget.work});
}
pub fn Result<Plan,join::Problem> extend_imports(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref binding::Bound bound,ref v::Vec<binding::Coordinate> seeds,Plan input,ref mut v::Vec<types::Type> graph){let usize before=types::count(graph);return switch(expand_imports(sources,metadata,bound,seeds,input,graph)){case .ok(p):{.ok(p)}case .err(p):{while(types::count(graph)>before){discard v::pop<types::Type>(graph);}.err(p)}};}
pub fn usize count(ref Plan p){return v::len<Instance>(ref p.instances);}
pub fn Instance at(ref Plan p,usize id){assert(id>0 && id<=count(p));return *v::at<Instance>(ref p.instances,id-1);}
pub fn usize argument_at(ref Plan p,usize index){return *v::at<usize>(ref p.arguments,index);}
pub fn usize parameter_at(ref Plan p,usize index){return *v::at<usize>(ref p.parameters,index);}
pub fn usize call_count(ref Plan p){return v::len<Call>(ref p.calls);}
pub fn Call call_at(ref Plan p,usize id){assert(id>0 && id<=call_count(p));return *v::at<Call>(ref p.calls,id-1);}
pub fn usize work(ref Plan p){return p.work;}
pub fn usize dependency_count(ref Plan p){return v::len<Dependency>(ref p.dependencies);}
pub fn Dependency dependency_at(ref Plan p,usize index){return *v::at<Dependency>(ref p.dependencies,index);}
pub fn usize cleanup_count(ref Plan p){return v::len<Cleanup>(ref p.cleanups);}
pub fn Cleanup cleanup_at(ref Plan p,usize id){return *v::at<Cleanup>(ref p.cleanups,id-1);}
pub fn usize cleanup_dependency_count(ref Plan p){return v::len<Dependency>(ref p.cleanup_dependencies);}
pub fn Dependency cleanup_dependency_at(ref Plan p,usize index){return *v::at<Dependency>(ref p.cleanup_dependencies,index);}
fn bool cleanup_take_leaf(ref syntax::Parsed source,usize declaration,bool vector){
    let d=syntax::declaration_at(source,declaration-1);if(!vector || d.kind!=3 || d.public || d.unsafe_end!=0 || d.attribute_count!=0 || d.body==0 || d.generic_parameters==0 || syntax::generic_parameter_count(source,declaration-1)!=1 || !bytes::equal(syntax::source_view(source)[d.name_start..d.name_end],b"take_slot") || !bytes::equal(syntax::type_text(source,d.result_type),b"T") || d.entry_count!=2 || syntax::block_statement_count(source,d.body)!=1){return false;}
    let param=syntax::entry_at(source,d.entry_start);let pointer=syntax::type_at(source,param.type_root);if(param.kind!=1 || !bytes::equal(syntax::source_view(source)[param.name_start..param.name_end],b"slot") || pointer.kind!=12 || !bytes::equal(syntax::type_text(source,pointer.left),b"void")){return false;}
    let returned=syntax::statement_at(source,syntax::block_statement(source,d.body,0));if(returned.kind!=3 || returned.expression==0){return false;}let value=syntax::expression_at(source,returned.expression);if(value.kind!=31 || value.left==0){return false;}let block=syntax::statement_at(source,value.left);if(block.kind!=1 || block.second!=0 || block.expression==0){return false;}
    let call=syntax::expression_at(source,block.expression);if(call.kind!=6 || call.left==0 || syntax::call_argument_count(source,block.expression)!=1){return false;}let generic=syntax::expression_at(source,call.left);if(generic.kind!=20 || generic.left==0 || syntax::specialization_argument_count(source,call.left)!=1 || !bytes::equal(syntax::expression_text(source,generic.left),b"storage_take") || !bytes::equal(syntax::type_text(source,syntax::specialization_argument(source,call.left,0)),b"T")){return false;}
    let arg=syntax::call_argument(source,block.expression,0);return !syntax::call_argument_labeled(source,syntax::call_argument_entry(source,block.expression,0)) && syntax::expression_at(source,arg).kind==2 && bytes::equal(syntax::expression_text(source,arg),b"slot");
}
fn join::Problem cleanup_requests(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref mut v::Vec<Instance> instances,ref mut v::Vec<usize> arguments,ref mut v::Vec<usize> parameters,ref mut v::Vec<Dependency> dependencies,ref mut v::Vec<Cleanup> cleanups,ref mut v::Vec<Dependency> cleanup_dependencies,ref mut Budget budget,ref mut v::Vec<types::Type> graph,usize type){
    if(type==0 || type>types::count(graph)){return fail(9,0,0,0);}let t=types::at(graph,type);if(t.kind!=3 && t.kind!=13){return fail(9,0,0,0);}var usize j=0;while(j<v::len<Cleanup>(cleanups)){if(v::at<Cleanup>(cleanups,j).type==type){return fail(0,0,0,0);}j+=1;}
    let original=v::at<syntax::Parsed>(sources,t.module_index);let d=syntax::declaration_at(original,t.declaration-1);if(!signatures::source_matches(metadata,t.module_index,original)){return fail(12,t.module_index,0,0);}if(d.kind!=6 || d.cleanup_body==0 || d.cleanup_attribute_count!=0){return fail(3,t.module_index,d.start,d.end);}if(v::len<Cleanup>(cleanups)>=512){return fail(10,t.module_index,d.start,d.end);}
    let bool vector=t.kind==13 && signatures::sdk_vector_source(metadata,t.module_index) && bytes::equal(syntax::source_view(original)[d.name_start..d.name_end],b"Vec");if((d.generic_parameters!=0)!=vector){return fail(4501,t.module_index,d.start,d.end);}
    var v::Vec<usize> args=v::empty<usize>();let usize argument_start=v::len<usize>(arguments);if(vector){if(!v::push<usize>(ref mut args,t.first).is_ok || !v::push<usize>(arguments,t.first).is_ok){return fail(11,t.module_index,d.start,d.end);}}
    let ability=abilities::read(original,t.declaration-1);if(!charge(budget,ability.work)){return fail(4503,t.module_index,d.start,d.end);}if(ability.code!=0){return fail(ability.code,t.module_index,ability.start,ability.end);}let contract=effects::read(original,t.declaration-1);if(contract.code!=0){return fail(contract.code,t.module_index,contract.start,contract.end);}var v::Vec<u8> states=v::empty<u8>();j=0;while(j<instance_limit()){if(!v::push<u8>(ref mut states,if(j<v::len<Instance>(instances)){2}else{0}).is_ok){return fail(11,t.module_index,d.start,d.end);}j+=1;}let usize id=v::len<Cleanup>(cleanups)+1;var usize i=1;
    while(i<=syntax::expression_count(original)){if(!charge(budget,1)){return fail(4503,t.module_index,d.cleanup_start,d.cleanup_end);}let e=syntax::expression_at(original,i);if(e.kind==20 && e.start>=d.cleanup_start && e.end<=d.cleanup_end){let base=syntax::expression_at(original,e.left);if(base.kind!=2){return fail(4501,t.module_index,e.start,e.end);}let name=syntax::expression_text(original,e.left);var u32 intrinsic=if(vector){storage::named(name)}else{0};var usize target=0;var usize aggregate_type=0;var usize intrinsic_type=0;var bool slice=false;var usize inline_declaration=0;
        if(intrinsic!=0){if(syntax::specialization_argument_count(original,i)!=1){return fail(4501,t.module_index,e.start,e.end);}var usize root=syntax::specialization_argument(original,i,0);let n=syntax::type_at(original,root);if(n.kind==4){slice=true;root=n.left;}let r=signatures::specialize_type(metadata,original,t.module_index,t.declaration,root,ref args,graph);if(r.problem.code!=0){return fail(r.problem.code,t.module_index,r.problem.start,r.problem.end);}intrinsic_type=r.type;}
        else{if(shadow(original,t.declaration,name,budget)){return fail(if(budget.work>=1048576){4503}else{4501},t.module_index,base.start,base.end);}let found=signatures::declaration_lookup(metadata,t.module_index,name);if(found.code!=0){return fail(found.code,t.module_index,base.start,base.end);}let callee=signatures::declaration_at(metadata,found.item);var v::Vec<usize> forwarded=v::empty<usize>();j=0;
            while(j<syntax::specialization_argument_count(original,i)){let usize root=syntax::specialization_argument(original,i,j);let r=if(vector){signatures::specialize_type(metadata,original,t.module_index,t.declaration,root,ref args,graph)}else{signatures::resolve_type(metadata,original,t.module_index,root,graph)};if(r.problem.code!=0){return fail(r.problem.code,t.module_index,r.problem.start,r.problem.end);}if(!v::push<usize>(ref mut forwarded,r.type).is_ok){return fail(11,t.module_index,e.start,e.end);}j+=1;}
            if(vector && callee.module_index==t.module_index && cleanup_take_leaf(original,callee.declaration,vector)){if(v::len<usize>(ref forwarded)!=1){return fail(4501,t.module_index,e.start,e.end);}intrinsic=3;intrinsic_type=*v::at<usize>(ref forwarded,0);inline_declaration=callee.declaration;}
            else if(vector && callee.kind==6 && callee.module_index==t.module_index && bytes::equal(name,b"Vec")){if(v::len<usize>(ref forwarded)!=1){return fail(4501,t.module_index,e.start,e.end);}aggregate_type=types::canonical(graph,types::Type{.kind=13,.scalar=0,.module_index=callee.module_index,.declaration=callee.declaration,.first=*v::at<usize>(ref forwarded,0),.second=0});if(aggregate_type==0){return fail(if(types::count(graph)>=4096){4503}else{11},t.module_index,e.start,e.end);}}
            else{target=switch(instantiate(sources,metadata,callee.module_index,callee.declaration,ref forwarded,graph,instances,arguments,parameters,budget,t.module_index,e.start,e.end)){case .ok(n):{n}case .err(p):{return p;}};let problem=forward(sources,metadata,graph,instances,arguments,parameters,dependencies,ref mut states,budget,target,1);if(problem.code!=0){return problem;}}
        }
        if(v::len<Dependency>(dependencies)+v::len<Dependency>(cleanup_dependencies)>=16384 || !v::push<Dependency>(cleanup_dependencies,Dependency{.owner=id,.source_index=i,.instance=target,.aggregate_type,.intrinsic,.intrinsic_type,.slice,.inline_declaration,.inline_unsafe=inline_declaration!=0}).is_ok){return fail(if(v::len<Dependency>(dependencies)+v::len<Dependency>(cleanup_dependencies)>=16384){4503}else{11},t.module_index,e.start,e.end);}
    }i+=1;}
    if(v::len<Dependency>(dependencies)+v::len<Dependency>(cleanup_dependencies)>16384){return fail(4503,t.module_index,d.cleanup_start,d.cleanup_end);}if(!v::push<Cleanup>(cleanups,Cleanup{.type,.module_index=t.module_index,.declaration=t.declaration,.argument_start,.argument_count=v::len<usize>(ref args),.start=d.cleanup_start,.end=d.cleanup_end,.effects=contract.bits,.abilities=ability.bits,.receiver_kind=10}).is_ok){return fail(11,t.module_index,d.start,d.end);}return fail(0,0,0,0);
}
fn Result<Plan,join::Problem> expand_cleanups(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,Plan input,ref mut v::Vec<types::Type> graph,ref v::Vec<usize> seeds){
    if(v::len<usize>(seeds)==0){return .ok(input);}var Budget budget=Budget{.work=input.work};var usize i=0;
    var v::Vec<Instance> instances=v::empty<Instance>();i=0;while(i<v::len<Instance>(ref input.instances)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Instance>(ref mut instances,*v::at<Instance>(ref input.instances,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<usize> arguments=v::empty<usize>();i=0;while(i<v::len<usize>(ref input.arguments)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<usize>(ref mut arguments,*v::at<usize>(ref input.arguments,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<usize> parameters=v::empty<usize>();i=0;while(i<v::len<usize>(ref input.parameters)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<usize>(ref mut parameters,*v::at<usize>(ref input.parameters,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Call> calls=v::empty<Call>();i=0;while(i<v::len<Call>(ref input.calls)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Call>(ref mut calls,*v::at<Call>(ref input.calls,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Dependency> dependencies=v::empty<Dependency>();i=0;while(i<v::len<Dependency>(ref input.dependencies)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Dependency>(ref mut dependencies,*v::at<Dependency>(ref input.dependencies,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Cleanup> cleanups=v::empty<Cleanup>();i=0;while(i<v::len<Cleanup>(ref input.cleanups)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Cleanup>(ref mut cleanups,*v::at<Cleanup>(ref input.cleanups,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<Dependency> cleanup_dependencies=v::empty<Dependency>();i=0;while(i<v::len<Dependency>(ref input.cleanup_dependencies)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<Dependency>(ref mut cleanup_dependencies,*v::at<Dependency>(ref input.cleanup_dependencies,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    var v::Vec<SourceStamp> stamps=v::empty<SourceStamp>();i=0;while(i<v::len<SourceStamp>(ref input.stamps)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<SourceStamp>(ref mut stamps,*v::at<SourceStamp>(ref input.stamps,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    i=0;while(i<v::len<usize>(seeds)){let p=cleanup_requests(sources,metadata,ref mut instances,ref mut arguments,ref mut parameters,ref mut dependencies,ref mut cleanups,ref mut cleanup_dependencies,ref mut budget,graph,*v::at<usize>(seeds,i));if(p.code!=0){return .err(p);}i+=1;}
    var v::Vec<types::Type> prefix=v::empty<types::Type>();i=1;while(i<=types::count(graph)){if(!charge(ref mut budget,1)){return .err(fail(4503,0,0,0));}if(!v::push<types::Type>(ref mut prefix,types::at(graph,i)).is_ok){return .err(fail(11,0,0,0));}i+=1;}
    return .ok(Plan{.instances,.arguments,.parameters,.calls,.dependencies,.cleanups,.cleanup_dependencies,.stamps,.prefix,.work=budget.work});
}
pub fn Result<Plan,join::Problem> extend_cleanups(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,Plan input,ref mut v::Vec<types::Type> graph,ref v::Vec<usize> seeds){
    let usize before=types::count(graph);return switch(expand_cleanups(sources,metadata,input,graph,seeds)){case .ok(p):{.ok(p)}case .err(p):{while(types::count(graph)>before){discard v::pop<types::Type>(graph);}.err(p)}};
}
pub fn join::Problem validate(ref Plan p,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref v::Vec<types::Type> graph){
    if(v::len<SourceStamp>(ref p.stamps)!=v::len<syntax::Parsed>(sources) || signatures::module_count(metadata)!=v::len<syntax::Parsed>(sources) || types::count(graph)<v::len<types::Type>(ref p.prefix)){return fail(12,0,0,0);}var usize i=0;
    // Exact source comparison above each stamp check retains freshness. The
    // catalog owns the digest of those same bytes, so hashing again adds no proof.
    while(i<v::len<syntax::Parsed>(sources)){let source=v::at<syntax::Parsed>(sources,i);let text=syntax::source_view(source);let stamp=*v::at<SourceStamp>(ref p.stamps,i);if(text.len!=stamp.length || !signatures::source_matches(metadata,i,source)){return fail(12,i,0,0);}let digest=signatures::source_digest(metadata,i);var usize n=0;while(n<8){if(digest[n]!=stamp.digest[n]){return fail(12,i,0,0);}n+=1;}i+=1;}
    i=1;while(i<=v::len<types::Type>(ref p.prefix)){let a=types::at(graph,i);let b=*v::at<types::Type>(ref p.prefix,i-1);if(a.kind!=b.kind || a.scalar!=b.scalar || a.module_index!=b.module_index || a.declaration!=b.declaration || a.first!=b.first || a.second!=b.second){return fail(12,0,0,0);}i+=1;}return fail(0,0,0,0);
}
pub fn Result<Plan,join::Problem> build(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref binding::Bound bound,ref mut v::Vec<types::Type> graph){
    var usize i=0;while(i<v::len<syntax::Parsed>(sources)){if(!signatures::source_matches(metadata,i,v::at<syntax::Parsed>(sources,i))){return .err(fail(12,i,0,0));}i+=1;}
    let usize before=types::count(graph);return switch(collect(sources,metadata,bound,graph)){case .ok(p):{.ok(p)}case .err(p):{while(types::count(graph)>before){discard v::pop<types::Type>(graph);}.err(p)}};
}
