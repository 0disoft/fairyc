module module_unit_value_variant;
import module_unit_value_model as m;
import module_unit_value_scalar as scalar;
import module_unit_interfaces as interfaces;
import module_types as types;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;

pub fn Result<interfaces::Shape,m::Problem> shape(ref interfaces::Interfaces imported,m::Frame frame,m::Expression e,usize type,ref mut usize work){var usize i=0;while(i<interfaces::shape_count(imported)){if(!m::charge(work,1)){return .err(m::fail(frame,10,e.start,e.end,0,0));}let s=interfaces::shape_at(imported,i);if(s.type==type){return .ok(s);}i+=1;}return .err(m::fail(frame,12,e.start,e.end,0,type));}
pub fn Result<usize,m::Problem> member(ref interfaces::Interfaces imported,m::Frame frame,m::Expression e,interfaces::Shape s,ref u8[] name,ref mut usize work){var usize i=0;while(i<s.field_count){let usize id=s.field_start+i;let f=interfaces::field_at(imported,id);if(!m::charge(work,name.len+1)){return .err(m::fail(frame,10,e.start,e.end,0,0));}if(f.kind==3 && bytes::equal(interfaces::field_name(imported,id),name)){return .ok(id+1);}i+=1;}return .err(m::fail(frame,2,e.start,e.end,0,s.type));}
pub fn Result<usize,m::Problem> field(ref interfaces::Interfaces imported,m::Frame frame,m::Expression e,usize variant,ref u8[] name,ref mut usize work){let selected=interfaces::field_at(imported,variant-1);var usize i=0;while(i<selected.payload_count){let usize id=selected.payload_start+i;if(!m::charge(work,name.len+1)){return .err(m::fail(frame,10,e.start,e.end,0,0));}if(bytes::equal(interfaces::field_name(imported,id),name)){return .ok(id+1);}i+=1;}return .err(m::fail(frame,2,e.start,e.end,0,0));}
pub fn m::Field provenance(ref interfaces::Interfaces imported,usize id,usize owner){let f=interfaces::field_at(imported,id-1);return m::Field{.id,.owner,.module_index=f.module_index,.declaration=f.declaration,.source_index=f.source_index};}
fn void record(ref mut v::Vec<m::Expression> expressions,usize id,usize type,usize variant,ref interfaces::Interfaces imported){let slot=v::at_mut<m::Expression>(expressions,id-1);slot.state=1;slot.type=type;slot.expected=type;slot.target=type;slot.place=m::no_place();if(variant!=0){slot.field=provenance(imported,variant,type);}}
fn m::Problem bare(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref mut v::Vec<m::Expression> expressions,ref mut usize work){let e=*v::at<m::Expression>(expressions,id-1);let name=syntax::expression_text(source,e.source_index);if(!m::charge(work,name.len+1)){return m::fail(frame,10,e.start,e.end,0,0);}if(expected==0){return m::fail(frame,2,e.start,e.end,0,0);}let t=types::at(graph,expected);
    if(bytes::equal(name,b"none")){if(t.kind!=5){return m::fail(frame,2,e.start,e.end,0,expected);}record(expressions,id,expected,0,imported);return m::fail(frame,0,0,0,0,0);}if(bytes::equal(name,b"some") || bytes::equal(name,b"ok") || bytes::equal(name,b"err") || t.kind!=4){return m::fail(frame,2,e.start,e.end,0,expected);}
    let s=switch(shape(imported,frame,e,expected,work)){case .ok(s):{s}case .err(p):{return p;}};let variant=switch(member(imported,frame,e,s,name,work)){case .ok(v):{v}case .err(p):{return p;}};if(interfaces::field_at(imported,variant-1).payload_count!=0){return m::fail(frame,2,e.start,e.end,0,expected);}record(expressions,id,expected,variant,imported);return m::fail(frame,0,0,0,0,0);
}
fn m::Problem call(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){let e=*v::at<m::Expression>(expressions,id-1);if(expected==0){return m::fail(frame,2,e.start,e.end,0,0);}let t=types::at(graph,expected);let name=syntax::expression_text(source,e.left);if(!m::charge(work,name.len+1)){return m::fail(frame,10,e.start,e.end,0,0);}var usize payload=0;
    if(bytes::equal(name,b"some") && t.kind==5){payload=t.first;}else if((bytes::equal(name,b"ok") || bytes::equal(name,b"err")) && t.kind==6){payload=if(bytes::equal(name,b"ok")){t.first}else{t.second};}else{return m::fail(frame,2,e.start,e.end,0,expected);}if(e.right==0){return m::fail(frame,2,e.start,e.end,0,expected);}let argument=syntax::expression_at(source,e.right);if(argument.kind!=7 || argument.right!=0){return m::fail(frame,2,e.start,e.end,0,expected);}let usize child=m::index(expressions,argument.left);let usize wrapper=m::index(expressions,e.right);let usize callee=m::index(expressions,e.left);if(child==0 || wrapper==0 || callee==0 || payload==0){return m::fail(frame,12,e.start,e.end,0,0);}
    let p=scalar::evaluate(source,frame,child,payload,imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}let actual=*v::at<m::Expression>(expressions,child-1);if(actual.state==2 || actual.type!=0 && actual.type!=payload){return m::fail(frame,1006,actual.start,actual.end,payload,actual.type);}let callee_slot=v::at_mut<m::Expression>(expressions,callee-1);callee_slot.state=2;callee_slot.type=0;callee_slot.expected=expected;let arg_slot=v::at_mut<m::Expression>(expressions,wrapper-1);arg_slot.expected=payload;if(actual.type!=0){record(expressions,id,expected,0,imported);}return m::fail(frame,0,0,0,0,0);
}
fn m::Problem aggregate(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){let e=*v::at<m::Expression>(expressions,id-1);if(expected==0 || types::at(graph,expected).kind!=4){return m::fail(frame,2,e.start,e.end,0,expected);}let s=switch(shape(imported,frame,e,expected,work)){case .ok(s):{s}case .err(p):{return p;}};let variant=switch(member(imported,frame,e,s,syntax::expression_text(source,e.left),work)){case .ok(v):{v}case .err(p):{return p;}};let selected=interfaces::field_at(imported,variant-1);
    var v::Vec<usize> seen=v::empty<usize>();var usize i=0;while(i<selected.payload_count){if(!m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}if(!v::push<usize>(ref mut seen,0).is_ok){return m::fail(frame,11,e.start,e.end,0,0);}i+=1;}var v::Vec<usize> order=v::empty<usize>();var usize link=e.right;while(link!=0){if(!m::charge(work,1) || v::len<usize>(ref order)>=1024){return m::fail(frame,10,e.start,e.end,0,0);}let row=syntax::expression_at(source,link);if(row.kind!=11){return m::fail(frame,12,row.start,row.end,0,0);}if(!v::push<usize>(ref mut order,link).is_ok){return m::fail(frame,11,row.start,row.end,0,0);}link=row.right;}
    var bool complete=true;i=v::len<usize>(ref order);while(i>0){i-=1;let usize original=*v::at<usize>(ref order,i);let usize wrapper=m::index(expressions,original);if(wrapper==0){return m::fail(frame,12,e.start,e.end,0,0);}let row=*v::at<m::Expression>(expressions,wrapper-1);let target=switch(field(imported,frame,row,variant,syntax::expression_text(source,original),work)){case .ok(id):{id}case .err(p):{return p;}};let f=interfaces::field_at(imported,target-1);if(target<=selected.payload_start || target>selected.payload_start+selected.payload_count || f.type==0){return m::fail(frame,12,row.start,row.end,0,0);}let usize position=target-1-selected.payload_start;if(*v::at<usize>(ref seen,position)!=0){return m::fail(frame,2,row.start,row.end,0,0);}let mark=v::at_mut<usize>(ref mut seen,position);*mark=original;let usize child=m::index(expressions,row.left);if(child==0){return m::fail(frame,12,row.start,row.end,0,0);}let p=scalar::evaluate(source,frame,child,f.type,imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}let actual=*v::at<m::Expression>(expressions,child-1);if(actual.state==2 || actual.type!=0 && actual.type!=f.type){return m::fail(frame,1006,actual.start,actual.end,f.type,actual.type);}if(actual.type==0){complete=false;}let annotation=v::at_mut<m::Expression>(expressions,wrapper-1);annotation.field=provenance(imported,target,expected);annotation.expected=f.type;
    }if(v::len<usize>(ref order)!=selected.payload_count){return m::fail(frame,2,e.start,e.end,0,expected);}let usize callee=m::index(expressions,e.left);if(callee==0){return m::fail(frame,12,e.start,e.end,0,0);}let slot=v::at_mut<m::Expression>(expressions,callee-1);slot.state=2;slot.expected=expected;if(complete){record(expressions,id,expected,variant,imported);}return m::fail(frame,0,0,0,0,0);
}
pub fn m::Problem evaluate(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){let e=*v::at<m::Expression>(expressions,id-1);return if(e.kind==28){bare(source,frame,id,expected,imported,graph,expressions,work)}else if(e.kind==6){call(source,frame,id,expected,imported,graph,atoms,expressions,work,depth)}else{aggregate(source,frame,id,expected,imported,graph,atoms,expressions,work,depth)};}
