            if(!seen[wire-1]){seen[wire-1]=true;if(!w::text(out,s,b"struct ") || !w::text(out,s,wire_name(wire)) || !w::text(out,s,b"{")){return false;}var usize j=0;while(j<field_count(wire)){if(!w::type(out,s,field_type(wire,j)) || !w::text(out,s,b" ") || !w::text(out,s,field_name(wire,j)) || !w::text(out,s,b";")){return false;}j+=1;}if(!w::text(out,s,b"};\n")){return false;}}
