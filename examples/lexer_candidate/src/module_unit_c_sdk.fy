                if(wire!=0 || is_arena || is_error || is_buffer || is_string || is_cstring || is_file || is_vector){let found=switch(shape(p,ref original,i,work)){case .ok(s):{s}case .err(e):{return .err(e);}};if(found==0){if(used(p,i,!is_vector && !is_string && !is_cstring && !is_file,work)){return .err(fail(if(*work>=1048576){1002}else{1001},unit.module_index,d.start,d.end));}if(is_vector){let slot=v::at_mut<usize>(ref mut vectors,i-1);*slot=ir::layout_count(p)+1;}i+=1;continue;}let s=ir::layout_at(p,found-1).value;
