// Closed runtime records use their real C tags. Internal nominal fields remain
// distinct, and adapters copy fields instead of claiming compatible C types.
pub resource Plan {v::Vec<usize> rules;v::Vec<usize> records;v::Vec<usize> layouts;v::Vec<usize> vectors;usize arena;usize alloc_error;usize buffer;usize string;usize cstring;usize file;cleanup{}}
fn clean::Problem fail(u32 code,usize module_index,usize start,usize end){return clean::Problem{.code,.module_index,.start,.end};}
fn ref u8[] slot(ref u8[] pool,usize index,usize count){if(index==0 || index>count){return pool[..0];}var usize start=0;var usize i=1;while(i<index){while(pool[start]!=0){start+=1;}start+=1;i+=1;}var usize end=start;while(pool[end]!=0){end+=1;}return pool[start..end];}
fn ref u8[] source_name(usize record){if(file_storage::fields(record)!=0){return file_rules::record_name(record);}let pool=b"raw_process_args_result\0raw_text_result\0raw_text_view\0raw_console_write_result\0raw_console_read_result\0";return slot(pool,record,5);}
fn ref u8[] wire_name(usize record){if(file_storage::fields(record)!=0){return file_storage::wire_name(record);}let pool=b"fy_std_process_args_result_v0\0fy_std_owned_text_result_v0\0fy_std_text_view_v0\0fy_std_console_write_result_v0\0fy_std_console_read_result_v0\0";return slot(pool,record,5);}
fn usize record_id(ref u8[] name,usize sdk_id){if(sdk_id==3){var usize record=6;while(record<=13){if(file_storage::fields(record)!=0 && bytes::equal(name,source_name(record))){return record;}record+=1;}return 0;}var usize i=1;while(i<=5){if(sdk_id==if(i==1){6}else if(i<=3){7}else{4} && bytes::equal(name,source_name(i))){return i;}i+=1;}return 0;}
fn usize field_count(usize record){return if(record<=5){2}else{file_storage::fields(record)};}
fn ref u8[] field_name(usize record,usize index){if(record>=6){return file_storage::field_name(record,index);}let pool=b"status\0needed\0allocation_status\0data\0length\0written\0read\0";let usize at=if(record==3){if(index==0){4}else{5}}else if(index==0){1}else if(record==1){2}else if(record==2){3}else if(record==4){6}else{7};return slot(pool,at,7);}
fn u32 field_type(usize record,usize index){if(record>=6){return file_rules::field_type(record,index);}return if(record==3 && index==0){pointers::make(3,false)}else if(index==0 || record==2){4}else{5};}
pub fn usize rule(ref Plan p,usize callable){assert(callable<v::len<usize>(ref p.rules));return *v::at<usize>(ref p.rules,callable);}
pub fn usize arena_type(ref Plan p){return p.arena;}
pub fn usize allocation_error(ref Plan p){return p.alloc_error;}
pub fn usize status_field(ref ir::Program p,ref Plan plan){assert(plan.alloc_error!=0);return ir::layout_at(p,layout(plan,plan.alloc_error)-1).value.field_start+1;}
// Other authenticated SDK components still need their storage/record bridges.
pub fn bool admitted(usize code){return code>=1 && code<=32 || code==70 || code==71 || file_storage::admitted(code);}
pub fn usize record(ref Plan p,usize type){return if(type==0 || type>v::len<usize>(ref p.records)){0}else{*v::at<usize>(ref p.records,type-1)};}
fn usize layout(ref Plan p,usize type){return *v::at<usize>(ref p.layouts,type-1);}
fn Result<usize,clean::Problem> shape(ref ir::Program p,ref syntax::Parsed original,usize type,ref mut usize work){let t=clean::type_at(ir::cleanup_ir(p),type);if(t.declaration==0 || t.declaration>syntax::declaration_count(original)){return .err(fail(1001,t.module_index,0,0));}let d=syntax::declaration_at(original,t.declaration-1);var usize found=0;var usize i=0;
    while(i<ir::layout_count(p)){if(!budget::charge(work,1)){return .err(fail(1002,t.module_index,0,0));}let s=ir::layout_at(p,i).value;if(s.type==type){if(found!=0 || s.module_index!=t.module_index || s.declaration!=t.declaration || s.start!=d.start || s.end!=d.end || s.field_count!=d.field_count || s.field_start>ir::field_count(p) || s.field_count>ir::field_count(p)-s.field_start || !bytes::equal(ir::layout_name(p,i),syntax::source_view(original)[d.name_start..d.name_end])){return .err(fail(1001,t.module_index,d.start,d.end));}found=i+1;}i+=1;}
    if(found==0){return .ok(0);}let s=ir::layout_at(p,found-1).value;i=0;
    while(i<s.field_count){if(!budget::charge(work,1)){return .err(fail(1002,t.module_index,d.start,d.end));}let f=ir::field_at(p,s.field_start+i);let original_field=syntax::field_at(original,d.field_start+i);
        if(f.kind!=0 || f.module_index!=t.module_index || f.declaration!=t.declaration || f.source_index!=d.field_start+i || f.start!=original_field.start || f.end!=original_field.end || f.payload_count!=0 || !bytes::equal(ir::field_name(p,s.field_start+i),syntax::source_view(original)[original_field.name_start..original_field.name_end]) || !authority::type_matches(p,original,t.module_index,original_field.type_root,f.type,0,work)){return .err(fail(if(*work>=1048576){1002}else{1001},t.module_index,f.start,f.end));}i+=1;
    }return .ok(found);
}
fn bool carries(ref ir::Program p,usize actual,usize wanted,usize depth,ref mut usize work){if(depth>=64 || !budget::charge(work,1)){return true;}if(actual==wanted){return true;}if(actual==0){return false;}let t=clean::type_at(ir::cleanup_ir(p),actual);return (t.kind>=5 && t.kind<=8 || t.kind==12 && t.first!=0 || t.kind==16) && (carries(p,t.first,wanted,depth+1,work) || t.kind==6 && carries(p,t.second,wanted,depth+1,work));}
fn bool used(ref ir::Program p,usize type,bool signatures,ref mut usize work){var usize i=1;while(i<=ir::count(p)){if(!budget::charge(work,1)){return true;}let b=ir::at(p,i);if(carries(p,clean::frame_at(ir::cleanup_ir(p),i).result,type,0,work)){return true;}var usize j=1;while(j<=ir::local_count(b)){if(carries(p,ir::local_at(b,j).type,type,0,work)){return true;}j+=1;}j=0;while(j<ir::node_count(b)){let e=ir::node_at(b,j).value;if(e.state==1 && carries(p,e.type,type,0,work)){return true;}j+=1;}i+=1;}i=0;while(signatures && i<ir::callable_count(p)){if(!budget::charge(work,1)){return true;}let c=ir::callable_at(p,i);if(carries(p,c.result,type,0,work)){return true;}var usize j=0;while(j<c.parameter_count){if(carries(p,ir::parameter_at(p,c.parameter_start+j),type,0,work)){return true;}j+=1;}i+=1;}return false;}
