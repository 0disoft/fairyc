module project_atlas_write;
import project_json_string as quoted;
import project_path as work;
import std::bytes as bytes;
import sha256_stream as sha;
pub fn Result<bool,u32> raw(ref mut bytes::Buffer out,ref u8[] s,ref mut usize meter){if(bytes::len(out)>4194304 || s.len>4194304-bytes::len(out) || !work::charge(meter,s.len+1)){return .err(3);}if(!bytes::append(out,s).is_ok){return .err(2);}return .ok(true);}
pub fn Result<bool,u32> string(ref mut bytes::Buffer out,ref u8[] s,ref mut usize meter){let q=quoted::quote(s,meter)?;return raw(out,bytes::view(ref q),meter);}
pub fn Result<bool,u32> pair(ref mut bytes::Buffer out,ref u8[] name,ref u8[] value,ref mut usize meter){discard string(out,name,meter)?;discard raw(out,b":",meter)?;return string(out,value,meter);}
pub fn Result<bool,u32> number(ref mut bytes::Buffer out,usize n,ref mut usize meter){if(!work::charge(meter,21)){return .err(3);}if(!bytes::append_usize(out,n).is_ok){return .err(2);}return .ok(true);}
pub fn bool hash_number(ref mut sha::State state,usize n){let digits=b"\x00\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f";var usize rest=n;var u8[8] data=[0;8];var usize i=8;while(i>0){i-=1;data[i]=(digits[(rest%256)/16]<<4)|digits[rest%16];rest/=256;}return rest==0 && sha::update(state,ref data);}
pub fn Result<bytes::Buffer,u32> source_hash(ref u8[] source,bool lines,ref mut usize meter){if(!work::charge(meter,source.len+1)){return .err(3);}var sha::State state=sha::empty();if(!sha::update(ref mut state,if(lines){b"fairyc.source-line-map\0\x01"}else{b"fairyc.source-file\0\x01"}) || !hash_number(ref mut state,source.len)){return .err(3);}if(lines){var usize count=1;var usize i=0;while(i<source.len){if(source[i]==10){count+=1;}i+=1;}if(!hash_number(ref mut state,count) || !hash_number(ref mut state,0)){return .err(3);}i=0;while(i<source.len){if(source[i]==10 && !hash_number(ref mut state,i+1)){return .err(3);}i+=1;}}else if(!sha::update(ref mut state,source)){return .err(3);}var bytes::Buffer out=bytes::empty();discard raw(ref mut out,if(lines){b"fylm1-sha256-"}else{b"fyfile1-sha256-"},meter)?;if(!sha::append_hex(ref state,ref mut out)){return .err(2);}return .ok(out);}
pub fn Result<bytes::Buffer,u32> envelope(ref u8[] map,ref mut usize meter){if(!work::charge(meter,map.len+1)){return .err(3);}var sha::State state=sha::empty();let schema=b"fairyc.fymap/v3";let encoding=b"fairyc.fymap-json/v3";if(!sha::update(ref mut state,b"fairyc.fymap-checksum\0\x01") || !hash_number(ref mut state,schema.len) || !sha::update(ref mut state,schema) || !hash_number(ref mut state,encoding.len) || !sha::update(ref mut state,encoding) || !hash_number(ref mut state,map.len) || !sha::update(ref mut state,map)){return .err(3);}var bytes::Buffer digest=bytes::empty();discard raw(ref mut digest,b"fymap1-sha256-",meter)?;if(!sha::append_hex(ref state,ref mut digest)){return .err(2);}var bytes::Buffer out=bytes::empty();discard raw(ref mut out,b"{\"schema\":\"fairyc.fymap/v3\",\"encoding\":\"fairyc.fymap-json/v3\",\"checksum_algorithm\":\"fairyc.fymap-checksum/v1-sha256\",\"checksum\":",meter)?;discard string(ref mut out,bytes::view(ref digest),meter)?;discard raw(ref mut out,b",\"map\":",meter)?;discard raw(ref mut out,map,meter)?;discard raw(ref mut out,b"}",meter)?;return .ok(out);}
