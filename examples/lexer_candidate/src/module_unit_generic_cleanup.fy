module module_unit_generic_cleanup;
import module_unit_generics as m;
import module_signatures as signatures;
import module_types as types;
import module_ast_join as join;
import syntax as syntax;
import effect_declarations as effects;
import storage_intrinsics as storage;
import std::bytes as bytes;
import std::vec as v;
import resource_abilities as abilities;
import generic_scalar_arguments as source_arguments;

// Preserve the shared specialization budget while checking cleanup source bodies
// in a separate compilation unit. The owning Plan remains in module_unit_generics.
fn bool cleanup_take_leaf(ref syntax::Parsed source,usize declaration,bool vector){
    let d=syntax::declaration_at(source,declaration-1);if(!vector || d.kind!=3 || d.public || d.unsafe_end!=0 || d.attribute_count!=0 || d.body==0 || d.generic_parameters==0 || syntax::generic_parameter_count(source,declaration-1)!=1 || !bytes::equal(syntax::source_view(source)[d.name_start..d.name_end],b"take_slot") || !bytes::equal(syntax::type_text(source,d.result_type),b"T") || d.entry_count!=2 || syntax::block_statement_count(source,d.body)!=1){return false;}
    let param=syntax::entry_at(source,d.entry_start);let pointer=syntax::type_at(source,param.type_root);if(param.kind!=1 || !bytes::equal(syntax::source_view(source)[param.name_start..param.name_end],b"slot") || pointer.kind!=12 || !bytes::equal(syntax::type_text(source,pointer.left),b"void")){return false;}
    let returned=syntax::statement_at(source,syntax::block_statement(source,d.body,0));if(returned.kind!=3 || returned.expression==0){return false;}let value=syntax::expression_at(source,returned.expression);if(value.kind!=31 || value.left==0){return false;}let block=syntax::statement_at(source,value.left);if(block.kind!=1 || block.second!=0 || block.expression==0){return false;}
    let call=syntax::expression_at(source,block.expression);if(call.kind!=6 || call.left==0 || syntax::call_argument_count(source,block.expression)!=1){return false;}let generic=syntax::expression_at(source,call.left);if(generic.kind!=20 || generic.left==0 || syntax::specialization_argument_count(source,call.left)!=1 || !bytes::equal(syntax::expression_text(source,generic.left),b"storage_take") || !bytes::equal(syntax::type_text(source,syntax::specialization_argument(source,call.left,0)),b"T")){return false;}
    let arg=syntax::call_argument(source,block.expression,0);return !syntax::call_argument_labeled(source,syntax::call_argument_entry(source,block.expression,0)) && syntax::expression_at(source,arg).kind==2 && bytes::equal(syntax::expression_text(source,arg),b"slot");
}
pub fn join::Problem requests(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref mut v::Vec<m::Instance> instances,ref mut v::Vec<usize> arguments,ref mut v::Vec<usize> parameters,ref mut v::Vec<m::Dependency> dependencies,ref mut v::Vec<m::Cleanup> cleanups,ref mut v::Vec<m::Dependency> cleanup_dependencies,ref mut m::Budget budget,ref mut v::Vec<types::Type> graph,usize type){
    if(type==0 || type>types::count(graph)){return m::fail(9,0,0,0);}let t=types::at(graph,type);if(t.kind!=3 && t.kind!=13){return m::fail(9,0,0,0);}var usize j=0;while(j<v::len<m::Cleanup>(cleanups)){if(v::at<m::Cleanup>(cleanups,j).type==type){return m::fail(0,0,0,0);}j+=1;}
    let original=v::at<syntax::Parsed>(sources,t.module_index);let d=syntax::declaration_at(original,t.declaration-1);if(!signatures::source_matches(metadata,t.module_index,original)){return m::fail(12,t.module_index,0,0);}if(d.kind!=6 || d.cleanup_body==0 || d.cleanup_attribute_count!=0){return m::fail(3,t.module_index,d.start,d.end);}if(v::len<m::Cleanup>(cleanups)>=512){return m::fail(10,t.module_index,d.start,d.end);}
    let bool vector=t.kind==13 && signatures::sdk_vector_source(metadata,t.module_index) && bytes::equal(syntax::source_view(original)[d.name_start..d.name_end],b"Vec");if((d.generic_parameters!=0)!=vector){return m::fail(4501,t.module_index,d.start,d.end);}
    var v::Vec<usize> args=v::empty<usize>();let usize argument_start=v::len<usize>(arguments);if(vector){if(!v::push<usize>(ref mut args,t.first).is_ok || !v::push<usize>(arguments,t.first).is_ok){return m::fail(11,t.module_index,d.start,d.end);}}
    let ability=abilities::read(original,t.declaration-1);if(!m::charge(budget,ability.work)){return m::fail(4503,t.module_index,d.start,d.end);}if(ability.code!=0){return m::fail(ability.code,t.module_index,ability.start,ability.end);}let contract=effects::read(original,t.declaration-1);if(contract.code!=0){return m::fail(contract.code,t.module_index,contract.start,contract.end);}var v::Vec<u8> states=v::empty<u8>();j=0;while(j<m::instance_limit()){if(!v::push<u8>(ref mut states,if(j<v::len<m::Instance>(instances)){2}else{0}).is_ok){return m::fail(11,t.module_index,d.start,d.end);}j+=1;}let usize id=v::len<m::Cleanup>(cleanups)+1;var usize i=1;
    while(i<=syntax::expression_count(original)){if(!m::charge(budget,1)){return m::fail(4503,t.module_index,d.cleanup_start,d.cleanup_end);}let e=syntax::expression_at(original,i);if(e.kind==20 && e.start>=d.cleanup_start && e.end<=d.cleanup_end){let base=syntax::expression_at(original,e.left);if(base.kind!=2){return m::fail(4501,t.module_index,e.start,e.end);}let name=syntax::expression_text(original,e.left);var u32 intrinsic=if(vector){storage::named(name)}else{0};var usize target=0;var usize aggregate_type=0;var usize intrinsic_type=0;var bool slice=false;var usize inline_declaration=0;
        if(intrinsic!=0){if(syntax::specialization_argument_count(original,i)!=1){return m::fail(4501,t.module_index,e.start,e.end);}var usize root=syntax::specialization_argument(original,i,0);let n=syntax::type_at(original,root);if(n.kind==4){slice=true;root=n.left;}let r=signatures::specialize_type(metadata,original,t.module_index,t.declaration,root,ref args,graph);if(r.problem.code!=0){return m::fail(r.problem.code,t.module_index,r.problem.start,r.problem.end);}intrinsic_type=r.type;}
        else{if(m::shadow(original,t.declaration,name,budget)){return m::fail(if(budget.work>=1048576){4503}else{4501},t.module_index,base.start,base.end);}let found=signatures::declaration_lookup(metadata,t.module_index,name);if(found.code!=0){return m::fail(found.code,t.module_index,base.start,base.end);}let callee=signatures::declaration_at(metadata,found.item);var v::Vec<usize> forwarded=v::empty<usize>();j=0;
            while(j<syntax::specialization_argument_count(original,i)){let usize root=syntax::specialization_argument(original,i,j);let empty=v::empty<usize>();let r=if(vector){signatures::resolve_argument(metadata,original,t.module_index,t.declaration,root,ref args,graph)}else{signatures::resolve_argument(metadata,original,t.module_index,0,root,ref empty,graph)};if(r.problem.code!=0){return m::fail(r.problem.code,t.module_index,r.problem.start,r.problem.end);}if(!v::push<usize>(ref mut forwarded,r.type).is_ok){return m::fail(11,t.module_index,e.start,e.end);}j+=1;}
            if(vector && callee.module_index==t.module_index && cleanup_take_leaf(original,callee.declaration,vector)){if(v::len<usize>(ref forwarded)!=1){return m::fail(4501,t.module_index,e.start,e.end);}if(source_arguments::descriptor(*v::at<usize>(ref forwarded,0))){return m::fail(5,t.module_index,e.start,e.end);}intrinsic=3;intrinsic_type=*v::at<usize>(ref forwarded,0);inline_declaration=callee.declaration;}
            else if(vector && callee.kind==6 && callee.module_index==t.module_index && bytes::equal(name,b"Vec")){if(v::len<usize>(ref forwarded)!=1){return m::fail(4501,t.module_index,e.start,e.end);}if(source_arguments::descriptor(*v::at<usize>(ref forwarded,0))){return m::fail(5,t.module_index,e.start,e.end);}aggregate_type=types::canonical(graph,types::Type{.kind=13,.scalar=0,.module_index=callee.module_index,.declaration=callee.declaration,.first=*v::at<usize>(ref forwarded,0),.second=0});if(aggregate_type==0){return m::fail(if(types::count(graph)>=4096){4503}else{11},t.module_index,e.start,e.end);}}
            else{target=switch(m::instantiate(sources,metadata,callee.module_index,callee.declaration,ref forwarded,graph,instances,arguments,parameters,budget,t.module_index,e.start,e.end)){case .ok(n):{n}case .err(p):{return p;}};let problem=m::forward(sources,metadata,graph,instances,arguments,parameters,dependencies,ref mut states,budget,target,1);if(problem.code!=0){return problem;}}
        }
        if(v::len<m::Dependency>(dependencies)+v::len<m::Dependency>(cleanup_dependencies)>=16384 || !v::push<m::Dependency>(cleanup_dependencies,m::Dependency{.owner=id,.source_index=i,.instance=target,.aggregate_type,.intrinsic,.intrinsic_type,.slice,.inline_declaration,.inline_unsafe=inline_declaration!=0}).is_ok){return m::fail(if(v::len<m::Dependency>(dependencies)+v::len<m::Dependency>(cleanup_dependencies)>=16384){4503}else{11},t.module_index,e.start,e.end);}
    }i+=1;}
    if(v::len<m::Dependency>(dependencies)+v::len<m::Dependency>(cleanup_dependencies)>16384){return m::fail(4503,t.module_index,d.cleanup_start,d.cleanup_end);}if(!v::push<m::Cleanup>(cleanups,m::Cleanup{.type,.module_index=t.module_index,.declaration=t.declaration,.argument_start,.argument_count=v::len<usize>(ref args),.start=d.cleanup_start,.end=d.cleanup_end,.effects=contract.bits,.abilities=ability.bits,.receiver_kind=10}).is_ok){return m::fail(11,t.module_index,d.start,d.end);}return m::fail(0,0,0,0);
}
