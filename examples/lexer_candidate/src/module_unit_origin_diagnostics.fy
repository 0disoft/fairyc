module module_unit_origin_diagnostics;
import module_unit_origin_returns as origins;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_value_model as m;
import module_unit_moves as moves;
import module_unit_cleanup_policy as cleanup_policy;
import std::vec as v;

// code 2 is unsupported origin analysis, never an E0002 diagnostic.
// Related roles: 1 origin, 2 candidate-origin, 3 allocation, 4 loan, 5 last-use, 6 owner, 7 declaration, 8 move, 9 loop-header, 10 field, 11 ability-declaration, 12 effect-declaration.
pub struct Related {u32 role;usize module_index;usize start;usize end;usize owner;}
pub struct Diagnostic {u32 feature;usize frame;u32 code;usize module_index;usize start;usize end;usize related_start;usize related_count;}
pub resource Report {v::Vec<Diagnostic> diagnostics;v::Vec<Related> related;usize work;usize visible;bool semantic;bool unsupported;cleanup{}}
pub fn usize count(ref Report p){return v::len<Diagnostic>(ref p.diagnostics);}
pub fn Diagnostic at(ref Report p,usize index){return *v::at<Diagnostic>(ref p.diagnostics,index);}
pub fn Related related_at(ref Report p,Diagnostic d,usize index){assert(index<d.related_count);return *v::at<Related>(ref p.related,d.related_start+index);}
// The CLI publishes semantic diagnostics first, or its unsupported facts.
pub fn usize visible_count(ref Report p){return p.visible;}
pub fn bool visible_at(ref Report p,usize index){return if(p.semantic){at(p,index).code!=2}else{at(p,index).code==2};}
pub fn usize work(ref Report p){return p.work;}
pub fn u32 exit_code(ref Report p){return if(p.semantic){3}else if(p.unsupported){2}else{0};}
fn bool before(Related a,Related b){return a.module_index<b.module_index || a.module_index==b.module_index && (a.start<b.start || a.start==b.start && (a.end<b.end || a.end==b.end && a.role<b.role));}
fn bool same(Related a,Related b){return a.role==b.role && a.module_index==b.module_index && a.start==b.start && a.end==b.end;}
fn m::Problem fail(m::Frame f,u32 code,usize start,usize end){return m::fail(f,code,start,end,0,0);}
fn m::Problem append_related(ref mut v::Vec<Related> related,Related next,m::Frame f,ref mut usize work){
    if(!m::charge(work,1) || v::len<Related>(related)>=16384){return fail(f,10,next.start,next.end);}if(!v::push<Related>(related,next).is_ok){return fail(f,11,next.start,next.end);}var usize i=v::len<Related>(related)-1;while(i>0 && before(next,*v::at<Related>(related,i-1))){if(!m::charge(work,1)){return fail(f,10,next.start,next.end);}let old=*v::at<Related>(related,i-1);let slot=v::at_mut<Related>(related,i);*slot=old;i-=1;}let slot=v::at_mut<Related>(related,i);*slot=next;return fail(f,0,0,0);
}
// Deduplicate only identical source diagnostics and related locations. Frame-
// local owner IDs may differ between generic instances of one declaration.
fn m::Problem publish(Diagnostic next,ref v::Vec<Related> candidates,ref mut v::Vec<Diagnostic> diagnostics,ref mut v::Vec<Related> related,ref mut v::Vec<usize> cache,m::Frame f,ref mut usize work){
    let usize capacity=v::len<usize>(cache);var usize slot=((next.module_index%capacity)*8192+next.start%capacity+(next.code as usize))%capacity;var bool found=false;
    while(!found){if(!m::charge(work,1)){return fail(f,10,next.start,next.end);}let usize known=*v::at<usize>(cache,slot);if(known==0){found=true;}else{let old=*v::at<Diagnostic>(diagnostics,known-1);if(old.code==next.code && old.feature==next.feature && old.module_index==next.module_index && old.start==next.start && old.end==next.end && old.related_count==v::len<Related>(candidates)){var usize i=0;var bool equal=true;while(i<old.related_count && equal){if(!m::charge(work,1)){return fail(f,10,next.start,next.end);}equal=same(*v::at<Related>(related,old.related_start+i),*v::at<Related>(candidates,i));i+=1;}if(equal){return fail(f,0,0,0);}}slot=(slot+1)%capacity;}}
    if(v::len<Diagnostic>(diagnostics)>=8192 || v::len<Related>(candidates)>32768-v::len<Related>(related)){return fail(f,10,next.start,next.end);}if(!m::charge(work,v::len<Related>(candidates)+1)){return fail(f,10,next.start,next.end);}var d=next;d.related_start=v::len<Related>(related);d.related_count=v::len<Related>(candidates);var usize i=0;while(i<d.related_count){if(!v::push<Related>(related,*v::at<Related>(candidates,i)).is_ok){return fail(f,11,next.start,next.end);}i+=1;}if(!v::push<Diagnostic>(diagnostics,d).is_ok){return fail(f,11,next.start,next.end);}let cell=v::at_mut<usize>(cache,slot);*cell=v::len<Diagnostic>(diagnostics);return fail(f,0,0,0);
}
pub fn Result<Report,m::Problem> collect(ref origins::Plan p){return collect_budgeted(p,origins::work(p));}
// Resource diagnostics own their declaration/transfer spans after the source
// and primary Values plans have been released. Roles 7/8/9 are declaration,
// move and loop-header; borrow report roles retain their existing identities.
fn m::Problem append_moves(ref moves::Plan plan,ref mut v::Vec<Diagnostic> diagnostics,ref mut v::Vec<Related> related,ref mut v::Vec<usize> cache,ref mut usize work){
    var usize i=0;while(i<moves::count(plan)){let row=moves::at(plan,i);let f=m::Frame{.kind=0,.context=row.frame,.module_index=row.module_index,.declaration=0,.result=0};if(row.code!=1101 && row.code!=1102 && row.code!=1103 && row.code!=1104 && row.code!=1105 || row.start>=row.end || row.declaration_start>=row.declaration_end){return fail(f,12,row.start,row.end);}
        var v::Vec<Related> candidates=v::empty<Related>();let declaration=append_related(ref mut candidates,Related{.role=if(row.code==1103){6}else{7},.module_index=row.module_index,.start=row.declaration_start,.end=row.declaration_end,.owner=0},f,work);if(declaration.code!=0){return declaration;}
        if(row.code==1103){let field=append_related(ref mut candidates,Related{.role=10,.module_index=row.field_module,.start=row.field_start,.end=row.field_end,.owner=0},f,work);if(field.code!=0){return field;}}
        if(row.move_end!=0){let transfer=append_related(ref mut candidates,Related{.role=8,.module_index=row.module_index,.start=row.move_start,.end=row.move_end,.owner=0},f,work);if(transfer.code!=0){return transfer;}}
        if(row.code==1105){let header=append_related(ref mut candidates,Related{.role=9,.module_index=row.module_index,.start=row.header_start,.end=row.header_end,.owner=0},f,work);if(header.code!=0){return header;}}
        let emitted=publish(Diagnostic{.feature=0,.frame=row.frame,.code=row.code,.module_index=row.module_index,.start=row.start,.end=row.end,.related_start=0,.related_count=0},ref candidates,diagnostics,related,cache,f,work);if(emitted.code!=0){return emitted;}i+=1;
    }return m::Problem{.code=0,.module_index=0,.start=0,.end=0,.expected=0,.actual=0};
}
pub fn Result<Report,m::Problem> collect_budgeted(ref origins::Plan p,usize prior_work){return collect_all(p,prior_work,.none,.none);}
pub fn Result<Report,m::Problem> collect_with_moves(ref origins::Plan p,ref moves::Plan plan){return collect_all(p,moves::work(plan),.some(plan),.none);}
pub fn Result<Report,m::Problem> collect_with_cleanup(ref origins::Plan p,ref moves::Plan plan,ref cleanup_policy::Plan policy){return collect_all(p,cleanup_policy::work(policy),.some(plan),.some(policy));}
fn m::Problem append_cleanup(ref cleanup_policy::Plan plan,ref mut v::Vec<Diagnostic> diagnostics,ref mut v::Vec<Related> related,ref mut v::Vec<usize> cache,ref mut usize work){var usize i=0;while(i<cleanup_policy::count(plan)){let row=cleanup_policy::at(plan,i);let f=m::Frame{.kind=0,.context=row.frame,.module_index=row.module_index,.declaration=0,.result=0};if(row.code!=1108 && row.code!=7102 || row.start>=row.end || row.field_start>=row.field_end){return fail(f,12,row.start,row.end);}var v::Vec<Related> candidates=v::empty<Related>();let anchor=append_related(ref mut candidates,Related{.role=if(row.code==1108){11}else{12},.module_index=row.field_module,.start=row.field_start,.end=row.field_end,.owner=0},f,work);if(anchor.code!=0){return anchor;}let p=publish(Diagnostic{.feature=0,.frame=row.frame,.code=row.code,.module_index=row.module_index,.start=row.start,.end=row.end,.related_start=0,.related_count=0},ref candidates,diagnostics,related,cache,f,work);if(p.code!=0){return p;}i+=1;}return m::Problem{.code=0,.module_index=0,.start=0,.end=0,.expected=0,.actual=0};}
fn Result<Report,m::Problem> collect_all(ref origins::Plan p,usize prior_work,Option<ref moves::Plan> extra,Option<ref cleanup_policy::Plan> policy){
    let input=origins::owned_inputs(p);var usize work=if(prior_work>origins::work(p)){prior_work}else{origins::work(p)};var usize sites=0;var usize id=1;if(origins::count(p)!=inputs::frame_count(input)){return .err(m::Problem{.code=12,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}
    while(id<=origins::count(p)){let f=inputs::frame(input,id);if(!m::charge(ref mut work,1) || origins::return_count(p,id)>8192-sites){return .err(fail(f.value,10,0,0));}sites+=origins::return_count(p,id);id+=1;}if(origins::unknown_count(p)>8192-sites){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}sites+=origins::unknown_count(p);if(origins::conflict_count(p)>8192-sites){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}sites+=origins::conflict_count(p);switch(extra){case .some(plan):{if(moves::count(plan)>8192-sites){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}sites+=moves::count(plan);}case .none:{}};switch(policy){case .some(plan):{if(cleanup_policy::count(plan)>8192-sites){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}sites+=cleanup_policy::count(plan);}case .none:{}};var usize capacity=8;while(capacity<sites*2){capacity*=2;}var v::Vec<usize> cache=v::empty<usize>();var usize i=0;
    while(i<capacity){if(!m::charge(ref mut work,1)){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}if(!v::push<usize>(ref mut cache,0).is_ok){return .err(m::Problem{.code=11,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}i+=1;}
    var v::Vec<Diagnostic> diagnostics=v::empty<Diagnostic>();var v::Vec<Related> related=v::empty<Related>();var bool semantic=false;var bool unsupported=false;var usize unknown=0;id=1;
    while(id<=origins::count(p)){let f=inputs::frame(input,id);i=0;while(i<=origins::return_count(p,id)){
            while(unknown<origins::unknown_count(p)){let fact=origins::unknown_at(p,unknown);if(fact.frame<id || fact.frame>origins::count(p) || fact.frame==id && (fact.after>origins::return_count(p,id) || fact.after<i)){return .err(fail(f.value,12,fact.start,fact.end));}if(fact.frame!=id || fact.after!=i){break;}var v::Vec<Related> candidates=v::empty<Related>();let u32 code=if(fact.kind==4){3101}else{2};if(fact.kind==4){if(fact.origin<3 || fact.origin-2>inputs::owner_count(input) || inputs::owner(input,fact.origin-2).kind!=14 || fact.allocation==0 || fact.allocation>inputs::allocation_count(input)){return .err(fail(f.value,12,fact.start,fact.end));}let allocation=inputs::allocation(input,fact.allocation);if(allocation.frame==0 || allocation.frame>inputs::frame_count(input) || allocation.module_index!=inputs::frame(input,allocation.frame).value.module_index || allocation.start>allocation.end){return .err(fail(f.value,12,fact.start,fact.end));}let related_error=append_related(ref mut candidates,Related{.role=3,.module_index=allocation.module_index,.start=allocation.start,.end=allocation.end,.owner=fact.origin-2},f.value,ref mut work);if(related_error.code!=0){return .err(related_error);}}let error=publish(Diagnostic{.feature=if(fact.kind==4){0}else{fact.kind},.frame=id,.code,.module_index=f.value.module_index,.start=fact.start,.end=fact.end,.related_start=0,.related_count=0},ref candidates,ref mut diagnostics,ref mut related,ref mut cache,f.value,ref mut work);if(error.code!=0){return .err(error);}semantic=semantic || code!=2;unsupported=unsupported || code==2;unknown+=1;}
            if(i==origins::return_count(p,id)){break;}let row=origins::return_at(p,id,i);if(!m::charge(ref mut work,1)){return .err(fail(f.value,10,row.start,row.end));}if(row.frame!=id || row.start>row.end){return .err(fail(f.value,12,row.start,row.end));}var u32 code=0;let usize count=origins::return_source_count(p,row);
            if(row.origin==1){code=2;}else if(count>1){code=2103;var usize candidate=0;while(candidate<count){if(!m::charge(ref mut work,1)){return .err(fail(f.value,10,row.start,row.end));}if(origins::return_source(p,row,candidate)==2){code=2;break;}candidate+=1;}}else if(count==0){if(row.origin!=sets::empty() || !f.tagged_return){return .err(fail(f.value,12,row.start,row.end));}}
            else{let leaf=origins::return_source(p,row,0);if(leaf==2){code=2;}else{if(leaf<3 || leaf-2>inputs::owner_count(input)){return .err(fail(f.value,12,row.start,row.end));}let owner=inputs::owner(input,leaf-2);if(owner.kind==11 || (owner.kind==1 || owner.kind==13) && owner.borrowed){code=0;}else if(owner.kind==14){code=3101;}else if(owner.kind==1 || owner.kind==2 || owner.kind==3 || owner.kind==4 || owner.kind==5 || owner.kind==12){code=2102;}else{code=2;}}}
            if(code!=0){var v::Vec<Related> candidates=v::empty<Related>();if(code==3101){let leaf=origins::return_source(p,row,0);let site=switch(origins::return_allocation(p,row,leaf,ref mut work)){case .ok(n):{n}case .err(code):{return .err(fail(f.value,code,row.start,row.end));}};if(site==0 || site>inputs::allocation_count(input)){return .err(fail(f.value,12,row.start,row.end));}let allocation=inputs::allocation(input,site);if(allocation.frame==0 || allocation.frame>inputs::frame_count(input) || allocation.module_index!=inputs::frame(input,allocation.frame).value.module_index || allocation.start>allocation.end){return .err(fail(f.value,12,row.start,row.end));}let error=append_related(ref mut candidates,Related{.role=3,.module_index=allocation.module_index,.start=allocation.start,.end=allocation.end,.owner=leaf-2},f.value,ref mut work);if(error.code!=0){return .err(error);}}if(code==2102 || code==2103){var usize ordinal=0;while(ordinal<count){if(!m::charge(ref mut work,1)){return .err(fail(f.value,10,row.start,row.end));}let leaf=origins::return_source(p,row,ordinal);if(leaf<3 || leaf-2>inputs::owner_count(input)){return .err(fail(f.value,12,row.start,row.end));}let owner=inputs::owner(input,leaf-2);if(owner.frame==0 || owner.frame>inputs::frame_count(input)){return .err(fail(f.value,12,row.start,row.end));}let origin_frame=inputs::frame(input,owner.frame);let error=append_related(ref mut candidates,Related{.role=if(code==2102){1}else{2},.module_index=origin_frame.value.module_index,.start=owner.start,.end=owner.end,.owner=leaf-2},f.value,ref mut work);if(error.code!=0){return .err(error);}ordinal+=1;}}
                let error=publish(Diagnostic{.feature=0,.frame=id,.code,.module_index=f.value.module_index,.start=row.start,.end=row.end,.related_start=0,.related_count=0},ref candidates,ref mut diagnostics,ref mut related,ref mut cache,f.value,ref mut work);if(error.code!=0){return .err(error);}semantic=semantic || code!=2;unsupported=unsupported || code==2;
            }i+=1;
        }id+=1;
    }if(unknown!=origins::unknown_count(p)){return .err(m::Problem{.code=12,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}i=0;while(i<origins::conflict_count(p)){let fact=origins::conflict_at(p,i);if(fact.frame==0 || fact.frame>inputs::frame_count(input)){return .err(m::Problem{.code=12,.module_index=0,.start=fact.start,.end=fact.end,.expected=0,.actual=0});}let f=inputs::frame(input,fact.frame);if(fact.start>=fact.end || fact.borrow_start>=fact.borrow_end || fact.use_start>=fact.use_end){return .err(fail(f.value,12,fact.start,fact.end));}var v::Vec<Related> candidates=v::empty<Related>();if(fact.code!=2101 && fact.code!=2105){return .err(fail(f.value,12,fact.start,fact.end));}if(fact.code==2105){if(fact.owner==0 || fact.owner>inputs::owner_count(input)){return .err(fail(f.value,12,fact.start,fact.end));}let owner=inputs::owner(input,fact.owner);if(owner.frame!=fact.frame || owner.start>=owner.end){return .err(fail(f.value,12,fact.start,fact.end));}let error=append_related(ref mut candidates,Related{.role=6,.module_index=f.value.module_index,.start=owner.start,.end=owner.end,.owner=fact.owner},f.value,ref mut work);if(error.code!=0){return .err(error);}}let first=append_related(ref mut candidates,Related{.role=4,.module_index=f.value.module_index,.start=fact.borrow_start,.end=fact.borrow_end,.owner=0},f.value,ref mut work);if(first.code!=0){return .err(first);}let second=append_related(ref mut candidates,Related{.role=5,.module_index=f.value.module_index,.start=fact.use_start,.end=fact.use_end,.owner=0},f.value,ref mut work);if(second.code!=0){return .err(second);}let error=publish(Diagnostic{.feature=0,.frame=fact.frame,.code=fact.code,.module_index=f.value.module_index,.start=fact.start,.end=fact.end,.related_start=0,.related_count=0},ref candidates,ref mut diagnostics,ref mut related,ref mut cache,f.value,ref mut work);if(error.code!=0){return .err(error);}semantic=true;i+=1;}switch(extra){case .some(plan):{let p=append_moves(plan,ref mut diagnostics,ref mut related,ref mut cache,ref mut work);if(p.code!=0){return .err(p);}semantic=semantic || moves::count(plan)!=0;}case .none:{}};switch(policy){case .some(plan):{let p=append_cleanup(plan,ref mut diagnostics,ref mut related,ref mut cache,ref mut work);if(p.code!=0){return .err(p);}semantic=semantic || cleanup_policy::count(plan)!=0;}case .none:{}};var usize visible=0;i=0;while(i<v::len<Diagnostic>(ref diagnostics)){if(!m::charge(ref mut work,1)){return .err(m::Problem{.code=10,.module_index=0,.start=0,.end=0,.expected=0,.actual=0});}if(v::at<Diagnostic>(ref diagnostics,i).code!=2){visible+=1;}i+=1;}if(!semantic && unsupported){visible=v::len<Diagnostic>(ref diagnostics);}return .ok(Report{.diagnostics,.related,.work,.visible,.semantic,.unsupported});
}
