module module_state_layout;
import sha256 as sha;
import std::bytes as bytes;
import std::vec as v;

// Storage codec IDs belong only to state declarations, never scalar types.
pub struct Field{u32 kind;u32 key;u32 value;usize name_start;usize name_end;usize start;usize end;u32[8] prefix;}
pub struct Layout{usize owner;usize module_index;usize declaration;usize start;usize end;usize uid_start;usize uid_end;usize field_start;usize field_count;u32[8] hash;}
pub resource Plan{bytes::Buffer names;v::Vec<Layout> layouts;v::Vec<Field> fields;cleanup{}}
pub fn Plan empty(){return Plan{.names=bytes::empty(),.layouts=v::empty<Layout>(),.fields=v::empty<Field>()};}
pub fn usize count(ref Plan p){return v::len<Layout>(ref p.layouts);}
pub fn Layout at(ref Plan p,usize index){return *v::at<Layout>(ref p.layouts,index);}
pub fn Field field_at(ref Plan p,usize index){return *v::at<Field>(ref p.fields,index);}
pub fn ref u8[] uid(ref Plan p,usize index){let l=at(p,index);return bytes::view(ref p.names)[l.uid_start..l.uid_end];}
pub fn ref u8[] name(ref Plan p,usize index){let f=field_at(p,index);return bytes::view(ref p.names)[f.name_start..f.name_end];}
pub fn ref u8[] codec(u32 id){let ref u8[] text=b"|bool/v1|u32/be/v1|u64/be/v1|bytes20/v1|bytes32/v1|";var usize start=0;var usize end=0;var u32 index=0;while(end<text.len){if(text[end]==124){if(index==id && id<=5){break;}index+=1;start=end+1;}end+=1;}if(id>5){start=0;end=0;}return text[start..end];}
pub fn bool charge(ref mut usize work,usize n){if(*work>1048576 || n>1048576-*work){return false;};*work=*work+n;return true;}
pub fn bool append(ref mut bytes::Buffer out,ref u8[] data,ref mut usize work){return charge(work,data.len+1) && bytes::len(out)<=1048576 && data.len<=1048576-bytes::len(out) && bytes::append(out,data).is_ok;}
fn u8 octet(usize n){var usize left=n&255;var u8 result=0;var usize bit=128;var u8 mask=128;while(bit!=0){if(left>=bit){result+=mask;left-=bit;}bit/=2;mask/=2;}return result;}
fn bool number(ref mut bytes::Buffer out,usize n,usize width,ref mut usize work){var u8[8] data=[0;8];var usize remaining=n;var usize i=0;while(i<width){data[width-i-1]=octet(remaining);remaining/=256;i+=1;}let ref u8[] raw=ref data;return append(out,raw[..width],work);}
fn bool string(ref mut bytes::Buffer out,ref u8[] data,ref mut usize work){return number(out,data.len,8,work) && append(out,data,work);}
fn bool identity(ref u8[] name,u32 kind,u32 key,u32 value,usize index,ref mut bytes::Buffer out,ref mut usize work){return number(out,index,4,work) && number(out,kind as usize,1,work) && string(out,name,work) && string(out,codec(key),work) && string(out,codec(value),work);}
pub fn Result<u32[8],u32> field_prefix(ref u8[] uid,ref u8[] name,u32 kind,u32 key,u32 value,usize index,ref mut usize work){var bytes::Buffer out=bytes::empty();if(!append(ref mut out,b"fairyc-contract-state-field/v1",work) || !string(ref mut out,uid,work) || !identity(name,kind,key,value,index,ref mut out,work)){return .err(if(*work>=1048576){10}else{11});}return .ok(sha::digest(bytes::view(ref out)));}
pub fn Result<u32[8],u32> layout_digest(ref u8[] uid,ref bytes::Buffer names,ref v::Vec<Field> fields,usize first,usize count,ref mut usize work){var bytes::Buffer out=bytes::empty();if(!append(ref mut out,b"fairyc-contract-state-layout/v1",work) || !string(ref mut out,uid,work) || !number(ref mut out,count,4,work)){return .err(if(*work>=1048576){10}else{11});}var usize i=0;while(i<count){let f=*v::at<Field>(fields,first+i);if(!identity(bytes::view(names)[f.name_start..f.name_end],f.kind,f.key,f.value,i,ref mut out,work)){return .err(if(*work>=1048576){10}else{11});}var usize j=0;while(j<8){if(!number(ref mut out,f.prefix[j] as usize,4,work)){return .err(if(*work>=1048576){10}else{11});}j+=1;}i+=1;}return .ok(sha::digest(bytes::view(ref out)));}
pub fn Result<u32[8],u32> prefix(ref Plan p,usize layout,usize id,ref mut usize work){let f=field_at(p,id);return field_prefix(uid(p,layout),name(p,id),f.kind,f.key,f.value,id-at(p,layout).field_start,work);}
pub fn Result<u32[8],u32> digest(ref Plan p,usize layout,ref mut usize work){let l=at(p,layout);return layout_digest(uid(p,layout),ref p.names,ref p.fields,l.field_start,l.field_count,work);}
pub fn bool equal(u32[8] a,u32[8] b){var usize i=0;while(i<8){if(a[i]!=b[i]){return false;}i+=1;}return true;}
pub fn bool valid_name(ref u8[] name,bool uid){if(name.len==0 || name.len>if(uid){255}else{127}){return false;}var usize i=0;while(i<name.len){let c=name[i];let alpha=c>=65 && c<=90 || c>=97 && c<=122;if(!alpha && c!=95 && !(c>=48 && c<=57 && (uid || i!=0)) && !(uid && (c==45 || c==46))){return false;}i+=1;}return true;}
// Recompute canonical facts from this independent owner before IR publication.
pub fn u32 validate(ref Plan p,ref mut usize work){if(count(p)>512 || bytes::len(ref p.names)>1048576){return 9;}var usize next=0;var usize text=0;var usize i=0;while(i<count(p)){if(!charge(work,1)){return 10;}let l=at(p,i);if(l.owner>=512 || l.module_index>=512 || l.declaration==0 || l.start>l.end || l.uid_start!=text || l.uid_end<l.uid_start || l.uid_end>bytes::len(ref p.names) || l.field_start!=next || l.field_count>1024 || next>v::len<Field>(ref p.fields) || l.field_count>v::len<Field>(ref p.fields)-next){return 9;}if(!valid_name(uid(p,i),true)){return 9;}text=l.uid_end;var usize j=0;while(j<i){if(!charge(work,1)){return 10;}if(at(p,j).owner==l.owner){return 9;}j+=1;}j=0;while(j<l.field_count){if(!charge(work,1)){return 10;}let f=field_at(p,next+j);if(f.kind!=1 && f.kind!=2 || f.value<1 || f.value>5 || f.kind==1 && f.key!=0 || f.kind==2 && (f.key<1 || f.key>5) || f.name_start!=text || f.name_end<f.name_start || f.name_end>bytes::len(ref p.names) || f.start<l.start || f.end<f.start || f.end>l.end){return 9;}if(!valid_name(name(p,next+j),false)){return 9;}text=f.name_end;var usize before=0;while(before<j){if(!charge(work,1)){return 10;}if(bytes::equal(name(p,next+before),name(p,next+j))){return 9;}before+=1;}let expected=switch(prefix(p,i,next+j,work)){case .ok(hash):{hash}case .err(code):{return code;}};if(!equal(expected,f.prefix)){return 9;}j+=1;}let expected=switch(digest(p,i,work)){case .ok(hash):{hash}case .err(code):{return code;}};if(!equal(expected,l.hash)){return 9;}next+=l.field_count;i+=1;}return if(next==v::len<Field>(ref p.fields) && text==bytes::len(ref p.names)){0}else{9};}
pub fn usize name_bytes(ref Plan p){return bytes::len(ref p.names);}
pub fn ref u8[] names(ref Plan p){return bytes::view(ref p.names);}
pub fn usize field_count(ref Plan p){return v::len<Field>(ref p.fields);}
pub fn Plan assemble(bytes::Buffer names,v::Vec<Layout> layouts,v::Vec<Field> fields){return Plan{.names,.layouts,.fields};}
pub fn Result<Plan,u32> copy(ref Plan p,ref mut usize work){var bytes::Buffer names=bytes::empty();var v::Vec<Layout> layouts=v::empty<Layout>();var v::Vec<Field> fields=v::empty<Field>();if(!append(ref mut names,bytes::view(ref p.names),work)){return .err(if(*work>=1048576){10}else{11});}var usize i=0;while(i<count(p)){if(!charge(work,1)){return .err(10);}if(!v::push<Layout>(ref mut layouts,at(p,i)).is_ok){return .err(11);}i+=1;}i=0;while(i<field_count(p)){if(!charge(work,1)){return .err(10);}if(!v::push<Field>(ref mut fields,field_at(p,i)).is_ok){return .err(11);}i+=1;}return .ok(Plan{.names,.layouts,.fields});}
