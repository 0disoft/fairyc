module project_lock_json;
import project_lock_document as document;
import project_json_string as strings;
import project_path as work;
import std::bytes as bytes;

// 1 8-MiB output/shared-work bound; 2 invalid UTF-8; 3 allocation.
fn u32 append(ref mut bytes::Buffer output,ref u8[] input,ref mut usize meter){if(bytes::len(output)>8388608 || input.len>8388608-bytes::len(output) || !work::charge(meter,input.len+1)){return 1;}return if(bytes::append(output,input).is_ok){0}else{3};}
fn u32 quoted(ref mut bytes::Buffer output,ref u8[] input,ref mut usize meter){let bytes::Buffer encoded=switch(strings::quote(input,meter)){case .ok(value):{value}case .err(code):{return code;}};return append(output,bytes::view(ref encoded),meter);}
fn ref u8[] header_name(usize field){if(field==0){return b"schema";}if(field==1){return b"packageInstanceAlgorithm";}if(field==2){return b"sourceDigestAlgorithm";}if(field==3){return b"language";}return b"root";}
fn ref u8[] package_name(usize field){if(field==0){return b"id";}if(field==1){return b"role";}if(field==2){return b"packageUid";}if(field==3){return b"sourceKind";}if(field==4){return b"localPath";}if(field==5){return b"sdkIdentity";}if(field==6){return b"runtimeAbi";}if(field==7){return b"sourceIdentity";}if(field==8){return b"sourceDigest";}return b"version";}
fn u32 pair(ref mut bytes::Buffer output,ref u8[] indent,ref u8[] name,ref u8[] value,ref mut usize meter){var u32 code=append(output,indent,meter);if(code!=0){return code;}code=quoted(output,name,meter);if(code!=0){return code;}code=append(output,b": ",meter);if(code!=0){return code;}return quoted(output,value,meter);}
pub fn Result<bytes::Buffer,u32> marshal(ref document::Document document,ref mut usize meter){var bytes::Buffer output=bytes::empty();var u32 code=append(ref mut output,b"{\n",meter);if(code!=0){return .err(code);}var usize field=0;while(field<5){code=pair(ref mut output,b"  ",header_name(field),document::header(document,field),meter);if(code!=0){return .err(code);}code=append(ref mut output,b",\n",meter);if(code!=0){return .err(code);}field+=1;}code=append(ref mut output,b"  \"packages\": [\n",meter);if(code!=0){return .err(code);}var usize at=0;
    while(at<document::package_count(document)){code=append(ref mut output,b"    {\n",meter);if(code!=0){return .err(code);}field=0;while(field<10){code=pair(ref mut output,b"      ",package_name(field),document::package_field(document,at,field),meter);if(code!=0){return .err(code);}code=append(ref mut output,b",\n",meter);if(code!=0){return .err(code);}field+=1;}code=append(ref mut output,b"      \"features\": ",meter);if(code!=0){return .err(code);}let usize count=document::feature_count(document,at);
        if(count==0){code=append(ref mut output,b"[]\n",meter);}else{code=append(ref mut output,b"[\n",meter);if(code!=0){return .err(code);}var usize index=0;while(index<count){code=append(ref mut output,b"        ",meter);if(code!=0){return .err(code);}code=quoted(ref mut output,document::feature(document,at,index),meter);if(code!=0){return .err(code);}code=append(ref mut output,if(index+1<count){b",\n"}else{b"\n"},meter);if(code!=0){return .err(code);}index+=1;}code=append(ref mut output,b"      ]\n",meter);}if(code!=0){return .err(code);}code=append(ref mut output,if(at+1<document::package_count(document)){b"    },\n"}else{b"    }\n"},meter);if(code!=0){return .err(code);}at+=1;
    }code=append(ref mut output,b"  ],\n  \"dependencies\": ",meter);if(code!=0){return .err(code);}let usize count=document::dependency_count(document);if(count==0){code=append(ref mut output,b"[]\n",meter);}else{code=append(ref mut output,b"[\n",meter);if(code!=0){return .err(code);}at=0;while(at<count){code=append(ref mut output,b"    {\n",meter);if(code!=0){return .err(code);}code=pair(ref mut output,b"      ",b"owner",document::package_field(document,document::owner(document,at),0),meter);if(code!=0){return .err(code);}code=append(ref mut output,b",\n",meter);if(code!=0){return .err(code);}code=pair(ref mut output,b"      ",b"binding",document::binding(document,at),meter);if(code!=0){return .err(code);}code=append(ref mut output,b",\n",meter);if(code!=0){return .err(code);}code=pair(ref mut output,b"      ",b"target",document::package_field(document,document::target(document,at),0),meter);if(code!=0){return .err(code);}code=append(ref mut output,if(at+1<count){b"\n    },\n"}else{b"\n    }\n"},meter);if(code!=0){return .err(code);}at+=1;}code=append(ref mut output,b"  ]\n",meter);}if(code!=0){return .err(code);}code=append(ref mut output,b"}\n",meter);if(code!=0){return .err(code);}return .ok(output);
}
