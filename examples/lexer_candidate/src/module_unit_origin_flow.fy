fn Result<bool,m::Problem> borrowed(ref inputs::Inputs input,ref values::Plan primary,usize frame,usize type,ref mut usize work){return switch(inputs::borrow_leaves(input,primary,frame,type,work)){case .ok(n):{if(n>1){.err(m::fail(inputs::frame(input,frame).value,2,0,0,0,0))}else{.ok(n==1)}}case .err(p):{.err(p)}};}
fn Result<g::Value,m::Problem> place(ref inputs::Inputs input,ref values::Plan primary,ref m::Values body,usize original,ref v::Vec<g::Value> env,ref mut g::Context c,usize depth){
    let e=switch(g::expression(body,original,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}
    if(e.kind==2 && e.binding!=0){if(e.binding>v::len<g::Value>(env)){return .err(g::fail(c,12,e.start,e.end));}let descriptor=e.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,e.type));if(descriptor){let n=*v::at<g::Value>(env,e.binding-1);return .ok(if(n.origin==0){g::Value{.subview=false,.loan=0,.origin=1,.allocation=0}}else{n});}let origin=switch(g::leaf(input,e,c)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok(g::Value{.subview=false,.loan=0,.origin,.allocation=0});}
    if(e.kind==3 || e.kind==8 || e.kind==9 || e.kind==26 || e.kind==4 && e.place.kind==3){return place(input,primary,body,e.left,env,c,depth+1);}return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});
}
// Argument snapshots retain both origin identity and each Region allocation.
fn Result<g::Value,m::Problem> substitute(ref inputs::Inputs input,ref m::Values body,usize target,m::Invocation call,ref v::Vec<g::Value> arguments,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut g::Context c){
    if(target==0){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}let summary=*v::at<g::Value>(summaries,target-1);if(summary.origin<=1){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}if(summary.origin==sets::empty()){return .ok(summary);}let f=inputs::frame(input,target);if(f.parameter_count!=call.argument_count || v::len<g::Value>(arguments)!=call.argument_count){return .err(g::fail(c,12,call.start,call.end));}var g::Value result=g::Value{.subview=false,.loan=0,.origin=0,.allocation=0};var usize i=0;
    while(i<sets::count(entries,members,summary.origin)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,call.start,call.end));}let leaf=sets::member(entries,members,summary.origin,i);var g::Value actual=g::Value{.subview=false,.loan=0,.origin=2,.allocation=0};if(leaf!=2){let owner=sets::owner_id(leaf);if(owner==0 || owner>inputs::owner_count(input)){return .err(g::fail(c,12,call.start,call.end));}let local=inputs::owner(input,owner);if(local.kind==11){actual.origin=leaf;}else{if(local.frame!=target || (local.kind!=1 && local.kind!=13) || !local.borrowed){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}var usize ordinal=0;var bool found=false;while(ordinal<f.parameter_count){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,call.start,call.end));}if(inputs::parameter(input,target,ordinal)==owner){found=true;break;}ordinal+=1;}if(!found){return .err(g::fail(c,12,call.start,call.end));}actual=*v::at<g::Value>(arguments,ordinal);if(actual.origin==0){actual=g::Value{.subview=false,.loan=0,.origin=1,.allocation=0};}if(local.kind==13){let site=switch(p::lookup(allocations,summary.allocation,leaf,ref mut c.work)){case .ok(n):{n}case .err(code):{return .err(g::fail(c,code,call.start,call.end));}};if(site==0){return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});}actual=switch(g::allocated(allocations,c,actual.origin,site,call.start,call.end)){case .ok(n):{n}case .err(p):{return .err(p);}};}}}
        result=switch(g::join_value(entries,members,allocations,c,result,actual,call.start,call.end)){case .ok(n):{n}case .err(p):{return .err(p);}};i+=1;
    }return .ok(result);
}
pub fn Result<g::Flow,m::Problem> expression(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize original,usize depth){
    if(original==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1});}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let body=inputs::body(input,primary,c.frame);let e=switch(g::expression(body,original,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}
    if(e.kind==12 || e.kind==31){return control::block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1);}if(e.kind==13 || e.kind==15){return control::branch(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e,depth+1);}
    let bool descriptor=switch(borrowed(input,primary,c.frame,e.type,ref mut c.work)){case .ok(b):{b}case .err(p):{return .err(p);}};
    if(e.kind==1 || e.kind==28 || e.kind==17 || e.kind==16 || e.kind==32 || e.kind==33){var usize origin=if(e.kind==28 && descriptor && bytes::equal(syntax::expression_text(source,original),b"none")){sets::empty()}else{0};if(e.kind==1 && descriptor){let owner=switch(inputs::static_owner(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n}case .err(p):{return .err(p);}};origin=owner+2;}return .ok(g::Flow{.loan=0,.allocation=0,.origin,.outcomes=1});}
    if(e.kind==2){var usize origin=0;var usize allocation=0;var usize loan_set=0;let bool capability=e.type!=0 && inputs::type_at(input,primary,c.frame,e.type).kind==19;if(descriptor || capability){if(e.binding==0 || e.binding>v::len<g::Value>(env)){origin=1;}else{let value=*v::at<g::Value>(env,e.binding-1);origin=value.origin;allocation=value.allocation;loan_set=value.loan;if(origin==0){origin=1;}if(descriptor){let checked=g::check_lifetime(input,value,entries,members,allocations,unknowns,c,e.start,e.end);if(checked.code!=0){return .err(checked);}}}}if(e.binding!=0){let current=if(descriptor){g::Value{.subview=false,.loan=loan_set,.origin,.allocation}}else{let leaf=switch(g::leaf(input,e,c)){case .ok(n):{n}case .err(p):{return .err(p);}};g::Value{.subview=false,.loan=0,.origin=leaf,.allocation=0}};let checked=generations::path(input,env,original,current,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}let owner=switch(inputs::storage_owner(input,c.frame,e)){case .ok(n):{n}case .err(p):{return .err(p);}};let read=generations::owner_read(owner,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(read.code!=0){return .err(read);}}return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes=1});}
    if(e.kind==6 && e.builtin.kind==300){let field=switch(g::expression(body,e.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,field.left,depth+1)){case .ok(p):{p}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}let value=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,syntax::call_argument(source,original,0),depth+1)){case .ok(p):{p}case .err(p):{return .err(p);}};let site=switch(inputs::placement(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n}case .err(p):{return .err(p);}};let placed=switch(g::allocated(allocations,c,receiver.origin,site,e.start,e.end)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok(g::Flow{.loan=0,.allocation=placed.allocation,.origin=placed.origin,.outcomes=(receiver.outcomes & 14) | value.outcomes});}
    if(e.kind==21 || e.kind==22){var selected=switch(g::expression(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};var usize groups=0;while(selected.kind==3){if(groups>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}selected=switch(g::expression(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};groups+=1;}if(selected.kind==26 || selected.kind==9){let parent=switch(g::expression(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(parent.type!=0 && inputs::type_at(input,primary,c.frame,parent.type).kind==16){let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,selected.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}var value=switch(place(input,primary,body,selected.left,env,c,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};let owner=switch(loans::root(input,body,selected.left,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let checked=loans::check(input,env,entries,members,original,false,owner,e.kind==22,false,e.start,e.end,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}let root=switch(references::root(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let indirect=root.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,root.type));if(indirect){let checked=references::access(input,primary,body,env,root.source_index,value,e.kind==22,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}else{value.loan=switch(loans::create(owner,e.kind==22,e.start,e.end,loan_records,held_loans,loan_conflicts,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}let base=loans::held_count(held_loans);let held=loans::hold(value,e.kind==22,true,held_loans,c,e.start,e.end);if(held.code!=0){return .err(held);}let selectors=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,selected.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};loans::release(base,held_loans);if(e.kind==22 && (selectors.outcomes & 1)!=0){value=switch(generations::child(value,owner,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=value.loan,.origin=value.origin,.allocation=value.allocation,.outcomes=(receiver.outcomes & 14) | selectors.outcomes});}}}
    if(e.kind==26 || e.kind==9){let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}let at=switch(g::expression(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let mutable=e.kind==26 && borrows::mutable(inputs::type_at(input,primary,c.frame,e.type));if(mutable){let checked=references::access(input,primary,body,env,e.left,g::value(receiver),true,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let base=loans::held_count(held_loans);let held=loans::hold(g::value(receiver),mutable,true,held_loans,c,e.start,e.end);if(held.code!=0){return .err(held);}let selector=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};loans::release(base,held_loans);var value=g::value(receiver);if(mutable && (selector.outcomes & 1)!=0){let root=switch(references::root(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};value=switch(generations::child(value,parent,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=if(descriptor){value.loan}else{0},.origin=if(descriptor){value.origin}else{0},.allocation=if(descriptor){value.allocation}else{0},.outcomes=(receiver.outcomes & 14) | selector.outcomes});}
    let left=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((left.outcomes & 1)==0){return .ok(left);}
    if(e.kind==3){return .ok(left);}if(e.kind==21 || e.kind==22){let origin=switch(place(input,primary,body,e.left,env,c,depth+1)){case .ok(n):{n}case .err(p):{return .err(p);}};let owner=switch(loans::root(input,body,e.left,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let checked=loans::check(input,env,entries,members,original,false,owner,e.kind==22,false,e.start,e.end,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}let root=switch(references::root(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let indirect=root.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,root.type));if(indirect){let checked=references::access(input,primary,body,env,root.source_index,origin,e.kind==22,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let loan_set=if(indirect){origin.loan}else{switch(loans::create(owner,e.kind==22,e.start,e.end,loan_records,held_loans,loan_conflicts,c)){case .ok(n):{n}case .err(p):{return .err(p);}}};var value=origin;value.loan=loan_set;if(e.kind==22 && e.left!=root.source_index){value=switch(generations::child(value,owner,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=value.loan,.allocation=value.allocation,.origin=value.origin,.outcomes=left.outcomes});}
