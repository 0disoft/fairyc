module module_unit_origin_flow;
import module_unit_origin_calls as calls;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_origin_flow_model as g;
import module_unit_origin_flow_control as control;
import module_unit_values as values;
import module_unit_value_model as m;
import module_unit_value_builtin as borrows;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;
import module_unit_origin_provenance as p;
import module_unit_loan_checks as loans;
import module_unit_loan_model as loan;
import module_unit_loan_reference as references;
import module_unit_loan_generations as generations;
import module_unit_loan_facts as facts;
import module_unit_loan_owner_reads as owner_reads;

fn Result<bool,m::Problem> borrowed(ref inputs::Inputs input,ref values::Plan primary,usize frame,usize type,ref mut usize work){return switch(inputs::borrow_leaves(input,primary,frame,type,work)){case .ok(n):{if(n>1){.err(m::fail(inputs::frame(input,frame).value,2,0,0,0,0))}else{.ok(n==1)}}case .err(p):{.err(p)}};}
fn Result<g::Value,m::Problem> place(ref inputs::Inputs input,ref values::Plan primary,ref m::Values body,usize original,ref v::Vec<g::Value> env,ref mut g::Context c,usize depth){
    let e=switch(g::expression(body,original,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}
    if(e.kind==2 && e.binding!=0){if(e.binding>v::len<g::Value>(env)){return .err(g::fail(c,12,e.start,e.end));}let descriptor=e.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,e.type));if(descriptor){let n=*v::at<g::Value>(env,e.binding-1);return .ok(if(n.origin==0){g::Value{.subview=false,.loan=0,.origin=1,.allocation=0}}else{n});}let origin=switch(g::leaf(input,e,c)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok(g::Value{.subview=false,.loan=0,.origin,.allocation=0});}
    if(e.kind==3 || e.kind==8 || e.kind==9 || e.kind==26 || e.kind==4 && e.place.kind==3){return place(input,primary,body,e.left,env,c,depth+1);}return .ok(g::Value{.subview=false,.loan=0,.origin=1,.allocation=0});
}
pub fn Result<g::Flow,m::Problem> expression(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize original,usize depth){
    if(original==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1});}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let written=syntax::expression_at(source,original);let prior=c.place_root;
    if(written.kind==21 || written.kind==22){let root=switch(references::root(inputs::body(input,primary,c.frame),written.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};c.place_root=root.source_index;}
    else if(written.kind==8 && bytes::equal(syntax::expression_text(source,original),b"len")){let parent=switch(g::expression(inputs::body(input,primary,c.frame),written.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(parent.type!=0 && inputs::type_at(input,primary,c.frame,parent.type).kind==16){let root=switch(references::root(inputs::body(input,primary,c.frame),written.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};c.place_root=root.source_index;}}
    let result=analyze_expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,original,depth);c.place_root=prior;return result;
}
fn Result<g::Flow,m::Problem> analyze_expression(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize original,usize depth){
    if(original==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1});}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let body=inputs::body(input,primary,c.frame);let e=switch(g::expression(body,original,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}
    // Branch dispatch visits this same node; only its children increase depth.
    if(e.kind==12 || e.kind==31){return control::block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1);}if(e.kind==13 || e.kind==15){return control::branch(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e,depth);}
    let bool descriptor=switch(borrowed(input,primary,c.frame,e.type,ref mut c.work)){case .ok(b):{b}case .err(p):{return .err(p);}};
    if(e.kind==1 || e.kind==28 || e.kind==17 || e.kind==16 || e.kind==32 || e.kind==33){var usize origin=if(e.kind==28 && descriptor && bytes::equal(syntax::expression_text(source,original),b"none")){sets::empty()}else{0};if(e.kind==1 && descriptor){let owner=switch(inputs::static_owner(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n}case .err(p):{return .err(p);}};origin=owner+2;}var usize pending=0;if(origin>1 && e.kind==1){let seeded=switch(facts::seed(g::Value{.subview=false,.loan=0,.origin,.allocation=0},false,0,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};pending=seeded.loan;}return .ok(g::Flow{.loan=pending,.allocation=0,.origin,.outcomes=1});}
    if(e.kind==2){var usize origin=0;var usize allocation=0;var usize loan_set=0;let bool capability=e.type!=0 && inputs::type_at(input,primary,c.frame,e.type).kind==19;if(descriptor || capability){if(e.binding==0 || e.binding>v::len<g::Value>(env)){origin=1;}else{let value=*v::at<g::Value>(env,e.binding-1);origin=value.origin;allocation=value.allocation;loan_set=value.loan;if(origin==0){origin=1;}if(descriptor){let checked=g::check_lifetime(input,value,entries,members,allocations,unknowns,c,e.start,e.end);if(checked.code!=0){return .err(checked);}}}}if(descriptor){let used=facts::used(g::Value{.subview=false,.loan=loan_set,.origin,.allocation},entries,members,loan_records,c,e.start,e.end);if(used.code!=0){return .err(used);}}if(e.binding!=0){let current=if(descriptor){g::Value{.subview=false,.loan=loan_set,.origin,.allocation}}else{let leaf=switch(g::leaf(input,e,c)){case .ok(n):{n}case .err(p):{return .err(p);}};g::Value{.subview=false,.loan=0,.origin=leaf,.allocation=0}};let checked=generations::path(input,env,original,current,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}let owner=switch(inputs::storage_owner(input,c.frame,e)){case .ok(n):{n}case .err(p):{return .err(p);}};let read=generations::owner_read(owner,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(read.code!=0){return .err(read);}if(!descriptor){let checked=owner_reads::check(input,env,original,owner,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}}return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes=1});}
    if(e.kind==6 && e.builtin.kind==300){let field=switch(g::expression(body,e.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,field.left,depth+1)){case .ok(p):{p}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}let value=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,syntax::call_argument(source,original,0),depth+1)){case .ok(p):{p}case .err(p):{return .err(p);}};let site=switch(inputs::placement(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n}case .err(p):{return .err(p);}};let placed=switch(g::allocated(allocations,c,receiver.origin,site,e.start,e.end)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok(g::Flow{.loan=0,.allocation=placed.allocation,.origin=placed.origin,.outcomes=(receiver.outcomes & 14) | value.outcomes});}
    if(e.kind==21 || e.kind==22){var selected=switch(g::expression(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};var usize groups=0;while(selected.kind==3){if(groups>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}selected=switch(g::expression(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};groups+=1;}if(selected.kind==26 || selected.kind==9){let parent=switch(g::expression(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(parent.type!=0 && inputs::type_at(input,primary,c.frame,parent.type).kind==16){let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,selected.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}var value=switch(place(input,primary,body,selected.left,env,c,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};let owner=switch(loans::root(input,body,selected.left,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let checked=loans::check(input,env,entries,members,original,false,owner,e.kind==22,false,e.start,e.end,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}let root=switch(references::root(body,selected.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let indirect=root.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,root.type));if(indirect){let checked=references::access(input,primary,body,env,root.source_index,value,e.kind==22,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}else{value.loan=switch(loans::create(owner,e.kind==22,e.start,e.end,loan_records,held_loans,loan_conflicts,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}let base=loans::held_count(held_loans);let held=loans::hold(value,e.kind==22,true,held_loans,c,e.start,e.end);if(held.code!=0){return .err(held);}let selectors=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,selected.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};loans::release(base,held_loans);if(e.kind==22 && (selectors.outcomes & 1)!=0){value=switch(generations::child(value,owner,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=value.loan,.origin=value.origin,.allocation=value.allocation,.outcomes=(receiver.outcomes & 14) | selectors.outcomes});}}}
    if(e.kind==26 || e.kind==9){let receiver=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((receiver.outcomes & 1)==0){return .ok(receiver);}let at=switch(g::expression(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let mutable=e.kind==26 && borrows::mutable(inputs::type_at(input,primary,c.frame,e.type));if(e.kind==9){let checked=references::read(input,primary,source,body,e,g::value(receiver),entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}if(mutable){let checked=references::access(input,primary,body,env,e.left,g::value(receiver),true,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let base=loans::held_count(held_loans);let held=loans::hold(g::value(receiver),mutable,true,held_loans,c,e.start,e.end);if(held.code!=0){return .err(held);}let selector=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};loans::release(base,held_loans);var value=g::value(receiver);if(mutable && (selector.outcomes & 1)!=0){let root=switch(references::root(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};value=switch(generations::child(value,parent,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=if(descriptor){value.loan}else{0},.origin=if(descriptor){value.origin}else{0},.allocation=if(descriptor){value.allocation}else{0},.outcomes=(receiver.outcomes & 14) | selector.outcomes});}
    let left=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((left.outcomes & 1)==0){return .ok(left);}
    if(e.kind==3){return .ok(left);}if(e.kind==21 || e.kind==22){let root=switch(references::root(body,e.left,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let indirect=root.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,root.type));let origin=if(root.kind==6 && indirect){g::value(left)}else{switch(place(input,primary,body,e.left,env,c,depth+1)){case .ok(n):{n}case .err(p):{return .err(p);}}};let owner=switch(loans::root(input,body,e.left,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let checked=loans::check(input,env,entries,members,original,false,owner,e.kind==22,false,e.start,e.end,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}if(indirect){let checked=references::access(input,primary,body,env,root.source_index,origin,e.kind==22,e.start,e.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let loan_set=if(indirect){origin.loan}else{switch(loans::create(owner,e.kind==22,e.start,e.end,loan_records,held_loans,loan_conflicts,c)){case .ok(n):{n}case .err(p):{return .err(p);}}};var value=origin;value.loan=loan_set;if(indirect && e.kind==21 && root.type!=0 && borrows::mutable(inputs::type_at(input,primary,c.frame,root.type))){let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};value=switch(facts::seed(value,false,parent,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}if(e.kind==22 && e.left!=root.source_index){value=switch(generations::child(value,owner,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}return .ok(g::Flow{.loan=value.loan,.allocation=value.allocation,.origin=value.origin,.outcomes=left.outcomes});}
    if(e.kind==8 || e.kind==4 && e.place.kind==3){let checked=references::read(input,primary,source,body,e,g::value(left),entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}
    // A field used as an explicit borrow place may be rooted in a returned
    // reference. Preserve that evaluated reference through the projection;
    // ordinary field values still carry no borrow descriptor of their own.
    if(e.kind==20 || e.kind==23 || e.kind==8 || e.kind==4){var bool call_place=false;if(c.place_root!=0 && (e.kind==8 || e.kind==4 && e.place.kind==3)){let root=switch(references::root(body,original,c)){case .ok(e):{e}case .err(p):{return .err(p);}};call_place=root.source_index==c.place_root && root.kind==6 && root.type!=0 && borrows::borrowed(inputs::type_at(input,primary,c.frame,root.type));}let carry=descriptor || call_place;return .ok(g::Flow{.loan=if(carry){left.loan}else{0},.allocation=if(carry){left.allocation}else{0},.origin=if(carry){left.origin}else{0},.outcomes=left.outcomes});}
    if(e.kind==30){let operand=switch(g::expression(body,e.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};let t=inputs::type_at(input,primary,c.frame,operand.type);if(t.kind!=6){return .err(g::fail(c,12,e.start,e.end));}let failure=switch(borrowed(input,primary,c.frame,t.second,ref mut c.work)){case .ok(b):{b}case .err(p):{return .err(p);}};if(failure){let p=g::returned(g::value(left),input,loan_records,entries,members,allocations,returns,c,e.start,e.end);if(p.code!=0){return .err(p);}}return .ok(g::Flow{.loan=if(descriptor){left.loan}else{0},.allocation=if(descriptor){left.allocation}else{0},.origin=if(descriptor){left.origin}else{0},.outcomes=left.outcomes | 2});}
    if(e.kind==6 || e.kind==10 || e.kind==24){return calls::evaluate(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,original,depth,source,body,e,descriptor,left);}
    // && and || have both the skipped and the evaluated right path.
    let op=syntax::expression_text(source,original);if(e.kind==5 && (bytes::equal(op,b"&&") || bytes::equal(op,b"||"))){let base=switch(g::copy(env,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var branch=switch(g::copy(env,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};let right=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut branch,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((right.outcomes & 1)!=0){let p=g::merge(ref base,ref branch,env,false,entries,members,allocations,c,e.start,e.end);if(p.code!=0){return .err(p);}}return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=left.outcomes | right.outcomes | 1});}
    let right=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};return .ok(g::Flow{.loan=if(descriptor){left.loan}else{0},.allocation=if(descriptor){left.allocation}else{0},.origin=if(descriptor){left.origin}else{0},.outcomes=(left.outcomes & 14) | right.outcomes});
}
