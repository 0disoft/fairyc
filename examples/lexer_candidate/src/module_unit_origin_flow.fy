    if(e.kind==30){let operand=switch(g::expression(body,e.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};let t=inputs::type_at(input,primary,c.frame,operand.type);if(t.kind!=6){return .err(g::fail(c,12,e.start,e.end));}let failure=switch(borrowed(input,primary,c.frame,t.second,ref mut c.work)){case .ok(b):{b}case .err(p):{return .err(p);}};if(failure){let p=g::returned(g::value(left),loan_records,entries,members,allocations,returns,c,e.start,e.end);if(p.code!=0){return .err(p);}}return .ok(g::Flow{.loan=if(descriptor){left.loan}else{0},.allocation=if(descriptor){left.allocation}else{0},.origin=if(descriptor){left.origin}else{0},.outcomes=left.outcomes | 2});}
    if(e.kind==6 || e.kind==10 || e.kind==24){let held_base=loans::held_count(held_loans);var v::Vec<usize> order=v::empty<usize>();var v::Vec<g::Value> arguments=v::empty<g::Value>();var usize link=e.right;let u32 kind=if(e.kind==6){7}else if(e.kind==10){11}else{25};
        while(link!=0){let row=syntax::expression_at(source,link);if(!m::charge(ref mut c.work,1) || v::len<usize>(ref order)>=1024){return .err(g::fail(c,10,row.start,row.end));}if(row.kind!=kind){return .err(g::fail(c,12,row.start,row.end));}if(!v::push<usize>(ref mut order,row.left).is_ok){return .err(g::fail(c,11,row.start,row.end));}link=row.right;}
        var usize outcomes=left.outcomes;var usize i=v::len<usize>(ref order);while(i>0 && (outcomes & 1)!=0){i-=1;if(e.kind==6){let argument=*v::at<usize>(ref order,i);let checked=loans::moved(input,primary,body,argument,c.statement,env,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let next=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,*v::at<usize>(ref order,i),depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};outcomes=(outcomes & 14) | next.outcomes;if(!v::push<g::Value>(ref mut arguments,g::value(next)).is_ok){return .err(g::fail(c,11,e.start,e.end));}if(e.kind==6){let argument=syntax::expression_at(source,*v::at<usize>(ref order,i));let kind=switch(loans::argument_kind(input,primary,body,original,v::len<g::Value>(ref arguments)-1,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(kind!=0){let checked=references::access(input,primary,body,env,*v::at<usize>(ref order,i),g::value(next),kind==2,argument.start,argument.end,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}let held=loans::hold(g::value(next),kind==2,kind!=0,held_loans,c,argument.start,argument.end);if(held.code!=0){return .err(held);}}}
        var usize allocation=0;var usize origin=0;var usize loan_set=0;if(descriptor && (outcomes & 1)!=0){origin=1;if(e.kind==6 && syntax::expression_at(source,e.left).kind==28){let name=syntax::expression_text(source,e.left);let t=inputs::type_at(input,primary,c.frame,e.type);if(!(t.kind==5 && bytes::equal(name,b"some") || t.kind==6 && (bytes::equal(name,b"ok") || bytes::equal(name,b"err"))) || v::len<g::Value>(ref arguments)!=1){return .err(g::fail(c,12,e.start,e.end));}let value=*v::at<g::Value>(ref arguments,0);origin=if(value.origin==0){sets::empty()}else{value.origin};allocation=value.allocation;loan_set=value.loan;}else if(e.kind==6 && e.builtin.kind==200){origin=switch(inputs::static_owner(input,primary,c.frame,original,ref mut c.work)){case .ok(n):{n+2}case .err(p):{return .err(p);}};}else if(e.kind==6 && (e.builtin.kind>=9 && e.builtin.kind<=12 || e.builtin.kind==106 || e.builtin.kind==107)){if(v::len<g::Value>(ref arguments)==0){return .err(g::fail(c,12,e.start,e.end));}var value=*v::at<g::Value>(ref arguments,0);if(e.builtin.kind==107 && e.builtin.slice){let argument=syntax::call_argument(source,original,0);let root=switch(references::root(body,argument,c)){case .ok(e):{e}case .err(p):{return .err(p);}};let parent=switch(inputs::binding_owner(input,c.frame,root)){case .ok(n):{n}case .err(p):{return .err(p);}};value=switch(generations::child(value,parent,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}origin=value.origin;allocation=value.allocation;loan_set=value.loan;}else if(e.kind==6){i=0;while(i<m::call_count(body)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}let call=m::call_at(body,i);if(call.source_index==original){if(!call.checked){return .err(g::fail(c,12,e.start,e.end));}let value=switch(substitute(input,body,inputs::target(input,c.frame,i),call,ref arguments,summaries,entries,members,allocations,c)){case .ok(n):{n}case .err(p):{return .err(p);}};var selected=value;let target=inputs::target(input,c.frame,i);if(target!=0 && v::at<g::Value>(summaries,target-1).subview){selected=switch(generations::child(value,0,e.start,e.end,entries,members,loan_records,c)){case .ok(v):{v}case .err(p):{return .err(p);}};}origin=selected.origin;allocation=selected.allocation;loan_set=selected.loan;break;}i+=1;}}}loans::release(held_base,held_loans);return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes});
    }
    // && and || have both the skipped and the evaluated right path.
    let op=syntax::expression_text(source,original);if(e.kind==5 && (bytes::equal(op,b"&&") || bytes::equal(op,b"||"))){let base=switch(g::copy(env,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var branch=switch(g::copy(env,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};let right=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut branch,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((right.outcomes & 1)!=0){let p=g::merge(ref base,ref branch,env,false,entries,members,allocations,c,e.start,e.end);if(p.code!=0){return .err(p);}}return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=left.outcomes | right.outcomes | 1});}
    let right=switch(expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};return .ok(g::Flow{.loan=if(descriptor){left.loan}else{0},.allocation=if(descriptor){left.allocation}else{0},.origin=if(descriptor){left.origin}else{0},.outcomes=(left.outcomes & 14) | right.outcomes});
}
