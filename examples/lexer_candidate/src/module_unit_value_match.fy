module module_unit_value_match;
import module_unit_value_model as m;
import module_unit_value_scalar as scalar;
import module_unit_value_control as control;
import module_unit_value_variant as variants;
import module_unit_interfaces as interfaces;
import module_types as types;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;

fn m::Problem bind(m::Frame frame,usize original,usize type,m::Field field,ref mut v::Vec<m::Expression> expressions,ref mut usize work){let usize id=m::index(expressions,original);if(id==0){return m::fail(frame,12,0,0,0,0);}let pattern=*v::at<m::Expression>(expressions,id-1);if(pattern.kind!=17 || type==0 || pattern.target!=0 && pattern.target!=type){return m::fail(frame,12,pattern.start,pattern.end,0,type);}let slot=v::at_mut<m::Expression>(expressions,id-1);slot.target=type;slot.expected=type;slot.field=field;
    if(pattern.place.root!=0){var usize i=0;while(i<v::len<m::Expression>(expressions)){if(!m::charge(work,1)){return m::fail(frame,10,pattern.start,pattern.end,0,0);}let e=*v::at<m::Expression>(expressions,i);if(e.kind==2 && e.place.root==pattern.place.root){if(e.type!=0 && e.type!=type){return m::fail(frame,12,e.start,e.end,type,e.type);}let value=v::at_mut<m::Expression>(expressions,i);value.type=type;value.state=1;}i+=1;}}return m::fail(frame,0,0,0,0,0);
}
fn m::Problem builtin_pattern(ref syntax::Parsed source,m::Frame frame,m::Expression e,types::Type t,usize scrutinee,ref mut v::Vec<m::Expression> expressions,ref mut usize work,ref mut usize variant){let name=syntax::expression_text(source,e.source_index);if(!m::charge(work,name.len+1)){return m::fail(frame,10,e.start,e.end,0,0);}if(e.kind!=16){return m::fail(frame,2,e.start,e.end,0,0);}var usize payload=0;
    if(t.kind==5){if(bytes::equal(name,b"some")){*variant=1;payload=t.first;}else if(bytes::equal(name,b"none")){*variant=2;}else{return m::fail(frame,2,e.start,e.end,0,0);}}
    else{if(bytes::equal(name,b"ok")){*variant=1;payload=t.first;}else if(bytes::equal(name,b"err")){*variant=2;payload=t.second;}else{return m::fail(frame,2,e.start,e.end,0,0);}}
    if(payload==0){if(e.left!=0){return m::fail(frame,2,e.start,e.end,0,0);}}else{if(e.left==0){return m::fail(frame,2,e.start,e.end,0,0);}let p=bind(frame,e.left,payload,m::Field{.id=0,.owner=scrutinee,.module_index=0,.declaration=0,.source_index=0},expressions,work);if(p.code!=0){return p;}}let usize id=m::index(expressions,e.source_index);let slot=v::at_mut<m::Expression>(expressions,id-1);slot.expected=scrutinee;return m::fail(frame,0,0,0,0,0);
}
fn m::Problem enum_pattern(ref syntax::Parsed source,m::Frame frame,m::Expression e,usize scrutinee,interfaces::Shape shape,ref interfaces::Interfaces imported,ref mut v::Vec<m::Expression> expressions,ref mut usize work,ref mut usize variant){if(e.kind!=16 && e.kind!=32){return m::fail(frame,2,e.start,e.end,0,0);};*variant=switch(variants::member(imported,frame,e,shape,syntax::expression_text(source,e.source_index),work)){case .ok(id):{id}case .err(p):{return p;}};let selected=interfaces::field_at(imported,*variant-1);
    if(e.kind==16){if(e.left!=0 || selected.payload_count!=0){return m::fail(frame,2,e.start,e.end,0,0);}}
    else{var v::Vec<usize> seen=v::empty<usize>();var usize i=0;while(i<selected.payload_count){if(!m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}if(!v::push<usize>(ref mut seen,0).is_ok){return m::fail(frame,11,e.start,e.end,0,0);}i+=1;}var v::Vec<usize> order=v::empty<usize>();var usize link=e.right;while(link!=0){if(!m::charge(work,1) || v::len<usize>(ref order)>=1024){return m::fail(frame,10,e.start,e.end,0,0);}let row=syntax::expression_at(source,link);if(row.kind!=33){return m::fail(frame,12,row.start,row.end,0,0);}if(!v::push<usize>(ref mut order,link).is_ok){return m::fail(frame,11,row.start,row.end,0,0);}link=row.right;}
        i=v::len<usize>(ref order);while(i>0){i-=1;let usize original=*v::at<usize>(ref order,i);let usize wrapper=m::index(expressions,original);if(wrapper==0){return m::fail(frame,12,e.start,e.end,0,0);}let row=*v::at<m::Expression>(expressions,wrapper-1);let usize field=switch(variants::field(imported,frame,row,*variant,syntax::expression_text(source,original),work)){case .ok(id):{id}case .err(p):{return p;}};if(field<=selected.payload_start || field>selected.payload_start+selected.payload_count){return m::fail(frame,12,row.start,row.end,0,0);}let usize position=field-1-selected.payload_start;if(*v::at<usize>(ref seen,position)!=0){return m::fail(frame,2,row.start,row.end,0,0);}let mark=v::at_mut<usize>(ref mut seen,position);*mark=original;let f=interfaces::field_at(imported,field-1);let provenance=variants::provenance(imported,field,scrutinee);let p=bind(frame,row.left,f.type,provenance,expressions,work);if(p.code!=0){return p;}let slot=v::at_mut<m::Expression>(expressions,wrapper-1);slot.field=provenance;slot.expected=f.type;
        }if(v::len<usize>(ref order)!=selected.payload_count){return m::fail(frame,2,e.start,e.end,0,0);}
    }let usize id=m::index(expressions,e.source_index);let slot=v::at_mut<m::Expression>(expressions,id-1);slot.expected=scrutinee;slot.field=variants::provenance(imported,*variant,scrutinee);return m::fail(frame,0,0,0,0,0);
}
fn Result<bool,m::Problem> terminal(ref syntax::Parsed source,m::Frame frame,usize body,bool result,ref mut usize work){let b=syntax::statement_at(source,body);if(!m::charge(work,1)){return .err(m::fail(frame,10,b.start,b.end,0,0));}if(b.expression!=0 || b.second==0){return .ok(false);}let row=syntax::statement_at(source,b.first);let last=syntax::statement_at(source,row.first);if(!m::charge(work,2)){return .err(m::fail(frame,10,b.start,b.end,0,0));}if(result && last.kind==3){return .ok(true);}if(last.kind!=11 || last.expression==0){return .ok(false);}let assertion=syntax::expression_at(source,last.expression);if(!m::charge(work,1)){return .err(m::fail(frame,10,b.start,b.end,0,0));}return .ok(assertion.kind==1 && bytes::equal(syntax::expression_text(source,last.expression),b"false"));}
pub fn m::Problem evaluate(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){let e=*v::at<m::Expression>(expressions,id-1);let usize subject=m::index(expressions,e.left);if(subject==0){return m::fail(frame,12,e.start,e.end,0,0);}let p=scalar::evaluate(source,frame,subject,0,imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}let actual=*v::at<m::Expression>(expressions,subject-1);if(actual.state==2){return m::fail(frame,2,actual.start,actual.end,0,0);}if(actual.type==0){return m::fail(frame,0,0,0,0,0);}let t=types::at(graph,actual.type);if(t.kind!=4 && t.kind!=5 && t.kind!=6){return m::fail(frame,2,actual.start,actual.end,0,actual.type);}
    var v::Vec<usize> order=v::empty<usize>();var usize link=e.right;while(link!=0){if(!m::charge(work,1) || v::len<usize>(ref order)>=1024){return m::fail(frame,10,e.start,e.end,0,0);}let row=syntax::expression_at(source,link);if(row.kind!=19){return m::fail(frame,12,row.start,row.end,0,0);}if(!v::push<usize>(ref mut order,row.left).is_ok){return m::fail(frame,11,row.start,row.end,0,0);}link=row.right;}if(v::len<usize>(ref order)==0 || t.kind!=4 && v::len<usize>(ref order)!=2){return m::fail(frame,2,e.start,e.end,0,actual.type);}
    var interfaces::Shape shape=interfaces::Shape{.type=0,.module_index=0,.declaration=0,.field_start=0,.field_count=0,.abilities=0,.repr_c=false,.start=0,.end=0,.cleanup_nonempty=false,.cleanup_effects=0};var usize required=2;var usize capacity=2;if(t.kind==4){shape=switch(variants::shape(imported,frame,e,actual.type,work)){case .ok(s):{s}case .err(p):{return p;}};capacity=shape.field_count;required=0;var usize i=0;while(i<capacity){if(!m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}if(interfaces::field_at(imported,shape.field_start+i).kind==3){required+=1;}i+=1;}}
    var v::Vec<usize> seen=v::empty<usize>();var usize i=0;while(i<capacity){if(!m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}if(!v::push<usize>(ref mut seen,0).is_ok){return m::fail(frame,11,e.start,e.end,0,0);}i+=1;}
    // Bind every arm before value inference, preserving scoped symbol roots.
    i=v::len<usize>(ref order);while(i>0){i-=1;let arm=syntax::expression_at(source,*v::at<usize>(ref order,i));let usize pattern_id=m::index(expressions,arm.left);if(arm.kind!=18 || pattern_id==0){return m::fail(frame,12,arm.start,arm.end,0,0);}let pattern=*v::at<m::Expression>(expressions,pattern_id-1);if(t.kind==6 && (pattern.kind!=16 || pattern.left==0)){return m::fail(frame,2,arm.start,arm.end,0,0);}var usize variant=0;let p=if(t.kind==4){enum_pattern(source,frame,pattern,actual.type,shape,imported,expressions,work,ref mut variant)}else{builtin_pattern(source,frame,pattern,t,actual.type,expressions,work,ref mut variant)};if(p.code!=0){return p;}let usize position=if(t.kind==4){variant-1-shape.field_start}else{variant-1};if(position>=capacity){return m::fail(frame,12,pattern.start,pattern.end,0,0);}if(*v::at<usize>(ref seen,position)!=0){return m::fail(frame,2,pattern.start,pattern.end,0,0);}let mark=v::at_mut<usize>(ref mut seen,position);*mark=1;
    }if(v::len<usize>(ref order)!=required){return m::fail(frame,2,e.start,e.end,0,actual.type);}
    var usize type=expected;var usize continuing=0;i=v::len<usize>(ref order);while(i>0){i-=1;let arm=syntax::expression_at(source,*v::at<usize>(ref order,i));let selected=control::block(source,frame,arm.right,type,imported,graph,atoms,expressions,work,depth+1);if(selected.problem.code!=0){return selected.problem;}let bool excluded=if(t.kind==4){false}else{switch(terminal(source,frame,arm.right,t.kind==6,work)){case .ok(b):{b}case .err(p):{return p;}}};if(!excluded){continuing+=1;if(selected.type==0){return m::fail(frame,0,0,0,0,0);}if(type==0){type=selected.type;}else if(type!=selected.type){let body=syntax::statement_at(source,arm.right);return m::fail(frame,1006,body.start,body.end,type,selected.type);}}let usize arm_id=m::index(expressions,*v::at<usize>(ref order,i));let slot=v::at_mut<m::Expression>(expressions,arm_id-1);slot.expected=type;slot.target=actual.type;
    }if(continuing==0){type=m::atom(atoms,7);}let slot=v::at_mut<m::Expression>(expressions,id-1);slot.state=1;slot.type=type;slot.expected=expected;slot.target=actual.type;slot.place=m::no_place();return m::fail(frame,0,0,0,0,0);
}
