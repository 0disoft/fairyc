module module_public_interface_extract;
import module_public_interface_model as model;
import module_public_interface_write as write;
import module_public_type_text as type_text;
import module_public_type_ids as ids;
import module_unit_interfaces as typed;
import module_signatures as signatures;
import module_registry as registry;
import module_state_layout as budget;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;

// Ordinary declarations only; templates require a separate identity before cache reuse.
pub resource Projection{model::Descriptor descriptor;bool templates;cleanup{}}
pub fn ref model::Descriptor descriptor(ref Projection p){return ref p.descriptor;}
pub fn bool has_templates(ref Projection p){return p.templates;}
fn model::Text blank(){return model::Text{.start=0,.end=0};}
fn model::Range none(){return model::Range{.first=0,.count=0};}
fn Result<model::Text,u32> text(ref mut bytes::Buffer names,ref u8[] value,ref mut usize work){let start=bytes::len(names);let code=write::raw(names,value,work);return if(code!=0){.err(code)}else{.ok(model::Text{.start,.end=bytes::len(names)})};}
fn Result<model::Text,u32> type(ref mut bytes::Buffer names,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,ref ids::Table named,usize owner,usize id,ref mut usize work){let value=switch(if(ids::count(named)==0){type_text::render(sources,metadata,graph,coordinates,owner,id,work)}else{type_text::render_prepared(named,sources,metadata,graph,coordinates,owner,id,work)}){case .ok(b):{b}case .err(code):{return .err(code);}};return text(names,bytes::view(ref value),work);}
fn Result<model::Range,u32> effects(ref mut bytes::Buffer names,ref mut v::Vec<model::Text> lists,u32 bits,bool abilities,ref mut usize work){let first=v::len<model::Text>(lists);let ref u8[] labels=if(abilities){b"drop|store|key|"}else{b"block_context|clock|console|emit|environment|external_call|filesystem|network|process|random|storage_read|storage_write|"};var usize start=0;var usize end=0;var usize i=0;let u32[3] ability_flags=[1,2,4];let u32[12] flags=[128,32,1,256,4,512,2,16,8,64,1024,2048];if(abilities && (bits==0 || bits>7 || (bits&4)!=0 && (bits&2)==0) || !abilities && bits>4095){return .err(9);}while(end<labels.len){if(!budget::charge(work,1)){return .err(10);}if(labels[end]==124){let u32 bit=if(abilities){ability_flags[i]}else{flags[i]};if((bits&bit)!=0){let name=switch(text(names,labels[start..end],work)){case .ok(t):{t}case .err(code):{return .err(code);}};if(v::len<model::Text>(lists)>=32768){return .err(10);}if(!v::push<model::Text>(lists,name).is_ok){return .err(11);}}i+=1;start=end+1;}end+=1;}return .ok(model::Range{.first,.count=v::len<model::Text>(lists)-first});}
fn Result<usize,u32> shape(ref typed::Interfaces graph,usize source,usize declaration,ref mut usize work){var usize i=0;while(i<typed::shape_count(graph)){if(!budget::charge(work,1)){return .err(10);}let s=typed::shape_at(graph,i);if(s.module_index==source && s.declaration==declaration){return .ok(i);}i+=1;}return .err(9);}
fn Result<model::Field,u32> field(ref mut bytes::Buffer names,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,ref ids::Table named,usize owner,usize id,ref mut usize work){if(!budget::charge(work,1)){return .err(10);}let f=typed::field_at(graph,id);let name=switch(text(names,typed::field_name(graph,id),work)){case .ok(t):{t}case .err(code):{return .err(code);}};let value=switch(type(names,sources,metadata,graph,coordinates,named,owner,f.type,work)){case .ok(t):{t}case .err(code):{return .err(code);}};return .ok(model::Field{.name,.type=value});}
fn Result<model::Item,u32> item(ref mut bytes::Buffer names,ref mut v::Vec<model::Text> lists,ref mut v::Vec<model::Field> fields,ref mut v::Vec<model::Variant> variants,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,ref ids::Table named,usize owner,usize source,usize declaration,ref mut usize work){
    let p=v::at<syntax::Parsed>(sources,source);let d=syntax::declaration_at(p,declaration-1);let kind=if(d.kind==4){b"struct"}else if(d.kind==6){b"resource"}else if(d.kind==11){b"enum"}else if(d.kind==9){b"foreign-function"}else{b"function"};
    let kind_name=switch(text(names,kind,work)){case .ok(t):{t}case .err(code):{return .err(code);}};let name=switch(text(names,syntax::source_view(p)[d.name_start..d.name_end],work)){case .ok(t):{t}case .err(code):{return .err(code);}};
    var model::Item result=model::Item{.kind=kind_name,.name,.repr_c=false,.unsafe_call=false,.must_use=false,.abi=blank(),.link=blank(),.owner=blank(),.effects=none(),.abilities=none(),.parameters=none(),.result=blank(),.fields=none(),.variants=none()};
    if(d.kind==3 || d.kind==9){let id=signatures::identity(metadata,source,declaration);if(id==0 || d.owner_end!=0){return .err(4501);}let s=signatures::at(metadata,id);result.unsafe_call=s.unsafe_call;result.must_use=s.must_use;result.effects=switch(effects(names,lists,s.effects,false,work)){case .ok(r):{r}case .err(code):{return .err(code);}};
        if(d.kind==9){result.abi=switch(text(names,b"C",work)){case .ok(t):{t}case .err(code):{return .err(code);}};result.link=switch(text(names,signatures::linker_name(metadata,id),work)){case .ok(t):{t}case .err(code):{return .err(code);}};}
        let first=v::len<model::Text>(lists);var usize i=0;while(i<s.parameter_count){if(!budget::charge(work,1)){return .err(10);}let value=switch(type(names,sources,metadata,graph,coordinates,named,owner,signatures::parameter_at(metadata,s.parameter_start+i),work)){case .ok(t):{t}case .err(code):{return .err(code);}};if(v::len<model::Text>(lists)>=32768){return .err(10);}if(!v::push<model::Text>(lists,value).is_ok){return .err(11);}i+=1;}result.parameters=model::Range{.first,.count=v::len<model::Text>(lists)-first};result.result=switch(type(names,sources,metadata,graph,coordinates,named,owner,s.result,work)){case .ok(t):{t}case .err(code):{return .err(code);}};return .ok(result);
    }
    let selected=switch(shape(graph,source,declaration,work)){case .ok(id):{id}case .err(code):{return .err(code);}};let s=typed::shape_at(graph,selected);
    if(d.kind==6){result.effects=switch(effects(names,lists,s.cleanup_effects,false,work)){case .ok(r):{r}case .err(code):{return .err(code);}};result.abilities=switch(effects(names,lists,s.abilities,true,work)){case .ok(r):{r}case .err(code):{return .err(code);}};return .ok(result);}
    if(d.kind==4){result.repr_c=s.repr_c;let first=v::len<model::Field>(fields);var usize i=0;while(i<s.field_count){let f=switch(field(names,sources,metadata,graph,coordinates,named,owner,s.field_start+i,work)){case .ok(f):{f}case .err(code):{return .err(code);}};if(v::len<model::Field>(fields)>=16384){return .err(10);}if(!v::push<model::Field>(fields,f).is_ok){return .err(11);}i+=1;}result.fields=model::Range{.first,.count=v::len<model::Field>(fields)-first};return .ok(result);}
    let first=v::len<model::Variant>(variants);var usize i=0;while(i<s.field_count){if(!budget::charge(work,1)){return .err(10);}let variant=typed::field_at(graph,s.field_start+i);if(variant.kind==2 || variant.kind==3){let name=switch(text(names,typed::field_name(graph,s.field_start+i),work)){case .ok(t):{t}case .err(code):{return .err(code);}};let payload=v::len<model::Field>(fields);var usize j=0;while(j<variant.payload_count){let f=switch(field(names,sources,metadata,graph,coordinates,named,owner,variant.payload_start+j,work)){case .ok(f):{f}case .err(code):{return .err(code);}};if(v::len<model::Field>(fields)>=16384){return .err(10);}if(!v::push<model::Field>(fields,f).is_ok){return .err(11);}j+=1;}if(v::len<model::Variant>(variants)>=16384){return .err(10);}if(!v::push<model::Variant>(variants,model::Variant{.name,.fields=model::Range{.first=payload,.count=variant.payload_count}}).is_ok){return .err(11);}}i+=1;}result.variants=model::Range{.first,.count=v::len<model::Variant>(variants)-first};return .ok(result);
}
fn Result<i32,u32> order(ref bytes::Buffer names,model::Text a,model::Text c,ref mut usize work){let storage=bytes::view(names);if(a.start>a.end || a.end>storage.len || c.start>c.end || c.end>storage.len){return .err(9);}let left=storage[a.start..a.end];let right=storage[c.start..c.end];var usize i=0;while(i<left.len && i<right.len){if(!budget::charge(work,1)){return .err(10);}if(left[i]!=right[i]){return .ok(if(left[i]<right[i]){-1}else{1});}i+=1;}return .ok(if(left.len<right.len){-1}else if(left.len>right.len){1}else{0});}
fn Result<i32,u32> compare(ref bytes::Buffer names,ref v::Vec<model::Item> items,ref v::Vec<model::Module> modules,usize a,usize c,bool module_order,ref mut usize work){if(!budget::charge(work,1)){return .err(10);}if(module_order){return order(names,v::at<model::Module>(modules,a).path,v::at<model::Module>(modules,c).path,work);}let left=*v::at<model::Item>(items,a);let right=*v::at<model::Item>(items,c);let kind=switch(order(names,left.kind,right.kind,work)){case .ok(n):{n}case .err(code):{return .err(code);}};return if(kind!=0){.ok(kind)}else{order(names,left.name,right.name,work)};}
fn void swap(ref mut v::Vec<model::Item> items,ref mut v::Vec<model::Module> modules,usize a,usize c,bool module_order){if(module_order){let left=*v::at<model::Module>(modules,a);let right=*v::at<model::Module>(modules,c);{let slot=v::at_mut<model::Module>(modules,a);*slot=right;}{let slot=v::at_mut<model::Module>(modules,c);*slot=left;}}else{let left=*v::at<model::Item>(items,a);let right=*v::at<model::Item>(items,c);{let slot=v::at_mut<model::Item>(items,a);*slot=right;}{let slot=v::at_mut<model::Item>(items,c);*slot=left;}}}
fn u32 sift(ref mut bytes::Buffer names,ref mut v::Vec<model::Item> items,ref mut v::Vec<model::Module> modules,usize first,usize root,usize count,bool module_order,ref mut usize work){var usize at=root;while(at<count/2){var usize child=at*2+1;if(child+1<count){let next=switch(compare(names,items,modules,first+child,first+child+1,module_order,work)){case .ok(n):{n}case .err(code):{return code;}};if(next<0){child+=1;}}let parent=switch(compare(names,items,modules,first+at,first+child,module_order,work)){case .ok(n):{n}case .err(code):{return code;}};if(parent>=0){return 0;}swap(items,modules,first+at,first+child,module_order);at=child;}return 0;}
fn u32 sort(ref mut bytes::Buffer names,ref mut v::Vec<model::Item> items,ref mut v::Vec<model::Module> modules,usize first,usize count,bool module_order,ref mut usize work){var usize root=count/2;while(root>0){root-=1;let code=sift(names,items,modules,first,root,count,module_order,work);if(code!=0){return code;}}var usize end=count;while(end>1){end-=1;swap(items,modules,first,first+end,module_order);let code=sift(names,items,modules,first,0,end,module_order,work);if(code!=0){return code;}}var usize i=1;while(i<count){let compared=switch(compare(names,items,modules,first+i-1,first+i,module_order,work)){case .ok(n):{n}case .err(code):{return code;}};if(compared>=0){return 9;}i+=1;}return 0;}
fn Result<Projection,u32> extract_scoped(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,ref ids::Table named,usize owner,ref mut usize work){
    if(owner>=512 || v::len<syntax::Parsed>(sources)!=signatures::module_count(metadata)){return .err(9);}let coordinate_code=type_text::validate_owner(coordinates,owner,work);if(coordinate_code!=0){return .err(coordinate_code);}var bytes::Buffer names=bytes::empty();var v::Vec<model::Text> lists=v::empty<model::Text>();var v::Vec<model::Field> fields=v::empty<model::Field>();var v::Vec<model::Variant> variants=v::empty<model::Variant>();var v::Vec<model::Item> items=v::empty<model::Item>();var v::Vec<model::Module> modules=v::empty<model::Module>();var bool templates=false;var usize source=0;
    while(source<v::len<syntax::Parsed>(sources)){if(!budget::charge(work,1)){return .err(10);}if(signatures::module_owner(metadata,source)!=owner){source+=1;continue;}let p=v::at<syntax::Parsed>(sources,source);if(!budget::charge(work,syntax::source_view(p).len+1)){return .err(10);}if(!signatures::source_matches(metadata,source,p)){return .err(12);}let header=syntax::declaration_at(p,0);if(header.kind!=1){return .err(9);}var bytes::Buffer path=bytes::empty();let code=registry::normalize(syntax::source_view(p)[header.name_start..header.name_end],ref mut path);if(code!=0){return .err(code);}let name=switch(text(ref mut names,bytes::view(ref path),work)){case .ok(t):{t}case .err(code):{return .err(code);}};let first=v::len<model::Item>(ref items);var usize declaration=1;
        while(declaration<syntax::declaration_count(p)){if(!budget::charge(work,1)){return .err(10);}let d=syntax::declaration_at(p,declaration);if(d.public){if(d.generic_parameters!=0){templates=true;}else if(d.kind==3 || d.kind==4 || d.kind==6 || d.kind==9 || d.kind==11){let value=switch(item(ref mut names,ref mut lists,ref mut fields,ref mut variants,sources,metadata,graph,coordinates,named,owner,source,declaration+1,work)){case .ok(i):{i}case .err(code):{return .err(code);}};if(v::len<model::Item>(ref items)>=16384){return .err(10);}if(!v::push<model::Item>(ref mut items,value).is_ok){return .err(11);}}else{return .err(9);}}declaration+=1;}
        let count=v::len<model::Item>(ref items)-first;let sorted=sort(ref mut names,ref mut items,ref mut modules,first,count,false,work);if(sorted!=0){return .err(sorted);}if(v::len<model::Module>(ref modules)>=512){return .err(10);}if(!v::push<model::Module>(ref mut modules,model::Module{.path=name,.items=model::Range{.first,.count}}).is_ok){return .err(11);}source+=1;
    }if(v::len<model::Module>(ref modules)==0){return .err(9);}let module_count=v::len<model::Module>(ref modules);let sorted=sort(ref mut names,ref mut items,ref mut modules,0,module_count,true,work);if(sorted!=0){return .err(sorted);}return .ok(Projection{.descriptor=model::assemble(names,lists,fields,variants,items,modules),.templates});
}

pub fn Result<Projection,u32> extract(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,usize owner,ref mut usize work){let named=ids::empty();return extract_scoped(sources,metadata,graph,coordinates,ref named,owner,work);}
pub fn Result<Projection,u32> extract_identified(ref ids::Table named,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref typed::Interfaces graph,ref type_text::Coordinates coordinates,usize owner,ref mut usize work){let checked=ids::current(named,sources,metadata,graph,work);if(checked!=0){return .err(checked);}return extract_scoped(sources,metadata,graph,coordinates,named,owner,work);}
