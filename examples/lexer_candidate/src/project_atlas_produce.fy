module project_atlas_produce;
import project_atlas_write as w;
import project_atlas_facts as facts;
import project_atlas_declarations as declarations;
import project_atlas_calls as calls;
import project_atlas_instances as instances;
import project_atlas_header as header;
import project_atlas_current as current;
import project_atlas_model as model;
import project_compiler_input as input;
import project_path as work;
import module_unit_body_ir_model as ir;
import project_atlas_schema as schema;
import module_signatures as signatures;
import module_types as types;
import module_public_type_text as coordinates;
import std::bytes as bytes;
import std::vec as v;
pub resource Package{facts::Facts facts;v::Vec<bytes::Buffer> declarations;v::Vec<bytes::Buffer> keys;v::Vec<bytes::Buffer> full;calls::Summaries summaries;cleanup{}}
pub fn usize call_count(ref Package p){return calls::count(ref p.summaries);}
pub fn usize external_count(ref Package p){return calls::external_count(ref p.summaries);}
pub fn ref u8[] uid(ref Package p){return facts::value(ref p.facts,b"package_uid");}
pub fn ref u8[] instance(ref Package p){return facts::value(ref p.facts,b"package_instance");}
pub fn Result<Package,u32> package(facts::Facts facts,ref input::Input source,ref ir::Program program,ref coordinates::Coordinates table,ref signatures::Program metadata,ref mut v::Vec<types::Type> type_rows,usize owner,ref mut usize meter){let context=instances::empty();return package_generics(facts,source,program,table,metadata,type_rows,ref context,owner,meter);}
pub fn Result<Package,u32> package_generics(facts::Facts facts,ref input::Input source,ref ir::Program program,ref coordinates::Coordinates table,ref signatures::Program metadata,ref mut v::Vec<types::Type> type_rows,ref instances::Instances context,usize owner,ref mut usize meter){let rows=if(instances::aggregate_types(context)){declarations::collect_aggregates(source,owner,meter)?}else if(instances::vector_types(context)){declarations::collect_sdk_vectors(source,owner,meter)?}else if(instances::template_count(context)>0){declarations::collect_generics(source,owner,meter)?}else{declarations::collect_all(source,owner,meter)?};if(v::len<declarations::Row>(ref rows)==0){return .err(104);}var keys=v::empty<bytes::Buffer>();var v::Vec<bytes::Buffer> decl=v::empty<bytes::Buffer>();var v::Vec<bytes::Buffer> hashes=v::empty<bytes::Buffer>();var usize i=0;while(i<v::len<declarations::Row>(ref rows)){let declaration=schema::declaration(source,table,metadata,type_rows,*v::at<declarations::Row>(ref rows,i),meter)?;var key=bytes::empty();discard schema::key(ref mut key,source,*v::at<declarations::Row>(ref rows,i),meter)?;if(!v::push<bytes::Buffer>(ref mut keys,key).is_ok){return .err(2);}let hash=declarations::digest(ref facts,bytes::view(ref declaration),meter)?;if(!v::push<bytes::Buffer>(ref mut decl,declaration).is_ok){return .err(2);}if(!v::push<bytes::Buffer>(ref mut hashes,hash).is_ok){return .err(2);}i+=1;}let summaries=calls::summaries_aggregates(source,program,metadata,table,context,ref rows,meter)?;return .ok(Package{.facts,.declarations=decl,.keys,.full=hashes,.summaries});}
pub fn Result<bytes::Buffer,u32> encode(ref Package p,usize total_resolved,usize total_external,ref mut usize meter){let count=v::len<bytes::Buffer>(ref p.declarations);let h=header::header_generics(ref p.facts,count,calls::function_count(ref p.summaries),call_count(p),total_external,calls::specialization_count(ref p.summaries),meter)?;let complete=header::completeness_generics(total_resolved,total_external,calls::template_count(ref p.summaries),calls::implementation_count(ref p.summaries),meter)?;var bytes::Buffer map=bytes::empty();discard w::raw(ref mut map,b"{",meter)?;if(calls::specialization_count(ref p.summaries)>0){discard w::raw(ref mut map,b"\"specializations\":",meter)?;discard w::raw(ref mut map,calls::specializations(ref p.summaries),meter)?;discard w::raw(ref mut map,b",",meter)?;}discard w::raw(ref mut map,b"\"header\":",meter)?;discard w::raw(ref mut map,bytes::view(ref h),meter)?;discard w::raw(ref mut map,b",\"files\":",meter)?;discard w::raw(ref mut map,facts::array(ref p.facts,b"files"),meter)?;discard w::raw(ref mut map,b",\"modules\":",meter)?;discard w::raw(ref mut map,facts::modules(ref p.facts),meter)?;discard w::raw(ref mut map,b",\"symbols\":[",meter)?;
 var v::Vec<usize> ordered=v::empty<usize>();var usize i=0;while(i<count){if(!v::push<usize>(ref mut ordered,i).is_ok){return .err(2);}var usize at=i;while(at>0){let old=*v::at<usize>(ref ordered,at-1);let left=bytes::view(v::at<bytes::Buffer>(ref p.full,i));let right=bytes::view(v::at<bytes::Buffer>(ref p.full,old));if(!work::charge(meter,left.len+right.len+1)){return .err(3);}if(!model::before(left,right)){break;}{let slot=v::at_mut<usize>(ref mut ordered,at);*slot=old;}{let slot=v::at_mut<usize>(ref mut ordered,at-1);*slot=i;}at-=1;}i+=1;}
 i=0;while(i<count){let at=*v::at<usize>(ref ordered,i);let full=bytes::view(v::at<bytes::Buffer>(ref p.full,at));var bytes::Buffer visible=bytes::empty();discard w::raw(ref mut visible,b"fysym1-sha256-128-",meter)?;discard w::raw(ref mut visible,full[18..50],meter)?;if(i>0){discard w::raw(ref mut map,b",",meter)?;}discard w::raw(ref mut map,b"{\"declaration\":",meter)?;discard w::raw(ref mut map,bytes::view(v::at<bytes::Buffer>(ref p.keys,at)),meter)?;discard w::raw(ref mut map,b",",meter)?;discard w::pair(ref mut map,b"visible",bytes::view(ref visible),meter)?;discard w::raw(ref mut map,b",",meter)?;discard w::pair(ref mut map,b"full",full,meter)?;discard w::raw(ref mut map,b"}",meter)?;i+=1;}
 discard w::raw(ref mut map,b"],\"declarations\":[",meter)?;i=0;while(i<count){if(i>0){discard w::raw(ref mut map,b",",meter)?;}discard w::raw(ref mut map,bytes::view(v::at<bytes::Buffer>(ref p.declarations,i)),meter)?;i+=1;}discard w::raw(ref mut map,b"],\"functions\":",meter)?;discard w::raw(ref mut map,calls::text(ref p.summaries),meter)?;discard w::raw(ref mut map,b",\"completeness\":",meter)?;discard w::raw(ref mut map,bytes::view(ref complete),meter)?;discard w::raw(ref mut map,b"}",meter)?;return w::envelope(bytes::view(ref map),meter);
}
pub fn Result<current::Ready,u32> ready(ref Package p,usize total_resolved,usize total_external,ref mut usize meter){let encoded=encode(p,total_resolved,total_external,meter)?;let expected=switch(bytes::copy(model::raw(facts::expected(ref p.facts),0))){case .ok(p):{p}case .err(_):{return .err(2);}};return if(calls::template_count(ref p.summaries)>0){current::read_generics(encoded,expected,meter)}else{current::read(encoded,expected,meter)};
}
