module module_unit_loan_live_walk;
import module_unit_loan_live_model as l;
import module_unit_loan_live_maps as table;
import module_unit_loan_live_control as control;
import module_unit_value_model as m;
import syntax as syntax;
import std::vec as v;

pub fn Result<m::Expression,m::Problem> typed(ref m::Values body,usize original,ref mut l::Context c){var usize low=0;var usize high=m::expression_count(body);while(low<high){if(!m::charge(ref mut c.work,1)){return .err(l::fail(c,10,0,0));}let mid=low+(high-low)/2;if(m::expression_at(body,mid+1).source_index<original){low=mid+1;}else{high=mid;}}return if(low<m::expression_count(body) && m::expression_at(body,low+1).source_index==original){.ok(m::expression_at(body,low+1))}else{.err(l::fail(c,12,0,0))};}
fn m::Problem list(usize id,u32 kind,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){var usize link=id;while(link!=0){if(!m::charge(ref mut c.work,1)){return l::fail(c,10,0,0);}let e=syntax::expression_at(source,link);if(e.kind!=kind){return l::fail(c,12,e.start,e.end);}let p=expression(e.left,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);if(p.code!=0){return p;}link=e.right;}return l::fail(c,0,0,0);}
pub fn m::Problem expression(usize id,ref syntax::Parsed source,ref m::Values body,ref v::Vec<l::Local> locals,l::Loop loop,usize depth,ref mut v::Vec<l::Use> env,ref mut v::Vec<l::Point> expressions,ref mut v::Vec<l::Point> statements,ref mut v::Vec<l::Header> maps,ref mut v::Vec<l::Row> rows,ref mut l::Context c){
    if(id==0){return l::fail(c,0,0,0);}let e=syntax::expression_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return l::fail(c,10,e.start,e.end);}let recorded=table::save(id,env,expressions,maps,rows,c);if(recorded.code!=0){return recorded;}
    if(e.kind==2 || e.kind==28){let typed=switch(typed(body,id,c)){case .ok(e):{e}case .err(p):{return p;}};if(typed.binding!=0){if(typed.binding>v::len<l::Local>(locals)){return l::fail(c,12,e.start,e.end);}if(v::at<l::Local>(locals,typed.binding-1).borrowed && e.end>v::at<l::Use>(env,typed.binding-1).end){let slot=v::at_mut<l::Use>(env,typed.binding-1);*slot=l::Use{.start=e.start,.end=e.end};}}return l::fail(c,0,0,0);}
    if(e.kind==1 || e.kind==16 || e.kind==17 || e.kind==32 || e.kind==33){return l::fail(c,0,0,0);}if(e.kind==12 || e.kind==31){return control::block(e.left,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}if(e.kind==13 || e.kind==15){return control::branch(e,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);}
    let right=if(e.kind==6 || e.kind==10 || e.kind==24){list(e.right,if(e.kind==6){7}else if(e.kind==10){11}else{25},source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c)}else if(e.kind==20 || e.kind==23){l::fail(c,0,0,0)}else{expression(e.right,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c)};if(right.code!=0){return right;}return expression(e.left,source,body,locals,loop,depth+1,env,expressions,statements,maps,rows,c);
}
