module module_unit_value_view;
import module_unit_value_model as m;
import module_unit_value_scalar as scalar;
import module_unit_value_place as places;
import module_unit_value_shapes as shapes;
import module_unit_interfaces as interfaces;
import module_types as types;
import scalar_views as views;
import syntax as syntax;
import std::vec as v;

pub fn bool view(types::Type t){return t.kind==10 || t.kind==11 || t.kind==15 && views::extended(t.scalar) || t.kind==17 || t.kind==18;}
pub fn bool mutable(types::Type t){return t.kind==11 || t.kind==15 && views::mutable(t.scalar) || t.kind==18;}
fn u32 element(types::Type t){return if(t.kind==10 || t.kind==11){3}else if(t.kind==15 && views::extended(t.scalar)){views::element(t.scalar)}else{0};}
pub fn bool shared(types::Type expected,types::Type actual){return view(expected) && view(actual) && !mutable(expected) && mutable(actual) && element(expected)==element(actual) && expected.first==actual.first;}
fn m::Problem ok(m::Frame frame){return m::fail(frame,0,0,0,0,0);}
fn Result<usize,m::Problem> canonical(m::Frame f,m::Expression e,types::Type t,ref mut v::Vec<types::Type> graph,ref mut usize work){if(!m::charge(work,types::count(graph)+1)){return .err(m::fail(f,10,e.start,e.end,0,0));}let usize id=types::canonical(graph,t);return if(id==0){.err(m::fail(f,if(types::count(graph)>=4096){10}else{11},e.start,e.end,0,0))}else{.ok(id)};}
fn void record(ref mut v::Vec<m::Expression> expressions,usize id,usize expected,usize type,m::Place origin){let slot=v::at_mut<m::Expression>(expressions,id-1);slot.state=1;slot.type=type;slot.expected=expected;slot.place=origin;}
fn m::Problem field_owner(m::Frame frame,m::Expression e,m::Expression owner,bool sliced,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Expression> expressions,ref mut usize work){
    var usize root=m::index(expressions,owner.source_index);var usize depth=0;while(root!=0){let node=*v::at<m::Expression>(expressions,root-1);if(node.kind!=3 && node.kind!=8){break;}if(depth>=64 || !m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}root=m::index(expressions,node.left);depth+=1;}if(root==0){return m::fail(frame,12,e.start,e.end,0,0);}let base=*v::at<m::Expression>(expressions,root-1);if(base.type==0){return m::fail(frame,12,e.start,e.end,0,0);}let bt=types::at(graph,base.type);let usize plain=if(bt.kind==7 || bt.kind==8){bt.first}else{base.type};let bool safe=switch(shapes::element(imported,graph,frame,e,plain,work)){case .ok(b):{b}case .err(p):{return p;}};
    let t=types::at(graph,owner.type);let bool item=switch(shapes::inline_element(imported,graph,frame,e,t.first,work)){case .ok(b):{b}case .err(p):{return p;}};if(base.kind!=2 || !safe || !item){return m::fail(frame,if(sliced){1008}else{2},if(sliced){owner.start}else{e.start},if(sliced){owner.end}else{e.end},0,owner.type);}return ok(frame);
}
pub fn m::Problem element_borrow(m::Frame frame,m::Expression e,m::Expression selected,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Expression> expressions,ref mut usize work){
    if(selected.place.kind!=4 && selected.place.kind!=2){return ok(frame);}var item=selected;var usize depth=0;while(item.kind==3 || item.kind==8){if(depth>=64 || !m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}let usize id=m::index(expressions,item.left);if(id==0){return m::fail(frame,12,e.start,e.end,0,0);}item=*v::at<m::Expression>(expressions,id-1);depth+=1;}if(item.kind!=9){return ok(frame);}let usize id=m::index(expressions,item.left);if(id==0){return m::fail(frame,12,e.start,e.end,0,0);}let owner=*v::at<m::Expression>(expressions,id-1);let t=types::at(graph,owner.type);
    if(t.kind==16 && owner.place.kind==2){let p=field_owner(frame,e,owner,false,imported,graph,expressions,work);if(p.code==2 && e.kind==22){return m::fail(frame,1008,selected.start,selected.end,0,owner.type);}return p;}return ok(frame);
}
fn Result<usize,m::Problem> array_type(ref syntax::Parsed source,m::Frame frame,m::Expression e,m::Expression owner,usize expected,bool sliced,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref v::Vec<m::Expression> expressions,ref mut usize work){
    let t=types::at(graph,owner.type);let bool exclusive=e.kind==22;let bool named=owner.kind==2 || owner.place.kind==2;if(!named || !owner.place.borrowable){return .err(m::fail(frame,if(exclusive){1008}else{2},if(exclusive){owner.start}else{e.start},if(exclusive){owner.end}else{e.end},0,owner.type));}if(exclusive && (!owner.place.mutable || owner.place.resource_field)){return .err(m::fail(frame,1008,owner.start,owner.end,0,owner.type));}
    let valid=switch(shapes::element(imported,graph,frame,e,t.first,work)){case .ok(b):{b}case .err(p):{return .err(p);}};if(!valid){return .err(m::fail(frame,2,e.start,e.end,0,owner.type));}
    let inner=types::at(graph,t.first);let u32 scalar=if(inner.kind==1){inner.scalar}else{0};let desired=if(expected==0){types::Type{.kind=0,.scalar=0,.module_index=0,.declaration=0,.first=0,.second=0}}else{types::at(graph,expected)};let bool contextual=view(desired) && mutable(desired)==exclusive && (scalar!=0 && element(desired)==scalar || inner.kind==2 && (desired.kind==17 || desired.kind==18) && desired.first==t.first);let bool nominal_field=owner.place.kind==2 && inner.kind==2 && view(desired);
    if(sliced || contextual || nominal_field){
        if(owner.place.kind==2){let p=field_owner(frame,e,owner,sliced,imported,graph,expressions,work);if(p.code!=0){return .err(p);}}
        if(inner.kind==2){return canonical(frame,e,types::Type{.kind=if(exclusive){18}else{17},.scalar=0,.module_index=0,.declaration=0,.first=t.first,.second=0},graph,work);}if(scalar==0){return .ok(0);}let u32 code=views::make(scalar,exclusive);return canonical(frame,e,types::Type{.kind=if(code==10){10}else if(code==11){11}else{15},.scalar=if(views::extended(code)){code}else{0},.module_index=0,.declaration=0,.first=0,.second=0},graph,work);
    }if(owner.place.kind==2 && inner.kind==2){return .err(m::fail(frame,2,e.start,e.end,0,owner.type));}return places::borrow(frame,e,owner,exclusive,graph,work);
}
fn m::Problem bounds(ref syntax::Parsed source,m::Frame frame,m::Expression slice,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth,ref mut bool complete){
    let b=syntax::expression_at(source,slice.right);if(b.kind!=27){return m::fail(frame,12,slice.start,slice.end,0,0);}var usize i=0;while(i<2){let usize original=if(i==0){b.left}else{b.right};if(original!=0){let usize id=m::index(expressions,original);if(id==0){return m::fail(frame,12,slice.start,slice.end,0,0);}let p=scalar::evaluate(source,frame,id,m::atom(atoms,5),imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}let actual=*v::at<m::Expression>(expressions,id-1);if(actual.state==2 || actual.type!=0 && actual.type!=m::atom(atoms,5)){return m::fail(frame,1006,actual.start,actual.end,m::atom(atoms,5),actual.type);}if(actual.type==0){*complete=false;}}i+=1;}return ok(frame);
}
pub fn m::Problem slice(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){
    let e=*v::at<m::Expression>(expressions,id-1);let usize child=m::index(expressions,e.left);if(child==0){return m::fail(frame,12,e.start,e.end,0,0);}let p=scalar::evaluate(source,frame,child,0,imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}var bool complete=true;let q=bounds(source,frame,e,imported,graph,atoms,expressions,work,depth,ref mut complete);if(q.code!=0){return q;}let owner=*v::at<m::Expression>(expressions,child-1);if(owner.state==2){return m::fail(frame,2,owner.start,owner.end,0,0);}if(owner.type==0){return ok(frame);}if(!view(types::at(graph,owner.type))){return m::fail(frame,2,owner.start,owner.end,0,owner.type);}if(!complete){return ok(frame);}var origin=owner.place;origin.kind=0;origin.projection=e.source_index;origin.mutable=mutable(types::at(graph,owner.type));origin.indirect=true;origin.borrowable=false;record(expressions,id,expected,owner.type,origin);return ok(frame);
}
pub fn m::Problem borrow(ref syntax::Parsed source,m::Frame frame,usize id,usize expected,ref interfaces::Interfaces imported,ref mut v::Vec<types::Type> graph,ref m::Atoms atoms,ref mut v::Vec<m::Expression> expressions,ref mut usize work,usize depth){
    let e=*v::at<m::Expression>(expressions,id-1);let usize child=m::index(expressions,e.left);if(child==0){return m::fail(frame,12,e.start,e.end,0,0);}var usize selected=child;var usize level=0;while(v::at<m::Expression>(expressions,selected-1).kind==3){if(level>=64 || !m::charge(work,1)){return m::fail(frame,10,e.start,e.end,0,0);}selected=m::index(expressions,v::at<m::Expression>(expressions,selected-1).left);if(selected==0){return m::fail(frame,12,e.start,e.end,0,0);}level+=1;}let target=*v::at<m::Expression>(expressions,selected-1);let bool sliced=target.kind==26;let usize actual=if(sliced){m::index(expressions,target.left)}else{child};if(actual==0){return m::fail(frame,12,e.start,e.end,0,0);}let p=scalar::evaluate(source,frame,actual,0,imported,graph,atoms,expressions,work,depth+1);if(p.code!=0){return p;}let owner=*v::at<m::Expression>(expressions,actual-1);if(owner.type==0){return ok(frame);}let t=types::at(graph,owner.type);if(t.kind!=16){if(sliced){return m::fail(frame,if(e.kind==22){1008}else{2},if(e.kind==22){target.start}else{e.start},if(e.kind==22){target.end}else{e.end},0,owner.type);}return ok(frame);}let usize type=switch(array_type(source,frame,e,owner,expected,sliced,imported,graph,atoms,expressions,work)){case .ok(t):{t}case .err(p):{return p;}};if(type==0){return ok(frame);}var origin=owner.place;origin.kind=0;origin.projection=e.source_index;origin.mutable=e.kind==22;origin.indirect=true;origin.borrowable=false;
    if(sliced){var bool complete=true;let q=bounds(source,frame,target,imported,graph,atoms,expressions,work,depth,ref mut complete);if(q.code!=0){return q;}if(!complete){return ok(frame);}record(expressions,selected,0,type,origin);var usize group=child;while(group!=selected){record(expressions,group,0,type,origin);group=m::index(expressions,v::at<m::Expression>(expressions,group-1).left);}}
    record(expressions,id,expected,type,origin);return ok(frame);
}
