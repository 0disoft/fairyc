module module_constant_runtime;
import module_unit_value_model as m;
import module_constant_model as model;
import syntax as syntax;
import type_state as scalars;
import std::bytes as bytes;
import std::vec as v;
import module_constant_arithmetic as arithmetic;
fn m::Problem step(usize module_index,syntax::Expression e,ref v::Vec<usize> owners,ref mut v::Vec<model::Counter> counters,ref mut usize work){
    if(!model::charge(work)){return model::fail(module_index,4304,e.start,e.end);}let usize owner=if(v::len<usize>(owners)==0){0}else{*v::at<usize>(owners,module_index)};var usize i=0;
    while(i<v::len<model::Counter>(counters)){if(!model::charge(work)){return model::fail(module_index,4304,e.start,e.end);}let current=*v::at<model::Counter>(counters,i);if(current.owner==owner){if(current.steps>=65536){return model::fail(module_index,4304,e.start,e.end);}let cell=v::at_mut<model::Counter>(counters,i);cell.steps+=1;return model::ok();}i+=1;}
    if(!v::push<model::Counter>(counters,model::Counter{.owner,.steps=1}).is_ok){return model::fail(module_index,11,e.start,e.end);}return model::ok();
}
pub fn Result<model::Value,m::Problem> constant(ref v::Vec<syntax::Parsed> sources,ref mut v::Vec<model::Entry> entries,ref v::Vec<model::Parameter> parameters,usize entry,ref mut v::Vec<u32> states,ref v::Vec<usize> owners,ref mut v::Vec<model::Counter> counters,ref mut usize work,usize calls){
    let row=*v::at<model::Entry>(entries,entry-1);if(*v::at<u32>(states,entry-1)==2){return .ok(row.value);}let source=v::at<syntax::Parsed>(sources,row.module_index);let d=syntax::declaration_at(source,row.declaration-1);
    if(*v::at<u32>(states,entry-1)==1){return .err(model::fail(row.module_index,4304,d.name_start,d.name_end));}{let cell=v::at_mut<u32>(states,entry-1);*cell=1;}
    let environment=v::empty<model::Value>();let value=switch(expression(sources,entries,parameters,row.module_index,row.expression,row.value.scalar,states,owners,counters,work,0,ref environment,calls,0)){case .ok(v):{v}case .err(p):{return .err(p);}};
    if(value.scalar!=row.value.scalar){let e=syntax::expression_at(source,d.expression);return .err(model::fail(row.module_index,1006,e.start,e.end));}{let cell=v::at_mut<model::Entry>(entries,entry-1);cell.value=value;}{let cell=v::at_mut<u32>(states,entry-1);*cell=2;}return .ok(value);
}
pub fn Result<model::Value,m::Problem> expression(ref v::Vec<syntax::Parsed> sources,ref mut v::Vec<model::Entry> entries,ref v::Vec<model::Parameter> parameters,usize module_index,usize id,u32 scalar,ref mut v::Vec<u32> states,ref v::Vec<usize> owners,ref mut v::Vec<model::Counter> counters,ref mut usize work,usize context,ref v::Vec<model::Value> environment,usize calls,usize depth){
    let source=v::at<syntax::Parsed>(sources,module_index);let e=syntax::expression_at(source,id);if(depth>=64){return .err(model::fail(module_index,4304,e.start,e.end));}let charged=step(module_index,e,owners,counters,work);if(charged.code!=0){return .err(charged);}let raw=syntax::expression_text(source,id);
    if(e.kind==1){if(bytes::equal(raw,b"true") || bytes::equal(raw,b"false")){return .ok(model::Value{.scalar=6,.bits=if(bytes::equal(raw,b"true")){1}else{0}});}let u32 selected=if(model::admitted(scalar) && scalar!=6){scalar}else{1};if(!scalars::fits(raw,selected,false)){return .err(model::fail(module_index,1013,e.start,e.end));}return .ok(model::Value{.scalar=selected,.bits=model::literal_bits(raw)});}
    if(e.kind==2){let parameter=switch(model::parameter(source,entries,parameters,context,raw,e.start,e.end,work)){case .ok(n):{n}case .err(p):{return .err(p);}};if(parameter!=0){let row=*v::at<model::Entry>(entries,context-1);return .ok(*v::at<model::Value>(environment,parameter-1-row.parameter_start));}let target=switch(model::find(sources,entries,module_index,raw,e.start,e.end,work)){case .ok(n):{n}case .err(p):{return .err(p);}};return constant(sources,entries,parameters,target,states,owners,counters,work,calls);}
    if(e.kind==3){return expression(sources,entries,parameters,module_index,e.left,scalar,states,owners,counters,work,context,environment,calls,depth+1);}
    if(e.kind==4){if(bytes::equal(raw,b"-")){let u32 signed=if(scalar==2){2}else{1};let minimum=switch(model::signed_minimum(source,module_index,e.left,signed,work)){case .ok(v):{v}case .err(p):{return .err(p);}};if(minimum){var usize id=e.left;while(syntax::expression_at(source,id).kind==3){let child=syntax::expression_at(source,id);let p=step(module_index,child,owners,counters,work);if(p.code!=0){return .err(p);}id=child.left;}let child=syntax::expression_at(source,id);let p=step(module_index,child,owners,counters,work);if(p.code!=0){return .err(p);}return .ok(model::Value{.scalar=signed,.bits=if(signed==1){2147483648}else{9223372036854775808}});}}
        let value=switch(expression(sources,entries,parameters,module_index,e.left,scalar,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};let computed=arithmetic::prefix(value.scalar,raw,value.bits);return if(computed.code==0){.ok(model::Value{.scalar=computed.scalar,.bits=computed.bits})}else{.err(model::fail(module_index,computed.code,e.start,e.end))};
    }
    if(e.kind==5){var model::Value left=model::Value{.scalar=0,.bits=0};var model::Value right=left;let logical=bytes::equal(raw,b"&&") || bytes::equal(raw,b"||");let numeric=scalars::operation(raw) || scalars::comparison(raw);let a=switch(model::flexible(source,module_index,e.left,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};let b=switch(model::flexible(source,module_index,e.right,work,0)){case .ok(v):{v}case .err(p):{return .err(p);}};
        if(numeric && a && !b){right=switch(expression(sources,entries,parameters,module_index,e.right,scalar,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};left=switch(expression(sources,entries,parameters,module_index,e.left,right.scalar,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}
        else{left=switch(expression(sources,entries,parameters,module_index,e.left,scalar,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};if(logical){if(left.scalar!=6){let child=syntax::expression_at(source,e.left);return .err(model::fail(module_index,1007,child.start,child.end));}if(bytes::equal(raw,b"&&") && left.bits==0 || bytes::equal(raw,b"||") && left.bits==1){return .ok(left);}}right=switch(expression(sources,entries,parameters,module_index,e.right,left.scalar,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};}
        if(left.scalar!=right.scalar){let child=syntax::expression_at(source,e.right);return .err(model::fail(module_index,1006,child.start,child.end));}let computed=arithmetic::binary(left.scalar,raw,left.bits,right.bits);return if(computed.code==0){.ok(model::Value{.scalar=computed.scalar,.bits=computed.bits})}else{.err(model::fail(module_index,computed.code,e.start,e.end))};
    }
    if(e.kind==6){let target=switch(model::callee(sources,entries,parameters,module_index,id,context,work)){case .ok(n):{n}case .err(p):{return .err(p);}};if(calls>=32){return .err(model::fail(module_index,4304,e.start,e.end));}let row=*v::at<model::Entry>(entries,target-1);var v::Vec<model::Value> bindings=v::empty<model::Value>();var usize i=0;
        while(i<row.parameter_count){let argument=syntax::call_argument(source,id,i);let expected=v::at<model::Parameter>(parameters,row.parameter_start+i).scalar;let value=switch(expression(sources,entries,parameters,module_index,argument,expected,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};if(value.scalar!=expected){let e=syntax::expression_at(source,argument);return .err(model::fail(module_index,1006,e.start,e.end));}if(!v::push<model::Value>(ref mut bindings,value).is_ok){return .err(model::fail(module_index,11,e.start,e.end));}i+=1;}
        return expression(sources,entries,parameters,row.module_index,row.expression,row.value.scalar,states,owners,counters,work,target,ref bindings,calls+1,0);
    }
    if(e.kind==23){let value=switch(expression(sources,entries,parameters,module_index,e.left,0,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};let computed=arithmetic::cast(value.scalar,scalars::primitive(source,e.right),value.bits);return if(computed.code==0){.ok(model::Value{.scalar=computed.scalar,.bits=computed.bits})}else{.err(model::fail(module_index,computed.code,e.start,e.end))};}
    if(e.kind==12){let tail=switch(model::tail(source,module_index,e.left)){case .ok(n):{n}case .err(p):{return .err(p);}};return expression(sources,entries,parameters,module_index,tail,scalar,states,owners,counters,work,context,environment,calls,depth+1);}
    if(e.kind==13){let condition=switch(expression(sources,entries,parameters,module_index,e.left,6,states,owners,counters,work,context,environment,calls,depth+1)){case .ok(v):{v}case .err(p):{return .err(p);}};let branch=syntax::expression_at(source,e.right);
        if(condition.bits==0){return expression(sources,entries,parameters,module_index,branch.right,scalar,states,owners,counters,work,context,environment,calls,depth+1);}let block=syntax::statement_at(source,branch.left);let charged=step(module_index,syntax::Expression{.kind=12,.start=block.start,.end=block.end,.token=0,.left=0,.right=0},owners,counters,work);if(charged.code!=0){return .err(charged);}let tail=switch(model::tail(source,module_index,branch.left)){case .ok(n):{n}case .err(p):{return .err(p);}};return expression(sources,entries,parameters,module_index,tail,scalar,states,owners,counters,work,context,environment,calls,depth+1);
    }
return .err(model::fail(module_index,4302,e.start,e.end));
}
