module project_atlas_header;
import project_atlas_facts as facts;
import project_atlas_write as w;
import std::bytes as bytes;
pub fn ref u8[] relations(){return b"allocates|borrows|calls|drops|effects|generic-specializations|generic-template-bodies|may-trap|moves|reads|returns-error|test-calls|uses-unsafe|writes";}
fn bool exact(ref u8[] relation){return bytes::equal(relation,b"calls") || bytes::equal(relation,b"generic-specializations");}
fn ref u8[] reason(ref u8[] relation){if(bytes::equal(relation,b"generic-template-bodies")){return b"bodies-checked-only-after-specialization";}return b"candidate-atlas-not-collected";}
pub fn Result<bytes::Buffer,u32> completeness(usize calls,ref mut usize meter){var bytes::Buffer out=bytes::empty();discard w::raw(ref mut out,b"[",meter)?;let names=relations();var usize start=0;while(start<names.len){var usize end=start;while(end<names.len && names[end]!=124){end+=1;}let relation=names[start..end];if(start!=0){discard w::raw(ref mut out,b",",meter)?;}discard w::raw(ref mut out,b"{",meter)?;discard w::pair(ref mut out,b"relation",relation,meter)?;discard w::raw(ref mut out,b",",meter)?;discard w::pair(ref mut out,b"status",if(exact(relation)){b"exact"}else{b"unavailable"},meter)?;discard w::raw(ref mut out,b",\"resolved\":",meter)?;discard w::number(ref mut out,if(bytes::equal(relation,b"calls")){calls}else{0},meter)?;discard w::raw(ref mut out,b",\"external\":0,\"unknown\":0,\"reasons\":[",meter)?;if(!exact(relation)){discard w::string(ref mut out,reason(relation),meter)?;}discard w::raw(ref mut out,b"]}",meter)?;start=end+1;}discard w::raw(ref mut out,b"]",meter)?;return .ok(out);}
fn Result<bool,u32> omissions(ref mut bytes::Buffer out,ref mut usize meter){discard w::raw(out,b"[",meter)?;let names=relations();var usize start=0;var bool first=true;while(start<names.len){var usize end=start;while(end<names.len && names[end]!=124){end+=1;}let relation=names[start..end];if(!exact(relation)){if(!first){discard w::raw(out,b",",meter)?;}var bytes::Buffer name=bytes::empty();discard w::raw(ref mut name,relation,meter)?;discard w::raw(ref mut name,b":unavailable:",meter)?;discard w::raw(ref mut name,reason(relation),meter)?;discard w::string(out,bytes::view(ref name),meter)?;first=false;}start=end+1;}return w::raw(out,b"]",meter);}
pub fn Result<bytes::Buffer,u32> header(ref facts::Facts f,usize declarations,usize calls,ref mut usize meter){var bytes::Buffer out=bytes::empty();discard w::raw(ref mut out,b"{\"logical_schema\":\"fairyc.fymap-logical/v3\",\"snapshot_model\":\"fairyc.semantic-snapshot/v0\",",meter)?;discard w::pair(ref mut out,b"compiler_build",facts::value(f,b"compiler_build"),meter)?;discard w::raw(ref mut out,b",\"compiler_build_algorithm\":\"fairyc.compiler-executable-sha256/v1\",",meter)?;
 let names=b"language|package_uid|package_instance|package_coordinate|package_source|package_source_kind|runtime_abi";var usize start=0;while(start<names.len){var usize end=start;while(end<names.len && names[end]!=124){end+=1;}let name=names[start..end];discard w::pair(ref mut out,name,facts::value(f,name),meter)?;discard w::raw(ref mut out,b",",meter)?;start=end+1;}
 discard w::raw(ref mut out,b"\"target_scope\":\"target-independent\",\"target\":\"\",\"package_instance_algorithm\":\"fairyc.package-instance/v1\",\"package_coordinate_algorithm\":\"fairyc.package-coordinate/v1\",\"package_source_algorithm\":\"fairyc.package-source/v1\",\"source_file_algorithm\":\"fairyc.source-file/v1\",\"line_map_algorithm\":\"fairyc.source-line-map/v1\",\"symbol_algorithm\":\"fairyc.symbol-id/v1-sha256-128+256\",\"interface_algorithm\":\"fairyc.public-interface/v5\",",meter)?;discard w::pair(ref mut out,b"interface_hash",facts::value(f,b"interface_hash"),meter)?;discard w::raw(ref mut out,b",\"generic_interface_algorithm\":\"fairyc.generic-public-interface/v0\",",meter)?;discard w::pair(ref mut out,b"generic_interface_hash",facts::value(f,b"generic_interface_hash"),meter)?;let arrays=b"features|dependencies|package_references";start=0;while(start<arrays.len){var usize end=start;while(end<arrays.len && arrays[end]!=124){end+=1;}let name=arrays[start..end];discard w::raw(ref mut out,b",",meter)?;discard w::string(ref mut out,name,meter)?;discard w::raw(ref mut out,b":",meter)?;discard w::raw(ref mut out,facts::array(f,name),meter)?;start=end+1;}
 discard w::raw(ref mut out,b",\"generation_status\":\"partial\",\"omissions\":",meter)?;discard omissions(ref mut out,meter)?;discard w::raw(ref mut out,b",\"counts\":{\"files\":",meter)?;discard w::number(ref mut out,facts::files(f),meter)?;discard w::raw(ref mut out,b",\"modules\":",meter)?;discard w::number(ref mut out,facts::files(f),meter)?;discard w::raw(ref mut out,b",\"symbols\":",meter)?;discard w::number(ref mut out,declarations,meter)?;discard w::raw(ref mut out,b",\"functions\":",meter)?;discard w::number(ref mut out,declarations,meter)?;discard w::raw(ref mut out,b",\"relations\":",meter)?;discard w::number(ref mut out,calls,meter)?;discard w::raw(ref mut out,b",\"completeness\":14}}",meter)?;return .ok(out);}
