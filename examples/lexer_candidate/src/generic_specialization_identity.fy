module generic_specialization_identity;
import generic_identity as identity;
import module_public_interface_model as model;
import module_public_interface_write as write;
import module_state_layout as budget;
import project_manifest_values as lexical;
import std::bytes as bytes;
import std::vec as v;

// The caller supplies resolved, dependency-closed planner facts. This encoder
// neither chooses providers nor admits source templates or executable artifacts.
pub struct Root{model::Text declaration;model::Text owner;model::Text definition;}
pub struct Concrete{model::Text id;model::Text owner;model::Text definition;model::Range abilities;}
pub struct Operand{model::Text id;model::Text definition;}
pub struct Constraint{model::Text capability;model::Text definition;model::Range arguments;model::Text provider;model::Text provider_definition;}
pub resource Facts{bytes::Buffer names;Root root;v::Vec<Concrete> arguments;v::Vec<model::Text> abilities;v::Vec<Constraint> constraints;v::Vec<Operand> operands;v::Vec<model::Text> dependencies;cleanup{}}
pub fn Facts assemble(bytes::Buffer names,Root root,v::Vec<Concrete> arguments,v::Vec<model::Text> abilities,v::Vec<Constraint> constraints,v::Vec<Operand> operands,v::Vec<model::Text> dependencies){return Facts{.names,.root,.arguments,.abilities,.constraints,.operands,.dependencies};}
fn bool valid(ref Facts p,model::Text t){return t.start<=t.end && t.end<=bytes::len(ref p.names);}
fn ref u8[] text(ref Facts p,model::Text t){assert(valid(p,t));return bytes::view(ref p.names)[t.start..t.end];}
fn bool start(u8 c){return c==95 || c>=65 && c<=90 || c>=97 && c<=122;}
fn bool path(ref u8[] value){if(value.len==0 || value.len>512){return false;}var usize at=0;var usize segment=0;while(at<value.len){if(value[at]==58){if(segment==0 || at+1>=value.len || value[at+1]!=58){return false;}segment=0;at+=2;continue;}let c=value[at];if(segment==0 && !start(c) || segment!=0 && !(start(c) || c>=48 && c<=57)){return false;}segment+=1;if(segment>128){return false;}at+=1;}return segment!=0;}
fn u32 name(ref Facts p,model::Text t,ref mut bytes::Buffer out,ref mut usize work){if(!valid(p,t)){return 9;}let value=text(p,t);if(!budget::charge(work,value.len+1)){return 10;}return if(!path(value)){9}else{identity::text(out,value,work)};}
fn u32 digest(ref Facts p,model::Text t,ref mut bytes::Buffer out,ref mut usize work){if(!valid(p,t)){return 9;}return identity::digest(out,text(p,t),true,work);}
fn u32 ability(ref u8[] value){return if(bytes::equal(value,b"copy")){1}else if(bytes::equal(value,b"drop")){2}else if(bytes::equal(value,b"inert")){3}else if(bytes::equal(value,b"key")){4}else if(bytes::equal(value,b"resource")){5}else if(bytes::equal(value,b"scalar")){6}else if(bytes::equal(value,b"store")){7}else{0};}
fn u32 abilities(ref Facts p,model::Range range,ref mut bytes::Buffer out,ref mut usize work){if(range.count>7 || !model::valid_range(range,v::len<model::Text>(ref p.abilities))){return 9;}var u32 code=write::number(out,range.count,work);if(code!=0){return code;}var u32 previous=0;var u32 mask=0;var usize i=0;while(i<range.count){let t=*v::at<model::Text>(ref p.abilities,range.first+i);if(!valid(p,t)){return 9;}let value=text(p,t);if(!budget::charge(work,value.len+1)){return 10;}let id=ability(value);if(id<=previous){return 9;}mask|=1<<(id-1);previous=id;code=identity::text(out,value,work);if(code!=0){return code;}i+=1;}return if(mask&32!=0 && mask&71!=71 || mask&4!=0 && mask&2==0 || mask&8!=0 && mask&64==0 || mask&16!=0 && mask&37!=0){9}else{0};}
fn Result<bytes::Buffer,u32> constraint_key(ref Facts p,Constraint c,ref mut usize work){if(!valid(p,c.capability) || !valid(p,c.provider) || c.arguments.count==0 || c.arguments.count>8 || !model::valid_range(c.arguments,v::len<Operand>(ref p.operands))){return .err(9);}var bytes::Buffer key=bytes::empty();var u32 code=write::raw(ref mut key,text(p,c.capability),work);if(code!=0){return .err(code);}code=write::raw(ref mut key,b"<",work);if(code!=0){return .err(code);}var usize i=0;while(i<c.arguments.count){let a=*v::at<Operand>(ref p.operands,c.arguments.first+i);if(!valid(p,a.id)){return .err(9);}if(i!=0){code=write::raw(ref mut key,b",",work);if(code!=0){return .err(code);}}code=write::raw(ref mut key,text(p,a.id),work);if(code!=0){return .err(code);}i+=1;}code=write::raw(ref mut key,b">=",work);if(code!=0){return .err(code);}code=write::raw(ref mut key,text(p,c.provider),work);if(code!=0){return .err(code);}return .ok(key);}
pub fn Result<bytes::Buffer,u32> encode(ref Facts p,ref mut usize work){
    let count=v::len<Concrete>(ref p.arguments);let constraints=v::len<Constraint>(ref p.constraints);let dependencies=v::len<model::Text>(ref p.dependencies);if(bytes::len(ref p.names)>1048576 || count==0 || count>8 || constraints>32 || dependencies>32 || v::len<model::Text>(ref p.abilities)>56 || v::len<Operand>(ref p.operands)>256){return .err(9);}var bytes::Buffer out=bytes::empty();var u32 code=identity::text(ref mut out,b"fairyc.genericplan.specialization.v0",work);if(code!=0){return .err(code);}code=name(p,p.root.declaration,ref mut out,work);if(code!=0){return .err(code);}code=name(p,p.root.owner,ref mut out,work);if(code!=0){return .err(code);}code=digest(p,p.root.definition,ref mut out,work);if(code!=0){return .err(code);}code=write::number(ref mut out,count,work);if(code!=0){return .err(code);}var usize i=0;
    while(i<count){if(!budget::charge(work,1)){return .err(10);}let a=*v::at<Concrete>(ref p.arguments,i);code=name(p,a.id,ref mut out,work);if(code!=0){return .err(code);}code=name(p,a.owner,ref mut out,work);if(code!=0){return .err(code);}code=abilities(p,a.abilities,ref mut out,work);if(code!=0){return .err(code);}code=digest(p,a.definition,ref mut out,work);if(code!=0){return .err(code);}i+=1;}
    code=write::number(ref mut out,constraints,work);if(code!=0){return .err(code);}var bytes::Buffer previous=bytes::empty();i=0;while(i<constraints){if(!budget::charge(work,1)){return .err(10);}let c=*v::at<Constraint>(ref p.constraints,i);let key=switch(constraint_key(p,c,work)){case .ok(value):{value}case .err(code):{return .err(code);}};if(i>0){if(!budget::charge(work,bytes::len(ref previous)+bytes::len(ref key)+1)){return .err(10);}if(lexical::before(bytes::view(ref key),bytes::view(ref previous))){return .err(9);}}discard bytes::clear(ref mut previous);if(!bytes::append(ref mut previous,bytes::view(ref key)).is_ok){return .err(11);}code=name(p,c.capability,ref mut out,work);if(code!=0){return .err(code);}code=digest(p,c.definition,ref mut out,work);if(code!=0){return .err(code);}code=write::number(ref mut out,c.arguments.count,work);if(code!=0){return .err(code);}var usize j=0;while(j<c.arguments.count){let a=*v::at<Operand>(ref p.operands,c.arguments.first+j);code=name(p,a.id,ref mut out,work);if(code!=0){return .err(code);}code=digest(p,a.definition,ref mut out,work);if(code!=0){return .err(code);}j+=1;}code=name(p,c.provider,ref mut out,work);if(code!=0){return .err(code);}code=digest(p,c.provider_definition,ref mut out,work);if(code!=0){return .err(code);}i+=1;}
    code=write::number(ref mut out,dependencies,work);if(code!=0){return .err(code);}i=0;while(i<dependencies){let t=*v::at<model::Text>(ref p.dependencies,i);if(!valid(p,t)){return .err(9);}let value=text(p,t);if(!budget::charge(work,value.len+1)){return .err(10);}if(!identity::valid_id(value,b"g0_")){return .err(9);}if(i>0){let before=*v::at<model::Text>(ref p.dependencies,i-1);if(!budget::charge(work,text(p,before).len+value.len+1)){return .err(10);}if(!lexical::before(text(p,before),value)){return .err(9);}}code=identity::text(ref mut out,value,work);if(code!=0){return .err(code);}i+=1;}return .ok(out);
}
pub fn Result<bytes::Buffer,u32> compute(ref Facts p,ref mut usize work){let encoded=switch(encode(p,work)){case .ok(value):{value}case .err(code):{return .err(code);}};return identity::hash(ref encoded,b"g0_",work);}
