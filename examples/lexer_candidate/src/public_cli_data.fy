module public_cli_data;
import std::bytes as bytes;

// Generated by cmd/fairyc-candidate-cli-embed from internal/cli, diagnostic,
// target, and sdkstdlib. Build tools replace version() in an isolated copy with
// current source-build metadata; an unstamped direct build retains unknown VCS.
pub fn ref str help(){return "Fairy C Stage 0 compiler prototype\n\nUsage:\n  fairyc new <package-name> --uid <package-uid>\n  fairyc check [--locked]\n  fairyc build [--release] [--locked]\n  fairyc run [--release] [--locked] [-- <program-args...>]\n  fairyc test [--json] [--locations] [--native [--release] [--stdin | --stdin-file <portable-workspace-file>] [--timeout-seconds <1..60>] [--capture-output] [-- <program-args>...]] [--workspace | --package <package-uid>] [--dir <portable-test-directory>]... [--file <portable-test-path>]... [--exact <test-identity>]... [--locked]\n  fairyc test --list [--json] [--locations] [--workspace | --package <package-uid>] [--dir <portable-test-directory>]... [--file <portable-test-path>]... [--locked]\n  fairyc explain <diagnostic-code>\n  fairyc targets\n  fairyc experimental parse <file.fy>\n  fairyc experimental check-syntax <file.fy>\n  fairyc experimental check-semantics <file.fy> [<file.fy>...]\n  fairyc experimental check <primary.fy> [--source <file.fy>]...\n  fairyc experimental check-workspace [--locked]\n  fairyc experimental atlas-pack overview --package-uid <uid> --max-records <count> --max-selection-bytes <bytes> --max-output-bytes <bytes> [--pack-version <1|2|3>] [--locked]\n  fairyc experimental atlas-pack show --package-uid <uid> --symbol <symbol-id> --direction <outgoing|incoming|both> --relation <kind> [--relation <kind>]... --max-records <count> --max-relations <count> --max-selection-bytes <bytes> --max-output-bytes <bytes> [--pack-version <1|2|3>] [--locked]\n  fairyc experimental atlas-pack around --package-uid <uid> --symbol <symbol-id> --direction <outgoing|incoming|both> --relation <kind> [--relation <kind>]... --max-records <count> --max-relations <count> --max-depth <depth> --max-selection-bytes <bytes> --max-output-bytes <bytes> [--pack-version <1|2|3>] [--locked]\n  fairyc experimental atlas-symbols list --package-uid <uid> --kind <kind> [--kind <kind>]... [--module <module>] [--name <identifier>] [--after <full-symbol-id>] --max-symbols <count> --max-selection-bytes <bytes> --max-output-bytes <bytes> [--catalog-version <1|2|3>] [--locked]\n  fairyc experimental atlas-calls list --package-uid <uid> --symbol <symbol-id> --direction <outgoing|incoming|both> --max-packages <count> --max-calls <count> --max-output-bytes <bytes> [--catalog-version <0|1|2>] [--locked]\n  fairyc experimental atlas-text source --package-uid <uid> --symbol <symbol-id> --origin workspace-authored --max-fragments <count> --max-fragment-bytes <bytes> --max-text-bytes <bytes> --max-output-bytes <bytes> [--locked]\n  fairyc experimental atlas-text documentation --package-uid <uid> --symbol <symbol-id> --origin workspace-authored --max-fragments <count> --max-fragment-bytes <bytes> --max-text-bytes <bytes> --max-output-bytes <bytes> [--locked]\n  fairyc experimental atlas-evidence show --package-uid <uid> --symbol <symbol-id> --direction <outgoing|incoming|both> --relation <kind> [--relation <kind>]... --max-records <count> --max-relations <count> --max-selection-bytes <bytes> --max-fragment-bytes <bytes> --max-text-bytes <bytes> --max-facts-bytes <bytes> --max-text-document-bytes <bytes> --max-output-bytes <bytes> [--bundle-version <0|1|2>] [--locked]\n  fairyc experimental check-workspace-cache --target <target-id> --cache-dir <build/path> --cache-max-entries <count> --cache-max-bytes <bytes> --cache-max-record-bytes <bytes> --cache-max-artifact-bytes <bytes> --cache-temp-max-age-seconds <seconds> [--locked]\n  fairyc experimental check-workspace-session --target <target-id> --max-requests <count> --cache-max-entries <count> --cache-max-bytes <bytes> --cache-max-artifact-bytes <bytes> [--locked]\n  fairyc experimental build-workspace --target x86_64-windows-msvc --profile <low|optimized> --output <build/path.exe> [--locked]\n  fairyc experimental build-workspace --target x86_64-linux-gnu --cc <gcc|clang> --profile <low|optimized> --output <build/path> [--locked]\n  fairyc experimental run-workspace --target x86_64-windows-msvc --profile <low|optimized> [--locked]\n  fairyc experimental run-workspace --target x86_64-linux-gnu --cc <gcc|clang> --profile <low|optimized> [--locked]\n  fairyc experimental emit-workspace-c --target <target-id> [--locked]\n  fairyc experimental target-spec <target-id>\n  fairyc experimental emit-c <entry.fy> [--source <file.fy>]...\n  fairyc experimental build <entry.fy> [--source <file.fy>]... --cc <clang|gcc> --profile <low|optimized> --output <build/path>\n  fairyc experimental build-target <entry.fy> [--source <file.fy>]... --target x86_64-windows-msvc --profile <low|optimized> --output <build/path.exe>\n  fairyc experimental run-target <entry.fy> [--source <file.fy>]... --target x86_64-windows-msvc --profile <low|optimized>\n  fairyc experimental exec-target <entry.fy> [--source <file.fy>]... --target x86_64-windows-msvc --profile <low|optimized>\n  fairyc experimental build-host <entry.fy> [--source <file.fy>]... --profile <low|optimized> --output <build/path.exe>\n  fairyc experimental run-host <entry.fy> [--source <file.fy>]... --profile <low|optimized>\n  fairyc experimental run <entry.fy> [--source <file.fy>]...\n  fairyc --help\n  fairyc --version\n\nThe experimental commands are unstable. \"fairyc new\" creates one no-overwrite child starter with\nan explicit package UID. \"fairyc check\" verifies the local workspace. \"fairyc build\"\ncreates or replaces build/<package-name>.exe on Windows or build/<package-name> on Linux GNU amd64.\nLinux builds require GCC or Clang on PATH. \"fairyc run\" builds and executes a temporary native\nimage, forwards caller stdin, bounded program output, and any arguments after \"--\" as the\nprogram's process arguments, preserves ordinary program status, and retains no artifact.\n\"fairyc test\" checks the root package, one explicitly selected root-reachable local package, or every\nunambiguous root-reachable local package with --workspace plus their isolated tests/ sources. It lists\ncanonical test identities or runs all, exact portable test directories, exact portable test files, or exact identities through the semantic interpreter or as\nisolated Windows or Linux images with --native; --json selects a stable machine report for listing or execution,\n--locations adds exact-current portable source anchors, and native tests receive any process arguments\nafter \"--\" in every isolated execution. Explicit --stdin attaches caller input only when exactly one\nnative test is selected; native tests otherwise receive EOF. Explicit --capture-output requires\nnative JSON execution and adds exact base64 process streams to each outcome.\nExplicit --stdin-file replays one bounded workspace-contained file from byte zero to every native test.\nExplicit --timeout-seconds bounds each isolated native test process and defaults to 60 seconds.\n\"fairyc experimental emit-workspace-c\" writes one private, explicitly targeted C11 bootstrap unit\nto stdout without invoking a toolchain. Its generated source is compiler-internal transport, not a\ncross-release C API or standalone product artifact. Pass --release to build, run, or native test for\noptimization. All four stable workspace commands read fairy.toml and refresh fairy.lock unless\n--locked is supplied.\n";}
pub fn ref str version(){return "Fairy C Stage 0\ncompiler: development\nsdk: fairyc-sdk-stdlib/0 0.0.0-stage0.87\nlanguage: fairyc-language/20\nruntime: fairyc-runtime/0\nrevision: unknown\nmodified: unknown\n";}
pub fn ref str targets(){return "x86_64-linux-gnu\n  schema: fairyc.target-spec/v0\n  emission subset: scalar-and-flat-copy-resource-tagged-c11\n  emittable: no\n  conformant: no\n  supported: no\n  missing evidence:\n    - complete-runtime\n    - complete-standard-library\n\nx86_64-windows-msvc\n  schema: fairyc.target-spec/v0\n  emission subset: scalar-and-llp64-c-scalar-c11\n  emittable: no\n  conformant: no\n  supported: no\n  missing evidence:\n    - bidirectional-c-abi-fixtures\n    - c-layout-probes\n    - complete-runtime\n    - complete-standard-library\n    - pe-coff-object-fixtures\n    - toolchain-baseline\n    - toolchain-provisioning\n    - windows-x64-unwind-fixtures\n";}
pub fn ref str explanation(ref u8[] code){
    if(bytes::equal(code,b"E0001")){return "E0001: Source is not valid UTF-8 or identifier syntax is unsupported.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0002")){return "E0002: Module declaration does not match its package-relative file identity.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0003")){return "E0003: Import lacks an alias or uses a forbidden wildcard, selective, cyclic, or re-export form.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0004")){return "E0004: Integer or floating literal has an invalid radix digit, separator, or excluded spelling.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0005")){return "E0005: String-family literal has an unknown, truncated, out-of-range, or disallowed escape.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0006")){return "E0006: C-string literal contains a decoded interior NUL.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0007")){return "E0007: Parser inserted one required missing token at a zero-width byte span.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0008")){return "E0008: Parser skipped an unexpected real token into an error node.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0009")){return "E0009: Comparison operators are chained without explicit parentheses.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0010")){return "E0010: Shared parser budget is exhausted before a complete bounded result is available.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0101")){return "E0101: Name or qualified path cannot be resolved in its owning scope.\nCategory: Name resolution and source visibility\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0102")){return "E0102: Declaration duplicates a name in the same owning scope.\nCategory: Name resolution and source visibility\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E0103")){return "E0103: Resolved item is not source-visible from the use module.\nCategory: Name resolution and source visibility\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1001")){return "E1001: Source local declaration has no initializer.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1002")){return "E1002: Inert struct contains a resource.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1003")){return "E1003: Named aggregate contains a safe borrow.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1004")){return "E1004: Restricted user enum contains a resource or safe-borrow payload.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1005")){return "E1005: Byte view is used as text without explicit validation.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1006")){return "E1006: Expression type is incompatible with its expected type.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1007")){return "E1007: Condition or logical operand is not `bool`.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1008")){return "E1008: Assignment target is not a mutable place.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1009")){return "E1009: Return expression is incompatible with the declared return type.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1010")){return "E1010: Call argument count does not match the resolved declaration.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1014")){return "E1014: Call argument label does not match its position or the call target does not support labels.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1012")){return "E1012: `break` or `continue` has no enclosing loop.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1013")){return "E1013: Integer literal is outside the range of its selected `i32`, `u8`, `u32`, or `usize` type.\nCategory: Type and initialization\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1101")){return "E1101: Resource used after move or consumption.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1102")){return "E1102: Operation would create or execute a second cleanup obligation.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1103")){return "E1103: Resource field move is not supported.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1104")){return "E1104: Branch join leaves a resource `MaybeLive`.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1105")){return "E1105: Loop back edge changes the required ownership state.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1106")){return "E1106: Fallible `drop` or ambiguous close ownership.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1107")){return "E1107: `@abilities` is empty, duplicated, malformed, names an unknown resource ability, or declares `key` without `store`.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1108")){return "E1108: Compiler-scheduled implicit destruction reaches a resource whose explicit ability set omits `drop`.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E1109")){return "E1109: Explicit `burn` is not authorized for this value, resource declaration, or module.\nCategory: Resource ownership and drop\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E2101")){return "E2101: Access conflicts with an active shared or mutable loan.\nCategory: Borrowing and return origins\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E2102")){return "E2102: Returned borrow originates from a local value.\nCategory: Borrowing and return origins\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E2103")){return "E2103: Returned borrow has multiple possible input origins.\nCategory: Borrowing and return origins\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E2104")){return "E2104: Borrow-returning function cannot become a function value or callback.\nCategory: Borrowing and return origins\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E2105")){return "E2105: Borrow outlives or moves its owner.\nCategory: Borrowing and return origins\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E3101")){return "E3101: Region-derived value escapes the region.\nCategory: Regions and arenas\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E3102")){return "E3102: Plain region allocation contains a type that needs drop.\nCategory: Regions and arenas\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E3103")){return "E3103: Region capability is stored, captured, moved out, or returned.\nCategory: Regions and arenas\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E3104")){return "E3104: Source attempts to construct a compiler-owned `Region` capability.\nCategory: Regions and arenas\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4101")){return "E4101: `Result` value is not handled, returned, propagated, or explicitly discarded.\nCategory: Option, Result, and propagation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4102")){return "E4102: `?` is applied to a non-`Result` value.\nCategory: Option, Result, and propagation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4103")){return "E4103: `?` error type is incompatible with the enclosing return type.\nCategory: Option, Result, and propagation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4201")){return "E4201: `@must_use` is malformed, duplicated, misplaced, or applied to an ineligible result.\nCategory: Return-value use obligations\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4202")){return "E4202: A resolved `@must_use` call result is ignored without explicit `discard`.\nCategory: Return-value use obligations\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4301")){return "E4301: A module constant or `@const_eval` declaration is malformed, misplaced, public, or otherwise ineligible.\nCategory: Bounded compile-time evaluation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4302")){return "E4302: A well-typed expression is outside the admitted compile-time subset.\nCategory: Bounded compile-time evaluation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4303")){return "E4303: Compile-time evaluation traps on arithmetic, division, shift, or cast semantics.\nCategory: Bounded compile-time evaluation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4304")){return "E4304: A compile-time dependency cycle or deterministic evaluator budget prevents a result.\nCategory: Bounded compile-time evaluation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4305")){return "E4305: A module-level `static_assert` evaluates to false.\nCategory: Bounded compile-time evaluation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4401")){return "E4401: The reserved `source_location` intrinsic name is declared, bound, or used without its exact call form.\nCategory: Name resolution and source visibility\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4402")){return "E4402: A `source_location()` call has no valid canonical source path or exact retained line geometry.\nCategory: Syntax, modules, and imports\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4501")){return "E4501: Generic source preparation rejects a malformed, colliding, shadowing, or reserved declaration or binding.\nCategory: Explicit generic source preparation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4502")){return "E4502: A generic call requires supported explicit scalar type arguments with the declared arity.\nCategory: Explicit generic source preparation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E4503")){return "E4503: A generic declaration or concrete request exceeds a catalog or expansion limit, or triggers a specialization cycle.\nCategory: Explicit generic source preparation\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5101")){return "E5101: Raw-pointer or unchecked operation appears outside an unsafe boundary.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5102")){return "E5102: Raw foreign signature contains a safe reference.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5103")){return "E5103: Foreign unwind, exception, or `longjmp` may cross a Fairy C frame.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5104")){return "E5104: Safe foreign callback is not supported in Stage 0.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5105")){return "E5105: A retained foreign-pointer API received stack or region-borrowed storage.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E5106")){return "E5106: `@link_name` is duplicated or does not contain exactly one nonempty string literal.\nCategory: Unsafe and foreign boundaries\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E6101")){return "E6101: Type has no supported ABI classification for the selected target.\nCategory: Target layout and ABI\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E6102")){return "E6102: Required target layout fact is unknown.\nCategory: Target layout and ABI\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E6103")){return "E6103: C ABI v0 excludes the requested calling, layout, callback, TLS, or variadic feature.\nCategory: Target layout and ABI\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E7101")){return "E7101: `@effects` is empty, duplicated, malformed, or names an effect outside the Stage 0 vocabulary.\nCategory: Effects and external capabilities\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E7102")){return "E7102: A call or compiler-scheduled resource cleanup requires one or more effects not declared by the enclosing function.\nCategory: Effects and external capabilities\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E7201")){return "E7201: A package state declaration has malformed UID authority, invalid visibility, or more than one package owner.\nCategory: Package-owned contract state\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E7202")){return "E7202: A package state field name is declared more than once.\nCategory: Package-owned contract state\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E7203")){return "E7203: A package state field uses an unsupported or malformed storage codec declaration.\nCategory: Package-owned contract state\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E8001")){return "E8001: Selected runtime ABI is incompatible with generated code.\nCategory: Compatibility and toolchain selection\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E8002")){return "E8002: Requested language revision is unsupported by this compiler.\nCategory: Compatibility and toolchain selection\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
    if(bytes::equal(code,b"E9001")){return "E9001: `@test` must appear exactly once without arguments on a private safe zero-argument free function returning `void` in isolated test source.\nCategory: Test declarations and harness\nCatalog: fairyc.diagnostic-catalog/v0 (provisional Stage 0)\n";}
