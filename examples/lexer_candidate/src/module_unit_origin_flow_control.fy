module module_unit_origin_flow_control;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_origin_flow_model as g;
import module_unit_origin_flow as flow;
import module_unit_origin_match as matching;
import module_unit_values as values;
import module_unit_value_model as m;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;
import module_unit_origin_provenance as p;
import module_unit_loan_checks as loans;
import module_unit_loan_model as loan;

pub fn Result<g::Flow,m::Problem> branch(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,m::Expression e,usize depth){
    let condition=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,e.left,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((condition.outcomes & 1)==0){return .ok(condition);}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let base=switch(g::copy(env,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var bool first=true;var usize origin=0;var usize allocation=0;var usize loan_set=0;var usize outcomes=condition.outcomes & 14;
    var v::Vec<usize> branches=v::empty<usize>();if(e.kind==13){let row=syntax::expression_at(source,e.right);if(row.kind!=14){return .err(g::fail(c,12,e.start,e.end));}if(!v::push<usize>(ref mut branches,row.left).is_ok){return .err(g::fail(c,11,e.start,e.end));}}
    else{var usize link=e.right;while(link!=0){if(!m::charge(ref mut c.work,1) || v::len<usize>(ref branches)>=1024){return .err(g::fail(c,10,e.start,e.end));}let row=syntax::expression_at(source,link);let arm=syntax::expression_at(source,row.left);if(row.kind!=19 || arm.kind!=18){return .err(g::fail(c,12,e.start,e.end));}if(!v::push<usize>(ref mut branches,row.left).is_ok){return .err(g::fail(c,11,e.start,e.end));}link=row.right;}}
    var usize i=0;while(i<v::len<usize>(ref branches)+if(e.kind==13){1}else{0}){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}var selected=switch(g::copy(ref base,c,e.start,e.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var usize symbol=0;if(e.kind==15 && i<v::len<usize>(ref branches)){let arm=syntax::expression_at(source,*v::at<usize>(ref branches,v::len<usize>(ref branches)-1-i));let body=inputs::body(input,primary,c.frame);let subject=switch(g::expression(body,e.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};let pattern=switch(g::expression(body,arm.left,c)){case .ok(p):{p}case .err(p):{return .err(p);}};symbol=switch(matching::seed(input,primary,body,unknowns,subject,pattern,g::value(condition),ref mut selected,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}var g::Flow next=g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1};
        if(i<v::len<usize>(ref branches)){next=switch(block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut selected,edges,loan_records,held_loans,loan_conflicts,c,if(e.kind==15){syntax::expression_at(source,*v::at<usize>(ref branches,v::len<usize>(ref branches)-1-i)).right}else{*v::at<usize>(ref branches,i)},depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};}
        else{let row=syntax::expression_at(source,e.right);next=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut selected,edges,loan_records,held_loans,loan_conflicts,c,row.right,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};}
        if(symbol!=0){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,e.start,e.end));}let slot=v::at_mut<g::Value>(ref mut selected,symbol-1);*slot=*v::at<g::Value>(ref base,symbol-1);}outcomes=outcomes | next.outcomes;if((next.outcomes & 1)!=0){let joined=switch(g::join_value(entries,members,allocations,c,g::Value{.loan=loan_set,.origin,.allocation},g::value(next),e.start,e.end)){case .ok(n):{n}case .err(p):{return .err(p);}};origin=joined.origin;allocation=joined.allocation;loan_set=joined.loan;let p=g::merge(ref base,ref selected,env,first,entries,members,allocations,c,e.start,e.end);if(p.code!=0){return .err(p);}first=false;}i+=1;
    }return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes});
}
fn Result<g::Flow,m::Problem> loop(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,syntax::Statement s,usize depth){
    let source=v::at<syntax::Parsed>(sources,c.value.module_index);var usize post=0;var usize initial_outcomes=0;if(s.kind==14){let h=syntax::statement_at(source,s.second);post=h.second;let initial=switch(statement(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,h.first,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((initial.outcomes & 1)==0){return .ok(initial);}initial_outcomes=initial.outcomes & 14;}
    var usize condition_id=s.expression;if(s.kind==18){let initial=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,s.expression,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((initial.outcomes & 1)==0){return .ok(initial);}initial_outcomes=initial.outcomes & 14;let view=syntax::expression_at(source,s.expression);var retained=g::value(initial);if(retained.loan==0){let owner=switch(loans::root(input,inputs::body(input,primary,c.frame),s.expression,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if(owner!=0 && !inputs::owner(input,owner).borrowed){retained.loan=switch(loans::create(owner,false,view.start,view.end,loan_records,held_loans,loan_conflicts,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}}let held=loans::hold(retained,false,false,held_loans,c,view.start,view.end);if(held.code!=0){return .err(held);}condition_id=0;}
    let base=switch(g::copy(env,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var header=switch(g::copy(env,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var usize rounds=0;var bool converged=false;let usize parent=c.loop_depth;
    while(rounds<64 && !converged){rounds+=1;c.probes+=1;let usize edge_start=v::len<g::Edge>(edges);var current=switch(g::copy(ref header,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};let condition=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut current,edges,loan_records,held_loans,loan_conflicts,c,condition_id,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};var next=switch(g::copy(ref base,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};
        if((condition.outcomes & 1)!=0){c.loop_depth=parent+1;let body=switch(block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut current,edges,loan_records,held_loans,loan_conflicts,c,s.first,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};var bool back=(body.outcomes & 1)!=0;var back_env=switch(g::copy(ref current,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var usize i=edge_start;
            while(i<v::len<g::Edge>(edges)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}let edge=v::at<g::Edge>(edges,i);if(g::edge_depth(edge)==parent+1 && g::edge_kind(edge)==10){let p=g::merge(ref base,g::edge_values(edge),ref mut back_env,!back,entries,members,allocations,c,s.start,s.end);if(p.code!=0){return .err(p);}back=true;}i+=1;}
            if(back){let after=switch(statement(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut back_env,edges,loan_records,held_loans,loan_conflicts,c,post,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((after.outcomes & 1)!=0){let p=g::merge(ref base,ref back_env,ref mut next,false,entries,members,allocations,c,s.start,s.end);if(p.code!=0){return .err(p);}}}c.loop_depth=parent;
        }g::drop_edges(edges,edge_start);c.probes-=1;converged=switch(g::same(ref header,ref next,c,s.start,s.end)){case .ok(b):{b}case .err(p):{return .err(p);}};let changed=g::replace(ref mut header,ref next,c,s.start,s.end);if(changed.code!=0){return .err(changed);}
    }if(!converged){return .err(g::fail(c,10,s.start,s.end));}
    var current=switch(g::copy(ref header,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};let condition=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut current,edges,loan_records,held_loans,loan_conflicts,c,condition_id,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};if((condition.outcomes & 1)==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=initial_outcomes | condition.outcomes});}
    let p=g::replace(env,ref current,c,s.start,s.end);if(p.code!=0){return .err(p);}let usize edge_start=v::len<g::Edge>(edges);c.loop_depth=parent+1;let body=switch(block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut current,edges,loan_records,held_loans,loan_conflicts,c,s.first,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};var usize outcomes=initial_outcomes | (condition.outcomes & 14) | (body.outcomes & 2) | 1;var bool back=(body.outcomes & 1)!=0;var back_env=switch(g::copy(ref current,c,s.start,s.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var usize i=edge_start;
    while(i<v::len<g::Edge>(edges)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}let edge=v::at<g::Edge>(edges,i);if(g::edge_depth(edge)==parent+1 && g::edge_kind(edge)==9){let p=g::merge(ref base,g::edge_values(edge),env,false,entries,members,allocations,c,s.start,s.end);if(p.code!=0){return .err(p);}}else if(g::edge_depth(edge)==parent+1 && g::edge_kind(edge)==10){let p=g::merge(ref base,g::edge_values(edge),ref mut back_env,!back,entries,members,allocations,c,s.start,s.end);if(p.code!=0){return .err(p);}back=true;}i+=1;}
    if(back){let after=switch(statement(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,ref mut back_env,edges,loan_records,held_loans,loan_conflicts,c,post,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};outcomes=outcomes | (after.outcomes & 2);}c.loop_depth=parent;g::drop_edges(edges,edge_start);return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes});
}
pub fn Result<g::Flow,m::Problem> statement(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize id,usize depth){
    let prior=c.statement;c.statement=id;let result=analyze_statement(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,id,depth);c.statement=prior;return result;
}
fn Result<g::Flow,m::Problem> analyze_statement(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize id,usize depth){
    if(id==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1});}let source=v::at<syntax::Parsed>(sources,c.value.module_index);let s=syntax::statement_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}
    if(s.kind==9 || s.kind==10){let p=g::capture(env,s.kind,edges,c,s.start,s.end);return if(p.code!=0){.err(p)}else{.ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=if(s.kind==9){4}else{8}})};}if(s.kind==8 || s.kind==14 || s.kind==18){let held_base=loans::held_count(held_loans);let result=loop(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,s,depth+1);loans::release(held_base,held_loans);return result;}
    var usize prior=0;if(s.kind==4){var usize target_id=s.target;var usize groups=0;while(syntax::expression_at(source,target_id).kind==3){if(groups>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}target_id=syntax::expression_at(source,target_id).left;groups+=1;}let Result<g::Flow,m::Problem> target_result=if(syntax::expression_at(source,target_id).kind==2){.ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=1})}else{flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,s.target,depth+1)};let target=switch(target_result){case .ok(f):{f}case .err(p):{return .err(p);}};if((target.outcomes & 1)==0){return .ok(target);}prior=target.outcomes & 14;}
    if(s.kind==2 || s.kind==3 || s.kind==4){let checked=loans::moved(input,primary,inputs::body(input,primary,c.frame),s.expression,id,env,entries,members,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}}
    let value=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,s.expression,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};var usize outcomes=prior | value.outcomes;if((value.outcomes & 1)==0){return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes});}
    if(s.kind==17){let body=inputs::body(input,primary,c.frame);var usize symbol=1;while(symbol<=m::local_count(body)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}let local=m::local_at(body,symbol);if(local.kind==6 && local.source_index==s.target){break;}symbol+=1;}if(symbol>m::local_count(body) || symbol>v::len<g::Value>(env)){return .err(g::fail(c,12,s.start,s.end));}let old=*v::at<g::Value>(env,symbol-1);let owner=inputs::frame(input,c.frame).local_start+symbol;let seed=switch(sets::owner(owner)){case .ok(n):{n}case .err(code):{return .err(g::fail(c,code,s.start,s.end));}};let slot=v::at_mut<g::Value>(env,symbol-1);*slot=g::Value{.loan=0,.origin=seed,.allocation=0};let usize edge_start=v::len<g::Edge>(edges);let nested=switch(block(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,s.first,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};let expire=g::expire_values(env,allocations,seed,c,s.start,s.end);if(expire.code!=0){return .err(expire);}let expire_paths=g::expire_edges(edges,edge_start,allocations,seed,c,s.start,s.end);if(expire_paths.code!=0){return .err(expire_paths);}let restore=v::at_mut<g::Value>(env,symbol-1);*restore=old;return .ok(g::Flow{.loan=nested.loan,.allocation=nested.allocation,.origin=nested.origin,.outcomes=(outcomes & 14) | nested.outcomes});}
    if(s.kind==3){var usize start=s.start;var usize end=s.end;if(s.expression!=0){let e=syntax::expression_at(source,s.expression);start=e.start;end=e.end;}let p=g::returned(g::value(value),entries,members,allocations,returns,c,start,end);return if(p.code!=0){.err(p)}else{.ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes=(outcomes & 14) | 2})};}
    if(s.kind==11 && s.expression!=0 && bytes::equal(syntax::expression_text(source,s.expression),b"false")){outcomes=(outcomes & 14) | 2;}
    if(s.kind==2){let body=inputs::body(input,primary,c.frame);var usize i=1;while(i<=m::local_count(body)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}let local=m::local_at(body,i);if(local.source_index==s.entry){if(inputs::owner(input,inputs::frame(input,c.frame).local_start+i).borrowed){let slot=v::at_mut<g::Value>(env,i-1);*slot=if(value.origin==0){g::Value{.loan=0,.origin=1,.allocation=0}}else{g::value(value)};if(value.origin==1){let e=syntax::expression_at(source,s.expression);let error=g::unknown(unknowns,c,1,e.start,e.end);if(error.code!=0){return .err(error);}}}break;}i+=1;}if(i>m::local_count(body)){return .err(g::fail(c,12,s.start,s.end));}}
    if(s.kind==4){let owner=switch(loans::root(input,inputs::body(input,primary,c.frame),s.target,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let at=syntax::expression_at(source,s.target);let checked=loans::check(input,env,entries,members,id,true,owner,true,true,at.start,at.end,loan_records,held_loans,loan_conflicts,c);if(checked.code!=0){return .err(checked);}var usize root=s.target;var usize count=0;while(syntax::expression_at(source,root).kind==3){if(count>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,s.start,s.end));}root=syntax::expression_at(source,root).left;count+=1;}let target=switch(g::expression(inputs::body(input,primary,c.frame),root,c)){case .ok(e):{e}case .err(p):{return .err(p);}};
        if(target.kind==2 && target.binding!=0){if(target.binding>v::len<g::Value>(env)){return .err(g::fail(c,12,target.start,target.end));}let owner=inputs::owner(input,inputs::frame(input,c.frame).local_start+target.binding);if(owner.borrowed){let slot=v::at_mut<g::Value>(env,target.binding-1);*slot=if(value.origin==0){g::Value{.loan=0,.origin=1,.allocation=0}}else{g::value(value)};if(value.origin==1){let e=syntax::expression_at(source,s.expression);let error=g::unknown(unknowns,c,2,e.start,e.end);if(error.code!=0){return .err(error);}}}}
    }return .ok(g::Flow{.loan=0,.allocation=0,.origin=0,.outcomes});
}
pub fn Result<g::Flow,m::Problem> block(ref v::Vec<syntax::Parsed> sources,ref inputs::Inputs input,ref values::Plan primary,ref v::Vec<g::Value> summaries,ref mut v::Vec<sets::Entry> entries,ref mut v::Vec<usize> members,ref mut v::Vec<p::Row> allocations,ref mut v::Vec<g::Returned> returns,ref mut v::Vec<g::Unknown> unknowns,ref mut v::Vec<g::Value> env,ref mut v::Vec<g::Edge> edges,ref mut v::Vec<loan::Loan> loan_records,ref mut v::Vec<loan::Held> held_loans,ref mut v::Vec<loan::Conflict> loan_conflicts,ref mut g::Context c,usize id,usize depth){
    let source=v::at<syntax::Parsed>(sources,c.value.module_index);if(id==0 || id>syntax::statement_count(source)){return .err(g::fail(c,12,0,0));}let b=syntax::statement_at(source,id);if(b.kind!=1){return .err(g::fail(c,12,b.start,b.end));}if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(g::fail(c,10,b.start,b.end));}let base=switch(g::copy(env,c,b.start,b.end)){case .ok(v):{v}case .err(p):{return .err(p);}};var v::Vec<usize> order=v::empty<usize>();var usize link=b.first;
    while(link!=0){let row=syntax::statement_at(source,link);if(!m::charge(ref mut c.work,1) || v::len<usize>(ref order)>=8192){return .err(g::fail(c,10,b.start,b.end));}if(row.kind!=7){return .err(g::fail(c,12,row.start,row.end));}if(!v::push<usize>(ref mut order,row.first).is_ok){return .err(g::fail(c,11,row.start,row.end));}link=row.second;}if(v::len<usize>(ref order)!=b.second){return .err(g::fail(c,12,b.start,b.end));}
    var usize outcomes=1;var usize origin=0;var usize allocation=0;var usize loan_set=0;var usize i=v::len<usize>(ref order);while(i>0 && (outcomes & 1)!=0){i-=1;let next=switch(statement(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,*v::at<usize>(ref order,i),depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};outcomes=(outcomes & 14) | next.outcomes;}
    if((outcomes & 1)!=0){let tail=switch(flow::expression(sources,input,primary,summaries,entries,members,allocations,returns,unknowns,env,edges,loan_records,held_loans,loan_conflicts,c,b.expression,depth+1)){case .ok(f):{f}case .err(p):{return .err(p);}};origin=tail.origin;allocation=tail.allocation;loan_set=tail.loan;outcomes=(outcomes & 14) | tail.outcomes;}
    var usize j=0;while(j<v::len<g::Value>(env)){if(!m::charge(ref mut c.work,1)){return .err(g::fail(c,10,b.start,b.end));}if(v::at<g::Value>(ref base,j).origin==0){let slot=v::at_mut<g::Value>(env,j);*slot=g::Value{.loan=0,.origin=0,.allocation=0};}j+=1;}return .ok(g::Flow{.loan=loan_set,.allocation,.origin,.outcomes});
}
