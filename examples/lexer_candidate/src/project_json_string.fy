}
pub fn Result<bytes::Buffer,u32> quote_diagnostic(ref u8[] input,ref mut usize meter){if(input.len>8388608 || !work::charge(meter,input.len+1)){return .err(1);}if(!text::validate_utf8(input).is_ok){return .err(2);}var bytes::Buffer out=bytes::empty();var u32 code=append(ref mut out,b"\"",meter);if(code!=0){return .err(code);}var usize at=0;while(at<input.len){let first=input[at];var usize width=if(first<128){1}else if(first<224){2}else if(first<240){3}else{4};var usize rune=if(width==1){first as usize}else if(width==2){(first as usize)%32}else if(width==3){(first as usize)%16}else{(first as usize)%8};var usize i=1;while(i<width){rune=rune*64+((input[at+i] as usize)%64);i+=1;}code=diagnostic_rune(ref mut out,input[at..at+width],rune,meter);if(code!=0){return .err(code);}at+=width;}code=append(ref mut out,b"\"",meter);if(code!=0){return .err(code);}return .ok(out);}
