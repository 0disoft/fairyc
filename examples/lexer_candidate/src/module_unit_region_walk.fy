module module_unit_region_walk;
import module_unit_region_model as r;
import module_unit_region_events as events;
import module_unit_value_model as m;
import module_unit_interfaces as interfaces;
import module_types as types;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;

// Outcomes: fallthrough1, return/trap2, nearest break4, continue8. A trap
// terminates traversal but emits neither cleanup nor reset facts.
fn Result<usize,m::Problem> list(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,usize id,u32 kind,usize depth,ref mut v::Vec<usize> active,ref mut v::Vec<r::Loop> loops,ref mut v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut v::Vec<r::Exit> exits,ref mut r::Context c){
    var v::Vec<usize> order=v::empty<usize>();var usize link=id;while(link!=0){let e=syntax::expression_at(source,link);if(!m::charge(ref mut c.work,1) || v::len<usize>(ref order)>=1024){return .err(r::fail(c,10,e.start,e.end));}if(e.kind!=kind){return .err(r::fail(c,12,e.start,e.end));}if(!v::push<usize>(ref mut order,e.left).is_ok){return .err(r::fail(c,11,e.start,e.end));}link=e.right;}var usize outcomes=1;var usize i=v::len<usize>(ref order);while(i>0 && (outcomes&1)!=0){i-=1;let next=switch(expression(source,imported,graph,locals,expressions,*v::at<usize>(ref order,i),depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};outcomes=(outcomes&14)|next;}return .ok(outcomes);
}
pub fn Result<usize,m::Problem> expression(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,usize id,usize depth,ref mut v::Vec<usize> active,ref mut v::Vec<r::Loop> loops,ref mut v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut v::Vec<r::Exit> exits,ref mut r::Context c){
    if(id==0){return .ok(1);}let e=syntax::expression_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(r::fail(c,10,e.start,e.end));}if(e.kind==1 || e.kind==2 || e.kind==16 || e.kind==17 || e.kind==28 || e.kind==32 || e.kind==33){return .ok(1);}if(e.kind==12 || e.kind==31){return block(source,imported,graph,locals,expressions,e.left,depth+1,active,loops,regions,placements,exits,c);}let left=switch(expression(source,imported,graph,locals,expressions,e.left,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((left&1)==0){return .ok(left);}
    if(e.kind==13){let branches=syntax::expression_at(source,e.right);if(branches.kind!=14){return .err(r::fail(c,12,e.start,e.end));}let yes=switch(block(source,imported,graph,locals,expressions,branches.left,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};let no=switch(expression(source,imported,graph,locals,expressions,branches.right,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};return .ok((left&14)|yes|no);}
    if(e.kind==15){var v::Vec<usize> arms=v::empty<usize>();var usize link=e.right;while(link!=0){let row=syntax::expression_at(source,link);if(row.kind!=19 || !m::charge(ref mut c.work,1) || v::len<usize>(ref arms)>=1024){return .err(r::fail(c,if(row.kind!=19){12}else{10},row.start,row.end));}if(!v::push<usize>(ref mut arms,row.left).is_ok){return .err(r::fail(c,11,row.start,row.end));}link=row.right;}var usize outcomes=0;var usize i=v::len<usize>(ref arms);while(i>0){i-=1;let arm=syntax::expression_at(source,*v::at<usize>(ref arms,i));let next=switch(block(source,imported,graph,locals,expressions,arm.right,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};outcomes|=next;}return .ok((left&14)|outcomes);}
    if(e.kind==30){switch(r::resets(3,0,0,e.start,e.end,active,exits,c)){case .ok(_):{}case .err(p):{return .err(p);}};return .ok(left|2);}if(e.kind==3 || e.kind==4 || e.kind==8 || e.kind==20 || e.kind==21 || e.kind==22 || e.kind==23){return .ok(left);}let right=switch(if(e.kind==6 || e.kind==10 || e.kind==24){list(source,imported,graph,locals,expressions,e.right,if(e.kind==6){7}else if(e.kind==10){11}else{25},depth+1,active,loops,regions,placements,exits,c)}else{expression(source,imported,graph,locals,expressions,e.right,depth+1,active,loops,regions,placements,exits,c)}){case .ok(n):{n}case .err(p):{return .err(p);}};
    if(e.kind==6 && (right&1)!=0){let actual=switch(events::typed(expressions,id,c)){case .ok(e):{e}case .err(p):{return .err(p);}};if(actual.builtin.kind==300){let p=events::placement(source,imported,graph,locals,expressions,actual,active,regions,placements,c);if(p.code!=0){return .err(p);}}}let op=syntax::expression_text(source,id);let skipped=e.kind==5 && (bytes::equal(op,b"&&") || bytes::equal(op,b"||"));return .ok((left&14)|right|if(skipped){1}else{0});
}
pub fn Result<usize,m::Problem> statement(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,usize id,usize depth,ref mut v::Vec<usize> active,ref mut v::Vec<r::Loop> loops,ref mut v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut v::Vec<r::Exit> exits,ref mut r::Context c){
    if(id==0){return .ok(1);}let s=syntax::statement_at(source,id);if(depth>=64 || !m::charge(ref mut c.work,1)){return .err(r::fail(c,10,s.start,s.end));}if(s.kind==17){return events::enter(source,imported,graph,locals,expressions,s,id,depth,active,loops,regions,placements,exits,c);}if(s.kind==9 || s.kind==10){if(v::len<r::Loop>(loops)==0){return .err(r::fail(c,12,s.start,s.end));}let loop=*v::at<r::Loop>(loops,v::len<r::Loop>(loops)-1);switch(r::resets(if(s.kind==9){4}else{5},loop.region_depth,loop.statement,s.start,s.end,active,exits,c)){case .ok(_):{}case .err(p):{return .err(p);}};return .ok(if(s.kind==9){4}else{8});}
    if(s.kind==8 || s.kind==14 || s.kind==18){var usize prior=0;var usize post=0;if(s.kind==14){let h=syntax::statement_at(source,s.second);let initial=switch(statement(source,imported,graph,locals,expressions,h.first,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((initial&1)==0){return .ok(initial);}prior=initial&14;post=h.second;}let condition=switch(expression(source,imported,graph,locals,expressions,s.expression,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((condition&1)==0){return .ok(prior|condition);}if(v::len<r::Loop>(loops)>=64 || !v::push<r::Loop>(loops,r::Loop{.statement=id,.region_depth=v::len<usize>(active)}).is_ok){return .err(r::fail(c,if(v::len<r::Loop>(loops)>=64){10}else{11},s.start,s.end));}let body=switch(block(source,imported,graph,locals,expressions,s.first,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};var usize after=0;if(post!=0 && (body&9)!=0){after=switch(statement(source,imported,graph,locals,expressions,post,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};}discard v::pop<r::Loop>(loops);return .ok(prior|(condition&2)|(body&2)|(after&2)|1);}
    let target=switch(expression(source,imported,graph,locals,expressions,if(s.kind==4){s.target}else{0},depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((target&1)==0){return .ok(target);}let value=switch(expression(source,imported,graph,locals,expressions,s.expression,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};if((value&1)==0){return .ok((target&14)|value);}if(s.kind==3){var usize start=s.start;var usize end=s.end;if(s.expression!=0){let e=syntax::expression_at(source,s.expression);start=e.start;end=e.end;}switch(r::resets(2,0,0,start,end,active,exits,c)){case .ok(_):{}case .err(p):{return .err(p);}};return .ok((target&14)|(value&14)|2);}if(s.kind==11 && bytes::equal(syntax::expression_text(source,s.expression),b"false")){return .ok((target&14)|(value&14)|2);}return .ok((target&14)|value);
}
pub fn Result<usize,m::Problem> block(ref syntax::Parsed source,ref interfaces::Interfaces imported,ref v::Vec<types::Type> graph,ref v::Vec<m::Local> locals,ref v::Vec<m::Expression> expressions,usize id,usize depth,ref mut v::Vec<usize> active,ref mut v::Vec<r::Loop> loops,ref mut v::Vec<r::Scope> regions,ref mut v::Vec<r::Placement> placements,ref mut v::Vec<r::Exit> exits,ref mut r::Context c){
    let b=syntax::statement_at(source,id);if(b.kind!=1 || depth>=64 || !m::charge(ref mut c.work,1)){return .err(r::fail(c,if(b.kind!=1){12}else{10},b.start,b.end));}var v::Vec<usize> order=v::empty<usize>();var usize link=b.first;while(link!=0){let row=syntax::statement_at(source,link);if(row.kind!=7 || !m::charge(ref mut c.work,1) || v::len<usize>(ref order)>=8192){return .err(r::fail(c,if(row.kind!=7){12}else{10},row.start,row.end));}if(!v::push<usize>(ref mut order,row.first).is_ok){return .err(r::fail(c,11,row.start,row.end));}link=row.second;}if(v::len<usize>(ref order)!=b.second){return .err(r::fail(c,12,b.start,b.end));}var usize outcomes=1;var usize i=v::len<usize>(ref order);while(i>0 && (outcomes&1)!=0){i-=1;let next=switch(statement(source,imported,graph,locals,expressions,*v::at<usize>(ref order,i),depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};outcomes=(outcomes&14)|next;}if((outcomes&1)!=0){let tail=switch(expression(source,imported,graph,locals,expressions,b.expression,depth+1,active,loops,regions,placements,exits,c)){case .ok(n):{n}case .err(p):{return .err(p);}};outcomes=(outcomes&14)|tail;}return .ok(outcomes);
}
