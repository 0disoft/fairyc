module generic_concrete_types;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import generic_package_context as context;
import generic_specialization_identity as specialization;
import generic_identity as identity;
import module_public_interface_model as model;
import module_public_interface_write as write;
import module_types as types;
import project_path as project;
import project_manifest_values as lexical;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;

// Planner properties are separate from value typing, layout and resource Flow.
// All thirteen Go scalar descriptors are retained; typed selection admits only
// the candidate's six existing scalar kinds. Nominal abilities remain empty.
pub struct Row{model::Text id;model::Text owner;model::Text definition;model::Text name;usize module_index;usize declaration;u32 kind;u32 scalar;bool public;}
struct Module{model::Text path;model::Text owner;}
struct Import{usize source;usize target;model::Text alias;}
pub resource Catalog{bytes::Buffer names;v::Vec<Row> rows;v::Vec<Module> modules;v::Vec<Import> imports;model::Text closed;cleanup{}}
pub fn usize count(ref Catalog p){return v::len<Row>(ref p.rows);}
pub fn Row at(ref Catalog p,usize i){assert(i<count(p));return *v::at<Row>(ref p.rows,i);}
pub fn ref u8[] text(ref Catalog p,model::Text t){assert(t.start<=t.end && t.end<=bytes::len(ref p.names));return bytes::view(ref p.names)[t.start..t.end];}
pub fn ref u8[] closed_digest(ref Catalog p){return text(p,p.closed);}
pub fn usize ability_count(ref Catalog p,usize i){return if(at(p,i).kind==1){5}else{0};}
pub fn ref u8[] ability_at(ref Catalog p,usize i,usize n){assert(n<ability_count(p,i));if(n==0){return b"copy";}if(n==1){return b"drop";}if(n==2){return b"inert";}if(n==3){return b"scalar";}return b"store";}
fn u32 fail(ref mut context::Budget b,u32 code){if(b.code==0){b.code=code;}return b.code;}
fn bool charge(ref mut context::Budget b,usize cost){if(b.code!=0){return false;}return if(project::charge(ref mut b.work,cost)){true}else{discard fail(b,10);false};}
fn Result<model::Text,u32> retain(ref mut bytes::Buffer names,ref u8[] value,ref mut context::Budget b){if(value.len>1048576 || bytes::len(names)>1048576-value.len || !charge(b,value.len+1)){return .err(fail(b,10));}let start=bytes::len(names);if(!bytes::append(names,value).is_ok){return .err(fail(b,11));}return .ok(model::Text{.start,.end=bytes::len(names)});}
fn bool letter(u8 c){return c==95 || c>=65 && c<=90 || c>=97 && c<=122;}
fn bool path(ref u8[] value){if(value.len==0 || value.len>512){return false;}var usize i=0;var usize segment=0;while(i<value.len){let c=value[i];if(c==58){if(segment==0 || i+1>=value.len || value[i+1]!=58){return false;}segment=0;i+=2;continue;}if(segment==0 && !letter(c) || segment!=0 && !(letter(c) || c>=48 && c<=57)){return false;}segment+=1;if(segment>128){return false;}i+=1;}return segment!=0;}
fn ref u8[] scalar_name(usize i){if(i==0){return b"bool";}if(i==1){return b"i8";}if(i==2){return b"i16";}if(i==3){return b"i32";}if(i==4){return b"i64";}if(i==5){return b"isize";}if(i==6){return b"u8";}if(i==7){return b"u16";}if(i==8){return b"u32";}if(i==9){return b"u64";}if(i==10){return b"usize";}if(i==11){return b"f32";}return b"f64";}
fn u32 scalar_kind(usize i){return if(i==0){6}else if(i==3){1}else if(i==4){2}else if(i==6){3}else if(i==8){4}else if(i==10){5}else{0};}
fn Result<i32,u32> compare(ref bytes::Buffer names,Row a,Row z,ref mut context::Budget b){let data=bytes::view(names);let left=data[a.id.start..a.id.end];let right=data[z.id.start..z.id.end];if(!charge(b,left.len+right.len+1)){return .err(b.code);}return .ok(if(bytes::equal(left,right)){0}else if(lexical::before(left,right)){-1}else{1});}
fn void swap(ref mut v::Vec<Row> rows,usize a,usize z){let left=*v::at<Row>(rows,a);let right=*v::at<Row>(rows,z);{let slot=v::at_mut<Row>(rows,a);*slot=right;}{let slot=v::at_mut<Row>(rows,z);*slot=left;}}
fn u32 sift(ref bytes::Buffer names,ref mut v::Vec<Row> rows,usize root,usize count,ref mut context::Budget b){var usize at=root;while(at<count/2){var usize child=at*2+1;if(child+1<count){let order=switch(compare(names,*v::at<Row>(rows,child),*v::at<Row>(rows,child+1),b)){case .ok(n):{n}case .err(code):{return code;}};if(order<0){child+=1;}}let order=switch(compare(names,*v::at<Row>(rows,at),*v::at<Row>(rows,child),b)){case .ok(n):{n}case .err(code):{return code;}};if(order>=0){return 0;}swap(rows,at,child);at=child;}return 0;}
fn u32 sort(ref bytes::Buffer names,ref mut v::Vec<Row> rows,ref mut context::Budget b){let count=v::len<Row>(rows);var usize i=count/2;while(i>0){i-=1;let code=sift(names,rows,i,count,b);if(code!=0){return code;}}i=count;while(i>1){i-=1;swap(rows,0,i);let code=sift(names,rows,0,i,b);if(code!=0){return code;}}i=1;while(i<count){let order=switch(compare(names,*v::at<Row>(rows,i-1),*v::at<Row>(rows,i),b)){case .ok(n):{n}case .err(code):{return code;}};if(order>=0){return fail(b,9);}i+=1;}return 0;}
pub fn Result<Catalog,u32> build(ref templates::Catalog source,ref v::Vec<syntax::Parsed> sources,ref mut context::Budget b){
    let packages=templates::packages(source);let closed=switch(context::compute(sources,packages,b)){case .ok(value):{value}case .err(code):{return .err(code);}};
    var bytes::Buffer names=bytes::empty();var v::Vec<Row> rows=v::empty<Row>();var v::Vec<Module> modules=v::empty<Module>();var v::Vec<Import> imports=v::empty<Import>();let saved_closed=switch(retain(ref mut names,context::digest(ref closed),b)){case .ok(value):{value}case .err(code):{return .err(code);}};
    let builtin=switch(retain(ref mut names,b"builtin",b)){case .ok(value):{value}case .err(code):{return .err(code);}};var usize i=0;
    while(i<13){if(!charge(b,1)){return .err(b.code);}let name=scalar_name(i);var usize measured=0;let digest=switch(identity::digest_text(b"source-scalar-v0",name,ref mut measured)){case .ok(value):{value}case .err(code):{discard charge(b,measured);return .err(fail(b,code));}};if(!charge(b,measured)){return .err(b.code);}let id=switch(retain(ref mut names,name,b)){case .ok(value):{value}case .err(code):{return .err(code);}};let definition=switch(retain(ref mut names,bytes::view(ref digest),b)){case .ok(value):{value}case .err(code):{return .err(code);}};if(!v::push<Row>(ref mut rows,Row{.id,.owner=builtin,.definition,.name=id,.module_index=0,.declaration=0,.kind=1,.scalar=scalar_kind(i),.public=true}).is_ok){return .err(fail(b,11));}i+=1;}
    var usize module_index=0;while(module_index<v::len<syntax::Parsed>(sources)){if(!charge(b,1)){return .err(b.code);}let p=v::at<syntax::Parsed>(sources,module_index);let m=bindings::module_at(packages,module_index);let owner=switch(retain(ref mut names,bindings::text(packages,m.namespace),b)){case .ok(value):{value}case .err(code):{return .err(code);}};let module_path=switch(retain(ref mut names,bindings::text(packages,m.path),b)){case .ok(value):{value}case .err(code):{return .err(code);}};if(!v::push<Module>(ref mut modules,Module{.path=module_path,.owner}).is_ok){return .err(fail(b,11));}i=1;
        while(i<syntax::declaration_count(p)){if(!charge(b,1)){return .err(b.code);}let d=syntax::declaration_at(p,i);if((d.kind==4 || d.kind==6) && d.generic_parameters==0){if(v::len<Row>(ref rows)>=4096){return .err(fail(b,10));}let raw_name=syntax::source_view(p)[d.name_start..d.name_end];var bytes::Buffer key=bytes::empty();if(!bytes::append(ref mut key,b"source_nominal_v0::").is_ok || !bytes::append(ref mut key,bindings::text(packages,m.namespace)).is_ok || !bytes::append(ref mut key,b"::").is_ok || !bytes::append(ref mut key,bindings::text(packages,m.path)).is_ok || !bytes::append(ref mut key,b"::").is_ok || !bytes::append(ref mut key,raw_name).is_ok){return .err(fail(b,11));}if(!charge(b,bytes::len(ref key)+1)){return .err(b.code);}if(!path(bytes::view(ref key))){return .err(fail(b,9));}let digest=switch(context::definition(ref closed,module_index,p,i,b)){case .ok(value):{value}case .err(code):{return .err(code);}};let id=switch(retain(ref mut names,bytes::view(ref key),b)){case .ok(value):{value}case .err(code):{return .err(code);}};let name=switch(retain(ref mut names,raw_name,b)){case .ok(value):{value}case .err(code):{return .err(code);}};let definition=switch(retain(ref mut names,bytes::view(ref digest),b)){case .ok(value):{value}case .err(code):{return .err(code);}};if(!v::push<Row>(ref mut rows,Row{.id,.owner,.definition,.name,.module_index,.declaration=i+1,.kind=if(d.kind==4){2}else{3},.scalar=0,.public=d.public}).is_ok){return .err(fail(b,11));}}i+=1;
        }module_index+=1;
    }i=0;while(i<bindings::import_count(packages)){if(!charge(b,1)){return .err(b.code);}let row=bindings::import_at(packages,i);let alias=switch(retain(ref mut names,bindings::text(packages,row.alias),b)){case .ok(value):{value}case .err(code):{return .err(code);}};if(!v::push<Import>(ref mut imports,Import{.source=row.module_index,.target=row.target,.alias}).is_ok){return .err(fail(b,11));}i+=1;}let sorted=sort(ref names,ref mut rows,b);if(sorted!=0){return .err(sorted);}return .ok(Catalog{.names,.rows,.modules,.imports,.closed=saved_closed});
}
// Lookup results are one-based, like retained specialization and cleanup IDs.
pub fn Result<usize,u32> lookup_id(ref Catalog p,ref u8[] id,ref mut usize work){if(!project::charge(work,id.len+1)){return .err(10);}if(!path(id)){return .err(9);}var usize low=0;var usize high=count(p);while(low<high){let mid=low+(high-low)/2;let name=text(p,at(p,mid).id);if(!project::charge(work,name.len+id.len+1)){return .err(10);}if(lexical::before(name,id)){low=mid+1;}else{high=mid;}}if(low<count(p)){let name=text(p,at(p,low).id);if(!project::charge(work,name.len+id.len+1)){return .err(10);}if(bytes::equal(name,id)){return .ok(low+1);}}return .err(9);}
pub fn Result<usize,u32> lookup_source(ref Catalog p,usize caller,ref u8[] spelling,ref mut usize work){if(caller>=v::len<Module>(ref p.modules) || !path(spelling)){return .err(9);}if(!project::charge(work,spelling.len+1)){return .err(10);}var usize split=spelling.len;var usize i=0;while(i<spelling.len){if(spelling[i]==58){if(split!=spelling.len){return .err(9);}split=i;i+=1;}i+=1;}var usize target=caller;var usize start=0;
    if(split<spelling.len){var bool found=false;i=0;while(i<v::len<Import>(ref p.imports)){let row=*v::at<Import>(ref p.imports,i);if(!project::charge(work,spelling.len+1)){return .err(10);}if(row.source==caller && bytes::equal(text(p,row.alias),spelling[..split])){target=row.target;found=true;break;}i+=1;}if(!found){return .err(9);}start=split+2;}
    i=0;while(i<count(p)){let row=at(p,i);if(!project::charge(work,spelling.len+1)){return .err(10);}if((row.kind==1 && split==spelling.len || row.kind!=1 && row.module_index==target) && bytes::equal(text(p,row.name),spelling[start..])){if(target!=caller && !row.public){return .err(13);}return .ok(i+1);}i+=1;}return .err(9);
}
pub fn Result<usize,u32> lookup_typed(ref Catalog p,types::Type t,ref mut usize work){if(t.kind==1){if(t.scalar==0 || t.scalar>6 || t.module_index!=0 || t.declaration!=0 || t.first!=0 || t.second!=0){return .err(9);}return lookup_id(p,if(t.scalar==1){b"i32"}else if(t.scalar==2){b"i64"}else if(t.scalar==3){b"u8"}else if(t.scalar==4){b"u32"}else if(t.scalar==5){b"usize"}else{b"bool"},work);}if(t.kind!=2 && t.kind!=3){return .err(4503);}if(t.scalar!=0 || t.first!=0 || t.second!=0 || t.module_index>=v::len<Module>(ref p.modules) || t.declaration==0){return .err(9);}var usize i=0;while(i<count(p)){if(!project::charge(work,1)){return .err(10);}let row=at(p,i);if(row.kind==t.kind && row.module_index==t.module_index && row.declaration==t.declaration){return .ok(i+1);}i+=1;}return .err(9);}
fn Result<model::Text,u32> append_text(ref mut bytes::Buffer names,ref u8[] value,ref mut usize work){let start=bytes::len(names);let code=write::raw(names,value,work);return if(code!=0){.err(code)}else{.ok(model::Text{.start,.end=bytes::len(names)})};}
pub fn u32 append_argument(ref Catalog p,usize selected,ref mut bytes::Buffer names,ref mut v::Vec<specialization::Concrete> arguments,ref mut v::Vec<model::Text> abilities,ref mut usize work){if(selected==0 || selected>count(p) || v::len<specialization::Concrete>(arguments)>=8 || v::len<model::Text>(abilities)>56-ability_count(p,selected-1)){return 9;}let row=at(p,selected-1);let id=switch(append_text(names,text(p,row.id),work)){case .ok(value):{value}case .err(code):{return code;}};let owner=switch(append_text(names,text(p,row.owner),work)){case .ok(value):{value}case .err(code):{return code;}};let definition=switch(append_text(names,text(p,row.definition),work)){case .ok(value):{value}case .err(code):{return code;}};let first=v::len<model::Text>(abilities);let count=ability_count(p,selected-1);var usize i=0;while(i<count){let name=switch(append_text(names,ability_at(p,selected-1,i),work)){case .ok(value):{value}case .err(code):{return code;}};if(!v::push<model::Text>(abilities,name).is_ok){return 11;}i+=1;}return if(v::push<specialization::Concrete>(arguments,specialization::Concrete{.id,.owner,.definition,.abilities=model::Range{.first,.count}}).is_ok){0}else{11};}
