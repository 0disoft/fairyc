module module_source_artifact_encode;
import module_source_artifact_model as model;
import generic_package_bindings as bindings;
import candidate_artifact_wire as wire;
import project_cache_encoding as budget;
pub fn Result<wire::Payload,u32> encode(ref model::Snapshot p,ref mut usize work){let checked=model::check(p,work);if(checked!=0){return .err(checked);}var wire::Status status=wire::Status{.code=0};var out=wire::writer(b"FYPROV00",ref mut status,work);wire::number(ref mut out,model::count(p),ref mut status,work);var usize i=0;
    while(i<model::count(p)){let m=model::module_at(p,i);wire::number(ref mut out,m.owner,ref mut status,work);wire::number(ref mut out,m.namespace.start,ref mut status,work);wire::number(ref mut out,m.namespace.end,ref mut status,work);wire::number(ref mut out,m.path.start,ref mut status,work);wire::number(ref mut out,m.path.end,ref mut status,work);wire::number(ref mut out,m.first,ref mut status,work);wire::number(ref mut out,m.count,ref mut status,work);wire::number(ref mut out,m.source_size,ref mut status,work);var usize j=0;while(j<8){wire::number(ref mut out,m.digest[j] as usize,ref mut status,work);j+=1;}if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,model::import_count(p),ref mut status,work);i=0;while(i<model::import_count(p)){let row=model::import_at(p,i);wire::number(ref mut out,row.module_index,ref mut status,work);wire::number(ref mut out,row.declaration,ref mut status,work);wire::number(ref mut out,row.target,ref mut status,work);wire::number(ref mut out,row.alias.start,ref mut status,work);wire::number(ref mut out,row.alias.end,ref mut status,work);wire::number(ref mut out,row.binding.start,ref mut status,work);wire::number(ref mut out,row.binding.end,ref mut status,work);if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}i+=1;}
    wire::number(ref mut out,model::names(p).len,ref mut status,work);if(wire::output_status(ref status)!=0){return .err(wire::output_status(ref status));}let code=budget::raw(ref mut out,model::names(p),work);if(code!=0){return .err(if(code==4){1003}else{1002});}return wire::finish(out,status);
}
pub fn Result<wire::Payload,u32> provenance(ref bindings::Bindings p,ref mut usize work){let snapshot=switch(model::extract(p,work)){case .ok(p):{p}case .err(code):{return .err(code);}};return encode(ref snapshot,work);}
