module array_provider;
pub struct Token {i32 n;}
pub enum Kind {Off;On;}
pub fn i32[20] copy(i32[20] input){return input;}
pub fn usize[1153] large(usize[1153] input){return input;}
pub fn Token[2] tokens(Token[2] input){return input;}
pub fn i32[3][4] matrix(i32[3][4] input){return input;}
pub fn Kind[2] kinds(Kind[2] input){return input;}
pub fn Option<i32>[2] options(Option<i32>[2] input){return input;}
