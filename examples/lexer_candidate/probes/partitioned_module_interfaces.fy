import file_source as files;
import scanner as scanner;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
import std::process as process;

@effects(console)
fn void number(ref str key,usize value){discard io::write(key);discard io::write_usize(value);}
@effects(filesystem,console)
fn i32 main(){
    var bytes::Buffer arg=bytes::empty();assert(bytes::resize_zeroed(ref mut arg,4096).is_ok);
    let usize n=switch(process::arg(1,bytes::view_mut(ref mut arg))){case .ok(n):{n}case .err(_):{return 2;}};
    let manifest=switch(files::manifest(bytes::view(ref arg)[..n])){case .ok(b):{b}case .err(_):{return 2;}};
    let source=bytes::view(ref manifest);var v::Vec<cli::Path> paths=v::empty<cli::Path>();assert(cli::paths(source,ref mut paths)==0);
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var usize i=0;
    while(i<v::len<cli::Path>(ref paths)){let path=*v::at<cli::Path>(ref paths,i);
        let input=switch(files::load(source[path.start..path.end])){case .ok(b):{b}case .err(_):{return 2;}};
        let stream=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{return 2;}};assert(scanner::diagnostic_count(ref stream)==0);
        let p=switch(syntax::parse(stream,512)){case .ok(p):{p}case .err(_):{return 2;}};assert(syntax::problem_count(ref p)==0);assert(v::push<syntax::Parsed>(ref mut sources,p).is_ok);i+=1;
    }
    let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{return 2;}};
    switch(compact::compact_in_place(ref mut sources,ref metadata)){case .ok(_):{}case .err(_):{return 2;}};
    let bound_metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{return 2;}};
    let plan=switch(units::build(ref sources,ref bound_metadata)){case .ok(p):{p}case .err(p):{number("planError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};
    number("files=",units::file_count(ref plan));number(" joinedBytes=",units::source_bytes(ref plan));number(" units=",units::count(ref plan));discard io::write("\n");
    number("admissionAttempts=",units::attempts(ref plan));number(" rangeSplits=",units::splits(ref plan));number(" planningWork=",units::work(ref plan));number(" maxAdmissionBindingWork=",units::binding_work(ref plan));number(" maxAdmissionInterfaceWork=",units::interface_work(ref plan));number(" maxAdmissionBodyWork=",units::body_work(ref plan));number(" maxAdmissionDropWork=",units::drop_work(ref plan));number(" maxAdmissionNameWork=",units::name_work(ref plan));discard io::write("\n");
    var usize modules=0;var usize expressions=0;var usize entries=0;var usize joined_bytes=0;var usize targets=0;var usize max_work=0;i=0;
    while(i<units::count(ref plan)){let unit=units::at(ref plan,i);let bound=switch(binding::bind(ref sources,ref bound_metadata,unit.first,unit.stop)){case .ok(p):{p}case .err(p):{number("bindError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};let ref syntax::Parsed p=binding::parsed(ref bound);
        assert(syntax::module_count(p)==unit.stop-unit.first && syntax::source_view(p).len==unit.usage.bytes && syntax::declaration_count(p)==unit.usage.declarations && syntax::expression_count(p)==unit.usage.expressions && syntax::statement_count(p)==unit.usage.statements && syntax::entry_count(p)==unit.usage.entries && syntax::type_count(p)==unit.usage.types && syntax::field_count(p)==unit.usage.fields && syntax::attribute_count(p)==unit.usage.attributes && syntax::attribute_argument_count(p)==unit.usage.arguments);
        let imported=switch(interfaces::build(ref sources,ref bound_metadata,ref bound)){case .ok(p):{p}case .err(p):{number("interfaceError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};
        var usize function_demands=0;var usize cleanup_demands=0;var usize constructors=0;var usize demand_id=0;while(demand_id<interfaces::body_type_count(ref imported)){let demand=interfaces::body_type_at(ref imported,demand_id);assert(demand.type>0 && demand.type<=interfaces::type_count(ref imported));let original=v::at<syntax::Parsed>(ref sources,demand.module_index);if(demand.context_kind==1){function_demands+=1;let c=generics::at(interfaces::specializations(ref imported),demand.context);assert(c.module_index==demand.module_index && c.declaration==demand.declaration);}else{cleanup_demands+=1;let c=generics::cleanup_at(interfaces::specializations(ref imported),demand.context);assert(demand.context_kind==2 && c.module_index==demand.module_index && c.declaration==demand.declaration && demand.start>=c.start && demand.end<=c.end);}if(demand.kind==1){let n=syntax::type_at(original,demand.source_index);assert(n.start==demand.start && n.end==demand.end);}else{constructors+=1;let n=syntax::expression_at(original,demand.source_index);assert(demand.kind==2 && n.kind==10 && n.start==demand.start && n.end==demand.end);}demand_id+=1;}number("bodyTypeDemands=",interfaces::body_type_count(ref imported));number(" functionTypeDemands=",function_demands);number(" cleanupTypeDemands=",cleanup_demands);number(" constructorDemands=",constructors);discard io::write("\n");
        let drop_plan=switch(drops::build(ref imported)){case .ok(p):{p}case .err(p):{number("dropError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};var usize drop_types=0;var usize effect_types=0;var usize denied_types=0;var usize drop_id=1;while(drop_id<=drops::count(ref drop_plan)){let node=drops::at(ref drop_plan,drop_id);if(node.complete){if(node.needed){drop_types+=1;}if(node.effects!=0){effect_types+=1;}if(!node.droppable){denied_types+=1;}}drop_id+=1;}number("dropNodes=",drops::count(ref drop_plan));number(" dropEdges=",drops::edge_count(ref drop_plan));number(" dropTypes=",drop_types);number(" effectDropTypes=",effect_types);number(" deniedDropTypes=",denied_types);number(" dropWork=",drops::work(ref drop_plan));discard io::write("\n");
        let owned=switch(bodies::build(ref sources,ref bound_metadata,ref imported)){case .ok(p):{p}case .err(p):{number("bodyError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};assert(bodies::fits(ref owned,unit.usage) && bodies::count(ref owned)==generics::count(interfaces::specializations(ref imported)) && bodies::type_count(ref owned)==interfaces::type_count(ref imported));let body_usage=bodies::usage(ref owned);
        let resolved=switch(names::build(ref sources,ref bound_metadata,ref imported,ref owned)){case .ok(p):{p}case .err(p):{number("nameError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};assert(names::function_count(ref resolved)==bodies::count(ref owned) && names::cleanup_count(ref resolved)==bodies::cleanup_count(ref owned));var u32 name_kind=1;while(name_kind<=2){var usize id=1;let usize count=if(name_kind==1){names::function_count(ref resolved)}else{names::cleanup_count(ref resolved)};while(id<=count){let r=if(name_kind==1){names::function_at(ref resolved,id)}else{names::cleanup_at(ref resolved,id)};let a=if(name_kind==1){bodies::body_ast(bodies::at(ref owned,id))}else{bodies::cleanup_ast(bodies::cleanup_at(ref owned,id))};let stream=if(name_kind==1){bodies::source_at(ref owned,id)}else{bodies::cleanup_source_at(ref owned,id)};assert(names::use_count(r)==body_ast::expression_count(a));var usize ref_id=1;while(ref_id<=names::references(r)){let reference=names::reference_at(r,ref_id);assert(reference.expression>0 && reference.expression<=body_ast::expression_count(a) && body_ast::expression_at(a,reference.expression).kind==2 && reference.source_index==body_ast::expression_origin(a,reference.expression) && names::use_at(r,reference.expression)==ref_id && reference.end<=scanner::source_view(stream).len);if(reference.kind==1){assert(reference.symbol>0 && reference.symbol<=names::local_count(r));}else{assert(reference.kind==2 || reference.kind==3);}ref_id+=1;}id+=1;}name_kind+=1;}number("nameFunctions=",names::function_count(ref resolved));number(" nameCleanups=",names::cleanup_count(ref resolved));number(" nameSymbols=",names::symbol_count(ref resolved));number(" nameReferences=",names::reference_count(ref resolved));number(" nameWork=",names::work(ref resolved));discard io::write("\n");
        let original_names=switch(ordinary::build(ref sources,ref bound_metadata,ref bound,ref imported)){case .ok(p):{p}case .err(p):{number("ordinaryNameError=",p.code as usize);number(" module=",p.module_index);number(" start=",p.start);number(" end=",p.end);discard io::write("\n");return 2;}};var usize ordinary_id=1;while(ordinary_id<=ordinary::count(ref original_names)){let f=ordinary::at(ref original_names,ordinary_id);let r=ordinary::resolved(f);let original=v::at<syntax::Parsed>(ref sources,ordinary::module_index(f));let d=syntax::declaration_at(original,ordinary::declaration(f)-1);assert(d.kind==3 && d.generic_parameters==0 && d.body!=0);var usize j=1;while(j<=names::references(r)){let use=names::reference_at(r,j);let node=syntax::expression_at(original,use.source_index);assert(use.source_index==ordinary::expression_origin(f,use.expression) && node.kind==2 && node.start==use.start && node.end==use.end && names::use_at(r,use.expression)==j);j+=1;}j=1;while(j<=names::local_count(r)){let symbol=names::symbol_at(r,j);if(symbol.entry!=0){let e=syntax::entry_at(original,ordinary::entry_origin(f,symbol.entry)-1);assert(e.name_start==symbol.start && e.name_end==symbol.end);}j+=1;}ordinary_id+=1;}number("ordinaryFunctions=",ordinary::count(ref original_names));number(" ordinarySymbols=",ordinary::symbols(ref original_names));number(" ordinaryReferences=",ordinary::references(ref original_names));number(" ordinaryNameWork=",ordinary::work(ref original_names));discard io::write("\n");
        var usize body_edges=0;var usize body_roots=0;var usize body_id=1;while(body_id<=bodies::count(ref owned)){let b=bodies::at(ref owned,body_id);let a=bodies::body_ast(b);let stream=bodies::source_at(ref owned,body_id);assert(body_ast::declaration(a).generic_parameters==0);var usize n=1;while(n<=body_ast::expression_count(a)){let e=body_ast::expression_at(a,n);assert(e.token<scanner::token_count(stream) && e.end<=scanner::source_view(stream).len);n+=1;}n=1;while(n<=body_ast::type_count(a)){let usize t=bodies::annotation_at(b,n);if(t!=0){assert(t<=bodies::type_count(ref owned));body_roots+=1;}n+=1;}body_edges+=bodies::edge_count(b);body_id+=1;}
        assert(bodies::cleanup_count(ref owned)==generics::cleanup_count(interfaces::specializations(ref imported)));var usize cleanup_roots=0;var usize cleanup_edges=0;body_id=1;while(body_id<=bodies::cleanup_count(ref owned)){let c=bodies::cleanup_at(ref owned,body_id);let info=bodies::cleanup_info(c);let a=bodies::cleanup_ast(c);let stream=bodies::cleanup_source_at(ref owned,body_id);assert(info.receiver_kind==10 && body_ast::declaration(a).cleanup_body>0 && body_ast::declaration(a).generic_parameters==0 && (bodies::type_at(ref owned,info.type).kind==3 || bodies::type_at(ref owned,info.type).kind==13));var usize n=1;while(n<=body_ast::expression_count(a)){let e=body_ast::expression_at(a,n);assert(e.token<scanner::token_count(stream) && e.start>=info.start && e.end<=info.end);n+=1;}n=1;while(n<=body_ast::type_count(a)){let usize t=bodies::cleanup_annotation_at(c,n);if(t!=0){assert(t<=bodies::type_count(ref owned));cleanup_roots+=1;}n+=1;}cleanup_edges+=bodies::cleanup_edge_count(c);body_id+=1;}
        number("ownedCleanups=",bodies::cleanup_count(ref owned));number(" cleanupAnnotations=",cleanup_roots);number(" cleanupEdges=",cleanup_edges);discard io::write("\n");
        number("ownedBodies=",bodies::count(ref owned));number(" bodySources=",bodies::source_count(ref owned));number(" bodyBytes=",body_usage.bytes);number(" bodyExpressions=",body_usage.expressions);number(" bodyStatements=",body_usage.statements);number(" bodyEntries=",body_usage.entries);number(" bodyTypes=",body_usage.types);number(" bodyAnnotations=",body_roots);number(" bodyEdges=",body_edges);number(" bodyCooked=",bodies::cooked_bytes(ref owned));number(" bodyGraph=",bodies::type_count(ref owned));number(" bodyWork=",bodies::work(ref owned));discard io::write("\n");
        assert(interfaces::annotation_count(ref imported)==syntax::type_count(p));var usize typed_roots=0;var usize deferred_roots=0;var usize root=1;
        while(root<=interfaces::annotation_count(ref imported)){let a=interfaces::annotation_at(ref imported,root);if(a.required){if(a.deferred){assert(a.type==0);deferred_roots+=1;}else{assert(a.type>0 && a.type<=interfaces::type_count(ref imported));typed_roots+=1;}}else{assert(a.type==0 && !a.deferred);}root+=1;}
        number("typedAnnotations=",typed_roots);number(" deferredAnnotations=",deferred_roots);discard io::write("\n");
        let specialized=interfaces::specializations(ref imported);assert(generics::count(specialized)<=64 && generics::call_count(specialized)==syntax::expression_count(p));var usize concrete_calls=0;var usize deferred_calls=0;var usize intrinsic_calls=0;root=1;
        var v::Vec<types::Type> retained_graph=v::empty<types::Type>();while(root<=interfaces::type_count(ref imported)){assert(v::push<types::Type>(ref mut retained_graph,interfaces::type_at(ref imported,root)).is_ok);root+=1;}assert(generics::validate(specialized,ref sources,ref bound_metadata,ref retained_graph).code==0);root=1;
        while(root<=generics::call_count(specialized)){let c=generics::call_at(specialized,root);if(c.instance!=0){assert(c.instance<=generics::count(specialized) && !c.deferred && c.intrinsic==0);concrete_calls+=1;}else if(c.deferred){deferred_calls+=1;}else if(c.intrinsic!=0){intrinsic_calls+=1;}root+=1;}
        root=1;while(root<=generics::count(specialized)){let s=generics::at(specialized,root);let original=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,s.module_index),s.declaration-1);assert(original.generic_parameters!=0 && original.kind==3 && syntax::generic_parameter_count(v::at<syntax::Parsed>(ref sources,s.module_index),s.declaration-1)==s.argument_count && s.result>0 && s.result<=interfaces::type_count(ref imported));root+=1;}
        var usize nested_calls=0;var usize nested_intrinsics=0;var usize aggregate_requests=0;root=0;while(root<generics::dependency_count(specialized)){let edge=generics::dependency_at(specialized,root);assert(edge.owner>0 && edge.owner<=generics::count(specialized));let owner=generics::at(specialized,edge.owner);let source=v::at<syntax::Parsed>(ref sources,owner.module_index);let d=syntax::declaration_at(source,owner.declaration-1);let e=syntax::expression_at(source,edge.source_index);assert(e.kind==20 && e.start>=d.start && e.end<=d.end);if(edge.instance!=0){assert(edge.instance<=generics::count(specialized) && edge.intrinsic==0 && edge.intrinsic_type==0 && edge.aggregate_type==0);nested_calls+=1;}else if(edge.aggregate_type!=0){assert(edge.intrinsic==0 && edge.intrinsic_type==0 && interfaces::type_at(ref imported,edge.aggregate_type).kind==13);aggregate_requests+=1;}else{assert(edge.intrinsic!=0 && edge.intrinsic_type>0 && edge.intrinsic_type<=interfaces::type_count(ref imported));nested_intrinsics+=1;}root+=1;}
        number("nestedCalls=",nested_calls);number(" nestedIntrinsics=",nested_intrinsics);number(" aggregateRequests=",aggregate_requests);discard io::write("\n");
        number("specializations=",generics::count(specialized));number(" specializedCalls=",concrete_calls);number(" deferredCalls=",deferred_calls);number(" intrinsicCalls=",intrinsic_calls);number(" genericWork=",generics::work(specialized));discard io::write("\n");
        var usize sh=0;while(sh<interfaces::shape_count(ref imported)){let shape=interfaces::shape_at(ref imported,sh);let original=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,shape.module_index),shape.declaration-1);assert(shape.start==original.start && shape.end==original.end && shape.field_count==original.field_count);sh+=1;}
        sh=0;while(sh<interfaces::field_count(ref imported)){let field=interfaces::field_at(ref imported,sh);let source=v::at<syntax::Parsed>(ref sources,field.module_index);let original=syntax::field_at(source,field.source_index);assert(field.kind==original.kind && field.start==original.start && field.end==original.end && bytes::equal(interfaces::field_name(ref imported,sh),syntax::source_view(source)[original.name_start..original.name_end]));sh+=1;}
        var usize d=1;while(d<=syntax::declaration_count(p)){let c=binding::definition_at(ref bound,d);let original=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,c.module_index),c.declaration-1);assert(c.kind==original.kind && c.start==original.start && c.end==original.end);d+=1;}
        d=1;while(d<=binding::target_count(ref bound)){let c=binding::target_at(ref bound,d);let original=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,c.module_index),c.declaration-1);assert(c.kind==original.kind && c.start==original.start && c.end==original.end);d+=1;}
        targets+=binding::target_count(ref bound);if(binding::work(ref bound)>max_work){max_work=binding::work(ref bound);}assert(binding::work(ref bound)<=1048576);
        modules+=syntax::module_count(p);expressions+=syntax::expression_count(p);entries+=syntax::entry_count(p);joined_bytes+=syntax::source_view(p).len;
        number("unit=",i);number(" first=",unit.first);number(" stop=",unit.stop);number(" bytes=",unit.usage.bytes);number(" declarations=",unit.usage.declarations);number(" expressions=",unit.usage.expressions);number(" statements=",unit.usage.statements);number(" entries=",unit.usage.entries);number(" types=",unit.usage.types);number(" fields=",unit.usage.fields);number(" attributes=",unit.usage.attributes);number(" arguments=",unit.usage.arguments);number(" targets=",binding::target_count(ref bound));number(" work=",binding::work(ref bound));number(" shapes=",interfaces::shape_count(ref imported));number(" fields=",interfaces::field_count(ref imported));number(" callables=",interfaces::callable_count(ref imported));number(" types=",interfaces::type_count(ref imported));number(" importWork=",interfaces::work(ref imported));discard io::write("\n");i+=1;
    }
    assert(modules==units::file_count(ref plan) && joined_bytes+units::count(ref plan)-1==units::source_bytes(ref plan));number("joinedModules=",modules);number(" totalExpressions=",expressions);number(" totalEntries=",entries);number(" totalTargets=",targets);number(" maxWork=",max_work);discard io::write("\n");return 0;
}
