fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(){var v::Vec<usize> p=v::empty<usize>();assert(v::push<usize>(ref mut p,1).is_ok);return p;}
fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn core::Complete compiled(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;var usize linked=0;return switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr("compiled ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);compiled(sources)}};}
@effects(console) fn identities::Snapshot snapshot(ref identified::Program program){var usize work=0;return switch(snapshot_extract::extract(identified::source_identities(program),ir::cleanup_ir(identified::ir_program(program)),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("snapshot ");discard io::write_stderr_u32(code);assert(false);snapshot(program)}};}
@effects(console) fn planned::Plan source_plan(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;return switch(planning::build_sources(sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);source_plan(sources)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("encoded ");discard io::write_stderr_u32(code);assert(false);encoded(p)}};}
@effects(console) fn ir::Program restored(ref u8[] raw){var usize work=0;return switch(decoder::decode(raw,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("restored ");discard io::write_stderr_u32(code);assert(false);restored(raw)}};}
fn void number(ref mut bytes::Buffer raw,usize at,usize input){assert(at+8<=bytes::len(raw));var bytes::Buffer octets=bytes::empty();var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(ref mut octets,input,ref mut status,ref mut work);assert(status.code==0 && bytes::len(ref octets)==8);var usize i=0;while(i<8){bytes::view_mut(raw)[at+i]=bytes::view(ref octets)[i];i+=1;}}
fn v::Vec<syntax::Parsed> inputs(){return source(b"module main;resource R{i32 n;cleanup{discard this.n;}}resource Pair{R first;R second;cleanup{}}fn R make(){return R{.n=1};}fn R forwarded(R value){return value;}fn Result<R,i32> fallible(){return .err(1);}fn Result<Pair,i32> partial(){return .ok(Pair{.first=make(),.second=fallible()?});}fn void exits(bool c){let R a=make();var R b=make();b=make();while(c){let R loop=make();if(c){break;}else{continue;}}discard make();discard fallible().is_ok;let Option<R> o=.some(make());switch(o){case .some(value):{discard value.n;}case .none:{}};if(c){return;}}fn i32 main(){exits(false);discard partial();return 42;}");}
fn usize named_frame(ref ir::Program p,ref v::Vec<syntax::Parsed> sources,ref u8[] name){var usize i=1;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);let parsed=v::at<syntax::Parsed>(sources,f.module_index);let d=syntax::declaration_at(parsed,f.declaration-1);if(f.kind==3 && bytes::equal(syntax::source_view(parsed)[d.name_start..d.name_end],name)){return i;}i+=1;}assert(false);return 0;}
struct Tables{budget::Span part;usize operands;usize operand_count_at;usize drops;usize drop_count_at;}
fn Tables tables(ref u8[] raw){var usize work=0;var c=switch(budget::cursor(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return tables(raw);}};let part=budget::member_from(raw,ref mut c,8388608,b"FYCLEAN0",ref mut work);c.offset=part.start+16;let types=budget::number_from(raw,ref mut c,ref mut work);c.offset+=types*104;let frames=budget::number_from(raw,ref mut c,ref mut work);c.offset+=frames*64;let fields=budget::number_from(raw,ref mut c,ref mut work);c.offset+=fields*24;let operand_count_at=c.offset;let operands=budget::number_from(raw,ref mut c,ref mut work);c.offset+=operands*48;let drop_count_at=c.offset;let drops=budget::number_from(raw,ref mut c,ref mut work);assert(c.code==0 && c.offset+drops*32==part.end);return Tables{.part,.operands=operand_count_at+8,.operand_count_at,.drops=drop_count_at+8,.drop_count_at};}
fn bytes::Buffer omit(ref u8[] raw,usize at,usize length){var bytes::Buffer changed=bytes::empty();assert(bytes::append(ref mut changed,raw[..at]).is_ok && bytes::append(ref mut changed,raw[at+length..]).is_ok);return changed;}
@test @effects(console) fn void source_move_requests_match_local_and_temporary_drop_exits(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let payload=encoded(identified::ir_program(named));let program=restored(wire::content(ref payload));let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let map=switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("matched ");discard io::write_stderr_u32(code);assert(false);return;}};let saved=ir::cleanup_ir(ref program);var usize local=0;var usize temporary=0;var u32 reasons=0;var usize i=0;while(i<clean::drop_count(saved)){let d=clean::drop_at(saved,i);let o=clean::operand_at(saved,d.operand);if(o.kind==1){local+=1;}else{temporary+=1;}reasons|=1<<d.exit;i+=1;}assert(local>0 && temporary>0 && reasons==1022 && mapping::unit_count(ref map)==values::count(compile::checked_values(ref checked)));assert(moves::cleanup_count(compile::checked_moves(ref checked))==clean::drop_count(saved));}
@test @effects(console) fn void structurally_valid_drop_mutations_and_orphans_reject(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let original=identified::ir_program(named);let saved=ir::cleanup_ir(original);let payload=encoded(original);let raw=wire::content(ref payload);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);let table=tables(raw);let frame=named_frame(original,ref sources,b"exits");var usize first=16384;var usize i=0;while(i+1<clean::drop_count(saved)){let a=clean::drop_at(saved,i);let b=clean::drop_at(saved,i+1);let oa=clean::operand_at(saved,a.operand);let ob=clean::operand_at(saved,b.operand);if(a.exit==2 && a.exit==b.exit && a.start==b.start && a.end==b.end && oa.frame==frame && ob.frame==frame && oa.kind==1 && ob.kind==1 && oa.type==ob.type && oa.id!=ob.id){first=i;break;}i+=1;}assert(first<16384);let a=clean::drop_at(saved,first);let b=clean::drop_at(saved,first+1);let position=table.drops+first*32;var u32 mode=0;
    while(mode<7){var bytes::Buffer changed=fixture::copied(raw);if(mode==0){var usize k=0;while(k<32){let byte=bytes::view(ref changed)[position+k];bytes::view_mut(ref mut changed)[position+k]=raw[position+32+k];bytes::view_mut(ref mut changed)[position+32+k]=byte;k+=1;}}else if(mode==1){number(ref mut changed,position+8,1);}else if(mode==2){number(ref mut changed,position+16,a.start+1);}else if(mode==3){number(ref mut changed,table.operands+(a.operand-1)*48+40,clean::operand_at(saved,a.operand).end+1);}else if(mode==4){number(ref mut changed,position,b.operand);}else if(mode==5){changed=omit(raw,position,32);number(ref mut changed,table.drop_count_at,clean::drop_count(saved)-1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start-32);}else{let forward=named_frame(original,ref sources,b"forwarded");let local=ir::local_at(ir::at(original,forward),1);var bytes::Buffer row=bytes::empty();var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(ref mut row,forward,ref mut status,ref mut work);budget::number(ref mut row,1,ref mut status,ref mut work);budget::number(ref mut row,1,ref mut status,ref mut work);budget::number(ref mut row,local.type,ref mut status,ref mut work);budget::number(ref mut row,local.start,ref mut status,ref mut work);budget::number(ref mut row,local.end,ref mut status,ref mut work);assert(status.code==0 && bytes::len(ref row)==48);changed=bytes::empty();assert(bytes::append(ref mut changed,raw[..table.drop_count_at]).is_ok && bytes::append(ref mut changed,bytes::view(ref row)).is_ok && bytes::append(ref mut changed,raw[table.drop_count_at..]).is_ok);number(ref mut changed,table.operand_count_at,clean::operand_count(saved)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+48);}
        var usize decoded_work=0;let program=switch(decoder::decode(bytes::view(ref changed),ref mut decoded_work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("mutation ");discard io::write_stderr_u32(mode);discard io::write_stderr(" ");discard io::write_stderr_u32(code);assert(false);return;}};var usize work=0;assert(switch(matching_calls::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{true}case .err(_):{false}});work=0;assert(switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;
    }
}
@test @effects(console) fn void exact_exhausted_invalid_and_stale_drop_checks_publish_no_partial_map(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let program=identified::ir_program(named);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let normal=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let required=work;work=budget::work_limit()-required;let exact=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work==budget::work_limit() && mapping::unit_count(ref normal)==mapping::unit_count(ref exact));work=budget::work_limit()-required+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);let changed=source(b"module main;fn i32 main(){return 42;}");work=0;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref changed,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_drops_match_each_source_unit(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let p=switch(mapping::build(ref program,current::source_identities(ref rebound),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<u8> covered=v::empty<u8>();var usize i=0;while(i<mapping::count(ref p)){assert(v::push<u8>(ref mut covered,0).is_ok);i+=1;}var usize unit=0;var usize cleanups=0;var usize specialized=0;var usize changed=0;
    while(unit<v::len<syntax::Parsed>(fixture::sources(ref sources))){let checked=get_checked(fixture::sources(ref sources),ref metadata,unit,unit+1);work=0;let ids=switch(matching::match(ref program,current::source_identities(ref rebound),compile::checked_state(ref checked),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(mapping::unit_count(ref ids)==values::count(typed));i=0;while(i<values::count(typed)){let f=body::frame(values::at(typed,i));let target=mapping::mapped(ref ids,i+1);let saved=mapping::frame_at(ref p,target);if(f.kind==2){cleanups+=1;assert(saved.receiver!=0 && saved.receiver_type!=0);}if(f.kind==1){specialized+=1;}if(f.context!=saved.context){changed+=1;}let marked=v::at_mut<u8>(ref mut covered,target-1);*marked=1;i+=1;}unit+=1;
    }i=0;while(i<v::len<u8>(ref covered)){assert(*v::at<u8>(ref covered,i)==1);i+=1;}assert(unit>2 && cleanups>0 && specialized>0 && changed>0);
}
