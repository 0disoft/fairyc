module tests::module_project_artifact_frames;
import module_project_artifact_frames as mapping;
import module_project_artifact_types as type_mapping;
import module_project_compile as compile;
import module_unit_values as values;
import module_unit_value_model as body;
import module_unit_body_ir_model as ir;
import module_identity_artifact_model as identities;
import module_identity_artifact_extract as snapshot_extract;
import project_compiler_core as core;
import module_project_identified_ir as identified;
import project_source_plan as planning;
import module_signatures as signatures;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import module_program_artifact_wire as budget;
import tests::module_project_artifact_current_fixture as fixture;
import module_project_artifact_current as current;
import module_project_artifact_rebase as rebase;
import candidate_artifact_wire as wire;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(){var v::Vec<usize> p=v::empty<usize>();assert(v::push<usize>(ref mut p,1).is_ok);return p;}
fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn mapping::Index detached(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;var usize linked=0;let compiled=switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return detached(sources);}};let p=core::checked_program(ref compiled);work=0;let snapshot=switch(snapshot_extract::extract(identified::source_identities(p),ir::cleanup_ir(identified::ir_program(p)),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return detached(sources);}};work=0;return switch(mapping::build(identified::ir_program(p),ref snapshot,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);detached(sources)}};}
fn v::Vec<syntax::Parsed> generic(u32 mode){return source(if(mode==1){b"module main;fn i32 constant<T>(){return 42;}fn i32 main(){discard constant<u64>();return constant<u16>();}"}else if(mode==2){b"module main;fn i32 constant<T>(){return 42;}fn i32 main(){discard constant<u8>();return constant<u64>();}"}else{b"module main;fn i32 constant<T>(){return 42;}fn i32 main(){discard constant<u16>();return constant<u64>();}"});}
fn v::Vec<syntax::Parsed> plain(u32 mode){return source(if(mode==1){b"module main;@effects(console)resource R{i32 n;cleanup{discard 1;}}@effects(console,filesystem,environment)fn i32 main(){let R r=R{.n=1};return 42;}"}else if(mode==2){b"module main;@effects(console,filesystem)resource R{i32 n;cleanup{discard 1;}}@effects(console,filesystem)fn i32 main(){let R r=R{.n=1};return 42;}"}else if(mode==3){b"module main;@effects(console)resource R{i32 n;cleanup{discard 1;}}@effects(console,filesystem)fn i64 main(){let R r=R{.n=1};return 42;}"}else{b"module main;@effects(console)resource R{i32 n;cleanup{discard 1;}}@effects(console,filesystem)fn i32 main(){let R r=R{.n=1};return 42;}"});}
@test @effects(console) fn void generic_source_ids_match_phantom_arguments_across_context_changes(){let original=generic(0);let p=detached(ref original);let sources=generic(1);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;let plan=switch(planning::build_sources(ref sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let ids=switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(mapping::unit_count(ref ids)==values::count(typed));var usize specialized=0;var usize first=0;var usize changed=0;var usize i=0;
    while(i<values::count(typed)){let frame=body::frame(values::at(typed,i));let target=mapping::mapped(ref ids,i+1);let saved=mapping::frame_at(ref p,target);assert(mapping::used(ref ids,target) && saved.module_index==frame.module_index && saved.declaration==frame.declaration && saved.result==type_mapping::mapped(mapping::type_mapping(ref ids),frame.result));if(saved.context!=frame.context){changed+=1;}if(frame.kind==1){specialized+=1;if(first==0){first=target;}else{assert(first!=target && mapping::frame_at(ref p,first).result==saved.result);}}i+=1;
    }assert(specialized==2 && changed>0 && mapping::mapped(ref ids,0)==0 && mapping::mapped(ref ids,mapping::unit_count(ref ids)+1)==0);
}
@test @effects(console) fn void wrong_return_effect_and_cleanup_authority_reject_despite_matching_types(){let original=plain(0);let p=detached(ref original);var u32 mode=1;while(mode<=3){let sources=plain(mode);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;let plan=switch(planning::build_sources(ref sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(type_mapping::match(mapping::type_index(ref p),compile::checked_state(ref checked),ref sources,ref mut work)){case .ok(_):{true}case .err(_):{false}});work=0;assert(switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;}}
@test @effects(console) fn void missing_specialization_and_exhausted_or_stale_inputs_publish_no_frame_map(){let original=generic(0);let p=detached(ref original);let sources=generic(0);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;let plan=switch(planning::build_sources(ref sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let normal=switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let required=work;work=budget::work_limit()-required;let exact=switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work==budget::work_limit() && mapping::unit_count(ref exact)==mapping::unit_count(ref normal));work=budget::work_limit()-required+1;assert(switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);
    let changed=generic(2);let changed_metadata=get_metadata(ref changed);let new_checked=get_checked(ref changed,ref changed_metadata,0,1);work=0;let new_plan=switch(planning::build_sources(ref changed,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(mapping::match(ref p,compile::checked_state(ref new_checked),ref new_plan,ref changed,ref changed_metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});work=0;assert(switch(mapping::match(ref p,compile::checked_state(ref checked),ref plan,ref changed,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});
}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_frames_match_all_current_source_units(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let p=switch(mapping::build(ref program,current::source_identities(ref rebound),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<u8> covered=v::empty<u8>();var usize i=0;while(i<mapping::count(ref p)){assert(v::push<u8>(ref mut covered,0).is_ok);i+=1;}var usize unit=0;var usize cleanups=0;var usize specialized=0;var usize changed=0;
    while(unit<v::len<syntax::Parsed>(fixture::sources(ref sources))){let checked=get_checked(fixture::sources(ref sources),ref metadata,unit,unit+1);work=0;let ids=switch(mapping::match(ref p,compile::checked_state(ref checked),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(mapping::unit_count(ref ids)==values::count(typed));i=0;while(i<values::count(typed)){let f=body::frame(values::at(typed,i));let target=mapping::mapped(ref ids,i+1);let saved=mapping::frame_at(ref p,target);if(f.kind==2){cleanups+=1;assert(saved.receiver!=0 && saved.receiver_type!=0);}if(f.kind==1){specialized+=1;}if(f.context!=saved.context){changed+=1;}let marked=v::at_mut<u8>(ref mut covered,target-1);*marked=1;i+=1;}unit+=1;
    }i=0;while(i<v::len<u8>(ref covered)){assert(*v::at<u8>(ref covered,i)==1);i+=1;}assert(unit>2 && cleanups>0 && specialized>0 && changed>0);
}
