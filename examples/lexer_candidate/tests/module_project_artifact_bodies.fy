import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(){var v::Vec<usize> p=v::empty<usize>();assert(v::push<usize>(ref mut p,1).is_ok);return p;}
fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn core::Complete compiled(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;var usize linked=0;return switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);compiled(sources)}};}
@effects(console) fn identities::Snapshot snapshot(ref identified::Program program){var usize work=0;return switch(snapshot_extract::extract(identified::source_identities(program),ir::cleanup_ir(identified::ir_program(program)),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);snapshot(program)}};}
@effects(console) fn planned::Plan source_plan(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;return switch(planning::build_sources(sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);source_plan(sources)}};}
fn v::Vec<syntax::Parsed> scalar(u32 mode){return source(if(mode==1){b"module main;const i32 N=43;const bool YES=true;struct S{i32 n;}resource R{i32 n;cleanup{discard 1;}}fn i32 constant<T>(){return N;}fn i32 main(){let R r=R{.n=1};let ref u8[] data=b\"a\\x00b\";var S s=S{.n=N};s.n+=1;while(s.n<44){s.n+=1;}discard data[1];discard YES;discard constant<u16>();return constant<u64>();}"}else if(mode==2){b"module main;const i32 N=42;const bool YES=true;struct S{i32 n;}resource R{i32 n;cleanup{discard 2;}}fn i32 constant<T>(){return N;}fn i32 main(){let R r=R{.n=1};let ref u8[] data=b\"a\\x00b\";var S s=S{.n=N};s.n+=1;while(s.n<44){s.n+=1;}discard data[1];discard YES;discard constant<u16>();return constant<u64>();}"}else if(mode==3){b"module main;const i32 N=42;const bool YES=true;struct S{i32 n;}resource R{i32 n;cleanup{discard 1;}}fn i32 constant<T>(){return N;}fn i32 main(){let R r=R{.n=1};let ref u8[] data=b\"a\\x00c\";var S s=S{.n=N};s.n+=1;while(s.n<44){s.n+=1;}discard data[1];discard YES;discard constant<u16>();return constant<u64>();}"}else if(mode==4){b"module main;const i32 N=42;const bool YES=true;struct S{i32 n;}resource R{i32 n;cleanup{discard 1;}}fn i32 constant<T>(){return N;}fn i32 main(){let R r=R{.n=1};let ref u8[] data=b\"a\\x00b\";var S s=S{.n=N};s.n-=1;while(s.n<44){s.n+=1;}discard data[1];discard YES;discard constant<u16>();return constant<u64>();}"}else{b"module main;const i32 N=42;const bool YES=true;struct S{i32 n;}resource R{i32 n;cleanup{discard 1;}}fn i32 constant<T>(){return N;}fn i32 main(){let R r=R{.n=1};let ref u8[] data=b\"a\\x00b\";var S s=S{.n=N};s.n+=1;while(s.n<44){s.n+=1;}discard data[1];discard YES;discard constant<u16>();return constant<u64>();}"});}
@test @effects(console) fn void source_values_match_folded_constants_literals_fields_and_cleanup(){let sources=scalar(0);let owned=compiled(ref sources);let program=core::checked_program(ref owned);let ids=snapshot(program);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let mapped=switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};assert(mapping::unit_count(ref mapped)==values::count(compile::checked_values(ref checked)) && mapping::unit_count(ref mapped)>=4 && work>0);}
@test @effects(console) fn void matching_signatures_do_not_admit_changed_values_or_statements(){let original=scalar(0);let owned=compiled(ref original);let program=core::checked_program(ref owned);let ids=snapshot(program);var u32 mode=1;while(mode<=4){let sources=scalar(mode);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let index=switch(mapping::build(identified::ir_program(program),ref ids,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(mapping::match(ref index,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{true}case .err(_):{false}});work=0;assert(switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;}}
@test @effects(console) fn void exact_exhausted_and_stale_work_never_admit_partial_body_maps(){let sources=scalar(0);let owned=compiled(ref sources);let program=core::checked_program(ref owned);let ids=snapshot(program);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let normal=switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let required=work;work=budget::work_limit()-required;let exact=switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work==budget::work_limit() && mapping::unit_count(ref normal)==mapping::unit_count(ref exact));work=budget::work_limit()-required+1;assert(switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);let changed=scalar(1);work=0;assert(switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref changed,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_bodies_match_without_lowering(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let p=switch(mapping::build(ref program,current::source_identities(ref rebound),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<u8> covered=v::empty<u8>();var usize i=0;while(i<mapping::count(ref p)){assert(v::push<u8>(ref mut covered,0).is_ok);i+=1;}var usize unit=0;var usize cleanups=0;var usize specialized=0;var usize changed=0;
    while(unit<v::len<syntax::Parsed>(fixture::sources(ref sources))){let checked=get_checked(fixture::sources(ref sources),ref metadata,unit,unit+1);work=0;let ids=switch(matching::match(ref program,current::source_identities(ref rebound),compile::checked_state(ref checked),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(mapping::unit_count(ref ids)==values::count(typed));i=0;while(i<values::count(typed)){let f=body::frame(values::at(typed,i));let target=mapping::mapped(ref ids,i+1);let saved=mapping::frame_at(ref p,target);if(f.kind==2){cleanups+=1;assert(saved.receiver!=0 && saved.receiver_type!=0);}if(f.kind==1){specialized+=1;}if(f.context!=saved.context){changed+=1;}let marked=v::at_mut<u8>(ref mut covered,target-1);*marked=1;i+=1;}unit+=1;
    }i=0;while(i<v::len<u8>(ref covered)){assert(*v::at<u8>(ref covered,i)==1);i+=1;}assert(unit>2 && cleanups>0 && specialized>0 && changed>0);
}

@test @effects(filesystem,console) fn void lexical_region_scopes_placement_and_resets_match_checked_sources(){
    let original=fixture::current(0);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var usize root=512;var usize allocator=512;var usize i=0;
    while(i<v::len<syntax::Parsed>(fixture::sources(ref original))){let p=v::at<syntax::Parsed>(fixture::sources(ref original),i);let d=syntax::declaration_at(p,0);let name=syntax::source_view(p)[d.name_start..d.name_end];if(bytes::equal(name,b"std::alloc")){allocator=i;}if(bytes::equal(name,b"main")){root=i;assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import helper as h;import std::vec as vec;import std::alloc as alloc;fn i32 main(){return 42;}fn Result<i32,alloc::AllocError> local_regions(ref mut alloc::Arena a,ref mut alloc::Arena b,bool c){region r in a{region s in b{let v=s.place(42)?;if(c){return .ok(*v);}}}return .ok(0);}")).is_ok);}else{assert(v::push<syntax::Parsed>(ref mut sources,parsed(syntax::source_view(p))).is_ok);}i+=1;}assert(root<512 && allocator<512);
    var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();i=0;while(i<v::len<catalog::Binding>(fixture::imports(ref original))){let row=*v::at<catalog::Binding>(fixture::imports(ref original),i);assert(v::push<catalog::Binding>(ref mut imports,row).is_ok);if(row.source==root && row.declaration==3){assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=root,.declaration=4,.target=allocator}).is_ok);}i+=1;}
    let owner=fixture::owners(ref original);let table=fixture::coordinate_table(ref original);let catalog=switch(catalog::build_scoped(ref sources,owner,ref imports)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return;}};let metadata=switch(signatures::build_catalog(ref sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize work=0;var usize linked=0;let owned=switch(core::build_complete_sources(ref sources,owner,ref imports,table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);return;}};let program=core::checked_program(ref owned);let ids=snapshot(program);let checked=get_checked(ref sources,ref metadata,root,root+1);work=0;let plan=switch(planning::build_sources(ref sources,owner,ref imports,table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let mapped=switch(matching::match(identified::ir_program(program),ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    var usize scopes=0;var usize placements=0;var usize resets=0;i=0;while(i<mapping::unit_count(ref mapped)){let saved=ir::at(identified::ir_program(program),mapping::mapped(ref mapped,i+1));scopes+=ir::region_count(saved);placements+=ir::placement_count(saved);resets+=ir::reset_count(saved);i+=1;}assert(scopes==2 && placements==1 && resets>=4);
}
