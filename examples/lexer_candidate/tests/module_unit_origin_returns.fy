module tests::module_unit_origin_returns;
import module_unit_origin_returns as origins;
import module_unit_origin_inputs as inputs;
import module_unit_origin_sets as sets;
import module_unit_values as values;
import module_unit_value_model as m;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn values::Plan primary(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return primary(sources,metadata);}};let ready=switch(closure::build(sources,metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return primary(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(_):{assert(false);primary(sources,metadata)}};}
fn values::Plan primary_unit(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return primary_unit(sources,metadata);}};let ready=switch(closure::build_unit(sources,metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return primary_unit(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(_):{assert(false);primary_unit(sources,metadata)}};}
fn usize frame(ref origins::Plan p,ref v::Vec<syntax::Parsed> sources,usize module_index,ref u8[] name){let input=origins::owned_inputs(p);var usize i=1;while(i<=inputs::frame_count(input)){let f=inputs::frame(input,i);if(f.value.module_index==module_index && f.value.kind==3){let source=v::at<syntax::Parsed>(sources,module_index);let d=syntax::declaration_at(source,f.value.declaration-1);if(bytes::equal(syntax::source_view(source)[d.name_start..d.name_end],name)){return i;}}i+=1;}assert(false);return 0;}
fn usize parameter(ref origins::Plan p,usize id,usize ordinal){return inputs::parameter(origins::owned_inputs(p),id,ordinal)+2;}
fn void singleton(ref origins::Plan p,usize id,usize origin){assert(origins::source_count(p,id)==1 && origins::source(p,id,0)==origin);}
fn void pair(ref origins::Plan p,usize id,usize a,usize b){assert(origins::source_count(p,id)==2 && origins::source(p,id,0)==if(a<b){a}else{b} && origins::source(p,id,1)==if(a<b){b}else{a});}
@test fn void provider_frames_follow_required_functions_and_reuse_transitive_generics(){
    let root=b"module main;import provider as p;fn ref i32 relay(ref i32 a){return p::first(a);}fn ref i32 again(ref i32 a){return p::second(a);}";
    let provider=b"module provider;pub fn ref i32 first(ref i32 n){return middle(n);}pub fn ref i32 second(ref i32 n){return middle(n);}fn ref i32 middle(ref i32 n){return identity<i32>(n);}fn ref T identity<T>(ref T n){return n;}fn ref i32 unused(){let i32 local=1;return ref local;}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let ready=switch(closure::build_unit(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let primary=switch(values::build(ref sources,ref metadata,ref ready)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let input=origins::owned_inputs(ref p);assert(inputs::provider_count(input)==1 && inputs::frame_count(input)==6);
    let relay=frame(ref p,ref sources,0,b"relay");let again=frame(ref p,ref sources,0,b"again");let first=frame(ref p,ref sources,1,b"first");let second=frame(ref p,ref sources,1,b"second");let middle=frame(ref p,ref sources,1,b"middle");
    singleton(ref p,relay,parameter(ref p,relay,0));singleton(ref p,again,parameter(ref p,again,0));singleton(ref p,first,parameter(ref p,first,0));singleton(ref p,second,parameter(ref p,second,0));singleton(ref p,middle,parameter(ref p,middle,0));
    assert(inputs::target(input,first,0)==middle && inputs::target(input,second,0)==middle);let generic=inputs::target(input,middle,0);singleton(ref p,generic,parameter(ref p,generic,0));assert(inputs::frame(input,generic).unit==inputs::frame(input,middle).unit && origins::unknown_count(ref p)==0);
}
@test fn void static_unknown_dead_suffixes_and_reassignments_are_inferred(){
    let text=b"module main;fn ref str literal(){return \"fixed\";}fn ref str mixed(ref str p,bool flag){return if(flag){\"fixed\"}else{p};}fn ref i32 dead(ref i32 a,ref i32 b){return a;return b;}fn ref i32 overwrite(ref i32 a,ref i32 b){var ref i32 r=a;r=b;return r;}fn ref i32 branch(ref i32 a,ref i32 b,bool flag){var ref i32 r=a;if(flag){r=b;};return r;}fn ref i32 terminated(ref i32 a,ref i32 b,bool flag){var ref i32 r=a;if(flag){r=b;return a;};return r;}fn ref i32 recursive(ref i32 a){return recursive(a);}fn ref i32 broken(){let i32 local=1;return ref local;}fn ref i32 from_bad(){return broken();}fn ref i32 first(ref i32 a,ref i32 b){return a;}fn ref i32 ordered(ref i32 a,ref i32 b){var ref i32 r=a;return first(r,{r=b;r});}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let literal=frame(ref p,ref sources,0,b"literal");assert(origins::source_count(ref p,literal)==1 && inputs::owner(origins::owned_inputs(ref p),origins::source(ref p,literal,0)-2).kind==11);let mixed=frame(ref p,ref sources,0,b"mixed");assert(origins::source_count(ref p,mixed)==2 && origins::source(ref p,mixed,0)==parameter(ref p,mixed,0) && inputs::owner(origins::owned_inputs(ref p),origins::source(ref p,mixed,1)-2).kind==11);let dead=frame(ref p,ref sources,0,b"dead");singleton(ref p,dead,parameter(ref p,dead,0));let overwrite=frame(ref p,ref sources,0,b"overwrite");singleton(ref p,overwrite,parameter(ref p,overwrite,1));let branch=frame(ref p,ref sources,0,b"branch");pair(ref p,branch,parameter(ref p,branch,0),parameter(ref p,branch,1));let terminated=frame(ref p,ref sources,0,b"terminated");singleton(ref p,terminated,parameter(ref p,terminated,0));assert(origins::summary(ref p,frame(ref p,ref sources,0,b"recursive"))==1 && origins::summary(ref p,frame(ref p,ref sources,0,b"from_bad"))==1);let broken=frame(ref p,ref sources,0,b"broken");let local=inputs::frame(origins::owned_inputs(ref p),broken).local_start+1;singleton(ref p,broken,local+2);assert(!inputs::owner(origins::owned_inputs(ref p),local).borrowed);let ordered=frame(ref p,ref sources,0,b"ordered");singleton(ref p,ordered,parameter(ref p,ordered,0));assert(origins::rounds(ref p)>=2 && origins::work(ref p)<1048576);
}
@test fn void loop_break_continue_and_nested_fixed_points_join_live_environments(){
    let text=b"module main;fn ref i32 break_exit(ref i32 a,ref i32 b,bool flag){var ref i32 r=a;while(flag){r=b;break;}return r;}fn ref i32 continue_backedge(ref i32 a,ref i32 b,bool flag){var ref i32 r=a;while(flag){r=b;continue;}return r;}fn ref i32 nested(ref i32 a,ref i32 b,bool flag){var ref i32 r=a;while(flag){while(flag){r=b;break;}continue;}return r;}fn ref i32 scalar_for(ref i32 a,ref i32 b){var ref i32 r=a;for(var i32 n=0;n<1;n+=1){r=b;continue;}return r;}fn ref i32 transfer(ref i32 a,ref i32 b,bool flag){var ref i32 first=a;var ref i32 second=b;while(flag){first=second;second=first;continue;}return first;}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize i=1;while(i<=origins::count(ref p)){pair(ref p,i,parameter(ref p,i,0),parameter(ref p,i,1));i+=1;}assert(origins::work(ref p)<1048576);
}
@test fn void generic_provider_summaries_substitute_unit_scoped_argument_origins(){
    let root=b"module main;import provider as p;fn ref i32 relay(ref i32 a,ref i32 b){return p::identity<i32>(b);}fn ref i64 wide(ref i64 a){return p::relay(a);}";let provider=b"module provider;pub fn ref T identity<T>(ref T n){return n;}pub fn ref i64 relay(ref i64 n){return identity<i64>(n);}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let primary=primary_unit(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};let relay=frame(ref p,ref sources,0,b"relay");let wide=frame(ref p,ref sources,0,b"wide");let internal=frame(ref p,ref sources,1,b"relay");singleton(ref p,relay,parameter(ref p,relay,1));singleton(ref p,wide,parameter(ref p,wide,0));singleton(ref p,internal,parameter(ref p,internal,0));let input=origins::owned_inputs(ref p);let a=inputs::target(input,relay,0);let b=inputs::target(input,internal,0);assert(a!=b && inputs::frame(input,a).unit!=inputs::frame(input,b).unit && inputs::frame(input,a).value.context==inputs::frame(input,b).value.context);singleton(ref p,a,parameter(ref p,a,0));singleton(ref p,b,parameter(ref p,b,0));
    switch(origins::build_budgeted(ref sources,ref metadata,ref primary,1048576)){case .ok(_):{assert(false);}case .err(e):{assert(e.code==10);}};
    var v::Vec<syntax::Parsed> changed=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut changed,parsed(b"module main;import provider as p;fn ref i32 relay(ref i32 a,ref i32 b){return p::identity<i32>(a);}fn ref i64 wide(ref i64 a){return p::relay(a);}")).is_ok && v::push<syntax::Parsed>(ref mut changed,parsed(provider)).is_ok);switch(origins::build(ref changed,ref metadata,ref primary)){case .ok(_):{assert(false);}case .err(e):{assert(e.code==12 && e.module_index==0);}};
}
@test fn void return_sites_keep_individual_origins_and_original_expression_spans(){
    let text=b"module main;fn ref i32 alternatives(ref i32 a,ref i32 b,bool flag){if(flag){return a;};return b;}fn ref i32 called(ref i32 a,ref i32 b,bool flag){return alternatives(a,b,flag);}fn ref i32 loop_return(ref i32 a,ref i32 b,bool flag){while(flag){return b;}return a;}fn ref i32 dead(ref i32 a,ref i32 b){return a;return b;}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    let alternatives=frame(ref p,ref sources,0,b"alternatives");pair(ref p,alternatives,parameter(ref p,alternatives,0),parameter(ref p,alternatives,1));assert(origins::return_count(ref p,alternatives)==2);let first=origins::return_at(ref p,alternatives,0);let second=origins::return_at(ref p,alternatives,1);assert(first.frame==alternatives && second.frame==alternatives && first.origin==parameter(ref p,alternatives,0) && second.origin==parameter(ref p,alternatives,1));assert(bytes::equal(text[first.start..first.end],b"a") && bytes::equal(text[second.start..second.end],b"b"));
    let called=frame(ref p,ref sources,0,b"called");assert(origins::return_count(ref p,called)==1);let call=origins::return_at(ref p,called,0);assert(call.frame==called && origins::return_source_count(ref p,call)==2 && bytes::equal(text[call.start..call.end],b"alternatives(a,b,flag)"));
    let loop=frame(ref p,ref sources,0,b"loop_return");assert(origins::return_count(ref p,loop)==2);let body=origins::return_at(ref p,loop,0);let after=origins::return_at(ref p,loop,1);assert(body.origin==parameter(ref p,loop,1) && after.origin==parameter(ref p,loop,0) && bytes::equal(text[body.start..body.end],b"b") && bytes::equal(text[after.start..after.end],b"a"));
    let dead=frame(ref p,ref sources,0,b"dead");assert(origins::return_count(ref p,dead)==1 && origins::return_at(ref p,dead,0).origin==parameter(ref p,dead,0));assert(origins::work(ref p)<1048576);
}
@test fn void static_origins_keep_literal_locations_across_calls_and_instances(){
    let text=b"module main;fn ref str choose(bool flag){return if(flag){\"a\"}else{\"b\"};}fn ref str alternatives(bool flag){if(flag){return \"a\";};return \"b\";}fn ref str forward(bool flag){return alternatives(flag);}fn ref str generic<T>(){return \"shared\";}fn void main(){discard generic<i32>();discard generic<i64>();}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(_):{assert(false);return;}};let choose=frame(ref p,ref sources,0,b"choose");let alternatives=frame(ref p,ref sources,0,b"alternatives");let forward=frame(ref p,ref sources,0,b"forward");assert(origins::source_count(ref p,choose)==2 && origins::return_count(ref p,choose)==1 && origins::return_source_count(ref p,origins::return_at(ref p,choose,0))==2);assert(origins::source_count(ref p,alternatives)==2 && origins::return_count(ref p,alternatives)==2 && origins::summary(ref p,alternatives)==origins::summary(ref p,forward));
    let input=origins::owned_inputs(ref p);let a=inputs::owner(input,origins::source(ref p,choose,0)-2);let b=inputs::owner(input,origins::source(ref p,choose,1)-2);assert(a.kind==11 && b.kind==11 && a.start!=b.start && a.local==0 && b.scope==0);assert(bytes::equal(text[a.start..a.end],b"\"a\"") && bytes::equal(text[b.start..b.end],b"\"b\""));
    var usize i=1;var usize literal=0;var usize instances=0;while(i<=inputs::frame_count(input)){let f=inputs::frame(input,i);if(f.value.kind==1){assert(origins::source_count(ref p,i)==1);let source=origins::source(ref p,i,0);if(literal!=0){assert(source==literal);}literal=source;instances+=1;}i+=1;}assert(instances==2 && inputs::owner(input,literal-2).kind==11 && origins::work(ref p)<1048576);
}
