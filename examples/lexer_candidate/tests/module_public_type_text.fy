module tests::module_public_type_text;
import module_public_type_text as public_type;
import module_signatures as signatures;
import module_catalog as catalog;
import module_unit_interfaces as typed;
import module_unit_bind as bind;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
pub resource Context{v::Vec<syntax::Parsed> sources;signatures::Program metadata;typed::Interfaces graph;cleanup{}}
fn syntax::Parsed parsed(ref u8[] source){let b=switch(bytes::copy(source)){case .ok(b):{b}case .err(_):{assert(false);return parsed(source);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(source);}};return switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(source);}};}
fn Context context(usize owner){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(input())).is_ok);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,owner).is_ok);let bindings=v::empty<catalog::Binding>();let c=switch(catalog::build_scoped(ref sources,ref owners,ref bindings)){case .ok(c):{c}case .err(_):{assert(false);return context(owner);}};let metadata=switch(signatures::build_catalog(ref sources,c)){case .ok(p):{p}case .err(_):{assert(false);return context(owner);}};let bound=switch(bind::bind(ref sources,ref metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return context(owner);}};let graph=switch(typed::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return context(owner);}};return Context{.sources,.metadata,.graph};}
fn public_type::Coordinates make_coordinates(usize owner,u32 mode){var bytes::Buffer names=bytes::empty();assert(bytes::append(ref mut names,coordinate()).is_ok);if(mode==2){let ref mut u8[] view=bytes::view_mut(ref mut names);view[3]=105;}if(mode==3){let ref mut u8[] view=bytes::view_mut(ref mut names);view[20]=65;}var v::Vec<public_type::Coordinate> rows=v::empty<public_type::Coordinate>();let row=public_type::Coordinate{.owner,.start=0,.end=bytes::len(ref names)+if(mode==5){1}else{0}};if(mode!=1){assert(v::push<public_type::Coordinate>(ref mut rows,row).is_ok);}if(mode==4){assert(v::push<public_type::Coordinate>(ref mut rows,row).is_ok);}return public_type::assemble(names,rows);}
fn usize parameter(ref Context p,usize index){let s=signatures::at(ref p.metadata,1);assert(s.parameter_count==37);return signatures::parameter_at(ref p.metadata,s.parameter_start+index);}
fn bytes::Buffer rendered(ref Context p,ref public_type::Coordinates coordinates,usize owner,usize id){var usize work=0;return switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,coordinates,owner,id,ref mut work)){case .ok(b):{b}case .err(_):{assert(false);return rendered(p,coordinates,owner,id);}};}
@test
fn void typed_public_names_match_actual_go_extraction(){let p=context(7);let coordinates=make_coordinates(7,0);var usize i=0;while(i<37){let actual=rendered(ref p,ref coordinates,7,parameter(ref p,i));assert(expected(bytes::view(ref actual),i,false));i+=1;}let result=rendered(ref p,ref coordinates,7,signatures::at(ref p.metadata,1).result);assert(bytes::equal(bytes::view(ref result),b"void"));}
@test
fn void dependency_names_use_source_independent_coordinates_and_ignore_local_owner_ids(){let p=context(7);let coordinates=make_coordinates(7,0);assert(public_type::valid_coordinate(coordinate()));var usize i=0;while(i<37){let actual=rendered(ref p,ref coordinates,0,parameter(ref p,i));assert(expected(bytes::view(ref actual),i,true));i+=1;}let renumbered=context(19);let changed=make_coordinates(19,0);let original=rendered(ref p,ref coordinates,0,parameter(ref p,18));let rebuilt=rendered(ref renumbered,ref changed,0,parameter(ref renumbered,18));assert(bytes::equal(bytes::view(ref original),bytes::view(ref rebuilt)));}
@test
fn void private_or_stale_nominals_and_bad_coordinates_are_not_published(){let p=context(7);var u32 mode=1;while(mode<=5){let coordinates=make_coordinates(7,mode);var usize work=0;assert(switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,ref coordinates,0,parameter(ref p,12),ref mut work)){case .ok(_):{false}case .err(code):{code==9}});mode+=1;}let coordinates=make_coordinates(7,0);var usize i=0;var usize private_id=0;while(i<typed::shape_count(ref p.graph)){let shape=typed::shape_at(ref p.graph,i);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref p.sources,shape.module_index),shape.declaration-1);if(!d.public){private_id=shape.type;}i+=1;}assert(private_id!=0);var usize work=0;assert(switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,ref coordinates,7,private_id,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});var v::Vec<syntax::Parsed> changed=v::empty<syntax::Parsed>();var bytes::Buffer text=bytes::empty();assert(bytes::append(ref mut text,input()).is_ok && bytes::append(ref mut text,b"\n// changed source").is_ok);assert(v::push<syntax::Parsed>(ref mut changed,parsed(bytes::view(ref text))).is_ok);work=0;assert(switch(public_type::render(ref changed,ref p.metadata,ref p.graph,ref coordinates,7,parameter(ref p,12),ref mut work)){case .ok(_):{false}case .err(code):{code==12}});}
@test
fn void canonical_type_rendering_respects_exact_shared_work_allowance(){let p=context(7);let coordinates=make_coordinates(7,0);let id=parameter(ref p,18);var usize cost=0;assert(switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,ref coordinates,0,id,ref mut cost)){case .ok(_):{true}case .err(_):{false}});assert(cost>0 && cost<1048576);var usize work=1048576-cost;assert(switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,ref coordinates,0,id,ref mut work)){case .ok(_):{true}case .err(_):{false}});assert(work==1048576);work=1048576-cost+1;assert(switch(public_type::render(ref p.sources,ref p.metadata,ref p.graph,ref coordinates,0,id,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});assert(work<=1048576);}
fn ref u8[] input(){return b"module /* header */ api;pub struct Leaf{i64 value;}pub resource Owner{cleanup{}}pub enum Kind{Off;}struct Secret{u32 value;}pub fn void types(i32 p0,i64 p1,u8 p2,u32 p3,usize p4,bool p5,ref str p6,ref CStr p7,ref u8[] p8,ref mut u8[] p9,ref i64[] p10,ref mut bool[] p11,ref Leaf p12,ref mut Owner p13,ref Leaf[] p14,ref mut Leaf[] p15,Leaf[2] p16,Option<ref Leaf> p17,Result<Option<ref Owner>,u32> p18,ptr mut void p19,ptr mut ptr mut void p20,c::bool p21,c::char p22,c::double p23,c::float p24,c::int p25,c::long p26,c::longlong p27,c::schar p28,c::short p29,c::size_t p30,c::ssize_t p31,c::uchar p32,c::uint p33,c::ulong p34,c::ulonglong p35,c::ushort p36){discard p18;}";}
fn ref u8[] coordinate(){return b"fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b";}
fn bool expected(ref u8[] actual,usize i,bool dependency){if(i==0){return if(dependency){bytes::equal(actual,b"i32")}else{bytes::equal(actual,b"i32")};}if(i==1){return if(dependency){bytes::equal(actual,b"i64")}else{bytes::equal(actual,b"i64")};}if(i==2){return if(dependency){bytes::equal(actual,b"u8")}else{bytes::equal(actual,b"u8")};}if(i==3){return if(dependency){bytes::equal(actual,b"u32")}else{bytes::equal(actual,b"u32")};}if(i==4){return if(dependency){bytes::equal(actual,b"usize")}else{bytes::equal(actual,b"usize")};}if(i==5){return if(dependency){bytes::equal(actual,b"bool")}else{bytes::equal(actual,b"bool")};}if(i==6){return if(dependency){bytes::equal(actual,b"ref str")}else{bytes::equal(actual,b"ref str")};}if(i==7){return if(dependency){bytes::equal(actual,b"ref CStr")}else{bytes::equal(actual,b"ref CStr")};}if(i==8){return if(dependency){bytes::equal(actual,b"ref u8[]")}else{bytes::equal(actual,b"ref u8[]")};}if(i==9){return if(dependency){bytes::equal(actual,b"ref mut u8[]")}else{bytes::equal(actual,b"ref mut u8[]")};}if(i==10){return if(dependency){bytes::equal(actual,b"ref i64[]")}else{bytes::equal(actual,b"ref i64[]")};}if(i==11){return if(dependency){bytes::equal(actual,b"ref mut bool[]")}else{bytes::equal(actual,b"ref mut bool[]")};}if(i==12){return if(dependency){bytes::equal(actual,b"ref dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Leaf")}else{bytes::equal(actual,b"ref self::api::Leaf")};}if(i==13){return if(dependency){bytes::equal(actual,b"ref mut dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Owner")}else{bytes::equal(actual,b"ref mut self::api::Owner")};}if(i==14){return if(dependency){bytes::equal(actual,b"ref dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Leaf[]")}else{bytes::equal(actual,b"ref self::api::Leaf[]")};}if(i==15){return if(dependency){bytes::equal(actual,b"ref mut dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Leaf[]")}else{bytes::equal(actual,b"ref mut self::api::Leaf[]")};}if(i==16){return if(dependency){bytes::equal(actual,b"dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Leaf[2]")}else{bytes::equal(actual,b"self::api::Leaf[2]")};}if(i==17){return if(dependency){bytes::equal(actual,b"Option<ref dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Leaf>")}else{bytes::equal(actual,b"Option<ref self::api::Leaf>")};}if(i==18){return if(dependency){bytes::equal(actual,b"Result<Option<ref dep[fypc1-sha256-b3062e93752f15fe8f3322e9177f6f3b33f01f2f0d5cfff5226f7300bd01ab0b]::api::Owner>, u32>")}else{bytes::equal(actual,b"Result<Option<ref self::api::Owner>, u32>")};}if(i==19){return if(dependency){bytes::equal(actual,b"ptr mut void")}else{bytes::equal(actual,b"ptr mut void")};}if(i==20){return if(dependency){bytes::equal(actual,b"ptr mut ptr mut void")}else{bytes::equal(actual,b"ptr mut ptr mut void")};}if(i==21){return if(dependency){bytes::equal(actual,b"c::bool")}else{bytes::equal(actual,b"c::bool")};}if(i==22){return if(dependency){bytes::equal(actual,b"c::char")}else{bytes::equal(actual,b"c::char")};}if(i==23){return if(dependency){bytes::equal(actual,b"c::double")}else{bytes::equal(actual,b"c::double")};}if(i==24){return if(dependency){bytes::equal(actual,b"c::float")}else{bytes::equal(actual,b"c::float")};}if(i==25){return if(dependency){bytes::equal(actual,b"c::int")}else{bytes::equal(actual,b"c::int")};}if(i==26){return if(dependency){bytes::equal(actual,b"c::long")}else{bytes::equal(actual,b"c::long")};}if(i==27){return if(dependency){bytes::equal(actual,b"c::longlong")}else{bytes::equal(actual,b"c::longlong")};}if(i==28){return if(dependency){bytes::equal(actual,b"c::schar")}else{bytes::equal(actual,b"c::schar")};}if(i==29){return if(dependency){bytes::equal(actual,b"c::short")}else{bytes::equal(actual,b"c::short")};}if(i==30){return if(dependency){bytes::equal(actual,b"c::size_t")}else{bytes::equal(actual,b"c::size_t")};}if(i==31){return if(dependency){bytes::equal(actual,b"c::ssize_t")}else{bytes::equal(actual,b"c::ssize_t")};}if(i==32){return if(dependency){bytes::equal(actual,b"c::uchar")}else{bytes::equal(actual,b"c::uchar")};}if(i==33){return if(dependency){bytes::equal(actual,b"c::uint")}else{bytes::equal(actual,b"c::uint")};}if(i==34){return if(dependency){bytes::equal(actual,b"c::ulong")}else{bytes::equal(actual,b"c::ulong")};}if(i==35){return if(dependency){bytes::equal(actual,b"c::ulonglong")}else{bytes::equal(actual,b"c::ulonglong")};}if(i==36){return if(dependency){bytes::equal(actual,b"c::ushort")}else{bytes::equal(actual,b"c::ushort")};}return false;}
