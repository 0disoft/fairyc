// Success is silent except for the exact C packet. Every authored failure has
// a checkpoint before assert, including failures preceding the mixed factory.
@effects(console) fn void require(bool ok,u32 point){if(!ok){discard io::write_stderr("closure-mixed-cache checkpoint=");discard io::write_stderr_u32(point);discard io::write_stderr("\n");assert(false);}}
@effects(console) fn void problem(core::Problem e){discard io::write_stderr("closure-mixed-cache phase/stage/code/module/span=");discard io::write_stderr_u32(e.phase);discard io::write_stderr("/");discard io::write_stderr_u32(e.stage);discard io::write_stderr("/");discard io::write_stderr_u32(e.code);discard io::write_stderr("/");discard io::write_stderr_usize(e.module_index);discard io::write_stderr("/");discard io::write_stderr_usize(e.start);discard io::write_stderr("..");discard io::write_stderr_usize(e.end);discard io::write_stderr("\n");}
@effects(console) fn bytes::Buffer argument(usize index){var u8[4096] raw=[0;4096];let n=switch(process::arg(index,ref mut raw)){case .ok(p):{p}case .err(_):{require(false,1);0}};let ref u8[] view=ref raw;return switch(bytes::copy(view[..n])){case .ok(p):{p}case .err(_):{require(false,2);bytes::empty()}};}
@effects(filesystem,console) fn visibility::Resolved loaded(ref u8[] root){var source_set::Budget budget=source_set::Budget{.files=0,.bytes=0};var usize work=0;return switch(visibility::load(root,ref mut budget,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(visibility::load_phase(ref e));require(false,3);loaded(root)}};}
@effects(filesystem,environment,console) fn environment::Environment current(){var usize work=0;return switch(environment::current(ref mut work)){case .ok(p):{p}case .err(_):{require(false,4);current()}};}
@effects(filesystem,console) fn disk::Store opened(ref u8[] path){return switch(disk::open(path,disk::Limits{.entries=32,.bytes=16777216,.record=8388608,.temporary_age=1})){case .ok(p):{p}case .err(_):{require(false,5);opened(path)}};}
@effects(console) fn core::Complete fresh(ref input::Input source,ref table::Coordinates table,bool aggregate){var usize a=0;var usize b=0;return switch(if(aggregate){core::build_complete_aggregate_sources(input::sources(source),input::owners(source),input::bindings(source),table,ref mut a,ref mut b)}else{core::build_complete_sources(input::sources(source),input::owners(source),input::bindings(source),table,ref mut a,ref mut b)}){case .ok(p):{p}case .err(e):{problem(e);require(false,6);fresh(source,table,aggregate)}};}
@effects(console) fn void same_interfaces(ref core::Complete actual,ref core::Complete expected){let a=core::public_interfaces(actual);let b=core::public_interfaces(expected);require(interfaces::count(a)==3 && interfaces::count(b)==3,7);let empty=state::empty();var usize i=0;while(i<3){let x=interfaces::at(a,i);let y=interfaces::at(b,i);require(interfaces::owner(x)==interfaces::owner(y) && bytes::equal(interfaces::ordinary_hash(x),interfaces::ordinary_hash(y)) && bytes::equal(interfaces::source_hash(x),interfaces::source_hash(y)),8);var usize work=0;let left=switch(codec::encode(ref empty,interfaces::owner(x),interfaces::descriptor(x),ref mut work)){case .ok(p):{p}case .err(_):{require(false,9);return;}};work=0;let right=switch(codec::encode(ref empty,interfaces::owner(y),interfaces::descriptor(y),ref mut work)){case .ok(p):{p}case .err(_):{require(false,10);return;}};require(bytes::equal(bytes::view(ref left),bytes::view(ref right)),11);i+=1;}}
@effects(console) fn void checked(ref core::Complete complete,bool aggregate,bool local){require(!core::is_state_graph(complete),12);let owner=core::checked_program(complete);let p=identified::ir_program(owner);let cleaned=ir::cleanup_ir(p);require(clean::project(cleaned) && clean::closures(cleaned) && clean::aggregates(cleaned)==aggregate && proof::check(p).code==0,13);var usize made=0;var usize mask=0;var usize f=1;while(f<=ir::count(p)){let frame=clean::frame_at(cleaned,f);let body=ir::at(p,f);var usize n=0;while(n<ir::node_count(body)){let value=ir::node_at(body,n).value;if(value.kind==36){var usize captures=0;var usize tail=value.right;while(tail!=0){require(captures<4,14);let at=ir::node(body,tail);require(at!=0,15);tail=ir::node_at(body,at-1).value.right;captures+=1;}var usize work=0;let helper=closures::helper(p,f,value.target,captures,ref mut work);require(helper!=0,16);let target=clean::frame_at(cleaned,helper);require(target.module_index==frame.module_index && target.declaration==value.target,17);made+=1;mask=mask|(1<<captures);}n+=1;}f+=1;}require(if(local){made==1 && mask==2}else{made==5 && mask==31},18);}
@effects(console) fn c::Bundle unreachable(){require(false,21);return unreachable();}
@effects(console) fn c::Bundle published(core::Complete complete,ref input::Input source){var usize work=0;let selected=switch(entry::select(source,identified::ir_program(core::checked_program(ref complete)),ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.kind);require(false,19);return published(complete,source);}};return switch(complete_c::partition_entry(complete,selected,2)){case .ok(p):{require(complete_c::has_complete(ref p),20);p}case .err(e):{discard io::write_stderr_u32(e.code);unreachable()}};}
@effects(console) fn void member(ref u8[] raw){require(io::write_usize(raw.len).is_ok && io::write("\n").is_ok && io::write_bytes(raw).is_ok,22);}
@effects(console) fn void same_bytes(ref u8[] actual,ref u8[] expected,u32 point){if(bytes::equal(actual,expected)){return;}var usize at=0;while(at<actual.len && at<expected.len && actual[at]==expected[at]){at+=1;}discard io::write_stderr("C mismatch point/offset/lengths=");discard io::write_stderr_u32(point);discard io::write_stderr("/");discard io::write_stderr_usize(at);discard io::write_stderr("/");discard io::write_stderr_usize(actual.len);discard io::write_stderr("/");discard io::write_stderr_usize(expected.len);let usize start=if(at>48){at-48}else{0};let usize end=if(actual.len-at>96){at+96}else{actual.len};let usize stop=if(expected.len-at>96){at+96}else{expected.len};discard io::write_stderr("\nactual=");discard io::write_stderr_bytes(actual[start..end]);discard io::write_stderr("\nexpected=");discard io::write_stderr_bytes(expected[start..stop]);discard io::write_stderr("\n");require(false,point);}
// Private C field numbers depend on UNIT partitioning. Compare cache hits with
// independently cold-lowered package UNITs; also retain the independent default
// Complete's interface and verified-source checks in compare_and_emit.
@effects(filesystem,clock,console) fn core::Complete cold_units(ref disk::Store store,ref environment::Environment env,ref input::Input source,ref table::Coordinates table){var work=cache::empty();work.io=disk::work_limit();var usize a=0;var usize b=0;let complete=switch(core::build_complete_aggregate_mixed(store,env,source,table,ref mut work,ref mut a,ref mut b)){case .ok(p):{p}case .err(e):{problem(e);require(false,38);return cold_units(store,env,source,table);}};require(work.hits==0 && work.misses==3 && work.stored==0 && a>0 && b>0,39);return complete;}
@effects(filesystem,clock,console) fn c::Bundle reference_parts(core::Complete expected,ref input::Input source,ref table::Coordinates table,bool aggregate,bool local,ref disk::Store store,ref environment::Environment env){if(!aggregate){return published(expected,source);}let matching=cold_units(store,env,source,table);same_interfaces(ref matching,ref expected);checked(ref matching,aggregate,local);return published(matching,source);}
@effects(filesystem,clock,console) fn void compare_and_emit(core::Complete actual,ref input::Input source,ref table::Coordinates table,bool aggregate,bool local,ref disk::Store store,ref environment::Environment env){let expected=fresh(source,table,aggregate);same_interfaces(ref actual,ref expected);checked(ref actual,aggregate,local);checked(ref expected,aggregate,local);let output=published(actual,source);let reference=reference_parts(expected,source,table,aggregate,local,store,env);let a=c::project_emission(ref output);let b=c::project_emission(ref reference);same_bytes(c::emission_header(a),c::emission_header(b),23);same_bytes(c::emission_literals(a),c::emission_literals(b),230);require(c::emission_unit_count(a)==c::emission_unit_count(b),231);var usize i=0;while(i<c::emission_unit_count(a)){require(bytes::equal(c::emission_source(a,i),c::emission_source(b,i)),24);i+=1;}require(io::write("FYCPARTS1\n").is_ok,25);member(c::emission_header(a));member(c::emission_literals(a));require(io::write_usize(c::emission_unit_count(a)).is_ok && io::write("\n").is_ok,26);i=0;while(i<c::emission_unit_count(a)){member(c::emission_source(a,i));i+=1;}}

@effects(filesystem,environment,clock,console) pub fn i32 run(){
    let root=argument(1);let path=argument(2);let mode_bytes=argument(3);let mode=bytes::view(ref mode_bytes);let feature=argument(4);let aggregate=bytes::equal(bytes::view(ref feature),b"aggregate");let local=bytes::equal(bytes::view(ref feature),b"local");let resolved=loaded(bytes::view(ref root));var usize projection=0;let table=switch(coordinates::collect(visibility::workspace_graph(ref resolved),ref mut projection)){case .ok(p):{p}case .err(_):{require(false,27);return 1;}};let source=switch(input::project(ref resolved,ref mut projection)){case .ok(p):{p}case .err(_):{require(false,28);return 1;}};require(input::count(ref source)==3,29);let store=opened(bytes::view(ref path));let env=current();var cachework=cache::empty();var usize a=0;var usize b=0;var reports=v::empty<diagnostics::Reports>();
    let mixed=if(aggregate){core::build_complete_aggregate_mixed(ref store,ref env,ref source,ref table,ref mut cachework,ref mut a,ref mut b)}else{core::build_complete_mixed(ref store,ref env,ref source,ref table,ref mut reports,ref mut cachework,ref mut a,ref mut b)};
    if(bytes::equal(mode,b"invalid")){let actual=switch(mixed){case .ok(_):{require(false,30);return 1;}case .err(e):{e}};a=0;b=0;let expected=switch(if(aggregate){core::build_complete_aggregate_sources(input::sources(ref source),input::owners(ref source),input::bindings(ref source),ref table,ref mut a,ref mut b)}else{core::build_complete_sources(input::sources(ref source),input::owners(ref source),input::bindings(ref source),ref table,ref mut a,ref mut b)}){case .ok(_):{require(false,31);return 1;}case .err(e):{e}};require(actual.phase==3 && actual.module_index>0 && cachework.misses>0 && cachework.stored==0,32);require(actual.phase==expected.phase && actual.stage==expected.stage && actual.code==expected.code && actual.module_index==expected.module_index && actual.start==expected.start && actual.end==expected.end,33);return 0;}
    let complete=switch(mixed){case .ok(p):{p}case .err(e):{problem(e);require(false,34);return 1;}};let usize hits=if(bytes::equal(mode,b"warm")){3}else if(bytes::equal(mode,b"changed")){2}else{0};if(cachework.hits!=hits || cachework.misses!=3-hits || cachework.stored!=3-hits){discard io::write_stderr("closure-mixed-cache hits/misses/stored=");discard io::write_stderr_usize(cachework.hits);discard io::write_stderr("/");discard io::write_stderr_usize(cachework.misses);discard io::write_stderr("/");discard io::write_stderr_usize(cachework.stored);discard io::write_stderr("\n");}require(cachework.hits==hits && cachework.misses==3-hits && cachework.stored==3-hits,35);if(hits!=0){require(cachework.source>0 && cachework.artifact>0,36);}require(v::len<diagnostics::Reports>(ref reports)==0,37);compare_and_emit(complete,ref source,ref table,aggregate,local,ref store,ref env);return 0;
}
