module tests::generic_package_context;
import generic_package_context as context;
import generic_package_bindings as bindings;
import project_coordinate_graph as coordinate_graph;
import project_source_set as sources;
import project_sdk_bundle as sdk;
import module_public_type_text as coordinates;
import project_module_visibility as visibility;
import project_compiler_input as compiler_input;
import module_catalog as catalog;
import syntax as syntax;
import scanner as scanner;
import file_source as files;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

fn bytes::Buffer join(ref u8[] root,ref u8[] leaf){var bytes::Buffer result=bytes::empty();assert(bytes::append(ref mut result,root).is_ok && bytes::append_byte(ref mut result,47).is_ok && bytes::append(ref mut result,leaf).is_ok);return result;}
@effects(filesystem,console)
fn bytes::Buffer read(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);return switch(files::load(bytes::view(ref path))){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem,console)
fn bytes::Buffer root(){var u8[4096] path=[0;4096];let n=switch(process::arg(1,ref mut path)){case .ok(n):{n}case .err(_):{assert(false);0}};let ref u8[] input=ref path;return switch(files::manifest(input[..n])){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem,console)
fn sdk::Bundle library(ref u8[] path){var v::Vec<sdk::File> input=v::empty<sdk::File>();var usize i=0;while(i<7){assert(v::push<sdk::File>(ref mut input,sdk::file(i+1,read(path,sdk::path(i)))).is_ok);i+=1;}var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;return switch(sdk::assemble(input,false,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return library(path);}};}
@effects(filesystem,console)
fn visibility::Resolved load(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);let bundle=library(root);var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;return switch(visibility::load_sdk(bytes::view(ref path),bundle,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return load(root,leaf);}};}
fn usize number(ref u8[] input,ref mut usize at){assert(*at<=input.len && input.len-*at>=8);var usize n=0;var usize i=0;while(i<8){n=n*256+(input[*at+i] as usize);i+=1;}*at+=8;return n;}
fn ref u8[] field(ref u8[] input,ref mut usize at){let n=number(input,at);assert(*at<=input.len && n<=input.len-*at);let start=*at;*at+=n;return input[start..*at];}
fn syntax::Parsed parsed(ref u8[] source){let b=switch(bytes::copy(source)){case .ok(b):{b}case .err(_):{assert(false);return parsed(source);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(source);}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(source);}};assert(syntax::problem_count(ref p)==0);return p;}
fn usize declaration(ref syntax::Parsed p,ref u8[] name){var usize i=1;while(i<syntax::declaration_count(p)){let d=syntax::declaration_at(p,i);if(bytes::equal(syntax::source_view(p)[d.name_start..d.name_end],name)){return i;}i+=1;}assert(false);return 0;}

fn ref u8[] source(usize mode){
    if(mode==0){return b"module root;import leaf as a0;import leaf as a;import leaf::extra as more;pub resource Handle{i32 value;cleanup{}}fn i32 helper(){return 1;}";}
    if(mode==1){return b"\xef\xbb\xbfmodule leaf;pub struct Leaf{u8[2] values;}struct Generic<T>{T value;}\n";}
    if(mode==2){return b"module leaf::extra;resource Bag{i64 value;cleanup{}}fn i32 secret(){return 7;}\r\n";}
    return b"";
}
fn coordinates::Coordinates table(usize count,usize offset,bool repeat){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<count){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;var u8[64] value=[48;64];if(repeat){while(n<64){value[n]=if(i==0){49}else{50};n+=1;}}else{let ref u8[] digits=b"0123456789abcdef";var usize number=i+1;n=64;while(number!=0){n-=1;value[n]=digits[number%16];number/=16;}}assert(bytes::append(ref mut names,ref value).is_ok && v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+offset,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn v::Vec<syntax::Parsed> source_set(bool reverse,bool edited){var v::Vec<syntax::Parsed> out=v::empty<syntax::Parsed>();var usize i=0;while(i<3){let at=if(reverse){2-i}else{i};let p=if(edited && at==0){parsed(b"module root;import leaf as a0;import leaf as a;import leaf::extra as more;pub resource Handle{i32 value;cleanup{}}fn i32 helper(){return 2;}")}else{parsed(source(at))};assert(v::push<syntax::Parsed>(ref mut out,p).is_ok);i+=1;}return out;}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,bool reverse,usize offset){var v::Vec<usize> own=v::empty<usize>();var usize i=0;while(i<3){let at=if(reverse){2-i}else{i};assert(v::push<usize>(ref mut own,offset+if(at==0){0}else{1}).is_ok);i+=1;}var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();i=0;while(i<3){assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=if(reverse){2}else{0},.declaration=i+2,.target=if(i==2){if(reverse){0}else{2}}else{1}}).is_ok);i+=1;}let coords=table(2,offset,true);var usize meter=0;return switch(bindings::build(sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,reverse,offset);}};}
@effects(console)
fn context::Context computed(ref v::Vec<syntax::Parsed> sources,ref bindings::Bindings bindings,ref mut context::Budget b){return switch(context::compute(sources,bindings,b)){case .ok(value):{value}case .err(code):{var bytes::Buffer out=bytes::empty();discard bytes::append(ref mut out,b"context failure code=");discard bytes::append_u32(ref mut out,code);discard bytes::append(ref mut out,b" work=");discard bytes::append_usize(ref mut out,b.work);discard bytes::append(ref mut out,b" encoded=");discard bytes::append_usize(ref mut out,b.encoded_work);discard bytes::append(ref mut out,b" hashed=");discard bytes::append_usize(ref mut out,b.hashed_bytes);discard io::write_stderr_bytes(bytes::view(ref out));assert(false);return computed(sources,bindings,b);}};}
@effects(filesystem,console)
fn void exact(ref u8[] root,ref u8[] leaf,usize expected){let resolved=load(root,leaf);var usize meter=0;let coords=switch(coordinate_graph::collect(visibility::workspace_graph(ref resolved),ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};meter=0;let projected=switch(compiler_input::project(ref resolved,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};meter=0;let table=switch(bindings::collect(ref projected,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};var context::Budget b=context::empty();let actual=computed(compiler_input::sources(ref projected),ref table,ref mut b);let path=join(root,leaf);let data=read(bytes::view(ref path),b"context.bin");let wire=bytes::view(ref data);assert(bytes::equal(wire[..8],b"FYGPCTX1"));var usize at=8;let size=number(wire,ref mut at);let digest=field(wire,ref mut at);assert(context::json_bytes(ref actual)==size && bytes::equal(context::digest(ref actual),digest) && context::count(ref actual)==expected && number(wire,ref mut at)==expected);var usize i=0;var usize definitions=0;
    while(i<expected){let instance=field(wire,ref mut at);let module_path=field(wire,ref mut at);var usize selected=expected;var usize j=0;while(j<expected){let m=bindings::module_at(ref table,j);if(bytes::equal(compiler_input::instance_id(ref projected,j),instance) && bytes::equal(bindings::text(ref table,m.path),module_path)){assert(selected==expected);selected=j;}j+=1;}assert(selected<expected);let n=number(wire,ref mut at);j=0;while(j<n){let name=field(wire,ref mut at);let expected_digest=field(wire,ref mut at);let p=compiler_input::source(ref projected,selected);b=context::empty();let result=switch(context::definition(ref actual,selected,p,declaration(p,name),ref mut b)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref result),expected_digest));definitions+=1;j+=1;}i+=1;}assert(at==wire.len && definitions>0);
}
@test
@effects(filesystem,console)
fn void matches_go_closed_workspaces_and_package_nominals(){let path=root();exact(bytes::view(ref path),b"Base",14);exact(bytes::view(ref path),b"Edited",14);exact(bytes::view(ref path),b"Reordered",14);exact(bytes::view(ref path),b"Provider",12);}
@test
@effects(filesystem,console)
fn void preserves_sorted_context_across_disposable_owner_and_source_order(){let path=root();let fixture=read(bytes::view(ref path),b"unit-context.bin");let wire=bytes::view(ref fixture);assert(bytes::equal(wire[..8],b"FYGPUNIT"));var usize at=8;let size=number(wire,ref mut at);let digest=field(wire,ref mut at);assert(number(wire,ref mut at)==3);let sources=source_set(false,false);let initial_bindings=bound(ref sources,false,0);var context::Budget b=context::empty();let original=computed(ref sources,ref initial_bindings,ref mut b);assert(context::json_bytes(ref original)==size && bytes::equal(context::digest(ref original),digest));var usize i=0;var usize definitions=0;while(i<3){let raw=field(wire,ref mut at);assert(bytes::equal(raw,source(i)));let n=number(wire,ref mut at);var usize j=0;while(j<n){let name=field(wire,ref mut at);let expected=field(wire,ref mut at);b=context::empty();let p=v::at<syntax::Parsed>(ref sources,i);let result=switch(context::definition(ref original,i,p,declaration(p,name),ref mut b)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref result),expected));definitions+=1;j+=1;}i+=1;}assert(at==wire.len && definitions==3);
    let reordered=source_set(true,false);let renumbered=bound(ref reordered,true,100);b=context::empty();let next=computed(ref reordered,ref renumbered,ref mut b);assert(bytes::equal(context::digest(ref original),context::digest(ref next)));let edited=source_set(false,true);let changed=bound(ref edited,false,0);b=context::empty();let different=computed(ref edited,ref changed,ref mut b);assert(!bytes::equal(context::digest(ref original),context::digest(ref different)));b=context::empty();let old=switch(context::definition(ref original,1,v::at<syntax::Parsed>(ref sources,1),1,ref mut b)){case .ok(value):{value}case .err(_):{assert(false);return;}};b=context::empty();let new=switch(context::definition(ref different,1,v::at<syntax::Parsed>(ref edited,1),1,ref mut b)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(!bytes::equal(bytes::view(ref old),bytes::view(ref new)));
}
@effects(console)
fn context::Context detached(){let sources=source_set(false,false);let bindings=bound(ref sources,false,0);var context::Budget b=context::empty();return computed(ref sources,ref bindings,ref mut b);}
@test
@effects(console)
fn void owns_context_and_rejects_stale_or_invalid_sources(){let owned=detached();let sources=source_set(false,false);let bindings=bound(ref sources,false,0);let stale=source_set(false,true);var context::Budget b=context::empty();assert(switch(context::compute(ref stale,ref bindings,ref mut b)){case .ok(_):{false}case .err(code):{code==12}});let saved=b;b=context::empty();assert(switch(context::definition(ref owned,0,v::at<syntax::Parsed>(ref stale,0),4,ref mut b)){case .ok(_):{false}case .err(code):{code==12}});b=context::empty();assert(switch(context::definition(ref owned,1,v::at<syntax::Parsed>(ref sources,1),2,ref mut b)){case .ok(_):{false}case .err(code):{code==9}});b=context::empty();assert(switch(context::definition(ref owned,3,v::at<syntax::Parsed>(ref sources,0),4,ref mut b)){case .ok(_):{false}case .err(code):{code==9}});let empty=v::empty<syntax::Parsed>();b=context::empty();assert(switch(context::compute(ref empty,ref bindings,ref mut b)){case .ok(_):{false}case .err(code):{code==9}});b=saved;assert(switch(context::compute(ref sources,ref bindings,ref mut b)){case .ok(_):{false}case .err(code):{code==12}});assert(b.work==saved.work && b.encoded_work==saved.encoded_work && b.hashed_bytes==saved.hashed_bytes);b=context::empty();let nominal=switch(context::definition(ref owned,0,v::at<syntax::Parsed>(ref sources,0),4,ref mut b)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::len(ref nominal)==64 && context::count(ref owned)==3);
}
@test
@effects(console)
fn void honors_independent_exact_fit_and_exhausted_histories(){let sources=source_set(false,false);let bindings=bound(ref sources,false,0);var context::Budget cost=context::empty();let original=computed(ref sources,ref bindings,ref mut cost);assert(cost.work>0 && cost.encoded_work>0 && cost.hashed_bytes>0);var usize mode=0;while(mode<3){var context::Budget fit=context::empty();if(mode==0){fit.work=16777216-cost.work;}else if(mode==1){fit.encoded_work=context::encoding_limit()-cost.encoded_work;}else{fit.hashed_bytes=context::hash_limit()-cost.hashed_bytes;}let initial=fit;let actual=computed(ref sources,ref bindings,ref mut fit);assert(bytes::equal(context::digest(ref original),context::digest(ref actual)));assert(if(mode==0){fit.work==16777216}else if(mode==1){fit.encoded_work==context::encoding_limit()}else{fit.hashed_bytes==context::hash_limit()});var context::Budget exhausted=initial;if(mode==0){exhausted.work+=1;}else if(mode==1){exhausted.encoded_work+=1;}else{exhausted.hashed_bytes+=1;}assert(switch(context::compute(ref sources,ref bindings,ref mut exhausted)){case .ok(_):{false}case .err(code):{code==10}});assert(exhausted.work<=16777216 && exhausted.encoded_work<=context::encoding_limit() && exhausted.hashed_bytes<=context::hash_limit());mode+=1;}
    var context::Budget request=context::empty();let expected=switch(context::definition(ref original,0,v::at<syntax::Parsed>(ref sources,0),4,ref mut request)){case .ok(value):{value}case .err(_):{assert(false);return;}};var context::Budget fit=context::Budget{.work=16777216-request.work,.encoded_work=context::encoding_limit()-request.encoded_work,.hashed_bytes=context::hash_limit()-request.hashed_bytes,.code=0};let actual=switch(context::definition(ref original,0,v::at<syntax::Parsed>(ref sources,0),4,ref mut fit)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(fit.work==16777216 && fit.encoded_work==context::encoding_limit() && fit.hashed_bytes==context::hash_limit() && bytes::equal(bytes::view(ref expected),bytes::view(ref actual)));
}
@test
@effects(filesystem,console)
fn void streams_graph_larger_than_one_module_json_allowance(){let path=root();let fixture=read(bytes::view(ref path),b"scale-context.bin");let wire=bytes::view(ref fixture);assert(bytes::equal(wire[..8],b"FYGPSCL1"));var usize at=8;let count=number(wire,ref mut at);let size=number(wire,ref mut at);let expected=field(wire,ref mut at);let raw=field(wire,ref mut at);assert(count==8 && size>1048576 && at==wire.len);let p=parsed(raw);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> own=v::empty<usize>();var usize i=0;while(i<count){var usize work=0;let copy=switch(syntax::copy(ref p,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(v::push<syntax::Parsed>(ref mut sources,copy).is_ok && v::push<usize>(ref mut own,i+100).is_ok);i+=1;}let imports=v::empty<catalog::Binding>();let coords=table(count,100,false);var usize meter=0;let bindings=switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};var context::Budget b=context::empty();let result=computed(ref sources,ref bindings,ref mut b);assert(context::json_bytes(ref result)==size && context::peak_chunk_bytes(ref result)<1048576 && context::peak_chunk_work(ref result)<1048576 && b.encoded_work>1048576 && bytes::equal(context::digest(ref result),expected));
}
