module tests::module_public_templates;
import module_public_templates as public;
import module_source_interface as interface;
import module_generic_interface as generic;
import module_public_interface_extract as extract;
import module_public_interface as ordinary;
import module_signatures as signatures;
import module_unit_interfaces as typed;
import module_unit_bind as bind;
import module_ast_join as join;
import generic_source_dependencies as dependencies;
import generic_source_dependency_model as model;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::fs as fs;
import std::text as text;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

pub resource Context{v::Vec<syntax::Parsed> sources;signatures::Program metadata;typed::Interfaces types;coordinates::Coordinates coordinates;model::Graph templates;cleanup{}}
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}

fn coordinates::Coordinates table(usize shift,bool changed,bool missing){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize digit=1;while(digit<=3 && !missing){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut names,if(changed && digit==1){52}else if(digit==1){49}else if(digit==2){50}else{51}).is_ok);i+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);digit+=1;}return coordinates::assemble(names,rows);}
fn join::Problem failure(u32 phase,u32 code,usize module_index,usize start,usize end){return join::Problem{.code=phase+code,.module_index,.start,.end};}
fn Result<Context,join::Problem> context(v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,usize shift){let coordinates=table(shift,false,false);var usize work=0;let resolved=switch(bindings::build(ref sources,owners,imports,ref coordinates,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,0,0));}};work=0;let c=switch(templates::build(resolved,ref sources,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,0,0));}};work=0;let graph=switch(dependencies::build(c,ref sources,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,p.start,p.end));}};let declarations=switch(catalog::build_scoped(ref sources,owners,imports)){case .ok(value):{value}case .err(p):{return .err(failure(200000,p.code,p.module_index,p.start,p.end));}};let metadata=switch(signatures::build_catalog(ref sources,declarations)){case .ok(value):{value}case .err(p):{return .err(failure(300000,p.code,p.module_index,p.start,p.end));}};let bound=switch(bind::bind(ref sources,ref metadata,0,v::len<syntax::Parsed>(ref sources))){case .ok(value):{value}case .err(p):{return .err(failure(400000,p.code,p.module_index,p.start,p.end));}};let types=switch(typed::build(ref sources,ref metadata,ref bound)){case .ok(value):{value}case .err(p):{return .err(failure(500000,p.code,p.module_index,p.start,p.end));}};return .ok(Context{.sources,.metadata,.types,.coordinates,.templates=graph});}

@test
@effects(filesystem,console)
fn void actual_public_templates_and_source_interfaces_match_go(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPUB01"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==6);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let count=number(wire,ref mut at);let usize shift=if(c==2){19}else{0};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut at)+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let input=switch(context(sources,ref owners,ref imports,shift)){case .ok(value):{value}case .err(code):{discard io::write_stderr_bytes(label);discard io::write_stderr(" context ");discard io::write_stderr_u32(code.code);discard io::write_stderr(" module ");discard io::write_stderr_usize(code.module_index);discard io::write_stderr(" span ");discard io::write_stderr_usize(code.start);discard io::write_stderr("..");discard io::write_stderr_usize(code.end);assert(false);return;}};assert(number(wire,ref mut at)==3);var usize package=0;while(package<3){let digit=number(wire,ref mut at);let owner=digit+shift;let expected=number(wire,ref mut at);var usize work=0;let public=switch(public::collect(ref input.templates,owner,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(generic::count(ref public)==expected);i=0;while(i<expected){let row=generic::at(ref public,i);assert(bytes::equal(generic::text(ref public,row.module_path),field(wire,ref mut at)) && bytes::equal(generic::text(ref public,row.name),field(wire,ref mut at)) && bytes::equal(generic::text(ref public,row.closure),field(wire,ref mut at)));i+=1;}let ordinary_expected=field(wire,ref mut at);let generic_expected=field(wire,ref mut at);work=0;if(digit!=3){let digest=switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,owner,ref mut work)){case .ok(value):{value}case .err(code):{discard io::write_stderr_bytes(label);discard io::write_stderr_usize(digit);discard io::write_stderr_u32(code);assert(false);return;}};assert(bytes::equal(bytes::view(ref digest),generic_expected));work=0;let projection=switch(extract::extract(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,owner,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};work=0;let ordinary=switch(ordinary::hash(signatures::state_layouts(ref input.metadata),owner,extract::descriptor(ref projection),ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref ordinary),ordinary_expected));}else{assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,owner,ref mut work)){case .ok(_):{false}case .err(code):{code==4503}});}package+=1;}c+=1;}assert(at==wire.len);}
fn Context small(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;pub fn T api<T>(T value){return value;}fn T secret<T>(T value){return value;}pub fn i32 plain(){return 7;}")).is_ok);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,1).is_ok);let imports=v::empty<catalog::Binding>();return switch(context(sources,ref owners,ref imports,0)){case .ok(value):{value}case .err(_):{assert(false);return small();}};}
@test
fn void source_interface_rejects_changed_import_provider(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;import helper as h;pub fn T api<T>(T value){return h::id<T>(value);}pub fn i32 plain(){return 7;}")).is_ok);var usize i=0;while(i<2){assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module helper;pub fn T id<T>(T value){return value;}")).is_ok);i+=1;}var v::Vec<usize> owners=v::empty<usize>();i=1;while(i<=3){assert(v::push<usize>(ref mut owners,i).is_ok);i+=1;}var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);let input=switch(context(sources,ref owners,ref imports,0)){case .ok(value):{value}case .err(_):{assert(false);return;}};{let slot=v::at_mut<catalog::Binding>(ref mut imports,0);slot.target=2;}let declarations=switch(catalog::build_scoped(ref input.sources,ref owners,ref imports)){case .ok(value):{value}case .err(_):{assert(false);return;}};let changed=switch(signatures::build_catalog(ref input.sources,declarations)){case .ok(value):{value}case .err(_):{assert(false);return;}};var usize work=0;assert(switch(interface::hash(ref input.sources,ref changed,ref input.types,ref input.coordinates,ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});work=0;assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,1,ref mut work)){case .ok(_):{true}case .err(_):{false}});}
@test
fn void detached_public_projection_excludes_private_and_rejects_missing_owner(){let input=small();var usize work=0;let projected=switch(public::collect(ref input.templates,1,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(generic::count(ref projected)==1);let row=generic::at(ref projected,0);assert(bytes::equal(generic::text(ref projected,row.module_path),b"root") && bytes::equal(generic::text(ref projected,row.name),b"api"));work=0;assert(switch(public::collect(ref input.templates,9,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});work=0;assert(switch(public::collect(ref input.templates,512,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});}
@test
fn void source_interface_rejects_stale_owner_and_coordinate_context(){let input=small();let changed=table(0,true,false);let missing=table(0,false,true);var usize work=0;assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref changed,ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});work=0;assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref missing,ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});var v::Vec<syntax::Parsed> stale=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut stale,parsed(b"module root;pub fn T api<T>(T value){return value;}fn T secret<T>(T value){return value;}pub fn i32 plain(){return 8;}")).is_ok);work=0;assert(switch(interface::hash(ref stale,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==12}});work=0;assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,9,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});}
@test
fn void source_projection_and_interface_honor_exact_project_work(){let input=small();var usize cost=0;let projected=switch(public::collect(ref input.templates,1,ref mut cost)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(cost>0 && cost<16777216);var usize work=16777216-cost;assert(switch(public::collect(ref input.templates,1,ref mut work)){case .ok(value):{generic::count(ref value)==generic::count(ref projected)}case .err(_):{false}} && work==16777216);work=16777216-cost+1;assert(switch(public::collect(ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});cost=0;let expected=switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,1,ref mut cost)){case .ok(value):{value}case .err(_):{assert(false);return;}};work=16777216-cost;let exact=switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,1,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(work==16777216 && bytes::equal(bytes::view(ref expected),bytes::view(ref exact)));work=16777216-cost+1;assert(switch(interface::hash(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,1,ref mut work)){case .ok(_):{false}case .err(code):{code==10}} && work<=16777216);}
