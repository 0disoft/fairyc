module tests::module_unit_origin_region;
import module_unit_origin_diagnostics as diagnostics;
import module_unit_origin_returns as origins;
import module_unit_values as values;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
import module_unit_origin_check as checker;
import std::process as process;
import file_source as files;
import module_unit_origin_inputs as lifetime_inputs;
import module_unit_origin_flow_model as lifetime;
import module_unit_origin_sets as lifetime_sets;
import module_unit_origin_provenance as lifetime_sites;
fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(console) fn values::Plan primary(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return primary(sources,metadata);}};let ready=switch(closure::build(sources,metadata,ref bound)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return primary(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);primary(sources,metadata)}};}
@effects(filesystem) fn syntax::Parsed allocator(){var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let n=switch(process::arg(1,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return allocator();}};let data=switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);return allocator();}};return parsed(bytes::view(ref data));}
@effects(filesystem,console) fn diagnostics::Report checked(ref u8[] root,ref u8[] provider){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,allocator()).is_ok);if(provider.len!=0){assert(v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);}let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(p):{discard io::write("metadata problem ");discard io::write_u32(p.code);discard io::write(" module ");discard io::write_usize(p.module_index);discard io::write(" span ");discard io::write_usize(p.start);discard io::write("..");discard io::write_usize(p.end);discard io::write("\n");assert(false);return checked(root,provider);}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(p):{discard io::write("origin problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return checked(root,provider);}};return switch(diagnostics::collect(ref p)){case .ok(p):{p}case .err(_):{assert(false);checked(root,provider)}};}
@effects(console) fn void emit(usize case_index,ref diagnostics::Report p){
    discard io::write("case ");discard io::write_usize(case_index);discard io::write(" ");discard io::write_u32(diagnostics::exit_code(p));discard io::write(" ");discard io::write_usize(diagnostics::visible_count(p));discard io::write("\n");var usize i=0;while(i<diagnostics::count(p)){if(!diagnostics::visible_at(p,i)){i+=1;continue;}let d=diagnostics::at(p,i);discard io::write("diagnostic ");discard io::write_u32(d.code);discard io::write(" ");discard io::write_usize(d.module_index);discard io::write(" ");discard io::write_usize(d.start);discard io::write(" ");discard io::write_usize(d.end);discard io::write(" ");discard io::write_usize(d.related_count);discard io::write("\n");var usize j=0;while(j<d.related_count){let r=diagnostics::related_at(p,d,j);discard io::write("related ");discard io::write_u32(r.role);discard io::write(" ");discard io::write_usize(r.module_index);discard io::write(" ");discard io::write_usize(r.start);discard io::write(" ");discard io::write_usize(r.end);discard io::write("\n");j+=1;}i+=1;}
}


@test @effects(filesystem,console) fn void allocated_returns_follow_region_inputs(){
    let p0=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region r,i32 n){return r.place(n);}",b"");emit(0,ref p0);assert(diagnostics::exit_code(ref p0)==0);
    let p1=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region r,i32 n){return .ok(r.place(n)?);}",b"");emit(1,ref p1);assert(diagnostics::exit_code(ref p1)==0);
    let p2=checked(b"module main;fn ref i32 f(Region r,i32 n){return switch(r.place(n)){case .ok(v):{v}case .err(e):{assert(false);}};}",b"");emit(2,ref p2);assert(diagnostics::exit_code(ref p2)==0);
    let p3=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region x,Region y,bool c){return if(c){x.place(1)}else{y.place(2)};}",b"");emit(3,ref p3);assert(diagnostics::exit_code(ref p3)==3);
    let p4=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region r,ref i32 a,bool c){return .ok(if(c){r.place(1)?}else{a});}",b"");emit(4,ref p4);assert(diagnostics::exit_code(ref p4)==3);
    let p5=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> store(Region r,i32 n){return r.place(n);}fn Result<ref i32,a::AllocError> f(Region r){return store(r,3);}",b"");emit(5,ref p5);assert(diagnostics::exit_code(ref p5)==0);
    let p6=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> store(i32 n,Region r){return r.place(n);}fn Result<ref i32,a::AllocError> f(Region r){return store(3,r);}",b"");emit(6,ref p6);assert(diagnostics::exit_code(ref p6)==0);
    let p7=checked(b"module main;import std::alloc as a;import provider as p;fn Result<ref i32,a::AllocError> f(Region r){return p::store(r,3);}",b"module provider;import std::alloc as a;pub fn Result<ref i32,a::AllocError> store(Region r,i32 n){return r.place(n);}");emit(7,ref p7);assert(diagnostics::exit_code(ref p7)==0);
    let p8=checked(b"module main;import std::alloc as a;fn Result<ref T,a::AllocError> store<T>(Region r,T n){return r.place(n);}fn Result<ref i32,a::AllocError> f(Region r){return store<i32>(r,3);}",b"");emit(8,ref p8);assert(diagnostics::exit_code(ref p8)==0);
    let p9=checked(b"module main;import std::alloc as a;struct S{i32 n;}fn Result<ref S,a::AllocError> f(Region r){return r.place(S{.n=3});}",b"");emit(9,ref p9);assert(diagnostics::exit_code(ref p9)==0);
    let p10=checked(b"module main;import std::alloc as a;enum E{None;Value{i32 n;};}fn Result<ref E,a::AllocError> f(Region r){let E v=.Value{.n=3};return r.place(v);}",b"");emit(10,ref p10);assert(diagnostics::exit_code(ref p10)==0);
    let p11=checked(b"module main;import std::alloc as a;fn Result<ref Option<i32>,a::AllocError> f(Region r){let Option<i32> v=.some(3);return r.place(v);}",b"");emit(11,ref p11);assert(diagnostics::exit_code(ref p11)==0);
    let p12=checked(b"module main;fn i32 f(Region r){let i32[2] v=[1,2];discard r.place(v);return 7;}",b"");emit(12,ref p12);assert(diagnostics::exit_code(ref p12)==0);
    let p13=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region r,bool c){return if(c){r.place(1)}else{r.place(2)};}",b"");emit(13,ref p13);assert(diagnostics::exit_code(ref p13)==0);
    let p14=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(Region r,bool c){if(c){return r.place(3);};return f(r,true);}",b"");emit(14,ref p14);assert(diagnostics::exit_code(ref p14)==2);
    let p15=checked(b"module main;fn void f(Region r){let ptr void p=null;discard r.place(p);}",b"");emit(15,ref p15);assert(diagnostics::exit_code(ref p15)==0);
    let p16=checked(b"module main;import std::alloc as a;struct U{i32 n;}struct S{U first;Option<U> later;}fn Result<ref S,a::AllocError> f(Region r){return r.place(S{.first=U{.n=1},.later=.some(U{.n=2})});}",b"");emit(16,ref p16);assert(diagnostics::exit_code(ref p16)==0);
}

@test @effects(filesystem,console) fn void local_region_escapes_keep_allocation_sites(){
    let q0=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{return r.place(1);}}",b"");emit(0,ref q0);assert(diagnostics::exit_code(ref q0)==3 && diagnostics::visible_count(ref q0)==1);
    let q1=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{let x=r.place(1)?;return .ok(x);}}",b"");emit(1,ref q1);assert(diagnostics::exit_code(ref q1)==3 && diagnostics::visible_count(ref q1)==1);
    let q2=checked(b"module main;import std::alloc as a;fn ref i32 f(ref mut a::Arena arena){region r in arena{return switch(r.place(1)){case .ok(x):{x}case .err(_):{assert(false);}};}}",b"");emit(2,ref q2);assert(diagnostics::exit_code(ref q2)==3 && diagnostics::visible_count(ref q2)==1);
    let q3=checked(b"module main;import std::alloc as a;fn Option<ref i32> f(ref mut a::Arena arena){region r in arena{let x=switch(r.place(1)){case .ok(x):{x}case .err(_):{assert(false);}};return .some(x);}}",b"");emit(3,ref q3);assert(diagnostics::exit_code(ref q3)==3 && diagnostics::visible_count(ref q3)==1);
    let q4=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{discard r.place(1);return r.place(2);}}",b"");emit(4,ref q4);assert(diagnostics::exit_code(ref q4)==3 && diagnostics::visible_count(ref q4)==1);
    let q5=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,bool c){region r in arena{let x=if(c){r.place(1)}else{r.place(2)};return x;}}",b"");emit(5,ref q5);assert(diagnostics::exit_code(ref q5)==3 && diagnostics::visible_count(ref q5)==1);
    let q6=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,ref mut a::Arena other,bool c){region r in arena{region s in other{let x=if(c){r.place(1)}else{s.place(2)};return x;}}}",b"");emit(6,ref q6);assert(diagnostics::exit_code(ref q6)==3 && diagnostics::visible_count(ref q6)==1);
    let q7=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,Region input,bool c){region r in arena{let x=if(c){r.place(1)}else{input.place(2)};return x;}}",b"");emit(7,ref q7);assert(diagnostics::exit_code(ref q7)==3 && diagnostics::visible_count(ref q7)==1);
    let q8=checked(b"module main;import std::alloc as a;fn ref i32 id(ref i32 x){return x;}fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{let x=r.place(1)?;return .ok(id(x));}}",b"");emit(8,ref q8);assert(diagnostics::exit_code(ref q8)==3 && diagnostics::visible_count(ref q8)==1);
    let q9=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> store(Region r){return r.place(3);}fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{return store(r);}}",b"");emit(9,ref q9);assert(diagnostics::exit_code(ref q9)==3 && diagnostics::visible_count(ref q9)==1);
    let q10=checked(b"module main;import std::alloc as a;import provider as p;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{return p::store(r);}}",b"module provider;import std::alloc as a;pub fn Result<ref i32,a::AllocError> store(Region r){return r.place(3);}");emit(10,ref q10);assert(diagnostics::exit_code(ref q10)==3 && diagnostics::visible_count(ref q10)==1);
    let q11=checked(b"module main;import std::alloc as a;fn Result<ref T,a::AllocError> store<T>(Region r,T x){return r.place(x);}fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{return store<i32>(r,3);}}",b"");emit(11,ref q11);assert(diagnostics::exit_code(ref q11)==3 && diagnostics::visible_count(ref q11)==1);
    let q12=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> choose(Region a,Region b,bool c){return if(c){a.place(1)}else{b.place(2)};}fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,bool c){region r in arena{return choose(r,r,c);}}",b"");emit(12,ref q12);assert(diagnostics::exit_code(ref q12)==3 && diagnostics::visible_count(ref q12)==2);
    let q13=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,Region input){region r in arena{discard r.place(1);return input.place(2);}}",b"");emit(13,ref q13);assert(diagnostics::exit_code(ref q13)==0 && diagnostics::visible_count(ref q13)==0);
    let q14=checked(b"module main;import std::alloc as a;fn ref i32 f(ref mut a::Arena arena,ref i32 x){region r in arena{discard r.place(1);return x;}}",b"");emit(14,ref q14);assert(diagnostics::exit_code(ref q14)==0 && diagnostics::visible_count(ref q14)==0);
    let q15=checked(b"module main;import std::alloc as a;fn Option<ref i32> f(ref mut a::Arena arena){region r in arena{return .none;}}",b"");emit(15,ref q15);assert(diagnostics::exit_code(ref q15)==0 && diagnostics::visible_count(ref q15)==0);
    let q16=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena,bool c){while(c){region r in arena{let x=r.place(1)?;return .ok(x);}}return .err(a::AllocError{.status=1});}",b"");emit(16,ref q16);assert(diagnostics::exit_code(ref q16)==3 && diagnostics::visible_count(ref q16)==1);
    let q17=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> again(Region r){return again(r);}fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{return again(r);}}",b"");emit(17,ref q17);assert(diagnostics::exit_code(ref q17)==2 && diagnostics::visible_count(ref q17)==2);
    let q18=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{var x=r.place(1)?;x=r.place(2)?;return .ok(x);}}",b"");emit(18,ref q18);assert(diagnostics::exit_code(ref q18)==3 && diagnostics::visible_count(ref q18)==1);
    let q19=checked(b"module main;import std::alloc as a;fn Result<i32,ref i32> error(ref i32 x){return .err(x);}fn Result<i32,ref i32> f(ref mut a::Arena arena){region r in arena{let x=switch(r.place(1)){case .ok(x):{x}case .err(_):{assert(false);}};discard error(x)?;return .ok(3);}}",b"");emit(19,ref q19);assert(diagnostics::exit_code(ref q19)==3 && diagnostics::visible_count(ref q19)==1);
    let q20=checked(b"module main;import std::alloc as a;fn Result<ref i32,a::AllocError> f(ref mut a::Arena arena){region r in arena{discard r.place(1);return .err(a::AllocError{.status=1});}}",b"");emit(20,ref q20);assert(diagnostics::exit_code(ref q20)==0 && diagnostics::visible_count(ref q20)==0);
}

@effects(filesystem,console) fn void lifetime_case(usize index,ref u8[] text,ref u8[] provider,u32 expected){let p=checked(text,provider);emit(index,ref p);assert(diagnostics::exit_code(ref p)==expected);if(expected==0){assert(diagnostics::visible_count(ref p)==0);}else{assert(diagnostics::visible_count(ref p)>0);var usize i=0;while(i<diagnostics::count(ref p)){if(diagnostics::visible_at(ref p,i)){let d=diagnostics::at(ref p,i);assert(d.code==3101 && d.related_count==1);let r=diagnostics::related_at(ref p,d,0);assert(r.role==3 && r.start<r.end && d.start<d.end);}i+=1;}}}
@test @effects(filesystem,console) fn void region_borrows_expire_across_control_flow_and_reentry(){
    lifetime_case(0,b"module main;import std::alloc as alloc;fn i32 f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}return switch(x){case .some(p):{*p}case .none:{0}};}",b"",3);
    lifetime_case(1,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}discard x;}",b"",3);
    lifetime_case(2,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};x=.none;}discard x;}",b"",0);
    lifetime_case(3,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}x=.none;discard x;}",b"",0);
    lifetime_case(4,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};discard x;}}",b"",0);
    lifetime_case(5,b"module main;import std::alloc as alloc;fn i32 f(Region r){return switch(r.place(3)){case .ok(p):{*p}case .err(_):{0}};}",b"",0);
    lifetime_case(6,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,ref mut alloc::Arena b){var Option<ref i32> x=.none;region outer in a{region r in b{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}discard x;}}",b"",3);
    lifetime_case(7,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,ref mut alloc::Arena b){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};region inner in b{}discard x;}}",b"",0);
    lifetime_case(8,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,bool c){var Option<ref i32> x=.none;while(c){region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};break;}}discard x;}",b"",3);
    lifetime_case(9,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,bool c){var Option<ref i32> x=.none;while(c){region r in a{discard x;switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};continue;}}x=.none;discard x;}",b"",3);
    lifetime_case(10,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,bool c){var Option<ref i32> x=.none;while(c){region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{x=.none;}};discard x;continue;}}x=.none;discard x;}",b"",0);
    lifetime_case(11,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,bool c){var Option<ref i32> x=.none;if(c){region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}}else{};discard x;}",b"",3);
    lifetime_case(12,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};assert(false);}discard x;}",b"",0);
    lifetime_case(13,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};}let y=x;discard y;}",b"",3);
    lifetime_case(14,b"module main;import std::alloc as alloc;import provider as provider;fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{x=provider::store(r);}discard x;}",b"module provider;import std::alloc as alloc;pub fn Option<ref i32> store(Region r){return switch(r.place(3)){case .ok(p):{.some(p)}case .err(_):{.none}};}",3);
    lifetime_case(15,b"module main;import std::alloc as alloc;fn Option<ref T> store<T>(Region r,T n){return switch(r.place(n)){case .ok(p):{.some(p)}case .err(_):{.none}};}fn void f(ref mut alloc::Arena a){var Option<ref i32> x=.none;region r in a{x=store<i32>(r,3);}discard x;}",b"",3);
    lifetime_case(16,b"module main;import std::alloc as alloc;fn void f(ref mut alloc::Arena a,bool c){var Option<ref i32> x=.none;while(c){region r in a{switch(r.place(3)){case .ok(p):{x=.some(p);}case .err(_):{}};discard x;continue;}}x=.none;discard x;}",b"",3);
}

@test @effects(filesystem,console) fn void abstract_static_origin_does_not_hide_expired_region(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import std::alloc as a;fn void f(ref mut a::Arena input){region r in input{discard r.place(3);}}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,allocator()).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let typed=primary(ref sources,ref metadata);let plan=switch(origins::build(ref sources,ref metadata,ref typed)){case .ok(p):{p}case .err(_):{assert(false);return;}};let input=origins::owned_inputs(ref plan);
    var usize owner=1;while(owner<=lifetime_inputs::owner_count(input) && lifetime_inputs::owner(input,owner).kind!=14){owner+=1;}assert(owner<=lifetime_inputs::owner_count(input));let source=lifetime_inputs::owner(input,owner);let frame=lifetime_inputs::frame(input,source.frame);var usize site=1;while(site<=lifetime_inputs::allocation_count(input) && lifetime_inputs::allocation(input,site).frame!=source.frame){site+=1;}assert(site<=lifetime_inputs::allocation_count(input));let allocation=lifetime_inputs::allocation(input,site);
    var lifetime::Context c=lifetime::Context{.frame=source.frame,.value=frame.value,.borrower=false,.tagged_return=false,.sites=0,.returned=0,.allocation=0,.seen=false,.work=0,.loop_depth=0,.probes=0};var v::Vec<lifetime_sets::Entry> entries=v::empty<lifetime_sets::Entry>();var v::Vec<usize> members=v::empty<usize>();var v::Vec<lifetime_sites::Row> sites=lifetime_sites::empty();var v::Vec<lifetime::Unknown> violations=v::empty<lifetime::Unknown>();let usize leaf=owner+2;
    let mixed=switch(lifetime_sets::join(ref mut entries,ref mut members,2,leaf,ref mut c.work)){case .ok(n):{n}case .err(_):{assert(false);return;}};let map=switch(lifetime_sites::single(ref mut sites,leaf,site,ref mut c.work)){case .ok(n):{n}case .err(_):{assert(false);return;}};
    let alive=lifetime::check_lifetime(input,lifetime::Value{.origin=mixed,.allocation=map},ref entries,ref members,ref sites,ref mut violations,ref mut c,allocation.start,allocation.end);assert(alive.code==0 && v::len<lifetime::Unknown>(ref violations)==0);
    let dead=switch(lifetime_sites::expire(ref mut sites,map,leaf,ref mut c.work)){case .ok(n):{n}case .err(_):{assert(false);return;}};let expired=lifetime::check_lifetime(input,lifetime::Value{.origin=mixed,.allocation=dead},ref entries,ref members,ref sites,ref mut violations,ref mut c,allocation.start,allocation.end);assert(expired.code==0 && v::len<lifetime::Unknown>(ref violations)==1);let failure=*v::at<lifetime::Unknown>(ref violations,0);assert(failure.kind==4 && failure.origin==leaf && failure.allocation==site);
}
