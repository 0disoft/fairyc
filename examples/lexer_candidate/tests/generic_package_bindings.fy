module tests::generic_package_bindings;
import generic_package_bindings as bindings;
import generic_source_json as json;
import project_coordinate_graph as coordinate_graph;
import project_workspace_graph as graph;
import project_source_set as sources;
import project_sdk_bundle as sdk;
import module_public_type_text as coordinates;
import project_module_visibility as visibility;
import project_compiler_input as compiler_input;
import module_catalog as catalog;
import syntax as syntax;
import scanner as scanner;
import file_source as files;
import std::bytes as bytes;
import std::process as process;
import std::vec as v;

fn bytes::Buffer join(ref u8[] root,ref u8[] leaf){var bytes::Buffer result=bytes::empty();assert(bytes::append(ref mut result,root).is_ok && bytes::append_byte(ref mut result,47).is_ok && bytes::append(ref mut result,leaf).is_ok);return result;}
@effects(filesystem)
fn bytes::Buffer read(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);return switch(files::load(bytes::view(ref path))){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem)
fn bytes::Buffer root(){var u8[4096] path=[0;4096];let n=switch(process::arg(1,ref mut path)){case .ok(n):{n}case .err(_):{assert(false);0}};let ref u8[] input=ref path;return switch(files::manifest(input[..n])){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem)
fn sdk::Bundle library(ref u8[] path){var v::Vec<sdk::File> input=v::empty<sdk::File>();var usize i=0;while(i<7){assert(v::push<sdk::File>(ref mut input,sdk::file(i+1,read(path,sdk::path(i)))).is_ok);i+=1;}var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;return switch(sdk::assemble(input,false,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return library(path);}};}
@effects(filesystem)
fn visibility::Resolved load(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);let bundle=library(root);var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;return switch(visibility::load_sdk(bytes::view(ref path),bundle,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return load(root,leaf);}};}
fn usize number(ref u8[] input,ref mut usize at){assert(*at<=input.len && input.len-*at>=8);var usize n=0;var usize i=0;while(i<8){n=n*256+(input[*at+i] as usize);i+=1;}*at+=8;return n;}
fn ref u8[] field(ref u8[] input,ref mut usize at){let n=number(input,at);assert(*at<=input.len && n<=input.len-*at);let start=*at;*at+=n;return input[start..*at];}
fn syntax::Parsed parsed(ref u8[] source){let b=switch(bytes::copy(source)){case .ok(b):{b}case .err(_):{assert(false);return parsed(source);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(source);}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(source);}};assert(syntax::problem_count(ref p)==0);return p;}
fn usize declaration(ref syntax::Parsed p,ref u8[] name){var usize i=1;while(i<syntax::declaration_count(p)){let d=syntax::declaration_at(p,i);if(bytes::equal(syntax::source_view(p)[d.name_start..d.name_end],name)){return i;}i+=1;}assert(false);return 0;}
@effects(filesystem)
fn void exact(ref u8[] root,ref u8[] leaf,usize expected){let resolved=load(root,leaf);var usize meter=0;let coords=switch(coordinate_graph::collect(visibility::workspace_graph(ref resolved),ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};meter=0;let projected=switch(compiler_input::project(ref resolved,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};meter=0;let table=switch(bindings::collect(ref projected,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bindings::count(ref table)==expected && bindings::import_count(ref table)==9);let path=join(root,leaf);let data=read(bytes::view(ref path),b"bindings.bin");let wire=bytes::view(ref data);assert(wire.len>=16 && bytes::equal(wire[..8],b"FYGPBND1"));var usize at=8;assert(number(wire,ref mut at)==expected);var usize i=0;var usize definitions=0;var v::Vec<bool> seen=v::empty<bool>();while(i<expected){assert(v::push<bool>(ref mut seen,false).is_ok);i+=1;}i=0;
    while(i<expected){let instance=field(wire,ref mut at);let path=field(wire,ref mut at);let owner=field(wire,ref mut at);let golden=field(wire,ref mut at);var usize selected=expected;var usize j=0;while(j<expected){let m=bindings::module_at(ref table,j);if(bytes::equal(compiler_input::instance_id(ref projected,j),instance) && bytes::equal(bindings::text(ref table,m.path),path)){assert(selected==expected);selected=j;}j+=1;}assert(selected<expected && !*v::at<bool>(ref seen,selected));let slot=v::at_mut<bool>(ref mut seen,selected);*slot=true;let m=bindings::module_at(ref table,selected);assert(bytes::equal(bindings::text(ref table,m.namespace),owner));var usize work=0;let actual=switch(bindings::encode(ref table,selected,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref actual),golden));let n=number(wire,ref mut at);j=0;while(j<n){let name=field(wire,ref mut at);let digest=field(wire,ref mut at);let p=compiler_input::source(ref projected,selected);work=0;let actual=switch(bindings::definition(ref table,selected,p,declaration(p,name),ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref actual),digest));definitions+=1;j+=1;}i+=1;
    }assert(at==wire.len && definitions==if(expected==14){7}else{5});
}
@test
@effects(filesystem)
fn void matches_go_resolved_workspace_providers_and_definitions(){let path=root();exact(bytes::view(ref path),b"Base",14);exact(bytes::view(ref path),b"Edited",14);exact(bytes::view(ref path),b"Reordered",14);exact(bytes::view(ref path),b"Provider",12);}

fn coordinates::Coordinates table(usize mode){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<3){let start=bytes::len(ref names);let digit=if(i==0 || mode==1){b"1"}else if(i==1){b"2"}else{b"3"};assert(bytes::append(ref mut names,if(mode==2){b"fypi1-sha256-"}else{b"fypc1-sha256-"}).is_ok);var usize n=0;while(n<64){assert(bytes::append(ref mut names,if(mode==3){b"0"}else{digit}).is_ok);n+=1;}if(mode!=4 || i!=2){assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i,.start,.end=bytes::len(ref names)}).is_ok);}i+=1;}if(mode==5){assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=77,.end=154}).is_ok);}if(mode==6){assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=0,.start=300,.end=376}).is_ok);}return coordinates::assemble(names,rows);}
fn ref u8[] source(usize mode){if(mode==0){return b"module root;import common as a;import common as a0;pub fn T id<T>(T value){return value;}";}if(mode==1){return b"module common;pub struct Box<T>{T value;}";}return b"module common;pub resource Hold<T>{T value;cleanup{}}";}
fn v::Vec<syntax::Parsed> source_set(){var v::Vec<syntax::Parsed> values=v::empty<syntax::Parsed>();var usize i=0;while(i<3){assert(v::push<syntax::Parsed>(ref mut values,parsed(source(i))).is_ok);i+=1;}return values;}
fn v::Vec<usize> owners(){var v::Vec<usize> values=v::empty<usize>();var usize i=0;while(i<3){assert(v::push<usize>(ref mut values,i).is_ok);i+=1;}return values;}
fn v::Vec<catalog::Binding> resolved(usize mode){var v::Vec<catalog::Binding> values=v::empty<catalog::Binding>();if(mode==1){return values;}let usize target=if(mode==2){99}else if(mode==3){0}else if(mode==7){2}else{1};assert(v::push<catalog::Binding>(ref mut values,catalog::Binding{.source=0,.declaration=if(mode==6){3}else{2},.target}).is_ok);assert(v::push<catalog::Binding>(ref mut values,catalog::Binding{.source=0,.declaration=if(mode==4 || mode==6){2}else{3},.target}).is_ok);if(mode==5){assert(v::push<catalog::Binding>(ref mut values,catalog::Binding{.source=1,.declaration=1,.target=2}).is_ok);}return values;}
fn bindings::Bindings detached(usize provider,ref mut usize meter){let sources=source_set();let own=owners();let imports=resolved(provider);let coords=table(0);return switch(bindings::build(ref sources,ref own,ref imports,ref coords,meter)){case .ok(value):{value}case .err(_):{assert(false);return detached(provider,meter);}};}
@test
fn void rejects_invalid_bindings_coordinates_and_stale_source(){let sources=source_set();let own=owners();let imports=resolved(0);let coords=table(0);var usize meter=0;let original=switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};var usize mode=1;while(mode<=6){let invalid=resolved(mode);meter=0;assert(switch(bindings::build(ref sources,ref own,ref invalid,ref coords,ref mut meter)){case .ok(_):{false}case .err(p):{p.code==9}});mode+=1;}mode=1;while(mode<=6){let invalid=table(mode);meter=0;assert(switch(bindings::build(ref sources,ref own,ref imports,ref invalid,ref mut meter)){case .ok(_):{false}case .err(p):{p.code==9}});mode+=1;}
    let stale=parsed(b"module root;import common as a;import common as a0;pub fn T id<T>(T value){return other;}");var usize work=0;assert(switch(bindings::definition(ref original,0,ref stale,3,ref mut work)){case .ok(_):{false}case .err(code):{code==12}});work=0;assert(switch(bindings::definition(ref original,0,v::at<syntax::Parsed>(ref sources,0),0,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});work=0;assert(switch(bindings::encode(ref original,3,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});
    meter=0;let swapped=detached(7,ref mut meter);let p=parsed(source(0));work=0;let a=switch(bindings::definition(ref original,0,ref p,3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};work=0;let b=switch(bindings::definition(ref swapped,0,ref p,3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(!bytes::equal(bytes::view(ref a),bytes::view(ref b)));
}
@test
fn void owns_sorted_bindings_and_preserves_exact_work_limits(){var usize cost=0;let original=detached(0,ref mut cost);assert(cost>0 && cost<16777216);var usize meter=16777216-cost;let fit=detached(0,ref mut meter);assert(meter==16777216 && bindings::count(ref fit)==3);let m=bindings::module_at(ref original,0);assert(m.count==2 && bytes::equal(bindings::text(ref original,bindings::import_at(ref original,m.first).alias),b"a0"));let sources=source_set();let own=owners();let imports=resolved(0);let coords=table(0);meter=16777216-cost+1;assert(switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(_):{false}case .err(p):{p.code==10}});assert(meter<=16777216);
    var usize work=0;let expected=switch(bindings::encode(ref original,0,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let encode_cost=work;work=1048576-encode_cost;let exact=switch(bindings::encode(ref original,0,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(work==1048576 && bytes::equal(bytes::view(ref expected),bytes::view(ref exact)));work=1048576-encode_cost+1;assert(switch(bindings::encode(ref original,0,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});
    let p=parsed(source(0));work=0;let digest=switch(bindings::definition(ref original,0,ref p,3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let definition_cost=work;work=1048576-definition_cost;let exact_digest=switch(bindings::definition(ref original,0,ref p,3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(work==1048576 && bytes::equal(bytes::view(ref digest),bytes::view(ref exact_digest)));work=1048576-definition_cost+1;assert(switch(bindings::definition(ref original,0,ref p,3,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});var json::Ledger ledger=json::Ledger{.used=0,.code=11};var bytes::Buffer out=bytes::empty();assert(!bindings::value(ref original,0,ref mut out,ref mut ledger) && ledger.code==11 && ledger.used==0 && bytes::len(ref out)==0);work=0;let empty=switch(bindings::encode(ref original,1,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref empty),b"null"));
}
@test
@effects(filesystem)
fn void matches_original_sdk_vec_package_definitions(){let path=root();let data=read(bytes::view(ref path),b"vec.bin");let wire=bytes::view(ref data);assert(wire.len>=16 && bytes::equal(wire[..8],b"FYGPVEC1"));var usize at=8;let raw=field(wire,ref mut at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok);var v::Vec<usize> own=v::empty<usize>();assert(v::push<usize>(ref mut own,0).is_ok);let imports=v::empty<catalog::Binding>();let coords=table(0);var usize meter=0;let collected=switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};let n=number(wire,ref mut at);assert(n==16);var usize i=0;let p=v::at<syntax::Parsed>(ref sources,0);while(i<n){let name=field(wire,ref mut at);let expected=field(wire,ref mut at);var usize work=0;let actual=switch(bindings::definition(ref collected,0,p,declaration(p,name),ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref actual),expected));i+=1;}assert(at==wire.len);
}
@test
fn void rejects_conflicting_package_providers_across_aliases_and_modules(){var sources=source_set();var own=owners();let coords=table(0);var imports=resolved(0);let slot=v::at_mut<catalog::Binding>(ref mut imports,1);slot.target=2;var usize meter=0;assert(switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(_):{false}case .err(p):{p.code==9 && p.module_index==0 && p.declaration==2}});
    imports=resolved(0);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root_other;import common as c;fn i32 main(){return 0;}")).is_ok && v::push<usize>(ref mut own,0).is_ok && v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=3,.declaration=2,.target=2}).is_ok);meter=0;assert(switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(_):{false}case .err(p):{p.code==9 && p.module_index==3 && p.declaration==1}});let last=v::at_mut<catalog::Binding>(ref mut imports,2);last.target=1;meter=0;let valid=switch(bindings::build(ref sources,ref own,ref imports,ref coords,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bindings::count(ref valid)==4 && bindings::import_count(ref valid)==3);
}
