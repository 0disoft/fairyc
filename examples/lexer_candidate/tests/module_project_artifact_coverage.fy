fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(ref v::Vec<syntax::Parsed> sources){var v::Vec<usize> p=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut p,1).is_ok);i+=1;}return p;}
fn v::Vec<catalog::Binding> imports(ref v::Vec<syntax::Parsed> sources){let base=switch(catalog::build(sources)){case .ok(p):{p}case .err(_):{assert(false);return imports(sources);}};var v::Vec<catalog::Binding> rows=v::empty<catalog::Binding>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){let p=v::at<syntax::Parsed>(sources,i);var usize j=0;while(j<syntax::declaration_count(p)){let d=syntax::declaration_at(p,j);if(d.kind==2){var usize measured=0;let target=catalog::import_target_measured(ref base,i,syntax::source_view(p)[d.name_start..d.name_end],ref mut measured);assert(target.code==0 && target.item>0);assert(v::push<catalog::Binding>(ref mut rows,catalog::Binding{.source=i,.declaration=j+1,.target=target.item-1}).is_ok);}j+=1;}i+=1;}return rows;}

fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn core::Complete compiled(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let table=table();var usize work=0;var usize linked=0;return switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr("compiled ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);compiled(sources)}};}
@effects(console) fn identities::Snapshot snapshot(ref identified::Program program){var usize work=0;return switch(identities::extract(identified::source_identities(program),ir::cleanup_ir(identified::ir_program(program)),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("snapshot ");discard io::write_stderr_u32(code);assert(false);snapshot(program)}};}
@effects(console) fn planned::Plan source_plan(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let table=table();var usize work=0;return switch(planning::build_sources(sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);source_plan(sources)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("encoded ");discard io::write_stderr_u32(code);assert(false);encoded(p)}};}
@effects(console) fn ir::Program restored(ref u8[] raw){var usize work=0;return switch(decoder::decode(raw,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("restored ");discard io::write_stderr_u32(code);assert(false);restored(raw)}};}
fn void number(ref mut bytes::Buffer raw,usize at,usize input){assert(at+8<=bytes::len(raw));var bytes::Buffer octets=bytes::empty();var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(ref mut octets,input,ref mut status,ref mut work);assert(status.code==0 && bytes::len(ref octets)==8);var usize i=0;while(i<8){bytes::view_mut(raw)[at+i]=bytes::view(ref octets)[i];i+=1;}}
struct Tables{budget::Span part;usize layouts;usize field_count_at;usize fields;usize callable_count_at;usize callables;usize parameter_count_at;usize parameters;usize name_count_at;usize names;}
fn Tables tables(ref u8[] raw){var usize work=0;var c=switch(budget::cursor(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return tables(raw);}};discard budget::member_from(raw,ref mut c,8388608,b"FYCLEAN0",ref mut work);discard budget::member_from(raw,ref mut c,8388608,b"FYSDK000",ref mut work);let part=budget::member_from(raw,ref mut c,8388608,b"FYMETA00",ref mut work);c.offset=part.start+24;let count=budget::number_from(raw,ref mut c,ref mut work);let layouts=c.offset;c.offset+=count*104;let field_count_at=c.offset;let fields_count=budget::number_from(raw,ref mut c,ref mut work);let fields=c.offset;c.offset+=fields_count*88;let callable_count_at=c.offset;let callable_count=budget::number_from(raw,ref mut c,ref mut work);let callables=c.offset;c.offset+=callable_count*96;let parameter_count_at=c.offset;let parameter_count=budget::number_from(raw,ref mut c,ref mut work);let parameters=c.offset;c.offset+=parameter_count*8;let name_count_at=c.offset;let names_count=budget::number_from(raw,ref mut c,ref mut work);assert(c.code==0 && c.offset+names_count==part.end);return Tables{.part,.layouts,.field_count_at,.fields,.callable_count_at,.callables,.parameter_count_at,.parameters,.name_count_at,.names=c.offset};}
fn v::Vec<syntax::Parsed> inputs(){return source(b"module main;struct Pair{i32 n;bool flag;}fn i32 ignore(Pair p){return 42;}fn i32 answer(i32 n){return n;}fn i32 main(){return answer(42);}");}
fn bytes::Buffer inserted(ref u8[] raw,usize at,ref u8[] row){var out=bytes::empty();assert(bytes::append(ref mut out,raw[..at]).is_ok && bytes::append(ref mut out,row).is_ok && bytes::append(ref mut out,raw[at..]).is_ok);return out;}
fn void word(ref mut bytes::Buffer raw,usize n){var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(raw,n,ref mut status,ref mut work);assert(status.code==0);}
@effects(console) fn identities::Snapshot expanded_ids(ref ir::Program p,ref identities::Snapshot old){let names=fixture::copied(identities::names(old));var v::Vec<selection::Row> types=v::empty<selection::Row>();var v::Vec<selection::Row> frames=v::empty<selection::Row>();var usize i=1;while(i<=clean::type_count(ir::cleanup_ir(p))){let row=if(i<=identities::type_count(old)){identities::type_at(old,i)}else{selection::Row{.node=0,.id=text::Text{.start=0,.end=0}}};assert(v::push<selection::Row>(ref mut types,row).is_ok);i+=1;}i=1;while(i<=identities::frame_count(old)){assert(v::push<selection::Row>(ref mut frames,identities::frame_at(old,i)).is_ok);i+=1;}var usize work=0;return switch(identities::assemble(names,types,frames,ir::cleanup_ir(p),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);expanded_ids(p,old)}};}
@effects(console) fn coverage::Covered covered(ref ir::Program p,ref identities::Snapshot ids,ref planned::Plan plan,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref mut usize work){return switch(coverage::build(p,ids,plan,sources,metadata,work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("coverage ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);covered(p,ids,plan,sources,metadata,work)}};}
@test @effects(console) fn void all_source_ranges_and_retained_tables_have_exact_coverage(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let payload=encoded(identified::ir_program(named));let program=restored(wire::content(ref payload));let ids=snapshot(named);let metadata=get_metadata(ref sources);let plan=source_plan(ref sources);var usize work=0;let result=covered(ref program,ref ids,ref plan,ref sources,ref metadata,ref mut work);let stats=coverage::stats(ref result);assert(stats.files==1 && stats.units==1 && stats.retries==0 && stats.frames==ir::count(ref program) && stats.types==clean::type_count(ir::cleanup_ir(ref program)) && stats.layouts==1 && stats.fields==2 && stats.cleanup_fields==0 && stats.callables==ir::callable_count(ref program) && stats.parameters==ir::parameter_count(ref program) && stats.names==ir::name_bytes(ref program));}
@test @effects(console) fn void structurally_valid_unmatched_types_fields_contracts_parameters_and_names_reject(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let original=identified::ir_program(named);let payload=encoded(original);let raw=wire::content(ref payload);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);let table=tables(raw);var u32 mode=0;
    while(mode<5){var bytes::Buffer changed=fixture::copied(raw);
        if(mode==0){changed=inserted(raw,table.callable_count_at,raw[table.fields..table.fields+88]);number(ref mut changed,table.field_count_at,ir::field_count(original)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+88);}
        else if(mode==1){changed=inserted(raw,table.name_count_at,raw[table.parameters..table.parameters+8]);number(ref mut changed,table.parameter_count_at,ir::parameter_count(original)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+8);}
        else if(mode==2){var bytes::Buffer row=bytes::empty();assert(bytes::append_byte(ref mut row,33).is_ok);changed=inserted(raw,table.part.end,bytes::view(ref row));number(ref mut changed,table.name_count_at,ir::name_bytes(original)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+1);}
        else if(mode==3){let existing=ir::callable_at(original,0);let shape=ir::layout_at(original,0).value;var usize i=0;while(i<ir::callable_count(original)){let c=ir::callable_at(original,i);assert(c.module_index!=shape.module_index || c.declaration!=shape.declaration);i+=1;}var bytes::Buffer row=bytes::empty();word(ref mut row,shape.module_index);word(ref mut row,shape.declaration);word(ref mut row,0);word(ref mut row,existing.result);i=0;while(i<8){word(ref mut row,0);i+=1;}assert(bytes::len(ref row)==96);changed=inserted(raw,table.parameter_count_at,bytes::view(ref row));number(ref mut changed,table.callable_count_at,ir::callable_count(original)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+96);}
        else{let clean=ir::cleanup_ir(original);let count=clean::type_count(clean);var usize i=1;while(i<=count){let t=clean::type_at(clean,i);assert(t.kind!=1 || t.scalar!=132);i+=1;}var usize framing_work=0;var cursor=switch(budget::cursor(raw,ref mut framing_work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let part=budget::member_from(raw,ref mut cursor,8388608,b"FYCLEAN0",ref mut framing_work);let type_end=part.start+24+count*48;let glue_end=type_end+count*56;var bytes::Buffer type=bytes::empty();word(ref mut type,1);word(ref mut type,132);i=0;while(i<4){word(ref mut type,0);i+=1;}var bytes::Buffer glue=bytes::empty();i=0;while(i<7){word(ref mut glue,0);i+=1;}changed=bytes::empty();assert(bytes::append(ref mut changed,raw[..type_end]).is_ok && bytes::append(ref mut changed,bytes::view(ref type)).is_ok && bytes::append(ref mut changed,raw[type_end..glue_end]).is_ok && bytes::append(ref mut changed,bytes::view(ref glue)).is_ok && bytes::append(ref mut changed,raw[glue_end..]).is_ok);number(ref mut changed,part.start+16,count+1);number(ref mut changed,part.start-8,part.end-part.start+104);number(ref mut changed,table.part.start+104+16,count+1);}
        var usize decoded_work=0;let program=switch(decoder::decode(bytes::view(ref changed),ref mut decoded_work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("mutation ");discard io::write_stderr_u32(mode);discard io::write_stderr(" ");discard io::write_stderr_u32(code);assert(false);return;}};let current_ids=expanded_ids(ref program,ref ids);var usize work=0;assert(switch(matching::match(ref program,ref current_ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{true}case .err(code):{discard io::write_stderr("prior ");discard io::write_stderr_u32(mode);discard io::write_stderr(" ");discard io::write_stderr_u32(code);false}});work=0;assert(switch(coverage::build(ref program,ref current_ids,ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==4 && e.code==1001}} && work>0);mode+=1;
    }
}
@test @effects(console) fn void exact_exhausted_invalid_and_stale_coverage_checks_publish_no_partial_owner(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let program=identified::ir_program(named);let ids=snapshot(named);let metadata=get_metadata(ref sources);let plan=source_plan(ref sources);var usize work=0;let normal=covered(program,ref ids,ref plan,ref sources,ref metadata,ref mut work);let required=work;work=budget::work_limit()-required;let exact=covered(program,ref ids,ref plan,ref sources,ref metadata,ref mut work);assert(work==budget::work_limit() && coverage::stats(ref normal).frames==coverage::stats(ref exact).frames);work=budget::work_limit()-required+1;assert(switch(coverage::build(program,ref ids,ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(e):{e.code==1002}});work=budget::work_limit()+1;assert(switch(coverage::build(program,ref ids,ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(e):{e.code==1002}} && work==budget::work_limit()+1);let changed=source(b"module main;fn i32 main(){return 42;}");work=0;assert(switch(coverage::build(program,ref ids,ref plan,ref changed,ref metadata,ref mut work)){case .ok(_):{false}case .err(_):{true}});}
fn v::Vec<syntax::Parsed> grouped(bool invalid){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var usize file=0;while(file<5){var bytes::Buffer raw=fixture::copied(b"module group");assert(bytes::append_usize(ref mut raw,file).is_ok && bytes::append(ref mut raw,b";").is_ok);var usize i=0;while(i<104){assert(bytes::append(ref mut raw,b"fn i32 f").is_ok && bytes::append_usize(ref mut raw,i).is_ok && bytes::append(ref mut raw,if(invalid && file==4 && i==103){b"(){return true;}"}else{b"(){return 42;}"}).is_ok);i+=1;}assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref raw))).is_ok);file+=1;}return sources;}
@test @effects(console) fn void grouped_source_ranges_cover_all_frames_and_late_check_errors_keep_locations(){let sources=grouped(false);let owned=compiled(ref sources);let named=core::checked_program(ref owned);let program=identified::ir_program(named);let ids=snapshot(named);let metadata=get_metadata(ref sources);let plan=source_plan(ref sources);var usize work=0;let result=covered(program,ref ids,ref plan,ref sources,ref metadata,ref mut work);let stats=coverage::stats(ref result);assert(stats.files==5 && stats.units==2 && stats.retries==0 && stats.frames==520);let changed=grouped(true);let changed_metadata=get_metadata(ref changed);let changed_plan=source_plan(ref changed);let expected=switch(compile::check_range(ref changed,ref changed_metadata,4,5)){case .ok(_):{assert(false);return;}case .err(e):{e}};assert(expected.stage==4);work=0;assert(switch(coverage::build(program,ref ids,ref changed_plan,ref changed,ref changed_metadata,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==2 && e.code==expected.code && e.source.stage==expected.stage && e.source.module_index==expected.module_index && e.source.start==expected.start && e.source.end==expected.end && e.source.first==4 && e.source.stop==5}});}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_artifact_has_complete_project_coverage(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let result=covered(ref program,current::source_identities(ref rebound),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work);let stats=coverage::stats(ref result);assert(stats.files>2 && stats.frames==ir::count(ref program) && stats.types==clean::type_count(ir::cleanup_ir(ref program)) && stats.cleanup_fields>0 && stats.layouts>0 && stats.callables>0 && stats.names>0);}
