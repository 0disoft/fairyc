module tests::generic_aggregate_signatures;
import project_source_plan as project;
import generic_aggregate_types as aggregates;
import generic_source_plan as plan;
import module_signatures as signatures;
import module_types as types;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize n=0;var usize i=0;while(i<8){n=n*256+(wire[*at+i] as usize);i+=1;}*at+=8;return n;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let n=number(wire,at);assert(*at<=wire.len && n<=wire.len-*at);let start=*at;*at+=n;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var names=bytes::empty();var rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let digit=*v::at<usize>(digits,i);let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else{b"3"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit-1+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn ref u8[] scalar(u32 id){if(id==1){return b"i32";}if(id==2){return b"i64";}if(id==3){return b"u8";}if(id==4){return b"u32";}if(id==5){return b"usize";}if(id==6){return b"bool";}if(id==32){return b"i8";}if(id==33){return b"i16";}if(id==34){return b"isize";}if(id==35){return b"u16";}if(id==36){return b"u64";}if(id==37){return b"f32";}if(id==38){return b"f64";}return b"void";}
fn void render(ref signatures::Program metadata,usize id,ref mut bytes::Buffer out,usize depth){
 assert(depth<64);let t=signatures::type_at(metadata,id);if(t.kind==1){assert(bytes::append(out,scalar(t.scalar)).is_ok);return;}
 if(t.kind==20 || t.kind==21){let p=signatures::aggregate_source(metadata);let plan=aggregates::source_plan(p);var usize i=0;while(i<aggregates::count(p)){let a=aggregates::at(p,i);if(a.type==id){let n=plan::at(plan,a.node-1);assert(bytes::append(out,plan::text(plan,n.id)).is_ok);return;}i+=1;}assert(false);return;}
 assert(t.kind==5 || t.kind==6 || t.kind==7 || t.kind==8);assert(bytes::append(out,if(t.kind==5){b"Option<"}else if(t.kind==6){b"Result<"}else if(t.kind==7){b"ref "}else{b"ref mut "}).is_ok);render(metadata,t.first,out,depth+1);if(t.kind==6){assert(bytes::append(out,b",").is_ok);render(metadata,t.second,out,depth+1);}if(t.kind==5 || t.kind==6){assert(bytes::append(out,b">").is_ok);}
}
@effects(console) fn void matches(ref signatures::Program metadata,usize id,ref u8[] expected){var out=bytes::empty();render(metadata,id,ref mut out,0);if(!bytes::equal(bytes::view(ref out),expected)){discard io::write_stderr_bytes(bytes::view(ref out));discard io::write_stderr_bytes(expected);}assert(bytes::equal(bytes::view(ref out),expected));}
fn v::Vec<types::Type> graph(ref signatures::Program p){var out=v::empty<types::Type>();var usize i=1;while(i<=signatures::type_count(p)){assert(v::push<types::Type>(ref mut out,signatures::type_at(p,i)).is_ok);i+=1;}return out;}
fn void graph_contracts(ref signatures::Program p,ref v::Vec<syntax::Parsed> sources){
 let prepared=signatures::aggregate_source(p);let c=aggregates::declarations(prepared);let plain=graph(p);assert(switch(types::assemble(c,plain)){case .ok(_):{false}case .err(code):{code==9}});let owned=switch(signatures::own_types(p,graph(p))){case .ok(g):{g}case .err(_):{assert(false);return;}};assert(types::aggregate_graph(ref owned) && types::validate_graph(c,ref owned)==0);
 var usize tuple=0;var usize pair=0;var usize i=1;while(i<=signatures::type_count(p)){let t=signatures::type_at(p,i);if(t.kind==22){tuple=i;}if(t.kind==20 && signatures::type_at(p,t.first).second!=0){pair=i;}i+=1;}assert(tuple!=0 && pair!=0);
 var leaked=graph(p);assert(v::push<types::Type>(ref mut leaked,types::Type{.kind=5,.scalar=0,.module_index=0,.declaration=0,.first=tuple,.second=0}).is_ok);assert(switch(types::assemble_aggregates(c,leaked)){case .ok(_):{false}case .err(code):{code==9}});
 var wrong=graph(p);let original=signatures::type_at(p,pair);{let slot=v::at_mut<types::Type>(ref mut wrong,pair-1);slot.first=signatures::type_at(p,original.first).second;}assert(switch(types::assemble_aggregates(c,wrong)){case .ok(_):{false}case .err(code):{code==9}});
 let source=v::at<syntax::Parsed>(sources,0);var roots=v::empty<usize>();var usize root=0;i=1;while(i<syntax::declaration_count(source)){let d=syntax::declaration_at(source,i);if(d.kind==3 && d.generic_parameters==0){root=d.result_type;break;}i+=1;}assert(root!=0);assert(v::push<usize>(ref mut roots,root).is_ok && v::push<usize>(ref mut roots,0).is_ok && v::push<usize>(ref mut roots,syntax::type_count(source)+1).is_ok);var records=graph(p);let before=types::count(ref records);assert(switch(signatures::resolve_types(p,source,0,ref roots,ref mut records)){case .ok(_):{false}case .err(e):{e.request==3 && e.problem.code==9}});assert(types::count(ref records)==before);
 let maker=v::at<syntax::Parsed>(sources,1);var usize cell=0;i=1;while(i<syntax::declaration_count(maker)){if(bytes::equal(syntax::declaration_name(maker,i+1),b"Cell")){cell=i+1;break;}i+=1;}assert(cell!=0);let d=syntax::declaration_at(maker,cell-1);let field=syntax::field_at(maker,d.field_start);var usize descriptor=4097;var u32 scalar=32;
 while(descriptor<=4103){var args=v::empty<usize>();assert(v::push<usize>(ref mut args,descriptor).is_ok);let r=signatures::specialize_type(p,maker,1,cell,field.type_root,ref args,ref mut records);assert(r.problem.code==0 && types::at(ref records,r.type).kind==1 && types::at(ref records,r.type).scalar==scalar);var roots=v::empty<usize>();assert(v::push<usize>(ref mut roots,field.type_root).is_ok && v::push<usize>(ref mut roots,0).is_ok);let batch=switch(signatures::specialize_types(p,maker,1,cell,ref roots,ref args,ref mut records)){case .ok(r):{r}case .err(_):{assert(false);return;}};assert(v::len<usize>(ref batch)==2 && *v::at<usize>(ref batch,0)==r.type && *v::at<usize>(ref batch,1)==0);descriptor+=1;scalar+=1;}
 var invalid=v::empty<usize>();assert(v::push<usize>(ref mut invalid,4104).is_ok);let used=types::count(ref records);assert(signatures::specialize_type(p,maker,1,cell,field.type_root,ref invalid,ref mut records).problem.code==4502 && types::count(ref records)==used);

}
@effects(console) fn void verify(ref u8[] wire){
 assert(wire.len>=16 && bytes::equal(wire[..8],b"FYGSGN01"));var usize at=8;let cases=number(wire,ref mut at);var usize k=0;
 while(k<cases){let label=field(wire,ref mut at);assert(number(wire,ref mut at)==3);var sources=v::empty<syntax::Parsed>();var digits=v::empty<usize>();var owners=v::empty<usize>();var usize[3] modules=[0;3];let usize shift=if(k==1){19}else{0};var usize i=0;
  while(i<3){let digit=number(wire,ref mut at);assert(digit>=1 && digit<=3);modules[digit-1]=i;assert(v::push<usize>(ref mut digits,digit).is_ok && v::push<usize>(ref mut owners,digit-1+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);i+=1;}
  var imports=v::empty<catalog::Binding>();i=0;while(i<3){let digit=*v::at<usize>(ref digits,i);if(digit!=3){assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=2,.target=modules[digit]}).is_ok);}i+=1;}
  let table=coords(ref digits,shift);var usize work=0;let original=switch(project::build_aggregate_sources(ref sources,ref owners,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);assert(false);return;}};
  let p=switch(aggregates::build(original,ref sources,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);assert(false);return;}};if(k==0){source_gates(ref sources,ref owners,ref imports,ref table); }let expected=number(wire,ref mut at);
  if(expected!=0){assert(switch(signatures::build_aggregates(ref sources,p,ref mut work)){case .ok(_):{false}case .err(e):{let actual=e.code as usize;if(actual!=expected){discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);}actual==expected}});k+=1;continue;}
  let metadata=switch(signatures::build_aggregates(ref sources,p,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);assert(false);return;}};assert(signatures::aggregate_types(ref metadata) && signatures::vector_count(ref metadata)==0);let functions=number(wire,ref mut at);assert(signatures::count(ref metadata)==functions);i=1;
  while(i<=functions){let s=signatures::at(ref metadata,i);assert(s.module_index==number(wire,ref mut at));let source=v::at<syntax::Parsed>(ref sources,s.module_index);let name=field(wire,ref mut at);assert(bytes::equal(syntax::declaration_name(source,s.declaration),name));matches(ref metadata,s.result,field(wire,ref mut at));let parameters=number(wire,ref mut at);assert(parameters==s.parameter_count && !s.foreign && !s.unsafe_call && s.effects==0 && s.must_use==bytes::equal(name,b"used"));var usize j=0;while(j<parameters){matches(ref metadata,signatures::parameter_at(ref metadata,s.parameter_start+j),field(wire,ref mut at));j+=1;}i+=1;}
  if(k==0){graph_contracts(ref metadata,ref sources);}k+=1;
 }assert(at==wire.len);
}
@effects(console) pub fn i32 run(){var input=bytes::empty();var u8[4096] chunk=[0;4096];while(true){let n=switch(io::read_stdin(ref mut chunk)){case .ok(n):{n}case .err(_):{assert(false);return 1;}};if(n==0){break;}let ref u8[] raw=ref chunk;assert(bytes::len(ref input)<=1048576-n && bytes::append(ref mut input,raw[..n]).is_ok);}verify(bytes::view(ref input));return 0;}

fn aggregates::Prepared prepare(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize work=0;let original=switch(project::build_aggregate_sources(sources,owners,imports,table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return prepare(sources,owners,imports,table);}};return switch(aggregates::build(original,sources,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);prepare(sources,owners,imports,table)}};}
fn void source_gates(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){
 let ordinary=switch(catalog::build_scoped(sources,owners,imports)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(switch(signatures::build_catalog(sources,ordinary)){case .ok(_):{false}case .err(e):{e.code==9}});
 var changed=v::empty<syntax::Parsed>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){var raw=bytes::empty();assert(bytes::append(ref mut raw,syntax::source_view(v::at<syntax::Parsed>(sources,i))).is_ok);if(i==1){assert(bytes::append(ref mut raw,b"\n").is_ok);}assert(v::push<syntax::Parsed>(ref mut changed,parsed(bytes::view(ref raw))).is_ok);i+=1;}
 let stale=prepare(sources,owners,imports,table);var usize work=0;assert(switch(signatures::build_aggregates(ref changed,stale,ref mut work)){case .ok(_):{false}case .err(e):{e.code==12}});
 let bounded=prepare(sources,owners,imports,table);work=16777216;assert(switch(signatures::build_aggregates(sources,bounded,ref mut work)){case .ok(_):{false}case .err(e):{e.code==10}});
}
