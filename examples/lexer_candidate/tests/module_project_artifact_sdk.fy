module tests::module_project_artifact_sdk;
import module_project_artifact_sdk as matching;
import module_unit_sdk_sources as sdk;
import module_sdk_artifact as codec;
import module_catalog as catalog;
import module_program_artifact_wire as budget;
import candidate_artifact_wire as wire;
import tests::module_project_artifact_current_fixture as fixture;
import module_project_artifact_current as current;
import module_project_artifact_rebase as rebase;
import module_unit_body_ir_model as ir;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let raw=fixture::copied(text);let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn catalog::Catalog scoped(ref fixture::Current p){return switch(catalog::build_scoped(fixture::sources(p),fixture::owners(p),fixture::imports(p))){case .ok(p):{p}case .err(_):{assert(false);scoped(p)}};}
fn sdk::Sources collected(ref v::Vec<syntax::Parsed> sources){var usize work=0;return switch(sdk::collect(sources,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);collected(sources)}};}
fn sdk::Sources transported(ref sdk::Sources p){var usize work=0;let raw=switch(codec::encode(p,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return transported(p);}};work=0;return switch(codec::decode(wire::content(ref raw),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);transported(p)}};}
@effects(console) fn matching::Matched matched(ref sdk::Sources saved,ref v::Vec<syntax::Parsed> sources,ref catalog::Catalog c,ref mut usize work){return switch(matching::build(saved,sources,c,work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);matched(saved,sources,c,work)}};}
fn sdk::Sources changed(ref sdk::Sources saved,u32 mode){var v::Vec<sdk::Unit> rows=v::empty<sdk::Unit>();var bytes::Buffer raw=bytes::empty();var usize i=0;while(i<sdk::count(saved)){if(mode!=1 && (mode!=0 || i!=0)){let old=if(mode==3 && i<2){1-i}else if(mode==5){sdk::count(saved)-1-i}else{i};var row=sdk::at(saved,old);if(mode==2 && i==0){assert(row.module_index>0);row.module_index=0;}else if(mode==3){row.module_index=sdk::at(saved,i).module_index;}else if(mode==5){row.module_index=sdk::module_count(saved)-1-row.module_index;}let text=sdk::source_at(saved,old);row.start=bytes::len(ref raw);assert(bytes::append(ref mut raw,text).is_ok);row.end=bytes::len(ref raw);assert(v::push<sdk::Unit>(ref mut rows,row).is_ok);}i+=1;}
    var usize work=0;return switch(sdk::assemble_artifact(sdk::module_count(saved)+if(mode==4){1}else{0},rows,raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);changed(saved,mode)}};
}
@effects(filesystem,console) fn matching::Matched detached(){let original=fixture::current(0);let live=collected(fixture::sources(ref original));let saved=transported(ref live);let rebased=changed(ref saved,5);let now=fixture::current(1);let c=scoped(ref now);var usize work=0;return matched(ref rebased,fixture::sources(ref now),ref c,ref mut work);}
@test @effects(filesystem,console) fn void exact_sdk_bytes_match_reordered_sources_and_detached_results(){let result=detached();let stats=matching::stats(ref result);assert(stats.modules>stats.units && stats.units==8 && stats.bytes>0);var v::Vec<syntax::Parsed> users=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut users,parsed(b"module stdx;fn i32 f(){return 42;}")).is_ok);let c=switch(catalog::build(ref users)){case .ok(p):{p}case .err(_):{assert(false);return;}};let original=collected(ref users);let saved=transported(ref original);var usize work=0;let empty=matched(ref saved,ref users,ref c,ref mut work);let no_sdk=matching::stats(ref empty);assert(no_sdk.modules==1 && no_sdk.units==0 && no_sdk.bytes==0 && work>0);}
@test @effects(filesystem,console) fn void authenticated_but_wrong_sdk_selection_and_coordinates_reject(){let original=fixture::current(0);let c=scoped(ref original);let live=collected(fixture::sources(ref original));let saved=transported(ref live);assert(sdk::count(ref saved)>1 && sdk::module_count(ref saved)<512 && sdk::at(ref saved,0).module_index>0);var u32 mode=0;while(mode<5){let wrong=changed(ref saved,mode);let restored=transported(ref wrong);var usize work=0;assert(switch(matching::build(ref restored,fixture::sources(ref original),ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;}}
fn v::Vec<syntax::Parsed> replaced(ref v::Vec<syntax::Parsed> sources,usize target,ref u8[] text){var v::Vec<syntax::Parsed> rows=v::empty<syntax::Parsed>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<syntax::Parsed>(ref mut rows,parsed(if(i==target){text}else{syntax::source_view(v::at<syntax::Parsed>(sources,i))})).is_ok);i+=1;}return rows;}
@test @effects(filesystem,console) fn void work_boundaries_stale_sources_and_false_sdk_authority_reject(){let original=fixture::current(0);let c=scoped(ref original);let live=collected(fixture::sources(ref original));let saved=transported(ref live);var usize cost=0;let normal=matched(ref saved,fixture::sources(ref original),ref c,ref mut cost);assert(cost>0);var usize work=budget::work_limit()-cost;let exact=matched(ref saved,fixture::sources(ref original),ref c,ref mut work);assert(work==budget::work_limit() && matching::stats(ref exact).bytes==matching::stats(ref normal).bytes);work=budget::work_limit()-cost+1;assert(switch(matching::build(ref saved,fixture::sources(ref original),ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::build(ref saved,fixture::sources(ref original),ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);let stale=fixture::current(2);work=0;assert(switch(matching::build(ref saved,fixture::sources(ref stale),ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});
    var usize vector=0;var usize i=0;while(i<sdk::count(ref saved)){let row=sdk::at(ref saved,i);if(row.sdk_id==8){vector=row.module_index;}i+=1;}assert(catalog::sdk_vector_source(ref c,vector));let injected=replaced(fixture::sources(ref original),vector,b"module std::vec;fn i32 fake(){return 42;}");work=0;assert(switch(matching::build(ref saved,ref injected,ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});
    var usize mode=0;while(mode<2){var v::Vec<syntax::Parsed> fake=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut fake,parsed(if(mode==0){b"module std::vec;fn i32 fake(){return 42;}"}else{b"module std::unknown;fn i32 fake(){return 42;}"})).is_ok);assert(switch(catalog::build(ref fake)){case .ok(_):{false}case .err(e):{e.code==6801}});mode+=1;}
    var v::Vec<syntax::Parsed> duplicate=v::empty<syntax::Parsed>();let text=sdk::source_at(ref saved,0);assert(v::push<syntax::Parsed>(ref mut duplicate,parsed(text)).is_ok && v::push<syntax::Parsed>(ref mut duplicate,parsed(text)).is_ok);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,0).is_ok && v::push<usize>(ref mut owners,1).is_ok);let imports=v::empty<catalog::Binding>();let duplicate_catalog=switch(catalog::build_scoped(ref duplicate,ref owners,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(catalog::source_matches(ref duplicate_catalog,0,v::at<syntax::Parsed>(ref duplicate,0)) && catalog::source_matches(ref duplicate_catalog,1,v::at<syntax::Parsed>(ref duplicate,1)));var v::Vec<sdk::Unit> rows=v::empty<sdk::Unit>();assert(v::push<sdk::Unit>(ref mut rows,sdk::Unit{.module_index=0,.sdk_id=sdk::at(ref saved,0).sdk_id,.start=0,.end=text.len}).is_ok);var usize verification=0;let single=switch(sdk::assemble_artifact(2,rows,fixture::copied(text),ref mut verification)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(matching::build(ref single,ref duplicate,ref duplicate_catalog,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});
}
@test @effects(filesystem,console) fn void actual_rebased_generic_vec_state_artifact_matches_current_sdk(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let c=scoped(ref sources);work=0;let result=matched(ir::sdk_units(ref program),fixture::sources(ref sources),ref c,ref mut work);let stats=matching::stats(ref result);assert(stats.units==8 && stats.modules==sdk::module_count(ir::sdk_units(ref program)) && stats.bytes==sdk::data(ir::sdk_units(ref program)).len);}
