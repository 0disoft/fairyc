module tests::module_unit_body_types;
import module_unit_interfaces as interfaces;
import module_unit_generics as generics;
import module_unit_bodies as bodies;
import module_unit_body_ast as ast;
import module_unit_bind as binding;
import module_unit_drops as drops;
import module_unit_body_types as body_types;
import module_types as types;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let stream=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(stream,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@test fn void private_local_types_close_fields_cleanups_and_new_helper_bodies(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;@effects(console,filesystem)fn i32 main(){discard p::go<bool>(true);return p::go<i32>(1);}")).is_ok);
    assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module provider;@effects(filesystem)resource Leaf{i32 n;cleanup{discard this.n;}}@effects(console,filesystem)resource Hidden{Leaf item;cleanup{let Leaf local=Leaf{.n=1};discard helper<i32>(1);}}struct Detail{u8 n;}fn T helper<T>(T n){let Detail local=Detail{.n=1};return n;}@effects(console,filesystem)pub fn T go<T>(T n){let Hidden value=Hidden{.item=Leaf{.n=1}};let inferred=Leaf{.n=2};let T[2] pair=[n;2];discard pair;return n;}")).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return;}};let imported=switch(interfaces::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    assert(generics::count(interfaces::specializations(ref imported))==3 && generics::cleanup_count(interfaces::specializations(ref imported))==2 && interfaces::shape_count(ref imported)==3);
    let drop=switch(drops::build(ref imported)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize annotations=0;var usize constructors=0;var usize cleanup_locals=0;var usize hidden=0;var usize detail=0;var usize i=0;
    while(i<interfaces::body_type_count(ref imported)){let r=interfaces::body_type_at(ref imported,i);assert(r.module_index==1 && r.declaration!=0 && r.end>r.start && r.type<=interfaces::type_count(ref imported));if(r.kind==1){annotations+=1;}else{constructors+=1;assert(r.kind==2 && syntax::expression_at(v::at<syntax::Parsed>(ref sources,1),r.source_index).kind==10);}if(r.context_kind==2){cleanup_locals+=1;}i+=1;}assert(annotations>=10 && constructors>=7 && cleanup_locals>=3);
    i=0;while(i<interfaces::shape_count(ref imported)){let s=interfaces::shape_at(ref imported,i);let t=interfaces::type_at(ref imported,s.type);assert(t.module_index==1);if(t.declaration==3){hidden=s.type;assert(drops::at(ref drop,s.type).effects==3 && drops::at(ref drop,s.type).complete);switch(interfaces::field(ref imported,s.type,0,b"item")){case .ok(_):{assert(false);}case .err(c):{assert(c==6201);}};}if(t.declaration==4){detail=s.type;let f=interfaces::field_at(ref imported,s.field_start);assert(interfaces::type_at(ref imported,f.type).scalar==3);}i+=1;}assert(hidden!=0 && detail!=0);
    let owned=switch(bodies::build(ref sources,ref metadata,ref imported)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bodies::type_count(ref owned)==interfaces::type_count(ref imported) && bodies::count(ref owned)==3 && bodies::cleanup_count(ref owned)==2);i=1;while(i<=bodies::count(ref owned)){let b=bodies::at(ref owned,i);let a=bodies::body_ast(b);var usize n=1;while(n<=ast::type_count(a)){let usize type=bodies::annotation_at(b,n);if(type!=0){var bool found=false;var usize r=0;while(r<interfaces::body_type_count(ref imported)){let demand=interfaces::body_type_at(ref imported,r);if(demand.context_kind==1 && demand.context==i && demand.kind==1 && demand.source_index==ast::type_origin(a,n)){assert(demand.type==type);found=true;}r+=1;}assert(found);}n+=1;}i+=1;}
}
@test fn void unrequested_templates_do_not_create_type_or_cleanup_demands(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){return p::id<i32>(1);}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module provider;pub fn T id<T>(T n){return n;}fn T unused<T>(T n){let Unknown bad=n;return bad;}")).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return;}};let p=switch(interfaces::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(interfaces::shape_count(ref p)==0 && generics::count(interfaces::specializations(ref p))==1 && generics::cleanup_count(interfaces::specializations(ref p))==0);var usize i=0;while(i<interfaces::body_type_count(ref p)){let r=interfaces::body_type_at(ref p,i);assert(r.context_kind==1 && r.context==1 && r.declaration==2);i+=1;}
}
@test fn void invalid_cleanup_local_type_keeps_provider_position(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){let p::Owner value=p::make();return 0;}")).is_ok);let text=b"module provider;pub resource Owner{i32 n;cleanup{let Unknown local=this.n;discard local;}}pub fn Owner make(){return Owner{.n=0};}";assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return;}};switch(interfaces::build(ref sources,ref metadata,ref bound)){case .ok(_):{assert(false);}case .err(p):{assert(p.code==5 && p.module_index==1 && bytes::equal(text[p.start..p.end],b"Unknown"));}};
}
@test fn void failed_local_type_collection_rolls_back_graph_additions(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){return p::go<i32>(1);}")).is_ok);let text=b"module provider;pub fn T go<T>(T n){let T[2] pair=[n;2];let Unknown invalid=n;return n;}";assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};var v::Vec<types::Type> graph=v::empty<types::Type>();var v::Vec<usize> arguments=v::empty<usize>();var usize i=1;while(i<=signatures::type_count(ref metadata)){let t=signatures::type_at(ref metadata,i);assert(v::push<types::Type>(ref mut graph,t).is_ok);if(t.kind==1 && t.scalar==1){assert(v::push<usize>(ref mut arguments,i).is_ok);}i+=1;}assert(v::len<usize>(ref arguments)==1);let usize before=types::count(ref graph);switch(body_types::collect(v::at<syntax::Parsed>(ref sources,1),ref metadata,1,2,1,1,ref arguments,ref mut graph)){case .ok(_):{assert(false);}case .err(p):{assert(p.code==5 && p.module_index==1 && bytes::equal(text[p.start..p.end],b"Unknown"));}};assert(types::count(ref graph)==before);
}
