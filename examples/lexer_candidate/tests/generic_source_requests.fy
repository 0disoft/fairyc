module tests::generic_source_requests;
import generic_source_requests as requests;
import generic_source_dependencies as dependencies;
import generic_source_closure as closures;
import generic_source_dependency_model as model;
import generic_source_dependency_json as json;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::fs as fs;
import std::text as text;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else if(digit==3){b"3"}else{b"4"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=0;return switch(templates::build(resolved,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn ref u8[] root(){return b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}pub fn T cycle<T>(T value){return cycle<T>(value);}";}
fn ref u8[] provider(){return b"module helper;pub fn T id<T>(T value){return value;}fn T secret<T>(T value){return value;}";}
fn v::Vec<syntax::Parsed> small_sources(ref u8[] first,ref u8[] second){var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,parsed(first)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(second)).is_ok);return input;}
fn v::Vec<catalog::Binding> small_imports(){var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);return imports;}
fn v::Vec<usize> small_digits(){var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);return digits;}
fn ref u8[] source(u32 mode){
if(mode==0){return b"module root;import helper as h;import helper as a;import std::vec as vec;struct Token{i32 n;}resource Owned{i32 n;cleanup{discard h::pair<i32,i64>(1,2);}}fn vec::Vec<h::Token> echo(vec::Vec<h::Token> items){return items;}pub fn T api<T>(T value){return h::id<T>(value);}fn T unused<T>(T value){return h::id<i64>(1);}fn ref u8[] producer<T>(){return b\"\";}fn void use(ref u8[] data){discard api<i32>(1);discard h::id<i32>(1);discard a::id<i32>(2);let vec::Vec<h::Token> items=vec::empty<h::Token>();discard items;for(let u8 byte in data){discard h::id<u8>(byte);}for(let u8 byte in producer<i64>()){discard h::id<u32>(1);}}";}
if(mode==1){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value;}pub fn A pair<A,B>(A first,B second){return first;}";}
if(mode==2){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value+1;}pub fn A pair<A,B>(A first,B second){return first;}";}
return b"";
}
@test
@effects(filesystem,console)
fn void direct_source_roots_match_actual_go_plan(){let fixture=fixture();let wire=bytes::view(ref fixture);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGROOT1"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==4);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let total=number(wire,ref mut at);var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<total){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(field(wire,ref mut at))).is_ok);let count=number(wire,ref mut at);var usize j=0;while(j<count){let alias=field(wire,ref mut at);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref input,i),j+1);assert(bytes::equal(alias,syntax::source_view(v::at<syntax::Parsed>(ref input,i))[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}
    let original=collected(ref input,ref imports,ref digits,if(c==2){19}else{0});var usize work=0;let actual=switch(requests::build(original,ref input,ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);discard io::write_stderr_usize(e.declaration);assert(false);return;}};let data=requests::data(ref actual);let count=number(wire,ref mut at);if(model::edge_count(data)!=count){discard io::write_stderr("root counts actual/expected ");discard io::write_stderr_usize(model::edge_count(data));discard io::write_stderr("/");discard io::write_stderr_usize(count);}assert(model::edge_count(data)==count && count==12 && model::range_count(data)==1);i=0;while(i<count){let expected=field(wire,ref mut at);let edge=model::edge_at(data,i);if(!bytes::equal(model::text(data,edge.key),expected)){discard io::write_stderr("\nexpected ");discard io::write_stderr_bytes(expected);discard io::write_stderr("\nactual ");discard io::write_stderr_bytes(model::text(data,edge.key));}assert(bytes::equal(model::text(data,edge.key),expected));let row=templates::template_at(requests::templates(ref actual),edge.target-1);assert(bytes::equal(templates::text(requests::templates(ref actual),row.id),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(edge.count==n);var usize j=0;while(j<n){let arg=model::argument_at(data,edge.first+j);assert(!arg.parameter && bytes::equal(model::text(data,arg.name),field(wire,ref mut at)));j+=1;}i+=1;}c+=1;}assert(at==wire.len);}
fn requests::Requests detached_requests(ref mut usize work){let input=small_sources(b"module root;import helper as a;fn void use(){discard a::id<i32>(1);discard a::id<i32>(2);}pub fn T unused<T>(T value){return a::id<i64>(1);}",provider());let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);return switch(requests::build(c,ref input,work)){case .ok(value):{value}case .err(_):{assert(false);return detached_requests(work);}};}
@test
fn void owns_unique_roots_and_exact_shared_work(){var usize cost=0;let detached=detached_requests(ref mut cost);let data=requests::data(ref detached);assert(model::edge_count(data)==1 && model::argument_count(data)==1 && model::range_at(data,0).count==1);let row=model::edge_at(data,0);let target=templates::template_at(requests::templates(ref detached),row.target-1);assert(bytes::equal(templates::text(requests::templates(ref detached),target.name),b"id") && bytes::equal(model::text(data,model::argument_at(data,0).name),b"i32"));var usize work=16777216-cost;let fit=detached_requests(ref mut work);assert(work==16777216 && model::edge_count(requests::data(ref fit))==1);let input=small_sources(b"module root;import helper as a;fn void use(){discard a::id<i32>(1);discard a::id<i32>(2);}pub fn T unused<T>(T value){return a::id<i64>(1);}",provider());let imports=small_imports();let digits=small_digits();let original=collected(ref input,ref imports,ref digits,0);work=16777216-cost+1;assert(switch(requests::build(original,ref input,ref mut work)){case .ok(_):{false}case .err(p):{p.code==10}} && work<=16777216);}
fn u32 root_rejected(ref u8[] raw){let input=small_sources(raw,provider());let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);var usize work=0;return switch(requests::build(c,ref input,ref mut work)){case .ok(_):{0}case .err(p):{assert(p.module_index==0 && p.declaration!=0 && p.start<p.end);p.code}};}
@test
fn void rejects_stale_private_unknown_arity_and_generated_roots(){assert(root_rejected(b"module root;import helper as a;fn void use(){discard a::secret<i32>(1);}")==13);assert(root_rejected(b"module root;import helper as a;fn void use(){discard missing<i32>(1);}")==4501);assert(root_rejected(b"module root;import helper as a;fn void use(){discard a::id<i32,i64>(1);}")==4501);assert(root_rejected(b"module root;import helper as a;fn void use(){discard a::id<ref i32>(1);}")==4501);assert(root_rejected(b"module root;import helper as a;fn void use(){discard a::id(1);}")==4501);assert(root_rejected(b"module root;import helper as a;fn void use(){let i32 id=1;discard _fy_generic_hidden;}")==4501);let input=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);let changed=small_sources(root(),b"module helper;pub fn T id<T>(T value){return value+1;}");var usize work=0;assert(switch(requests::build(c,ref changed,ref mut work)){case .ok(_):{false}case .err(p):{p.code==12 && p.module_index==1}});}
@test
fn void unused_templates_do_not_create_direct_roots(){let input=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);var usize work=0;let actual=switch(requests::build(c,ref input,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(model::edge_count(requests::data(ref actual))==0 && model::argument_count(requests::data(ref actual))==0 && model::range_count(requests::data(ref actual))==1);}
