module tests::module_unit_c_sdk;
import module_unit_c_emit as emit;
import module_unit_c_sdk as sdk;
import module_unit_c_region as lifecycle;
import c_text as w;
import module_unit_body_ir_model as ir;
import module_unit_body_ir_storage as storage_proof;
import module_unit_value_model as m;
import module_unit_region_model as regions;
import module_unit_body_ir_lower as lower;
import module_unit_cleanup_mir_model as clean;
import module_unit_values as values;
import module_unit_moves as moves;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import scanner as scanner;
import syntax as syntax;
import file_source as files;
import std::bytes as bytes;
import std::vec as v;
import std::process as process;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let b=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(filesystem) fn bytes::Buffer input(usize index){var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let n=switch(process::arg(index,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};return switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);bytes::empty()}};}
@effects(console) fn void error(u32 code,usize start,usize end){discard io::write_u32(code);discard io::write(" at ");discard io::write_usize(start);discard io::write("..");discard io::write_usize(end);discard io::write("\n");assert(false);}
@effects(console) fn ir::Program retained(ref u8[] root,ref u8[] provider){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root,provider);}};
    let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root,provider);}};
    let ready=switch(closure::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root,provider);}};
    let typed=switch(values::build(ref sources,ref metadata,ref ready)){case .ok(p):{p}case .err(e):{discard io::write("values ");error(e.code,e.start,e.end);return retained(root,provider);}};
    let moved=switch(moves::build(ref sources,ref typed,values::work(ref typed))){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root,provider);}};
    return switch(lower::lower(ref sources,ref typed,closure::imported(ref ready),ref moved)){case .ok(p):{p}case .err(e):{discard io::write("lower ");error(e.code,e.start,e.end);retained(root,provider)}};
}
fn usize entry(ref ir::Program p){var usize found=0;var usize i=1;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);let result=clean::type_at(ir::cleanup_ir(p),f.result);if(f.module_index==0 && f.kind==3 && result.kind==1 && result.scalar==1){let b=ir::at(p,i);var usize j=1;var bool parameter=false;while(j<=ir::local_count(b)){if(ir::local_at(b,j).kind==1){parameter=true;}j+=1;}if(!parameter){assert(found==0);found=i;}}i+=1;}assert(found!=0);return found;}
@effects(console) fn void output(ref ir::Program p){var bytes::Buffer c=bytes::empty();let result=emit::render(p,entry(p),ref mut c);if(result.code!=0){discard io::write("C ");error(result.code,result.start,result.end);}assert(io::write_bytes(bytes::view(ref c)).is_ok);}
@test @effects(console,filesystem) fn void sdk_c_executes_process_arguments_through_exact_result_bridge(){let source=input(1);let p=retained(b"module main;import std::process as p;fn i32 main(){assert(p::arg_count()==3);var u8[4] data=[0;4];let usize n=switch(p::arg(1,ref mut data[..])){case .ok(n):{n}case .err(_):{assert(false);0}};assert(n==3 && data[0]==97 && data[1]==98 && data[2]==99);let usize second=switch(p::arg(2,ref mut data[..])){case .ok(n):{n}case .err(_):{assert(false);0}};assert(second==2 && data[0]==206 && data[1]==187);assert(!p::arg(3,ref mut data[..]).is_ok);var u8[1] small=[0];assert(!p::arg(1,ref mut small[..]).is_ok);return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_arena_factory_switch_and_owned_cleanup(){let source=input(2);let p=retained(b"module main;import std::alloc as alloc;fn i32 main(){let alloc::Arena arena=switch(alloc::create()){case .ok(value):{value}case .err(_):{assert(false);return 1;}};discard arena;let Result<alloc::Arena,alloc::AllocError> ignored=alloc::create();discard ignored;return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_console_numbers_bytes_and_record_result_bridges(){let source=input(3);let p=retained(b"module main;import std::io as io;@effects(console)fn i32 main(){assert(io::write_u32(42).is_ok);discard io::write(\"|\");assert(io::write_i32(-7).is_ok);discard io::write(\"|\");assert(io::write_usize(9).is_ok);discard io::write(\"|\");assert(io::write_i64(-9223372036854775808).is_ok);discard io::write(\"|λ\\n\");return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_plan_respects_work_budget_before_authority_or_output(){let source=input(1);let p=retained(b"module main;import std::process as p;fn i32 main(){discard p::arg_count();return 0;}",bytes::view(ref source));var usize work=1048576;assert(switch(sdk::build(ref p,ref mut work)){case .ok(_):{false}case .err(e):{e.code==1002}});}
@test @effects(console,filesystem) fn void sdk_c_executes_stdin_and_stderr_byte_results(){let source=input(3);let p=retained(b"module main;import std::io as io;@effects(console)fn i32 main(){var u8[5] data=[0;5];var usize position=0;while(position<5){let usize n=switch(io::read_stdin(ref mut data[position..])){case .ok(n):{n}case .err(_):{assert(false);0}};assert(n>0);position+=n;}assert(data[0]==65 && data[1]==0 && data[2]==206 && data[3]==187 && data[4]==90);let usize eof=switch(io::read_stdin(ref mut data[..])){case .ok(n):{n}case .err(_):{assert(false);1}};assert(eof==0);let ref u8[] got=ref data;assert(io::write_bytes(got).is_ok);assert(io::write_stderr_u32(42).is_ok);discard io::write_stderr(\"|\");assert(io::write_stderr_i32(-7).is_ok);discard io::write_stderr(\"|\");assert(io::write_stderr_usize(9).is_ok);discard io::write_stderr(\"|\");assert(io::write_stderr_i64(-9223372036854775808).is_ok);discard io::write_stderr(\"|\");assert(io::write_stderr_bool(true).is_ok);discard io::write_stderr(\"|λ\\n\");return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_region_lifecycle_and_cleanup_edges(){let source=input(2);let p=retained(b"module main;import std::alloc as alloc;@link_name(\"test_report\")unsafe extern C fn void sink(i32 n);fn void report(i32 n){unsafe{sink(n);}}resource R{i32 n;cleanup{report(this.n);}}fn alloc::Arena fresh(){return switch(alloc::create()){case .ok(a):{a}case .err(_):{assert(false);return fresh();}};}fn void fall(ref mut alloc::Arena a){region r in a{let R inner=R{.n=1};defer report(2);}}fn i32 early(ref mut alloc::Arena a){region r in a{let R inner=R{.n=3};defer report(4);return 7;}}fn void nested(ref mut alloc::Arena a,ref mut alloc::Arena b){region r in a{let R outer=R{.n=5};region s in b{let R inner=R{.n=6};}}}fn void loops(ref mut alloc::Arena a){var i32 i=0;while(i<3){i+=1;region r in a{let R inner=R{.n=10+i};if(i==1){continue;}break;}}}fn i32 main(){var alloc::Arena a=fresh();var alloc::Arena b=fresh();fall(ref mut a);assert(early(ref mut a)==7);nested(ref mut a,ref mut b);loops(ref mut a);return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_region_placement_and_param_origin(){let source=input(2);let p=retained(b"module main;import std::alloc as a;@link_name(\"test_report\")unsafe extern C fn void sink(i32 n);fn i32 value(i32 n){unsafe{sink(n);}return n;}struct Pair{i32 n;u8[3] data;}struct Leaf{i32 n;}enum E{None;Some{Leaf pair;};}fn a::Arena fresh(){return switch(a::create()){case .ok(a):{a}case .err(_):{assert(false);return fresh();}};}fn Result<ref i32,a::AllocError> store(Region r,i32 n){return r.place(n);}fn Result<i32,a::AllocError> use(Region r){let ref i32 p=store(r,value(7))?;return .ok(*p);}fn i32 main(){var a::Arena arena=fresh();region r in ref mut arena{let i32 n=switch(use(r)){case .ok(n):{n}case .err(_):{assert(false);return 1;}};assert(n==7);var Pair original=Pair{.n=3,.data=[1,2,3]};let ref Pair copy=switch(r.place(original)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};original.n=9;original.data[0]=9;assert(copy.n==3 && copy.data[0]==1);let E e=.Some{.pair=Leaf{.n=4}};let ref E placed=switch(r.place(e)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};switch(*placed){case .None:{assert(false);}case .Some{.pair=p}:{assert(p.n==4);}};let Option<u32> optional=.some(9);let ref Option<u32> option=switch(r.place(optional)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};switch(*option){case .some(n):{assert(n==9);}case .none:{assert(false);}};let Result<i64,u32> tagged=.err(11);let ref Result<i64,u32> result=switch(r.place(tagged)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};switch(*result){case .ok(_):{assert(false);}case .err(n):{assert(n==11);}};}return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_region_storage_or_tracking_failure_as_result(){let source=input(2);let p=retained(b"module main;import std::alloc as a;@link_name(\"test_report\")unsafe extern C fn void sink(i32 n);fn i32 value(i32 n){unsafe{sink(n);}return n;}fn a::Arena fresh(){return switch(a::create()){case .ok(a):{a}case .err(_):{assert(false);return fresh();}};}fn Result<i32,a::AllocError> allocate(){var a::Arena arena=fresh();region r in ref mut arena{let ref i32 p=r.place(value(7))?;return .ok(*p);}}fn i32 main(){let result=allocate();switch(result){case .ok(_):{assert(false);}case .err(error):{assert(a::error_status(error)==1);}};return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_region_plan_respects_placement_budget_before_output(){let source=input(2);let p=retained(b"module main;import std::alloc as a;fn i32 main(){var a::Arena arena=switch(a::create()){case .ok(a):{a}case .err(_):{assert(false);return 1;}};region r in ref mut arena{discard r.place(1);}return 0;}",bytes::view(ref source));var usize work=0;let plan=switch(sdk::build(ref p,ref mut work)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return;}};work=1048576;var bytes::Buffer out=bytes::empty();var w::State state=w::State{.code=0};assert(!lifecycle::definitions(ref p,ref plan,ref mut out,ref mut state,ref mut work) && state.code==1002 && bytes::len(ref out)==0);}
@test @effects(console,filesystem) fn void sdk_c_executes_buffer_owned_views_and_cleanup(){let source=input(4);let p=retained(b"module main;import std::bytes as b;fn i32 main(){var b::Buffer buffer=switch(b::copy(b\"A\\0λZ\")){case .ok(b):{b}case .err(_):{assert(false);return 1;}};assert(b::len(ref buffer)==5);let ref u8[] first=b::view(ref buffer);assert(first[0]==65 && first[1]==0 && first[2]==206 && first[3]==187 && first[4]==90);let ref mut u8[] changed=b::view_mut(ref mut buffer);changed[0]=66;assert(changed[0]==66);assert(b::append_byte(ref mut buffer,33).is_ok && b::len(ref buffer)==6);assert(b::reserve(ref mut buffer,32).is_ok && b::capacity(ref buffer)>=32);assert(b::resize_zeroed(ref mut buffer,9).is_ok);let ref u8[] grown=b::view(ref buffer);assert(grown.len==9 && grown[0]==66 && grown[1]==0 && grown[2]==206 && grown[3]==187 && grown[4]==90 && grown[5]==33 && grown[6]==0 && grown[8]==0);assert(b::truncate(ref mut buffer,3).is_ok);assert(!b::truncate(ref mut buffer,4).is_ok && b::len(ref buffer)==3);assert(b::clear(ref mut buffer).is_ok && b::is_empty(ref buffer));let ref u8[] empty=b::view(ref buffer);assert(empty.len==0);let b::Buffer extra=b::empty();discard extra;return 0;}",bytes::view(ref source));output(ref p);}
