@test @effects(console,filesystem) fn void sdk_c_executes_buffer_growth_failure_preserves_bytes(){let source=input(4);let p=retained(b"module main;import std::bytes as b;fn i32 main(){var b::Buffer buffer=switch(b::copy(b\"A\\0λZ\")){case .ok(b):{b}case .err(_):{assert(false);return 1;}};let usize capacity=b::capacity(ref buffer);let result=b::reserve(ref mut buffer,32);switch(result){case .ok(_):{assert(false);}case .err(e):{assert(b::error_status(e)==1);}};assert(b::len(ref buffer)==5 && b::capacity(ref buffer)==capacity);let ref u8[] value=b::view(ref buffer);assert(value.len==5 && value[0]==65 && value[1]==0 && value[2]==206 && value[3]==187 && value[4]==90);return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_vector_storage_and_views(){let source=input(5);let p=retained(b"module main;import std::vec as v;fn i32 main(){var v::Vec<i64> vector=v::empty<i64>();assert(v::is_empty<i64>(ref vector));assert(v::push<i64>(ref mut vector,7).is_ok);assert(v::push<i64>(ref mut vector,-9).is_ok);let ref i64[] before=v::view_i64(ref vector);assert(before.len==2 && before[0]==7 && before[1]==-9);let ref mut i64[] changed=v::view_mut_i64(ref mut vector);changed[0]=11;assert(changed[0]==11);let ref mut i64 element=v::at_mut<i64>(ref mut vector,1);*element=13;assert(*element==13);assert(*v::at<i64>(ref vector,1)==13);assert(v::reserve<i64>(ref mut vector,32).is_ok && v::capacity<i64>(ref vector)>=32);switch(v::pop<i64>(ref mut vector)){case .some(n):{assert(n==13);}case .none:{assert(false);}};assert(v::truncate<i64>(ref mut vector,0)==1);switch(v::pop<i64>(ref mut vector)){case .some(_):{assert(false);}case .none:{}};let ref i64[] empty=v::view_i64(ref vector);assert(empty.len==0);return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_vector_resource_cleanup(){let source=input(5);let p=retained(b"module main;import std::vec as v;@link_name(\"test_report\")unsafe extern C fn void report(i32 n);resource Item{i32 n;cleanup{unsafe{report(this.n);}}}fn i32 main(){var v::Vec<Item> vector=v::empty<Item>();assert(v::push<Item>(ref mut vector,Item{.n=1}).is_ok);assert(v::push<Item>(ref mut vector,Item{.n=2}).is_ok);assert(v::push<Item>(ref mut vector,Item{.n=3}).is_ok);switch(v::pop<Item>(ref mut vector)){case .some(value):{assert(value.n==3);}case .none:{assert(false);}};assert(v::truncate<Item>(ref mut vector,1)==1);assert(v::len<Item>(ref vector)==1);return 0;}",bytes::view(ref source));output(ref p);}
