@test @effects(console,filesystem) fn void sdk_c_executes_vector_growth_failure_preserves_prefix(){let source=input(5);let p=retained(b"module main;import std::vec as v;@link_name(\"test_report\")unsafe extern C fn void report(i32 n);resource Item{i32 n;cleanup{unsafe{report(this.n);}}}fn i32 main(){var v::Vec<Item> vector=v::empty<Item>();var i32 i=1;while(i<=8){assert(v::push<Item>(ref mut vector,Item{.n=i}).is_ok);i+=1;}let usize capacity=v::capacity<Item>(ref vector);switch(v::push<Item>(ref mut vector,Item{.n=9})){case .ok(_):{assert(false);}case .err(donor):{assert(donor.n==9);}};assert(v::len<Item>(ref vector)==8 && v::capacity<Item>(ref vector)==capacity);assert(v::at<Item>(ref vector,0).n==1 && v::at<Item>(ref vector,7).n==8);return 0;}",bytes::view(ref source));output(ref p);}
