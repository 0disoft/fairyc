@test @effects(console,filesystem) fn void sdk_c_rejects_forged_storage_metadata(){let source=input(5);let p=retained(b"module main;import std::vec as v;fn i32 main(){let v::Vec<i64> vector=v::empty<i64>();let ref i64[] empty=v::view_i64(ref vector);assert(empty.len==0);return 0;}",bytes::view(ref source));var usize frame=1;var usize found=0;while(frame<=ir::count(ref p)){let b=ir::at(ref p,frame);var usize i=0;while(i<ir::node_count(b)){let e=ir::node_at(b,i).value;if(e.kind==6 && e.builtin.kind==106 && e.builtin.slice){found=frame;}i+=1;}frame+=1;}assert(found!=0);let b=ir::at(ref p,found);var usize work=0;assert(storage_proof::check(ref p,b,found,ref mut work).code==0);var usize mode=0;while(mode<6){var v::Vec<ir::Node> nodes=v::empty<ir::Node>();var usize i=0;while(i<ir::node_count(b)){var n=ir::node_at(b,i);if(n.value.kind==6 && n.value.builtin.kind==106){if(mode==0){n.value.builtin.unsafe_context=false;}if(mode==1){n.value.builtin.kind=107;}if(mode==2){n.value.right=0;}if(mode==3){n.value.place.root=0;}if(mode==4){n.value.builtin.element=0;}}if(mode==5 && n.value.kind==20){n.value.start=0;}assert(v::push<ir::Node>(ref mut nodes,n).is_ok);i+=1;}let text=switch(bytes::copy(ir::text_view(b))){case .ok(t):{t}case .err(_):{assert(false);return;}};let changed=ir::assemble_body(ir::body(b),ir::source_bytes(b),ir::start(b),ir::end(b),nodes,v::empty<ir::Statement>(),v::empty<m::Local>(),v::empty<m::Invocation>(),v::empty<m::Argument>(),v::empty<regions::Scope>(),v::empty<regions::Exit>(),text);work=0;assert(storage_proof::check(ref p,ref changed,found,ref mut work).code==1001);mode+=1;}work=1048576;assert(storage_proof::check(ref p,b,found,ref mut work).code==1002);}
@test @effects(console,filesystem) fn void sdk_c_executes_nested_vector_move_and_cleanup(){let source=input(5);let p=retained(b"module main;import std::vec as v;@link_name(\"test_report\")unsafe extern C fn void report(i32 n);resource Leaf{i32 n;cleanup{unsafe{report(this.n);}}}resource Item{i32 n;Leaf left;Leaf right;cleanup{unsafe{report(100+this.n);}}}resource Holder{v::Vec<Item> values;cleanup{unsafe{report(900);}}}fn v::Vec<Item> transfer(v::Vec<Item> value){return value;}fn Item item(i32 n){return Item{.n=n,.left=Leaf{.n=n*10+1},.right=Leaf{.n=n*10+2}};}fn i32 main(){var v::Vec<Item> source=v::empty<Item>();assert(v::push<Item>(ref mut source,item(1)).is_ok);assert(v::push<Item>(ref mut source,item(2)).is_ok);var v::Vec<Item> owned=transfer(source);switch(v::pop<Item>(ref mut owned)){case .some(value):{assert(value.n==2 && value.left.n==21 && value.right.n==22);}case .none:{assert(false);}};assert(v::len<Item>(ref owned)==1);let Holder holder=Holder{.values=owned};return 0;}",bytes::view(ref source));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_nested_vector_failed_push_donor(){let source=input(5);let p=retained(b"module main;import std::vec as v;@link_name(\"test_report\")unsafe extern C fn void report(i32 n);resource Leaf{i32 n;cleanup{unsafe{report(this.n);}}}resource Item{i32 n;Leaf left;Leaf right;cleanup{unsafe{report(100+this.n);}}}resource Holder{v::Vec<Item> values;cleanup{unsafe{report(900);}}}fn i32 main(){var v::Vec<Item> source=v::empty<Item>();let Item original=Item{.n=7,.left=Leaf{.n=71},.right=Leaf{.n=72}};switch(v::push<Item>(ref mut source,original)){case .ok(_):{assert(false);}case .err(donor):{assert(donor.n==7 && donor.left.n==71 && donor.right.n==72);}};assert(v::len<Item>(ref source)==0);let Holder holder=Holder{.values=source};return 0;}",bytes::view(ref source));output(ref p);}
