module tests::generic_concrete_types;
import generic_concrete_types as concrete;
import generic_package_context as context;
import generic_package_bindings as bindings;
import generic_source_catalog as templates;
import generic_specialization_identity as identity;
import module_public_interface_model as model;
import module_public_interface_write as write;
import module_public_type_text as coordinates;
import module_signatures as signatures;
import module_catalog as catalog;
import module_types as types;
import syntax as syntax;
import scanner as scanner;
import file_source as files;
import std::bytes as bytes;
import std::process as process;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let n=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;return switch(files::load(view[..n])){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let n=number(wire,at);assert(*at<=wire.len && n<=wire.len-*at);let start=*at;*at+=n;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let digit=*v::at<usize>(digits,i);let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){assert(bytes::append_byte(ref mut names,if(digit==1){49}else if(digit==2){50}else if(digit==3){51}else{52}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> digits,ref v::Vec<catalog::Binding> imports,usize shift){let table=coords(digits,shift);var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<usize>(digits)){assert(v::push<usize>(ref mut owners,*v::at<usize>(digits,i)+shift).is_ok);i+=1;}var usize work=0;let packages=switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,digits,imports,shift);}};work=0;return switch(templates::build(packages,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);collected(sources,digits,imports,shift)}};}
fn model::Text retained(ref mut bytes::Buffer names,ref u8[] value,ref mut usize work){let start=bytes::len(names);assert(write::raw(names,value,work)==0);return model::Text{.start,.end=bytes::len(names)};}
fn bytes::Buffer leaf(ref concrete::Catalog p,ref templates::Catalog source,ref u8[] declaration){var usize at=0;while(at<templates::count(source)){let row=templates::template_at(source,at);if(bytes::equal(templates::text(source,row.id),declaration)){var bytes::Buffer names=bytes::empty();var usize work=0;let id=retained(ref mut names,templates::text(source,row.id),ref mut work);let packages=templates::packages(source);let owner=retained(ref mut names,bindings::text(packages,bindings::module_at(packages,row.module_index).namespace),ref mut work);let definition=retained(ref mut names,templates::text(source,row.definition),ref mut work);var v::Vec<identity::Concrete> arguments=v::empty<identity::Concrete>();var v::Vec<model::Text> abilities=v::empty<model::Text>();let selected=switch(concrete::lookup_id(p,b"i32",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(concrete::append_argument(p,selected,ref mut names,ref mut arguments,ref mut abilities,ref mut work)==0);let constraints=v::empty<identity::Constraint>();let operands=v::empty<identity::Operand>();let dependencies=v::empty<model::Text>();let facts=identity::assemble(names,identity::Root{.declaration=id,.owner,.definition},arguments,abilities,constraints,operands,dependencies);return switch(identity::compute(ref facts,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}at+=1;}assert(false);return bytes::empty();}
@test
@effects(filesystem)
fn void actual_catalog_types_and_leaf_specializations_match_go(){let fixture=fixture();let wire=bytes::view(ref fixture);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGTYPE1"));var usize at=8;assert(number(wire,ref mut at)==4);var usize c=0;while(c<4){discard field(wire,ref mut at);let count=number(wire,ref mut at);let usize shift=if(c==2){19}else{0};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,i),j+1);assert(bytes::equal(alias,syntax::source_view(v::at<syntax::Parsed>(ref sources,i))[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let source=collected(ref sources,ref digits,ref imports,shift);var context::Budget budget=context::empty();let types=switch(concrete::build(ref source,ref sources,ref mut budget)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(bytes::equal(concrete::closed_digest(ref types),field(wire,ref mut at)));let expected=number(wire,ref mut at);assert(concrete::count(ref types)==expected);i=0;while(i<expected){let row=concrete::at(ref types,i);assert(bytes::equal(concrete::text(ref types,row.id),field(wire,ref mut at)) && bytes::equal(concrete::text(ref types,row.owner),field(wire,ref mut at)) && bytes::equal(concrete::text(ref types,row.definition),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(concrete::ability_count(ref types,i)==n);var usize j=0;while(j<n){assert(bytes::equal(concrete::ability_at(ref types,i,j),field(wire,ref mut at)));j+=1;}var usize work=0;assert(switch(concrete::lookup_id(ref types,concrete::text(ref types,row.id),ref mut work)){case .ok(value):{value==i+1}case .err(_):{false}});i+=1;}let declaration=field(wire,ref mut at);let expected_leaf=field(wire,ref mut at);let actual=leaf(ref types,ref source,declaration);assert(bytes::equal(bytes::view(ref actual),expected_leaf));var v::Vec<usize> owners=v::empty<usize>();i=0;while(i<count){assert(v::push<usize>(ref mut owners,*v::at<usize>(ref digits,i)+shift).is_ok);i+=1;}let declarations=switch(catalog::build_scoped(ref sources,ref owners,ref imports)){case .ok(value):{value}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(ref sources,declarations)){case .ok(value):{value}case .err(_):{assert(false);return;}};var v::Vec<types::Type> graph=v::empty<types::Type>();i=1;while(i<=signatures::type_count(ref metadata)){assert(v::push<types::Type>(ref mut graph,signatures::type_at(ref metadata,i)).is_ok);i+=1;}i=0;while(i<expected){let row=concrete::at(ref types,i);if(row.kind!=1){let r=signatures::declaration_type(ref metadata,row.module_index,row.declaration,ref mut graph);assert(r.problem.code==0);var usize work=0;assert(switch(concrete::lookup_typed(ref types,types::at(ref graph,r.type),ref mut work)){case .ok(value):{value==i+1}case .err(_):{false}});}i+=1;}c+=1;}assert(at==wire.len);}
fn ref u8[] source(u32 mode){
if(mode==0){return b"module root;import helper as h;import helper as a;import std::vec as vec;struct Local{i32 n;}resource Owned{i32 n;cleanup{}}pub fn T api<T>(T value){return h::id<T>(value);}fn void use(){let i32 value=h::id<i32>(1);let vec::Vec<h::Token> items=vec::empty<h::Token>();discard value;discard items;}";}
if(mode==1){return b"module helper;pub struct Token{i32 value;}struct Hidden{i32 n;}pub resource Handle{i32 value;cleanup{}}pub fn T id<T>(T value){return value;}fn i32 private_helper(){return 1;}";}
if(mode==2){return b"module helper;pub struct Token{i32 value;}struct Hidden{i32 n;}pub resource Handle{i32 value;cleanup{}}pub fn T id<T>(T value){return value;}fn i32 private_helper(){return 2;}";}
return b"";}
fn templates::Catalog small_source(ref v::Vec<syntax::Parsed> sources){var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok);let imports=v::empty<catalog::Binding>();return collected(sources,ref digits,ref imports,0);}
fn v::Vec<syntax::Parsed> small_sources(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;struct Local{i32 n;}pub resource Owned{i32 n;cleanup{}}enum Flag{ready;}" )).is_ok);return sources;}
fn concrete::Catalog detached(){let sources=small_sources();let source=small_source(ref sources);var context::Budget budget=context::empty();return switch(concrete::build(ref source,ref sources,ref mut budget)){case .ok(value):{value}case .err(_):{assert(false);detached()}};}
@test
fn void imported_nominal_types_keep_provider_and_visibility(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;import helper as h;import helper as a;struct Local{i32 n;}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module helper;pub struct Token{i32 n;}struct Hidden{i32 n;}")).is_ok);var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok && v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=3,.target=1}).is_ok);let source=collected(ref sources,ref digits,ref imports,0);var context::Budget budget=context::empty();let p=switch(concrete::build(ref source,ref sources,ref mut budget)){case .ok(value):{value}case .err(_):{assert(false);return;}};var usize work=0;let first=switch(concrete::lookup_source(ref p,0,b"h::Token",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(switch(concrete::lookup_source(ref p,0,b"a::Token",ref mut work)){case .ok(value):{value==first}case .err(_):{false}});let row=concrete::at(ref p,first-1);assert(row.module_index==1 && row.declaration==2);assert(switch(concrete::lookup_source(ref p,0,b"h::Hidden",ref mut work)){case .ok(_):{false}case .err(code):{code==13}});assert(switch(concrete::lookup_source(ref p,1,b"Hidden",ref mut work)){case .ok(value):{concrete::at(ref p,value-1).module_index==1}case .err(_):{false}});assert(switch(concrete::lookup_source(ref p,0,b"h::sub::Token",ref mut work)){case .ok(_):{false}case .err(code):{code==9}});}
@test
fn void retained_type_properties_and_admission_boundaries(){let p=detached();assert(concrete::count(ref p)==15);var usize work=0;let scalar=switch(concrete::lookup_source(ref p,0,b"i32",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(concrete::ability_count(ref p,scalar-1)==5);let local=switch(concrete::lookup_source(ref p,0,b"Local",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(concrete::ability_count(ref p,local-1)==0 && concrete::at(ref p,local-1).kind==2);let owned=switch(concrete::lookup_source(ref p,0,b"Owned",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(concrete::ability_count(ref p,owned-1)==0 && concrete::at(ref p,owned-1).kind==3);assert(switch(concrete::lookup_source(ref p,0,b"Flag",ref mut work)){case .ok(_):{false}case .err(code):{code==9}});assert(switch(concrete::lookup_source(ref p,0,b"missing::Local",ref mut work)){case .ok(_):{false}case .err(code):{code==9}});assert(switch(concrete::lookup_id(ref p,b"missing",ref mut work)){case .ok(_):{false}case .err(code):{code==9}});let invalid=types::Type{.kind=1,.scalar=7,.module_index=0,.declaration=0,.first=0,.second=0};assert(switch(concrete::lookup_typed(ref p,invalid,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});let vector=types::Type{.kind=13,.scalar=0,.module_index=0,.declaration=1,.first=1,.second=0};assert(switch(concrete::lookup_typed(ref p,vector,ref mut work)){case .ok(_):{false}case .err(code):{code==4503}});var u32 kind=1;while(kind<=6){assert(switch(concrete::lookup_typed(ref p,types::Type{.kind=1,.scalar=kind,.module_index=0,.declaration=0,.first=0,.second=0},ref mut work)){case .ok(value):{concrete::at(ref p,value-1).scalar==kind}case .err(_):{false}});kind+=1;}}
@test
fn void stale_sources_and_shared_collection_limits(){let sources=small_sources();let source=small_source(ref sources);var context::Budget measured=context::empty();let expected=switch(concrete::build(ref source,ref sources,ref mut measured)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(measured.work>0 && measured.work<16777216 && measured.encoded_work>0 && measured.hashed_bytes>0);var context::Budget exact=context::empty();exact.work=16777216-measured.work;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(value):{concrete::count(ref value)==concrete::count(ref expected)}case .err(_):{false}} && exact.work==16777216);exact=context::empty();exact.work=16777216-measured.work+1;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(_):{false}case .err(code):{code==10}} && exact.code==10);exact=context::empty();exact.encoded_work=context::encoding_limit()-measured.encoded_work;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(_):{true}case .err(_):{false}} && exact.encoded_work==context::encoding_limit());exact=context::empty();exact.hashed_bytes=context::hash_limit()-measured.hashed_bytes;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(_):{true}case .err(_):{false}} && exact.hashed_bytes==context::hash_limit());exact=context::empty();exact.hashed_bytes=context::hash_limit()-measured.hashed_bytes+1;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(_):{false}case .err(code):{code==10}});exact=context::empty();exact.code=95;assert(switch(concrete::build(ref source,ref sources,ref mut exact)){case .ok(_):{false}case .err(code):{code==95}});var v::Vec<syntax::Parsed> changed=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut changed,parsed(b"module root;struct Local{i64 n;}pub resource Owned{i32 n;cleanup{}}enum Flag{ready;}")).is_ok);exact=context::empty();assert(switch(concrete::build(ref source,ref changed,ref mut exact)){case .ok(_):{false}case .err(code):{code==12}});}
@test
fn void argument_copy_and_lookup_work_boundaries(){let p=detached();var usize work=0;let selected=switch(concrete::lookup_id(ref p,b"i32",ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};let cost=work;work=16777216-cost;assert(switch(concrete::lookup_id(ref p,b"i32",ref mut work)){case .ok(value):{value==selected}case .err(_):{false}} && work==16777216);work=16777216-cost+1;assert(switch(concrete::lookup_id(ref p,b"i32",ref mut work)){case .ok(_):{false}case .err(code):{code==10}});var bytes::Buffer names=bytes::empty();var v::Vec<identity::Concrete> arguments=v::empty<identity::Concrete>();var v::Vec<model::Text> abilities=v::empty<model::Text>();work=0;assert(concrete::append_argument(ref p,selected,ref mut names,ref mut arguments,ref mut abilities,ref mut work)==0);let copied=work;var bytes::Buffer exact_names=bytes::empty();var v::Vec<identity::Concrete> exact_arguments=v::empty<identity::Concrete>();var v::Vec<model::Text> exact_abilities=v::empty<model::Text>();work=1048576-copied;assert(concrete::append_argument(ref p,selected,ref mut exact_names,ref mut exact_arguments,ref mut exact_abilities,ref mut work)==0 && work==1048576 && v::len<identity::Concrete>(ref exact_arguments)==1 && v::len<model::Text>(ref exact_abilities)==5 && bytes::equal(bytes::view(ref names),bytes::view(ref exact_names)));discard bytes::clear(ref mut exact_names);discard v::clear<identity::Concrete>(ref mut exact_arguments);discard v::clear<model::Text>(ref mut exact_abilities);work=1048576-copied+1;assert(concrete::append_argument(ref p,selected,ref mut exact_names,ref mut exact_arguments,ref mut exact_abilities,ref mut work)==10);work=0;assert(concrete::append_argument(ref p,0,ref mut exact_names,ref mut exact_arguments,ref mut exact_abilities,ref mut work)==9);}
