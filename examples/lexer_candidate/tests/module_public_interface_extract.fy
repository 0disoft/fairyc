module tests::module_public_interface_extract;
import module_public_interface_extract as extract;
import module_public_interface as public_interface;
import module_public_interface_model as model;
import module_public_type_text as public_type;
import module_signatures as signatures;
import module_catalog as catalog;
import module_unit_interfaces as typed;
import module_unit_bind as bind;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
pub resource Context{v::Vec<syntax::Parsed> sources;signatures::Program metadata;typed::Interfaces graph;cleanup{}}
fn syntax::Parsed parsed(ref u8[] source){let b=switch(bytes::copy(source)){case .ok(b):{b}case .err(_):{assert(false);return parsed(source);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(source);}};return switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(source);}};}
fn Context context(u32 mode,usize owner){
  var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var usize i=0;let usize count=if(mode==3){1}else{2};
  while(i<count){assert(v::push<syntax::Parsed>(ref mut sources,parsed(input(mode,i))).is_ok);assert(v::push<usize>(ref mut owners,owner).is_ok);i+=1;}
  let bindings=v::empty<catalog::Binding>();let c=switch(catalog::build_scoped(ref sources,ref owners,ref bindings)){case .ok(c):{c}case .err(_):{assert(false);return context(mode,owner);}};
  let metadata=switch(signatures::build_catalog(ref sources,c)){case .ok(p):{p}case .err(_):{assert(false);return context(mode,owner);}};
  let bound=switch(bind::bind(ref sources,ref metadata,0,count)){case .ok(b):{b}case .err(_):{assert(false);return context(mode,owner);}};
  let graph=switch(typed::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return context(mode,owner);}};return Context{.sources,.metadata,.graph};
}
fn public_type::Coordinates coordinates(usize owner,bool present){var bytes::Buffer names=bytes::empty();assert(bytes::append(ref mut names,coordinate()).is_ok);var v::Vec<public_type::Coordinate> rows=v::empty<public_type::Coordinate>();if(present){assert(v::push<public_type::Coordinate>(ref mut rows,public_type::Coordinate{.owner,.start=0,.end=bytes::len(ref names)}).is_ok);}return public_type::assemble(names,rows);}
fn extract::Projection projected(ref Context p,ref public_type::Coordinates coordinates,usize owner){var usize work=0;return switch(extract::extract(ref p.sources,ref p.metadata,ref p.graph,coordinates,owner,ref mut work)){case .ok(d):{d}case .err(_):{assert(false);return projected(p,coordinates,owner);}};}
fn bytes::Buffer encoded(ref Context p,ref extract::Projection projection,usize owner){var usize work=0;return switch(public_interface::encode(signatures::state_layouts(ref p.metadata),owner,extract::descriptor(projection),ref mut work)){case .ok(b):{b}case .err(_):{assert(false);return encoded(p,projection,owner);}};}
fn bytes::Buffer hashed(ref Context p,ref extract::Projection projection,usize owner){var usize work=0;return switch(signatures::public_interface_hash(ref p.metadata,owner,extract::descriptor(projection),ref mut work)){case .ok(b):{b}case .err(_):{assert(false);return hashed(p,projection,owner);}};}
fn u8 digit(u8 value){return if(value<=57){value-48}else{value-87};}
fn bool matches_hex(ref u8[] actual,ref u8[] hex){if(actual.len*2!=hex.len){return false;}var usize i=0;while(i<actual.len){if(actual[i]!=digit(hex[i*2])*16+digit(hex[i*2+1])){return false;}i+=1;}return true;}
@test
fn void actual_typed_source_matches_go_public_v5_bytes_and_hash(){let p=context(0,7);let coords=coordinates(7,true);let d=projected(ref p,ref coords,7);assert(!extract::has_templates(ref d));let descriptor=extract::descriptor(ref d);assert(model::module_count(descriptor)==2 && model::item_count(descriptor)==7 && model::variant_count(descriptor)==2);let actual=encoded(ref p,ref d,7);assert(matches_hex(bytes::view(ref actual),expected_hex()));let hash=hashed(ref p,ref d,7);assert(expected_hash(bytes::view(ref hash),false));}
@test
fn void declaration_order_private_bodies_and_disposable_owners_preserve_hash(){let p=context(1,19);let coords=coordinates(19,true);let d=projected(ref p,ref coords,19);let actual=encoded(ref p,ref d,19);assert(matches_hex(bytes::view(ref actual),expected_hex()));let hash=hashed(ref p,ref d,19);assert(expected_hash(bytes::view(ref hash),false));let changed=context(2,7);let changed_coords=coordinates(7,true);let changed_d=projected(ref changed,ref changed_coords,7);let changed_hash=hashed(ref changed,ref changed_d,7);assert(expected_hash(bytes::view(ref changed_hash),true));assert(!bytes::equal(bytes::view(ref hash),bytes::view(ref changed_hash)));}
@test
fn void public_templates_remain_explicit_and_missing_or_stale_inputs_reject(){let generic=context(3,7);let coords=coordinates(7,true);let d=projected(ref generic,ref coords,7);assert(extract::has_templates(ref d));assert(model::item_count(extract::descriptor(ref d))==1);let p=context(0,7);let missing=coordinates(7,false);var usize work=0;assert(switch(extract::extract(ref p.sources,ref p.metadata,ref p.graph,ref missing,7,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});var v::Vec<syntax::Parsed> changed=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut changed,parsed(b"module api;pub struct Leaf{i32 value;}")).is_ok);assert(v::push<syntax::Parsed>(ref mut changed,parsed(input(0,1))).is_ok);work=0;assert(switch(extract::extract(ref changed,ref p.metadata,ref p.graph,ref coords,7,ref mut work)){case .ok(_):{false}case .err(code):{code==12}});}
@test
fn void extraction_honors_exact_shared_work_allowance(){let p=context(0,7);let coords=coordinates(7,true);var usize cost=0;assert(switch(extract::extract(ref p.sources,ref p.metadata,ref p.graph,ref coords,7,ref mut cost)){case .ok(_):{true}case .err(_):{false}});assert(cost>0 && cost<1048576);var usize work=1048576-cost;assert(switch(extract::extract(ref p.sources,ref p.metadata,ref p.graph,ref coords,7,ref mut work)){case .ok(_):{true}case .err(_):{false}});assert(work==1048576);work=1048576-cost+1;assert(switch(extract::extract(ref p.sources,ref p.metadata,ref p.graph,ref coords,7,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});assert(work<=1048576);}
fn ref u8[] input(u32 mode,usize i){
  if(mode==0 && i==0){return b"module api;pub struct Leaf{i64 value;}@repr(C)pub struct Wire{c::int value;c::uint code;}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);fn i32 hidden(){return 1;}";}
  if(mode==0 && i==1){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==1 && i==0){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==1 && i==1){return b"module api;fn i32 hidden(){return 99;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@repr(C)pub struct Wire{c::int value;c::uint code;}pub struct Leaf{i64 value;}";}
  if(mode==2 && i==0){return b"module api;pub struct Leaf{i32 value;}@repr(C)pub struct Wire{c::int value;c::uint code;}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);fn i32 hidden(){return 1;}";}
  if(mode==2 && i==1){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==3 && i==0){return b"module generic;pub fn T identity<T>(T value){return value;}pub fn i32 token(){return 7;}";}
  return b"";
}
fn ref u8[] coordinate(){return b"fypc1-sha256-1885acb49443b933c42734be7ede939614972f6110b78260fc40b67fd23c26f3";}
// Generated from actual Go frontend + semantic.Analyze + moduleinterface.Extract/Encode/Compute.
fn ref u8[] expected_hex(){return b"";}
fn bool expected_hash(ref u8[] actual,bool changed){if(changed){return bytes::equal(actual,b"fyif5-sha256-a919d86c16731341cf6ad778dc6d1660088ade9a7155d7add89ea3f15ee4d036");}return bytes::equal(actual,b"fyif5-sha256-a9c489cf3fee25454bcfdcbb229c785bc9abc3c15270fcbec0a4fe940dfed81c");}
