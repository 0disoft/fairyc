module tests::module_unit_names;
import module_unit_names as names;
import module_unit_bodies as bodies;
import module_unit_body_ast as ast;
import module_unit_interfaces as interfaces;
import module_unit_bind as binding;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import file_source as files;
import std::bytes as bytes;
import std::vec as v;
import std::process as process;

fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn interfaces::Interfaces imported(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let b=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return imported(sources,metadata);}};return switch(interfaces::build(sources,metadata,ref b)){case .ok(p):{p}case .err(_):{assert(false);imported(sources,metadata)}};}
fn bodies::Plan cloned(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref interfaces::Interfaces p){return switch(bodies::build(sources,metadata,p)){case .ok(b):{b}case .err(_):{assert(false);cloned(sources,metadata,p)}};}
@test fn void lexical_scopes_patterns_loop_headers_and_provider_coordinates_are_owned(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){return p::go<i32>(1);}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module provider;fn i32 helper(i32 n){return n;}pub fn T go<T>(T value){let T outer=value;if(true){let T value=outer;discard value;}for(var i32 k=0;k<2;k+=1){let i32 outer=k;discard outer;}for(let u8 byte in b\"x\"){discard byte;}let Option<i32> subject=.some(2);let i32 selected=switch(subject){case .some(n):{helper(n)}case .none:{0}};return value;}")).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let imported=imported(ref sources,ref metadata);let owned=cloned(ref sources,ref metadata,ref imported);let p=switch(names::build(ref sources,ref metadata,ref imported,ref owned)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(names::function_count(ref p)==1 && names::cleanup_count(ref p)==0 && names::work(ref p)<1048576);let resolved=names::function_at(ref p,1);let a=bodies::body_ast(bodies::at(ref owned,1));let stream=bodies::source_at(ref owned,1);let text=scanner::source_view(stream);var usize parameter=0;var usize inner=0;var usize patterns=0;var usize bytes=0;var usize i=1;
    while(i<=names::local_count(resolved)){let s=names::symbol_at(resolved,i);if(s.kind==1){parameter=i;assert(bodies::type_at(ref owned,s.type).scalar==1 && names::entry_symbol(resolved,s.entry)==i);}else if(s.kind==2 && bytes::equal(text[s.start..s.end],b"value")){inner=i;}if(s.kind==4){patterns+=1;assert(s.type==0 && names::pattern_symbol(resolved,s.pattern)==i);}if(s.kind==5){bytes+=1;assert(bodies::type_at(ref owned,s.type).scalar==3);}i+=1;}assert(parameter!=0 && inner!=0 && parameter!=inner && patterns==1 && bytes==1);
    i=1;var usize globals=0;var usize outer_uses=0;var usize inner_uses=0;while(i<=names::references(resolved)){let r=names::reference_at(resolved,i);assert(r.source_index==ast::expression_origin(a,r.expression) && names::use_at(resolved,r.expression)==i && r.end<=text.len && r.start<r.end);if(r.kind==2){globals+=1;assert(r.module_index==1 && r.declaration==2 && r.declaration_kind==3 && bytes::equal(text[r.start..r.end],b"helper"));}else{assert(r.kind==1);if(r.symbol==parameter){outer_uses+=1;}if(r.symbol==inner){inner_uses+=1;}}i+=1;}assert(globals==1 && outer_uses==2 && inner_uses==1);
}
fn void denied(ref u8[] provider,u32 code,ref u8[] token){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){return p::go<i32>(1);}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let imported=imported(ref sources,ref metadata);let owned=cloned(ref sources,ref metadata,ref imported);switch(names::build(ref sources,ref metadata,ref imported,ref owned)){case .ok(p):{assert(code==0 && names::symbol_count(ref p)==128);}case .err(p):{assert(p.code==code && p.module_index==1 && bytes::equal(provider[p.start..p.end],token));}};}
@test fn void use_before_definition_duplicates_and_escaped_patterns_are_rejected(){
    denied(b"module provider;pub fn T go<T>(T n){discard later;let i32 later=0;return n;}",1,b"later");
    denied(b"module provider;pub fn T go<T>(T n){let T value=n;let T value=n;return value;}",2,b"value");
    denied(b"module provider;pub fn T go<T>(T n){let Option<i32> subject=.none;let i32 value=switch(subject){case .some(local):{local}case .none:{0}};discard local;return n;}",1,b"local");
    denied(b"module provider;pub fn T go<T>(T n){for(var i32 k=0;k<1;k+=1){discard k;}discard k;return n;}",1,b"k");
}
@test fn void private_imports_and_stale_owned_bodies_are_not_published(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){return p::go<i32>(1);}")).is_ok);let text=b"module provider;import secret as s;pub fn T go<T>(T n){discard s::hidden();return n;}";assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module secret;fn i32 hidden(){return 1;}")).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let imported=imported(ref sources,ref metadata);let owned=cloned(ref sources,ref metadata,ref imported);switch(names::build(ref sources,ref metadata,ref imported,ref owned)){case .ok(_):{assert(false);}case .err(p):{assert(p.code==6 && p.module_index==1 && bytes::equal(text[p.start..p.end],b"s::hidden"));}};
    discard v::pop<syntax::Parsed>(ref mut sources);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module secret;pub fn i32 hidden(){return 1;}")).is_ok);let fresh=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};switch(names::build(ref sources,ref fresh,ref imported,ref owned)){case .ok(_):{assert(false);}case .err(p):{assert(p.code==12 && p.module_index==2);}};
}
@effects(filesystem)
@test fn void sdk_storage_refs_unsafe_context_and_dropping_receiver_are_distinct(){
    var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let usize n=switch(process::arg(1,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return;}};let sdk=switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);return;}};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import std::vec as v;fn usize main(){let v::Vec<i32> value=v::empty<i32>();return v::len<i32>(ref value);}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref sdk))).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};let imported=imported(ref sources,ref metadata);let owned=cloned(ref sources,ref metadata,ref imported);let p=switch(names::build(ref sources,ref metadata,ref imported,ref owned)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(names::function_count(ref p)==2 && names::cleanup_count(ref p)==1);let resolved_cleanup=names::cleanup_at(ref p,1);let receiver=names::symbol_at(resolved_cleanup,1);assert(receiver.kind==10 && receiver.type==bodies::cleanup_info(bodies::cleanup_at(ref owned,1)).type && receiver.entry==0 && receiver.pattern==0);var usize private_leaf=0;var usize foreign=0;var usize i=1;while(i<=names::references(resolved_cleanup)){let r=names::reference_at(resolved_cleanup,i);if(r.kind==2){assert(r.module_index==1);if(r.declaration_kind==3){assert(!r.unsafe_context && r.declaration==bodies::cleanup_edge_at(bodies::cleanup_at(ref owned,1),0).target.inline_declaration);private_leaf+=1;}else{assert(r.declaration_kind==9 && r.unsafe_context);foreign+=1;}}if(r.kind==1 && r.symbol==1){assert(names::symbol_at(resolved_cleanup,r.symbol).kind==10);}i+=1;}assert(private_leaf==1 && foreign==2);
    var usize intrinsics=0;i=1;while(i<=names::function_count(ref p)){let f=names::function_at(ref p,i);var usize r=1;while(r<=names::references(f)){let use=names::reference_at(f,r);if(use.kind==3){assert(use.builtin>=101 && use.builtin<=107 && use.unsafe_context);intrinsics+=1;}r+=1;}i+=1;}assert(intrinsics==2);
}
fn void suffix(ref mut bytes::Buffer out,usize n){let digits=b"0123456789";if(n>=100){assert(bytes::append_byte(out,digits[n/100]).is_ok);}if(n>=10){assert(bytes::append_byte(out,digits[(n/10)%10]).is_ok);}assert(bytes::append_byte(out,digits[n%10]).is_ok);}
@test fn void active_local_capacity_stays_at_128_with_original_failure_span(){
    var bytes::Buffer text=bytes::empty();assert(bytes::append(ref mut text,b"module provider;pub fn T go<T>(T n){").is_ok);var usize i=0;while(i<127){assert(bytes::append(ref mut text,b"let i32 v").is_ok);suffix(ref mut text,i);assert(bytes::append(ref mut text,b"=0;").is_ok);i+=1;}let usize prefix=bytes::len(ref text);assert(bytes::append(ref mut text,b"return n;}").is_ok);denied(bytes::view(ref text),0,b"");assert(bytes::resize_zeroed(ref mut text,prefix).is_ok);assert(bytes::append(ref mut text,b"let i32 v127=0;return n;}").is_ok);denied(bytes::view(ref text),10,b"v127");
}
