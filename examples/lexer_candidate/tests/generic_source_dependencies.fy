module tests::generic_source_dependencies;
import generic_source_dependencies as dependencies;
import generic_source_dependency_model as model;
import generic_source_dependency_json as json;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::fs as fs;
import std::text as text;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else{b"3"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=0;return switch(templates::build(resolved,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
@test
@effects(filesystem,console)
fn void matches_real_go_canonical_declarations(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGDEP01"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==4);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let total=number(wire,ref mut at);var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;
        while(i<total){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(field(wire,ref mut at))).is_ok);let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let p=v::at<syntax::Parsed>(ref input,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(syntax::source_view(p)[d.name_start..d.name_end],alias));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;
        }let original=collected(ref input,ref imports,ref digits,if(c==2){19}else{0});var usize work=0;let graph=switch(dependencies::build(original,ref input,ref mut work)){case .ok(value):{value}case .err(p):{discard io::write_stderr_bytes(label);discard io::write_stderr(" graph code ");discard io::write_stderr_u32(p.code);discard io::write_stderr(" declaration ");discard io::write_stderr_usize(p.declaration);assert(false);return;}};let catalog=model::templates(ref graph);let count=number(wire,ref mut at);assert(templates::count(catalog)==count && count==25);i=0;
        while(i<count){let id=field(wire,ref mut at);let expected=field(wire,ref mut at);let closure=field(wire,ref mut at);assert(closure.len==64);let row=templates::template_at(catalog,i);assert(bytes::equal(id,templates::text(catalog,row.id)));work=0;let actual=switch(json::encode(ref graph,i,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};if(!bytes::equal(expected,bytes::view(ref actual))){discard io::write_stderr_bytes(label);discard io::write_stderr_bytes(id);discard io::write_stderr("\nexpected: ");discard io::write_stderr_bytes(expected);discard io::write_stderr("\nactual: ");discard io::write_stderr_bytes(bytes::view(ref actual));assert(false);}i+=1;
        }assert(model::edge_count(model::data(ref graph))==if(c==1){29}else{28});c+=1;
    }assert(at==wire.len);
}
fn ref u8[] root(){return b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}pub fn T cycle<T>(T value){return cycle<T>(value);}";}
fn ref u8[] provider(){return b"module helper;pub fn T id<T>(T value){return value;}fn T secret<T>(T value){return value;}";}
fn v::Vec<syntax::Parsed> small_sources(ref u8[] first,ref u8[] second){var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,parsed(first)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(second)).is_ok);return input;}
fn v::Vec<catalog::Binding> small_imports(){var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);return imports;}
fn v::Vec<usize> small_digits(){var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);return digits;}
fn model::Graph detached(ref mut usize work){let input=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let catalog=collected(ref input,ref imports,ref digits,0);return switch(dependencies::build(catalog,ref input,work)){case .ok(value):{value}case .err(_):{assert(false);return detached(work);}};}
@test
fn void owns_direct_edges_cycles_and_exact_work_boundaries(){var usize cost=0;let graph=detached(ref mut cost);assert(cost>0 && cost<16777216);let catalog=model::templates(ref graph);let data=model::data(ref graph);assert(templates::count(catalog)==4 && model::edge_count(data)==2);let api=model::range_at(data,0);let cycle=model::range_at(data,1);assert(api.count==1 && cycle.count==1);let edge=model::edge_at(data,cycle.first);assert(edge.target==2);var usize work=16777216-cost;let fit=detached(ref mut work);assert(work==16777216 && model::edge_count(model::data(ref fit))==2);let input=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);work=16777216-cost+1;assert(switch(dependencies::build(c,ref input,ref mut work)){case .ok(_):{false}case .err(p):{p.code==10}});assert(work<=16777216);
    work=0;let encoded=switch(json::encode(ref graph,0,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let json_cost=work;work=1048576-json_cost;let same=switch(json::encode(ref graph,0,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(work==1048576 && bytes::equal(bytes::view(ref encoded),bytes::view(ref same)));work=1048576-json_cost+1;assert(switch(json::encode(ref graph,0,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});
}
fn u32 rejected(ref u8[] first,ref u8[] second){let input=small_sources(first,second);let imports=small_imports();let digits=small_digits();let c=collected(ref input,ref imports,ref digits,0);var usize work=0;return switch(dependencies::build(c,ref input,ref mut work)){case .ok(_):{0}case .err(p):{p.code}};}
@test
fn void rejects_stale_private_unknown_and_invalid_arguments(){let original=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let c=collected(ref original,ref imports,ref digits,0);let changed=small_sources(root(),b"module helper;pub fn T id<T>(T value){return other;}");var usize work=0;assert(switch(dependencies::build(c,ref changed,ref mut work)){case .ok(_):{false}case .err(p):{p.code==12 && p.module_index==1}});assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){return a::secret<T>(value);}",provider())==13);assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){return missing<T>(value);}",provider())==4501);assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T,i32>(value);}",provider())==4501);assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){return a::id<ref T>(value);}",provider())==4501);assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){return a::id(value);}",provider())==4501);assert(rejected(b"module root;import helper as a;pub fn T api<T>(T value){let T api=value;return value;}",provider())==4501);assert(rejected(b"module root;import helper as a;struct T{i32 value;}pub fn i32 api<T>(i32 value){return value;}",provider())==4501);assert(rejected(b"module root;import helper as a;pub fn _fy_generic_hidden api<T>(T value){return value;}",provider())==4501);
}
