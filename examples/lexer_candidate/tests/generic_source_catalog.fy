module tests::generic_source_catalog;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_public_type_text as coordinates;
import module_catalog as catalog;
import syntax as syntax;
import scanner as scanner;
import file_source as files;
import std::bytes as bytes;
import std::process as process;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn coordinates::Coordinates coords(usize count,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<count){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){assert(bytes::append(ref mut names,if(i==0){b"1"}else if(i==1){b"2"}else{b"3"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,usize shift,bool vector,bool reverse){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,if(reverse){1-i+shift}else{i+shift}).is_ok);i+=1;}var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();let usize from=if(reverse){1}else{0};let usize target=if(reverse){0}else{1};assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=from,.declaration=2,.target}).is_ok && v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=from,.declaration=3,.target}).is_ok);if(vector){assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=4,.target=2}).is_ok);}let table=coords(v::len<syntax::Parsed>(sources),shift);var usize work=0;return switch(bindings::build(sources,ref owners,ref imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,shift,vector,reverse);}};}
fn ref u8[] raw(usize mode){if(mode==0){return b"module root;import helper as a;import helper as a0;pub fn T export<T>(T value){return a::id<T>(value);}fn T local<T>(T value){return value;}";}return b"module helper;pub fn U id<U>(U value){return value;}fn A pair<A,B>(A a,B b){return a;}fn T secret<T>(T value){return value;}";}
fn v::Vec<syntax::Parsed> sources(bool reverse){var v::Vec<syntax::Parsed> out=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut out,parsed(raw(if(reverse){1}else{0}))).is_ok && v::push<syntax::Parsed>(ref mut out,parsed(raw(if(reverse){0}else{1}))).is_ok);return out;}
fn templates::Catalog detached(usize shift,bool reverse,ref mut usize work){let input=sources(reverse);let resolved=bound(ref input,shift,false,reverse);return switch(templates::build(resolved,ref input,work)){case .ok(value):{value}case .err(_):{assert(false);return detached(shift,reverse,work);}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;return switch(files::manifest(view[..size])){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@test
@effects(filesystem)
fn void matches_go_original_declarations_and_sdk_definitions(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>=16 && bytes::equal(wire[..8],b"FYGSCAT1"));var usize at=8;let total=number(wire,ref mut at);assert(total==3);var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();var usize i=0;while(i<total){assert(v::push<syntax::Parsed>(ref mut input,parsed(field(wire,ref mut at))).is_ok);i+=1;}let resolved=bound(ref input,0,true,false);var usize work=0;let actual=switch(templates::build(resolved,ref input,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let count=number(wire,ref mut at);assert(count==21 && templates::count(ref actual)==count);i=0;while(i<count){let row=templates::template_at(ref actual,i);assert(row.module_index==number(wire,ref mut at) && (row.kind as usize)==number(wire,ref mut at) && row.start==number(wire,ref mut at) && row.end==number(wire,ref mut at) && row.name_start==number(wire,ref mut at) && row.name_end==number(wire,ref mut at) && row.public==(number(wire,ref mut at)==1));assert(bytes::equal(templates::text(ref actual,row.name),field(wire,ref mut at)) && bytes::equal(templates::text(ref actual,row.id),field(wire,ref mut at)) && bytes::equal(templates::text(ref actual,row.definition),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(row.count==n);var usize j=0;while(j<n){let p=templates::parameter_at(ref actual,row.first+j);assert(bytes::equal(templates::text(ref actual,p.name),field(wire,ref mut at)) && p.scalar==(number(wire,ref mut at)==1));j+=1;}i+=1;}assert(at==wire.len);
    work=0;let vector=switch(templates::lookup(ref actual,0,b"vectors::Vec",0,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(vector!=0 && templates::template_at(ref actual,vector-1).kind==6);work=0;assert(switch(templates::lookup(ref actual,0,b"vectors::Vec",3,ref mut work)){case .ok(value):{value==0}case .err(_):{false}});
}
@test
fn void owns_templates_and_resolves_exact_aliases_with_privacy(){var usize work=0;let p=detached(0,false,ref mut work);assert(templates::count(ref p)==5);work=0;let a=switch(templates::lookup(ref p,0,b"a::id",3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};let b=switch(templates::lookup(ref p,0,b"a0::id",3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};assert(a!=0 && a==b && templates::template_at(ref p,a-1).module_index==1);assert(switch(templates::lookup(ref p,0,b"a::secret",3,ref mut work)){case .ok(_):{false}case .err(code):{code==13}});assert(switch(templates::lookup(ref p,1,b"secret",3,ref mut work)){case .ok(value):{value!=0}case .err(_):{false}});assert(switch(templates::lookup(ref p,0,b"helper::id",3,ref mut work)){case .ok(value):{value==0}case .err(_):{false}});assert(switch(templates::lookup(ref p,0,b"a::nested::id",3,ref mut work)){case .ok(value):{value==0}case .err(_):{false}});assert(switch(templates::lookup(ref p,0,b"local",0,ref mut work)){case .ok(value):{value==0}case .err(_):{false}});assert(switch(templates::lookup(ref p,9,b"local",3,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});
    work=0;let other=detached(19,true,ref mut work);var usize i=0;while(i<templates::count(ref p)){let left=templates::template_at(ref p,i);let right=templates::template_at(ref other,i);assert(bytes::equal(templates::text(ref p,left.id),templates::text(ref other,right.id)) && bytes::equal(templates::text(ref p,left.definition),templates::text(ref other,right.definition)));i+=1;}
}
fn u32 invalid(ref u8[] raw){var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,parsed(raw)).is_ok);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,0).is_ok);let imports=v::empty<catalog::Binding>();let table=coords(1,0);var usize work=0;let resolved=switch(bindings::build(ref input,ref owners,ref imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return 0;}};work=0;return switch(templates::build(resolved,ref input,ref mut work)){case .ok(_):{0}case .err(p):{p.code}};}
@test
fn void rejects_stale_duplicate_and_unauthenticated_templates(){let input=sources(false);let resolved=bound(ref input,0,false,false);var v::Vec<syntax::Parsed> altered=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut altered,parsed(raw(0))).is_ok && v::push<syntax::Parsed>(ref mut altered,parsed(b"module helper;pub fn U id<U>(U value){return other;}")).is_ok);var usize work=0;assert(switch(templates::build(resolved,ref altered,ref mut work)){case .ok(_):{false}case .err(p):{p.code==12 && p.module_index==1}});assert(invalid(b"module plain;struct Box<T>{T value;}")==4501);assert(invalid(b"module std::vec;pub resource Vec<T>{T value;cleanup{}}")==4501);assert(invalid(b"module plain;fn T same<T>(T x){return x;}fn T same<T>(T x){return x;}")==4501);assert(invalid(b"module plain;fn T same<T,T>(T x){return x;}")==4501);assert(invalid(b"module plain;fn T source_location<T>(T x){return x;}")==4501);assert(invalid(b"module plain;fn i32 first<i8>(i32 x){return x;}")==4501);assert(invalid(b"module plain;fn i32 first<f64>(i32 x){return x;}")==4501);assert(invalid(b"module plain;fn T _fy_generic_x<T>(T x){return x;}")==4501);assert(invalid(b"module plain;const i32 same=1;fn T same<T>(T x){return x;}")==4501);assert(invalid(b"module plain;fn T first<T>(T x){return x;}static_assert(true);")==0);
}
@test
fn void preserves_exact_fit_and_exhausted_collection_and_lookup(){var usize cost=0;let p=detached(0,false,ref mut cost);assert(cost>0 && cost<16777216);var usize work=16777216-cost;let exact=detached(0,false,ref mut work);assert(work==16777216 && templates::count(ref exact)==templates::count(ref p));let input=sources(false);let resolved=bound(ref input,0,false,false);work=16777216-cost+1;assert(switch(templates::build(resolved,ref input,ref mut work)){case .ok(_):{false}case .err(p):{p.code==10}});assert(work<=16777216);work=0;let expected=switch(templates::lookup(ref p,0,b"a0::id",3,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);0}};let lookup_cost=work;work=16777216-lookup_cost;assert(switch(templates::lookup(ref p,0,b"a0::id",3,ref mut work)){case .ok(value):{value==expected}case .err(_):{false}} && work==16777216);work=16777216-lookup_cost+1;assert(switch(templates::lookup(ref p,0,b"a0::id",3,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});
}
