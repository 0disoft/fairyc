module tests::module_project_artifact_admission;
import module_project_artifact_admission as admission;
import module_project_artifact_current as current;
import module_project_artifact_rebase as rebase;
import module_project_artifact_encode as encoder;
import module_program_artifact_encode as program_encoder;
import module_program_artifact_decode as program_decoder;
import module_program_artifact_wire as budget;
import module_identity_artifact_model as ids;
import module_unit_body_ir_model as ir;
import module_unit_body_ir_verify as proof;
import module_state_layout as state;
import generic_package_bindings as provenance;
import module_signatures as signatures;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import project_compiler_core as core;
import tests::module_project_artifact_current_fixture as fixture;
import candidate_artifact_wire as wire;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
fn syntax::Parsed parsed(ref u8[] text){let tokens=switch(scanner::collect(fixture::copied(text),false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};return switch(syntax::parse(tokens,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(b"module empty;")}};}
fn v::Vec<syntax::Parsed> small(u32 mode){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(if(mode==1){b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}fn i32 main(){return 43;}"}else if(mode==2){b"module main;@contract_uid(\"example.main\")state{cell u32 supply;}fn i32 main(){return 42;}"}else{b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}fn i32 main(){return 42;}"})).is_ok);return sources;}
fn v::Vec<usize> owners(){var v::Vec<usize> rows=v::empty<usize>();assert(v::push<usize>(ref mut rows,1).is_ok);return rows;}
fn coordinates::Coordinates table(){let names=fixture::copied(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref names)}).is_ok);return coordinates::assemble(names,rows);}
fn catalog::Catalog scoped(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports){return switch(catalog::build_scoped(sources,owners,imports)){case .ok(p):{p}case .err(_):{assert(false);scoped(sources,owners,imports)}};}
fn signatures::Program metadata(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports){return switch(signatures::build_catalog(sources,scoped(sources,owners,imports))){case .ok(p):{p}case .err(_):{assert(false);metadata(sources,owners,imports)}};}
@effects(console) fn wire::Payload packet(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize source_work=0;var usize link_work=0;let complete=switch(core::build_complete_sources(sources,owners,imports,table,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return packet(sources,owners,imports,table);}};var usize work=0;return switch(encoder::encode(core::checked_program(ref complete),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);packet(sources,owners,imports,table)}};}
@effects(console) fn current::Rebound bound(ref u8[] raw,ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize work=0;return switch(current::build_sources(fixture::restored(raw),sources,owners,imports,table,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);bound(raw,sources,owners,imports,table)}};}
@effects(console) fn ir::Program rebased(ref current::Rebound selected){var usize work=0;return switch(rebase::build(selected,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);rebased(selected)}};}
@effects(console) fn admission::Admitted accepted(ir::Program program,ref current::Rebound selected,ref v::Vec<syntax::Parsed> sources,ref catalog::Catalog scope,ref signatures::Program metadata,ref coordinates::Coordinates table,ref mut usize work){return switch(admission::build(program,selected,sources,scope,metadata,table,work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("admission ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);accepted(rebased(selected),selected,sources,scope,metadata,table,work)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(program_encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);encoded(p)}};}
@test @effects(console) fn void ordinary_ir_is_retained_byte_identically_after_all_same_owner_gates(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let selected=bound(wire::content(ref data),ref sources,ref owners,ref imports,ref table);let program=rebased(ref selected);let before=encoded(ref program);let scope=scoped(ref sources,ref owners,ref imports);let metadata=metadata(ref sources,ref owners,ref imports);var usize work=0;let p=accepted(program,ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work);let after=encoded(admission::program(ref p));let s=admission::stats(ref p);assert(bytes::equal(wire::content(ref before),wire::content(ref after)) && s.coverage.files==1 && s.coverage.frames==1 && s.states==1 && s.sdk_units==0 && s.sdk_bytes==0 && work>0);}
@test @effects(console) fn void valid_ir_with_changed_body_or_state_cannot_gain_source_authority(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let selected=bound(wire::content(ref data),ref sources,ref owners,ref imports,ref table);let scope=scoped(ref sources,ref owners,ref imports);let metadata=metadata(ref sources,ref owners,ref imports);var u32 mode=1;
    while(mode<=2){let changed=small(mode);let other=packet(ref changed,ref owners,ref imports,ref table);let alternative=bound(wire::content(ref other),ref changed,ref owners,ref imports,ref table);let program=rebased(ref alternative);var usize fresh=0;assert(proof::check_metered(ref program,ref mut fresh).code==0);var usize work=0;assert(switch(admission::build(program,ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==if(mode==1){2}else{3} && e.code==1001}} && work>0);mode+=1;}
}
@test @effects(console) fn void exact_exhausted_invalid_and_stale_admission_preserves_bounded_history(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let selected=bound(wire::content(ref data),ref sources,ref owners,ref imports,ref table);let scope=scoped(ref sources,ref owners,ref imports);let metadata=metadata(ref sources,ref owners,ref imports);var usize work=0;let normal=accepted(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work);let required=work;work=budget::work_limit()-required;let exact=accepted(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work);assert(work==budget::work_limit() && admission::stats(ref normal).coverage.frames==admission::stats(ref exact).coverage.frames);work=budget::work_limit()-required+1;assert(switch(admission::build(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.code==1002}});work=budget::work_limit()+1;assert(switch(admission::build(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==1 && e.code==1002}} && work==budget::work_limit()+1);let changed=small(1);work=0;assert(switch(admission::build(rebased(ref selected),ref selected,ref changed,ref scope,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==1 && e.code==1001}});}
@effects(filesystem,console) fn admission::Admitted detached(){let data=fixture::packet();let inputs=fixture::current(1);let sources=fixture::sources(ref inputs);let owners=fixture::owners(ref inputs);let imports=fixture::imports(ref inputs);let table=fixture::coordinate_table(ref inputs);let selected=bound(wire::content(ref data),sources,owners,imports,table);let scope=scoped(sources,owners,imports);let metadata=metadata(sources,owners,imports);var usize work=0;return accepted(rebased(ref selected),ref selected,sources,ref scope,ref metadata,table,ref mut work);}
@test @effects(filesystem,console) fn void reordered_generic_vec_state_owner_detaches_all_checked_facts(){let p=detached();let s=admission::stats(ref p);assert(s.coverage.files==10 && s.coverage.frames>100 && s.coverage.layouts>0 && s.coverage.cleanup_fields>0 && s.states==1 && s.sdk_units>0 && s.sdk_bytes>0);assert(provenance::count(admission::source_provenance(ref p))==10 && ids::names(admission::source_identities(ref p)).len>67 && ids::frame_count(admission::source_identities(ref p))==s.coverage.frames);var usize work=0;assert(proof::check_metered(admission::program(ref p),ref mut work).code==0 && work>0);assert(ir::count(admission::program(ref p))==s.coverage.frames && state::count(ir::state_layouts(admission::program(ref p)))==1 && ir::work(admission::program(ref p))==0);}
