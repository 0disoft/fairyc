module tests::module_unit_c_import_budget;
import module_unit_generics as generics;
import module_unit_interfaces as interfaces;
import module_unit_call_closure as closure;
import module_unit_bind as binding;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
fn syntax::Parsed parsed(ref u8[] text){let b=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
resource Sources {bytes::Buffer root;v::Vec<bytes::Buffer> providers;cleanup{}}
fn void text(ref mut bytes::Buffer out,ref u8[] value){assert(bytes::append(out,value).is_ok);}
fn void number(ref mut bytes::Buffer out,usize value){assert(bytes::append_usize(out,value).is_ok);}
fn Sources ordinary_sources(usize count){var bytes::Buffer root=bytes::empty();var v::Vec<bytes::Buffer> providers=v::empty<bytes::Buffer>();text(ref mut root,b"module main;");var usize part=0;while(part<(count+99)/100){text(ref mut root,b"import provider");number(ref mut root,part);text(ref mut root,b" as p");number(ref mut root,part);text(ref mut root,b";");part+=1;}text(ref mut root,b"fn i32 main(){var i32 n=0;");part=0;var usize i=0;while(i<count){var bytes::Buffer provider=bytes::empty();text(ref mut provider,b"module provider");number(ref mut provider,part);text(ref mut provider,b";");let end=if(count-i<100){count}else{i+100};while(i<end){text(ref mut provider,b"pub fn i32 f");number(ref mut provider,i);text(ref mut provider,b"(){return ");number(ref mut provider,i);text(ref mut provider,b";}");text(ref mut root,b"n+=p");number(ref mut root,part);text(ref mut root,b"::f");number(ref mut root,i);text(ref mut root,b"();");i+=1;}assert(v::push<bytes::Buffer>(ref mut providers,provider).is_ok);part+=1;}text(ref mut root,b"assert(n==");number(ref mut root,count*(count-1)/2);text(ref mut root,b");return 0;}");return Sources{.root,.providers};}
fn Sources generic_sources(usize count){var bytes::Buffer root=bytes::empty();var bytes::Buffer provider=bytes::empty();text(ref mut root,b"module main;import provider as p;fn i32 main(){");text(ref mut provider,b"module provider;");var usize i=0;while(i<(count+5)/6){text(ref mut provider,b"pub fn i32 g");number(ref mut provider,i);text(ref mut provider,b"<T>(){return 0;}");i+=1;}i=0;while(i<count){text(ref mut root,b"discard p::g");number(ref mut root,i/6);text(ref mut root,b"<");text(ref mut root,if(i%6==0){b"i32"}else if(i%6==1){b"i64"}else if(i%6==2){b"u8"}else if(i%6==3){b"u32"}else if(i%6==4){b"usize"}else{b"bool"});text(ref mut root,b">();");i+=1;}text(ref mut root,b"return 0;}");var v::Vec<bytes::Buffer> providers=v::empty<bytes::Buffer>();assert(v::push<bytes::Buffer>(ref mut providers,provider).is_ok);return Sources{.root,.providers};}
struct Checked {u32 code;usize ordinary;usize generic;}
fn Checked checked(ref Sources input){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref input.root))).is_ok);var usize source=0;while(source<v::len<bytes::Buffer>(ref input.providers)){assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(v::at<bytes::Buffer>(ref input.providers,source)))).is_ok);source+=1;}let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(e):{return Checked{.code=e.code,.ordinary=0,.generic=0};}};let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(p):{p}case .err(e):{return Checked{.code=e.code,.ordinary=0,.generic=0};}};let ready=switch(closure::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(e):{return Checked{.code=e.code,.ordinary=0,.generic=0};}};let plan=interfaces::specializations(closure::imported(ref ready));var Checked result=Checked{.code=0,.ordinary=0,.generic=0};var usize i=1;while(i<=generics::count(plan)){if(generics::at(plan,i).argument_count==0){result.ordinary+=1;}else{result.generic+=1;}i+=1;}return result;}
@test @effects(console) fn void import_body_budget_keeps_generic_and_total_limits(){assert(generics::instance_limit()==256);discard io::write("ordinary begin\n");let admitted=ordinary_sources(256);let result=checked(ref admitted);discard io::write_u32(result.code);discard io::write(" ordinary ");discard io::write_usize(result.ordinary);discard io::write(" generic ");discard io::write_usize(result.generic);discard io::write("\n");assert(result.code==0 && result.ordinary==256 && result.generic==0);let excess=ordinary_sources(257);let excess_result=checked(ref excess);discard io::write_u32(excess_result.code);discard io::write(" excess\n");assert(excess_result.code==4503);let generic=generic_sources(64);let g=checked(ref generic);discard io::write_u32(g.code);discard io::write(" generic ");discard io::write_usize(g.generic);discard io::write("\n");assert(g.code==0 && g.generic==64 && g.ordinary==0);let overflow=generic_sources(65);let overflow_result=checked(ref overflow);discard io::write_u32(overflow_result.code);discard io::write(" overflow\n");assert(overflow_result.code==4503);}
