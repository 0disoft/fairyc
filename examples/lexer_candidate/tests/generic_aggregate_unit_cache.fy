@effects(console) fn void failure(core::Problem e){discard io::write_stderr("unit cache ");discard io::write_stderr_u32(e.phase);discard io::write_stderr("/");discard io::write_stderr_u32(e.stage);discard io::write_stderr("/");discard io::write_stderr_u32(e.code);assert(false);}
fn bytes::Buffer argument(usize index){var u8[4096] raw=[0;4096];let n=switch(process::arg(index,ref mut raw)){case .ok(p):{p}case .err(_):{assert(false);0}};let ref u8[] view=ref raw;return switch(bytes::copy(view[..n])){case .ok(p):{p}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem,console) fn visibility::Resolved loaded(ref u8[] root){var source_set::Budget budget=source_set::Budget{.files=0,.bytes=0};var usize work=0;return switch(visibility::load(root,ref mut budget,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("unit cache load ");discard io::write_stderr_u32(visibility::load_phase(ref e));assert(false);loaded(root)}};}
@effects(filesystem,environment) fn environment::Environment current(){var usize work=0;return switch(environment::current(ref mut work)){case .ok(p):{p}case .err(_):{assert(false);current()}};}
@effects(filesystem) fn disk::Store store(ref u8[] path){return switch(disk::open(path,disk::Limits{.entries=16,.bytes=16777216,.record=8388608,.temporary_age=1})){case .ok(p):{p}case .err(_):{assert(false);store(path)}};}
@effects(console) fn core::Complete cold(ref input::Input source,ref module_public_type_text::Coordinates table,bool ordinary){var usize a=0;var usize b=0;return switch(if(ordinary){core::build_complete_sources(input::sources(source),input::owners(source),input::bindings(source),table,ref mut a,ref mut b)}else{core::build_complete_aggregate_sources(input::sources(source),input::owners(source),input::bindings(source),table,ref mut a,ref mut b)}){case .ok(p):{p}case .err(e):{failure(e);cold(source,table,ordinary)}};}
fn usize entry(ref core::Complete complete,ref input::Input source){let p=checked::ir_program(core::checked_program(complete));var usize i=1;var usize result=0;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);if(f.kind==3 && input::origin(source,f.module_index).owner==0){assert(result==0);result=i;}i+=1;}assert(result!=0);return result;}
fn c::Bundle unreachable(){assert(false);return unreachable();}
fn c::Bundle parts(core::Complete p,usize entry){return switch(complete_c::partition(p,entry,2)){case .ok(p):{p}case .err(_):{unreachable()}};}
fn void same_interfaces(ref core::Complete a,ref core::Complete b){let x=core::public_interfaces(a);let y=core::public_interfaces(b);assert(interfaces::count(x)==interfaces::count(y));let empty=state::empty();var usize i=0;while(i<interfaces::count(x)){let p=interfaces::at(x,i);let q=interfaces::at(y,i);assert(interfaces::owner(p)==interfaces::owner(q) && bytes::equal(interfaces::ordinary_hash(p),interfaces::ordinary_hash(q)) && bytes::equal(interfaces::source_hash(p),interfaces::source_hash(q)));var usize work=0;let px=switch(codec::encode(ref empty,interfaces::owner(p),interfaces::descriptor(p),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let qx=switch(codec::encode(ref empty,interfaces::owner(q),interfaces::descriptor(q),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref px),bytes::view(ref qx)));i+=1;}}
@effects(filesystem,clock,console) fn void compare_and_emit(core::Complete p,ref input::Input source,ref module_public_type_text::Coordinates table,bool ordinary,ref disk::Store store,ref environment::Environment env){let fresh=cold(source,table,ordinary);same_interfaces(ref p,ref fresh);var blocked=cache::empty();blocked.io=disk::work_limit();var usize a=0;var usize b=0;var reports=v::empty<diagnostics::Reports>();let reference=switch(if(ordinary){core::build_complete_mixed(store,env,source,table,ref mut reports,ref mut blocked,ref mut a,ref mut b)}else{core::build_complete_aggregate_mixed(store,env,source,table,ref mut blocked,ref mut a,ref mut b)}){case .ok(p):{p}case .err(e):{failure(e);return;}};assert(blocked.hits==0 && blocked.misses==3 && blocked.stored==0 && blocked.io==disk::work_limit());let at=entry(ref p,source);let expected_at=entry(ref reference,source);let output=parts(p,at);let expected=parts(reference,expected_at);assert(bytes::equal(c::project_header(ref output),c::project_header(ref expected)) && bytes::equal(c::project_literals(ref output),c::project_literals(ref expected)) && c::project_unit_count(ref output)==c::project_unit_count(ref expected));var usize i=0;while(i<c::project_unit_count(ref output)){assert(bytes::equal(c::project_source(ref output,i),c::project_source(ref expected,i)));i+=1;}assert(io::write("FYCPARTS1\n").is_ok);member(c::project_header(ref output));member(c::project_literals(ref output));assert(io::write_usize(c::project_unit_count(ref output)).is_ok && io::write("\n").is_ok);i=0;while(i<c::project_unit_count(ref output)){member(c::project_source(ref output,i));i+=1;}}
@effects(console) fn void member(ref u8[] raw){assert(io::write_usize(raw.len).is_ok && io::write("\n").is_ok && io::write_bytes(raw).is_ok);}
// Distinct key domains cannot publish or read the other unit family. The
// selected aggregate range also returns a decoded owner with no lowering work.
fn void key_controls(ref input::Input source,ref module_public_type_text::Coordinates table,ref environment::Environment env){var usize work=0;let plan=switch(planning::build_aggregate_sources(input::sources(source),input::owners(source),input::bindings(source),table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let prepared=switch(aggregates::build(plan,input::sources(source),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_aggregates(input::sources(source),prepared,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let original=aggregates::source_plan(signatures::aggregate_source(ref metadata));let saved=switch(units::build_partitioned(input::sources(source),ref metadata,original,1,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(units::count(ref saved)==3);let range=units::range_at(ref saved,0);var usize key_work=0;let key=switch(keys::collect_aggregates(source,original,env,range.first,range.stop,ref mut key_work)){case .ok(p):{p}case .err(_):{assert(false);return;}};key_work=0;let ordinary=switch(keys::collect(source,original,env,range.first,range.stop,ref mut key_work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(keys::aggregates(ref key) && !keys::aggregates(ref ordinary) && !bytes::equal(keys::canonical(ref key),keys::canonical(ref ordinary)) && !bytes::equal(keys::route(ref key),keys::route(ref ordinary)));var usize artifact=0;let encoded=switch(cache::encode(ref key,units::at(ref saved,0),ref mut artifact)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(payload::content(ref encoded)[..8],b"FYCACHE1"));artifact=0;assert(switch(cache::encode(ref ordinary,units::at(ref saved,0),ref mut artifact)){case .ok(_):{false}case .err(code):{code==1001}});let scope=switch(input::declarations(source)){case .ok(p):{p}case .err(_):{assert(false);return;}};artifact=0;var usize source_work=0;let admitted=switch(cache::restore(payload::content(ref encoded),ref key,input::sources(source),ref scope,ref metadata,original,range.first,range.stop,ref mut source_work,ref mut artifact)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(ir::work(unit::ir_program(ref admitted))==0 && source_work>0 && artifact>0);artifact=0;source_work=0;assert(!cache::restore(payload::content(ref encoded),ref ordinary,input::sources(source),ref scope,ref metadata,original,range.first,range.stop,ref mut source_work,ref mut artifact).is_ok);}
@effects(filesystem,environment,clock,console) pub fn i32 run(){let root=argument(1);let path=argument(2);let mode_bytes=argument(3);let mode=bytes::view(ref mode_bytes);let loaded=loaded(bytes::view(ref root));var usize projection=0;let table=switch(coordinates::collect(visibility::workspace_graph(ref loaded),ref mut projection)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};let source=switch(input::project(ref loaded,ref mut projection)){case .ok(p):{p}case .err(_):{assert(false);return 1;}};assert(input::count(ref source)==3);let store=store(bytes::view(ref path));let env=current();var work=cache::empty();var usize a=0;var usize b=0;
 if(bytes::equal(mode,b"invalid")){let expected=switch(core::build_complete_aggregate_sources(input::sources(ref source),input::owners(ref source),input::bindings(ref source),ref table,ref mut a,ref mut b)){case .ok(_):{assert(false);return 1;}case .err(e):{e}};a=0;b=0;let actual=switch(core::build_complete_aggregate_mixed(ref store,ref env,ref source,ref table,ref mut work,ref mut a,ref mut b)){case .ok(_):{assert(false);return 1;}case .err(e):{e}};assert(work.stored==0 && actual.phase==expected.phase && actual.stage==expected.stage && actual.code==expected.code && actual.module_index==expected.module_index && actual.start==expected.start && actual.end==expected.end);return 0;}
 let ordinary=bytes::equal(mode,b"ordinarycold") || bytes::equal(mode,b"ordinarywarm");var reports=v::empty<diagnostics::Reports>();if(bytes::equal(mode,b"exhausted")){work.io=disk::work_limit();}let result=switch(if(ordinary){core::build_complete_mixed(ref store,ref env,ref source,ref table,ref mut reports,ref mut work,ref mut a,ref mut b)}else{core::build_complete_aggregate_mixed(ref store,ref env,ref source,ref table,ref mut work,ref mut a,ref mut b)}){case .ok(p):{p}case .err(e):{failure(e);return 1;}};let usize expected=if(bytes::equal(mode,b"warm") || bytes::equal(mode,b"ordinarywarm")){3}else if(bytes::equal(mode,b"private") || bytes::equal(mode,b"repair")){2}else if(bytes::equal(mode,b"generic")){1}else{0};if(work.hits!=expected || work.misses!=3-expected){discard io::write_stderr("units hit/miss ");discard io::write_stderr_usize(work.hits);discard io::write_stderr("/");discard io::write_stderr_usize(work.misses);}assert(work.hits==expected && work.misses==3-expected && work.stored==if(bytes::equal(mode,b"exhausted")){0}else{3-expected});if(bytes::equal(mode,b"cold")){key_controls(ref source,ref table,ref env);}compare_and_emit(result,ref source,ref table,ordinary,ref store,ref env);return 0;}
