module tests::module_unit_c_text;
import module_unit_c_emit as emit;
import module_unit_body_ir_model as ir;
import module_unit_body_ir_lower as lower;
import module_unit_body_ir_verify as proof;
import module_unit_cleanup_mir_model as clean;
import module_unit_value_model as m;
import module_unit_region_model as regions;
import module_unit_values as values;
import module_unit_moves as moves;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import scanner as scanner;
import syntax as syntax;
import file_source as files;
import std::bytes as bytes;
import std::vec as v;
import std::process as process;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let b=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(filesystem) fn bytes::Buffer input(usize index){var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let n=switch(process::arg(index,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};return switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);bytes::empty()}};}
@effects(console) fn void error(u32 code,usize start,usize end){discard io::write_u32(code);discard io::write(" at ");discard io::write_usize(start);discard io::write("..");discard io::write_usize(end);discard io::write("\n");assert(false);}
@effects(console,filesystem) fn ir::Program retained(ref u8[] root){let text=input(1);let buffer=input(2);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref text))).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref buffer))).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let ready=switch(closure::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let typed=switch(values::build(ref sources,ref metadata,ref ready)){case .ok(p):{p}case .err(e):{discard io::write("values ");error(e.code,e.start,e.end);return retained(root);}};
    let moved=switch(moves::build(ref sources,ref typed,values::work(ref typed))){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    return switch(lower::lower(ref sources,ref typed,closure::imported(ref ready),ref moved)){case .ok(p):{p}case .err(e):{discard io::write("lower ");error(e.code,e.start,e.end);retained(root)}};
}
fn usize entry(ref ir::Program p){var usize found=0;var usize i=1;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);let result=clean::type_at(ir::cleanup_ir(p),f.result);if(f.module_index==0 && f.kind==3 && result.kind==1 && result.scalar==1){let b=ir::at(p,i);var usize j=1;var bool parameter=false;while(j<=ir::local_count(b)){if(ir::local_at(b,j).kind==1){parameter=true;}j+=1;}if(!parameter){assert(found==0);found=i;}}i+=1;}assert(found!=0);return found;}
@effects(console) fn void output(ref ir::Program p){var bytes::Buffer c=bytes::empty();let result=emit::render(p,entry(p),ref mut c);if(result.code!=0){discard io::write("C ");error(result.code,result.start,result.end);}assert(io::write_bytes(bytes::view(ref c)).is_ok);}
@test @effects(console,filesystem) fn void sdk_c_executes_string_utf8_views_append_and_empty(){let p=retained(b"module main;import std::text as t;fn i32 main(){var t::String value=switch(t::copy(\"A\\0λ\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(t::string_len(ref value)==4 && !t::string_is_empty(ref value));assert(t::append(ref mut value,\"Z\").is_ok);let ref u8[] data=t::as_bytes(t::string_as_str(ref value));assert(data.len==5 && data[0]==65 && data[1]==0 && data[2]==206 && data[3]==187 && data[4]==90);let Result<ref str,t::TextError> valid=t::validate_utf8(b\"A\\0λZ\");switch(valid){case .ok(text):{assert(text.len==5);}case .err(_):{assert(false);}};switch(t::validate_utf8(b\"\\xff\")){case .ok(_):{assert(false);}case .err(error):{assert(t::error_status(error)==2 && t::error_allocation_status(error)==0);}};let t::String empty=switch(t::copy(\"\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(t::string_is_empty(ref empty) && t::as_bytes(t::string_as_str(ref empty)).len==0);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_string_initial_allocation_failure(){let p=retained(b"module main;import std::text as t;fn i32 main(){switch(t::copy(\"λZ\")){case .ok(_):{assert(false);}case .err(error):{assert(t::error_status(error)==1 && t::error_allocation_status(error)==1);}};return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_string_append_failure_preserves_owner(){let p=retained(b"module main;import std::text as t;fn i32 main(){var t::String value=switch(t::copy(\"A\\0λ\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};switch(t::append(ref mut value,\"0123456789012345678901234567890123\")){case .ok(_):{assert(false);}case .err(error):{assert(t::error_status(error)==1 && t::error_allocation_status(error)==1);}};assert(t::string_len(ref value)==4);let ref u8[] data=t::as_bytes(t::string_as_str(ref value));assert(data.len==4 && data[0]==65 && data[1]==0 && data[2]==206 && data[3]==187);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_string_buffer_transfers_without_copy(){let p=retained(b"module main;import std::text as t;import std::bytes as b;fn i32 main(){let b::Buffer buffer=switch(b::copy(b\"A\\0λZ\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};let ptr u8 address=unsafe{b::view(ref buffer) as ptr u8};let t::String text=switch(t::from_buffer(buffer)){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(t::string_len(ref text)==5 && unsafe{t::as_bytes(t::string_as_str(ref text)) as ptr u8}==address);let b::Buffer again=t::into_buffer(text);assert(b::len(ref again)==5 && unsafe{b::view(ref again) as ptr u8}==address);let b::Buffer invalid=switch(b::copy(b\"\\xff\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};let ptr u8 invalid_address=unsafe{b::view(ref invalid) as ptr u8};switch(t::from_buffer(invalid)){case .ok(_):{assert(false);}case .err(donor):{let ref u8[] data=b::view(ref donor);assert(data.len==1 && data[0]==255 && unsafe{data as ptr u8}==invalid_address);}};return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_cstring_termination_and_interior_nul(){let p=retained(b"module main;import std::text as t;@link_name(\"test_cstring_probe\")unsafe extern C fn i32 probe(ptr u8 data,usize length);fn i32 main(){let t::CString value=switch(t::cstring_from_text(\"λZ\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(t::cstring_len(ref value)==3 && !t::cstring_is_empty(ref value));let ref CStr view=t::cstring_as_cstr(ref value);assert(unsafe{probe(view as ptr u8,3)}==1);switch(t::cstring_from_text(\"A\\0Z\")){case .ok(_):{assert(false);}case .err(error):{assert(t::error_status(error)==3 && t::error_allocation_status(error)==0);}};let t::CString empty=switch(t::cstring_from_text(\"\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(t::cstring_len(ref empty)==0 && t::cstring_is_empty(ref empty));let ref CStr empty_view=t::cstring_as_cstr(ref empty);assert(unsafe{probe(empty_view as ptr u8,0)}==1);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_cstring_initial_allocation_failure(){let p=retained(b"module main;import std::text as t;fn i32 main(){switch(t::cstring_from_text(\"λZ\")){case .ok(_):{assert(false);}case .err(error):{assert(t::error_status(error)==1 && t::error_allocation_status(error)==1);}};return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_rejects_forged_cstring_view_authority(){let p=retained(b"module main;import std::text as t;fn i32 main(){let t::CString value=switch(t::cstring_from_text(\"Z\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};discard t::cstring_as_cstr(ref value);return 0;}");var usize found=0;var usize frame=1;while(frame<=ir::count(ref p)){let b=ir::at(ref p,frame);var usize i=0;while(i<ir::node_count(b)){let e=ir::node_at(b,i).value;if(e.kind==6 && e.builtin.kind==12){found=frame;}i+=1;}frame+=1;}assert(found!=0);let b=ir::at(ref p,found);var usize work=0;assert(proof::check_raw_parts(ref p,b,found,ref mut work).code==0);var usize mode=0;while(mode<3){var v::Vec<ir::Node> nodes=v::empty<ir::Node>();var usize i=0;while(i<ir::node_count(b)){var n=ir::node_at(b,i);if(n.value.kind==6 && n.value.builtin.kind==12){if(mode==0){n.value.builtin.unsafe_context=false;}if(mode==1){n.value.builtin.kind=11;}if(mode==2){n.value.place.root=0;}}assert(v::push<ir::Node>(ref mut nodes,n).is_ok);i+=1;}let text=switch(bytes::copy(ir::text_view(b))){case .ok(t):{t}case .err(_):{assert(false);return;}};let changed=ir::assemble_body(ir::body(b),ir::source_bytes(b),ir::start(b),ir::end(b),nodes,v::empty<ir::Statement>(),v::empty<m::Local>(),v::empty<m::Invocation>(),v::empty<m::Argument>(),v::empty<regions::Scope>(),v::empty<regions::Exit>(),text);work=0;assert(proof::check_raw_parts(ref p,ref changed,found,ref mut work).code==1001);mode+=1;}work=1048576;assert(proof::check_raw_parts(ref p,b,found,ref mut work).code==1002);}
