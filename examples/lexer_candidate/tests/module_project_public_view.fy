fn syntax::Parsed parsed(ref u8[] raw){let owned=switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);bytes::empty()}};let scanned=switch(scanner::collect(owned,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"");}};return switch(syntax::parse(scanned,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(b"")}};}
fn v::Vec<syntax::Parsed> source_set(bool changed){var v::Vec<syntax::Parsed> out=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut out,parsed(if(changed){b"module root;import helper as h;fn i32 main(){return h::id<i32>(42);}fn i32 ordinary(){return 2;}pub struct Packet{h::Leaf inner;i32[2] array;}pub enum Choice{Empty;Pair{h::Leaf item;};}pub resource Token{i32 hidden;cleanup{discard this.hidden;}}@must_use pub fn i32 read(ref Packet packet,Option<ref h::Leaf> optional){return 7;}@link_name(\"public_fixture_host\")pub unsafe extern C fn c::int host(c::uint code);"}else{b"module root;import helper as h;fn i32 main(){return h::id<i32>(42);}fn i32 ordinary(){return 1;}pub struct Packet{h::Leaf inner;i32[2] array;}pub enum Choice{Empty;Pair{h::Leaf item;};}pub resource Token{i32 hidden;cleanup{discard this.hidden;}}@must_use pub fn i32 read(ref Packet packet,Option<ref h::Leaf> optional){return 7;}@link_name(\"public_fixture_host\")pub unsafe extern C fn c::int host(c::uint code);"})).is_ok);assert(v::push<syntax::Parsed>(ref mut out,parsed(b"module helper;pub struct Leaf{i32 value;}pub fn T id<T>(T n){return n;}")).is_ok && v::push<syntax::Parsed>(ref mut out,parsed(b"module helper;pub struct Leaf{i32 value;}pub fn T id<T>(T n){return n;}")).is_ok);return out;}
fn v::Vec<usize> owners(bool changed){var v::Vec<usize> out=v::empty<usize>();assert(v::push<usize>(ref mut out,0).is_ok && v::push<usize>(ref mut out,if(changed){2}else{1}).is_ok && v::push<usize>(ref mut out,if(changed){1}else{2}).is_ok);return out;}
fn v::Vec<catalog::Binding> imports(bool changed){var v::Vec<catalog::Binding> out=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut out,catalog::Binding{.source=0,.declaration=2,.target=if(changed){2}else{1}}).is_ok);return out;}
fn coordinates::Coordinates coordinate_table(bool changed,bool reverse){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<3){let owner=if(reverse){2-i}else{i};let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize j=0;while(j<64){assert(bytes::append_byte(ref mut names,if(changed && owner==1){52}else{if(owner==0){49}else if(owner==1){50}else{51}}).is_ok);j+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
@effects(console)
fn signatures::Program make_metadata(ref v::Vec<syntax::Parsed> sources,bool owner_change,bool provider_change){let owners=owners(owner_change);let imports=imports(provider_change);let catalog=switch(catalog::build_scoped(sources,ref owners,ref imports)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return make_metadata(sources,owner_change,provider_change);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);make_metadata(sources,owner_change,provider_change)}};}
@effects(console)
fn plan::Plan planned(ref v::Vec<syntax::Parsed> sources){let owners=owners(false);let imports=imports(false);let coordinates=coordinate_table(false,false);var context::Budget work=context::empty();let bound=switch(bindings::build(sources,ref owners,ref imports,ref coordinates,ref mut work.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return planned(sources);}};let catalog=switch(templates::build(bound,sources,ref mut work.work)){case .ok(p):{p}case .err(_):{assert(false);return planned(sources);}};let roots=switch(requests::build(catalog,sources,ref mut work.work)){case .ok(p):{p}case .err(_):{assert(false);return planned(sources);}};let input=switch(prepared::build(roots,sources,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return planned(sources);}};return switch(plan::build(input,plan::defaults(),ref mut work.work)){case .ok(p):{p}case .err(_):{assert(false);planned(sources)}};}
@effects(console)
fn project::Plan compile_units(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let original=planned(sources);var usize work=0;return switch(project::build(sources,metadata,ref original,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr_u32(e.code);assert(false);compile_units(sources,metadata)}};}
@effects(console)
fn linked::Program detached(){let sources=source_set(false);let metadata=make_metadata(ref sources,false,false);let units=compile_units(ref sources,ref metadata);var usize work=0;return switch(linked::build(ref metadata,ref units,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);detached()}};}
fn syntax::Parsed vec_parsed(bytes::Buffer raw){let scanned=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return vec_parsed(bytes::empty());}};return switch(syntax::parse(scanned,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);vec_parsed(bytes::empty())}};}
fn syntax::Parsed vec_text(ref u8[] raw){return vec_parsed(switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);bytes::empty()}});}
fn syntax::Parsed vec_provider(ref u8[] name,bool invalid){var bytes::Buffer raw=bytes::empty();assert(bytes::append(ref mut raw,b"module ").is_ok && bytes::append(ref mut raw,name).is_ok && bytes::append(ref mut raw,b";import helper as shared;import std::vec as vec;").is_ok);var u8 i=0;
    while(i<8){let u8[1] letter=[97+i];assert(bytes::append(ref mut raw,b"fn T ").is_ok && bytes::append(ref mut raw,ref letter[..]).is_ok && bytes::append(ref mut raw,b"<T>(T n){return n;}").is_ok);i+=1;}
    assert(bytes::append(ref mut raw,b"pub fn i32 run(){let vec::Vec<i32> items=vec::empty<i32>();discard items;").is_ok);i=0;
    while(i<8){let u8[1] letter=[97+i];var usize type=0;while(type<5){assert(bytes::append(ref mut raw,b"discard ").is_ok && bytes::append(ref mut raw,ref letter[..]).is_ok);let call=if(type==0){b"<bool>(false);"}else if(type==1){b"<u8>(1);"}else if(type==2){b"<u32>(1);"}else if(type==3){b"<i32>(1);"}else{b"<usize>(1);"};assert(bytes::append(ref mut raw,call).is_ok);type+=1;}i+=1;}
    assert(bytes::append(ref mut raw,if(invalid){b"discard shared::id<i32>(1);return true;}"}else{b"return shared::id<i32>(21);}"}).is_ok);return vec_parsed(raw);
}
@effects(console)
fn plan::Plan vec_planned(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){var bytes::Buffer text=bytes::empty();assert(bytes::append(ref mut text,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut text,49).is_ok);i+=1;}var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=0,.start=0,.end=bytes::len(ref text)}).is_ok);let coordinates=coordinates::assemble(text,rows);
    var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,0).is_ok);let source=v::at<syntax::Parsed>(sources,i);var usize j=1;while(j<syntax::declaration_count(source)){let d=syntax::declaration_at(source,j);if(d.kind==2){var usize measured=0;let target=signatures::import_target_measured(metadata,i,syntax::source_view(source)[d.name_start..d.name_end],ref mut measured);assert(target.code==0 && target.item>0);assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+1,.target=target.item-1}).is_ok);}j+=1;}i+=1;}
    var context::Budget work=context::empty();let bound=switch(bindings::build(sources,ref owners,ref imports,ref coordinates,ref mut work.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return vec_planned(sources,metadata);}};
    let catalog=switch(templates::build(bound,sources,ref mut work.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return vec_planned(sources,metadata);}};
    let roots=switch(requests::build(catalog,sources,ref mut work.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return vec_planned(sources,metadata);}};
    let input=switch(prepared::build(roots,sources,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.source.code);assert(false);return vec_planned(sources,metadata);}};
    return switch(plan::build(input,plan::defaults(),ref mut work.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);vec_planned(sources,metadata)}};
}

@effects(filesystem,console)
fn bytes::Buffer vec_fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(n):{n}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(utf8::validate_utf8(view[..size])){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(p):{p}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer data=bytes::empty();assert(bytes::resize_zeroed(ref mut data,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut data)[used..])){case .ok(n):{n}case .err(_):{assert(false);return data;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut data,used).is_ok);return data;}
@effects(filesystem,console)
fn v::Vec<syntax::Parsed> vec_source_set(){let sdk=vec_fixture();var v::Vec<syntax::Parsed> out=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut out,vec_text(b"module root;import left as a;import right as b;fn i32 main(){return a::run()+b::run();}")).is_ok && v::push<syntax::Parsed>(ref mut out,vec_provider(b"left",false)).is_ok && v::push<syntax::Parsed>(ref mut out,vec_provider(b"right",false)).is_ok && v::push<syntax::Parsed>(ref mut out,vec_text(b"module helper;pub fn T id<T>(T n){return n;}")).is_ok && v::push<syntax::Parsed>(ref mut out,vec_text(bytes::view(ref sdk))).is_ok);return out;}
@effects(filesystem,console)
fn linked::Program vec_compiled(){let sources=vec_source_set();let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return vec_compiled();}};let original=vec_planned(ref sources,ref metadata);var usize work=0;let units=switch(project::build(ref sources,ref metadata,ref original,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_bytes(b"compile=");discard io::write_stderr_u32(e.stage);discard io::write_stderr_u32(e.code);assert(false);return vec_compiled();}};assert(project::count(ref units)>1);var usize repeated=0;var usize unit=0;while(unit<project::count(ref units)){let owner=project::at(ref units,unit);let ir=identified::ir_program(owner);var usize i=1;while(i<=ir::count(ir)){let f=clean::frame_at(ir::cleanup_ir(ir),i);if(f.kind==2){let t=clean::type_at(ir::cleanup_ir(ir),f.receiver_type);if(t.kind==13 && clean::type_at(ir::cleanup_ir(ir),t.first).scalar==1){repeated+=1;}}i+=1;}unit+=1;}assert(repeated>1);work=0;return switch(linked::build(ref metadata,ref units,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_bytes(b"link=");discard io::write_stderr_u32(e.code);assert(false);vec_compiled()}};}

