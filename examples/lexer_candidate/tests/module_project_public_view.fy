fn void split_sdk_vec_names_retain_linked_identities_after_all_owners_close(){let view=detached_vec_view();var usize vectors=0;var usize i=1;while(i<=public::type_count(ref view)){let t=public::type_at(ref view,i);assert(ids::same(t,ids::at(public::type_names(ref view),i).type));if(t.kind==13){assert(ids::valid(ids::name(public::type_names(ref view),i)));vectors+=1;}else{assert(ids::name(public::type_names(ref view),i).len==0);}i+=1;}assert(vectors>0 && public::callable_count(ref view)>3 && public::shape_count(ref view)>0);}
