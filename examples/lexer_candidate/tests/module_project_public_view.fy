fn public::View detached_vec_view(){let p=vec_compiled();let sources=vec_source_set();let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return detached_vec_view();}};let table=vec_coordinates();let view=projected(ref p,ref sources,ref metadata,ref table);var usize i=1;var usize vectors=0;while(i<=public::type_count(ref view)){let t=public::type_at(ref view,i);if(t.kind==13){let id=linked::identity(ref p,linked::type_at(ref p,i));let name=ids::name(public::type_names(ref view),i);let prefix=b"std::vec::_fy_generic_";assert(name.len==prefix.len+id.len && bytes::equal(name[..prefix.len],prefix) && bytes::equal(name[prefix.len..],id));assert(switch(ids::owner(public::type_names(ref view),i,t)){case .ok(n):{n==0}case .err(_):{false}});vectors+=1;}i+=1;}assert(vectors>0);return view;}
