@test @effects(console)
fn void public_rows_preserve_linked_types_payloads_callables_and_detached_ownership(){let p=detached();let sources=source_set(false);let metadata=make_metadata(ref sources,false,false);let table=coordinate_table(false,false);let view=projected(ref p,ref sources,ref metadata,ref table);let program=linked::ir_program(ref p);
 assert(public::type_count(ref view)==clean::type_count(ir::cleanup_ir(program)) && public::shape_count(ref view)==ir::layout_count(program) && public::field_count(ref view)==ir::field_count(program) && public::callable_count(ref view)>=ir::callable_count(program) && public::parameter_count(ref view)>=ir::parameter_count(program));var usize i=1;
 while(i<=public::type_count(ref view)){assert(ids::same(public::type_at(ref view,i),clean::type_at(ir::cleanup_ir(program),i)));i+=1;}i=0;var usize payloads=0;var usize resources=0;
 while(i<public::shape_count(ref view)){let a=public::shape_at(ref view,i);let b=ir::layout_at(program,i).value;assert(a.type==b.type && a.module_index==b.module_index && a.declaration==b.declaration && a.field_start==b.field_start && a.field_count==b.field_count && a.abilities==b.abilities && a.cleanup_effects==b.cleanup_effects && a.repr_c==b.repr_c && a.start==b.start && a.end==b.end);if(public::type_at(ref view,a.type).kind==3){resources+=1;}i+=1;}
 i=0;while(i<public::field_count(ref view)){let a=public::field_at(ref view,i);let b=ir::field_at(program,i);assert(a.kind==b.kind && a.type==b.type && a.module_index==b.module_index && a.declaration==b.declaration && a.source_index==b.source_index && a.start==b.start && a.end==b.end && a.payload_start==b.payload_start && a.payload_count==b.payload_count && bytes::equal(public::field_name(ref view,i),ir::field_name(program,i)));payloads+=a.payload_count;i+=1;}assert(payloads>0 && resources==1);
 i=0;var usize foreign=0;while(i<ir::callable_count(program)){let a=public::callable_at(ref view,i);let b=ir::callable_at(program,i);assert(a.module_index==b.module_index && a.declaration==b.declaration && a.template==b.template && a.result==b.result && a.parameter_start==b.parameter_start && a.parameter_count==b.parameter_count && a.effects==b.effects && a.must_use==b.must_use && a.unsafe_call==b.unsafe_call && a.foreign==b.foreign && bytes::equal(public::linker_name(ref view,i),ir::linker_name(program,i)));if(a.foreign){foreign+=1;}i+=1;}assert(foreign==0 && public::callable_count(ref view)>ir::callable_count(program));let unused=public::callable_at(ref view,public::callable_count(ref view)-1);assert(unused.foreign && unused.unsafe_call && !unused.template && bytes::equal(public::linker_name(ref view,public::callable_count(ref view)-1),b"public_fixture_host"));assert(public::type_at(ref view,unused.result).scalar==132 && public::type_at(ref view,public::parameter_at(ref view,unused.parameter_start)).scalar==140);
 i=0;while(i<ir::parameter_count(program)){assert(public::parameter_at(ref view,i)==ir::parameter_at(program,i));i+=1;}
 let detached=detached_view();var usize work=0;assert(public::current(ref detached,ref sources,ref metadata,ref table,ref mut work)==0 && public::field_count(ref detached)==public::field_count(ref view));i=0;while(i<public::field_count(ref detached)){assert(bytes::equal(public::field_name(ref detached,i),public::field_name(ref view,i)));i+=1;}
}
@test @effects(console)
fn void stale_sources_namespaces_imports_and_exact_budget_reject_before_publication(){let p=detached();let sources=source_set(false);let metadata=make_metadata(ref sources,false,false);let table=coordinate_table(false,false);var usize cost=0;let view=switch(public::build(ref p,ref sources,ref metadata,ref table,ref mut cost)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(cost>0 && cost<16777216);var usize work=16777216-cost;assert(switch(public::build(ref p,ref sources,ref metadata,ref table,ref mut work)){case .ok(_):{true}case .err(_):{false}} && work==16777216);work=16777217-cost;assert(switch(public::build(ref p,ref sources,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e==10}});work=16777217;assert(switch(public::build(ref p,ref sources,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e==10}} && work==16777217);
 let changed=source_set(true);let changed_metadata=make_metadata(ref changed,false,false);work=0;assert(switch(public::build(ref p,ref changed,ref changed_metadata,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e==12}});work=0;assert(public::current(ref view,ref changed,ref changed_metadata,ref table,ref mut work)==12);
 let wrong=coordinate_table(true,false);work=0;assert(switch(public::build(ref p,ref sources,ref metadata,ref wrong,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});let rebound=make_metadata(ref sources,false,true);work=0;assert(switch(public::build(ref p,ref sources,ref rebound,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});let moved=make_metadata(ref sources,true,false);work=0;assert(switch(public::build(ref p,ref sources,ref moved,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});
}
