pub resource Sources{v::Vec<syntax::Parsed> sources;v::Vec<usize> owners;v::Vec<catalog::Binding> imports;cleanup{}}
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn coordinates::Coordinates table(usize shift,bool changed,bool missing){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize digit=1;while(digit<=3 && !missing){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut names,if(changed && digit==1){52}else if(digit==1){49}else if(digit==2){50}else{51}).is_ok);i+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);digit+=1;}return coordinates::assemble(names,rows);}

fn Sources owned(v::Vec<syntax::Parsed> sources,v::Vec<usize> owners,v::Vec<catalog::Binding> imports){return Sources{.sources,.owners,.imports};}
fn Sources simple(ref u8[] raw){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok && v::push<usize>(ref mut owners,1).is_ok);return owned(sources,owners,v::empty<catalog::Binding>());}
@effects(console)
fn void failed(core::Problem p){discard io::write_stderr("phase ");discard io::write_stderr_u32(p.phase);discard io::write_stderr(" stage ");discard io::write_stderr_u32(p.stage);discard io::write_stderr(" code ");discard io::write_stderr_u32(p.code);discard io::write_stderr(" module ");discard io::write_stderr_usize(p.module_index);discard io::write_stderr(" span ");discard io::write_stderr_usize(p.start);discard io::write_stderr("..");discard io::write_stderr_usize(p.end);}
@effects(console)
fn core::Complete complete(ref Sources source,ref coordinates::Coordinates table,ref mut usize source_work,ref mut usize link_work){return switch(core::build_complete_sources(ref source.sources,ref source.owners,ref source.imports,table,source_work,link_work)){case .ok(p):{p}case .err(e):{failed(e);assert(false);return complete(source,table,source_work,link_work);}};}
@effects(console)
fn core::Complete detached(v::Vec<syntax::Parsed> sources,v::Vec<usize> owners,v::Vec<catalog::Binding> imports,usize shift){let source=owned(sources,owners,imports);let coords=table(shift,false,false);var usize work=0;var usize linking=0;return complete(ref source,ref coords,ref mut work,ref mut linking);}
@test @effects(filesystem,console)
fn void complete_checked_projects_match_go_descriptors_templates_and_both_hashes(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPDES1"));var usize cursor=8;assert(number(wire,ref mut cursor)==6);var usize case_index=0;var usize compared=0;var usize compared_bytes=0;var usize compared_templates=0;
 while(case_index<6){let label=field(wire,ref mut cursor);let count=number(wire,ref mut cursor);let usize shift=if(case_index==2){19}else{0};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;
  while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut cursor)+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut cursor))).is_ok);let n=number(wire,ref mut cursor);var usize j=0;while(j<n){let alias=field(wire,ref mut cursor);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut cursor)}).is_ok);j+=1;}i+=1;}
  let result=detached(sources,owners,imports,shift);assert(proof::check(checked::ir_program(core::checked_program(ref result))).code==0);let packages=core::public_interfaces(ref result);assert(interfaces::count(packages)==3 && number(wire,ref mut cursor)==3);var usize package=0;
  while(package<3){let owner=number(wire,ref mut cursor)+shift;let expected_templates=number(wire,ref mut cursor);let record=interfaces::at(packages,package);assert(interfaces::owner(record)==owner);let templates=interfaces::templates(record);assert(generic::count(templates)==expected_templates);i=0;
   while(i<expected_templates){let row=generic::at(templates,i);assert(bytes::equal(generic::text(templates,row.module_path),field(wire,ref mut cursor)) && bytes::equal(generic::text(templates,row.name),field(wire,ref mut cursor)) && bytes::equal(generic::text(templates,row.closure),field(wire,ref mut cursor)));i+=1;}
   assert(bytes::equal(interfaces::ordinary_hash(record),field(wire,ref mut cursor)));let source_hash=field(wire,ref mut cursor);if(!bytes::equal(interfaces::source_hash(record),source_hash)){discard io::write_stderr_bytes(label);discard io::write_stderr_usize(owner);assert(false);}let expected=field(wire,ref mut cursor);let state=layouts::empty();var usize work=0;let encoded=switch(ordinary::encode(ref state,owner,interfaces::descriptor(record),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref encoded),expected));compared+=1;compared_bytes+=expected.len;compared_templates+=expected_templates;package+=1;}
  case_index+=1;
 }assert(cursor==wire.len && compared==18 && compared_bytes==15788 && compared_templates==113);
}
@test @effects(console)
fn void exact_source_and_link_budgets_gate_atomic_complete_publication(){let source=simple(b"module main;pub fn T identity<T>(T x){return x;}pub fn i32 main(){return identity<i32>(42);}");let coords=table(0,false,false);var usize required=0;var usize link_required=0;let result=complete(ref source,ref coords,ref mut required,ref mut link_required);assert(required>0 && required<16777216 && link_required>0 && link_required<8388608);var usize work=16777216-required;var usize linking=8388608-link_required;let exact=complete(ref source,ref coords,ref mut work,ref mut linking);assert(work==16777216 && linking==8388608 && bytes::equal(interfaces::source_hash(interfaces::at(core::public_interfaces(ref result),0)),interfaces::source_hash(interfaces::at(core::public_interfaces(ref exact),0))));work=16777217-required;linking=0;assert(switch(core::build_complete_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut work,ref mut linking)){case .ok(_):{false}case .err(e):{e.phase==6 && e.code==10}});work=0;linking=8388609-link_required;assert(switch(core::build_complete_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut work,ref mut linking)){case .ok(_):{false}case .err(e):{e.phase==4 && e.code==1002}});work=16777217;linking=0;assert(switch(core::build_complete_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut work,ref mut linking)){case .ok(_):{false}case .err(e):{e.phase==5 && e.code==10}} && work==16777217);}
fn ref u8[] invalid(usize index){if(index==0){return b"module broken;pub fn i32 bad(){return true;}";}if(index==1){return b"module broken;resource R{i32 x;cleanup{}}pub fn i32 bad(){let R r=R{.x=1};let R s=r;return r.x;}";}return b"module broken;pub fn i32 bad(){var i32 x=1;let ref i32 r=ref x;x=2;return *r;}";}
@test @effects(console)
fn void later_body_move_and_borrow_errors_publish_neither_ir_nor_interfaces(){let coords=table(0,false,false);var usize i=0;while(i<3){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;pub fn i32 main(){return 42;}")).is_ok && v::push<usize>(ref mut owners,1).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(invalid(i))).is_ok && v::push<usize>(ref mut owners,2).is_ok);let source=owned(sources,owners,v::empty<catalog::Binding>());var usize work=0;var usize linking=0;let previous=switch(core::build_identified_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut work,ref mut linking)){case .ok(_):{assert(false);core::empty()}case .err(e):{e}};assert(previous.phase==3 && previous.module_index==1 && previous.start<previous.end);work=0;linking=0;switch(core::build_complete_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut work,ref mut linking)){case .ok(_):{assert(false);}case .err(e):{assert(e.phase==previous.phase && e.stage==previous.stage && e.code==previous.code && e.module_index==previous.module_index && e.start==previous.start && e.end==previous.end && e.expected==previous.expected && e.actual==previous.actual && e.move_start==previous.move_start && e.move_end==previous.move_end);if(i==1){assert(e.code==1101);}}};i+=1;}}
@test @effects(console)
fn void stale_sources_and_alternate_plan_namespaces_cannot_replace_checked_facts(){let source=simple(b"module main;pub fn i32 main(){return 42;}");let coords=table(0,false,false);var usize work=0;var usize linking=0;let result=complete(ref source,ref coords,ref mut work,ref mut linking);let changed=simple(b"module main;pub fn i32 main(){return 43;}");let catalog=switch(catalog::build_scoped(ref changed.sources,ref changed.owners,ref changed.imports)){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(ref changed.sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let plan=switch(source_plan::build_sources(ref changed.sources,ref changed.owners,ref changed.imports,ref coords,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(interfaces::build(core::checked_program(ref result),ref plan,ref changed.sources,ref metadata,ref coords,ref mut work)){case .ok(_):{false}case .err(e):{e==12}});let original_catalog=switch(catalog::build_scoped(ref source.sources,ref source.owners,ref source.imports)){case .ok(p):{p}case .err(_):{assert(false);return;}};let original_metadata=switch(signatures::build_catalog(ref source.sources,original_catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};let wrong=table(0,true,false);work=0;let wrong_plan=switch(source_plan::build_sources(ref source.sources,ref source.owners,ref source.imports,ref wrong,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;assert(switch(interfaces::build(core::checked_program(ref result),ref wrong_plan,ref source.sources,ref original_metadata,ref coords,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});}

@test
fn void complete_reports_unsupported_signatures_without_publishing_ir(){
    let source=simple(b"module root;fn T id<T>(T x){return x;}fn i32 main(){return id<u16>(42);}");let coords=table(0,false,false);var usize work=0;var usize linking=0;var v::Vec<diagnostics::Reports> reports=v::empty<diagnostics::Reports>();
    switch(core::build_complete_reporting_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut reports,ref mut work,ref mut linking)){case .ok(_):{assert(false);}case .err(e):{assert(e.phase==5 && e.stage==6 && e.code==4505 && e.module_index==0 && e.start==15 && e.end==16);}};
    assert(v::len<diagnostics::Reports>(ref reports)==1 && linking==0);let actual=v::at<diagnostics::Reports>(ref reports,0);assert(diagnostics::count(actual)==2 && bytes::equal(diagnostics::name(actual,0),b"u16"));
    let normal=simple(b"module root;fn i32 main(){return 42;}");var v::Vec<diagnostics::Reports> clean=v::empty<diagnostics::Reports>();work=0;linking=0;
    switch(core::build_complete_reporting_sources(ref normal.sources,ref normal.owners,ref normal.imports,ref coords,ref mut clean,ref mut work,ref mut linking)){case .ok(p):{assert(proof::check(checked::ir_program(core::checked_program(ref p))).code==0);}case .err(_):{assert(false);}};assert(v::len<diagnostics::Reports>(ref clean)==0);
    work=0;linking=0;switch(core::build_complete_reporting_sources(ref normal.sources,ref normal.owners,ref normal.imports,ref coords,ref mut reports,ref mut work,ref mut linking)){case .ok(_):{assert(false);}case .err(e):{assert(e.phase==5 && e.stage==6 && e.code==9);}};assert(work==0 && linking==0 && v::len<diagnostics::Reports>(ref reports)==1);
    var v::Vec<diagnostics::Reports> exhausted=v::empty<diagnostics::Reports>();work=16777217;switch(core::build_complete_reporting_sources(ref source.sources,ref source.owners,ref source.imports,ref coords,ref mut exhausted,ref mut work,ref mut linking)){case .ok(_):{assert(false);}case .err(e):{assert(e.code==10);}};assert(v::len<diagnostics::Reports>(ref exhausted)==0 && linking==0);
}
