fn syntax::Parsed parsed(ref u8[] text){let tokens=switch(scanner::collect(fixture::copied(text),false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};return switch(syntax::parse(tokens,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(b"module empty;")}};}
fn v::Vec<syntax::Parsed> small(u32 mode){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(if(mode==1){b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=43,.ok=true};return read(ref p).n;}"}else if(mode==2){b"module main;@contract_uid(\"example.main\")state{cell u32 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=42,.ok=true};return read(ref p).n;}"}else{b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=42,.ok=true};return read(ref p).n;}"})).is_ok);return sources;}
fn v::Vec<usize> owners(){var v::Vec<usize> rows=v::empty<usize>();assert(v::push<usize>(ref mut rows,1).is_ok);return rows;}
fn coordinates::Coordinates table(){let names=fixture::copied(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref names)}).is_ok);return coordinates::assemble(names,rows);}
@effects(console) fn wire::Payload packet(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize source_work=0;var usize link_work=0;let complete=switch(core::build_complete_sources(sources,owners,imports,table,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return packet(sources,owners,imports,table);}};var usize work=0;return switch(encoder::encode(core::checked_program(ref complete),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);packet(sources,owners,imports,table)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(program_encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);encoded(p)}};}
struct Work{usize source;usize artifact;usize link;}
fn Work zero(){return Work{.source=0,.artifact=0,.link=0};}
fn Result<core::Complete,core::Problem> attempt(artifact::Restored input,ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table,ref mut Work work){var usize source_work=work.source;var usize artifact_work=work.artifact;var usize link_work=work.link;let result=core::restore_complete_sources(input,sources,owners,imports,table,ref mut source_work,ref mut artifact_work,ref mut link_work);work.source=source_work;work.artifact=artifact_work;work.link=link_work;return result;}
@effects(console) fn core::Complete restored(ref u8[] raw,ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table,ref mut Work work){return switch(attempt(fixture::restored(raw),sources,owners,imports,table,work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("restore ");discard io::write_stderr_u32(e.phase);discard io::write_stderr(" ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);restored(raw,sources,owners,imports,table,work)}};}
@effects(console) fn core::Complete detached_small(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let original=fixture::restored(wire::content(ref data));let before=encoded(artifact::program(ref original));var work=zero();let p=restored(wire::content(ref data),ref sources,ref owners,ref imports,ref table,ref mut work);let after=encoded(checked::ir_program(core::checked_program(ref p)));assert(bytes::equal(wire::content(ref before),wire::content(ref after)) && work.source>0 && work.artifact>0 && work.link>0);return p;}
@test @effects(console) fn void restored_complete_owner_detaches_ir_interfaces_and_call_targets(){let p=detached_small();let program=core::checked_program(ref p);let ir=checked::ir_program(program);assert(ir::count(ir)==2 && ir::work(ir)==0 && interfaces::count(core::public_interfaces(ref p))==1);var usize work=0;assert(proof::check_metered(ir,ref mut work).code==0 && work>0);let facts=interfaces::at(core::public_interfaces(ref p),0);assert(interfaces::owner(facts)==1 && interfaces::ordinary_hash(facts).len>64);var usize frame=1;var usize calls=0;while(frame<=ir::count(ir)){let body=ir::at(ir,frame);var usize i=0;while(i<ir::call_count(body)){let call=ir::call_at(body,i);if(call.kind==1 || call.kind==2){work=0;let target=switch(checked::call_frame(program,frame,i,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(target>0 && target<=ir::count(ir));calls+=1;}i+=1;}frame+=1;}assert(calls>0);}
@test @effects(console) fn void independent_source_artifact_link_histories_keep_exact_limits_and_reject_stale_inputs(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let raw=wire::content(ref data);var normal=zero();let first=restored(raw,ref sources,ref owners,ref imports,ref table,ref mut normal);var exact=Work{.source=16777216-normal.source,.artifact=budget::work_limit()-normal.artifact,.link=limits::project_work()-normal.link};let second=restored(raw,ref sources,ref owners,ref imports,ref table,ref mut exact);assert(exact.source==16777216 && exact.artifact==budget::work_limit() && exact.link==limits::project_work() && interfaces::count(core::public_interfaces(ref first))==interfaces::count(core::public_interfaces(ref second)));var u32 mode=0;
    while(mode<3){var work=zero();if(mode==0){work.source=16777216-normal.source+1;}else if(mode==1){work.artifact=budget::work_limit()-normal.artifact+1;}else{work.link=limits::project_work()-normal.link+1;}assert(switch(attempt(fixture::restored(raw),ref sources,ref owners,ref imports,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.code==10 || e.code==1002}});mode+=1;}
    var invalid=Work{.source=16777217,.artifact=0,.link=0};assert(switch(attempt(fixture::restored(raw),ref sources,ref owners,ref imports,ref table,ref mut invalid)){case .ok(_):{false}case .err(e):{e.phase==7 && e.code==10}} && invalid.source==16777217);mode=1;while(mode<3){let changed=small(mode);var work=zero();assert(switch(attempt(fixture::restored(raw),ref changed,ref owners,ref imports,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.phase==7 && (e.code==9 || e.code==12)}});mode+=1;}
}
fn bool foreign_target(ref ir::Program p,usize module_index,usize declaration){var usize i=0;while(i<ir::callable_count(p)){let row=ir::callable_at(p,i);if(row.module_index==module_index && row.declaration==declaration){return row.foreign && !row.template;}i+=1;}return false;}
@effects(filesystem,console) fn c::Bundle detached_generic(){let data=fixture::packet();let now=fixture::current(1);let sources=fixture::sources(ref now);let owners=fixture::owners(ref now);let imports=fixture::imports(ref now);let table=fixture::coordinate_table(ref now);var work=zero();let p=restored(wire::content(ref data),sources,owners,imports,table,ref mut work);let program=core::checked_program(ref p);let ir=checked::ir_program(program);assert(ir::count(ir)>100 && interfaces::count(core::public_interfaces(ref p))>1);var usize encoding=0;let again=switch(encoder::encode(program,ref mut encoding)){case .ok(p):{p}case .err(_):{assert(false);return detached_generic();}};let decoded=fixture::restored(wire::content(ref again));assert(ids::frame_count(artifact::source_identities(ref decoded))==ir::count(ir));var usize frame=1;var usize entry=0;var usize selected=0;var usize calls=0;var usize foreign_calls=0;var usize specialized_calls=0;
    while(frame<=ir::count(ir)){let original=checked::frame_at(program,frame);if(original.node!=0){assert(checked::identity(program,original).len==67);selected+=1;}let f=clean::frame_at(ir::cleanup_ir(ir),frame);let source=v::at<syntax::Parsed>(sources,f.module_index);let d=syntax::declaration_at(source,f.declaration-1);if(d.kind==3 && bytes::equal(syntax::source_view(source)[d.name_start..d.name_end],b"main")){assert(entry==0);entry=frame;}let body=ir::at(ir,frame);var usize i=0;while(i<ir::call_count(body)){let call=ir::call_at(body,i);if(call.kind==1 || call.kind==2){var usize used=0;let target=switch(checked::call_frame(program,frame,i,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return detached_generic();}};if(target==0){assert(call.kind==1 && foreign_target(ir,call.target_module,call.target_declaration));foreign_calls+=1;}else{assert(target<=ir::count(ir));if(call.kind==2){assert(checked::frame_at(program,target).node!=0);specialized_calls+=1;}calls+=1;}}i+=1;}frame+=1;}
    assert(entry>0 && selected>0 && calls>0 && foreign_calls>0 && specialized_calls>0);return switch(complete_c::partition_entry(p,entry,128)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);detached_generic()}};
}
@effects(console) fn void text(ref u8[] raw){assert(io::write_bytes(raw).is_ok);}
@effects(console) fn void member(ref u8[] raw){assert(io::write_usize(raw.len).is_ok);text(b"\n");text(raw);}
@test @effects(filesystem,console) fn void reordered_generic_vec_state_complete_owner_emits_a_detached_native_packet(){let bundle=detached_generic();assert(complete_c::has_complete(ref bundle) && c::project_selected_frames(ref bundle)>1 && interfaces::count(core::public_interfaces(complete_c::complete(ref bundle)))>1);text(b"FYCPARTS1\n");member(c::project_header(ref bundle));member(c::project_literals(ref bundle));assert(io::write_usize(c::project_unit_count(ref bundle)).is_ok);text(b"\n");var usize i=0;while(i<c::project_unit_count(ref bundle)){member(c::project_source(ref bundle,i));i+=1;}}
