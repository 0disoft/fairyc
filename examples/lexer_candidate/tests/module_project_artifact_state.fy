module tests::module_project_artifact_state;
import module_project_artifact_state as matching;
import module_state_layout as state;
import module_state_declarations as declarations;
import module_state_artifact as codec;
import module_catalog as catalog;
import module_program_artifact_wire as budget;
import candidate_artifact_wire as wire;
import tests::module_project_artifact_current_fixture as fixture;
import module_project_artifact_current as current;
import module_project_artifact_rebase as rebase;
import module_unit_body_ir_model as ir;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> sources(bool reversed){var v::Vec<syntax::Parsed> rows=v::empty<syntax::Parsed>();var usize i=0;while(i<2){let old=if(reversed){1-i}else{i};assert(v::push<syntax::Parsed>(ref mut rows,parsed(if(old==0){b"module left;@contract_uid(\"example.left\")state{cell u64 supply;map u32 u64 balances;}fn i32 f(){return 1;}"}else{b"module right;@contract_uid(\"example.right\")state{cell bool paused;cell bytes32 root;}fn i32 f(){return 2;}"})).is_ok);i+=1;}return rows;}
fn catalog::Catalog scoped(ref v::Vec<syntax::Parsed> sources,bool reversed,usize offset){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,if(reversed){1-i+offset}else{i+offset}).is_ok);i+=1;}let imports=v::empty<catalog::Binding>();return switch(catalog::build_scoped(sources,ref owners,ref imports)){case .ok(p):{p}case .err(_):{assert(false);scoped(sources,reversed,offset)}};}
fn state::Plan fresh(ref v::Vec<syntax::Parsed> sources,ref catalog::Catalog c){return switch(declarations::build(sources,c)){case .ok(p):{p}case .err(_):{assert(false);fresh(sources,c)}};}
fn state::Plan transported(ref state::Plan p){var usize work=0;let data=switch(codec::encode(p,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return transported(p);}};work=0;return switch(codec::decode(wire::content(ref data),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);transported(p)}};}
@effects(console) fn matching::Matched matched(ref state::Plan p,ref v::Vec<syntax::Parsed> sources,ref catalog::Catalog c,ref mut usize work){return switch(matching::build(p,sources,c,work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);matched(p,sources,c,work)}};}
fn state::Plan rebased(ref state::Plan p){var v::Vec<state::Layout> layouts=v::empty<state::Layout>();var v::Vec<state::Field> fields=v::empty<state::Field>();var usize i=0;while(i<state::count(p)){var row=state::at(p,i);row.module_index=1-row.module_index;row.owner+=7;assert(v::push<state::Layout>(ref mut layouts,row).is_ok);i+=1;}i=0;while(i<state::field_count(p)){assert(v::push<state::Field>(ref mut fields,state::field_at(p,i)).is_ok);i+=1;}return state::assemble(fixture::copied(state::names(p)),layouts,fields);}
@effects(console) fn matching::Matched detached(){let original=sources(false);let catalog=scoped(ref original,false,0);let state=fresh(ref original,ref catalog);let saved=transported(ref state);let rebased=rebased(ref saved);let now=sources(true);let current=scoped(ref now,true,7);var usize work=0;return matched(ref rebased,ref now,ref current,ref mut work);}
@test @effects(console) fn void canonical_states_match_reordered_sources_and_detached_maps(){let result=detached();assert(matching::count(ref result)==2 && matching::at(ref result,0)==2 && matching::at(ref result,1)==1);var v::Vec<syntax::Parsed> empty=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut empty,parsed(b"module empty;fn i32 f(){return 42;}")).is_ok);let c=scoped(ref empty,false,0);let original=fresh(ref empty,ref c);let saved=transported(ref original);var usize work=0;let none=matched(ref saved,ref empty,ref c,ref mut work);assert(matching::count(ref none)==0 && work>0);}

// Each changed plan has valid independently recomputed canonical hashes. It is
// structurally admissible to the codec while contradicting actual source facts.
fn state::Plan changed(ref state::Plan p,u32 mode){var bytes::Buffer names=bytes::empty();var v::Vec<state::Layout> layouts=v::empty<state::Layout>();var v::Vec<state::Field> fields=v::empty<state::Field>();var usize i=0;
    let usize count=if(mode==13){1}else if(mode==14){3}else{state::count(p)};
    while(i<count){var row=state::at(p,if(i<2){i}else{0});let extra=i==2;var uid=fixture::copied(if(extra){b"extra"}else{state::uid(p,i)});if(mode==8 && i==0){bytes::view_mut(ref mut uid)[0]=110;}
        if(i==0){if(mode==0){row.owner+=2;}else if(mode==1){row.module_index+=2;}else if(mode==2){row.declaration+=1;}else if(mode==3){row.end+=1;}}
        if(extra){row.owner=99;row.module_index=2;row.declaration=1;row.field_count=0;}else if(i==0 && mode==11){row.field_count-=1;}else if(i==0 && mode==12){row.field_count+=1;}
        row.uid_start=bytes::len(ref names);assert(bytes::append(ref mut names,bytes::view(ref uid)).is_ok);row.uid_end=bytes::len(ref names);let old_first=row.field_start;row.field_start=v::len<state::Field>(ref fields);var usize j=0;
        while(j<row.field_count){let added=i==0 && mode==12 && j==2;let usize old=if(added){0}else if(i==0 && mode==10){1-j}else{j};var f=state::field_at(p,old_first+old);var text=fixture::copied(if(added){b"added"}else{state::name(p,old_first+old)});
            if(i==0 && j==0){if(mode==4){f.start+=1;}else if(mode==5){f.value=2;}else if(mode==6){f.kind=2;f.key=2;}else if(mode==9){bytes::view_mut(ref mut text)[0]=116;}}
            if(i==0 && j==1 && mode==7){f.key=3;}f.name_start=bytes::len(ref names);assert(bytes::append(ref mut names,bytes::view(ref text)).is_ok);f.name_end=bytes::len(ref names);var usize work=0;
            f.prefix=switch(state::field_prefix(bytes::view(ref uid),bytes::view(ref text),f.kind,f.key,f.value,j,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);[0;8]}};assert(v::push<state::Field>(ref mut fields,f).is_ok);j+=1;
        }var usize work=0;row.hash=switch(state::layout_digest(bytes::view(ref uid),ref names,ref fields,row.field_start,row.field_count,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);[0;8]}};assert(v::push<state::Layout>(ref mut layouts,row).is_ok);i+=1;
    }let result=state::assemble(names,layouts,fields);var usize work=0;assert(state::validate(ref result,ref mut work)==0);return result;
}
@test @effects(console) fn void valid_rehashed_state_contradictions_reject(){let sources=sources(false);let c=scoped(ref sources,false,0);let original=fresh(ref sources,ref c);var u32 mode=0;while(mode<15){let altered=changed(ref original,mode);let saved=transported(ref altered);var usize work=0;assert(switch(matching::build(ref saved,ref sources,ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;}}
@test @effects(console) fn void work_boundaries_stale_sources_and_invalid_declarations_publish_no_map(){let original=sources(false);let c=scoped(ref original,false,0);let saved=fresh(ref original,ref c);var usize cost=0;let normal=matched(ref saved,ref original,ref c,ref mut cost);assert(cost>0);var usize work=budget::work_limit()-cost;let fit=matched(ref saved,ref original,ref c,ref mut work);assert(work==budget::work_limit() && matching::count(ref fit)==matching::count(ref normal));work=budget::work_limit()-cost+1;assert(switch(matching::build(ref saved,ref original,ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::build(ref saved,ref original,ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);
    let reordered=sources(true);work=0;assert(switch(matching::build(ref saved,ref reordered,ref c,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});var v::Vec<syntax::Parsed> bad=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut bad,parsed(b"module bad;@contract_uid(\"bad\")state{cell i32 count;}fn i32 f(){return 42;}")).is_ok);let bad_catalog=scoped(ref bad,false,0);work=0;assert(switch(matching::build(ref saved,ref bad,ref bad_catalog,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);
    work=0;let metered=switch(declarations::build_metered(ref original,ref c,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work>0 && state::equal(state::at(ref saved,0).hash,state::at(ref metered,0).hash));work=1048577;assert(switch(declarations::build_metered(ref original,ref c,ref mut work)){case .ok(_):{false}case .err(e):{e.code==10}} && work==1048577);
}
@test @effects(filesystem,console) fn void actual_rebased_generic_vec_state_artifact_matches_current_declarations(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let c=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let result=matched(ir::state_layouts(ref program),fixture::sources(ref sources),ref c,ref mut work);assert(matching::count(ref result)==1 && matching::at(ref result,0)==1 && state::field_count(ir::state_layouts(ref program))>0);}
