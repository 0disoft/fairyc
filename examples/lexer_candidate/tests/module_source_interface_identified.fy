import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

pub resource Context{v::Vec<syntax::Parsed> sources;signatures::Program metadata;typed::Interfaces types;coordinates::Coordinates coordinates;model::Graph templates;cleanup{}}
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}

fn coordinates::Coordinates table(usize shift,bool changed,bool missing){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize digit=1;while(digit<=3 && !missing){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut names,if(changed && digit==1){52}else if(digit==1){49}else if(digit==2){50}else{51}).is_ok);i+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);digit+=1;}return coordinates::assemble(names,rows);}
fn join::Problem failure(u32 phase,u32 code,usize module_index,usize start,usize end){return join::Problem{.code=phase+code,.module_index,.start,.end};}
fn Result<Context,join::Problem> context(v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,usize shift){let coordinates=table(shift,false,false);var usize work=0;let resolved=switch(bindings::build(ref sources,owners,imports,ref coordinates,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,0,0));}};work=0;let c=switch(templates::build(resolved,ref sources,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,0,0));}};work=0;let graph=switch(dependencies::build(c,ref sources,ref mut work)){case .ok(value):{value}case .err(p):{return .err(failure(100000,p.code,p.module_index,p.start,p.end));}};let declarations=switch(catalog::build_scoped(ref sources,owners,imports)){case .ok(value):{value}case .err(p):{return .err(failure(200000,p.code,p.module_index,p.start,p.end));}};let metadata=switch(signatures::build_catalog(ref sources,declarations)){case .ok(value):{value}case .err(p):{return .err(failure(300000,p.code,p.module_index,p.start,p.end));}};let bound=switch(bind::bind(ref sources,ref metadata,0,v::len<syntax::Parsed>(ref sources))){case .ok(value):{value}case .err(p):{return .err(failure(400000,p.code,p.module_index,p.start,p.end));}};let types=switch(typed::build(ref sources,ref metadata,ref bound)){case .ok(value):{value}case .err(p):{return .err(failure(500000,p.code,p.module_index,p.start,p.end));}};return .ok(Context{.sources,.metadata,.types,.coordinates,.templates=graph});}

@test
@effects(filesystem,console)
fn void actual_public_templates_and_source_interfaces_match_go(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPUB01"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==6);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let count=number(wire,ref mut at);let usize shift=if(c==2){19}else{0};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut at)+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let input=switch(context(sources,ref owners,ref imports,shift)){case .ok(value):{value}case .err(code):{discard io::write_stderr_bytes(label);discard io::write_stderr(" context ");discard io::write_stderr_u32(code.code);discard io::write_stderr(" module ");discard io::write_stderr_usize(code.module_index);discard io::write_stderr(" span ");discard io::write_stderr_usize(code.start);discard io::write_stderr("..");discard io::write_stderr_usize(code.end);assert(false);return;}};let source=planned(ref input);var usize names_work=0;let names=switch(source_types::build(ref source,ref input.sources,ref input.metadata,ref input.types,ref mut names_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return;}};assert(number(wire,ref mut at)==3);var usize package=0;while(package<3){let digit=number(wire,ref mut at);let owner=digit+shift;let expected=number(wire,ref mut at);var usize work=0;let public=switch(public::collect(ref input.templates,owner,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(generic::count(ref public)==expected);i=0;while(i<expected){let row=generic::at(ref public,i);assert(bytes::equal(generic::text(ref public,row.module_path),field(wire,ref mut at)) && bytes::equal(generic::text(ref public,row.name),field(wire,ref mut at)) && bytes::equal(generic::text(ref public,row.closure),field(wire,ref mut at)));i+=1;}let ordinary_expected=field(wire,ref mut at);let generic_expected=field(wire,ref mut at);work=0;let digest=switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref source,owner,ref mut work)){case .ok(value):{value}case .err(code):{discard io::write_stderr_bytes(label);discard io::write_stderr_usize(digit);discard io::write_stderr_u32(code);assert(false);return;}};assert(bytes::equal(bytes::view(ref digest),generic_expected));work=0;let projection=switch(extract::extract_identified(ref names,ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,owner,ref mut work)){case .ok(value):{value}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let ordinary=switch(ordinary::hash(signatures::state_layouts(ref input.metadata),owner,extract::descriptor(ref projection),ref mut work)){case .ok(value):{value}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};assert(bytes::equal(bytes::view(ref ordinary),ordinary_expected));package+=1;}c+=1;}assert(at==wire.len);}

@effects(console)
fn plans::Plan planned_with_coordinates(ref Context input,ref coordinates::Coordinates coordinates){var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<v::len<syntax::Parsed>(ref input.sources)){assert(v::push<usize>(ref mut owners,signatures::module_owner(ref input.metadata,i)).is_ok);let source=v::at<syntax::Parsed>(ref input.sources,i);var usize j=1;while(j<syntax::declaration_count(source)){let d=syntax::declaration_at(source,j);if(d.kind==2){var usize measured=0;let target=signatures::import_target_measured(ref input.metadata,i,syntax::source_view(source)[d.name_start..d.name_end],ref mut measured);assert(target.code==0 && target.item>0);assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+1,.target=target.item-1}).is_ok);}j+=1;}i+=1;}var planning::Budget budget=planning::empty();let packages=switch(bindings::build(ref input.sources,ref owners,ref imports,coordinates,ref mut budget.work)){case .ok(p):{p}case .err(_):{assert(false);return planned(input);}};let catalog=switch(templates::build(packages,ref input.sources,ref mut budget.work)){case .ok(p):{p}case .err(_):{assert(false);return planned(input);}};let roots=switch(requests::build(catalog,ref input.sources,ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return planned(input);}};let prepared=switch(plan_input::build(roots,ref input.sources,ref mut budget)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.source.code);assert(false);return planned(input);}};return switch(plans::build(prepared,plans::defaults(),ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return planned(input);}};}

@effects(console)
fn plans::Plan planned(ref Context input){return planned_with_coordinates(input,ref input.coordinates);}
@effects(filesystem,console)
fn Context base(bool edited){let data=fixture();let wire=bytes::view(ref data);var usize at=8;assert(number(wire,ref mut at)==6);discard field(wire,ref mut at);let count=number(wire,ref mut at);assert(count==3);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut at)).is_ok);let raw=field(wire,ref mut at);if(edited && i==1){var bytes::Buffer changed=bytes::empty();assert(bytes::append(ref mut changed,raw).is_ok && bytes::append(ref mut changed,b"\n// stale source control").is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref changed))).is_ok);}else{assert(v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok);}let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}return switch(context(sources,ref owners,ref imports,0)){case .ok(p):{p}case .err(_):{assert(false);return base(edited);}};}
@test @effects(filesystem,console)
fn void sdk_source_interface_exact_project_work_fails_without_partial_hash(){let input=base(false);let source=planned(ref input);var usize cost=0;let expected=switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref source,3,ref mut cost)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e);assert(false);return;}};assert(cost>0 && cost<16777216);var usize work=16777216-cost;let exact=switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref source,3,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e);assert(false);return;}};assert(work==16777216 && bytes::equal(bytes::view(ref expected),bytes::view(ref exact)));work=16777217-cost;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref source,3,ref mut work)){case .ok(_):{false}case .err(e):{e==10}});work=16777217;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref source,3,ref mut work)){case .ok(_):{false}case .err(e):{e==10}});}
@test @effects(filesystem,console)
fn void mismatched_plan_namespaces_and_stale_graphs_do_not_publish_interfaces(){let input=base(false);let source=planned(ref input);let wrong=table(0,true,false);let missing=table(0,false,true);var usize work=0;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref wrong,ref input.templates,ref source,3,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});work=0;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref missing,ref input.templates,ref source,3,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});let wrong_plan=planned_with_coordinates(ref input,ref wrong);work=0;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref wrong_plan,3,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});let changed=base(true);let stale=planned(ref changed);work=0;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref input.templates,ref stale,3,ref mut work)){case .ok(_):{false}case .err(e):{e==12}});work=0;assert(switch(interface::hash_identified(ref input.sources,ref input.metadata,ref input.types,ref input.coordinates,ref changed.templates,ref source,3,ref mut work)){case .ok(_):{false}case .err(e):{e==12}});}
