fn bytes::Buffer copied(ref u8[] raw){return switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);return copied(raw);}};}
@effects(filesystem) fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let n=switch(process::arg(1,ref mut path)){case .ok(n):{n}case .err(_):{assert(false);0}};let ref u8[] view=ref path;return switch(files::manifest(view[..n])){case .ok(p):{p}case .err(_):{assert(false);return fixture();}};}
@effects(console) fn wire::Payload encoded(ref model::Metadata p,ref clean::Program cleaned,ref mut usize work){return switch(encoder::encode(p,cleaned,2,work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return encoded(p,cleaned,work);}};}
@effects(console) fn model::Metadata decoded(ref u8[] raw,ref clean::Program cleaned,ref mut usize work){return switch(decoder::decode(raw,cleaned,2,work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return decoded(raw,cleaned,work);}};}
fn u32 rejected(ref u8[] raw,ref clean::Program cleaned,usize modules){var usize work=0;return switch(decoder::decode(raw,cleaned,modules,ref mut work)){case .ok(_):{0}case .err(code):{code}};}
fn void same_layout(ir::Layout a,ir::Layout b){assert(a.value.type==b.value.type && a.value.module_index==b.value.module_index && a.value.declaration==b.value.declaration && a.value.field_start==b.value.field_start && a.value.field_count==b.value.field_count && a.value.abilities==b.value.abilities && a.value.repr_c==b.value.repr_c && a.value.start==b.value.start && a.value.end==b.value.end && a.value.cleanup_nonempty==b.value.cleanup_nonempty && a.value.cleanup_effects==b.value.cleanup_effects && a.name_start==b.name_start && a.name_end==b.name_end);}
fn void same_field(interfaces::Field a,interfaces::Field b){assert(a.kind==b.kind && a.type==b.type && a.module_index==b.module_index && a.declaration==b.declaration && a.source_index==b.source_index && a.start==b.start && a.end==b.end && a.name_start==b.name_start && a.name_end==b.name_end && a.payload_start==b.payload_start && a.payload_count==b.payload_count);}
fn void same_callable(interfaces::Callable a,interfaces::Callable b){assert(a.module_index==b.module_index && a.declaration==b.declaration && a.template==b.template && a.result==b.result && a.parameter_start==b.parameter_start && a.parameter_count==b.parameter_count && a.effects==b.effects && a.must_use==b.must_use && a.unsafe_call==b.unsafe_call && a.foreign==b.foreign && a.link_start==b.link_start && a.link_end==b.link_end);}
fn void same(ref model::Metadata a,ref model::Metadata b){assert(bytes::equal(model::names(a),model::names(b)) && model::layout_count(a)==model::layout_count(b) && model::field_count(a)==model::field_count(b) && model::callable_count(a)==model::callable_count(b) && model::parameter_count(a)==model::parameter_count(b));var usize i=0;
while(i<model::layout_count(a)){same_layout(model::layout_at(a,i),model::layout_at(b,i));i+=1;}i=0;while(i<model::field_count(a)){same_field(model::field_at(a,i),model::field_at(b,i));i+=1;}i=0;while(i<model::callable_count(a)){same_callable(model::callable_at(a,i),model::callable_at(b,i));i+=1;}i=0;while(i<model::parameter_count(a)){assert(model::parameter_at(a,i)==model::parameter_at(b,i));i+=1;}}
@effects(filesystem,console) fn model::Metadata detached(){let raw=fixture();let cleaned=fixture_owner::cleaned(false);var usize work=0;return decoded(bytes::view(ref raw),ref cleaned,ref mut work);}
@test @effects(filesystem,console)
fn void metadata_binary_matches_independent_golden_and_detaches(){let expected=fixture();let cleaned=fixture_owner::cleaned(false);let p=fixture_owner::metadata(ref cleaned);var usize work=0;let data=encoded(ref p,ref cleaned,ref mut work);assert(bytes::equal(wire::content(ref data),bytes::view(ref expected)));let copy=detached();same(ref p,ref copy);assert(model::layout_count(ref copy)==2 && model::field_count(ref copy)==3 && model::callable_count(ref copy)==2 && model::parameter_count(ref copy)==2);}
@test @effects(filesystem,console)
fn void metadata_codec_enforces_context_and_exact_work(){let expected=fixture();let cleaned=fixture_owner::cleaned(false);let p=fixture_owner::metadata(ref cleaned);var usize cost=0;let data=encoded(ref p,ref cleaned,ref mut cost);assert(cost==867);var usize work=16777216-cost;let fit=encoded(ref p,ref cleaned,ref mut work);assert(work==16777216 && bytes::equal(wire::content(ref fit),wire::content(ref data)));
work=16777216-cost+1;assert(switch(encoder::encode(ref p,ref cleaned,2,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work<=16777216);
cost=0;let restored=decoded(wire::content(ref data),ref cleaned,ref mut cost);assert(cost==868);work=16777216-cost;let copy=decoded(wire::content(ref data),ref cleaned,ref mut work);assert(work==16777216);same(ref restored,ref copy);
work=16777216-cost+1;assert(switch(decoder::decode(wire::content(ref data),ref cleaned,2,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work<=16777216);work=16777217;assert(switch(decoder::decode(wire::content(ref data),ref cleaned,2,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==16777217);
assert(rejected(bytes::view(ref expected),ref cleaned,1)==1001);let scalar=scalar_owner::build();assert(rejected(bytes::view(ref expected),ref scalar,2)==1001);let other=fixture_owner::cleaned(true);assert(rejected(bytes::view(ref expected),ref other,2)==1001);
}
@test @effects(filesystem)
fn void metadata_codec_rejects_truncation_invalid_flags_and_table_links(){let expected=fixture();let cleaned=fixture_owner::cleaned(false);let raw=bytes::view(ref expected);assert(raw.len==763);var usize i=0;while(i<raw.len){assert(rejected(raw[..i],ref cleaned,2)!=0);i+=1;}var trailing=copied(raw);assert(bytes::append_byte(ref mut trailing,0).is_ok && rejected(bytes::view(ref trailing),ref cleaned,2)==1001);
var u32 mode=0;while(mode<21){var changed=copied(raw);let view=bytes::view_mut(ref mut changed);if(mode==0){view[7]=49;}else if(mode==1){view[39]=0;}else if(mode==2){view[47]=0;}else if(mode==3){view[55]=4;}else if(mode==4){view[63]=255;}else if(mode==5){view[87]=2;}else if(mode==6){view[79]=8;}else if(mode==7){view[72]=1;}else if(mode==8){view[135]=255;}else if(mode==9){view[24]=255;}else if(mode==10){view[240]=255;}else if(mode==11){view[263]=7;}else if(mode==12){view[327]=255;}else if(mode==13){view[543]=2;}else if(mode==14){view[559]=255;}else if(mode==15){view[711]=255;}else if(mode==16){view[736]=255;}else if(mode==17){view[727]=7;}else if(mode==18){view[248]=1;}else if(mode==19){view[272]=255;}else{view[280]=255;}assert(rejected(bytes::view(ref changed),ref cleaned,2)==if(mode==9 || mode==10 || mode==16){1002}else{1001});mode+=1;}}
@effects(console) fn ir::Program restored_program(ref ir::Program original,ref model::Metadata metadata){var usize used=0;let encoded_clean=switch(clean_encoder::encode(ir::cleanup_ir(original),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};used=0;let cleaned=switch(clean_decoder::decode(wire::content(ref encoded_clean),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};
var v::Vec<ir::Body> bodies=v::empty<ir::Body>();var usize i=1;while(i<=ir::count(original)){used=0;let data=switch(body_encoder::encode(original,i,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};used=0;let body=switch(body_decoder::decode(wire::content(ref data),ref cleaned,i,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};assert(v::push<ir::Body>(ref mut bodies,body).is_ok);i+=1;}
used=0;let sdk_data=switch(sdk_codec::encode(ir::sdk_units(original),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};used=0;let sources=switch(sdk_codec::decode(wire::content(ref sdk_data),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};
used=0;let states=switch(state::copy(ir::state_layouts(original),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return restored_program(original,metadata);}};used=0;return switch(model::restore(metadata,states,sources,cleaned,bodies,ref mut used)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return restored_program(original,metadata);}};
}
@effects(console) fn ir::Program detached_source_program(){let original=source_fixture::retained(b"module main;import provider as p;enum E{Empty;Data{i32 a;bool b;};}fn E choose(){return .Data{.a=1,.b=true};}@repr(C)struct S{i32 n;bool yes;}@effects(console)resource R{i32 n;cleanup{discard 1;}}@must_use @effects(console)fn i32 f(i32 n){let E e=choose();discard e;let S x=S{.n=n,.yes=true};let R r=R{.n=n};let p::S y=p::make(n);return p::number(n);}",b"module provider;pub struct S{i32 n;}pub fn S make(i32 n){return S{.n=n};}@link_name(\"foreign_number\")unsafe extern C fn i32 foreign(i32 n);@must_use pub fn i32 number(i32 n){return unsafe{foreign(n)};}");
var usize used=0;let original_metadata=switch(model::extract(ref original,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return detached_source_program();}};used=0;let data=switch(encoder::program(ref original,ref mut used)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return detached_source_program();}};used=0;let metadata=switch(decoder::decode(wire::content(ref data),ir::cleanup_ir(ref original),sdk::module_count(ir::sdk_units(ref original)),ref mut used)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return detached_source_program();}};same(ref original_metadata,ref metadata);return restored_program(ref original,ref metadata);
}
@test @effects(console)
fn void source_metadata_roundtrip_reassembles_a_fully_verified_program(){let p=detached_source_program();assert(ir::work(ref p)==0 && proof::check(ref p).code==0 && ir::layout_count(ref p)>0 && ir::field_count(ref p)>0 && ir::callable_count(ref p)>0 && ir::parameter_count(ref p)>0);
var usize used=0;let data=switch(encoder::program(ref p,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return;}};used=0;let metadata=switch(model::extract(ref p,ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return;}};used=0;let restored=switch(decoder::decode(wire::content(ref data),ir::cleanup_ir(ref p),sdk::module_count(ir::sdk_units(ref p)),ref mut used)){case .ok(p):{p}case .err(_):{assert(false);return;}};same(ref metadata,ref restored);
var usize foreign=0;var usize must_use=0;var usize repr=0;var usize i=0;while(i<model::callable_count(ref restored)){let c=model::callable_at(ref restored,i);if(c.foreign){foreign+=1;assert(c.unsafe_call && bytes::equal(model::names(ref restored)[c.link_start..c.link_end],b"foreign_number"));}if(c.must_use){must_use+=1;}i+=1;}i=0;while(i<model::layout_count(ref restored)){if(model::layout_at(ref restored,i).value.repr_c){repr+=1;}i+=1;}var usize payloads=0;i=0;while(i<model::field_count(ref restored)){if(model::field_at(ref restored,i).payload_count!=0){payloads+=1;}i+=1;}assert(foreign>0 && must_use>0 && repr>0 && payloads>0);
}
