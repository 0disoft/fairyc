module tests::windows_host_paths;
import windows_host_paths as paths;
import file_source as files;
import std::process as process;
import std::bytes as bytes;

fn bytes::Buffer decoded(ref u8[] data){return switch(paths::decode(data)){case .ok(p):{p}case .err(_):{assert(false);return bytes::empty();}};}
fn void rejected(ref u8[] data){switch(paths::decode(data)){case .ok(_):{assert(false);}case .err(e):{assert(e.kind==1);}};}
@test fn void decodes_unicode_and_rejects_malformed_host_words(){let value=decoded(b"C\x00:\x00\\\x00\x5c\xd5\x3d\xd8\x00\xde\x00\x00");assert(bytes::equal(bytes::view(ref value),b"C:\\\xed\x95\x9c\xf0\x9f\x98\x80"));rejected(b"");rejected(b"\x00");rejected(b"A\x00");rejected(b"\x00\x00A\x00\x00\x00");rejected(b"\x3d\xd8\x00\x00");rejected(b"\x00\xde\x00\x00");let companion=switch(paths::sibling(b"C:\\tool dir\\fairyc.exe",b"fairyc-candidate-build.exe")){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref companion),b"C:\\tool dir\\fairyc-candidate-build.exe"));}
@test @effects(filesystem,environment) fn void queries_current_temp_and_own_image(){var u8[4096] data=[0;4096];let n=switch(process::arg(1,ref mut data)){case .ok(n):{n}case .err(_):{assert(false);return;}};let ref u8[] view=ref data;let fixture=switch(files::manifest(view[..n])){case .ok(p):{p}case .err(_):{assert(false);return;}};let expected=bytes::view(ref fixture);var usize separator=0;while(separator<expected.len && expected[separator]!=10){separator+=1;}assert(separator<expected.len);let cwd=switch(paths::current()){case .ok(p):{p}case .err(_):{assert(false);return;}};let temp=switch(paths::temporary()){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref cwd),expected[..separator]) && bytes::equal(bytes::view(ref temp),expected[separator+1..]));let count=switch(process::arg(0,ref mut data)){case .ok(n):{n}case .err(_):{assert(false);return;}};let image=switch(paths::executable()){case .ok(p):{p}case .err(_):{assert(false);return;}};let ref u8[] argument=ref data;assert(bytes::equal(bytes::view(ref image),argument[..count]));let companion=switch(paths::driver()){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::len(ref companion)>bytes::len(ref image));}
