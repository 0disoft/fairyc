pub resource Context{v::Vec<syntax::Parsed> sources;signatures::Program metadata;coordinates::Coordinates coordinates;view::View view;cleanup{}}
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}

fn coordinates::Coordinates table(usize shift,bool changed,bool missing){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize digit=1;while(digit<=3 && !missing){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut names,if(changed && digit==1){52}else if(digit==1){49}else if(digit==2){50}else{51}).is_ok);i+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);digit+=1;}return coordinates::assemble(names,rows);}

@effects(console)
fn Context context(v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,usize shift){let coordinates=table(shift,false,false);let catalog=switch(catalog::build_scoped(ref sources,owners,imports)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};let metadata=switch(signatures::build_catalog(ref sources,catalog)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};
 var planning::Budget budget=planning::empty();let bindings=switch(bindings::build(ref sources,owners,imports,ref coordinates,ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};let templates=switch(templates::build(bindings,ref sources,ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};let roots=switch(requests::build(templates,ref sources,ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};let prepared=switch(prepared::build(roots,ref sources,ref mut budget)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.source.code);assert(false);return context(sources,owners,imports,shift);}};let plan=switch(plans::build(prepared,plans::defaults(),ref mut budget.work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};
 var usize work=0;let units=switch(project::build(ref sources,ref metadata,ref plan,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("project ");discard io::write_stderr_u32(e.stage);discard io::write_stderr("/");discard io::write_stderr_u32(e.code);discard io::write_stderr(" module ");discard io::write_stderr_usize(e.module_index);assert(false);return context(sources,owners,imports,shift);}};work=0;let linked=switch(linked::build(ref metadata,ref units,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return context(sources,owners,imports,shift);}};work=0;let view=switch(view::build(ref linked,ref sources,ref metadata,ref coordinates,ref mut work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e);assert(false);return context(sources,owners,imports,shift);}};return Context{.sources,.metadata,.coordinates,.view};
}
@effects(console)
fn descriptor::Projection projected(ref Context input,usize owner,ref mut usize work){return switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref input.coordinates,owner,work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("extract ");discard io::write_stderr_u32(e);assert(false);return projected(input,owner,work);}};}
fn bytes::Buffer encoded(ref Context input,ref descriptor::Projection projection,usize owner){var usize work=0;return switch(ordinary::encode(signatures::state_layouts(ref input.metadata),owner,descriptor::descriptor(projection),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return encoded(input,projection,owner);}};}
@effects(filesystem,console)
fn Context base(bool edited,bool wide){let data=fixture();let wire=bytes::view(ref data);assert(bytes::equal(wire[..8],b"FYGPDES1"));var usize at=8;assert(number(wire,ref mut at)==6);discard field(wire,ref mut at);let count=number(wire,ref mut at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut at)).is_ok);let raw=field(wire,ref mut at);if(edited && i==1){var bytes::Buffer changed=bytes::empty();assert(bytes::append(ref mut changed,raw).is_ok && bytes::append(ref mut changed,b"\n// changed source").is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref changed))).is_ok);}else{assert(v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok);}let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let source=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(source,j+1);assert(bytes::equal(alias,syntax::source_view(source)[d.name_start..d.name_end]));let target=number(wire,ref mut at);assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=target}).is_ok);j+=1;}i+=1;}
 if(wide){var u8[4096] filler=[120;4096];var u8 index=0;while(index<17){let u8[1] letter=[97+index];var bytes::Buffer raw=bytes::empty();assert(bytes::append(ref mut raw,b"module wide::").is_ok && bytes::append(ref mut raw,ref letter[..]).is_ok && bytes::append(ref mut raw,b";/*").is_ok);var usize part=0;while(part<15){assert(bytes::append(ref mut raw,ref filler[..]).is_ok);part+=1;}assert(bytes::append(ref mut raw,b"*/pub struct Leaf{i32 value;}pub fn i32 read(ref Leaf leaf){return leaf.value;}").is_ok && bytes::len(ref raw)<65536);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref raw))).is_ok && v::push<usize>(ref mut owners,1).is_ok);index+=1;}}
 return context(sources,ref owners,ref imports,0);
}
@test @effects(filesystem,console)
fn void checked_project_descriptors_match_all_go_encoding_bytes_and_hashes(){let data=fixture();let wire=bytes::view(ref data);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPDES1"));var usize at=8;assert(number(wire,ref mut at)==6);var usize case_index=0;var usize compared=0;var usize compared_bytes=0;while(case_index<6){let label=field(wire,ref mut at);let count=number(wire,ref mut at);let usize shift=if(case_index==2){19}else{0};var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut at)+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let n=number(wire,ref mut at);var usize j=0;while(j<n){let alias=field(wire,ref mut at);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let input=context(sources,ref owners,ref imports,shift);assert(number(wire,ref mut at)==3);var usize package=0;while(package<3){let owner=number(wire,ref mut at)+shift;let templates=number(wire,ref mut at);i=0;while(i<templates){discard field(wire,ref mut at);discard field(wire,ref mut at);discard field(wire,ref mut at);i+=1;}let hash=field(wire,ref mut at);discard field(wire,ref mut at);let expected=field(wire,ref mut at);var usize work=0;let projection=projected(ref input,owner,ref mut work);assert(descriptor::has_templates(ref projection)==(templates!=0));let actual=encoded(ref input,ref projection,owner);if(!bytes::equal(bytes::view(ref actual),expected)){discard io::write_stderr_bytes(label);discard io::write_stderr_usize(owner);assert(false);}work=0;let digest=switch(ordinary::hash(signatures::state_layouts(ref input.metadata),owner,descriptor::descriptor(ref projection),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref digest),hash));compared+=1;compared_bytes+=expected.len;package+=1;}case_index+=1;}assert(at==wire.len && compared==18 && compared_bytes==15788);}
@test @effects(filesystem,console)
fn void stale_sources_coordinates_and_work_exhaustion_publish_no_descriptor(){let input=base(false,false);var usize required=0;let projection=projected(ref input,3,ref mut required);let expected=encoded(ref input,ref projection,3);assert(required>0 && required<16777216);var usize work=16777216-required;let exact=projected(ref input,3,ref mut work);let actual=encoded(ref input,ref exact,3);assert(work==16777216 && bytes::equal(bytes::view(ref expected),bytes::view(ref actual)));work=16777217-required;assert(switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref input.coordinates,3,ref mut work)){case .ok(_):{false}case .err(e):{e==10}});work=16777217;assert(switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref input.coordinates,3,ref mut work)){case .ok(_):{false}case .err(e):{e==10}} && work==16777217);
 let changed=base(true,false);work=0;assert(switch(public::extract(ref input.view,ref changed.sources,ref changed.metadata,ref input.coordinates,3,ref mut work)){case .ok(_):{false}case .err(e):{e==12}});let wrong=table(0,true,false);work=0;assert(switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref wrong,3,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});let missing=table(0,false,true);work=0;assert(switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref missing,3,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});work=0;assert(switch(public::extract(ref input.view,ref input.sources,ref input.metadata,ref input.coordinates,511,ref mut work)){case .ok(_):{false}case .err(e):{e==9}});
}
@test @effects(filesystem,console)
fn void full_source_authentication_and_repeated_nominal_names_use_separate_histories(){let input=base(false,true);var usize retained_bytes=0;var usize i=0;while(i<v::len<syntax::Parsed>(ref input.sources)){retained_bytes+=syntax::source_view(v::at<syntax::Parsed>(ref input.sources,i)).len;i+=1;}assert(retained_bytes>1048576);var usize work=0;let projection=projected(ref input,1,ref mut work);assert(work>1048576 && work<16777216);let output=encoded(ref input,ref projection,1);assert(records::module_count(descriptor::descriptor(ref projection))==18 && records::item_count(descriptor::descriptor(ref projection))==34 && bytes::len(ref output)>1000);}

@test @effects(console)
fn void ordinary_fields_variants_effects_abilities_and_unused_foreign_match_go(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<2){assert(v::push<syntax::Parsed>(ref mut sources,parsed(ordinary_source(0,i))).is_ok && v::push<usize>(ref mut owners,1).is_ok);i+=1;}let imports=v::empty<catalog::Binding>();let input=context(sources,ref owners,ref imports,0);var usize work=0;let projection=projected(ref input,1,ref mut work);assert(!descriptor::has_templates(ref projection));let value=descriptor::descriptor(ref projection);assert(records::module_count(value)==2 && records::item_count(value)==7 && records::variant_count(value)==2);let actual=encoded(ref input,ref projection,1);let hex=expected_hex();let raw=bytes::view(ref actual);assert(raw.len*2==hex.len);i=0;while(i<raw.len){assert(raw[i]==digit(hex[i*2])*16+digit(hex[i*2+1]));i+=1;}work=0;let digest=switch(ordinary::hash(signatures::state_layouts(ref input.metadata),1,value,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(expected_hash(bytes::view(ref digest),false));}
fn u8 digit(u8 value){return if(value<=57){value-48}else{value-87};}
fn ref u8[] ordinary_source(u32 mode,usize i){
  if(mode==0 && i==0){return b"module api;pub struct Leaf{i64 value;}@repr(C)pub struct Wire{c::int value;c::uint code;}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);fn i32 hidden(){return 1;}";}
  if(mode==0 && i==1){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==1 && i==0){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==1 && i==1){return b"module api;fn i32 hidden(){return 99;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@repr(C)pub struct Wire{c::int value;c::uint code;}pub struct Leaf{i64 value;}";}
  if(mode==2 && i==0){return b"module api;pub struct Leaf{i32 value;}@repr(C)pub struct Wire{c::int value;c::uint code;}pub enum Kind{Off;Pair{i32 x;Leaf leaf;};}@abilities(store,key)@effects(console)pub resource Asset{i32 hidden;cleanup{discard this.hidden;}}@must_use @effects(storage_write,console,clock)pub unsafe fn i32 read(ref Leaf leaf,ref mut Asset asset,Option<ref Leaf> optional,Kind kind){return 7;}@link_name(\"fixture_public_read\")@effects(filesystem)@must_use pub unsafe extern C fn c::int host(c::uint code);fn i32 hidden(){return 1;}";}
  if(mode==2 && i==1){return b"module zeta;pub fn bool ready(){return true;}struct Secret{i32 private;}resource Local{cleanup{}}";}
  if(mode==3 && i==0){return b"module generic;pub fn T identity<T>(T value){return value;}pub fn i32 token(){return 7;}";}
  return b"";
}
fn ref u8[] expected_hex(){return b"";}
fn bool expected_hash(ref u8[] actual,bool changed){if(changed){return bytes::equal(actual,b"fyif5-sha256-a919d86c16731341cf6ad778dc6d1660088ade9a7155d7add89ea3f15ee4d036");}return bytes::equal(actual,b"fyif5-sha256-a9c489cf3fee25454bcfdcbb229c785bc9abc3c15270fcbec0a4fe940dfed81c");}
