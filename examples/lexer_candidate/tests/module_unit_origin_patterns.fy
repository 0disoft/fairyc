module tests::module_unit_origin_patterns;
import module_unit_origin_diagnostics as diagnostics;
import module_unit_origin_returns as origins;
import module_unit_values as values;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
import module_unit_origin_check as checker;
fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(console) fn values::Plan primary(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return primary(sources,metadata);}};let ready=switch(closure::build(sources,metadata,ref bound)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return primary(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);primary(sources,metadata)}};}
@effects(console) fn diagnostics::Report checked(ref u8[] root,ref u8[] provider){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok);if(provider.len!=0){assert(v::push<syntax::Parsed>(ref mut sources,parsed(provider)).is_ok);}let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return checked(root,provider);}};let primary=primary(ref sources,ref metadata);let p=switch(origins::build(ref sources,ref metadata,ref primary)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);return checked(root,provider);}};return switch(diagnostics::collect(ref p)){case .ok(p):{p}case .err(p):{discard io::write("analysis problem ");discard io::write_u32(p.code);discard io::write("\n");assert(false);checked(root,provider)}};}
@effects(console) fn void emit(usize case_index,ref diagnostics::Report p){
    discard io::write("case ");discard io::write_usize(case_index);discard io::write(" ");discard io::write_u32(diagnostics::exit_code(p));discard io::write(" ");discard io::write_usize(diagnostics::visible_count(p));discard io::write("\n");var usize i=0;while(i<diagnostics::count(p)){if(!diagnostics::visible_at(p,i)){i+=1;continue;}let d=diagnostics::at(p,i);discard io::write("diagnostic ");discard io::write_u32(d.code);discard io::write(" ");discard io::write_usize(d.module_index);discard io::write(" ");discard io::write_usize(d.start);discard io::write(" ");discard io::write_usize(d.end);discard io::write(" ");discard io::write_usize(d.related_count);discard io::write("\n");var usize j=0;while(j<d.related_count){let r=diagnostics::related_at(p,d,j);discard io::write("related ");discard io::write_u32(r.role);discard io::write(" ");discard io::write_usize(r.module_index);discard io::write(" ");discard io::write_usize(r.start);discard io::write(" ");discard io::write_usize(r.end);discard io::write("\n");j+=1;}i+=1;}
}


@test @effects(console) fn void matched_payloads_preserve_origins_and_diagnostic_sites(){
    let p0=checked(b"module main;fn ref i32 f(Option<ref i32> x,ref i32 fallback){return switch(x){case .some(a):{a}case .none:{fallback}};}",b"");emit(0,ref p0);assert(diagnostics::exit_code(ref p0)==3);
    let p1=checked(b"module main;fn ref i32 f(ref i32 fallback){let i32 n=1;let Option<ref i32> x=.some(ref n);return switch(x){case .some(a):{a}case .none:{fallback}};}",b"");emit(1,ref p1);assert(diagnostics::exit_code(ref p1)==3);
    let p2=checked(b"module main;fn ref i32 f(Option<i32> x,ref i32 fallback){return switch(x){case .some(n):{ref n}case .none:{fallback}};}",b"");emit(2,ref p2);assert(diagnostics::exit_code(ref p2)==3);
    let p3=checked(b"module main;fn ref i32 f(ref i32 fallback){let Option<ref i32> x=.none;return switch(x){case .some(a):{a}case .none:{fallback}};}",b"");emit(3,ref p3);assert(diagnostics::exit_code(ref p3)==0);
    let p4=checked(b"module main;fn Option<ref i32> f(){let Option<Option<ref i32>> x=.some(.none);return switch(x){case .some(a):{a}case .none:{.none}};}",b"");emit(4,ref p4);assert(diagnostics::exit_code(ref p4)==0);
    let p5=checked(b"module main;fn ref i32 f(Result<ref i32,i32> x,ref i32 fallback){return switch(x){case .ok(a):{a}case .err(e):{fallback}};}",b"");emit(5,ref p5);assert(diagnostics::exit_code(ref p5)==3);
    let p6=checked(b"module main;fn ref i32 f(Option<ref i32> x){return switch(x){case .some(a):{a}case .none:{assert(false);}};}",b"");emit(6,ref p6);assert(diagnostics::exit_code(ref p6)==0);
    let p7=checked(b"module main;fn ref i32 f(Option<i32> x){return switch(x){case .some(a):{ref a}case .none:{assert(false);}};}",b"");emit(7,ref p7);assert(diagnostics::exit_code(ref p7)==3);
    let p8=checked(b"module main;fn ref i32 f(ref i32 a){let Option<ref i32> x=.some(a);return switch(x){case .some(v):{v}case .none:{a}};}",b"");emit(8,ref p8);assert(diagnostics::exit_code(ref p8)==0);
    let p9=checked(b"module main;fn ref i32 f(Option<Option<ref i32>> x){return switch(x){case .some(v):{switch(v){case .some(a):{a}case .none:{assert(false);}}}case .none:{assert(false);}};}",b"");emit(9,ref p9);assert(diagnostics::exit_code(ref p9)==0);
    let p10=checked(b"module main;fn Option<ref i32> f(Option<ref i32> x){return switch(x){case .some(v):{.some(v)}case .none:{.none}};}",b"");emit(10,ref p10);assert(diagnostics::exit_code(ref p10)==0);
    let p11=checked(b"module main;fn ref i32 f(Result<i32,ref i32> x){return switch(x){case .ok(a):{assert(false);}case .err(e):{e}};}",b"");emit(11,ref p11);assert(diagnostics::exit_code(ref p11)==0);
    let p12=checked(b"module main;fn ref i32 f(Option<ref i32> x,ref i32 a){let ref i32 v=a;discard switch(x){case .some(v):{discard v;0}case .none:{0}};return v;}",b"");emit(12,ref p12);assert(diagnostics::exit_code(ref p12)==0);
    let p13=checked(b"module main;fn ref i32 f(Option<ref i32> x,ref i32 a){var ref i32 r=a;discard switch(x){case .some(v):{r=v;0}case .none:{0}};return r;}",b"");emit(13,ref p13);assert(diagnostics::exit_code(ref p13)==3);
    let p14=checked(b"module main;fn ref str f(){let Option<ref str> x=.some(\"a\");return switch(x){case .some(v):{v}case .none:{\"b\"}};}",b"");emit(14,ref p14);assert(diagnostics::exit_code(ref p14)==3);
    let p15=checked(b"module main;fn ref i32 f(ref i32 a){return switch(recursive(a)){case .some(v):{v}case .none:{a}};}fn Option<ref i32> recursive(ref i32 a){return recursive(a);}",b"");emit(15,ref p15);assert(diagnostics::exit_code(ref p15)==2);
    let p16=checked(b"module main;fn ref i32 f(ref i32 a){let Option<ref i32> x=recursive(a);return switch(x){case .some(v):{v}case .none:{a}};}fn Option<ref i32> recursive(ref i32 a){return recursive(a);}",b"");emit(16,ref p16);assert(diagnostics::exit_code(ref p16)==2);
    let p17=checked(b"module main;fn ref i32 f(ref i32 a,bool c){if(c){return recurse(a);};return switch(recurse_option(a)){case .some(v):{v}case .none:{a}};}fn ref i32 recurse(ref i32 a){return recurse(a);}fn Option<ref i32> recurse_option(ref i32 a){return recurse_option(a);}",b"");emit(17,ref p17);assert(diagnostics::exit_code(ref p17)==2);
    let p18=checked(b"module main;fn ref i32 f(ref i32 a,bool c){if(c){let i32 n=1;return ref n;};return switch(recursive(a)){case .some(v):{v}case .none:{a}};}fn Option<ref i32> recursive(ref i32 a){return recursive(a);}",b"");emit(18,ref p18);assert(diagnostics::exit_code(ref p18)==3);
    let p19=checked(b"module main;fn ref i32 f(Option<ref i32> x,ref i32 a){return switch(x){case .some(_):{a}case .none:{a}};}",b"");emit(19,ref p19);assert(diagnostics::exit_code(ref p19)==0);
    let p20=checked(b"module main;import provider as p;fn ref i32 f(Option<ref i32> x){return p::extract(x);}",b"module provider;pub fn ref i32 extract(Option<ref i32> x){return switch(x){case .some(v):{v}case .none:{assert(false);}};}");emit(20,ref p20);assert(diagnostics::exit_code(ref p20)==0);
}
