module tests::generic_source_plan_input;
import generic_source_plan_input as prepared;
import generic_concrete_types as concrete;
import generic_package_context as context;
import generic_source_requests as requests;
import generic_source_dependencies as dependencies;
import generic_source_closure as closures;
import generic_source_dependency_model as model;
import generic_source_dependency_json as json;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::fs as fs;
import std::text as text;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else if(digit==3){b"3"}else{b"4"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=0;return switch(templates::build(resolved,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn ref u8[] root(){return b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}pub fn T cycle<T>(T value){return cycle<T>(value);}";}
fn ref u8[] provider(){return b"module helper;pub fn T id<T>(T value){return value;}fn T secret<T>(T value){return value;}";}
fn v::Vec<syntax::Parsed> small_sources(ref u8[] first,ref u8[] second){var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,parsed(first)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(second)).is_ok);return input;}
fn v::Vec<catalog::Binding> small_imports(){var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);return imports;}
fn v::Vec<usize> small_digits(){var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);return digits;}
fn ref u8[] source(u32 mode){
if(mode==0){return b"module root;import helper as h;import helper as a;import std::vec as vec;struct Token{i32 n;}resource Owned{i32 n;cleanup{discard h::pair<i32,i64>(1,2);}}fn vec::Vec<h::Token> echo(vec::Vec<h::Token> items){return items;}pub fn T api<T>(T value){return h::id<T>(value);}fn T unused<T>(T value){return h::id<i64>(1);}fn ref u8[] producer<T>(){return b\"\";}fn void use(ref u8[] data){discard api<i32>(1);discard h::id<i32>(1);discard a::id<i32>(2);let vec::Vec<h::Token> items=vec::empty<h::Token>();discard items;for(let u8 byte in data){discard h::id<u8>(byte);}for(let u8 byte in producer<i64>()){discard h::id<u32>(1);}}";}
if(mode==1){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value;}pub fn A pair<A,B>(A first,B second){return first;}";}
if(mode==2){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value+1;}pub fn A pair<A,B>(A first,B second){return first;}";}
return b"";
}
fn void descriptor(ref prepared::Input p,usize selected,ref u8[] wire,ref mut usize at){assert(selected!=0 && selected<=concrete::count(prepared::types(p)));let types=prepared::types(p);let row=concrete::at(types,selected-1);assert(bytes::equal(concrete::text(types,row.id),field(wire,at)) && bytes::equal(concrete::text(types,row.owner),field(wire,at)) && bytes::equal(concrete::text(types,row.definition),field(wire,at)));let count=number(wire,at);assert(concrete::ability_count(types,selected-1)==count);var usize i=0;while(i<count){assert(bytes::equal(concrete::ability_at(types,selected-1,i),field(wire,at)));i+=1;}}
@test
@effects(filesystem,console)
fn void all_source_request_and_dependency_facts_match_go(){let fixture=fixture();let wire=bytes::view(ref fixture);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGINPUT"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==4);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let total=number(wire,ref mut at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<total){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let count=number(wire,ref mut at);var usize j=0;while(j<count){let alias=field(wire,ref mut at);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,i),j+1);assert(bytes::equal(alias,syntax::source_view(v::at<syntax::Parsed>(ref sources,i))[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}
    let original=collected(ref sources,ref imports,ref digits,if(c==2){19}else{0});var context::Budget b=context::empty();let roots=switch(requests::build(original,ref sources,ref mut b.work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let input=switch(prepared::build(roots,ref sources,ref mut b)){case .ok(value):{value}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.phase);discard io::write_stderr_u32(e.source.code);assert(false);return;}};let source=prepared::templates(ref input);let data=prepared::roots(ref input);let count=number(wire,ref mut at);assert(model::edge_count(data)==count && count==12);i=0;while(i<count){let edge=model::edge_at(data,i);assert(bytes::equal(model::text(data,edge.key),field(wire,ref mut at)));let row=templates::template_at(source,edge.target-1);assert(bytes::equal(templates::text(source,row.id),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(edge.count==n);var usize j=0;while(j<n){descriptor(ref input,prepared::root_argument(ref input,edge.first+j),wire,ref mut at);j+=1;}i+=1;}
    let declarations=number(wire,ref mut at);assert(templates::count(source)==declarations);let graph=prepared::dependencies(ref input);assert(model::range_count(graph)==declarations && prepared::argument_count(ref input)==model::argument_count(graph));i=0;while(i<declarations){let row=templates::template_at(source,i);assert(bytes::equal(templates::text(source,row.id),field(wire,ref mut at)));let packages=templates::packages(source);let owner=bindings::module_at(packages,row.module_index);assert(bytes::equal(bindings::text(packages,owner.namespace),field(wire,ref mut at)) && bytes::equal(templates::text(source,row.definition),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(row.count==n);var usize j=0;while(j<n){let param=templates::parameter_at(source,row.first+j);assert(bytes::equal(templates::text(source,param.name),field(wire,ref mut at)) && param.scalar==(number(wire,ref mut at)==1));j+=1;}let range=model::range_at(graph,i);assert(range.count==number(wire,ref mut at));j=0;while(j<range.count){let edge=model::edge_at(graph,range.first+j);let target=templates::template_at(source,edge.target-1);assert(bytes::equal(templates::text(source,target.id),field(wire,ref mut at)) && edge.count==number(wire,ref mut at));var usize k=0;while(k<edge.count){let arg=prepared::argument_at(ref input,edge.first+k);if(number(wire,ref mut at)==1){assert(arg.parameter!=0 && arg.parameter<=row.count && arg.concrete==0);let param=templates::parameter_at(source,row.first+arg.parameter-1);assert(bytes::equal(templates::text(source,param.name),field(wire,ref mut at)));}else{assert(arg.parameter==0);descriptor(ref input,arg.concrete,wire,ref mut at);}k+=1;}j+=1;}i+=1;}c+=1;}assert(at==wire.len);}
fn prepared::Input detached(ref mut context::Budget b){let sources=small_sources(b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}fn void use(){discard api<i32>(1);}pub fn T cycle<T>(T value){return cycle<T>(value);}",b"module helper;pub fn U id<U>(U value){return pair<U,i64>(value,1);}fn A pair<A,B>(A value,B second){return value;}");let imports=small_imports();let digits=small_digits();let c=collected(ref sources,ref imports,ref digits,0);var usize work=0;let roots=switch(requests::build(c,ref sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return detached(b);}};return switch(prepared::build(roots,ref sources,b)){case .ok(value):{value}case .err(_):{assert(false);detached(b)}};}
@test
fn void owns_concrete_and_symbolic_arguments_after_sources_drop(){var context::Budget b=context::empty();let input=detached(ref mut b);assert(prepared::root_argument_count(ref input)==1 && prepared::argument_count(ref input)==4);let source=prepared::templates(ref input);let graph=prepared::dependencies(ref input);var usize symbols=0;var usize constants=0;var usize i=0;while(i<prepared::argument_count(ref input)){let arg=prepared::argument_at(ref input,i);if(arg.parameter!=0){symbols+=1;assert(arg.concrete==0);}else{constants+=1;assert(arg.concrete!=0 && bytes::equal(concrete::text(prepared::types(ref input),concrete::at(prepared::types(ref input),arg.concrete-1).id),b"i64"));}i+=1;}assert(symbols==3 && constants==1 && model::edge_count(graph)==3 && templates::count(source)==4);let selected=prepared::root_argument(ref input,0);assert(bytes::equal(concrete::text(prepared::types(ref input),concrete::at(prepared::types(ref input),selected-1).id),b"i32"));}
@test
fn void exact_work_encoding_and_hash_limits_fail_without_input(){var context::Budget cost=context::empty();let input=detached(ref mut cost);assert(cost.code==0 && cost.work>0 && cost.encoded_work>0 && cost.hashed_bytes>0);var context::Budget fit=context::empty();fit.work=16777216-cost.work;fit.encoded_work=context::encoding_limit()-cost.encoded_work;fit.hashed_bytes=context::hash_limit()-cost.hashed_bytes;let same=detached(ref mut fit);assert(fit.work==16777216 && fit.encoded_work==context::encoding_limit() && fit.hashed_bytes==context::hash_limit() && model::edge_count(prepared::roots(ref same))==1);
    var u32 mode=0;while(mode<4){let sources=small_sources(b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}fn void use(){discard api<i32>(1);}pub fn T cycle<T>(T value){return cycle<T>(value);}",b"module helper;pub fn U id<U>(U value){return pair<U,i64>(value,1);}fn A pair<A,B>(A value,B second){return value;}");let imports=small_imports();let digits=small_digits();let c=collected(ref sources,ref imports,ref digits,0);var usize work=0;let roots=switch(requests::build(c,ref sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};var context::Budget b=context::empty();if(mode==0){b.work=16777216-cost.work+1;}else if(mode==1){b.encoded_work=context::encoding_limit()-cost.encoded_work+1;}else if(mode==2){b.hashed_bytes=context::hash_limit()-cost.hashed_bytes+1;}else{b.code=12;}assert(switch(prepared::build(roots,ref sources,ref mut b)){case .ok(_):{false}case .err(e):{e.source.code==if(mode==3){12}else{10}}});assert(b.work<=16777216 && b.encoded_work<=context::encoding_limit() && b.hashed_bytes<=context::hash_limit());mode+=1;}}
@test
fn void rejects_stale_source_before_binding_root_catalog(){let sources=small_sources(root(),provider());let imports=small_imports();let digits=small_digits();let c=collected(ref sources,ref imports,ref digits,0);var usize work=0;let roots=switch(requests::build(c,ref sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};let changed=small_sources(root(),b"module helper;pub fn T id<T>(T value){return value+1;}");var context::Budget b=context::empty();assert(switch(prepared::build(roots,ref changed,ref mut b)){case .ok(_):{false}case .err(e):{e.phase==1 && e.source.code==12 && e.source.module_index==1}} && b.code==12);}
