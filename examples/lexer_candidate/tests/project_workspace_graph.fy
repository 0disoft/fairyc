module tests::project_workspace_graph;
import project_workspace_graph as graph;
import project_instance_graph as local;
import project_module_visibility as visibility;
import project_sdk_bundle as sdk;
import project_workspace_input as workspace;
import project_workspace_catalog as catalog;
import project_source_set as sources;
import syntax as syntax;
import file_source as files;
import std::bytes as bytes;
import std::process as process;
import std::vec as v;

fn bytes::Buffer join(ref u8[] root,ref u8[] leaf){var bytes::Buffer result=bytes::empty();assert(bytes::append(ref mut result,root).is_ok && bytes::append_byte(ref mut result,47).is_ok && bytes::append(ref mut result,leaf).is_ok);return result;}
@effects(filesystem)
fn bytes::Buffer read(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);return switch(files::load(bytes::view(ref path))){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem)
fn bytes::Buffer root(){var u8[4096] argument=[0;4096];let usize length=switch(process::arg(1,ref mut argument)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] input=ref argument;return switch(files::manifest(input[..length])){case .ok(value):{value}case .err(_):{assert(false);bytes::empty()}};}
fn usize number(ref u8[] input,usize at){assert(input.len==40 && at<5);var usize value=0;var usize index=at*8;while(index<at*8+8){value=value*256+(input[index] as usize);index+=1;}return value;}
fn void line(ref mut bytes::Buffer output,ref u8[] value){assert(bytes::append(output,value).is_ok && bytes::append_byte(output,10).is_ok);}
@effects(filesystem)
fn sdk::Bundle library(ref u8[] root,usize count,bool candidate){var v::Vec<sdk::File> input=v::empty<sdk::File>();var usize index=0;while(index<count){assert(v::push<sdk::File>(ref mut input,sdk::file(index+1,read(root,sdk::path(index)))).is_ok);index+=1;}var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;return switch(sdk::assemble(input,candidate,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return library(root,count,candidate);}};}
@effects(filesystem)
fn void accepted(ref u8[] root,ref u8[] leaf){let path=join(root,leaf);let counts=read(bytes::view(ref path),b"counts.bin");let selected=read(bytes::view(ref path),b"selection.txt");let usize profile=(bytes::view(ref selected)[0]-48) as usize;let sdk::Bundle bundle=library(root,if(profile>=2){8}else{7},profile==3);var sources::Budget budget=sources::Budget{.files=4096-number(bytes::view(ref counts),0),.bytes=67108864-number(bytes::view(ref counts),1)};var usize meter=0;
    let loaded=switch(visibility::load_sdk(bytes::view(ref path),bundle,ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};let g=visibility::workspace_graph(ref loaded);assert(budget.files==4096 && budget.bytes==67108864 && graph::node_count(g)==number(bytes::view(ref counts),2) && graph::edge_count(g)==number(bytes::view(ref counts),3) && visibility::lookup_count(ref loaded)==number(bytes::view(ref counts),4) && graph::has_sdk(g)==(profile!=0));
    var bytes::Buffer nodes=bytes::empty();var bytes::Buffer edges=bytes::empty();var bytes::Buffer lookups=bytes::empty();var usize at=0;while(at<graph::node_count(g)){line(ref mut nodes,graph::node_id(g,at));line(ref mut nodes,if(graph::is_sdk(g,at)){b"standard-library"}else if(at==0){b"root"}else{b"dependency"});if(at<graph::local_node_count(g)){assert(bytes::equal(graph::node_id(g,at),local::node_id(graph::local_graph(g),at)));}else{assert(graph::node(g,at).package_index==catalog::count(workspace::local_catalog(local::input(graph::local_graph(g)))) && graph::module_count(g,at)==if(profile>=2){8}else{7});let retained=graph::standard_library(g);assert(sdk::candidate(retained)==(profile==3));}at+=1;}let expected_nodes=read(bytes::view(ref path),b"nodes.txt");assert(bytes::equal(bytes::view(ref nodes),bytes::view(ref expected_nodes)));
    at=0;while(at<graph::edge_count(g)){let e=graph::edge(g,at);line(ref mut edges,graph::node_id(g,e.owner));line(ref mut edges,graph::binding(g,at));line(ref mut edges,graph::node_id(g,e.target));if(graph::is_sdk(g,e.target)){assert(bytes::equal(graph::binding(g,at),b"stdlib"));}at+=1;}let expected_edges=read(bytes::view(ref path),b"edges.txt");assert(bytes::equal(bytes::view(ref edges),bytes::view(ref expected_edges)));
    at=0;while(at<visibility::lookup_count(ref loaded)){let l=visibility::lookup(ref loaded,at);line(ref mut lookups,graph::node_id(g,l.owner));line(ref mut lookups,graph::module_name(g,l.owner,l.source_module));line(ref mut lookups,visibility::import_path(ref loaded,at));line(ref mut lookups,graph::node_id(g,l.provider));line(ref mut lookups,graph::module_name(g,l.provider,l.provider_module));let d=syntax::declaration_at(graph::module_parser(g,l.owner,l.source_module),l.declaration);assert(d.kind==2 && d.start<=l.start && l.start<l.end && l.end<=d.end && bytes::equal(visibility::import_path(ref loaded,at),graph::module_name(g,l.provider,l.provider_module)));at+=1;}let expected_lookups=read(bytes::view(ref path),b"lookups.txt");assert(bytes::equal(bytes::view(ref lookups),bytes::view(ref expected_lookups)));
    var v::Vec<usize> positions=v::empty<usize>();at=0;while(at<graph::node_count(g)){assert(v::push<usize>(ref mut positions,graph::node_count(g)).is_ok);at+=1;}at=0;while(at<graph::node_count(g)){let usize node=graph::build_order(g,at);assert(node<graph::node_count(g) && *v::at<usize>(ref positions,node)==graph::node_count(g));let ref mut usize slot=v::at_mut<usize>(ref mut positions,node);*slot=at;at+=1;}at=0;while(at<graph::edge_count(g)){let e=graph::edge(g,at);assert(*v::at<usize>(ref positions,e.target)<*v::at<usize>(ref positions,e.owner));at+=1;}
}
@test
@effects(filesystem)
fn void injects_one_authenticated_sdk_and_resolves_direct_and_self_imports(){let owned=root();let path=bytes::view(ref owned);accepted(path,b"None");accepted(path,b"CandidateUnused");accepted(path,b"Core");accepted(path,b"AliasCore");accepted(path,b"Vector");accepted(path,b"CandidateCore");accepted(path,b"ChildOnly");accepted(path,b"Both");accepted(path,b"ChildVector");accepted(path,b"UnreachableVector");accepted(path,b"FeatureSplit");accepted(path,b"InstanceAliases");accepted(path,b"LongTrivia");accepted(path,b"SimilarNamespaces");}
@effects(filesystem)
fn void rejected(ref u8[] root,ref u8[] leaf,usize count,bool missing){let path=join(root,leaf);var sources::Budget budget=sources::Budget{.files=17,.bytes=31};var usize meter=0;let e=switch(visibility::load_sdk(bytes::view(ref path),library(root,count,false),ref mut budget,ref mut meter)){case .ok(_):{assert(false);return;}case .err(value):{value}};assert(budget.files==17 && budget.bytes==31);if(missing){assert(visibility::load_phase(ref e)==2);let failure=visibility::visibility_error(ref e);let p=visibility::error(failure);let expected=read(bytes::view(ref path),b"path.txt");assert(p.code==1 && p.start<p.end && p.end<=visibility::error_source(failure).len && bytes::equal(visibility::error_path(failure),bytes::view(ref expected)) && graph::has_sdk(visibility::error_workspace_graph(failure)));let original=read(bytes::view(ref path),b"src/main.fy");assert(bytes::equal(bytes::view(ref original),visibility::error_source(failure)));}else{assert(visibility::load_phase(ref e)==4 && graph::error(visibility::sdk_error(ref e)).code==7 && local::node_count(graph::error_local_graph(visibility::sdk_error(ref e)))==1);}}
@test
@effects(filesystem)
fn void rejects_wrong_profiles_unknown_sdk_modules_and_work_without_counter_commit(){let owned=root();let path=bytes::view(ref owned);rejected(path,b"Core",8,false);rejected(path,b"Vector",7,false);rejected(path,b"UnknownStd",7,true);rejected(path,b"BareStd",7,true);let core=join(path,b"Core");var sources::Budget budget=sources::Budget{.files=0,.bytes=0};var usize meter=0;let loaded=switch(local::load(bytes::view(ref core),ref mut budget,ref mut meter)){case .ok(value):{value}case .err(_):{assert(false);return;}};meter=16777216;let e=switch(graph::inject(loaded,library(path,7,false),ref mut meter)){case .ok(_):{assert(false);return;}case .err(value):{value}};assert(graph::error(ref e).code==4 && local::node_count(graph::error_local_graph(ref e))==1);}
