module tests::module_state_interface;
import module_state_interface as public_state;
import module_state_layout as state;
import module_signatures as signatures;
import scanner as scanner;
import syntax as syntax;
import std::bytes as bytes;
import std::vec as v;
fn signatures::Program metadata(ref u8[] source){let b=switch(bytes::copy(source)){case .ok(b):{b}case .err(_):{assert(false);return metadata(source);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return metadata(source);}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return metadata(source);}};assert(syntax::problem_count(ref p)==0);var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,p).is_ok);return switch(signatures::build(ref input)){case .ok(p):{p}case .err(_):{assert(false);return metadata(source);}};}
fn ref u8[] source(){return b"module main;@contract_uid(\"example.\\u{74}oken\")state{cell u64 total_supply;map bytes20 u64 balances;cell bool paused;cell u32 count;cell bytes32 root;}fn i32 private(){return 42;}";}
fn bytes::Buffer prefix(ref state::Plan p,usize owner){var usize work=0;return switch(public_state::prefix(p,owner,ref mut work)){case .ok(b):{b}case .err(_):{assert(false);return prefix(p,owner);}};}
// Modes change local coordinates, canonical facts, ranges or unrelated owners.
fn state::Plan altered(ref state::Plan p,u32 mode){var bytes::Buffer names=bytes::empty();assert(bytes::append(ref mut names,state::uid(p,0)).is_ok);var row=state::at(p,0);var v::Vec<state::Field> fields=v::empty<state::Field>();var usize i=0;while(i<row.field_count){assert(bytes::append(ref mut names,state::name(p,row.field_start+i)).is_ok);var f=state::field_at(p,row.field_start+i);if(mode==2 && i==0){f.prefix[0]=0;}assert(v::push<state::Field>(ref mut fields,f).is_ok);i+=1;}if(mode==0){row.owner=7;row.module_index=99;row.declaration=37;}if(mode==1){row.hash[0]=0;}if(mode==3){row.uid_end=bytes::len(ref names)+1;}var v::Vec<state::Layout> layouts=v::empty<state::Layout>();assert(v::push<state::Layout>(ref mut layouts,row).is_ok);if(mode==4){assert(v::push<state::Layout>(ref mut layouts,row).is_ok);}if(mode==5){row.owner=9;row.hash=[0;8];row.uid_start=1048576;row.uid_end=1048577;assert(v::push<state::Layout>(ref mut layouts,row).is_ok);}return state::assemble(names,layouts,fields);}
@test
fn void v5_state_prefix_matches_actual_go_interface_encoder(){let p=metadata(source());var usize work=0;let encoded=switch(signatures::public_state_prefix(ref p,0,ref mut work)){case .ok(b):{b}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref encoded),canonical()));let empty_metadata=metadata(b"module main;@contract_uid(\"example.empty\")state{}");let empty_bytes=prefix(signatures::state_layouts(ref empty_metadata),0);assert(bytes::equal(bytes::view(ref empty_bytes),empty()));let none=metadata(b"module main;fn i32 private(){return 7;}");let no_bytes=prefix(signatures::state_layouts(ref none),0);assert(bytes::equal(bytes::view(ref no_bytes),absent()));}
@test
fn void public_state_identity_ignores_numbers_bodies_and_other_packages(){let p=metadata(source());let states=signatures::state_layouts(ref p);let original=prefix(states,0);let renumbered=altered(states,0);let rebuilt=prefix(ref renumbered,7);assert(bytes::equal(bytes::view(ref original),bytes::view(ref rebuilt)));let absent_bytes=prefix(ref renumbered,0);assert(bytes::equal(bytes::view(ref absent_bytes),absent()));let other=altered(states,5);let isolated=prefix(ref other,0);assert(bytes::equal(bytes::view(ref original),bytes::view(ref isolated)));let body=metadata(b"module other;fn i32 private(){return 91;}@contract_uid(\"example.token\")state{cell u64 total_supply;map bytes20 u64 balances;cell bool paused;cell u32 count;cell bytes32 root;}");let body_bytes=prefix(signatures::state_layouts(ref body),0);assert(bytes::equal(bytes::view(ref original),bytes::view(ref body_bytes)));let codec=metadata(b"module main;@contract_uid(\"example.token\")state{cell u64 total_supply;map bytes20 u32 balances;cell bool paused;cell u32 count;cell bytes32 root;}");let codec_bytes=prefix(signatures::state_layouts(ref codec),0);assert(!bytes::equal(bytes::view(ref original),bytes::view(ref codec_bytes)));}
@test
fn void public_state_prefix_rejects_invalid_selected_facts_and_work_exhaustion(){let p=metadata(source());let states=signatures::state_layouts(ref p);var u32 mode=1;while(mode<=4){let bad=altered(states,mode);var usize work=0;assert(switch(public_state::prefix(ref bad,0,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});mode+=1;}var usize work=1048576;assert(switch(public_state::prefix(states,0,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});assert(work==1048576);work=0;assert(switch(public_state::prefix(states,512,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});assert(work==0);}
fn ref u8[] absent(){return b"\x66\x61\x69\x72\x79\x63\x2e\x70\x75\x62\x6c\x69\x63\x2d\x69\x6e\x74\x65\x72\x66\x61\x63\x65\x00\x05\x00\x00\x00\x00\x00\x00\x00\x00";}
fn ref u8[] canonical(){return b"\x66\x61\x69\x72\x79\x63\x2e\x70\x75\x62\x6c\x69\x63\x2d\x69\x6e\x74\x65\x72\x66\x61\x63\x65\x00\x05\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0d\x65\x78\x61\x6d\x70\x6c\x65\x2e\x74\x6f\x6b\x65\x6e\x84\xd5\x56\x20\x9f\x8e\x03\xdf\xac\x19\x6a\x16\xb2\x2a\x02\xb2\x04\x4c\xcc\x36\x40\xd1\xd0\x1e\x40\xf4\x02\xfc\xa2\x55\x73\x42";}
fn ref u8[] empty(){return b"\x66\x61\x69\x72\x79\x63\x2e\x70\x75\x62\x6c\x69\x63\x2d\x69\x6e\x74\x65\x72\x66\x61\x63\x65\x00\x05\x00\x00\x00\x00\x00\x00\x00\x01\x00\x00\x00\x00\x00\x00\x00\x0d\x65\x78\x61\x6d\x70\x6c\x65\x2e\x65\x6d\x70\x74\x79\xe1\x7b\x11\x88\x02\x3e\xc4\x7d\x2f\xc5\x20\x54\x10\x26\xc4\xd2\x5d\xf0\xe6\x6b\xd1\x51\xe7\x69\xd6\xe1\xcc\x89\xc3\x30\x13\x3e";}

@test
fn void public_state_prefix_reports_partial_budget_exhaustion(){let p=metadata(source());let states=signatures::state_layouts(ref p);var usize cost=0;assert(switch(public_state::prefix(states,0,ref mut cost)){case .ok(_):{true}case .err(_):{false}});assert(cost>0 && cost<1048576);var usize fits=1048576-cost;assert(switch(public_state::prefix(states,0,ref mut fits)){case .ok(_):{true}case .err(_):{false}});assert(fits==1048576);var usize at=1048576-cost+1;while(at<1048576){var usize work=at;assert(switch(public_state::prefix(states,0,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});assert(work<=1048576);at+=17;}}
