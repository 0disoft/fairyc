fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else if(digit==3){b"3"}else{b"4"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
@effects(console)
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=0;return switch(templates::build(resolved,sources,ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem,console)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}

fn ref u8[] root(){return b"module root;import helper as a;import helper as b;import std::vec as vec;resource Owned{i32 n;cleanup{discard a::id<i32>(1);}}fn bool main(){discard a::flip<i32,bool>(1,true);discard b::flip<i32,bool>(2,false);discard a::flip<bool,i32>(true,1);let vec::Vec<a::Token> items=vec::empty<a::Token>();discard items;let Owned x=Owned{.n=1};discard x;return true;}";}
fn ref u8[] provider(){return b"module helper;pub struct Token{i32 n;}pub fn B flip<A,B>(A a,B b){return id<B>(b);}pub fn T id<T>(T value){return value;}";}
@effects(filesystem,console)
fn v::Vec<syntax::Parsed> sources(){let sdk=fixture();var v::Vec<syntax::Parsed> out=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut out,parsed(root())).is_ok && v::push<syntax::Parsed>(ref mut out,parsed(provider())).is_ok && v::push<syntax::Parsed>(ref mut out,parsed(bytes::view(ref sdk))).is_ok);return out;}
fn v::Vec<catalog::Binding> imports(){var v::Vec<catalog::Binding> out=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut out,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok && v::push<catalog::Binding>(ref mut out,catalog::Binding{.source=0,.declaration=3,.target=1}).is_ok && v::push<catalog::Binding>(ref mut out,catalog::Binding{.source=0,.declaration=4,.target=2}).is_ok);return out;}
fn v::Vec<usize> digits(){var v::Vec<usize> out=v::empty<usize>();assert(v::push<usize>(ref mut out,1).is_ok && v::push<usize>(ref mut out,2).is_ok && v::push<usize>(ref mut out,3).is_ok);return out;}
@effects(console)
fn signatures::Program signatures_for(ref v::Vec<syntax::Parsed> sources,usize shift){let bindings=imports();var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let declarations=switch(catalog::build_scoped(sources,ref owners,ref bindings)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return signatures_for(sources,shift);}};return switch(signatures::build_catalog(sources,declarations)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);signatures_for(sources,shift)}};}
@effects(console)
fn typed::Interfaces retained(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return retained(sources,metadata);}};return switch(typed::build(sources,metadata,ref bound)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);retained(sources,metadata)}};}
@effects(console)
fn plan::Plan planned(ref v::Vec<syntax::Parsed> sources,usize shift){let bindings=imports();let digits=digits();let original=collected(sources,ref bindings,ref digits,shift);var context::Budget work=context::empty();let roots=switch(requests::build(original,sources,ref mut work.work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return planned(sources,shift);}};let input=switch(prepared::build(roots,sources,ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.source.code);assert(false);return planned(sources,shift);}};return switch(plan::build(input,plan::defaults(),ref mut work.work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);planned(sources,shift)}};}
@test
@effects(filesystem,console)
fn void typed_functions_vectors_cleanup_and_calls_select_source_ids(){let sources=sources();let metadata=signatures_for(ref sources,0);let graph=retained(ref sources,ref metadata);let planned_source=planned(ref sources,0);var usize work=0;let actual=switch(selected::build(ref planned_source,ref sources,ref metadata,ref graph,ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);discard io::write_stderr_bytes(b" kind=");discard io::write_stderr_u32(e.kind);discard io::write_stderr_bytes(b" id=");discard io::write_stderr_usize(e.id);assert(false);return;}};let specialized=typed::specializations(ref graph);assert(selected::function_count(ref actual)==generics::count(specialized) && selected::type_count(ref actual)==typed::type_count(ref graph) && selected::cleanup_count(ref actual)==generics::cleanup_count(specialized));var usize i=1;var usize functions=0;var usize vectors=0;var usize cleanups=0;
while(i<=generics::count(specialized)){let instance=generics::at(specialized,i);let row=selected::function_at(ref actual,i);if(instance.argument_count==0){assert(row.node==0 && selected::identity(ref actual,row).len==0);}else{assert(row.node!=0);let node=plan::at(ref planned_source,row.node-1);let template=templates::template_at(prepared::templates(plan::input(ref planned_source)),node.template_index);assert(template.module_index==instance.module_index && template.declaration+1==instance.declaration && node.count==instance.argument_count && bytes::equal(selected::identity(ref actual,row),plan::text(ref planned_source,node.id)));var usize j=0;while(j<node.count){let id=generics::argument_at(specialized,instance.argument_start+j);let expected=concrete::at(prepared::types(plan::input(ref planned_source)),node.arguments[j]-1);let original=typed::type_at(ref graph,id);assert(original.kind==expected.kind && (if(original.kind==1){original.scalar==expected.scalar}else{original.module_index==expected.module_index && original.declaration==expected.declaration}));j+=1;}functions+=1;}i+=1;}
i=1;while(i<=typed::type_count(ref graph)){let t=typed::type_at(ref graph,i);let row=selected::type_at(ref actual,i);if(t.kind==13){assert(row.node!=0);let node=plan::at(ref planned_source,row.node-1);let template=templates::template_at(prepared::templates(plan::input(ref planned_source)),node.template_index);assert(template.kind==6 && template.module_index==t.module_index && template.declaration+1==t.declaration);vectors+=1;}else{assert(row.node==0);}i+=1;}
i=1;while(i<=generics::cleanup_count(specialized)){let item=generics::cleanup_at(specialized,i);let row=selected::cleanup_at(ref actual,i);if(item.argument_count!=0){assert(row.node==selected::type_at(ref actual,item.type).node);cleanups+=1;}else{assert(row.node==0);}i+=1;}
i=1;var usize calls=0;var usize aliases=0;var usize first=0;while(i<=generics::call_count(specialized)){let call=generics::call_at(specialized,i);if(call.instance!=0){let row=selected::function_at(ref actual,call.instance);assert(row.node!=0);if(generics::at(specialized,call.instance).argument_count==2){if(aliases==0){first=row.node;}if(aliases==1){assert(first==row.node);}aliases+=1;}calls+=1;}i+=1;}assert(functions==5 && vectors==6 && cleanups==1 && calls==5 && aliases==3);}
@test
@effects(filesystem,console)
fn void stale_sources_owners_and_exact_work_limits_fail_closed(){var sources=sources();let metadata=signatures_for(ref sources,0);let graph=retained(ref sources,ref metadata);let planned_source=planned(ref sources,0);var usize measured=0;assert(switch(selected::build(ref planned_source,ref sources,ref metadata,ref graph,ref mut measured)){case .ok(_):{true}case .err(_):{false}});assert(measured>0 && measured<16777216);var usize work=16777216-measured;assert(switch(selected::build(ref planned_source,ref sources,ref metadata,ref graph,ref mut work)){case .ok(_):{true}case .err(_):{false}} && work==16777216);work=16777216-measured+1;assert(switch(selected::build(ref planned_source,ref sources,ref metadata,ref graph,ref mut work)){case .ok(_):{false}case .err(e):{e.code==10}});let other=signatures_for(ref sources,19);work=0;assert(switch(selected::build(ref planned_source,ref sources,ref other,ref graph,ref mut work)){case .ok(_):{false}case .err(e):{e.code==9}});let changed=parsed(b"module helper;pub struct Token{i64 n;}pub fn B flip<A,B>(A a,B b){return id<B>(b);}pub fn T id<T>(T value){return value;}");let sdk=fixture();var v::Vec<syntax::Parsed> updated=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut updated,parsed(root())).is_ok);assert(v::push<syntax::Parsed>(ref mut updated,changed).is_ok);assert(v::push<syntax::Parsed>(ref mut updated,parsed(bytes::view(ref sdk))).is_ok);let refreshed=signatures_for(ref updated,0);work=0;assert(switch(selected::build(ref planned_source,ref updated,ref refreshed,ref graph,ref mut work)){case .ok(_):{false}case .err(e):{e.code==12}});}
@effects(filesystem,console)
fn selected::Selection detached(){let sources=sources();let metadata=signatures_for(ref sources,0);let graph=retained(ref sources,ref metadata);let planned_source=planned(ref sources,0);var usize work=0;return switch(selected::build(ref planned_source,ref sources,ref metadata,ref graph,ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_u32(e.code);discard io::write_stderr_bytes(b" kind=");discard io::write_stderr_u32(e.kind);discard io::write_stderr_bytes(b" id=");discard io::write_stderr_usize(e.id);assert(false);detached()}};}
@test
@effects(filesystem,console)
fn void selected_id_bytes_survive_all_original_owners(){let actual=detached();var usize i=1;var usize nonempty=0;while(i<=selected::function_count(ref actual)){let row=selected::function_at(ref actual,i);let id=selected::identity(ref actual,row);if(row.node!=0){assert(id.len==67 && bytes::equal(id[..3],b"g0_"));nonempty+=1;}else{assert(id.len==0);}i+=1;}assert(nonempty==5);}
