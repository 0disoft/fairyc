module tests::module_unit_storage;
import module_unit_values as values;
import module_unit_value_model as model;
import module_unit_call_closure as closure;
import module_unit_bind as binding;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::process as process;
import file_source as files;
import module_types as types;
import module_unit_value_storage as storage;
import module_unit_interfaces as interfaces;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn Result<values::Plan,model::Problem> projected(ref v::Vec<syntax::Parsed> sources,usize first,usize stop){let metadata=switch(signatures::build(sources)){case .ok(m):{m}case .err(p):{return .err(model::Problem{.code=p.code,.module_index=p.module_index,.start=p.start,.end=p.end,.expected=0,.actual=0});}};let bound=switch(binding::bind(sources,ref metadata,first,stop)){case .ok(b):{b}case .err(p):{return .err(model::Problem{.code=p.code,.module_index=p.module_index,.start=p.start,.end=p.end,.expected=0,.actual=0});}};let ready=switch(closure::build(sources,ref metadata,ref bound)){case .ok(p):{p}case .err(p):{return .err(model::Problem{.code=p.code,.module_index=p.module_index,.start=p.start,.end=p.end,.expected=0,.actual=0});}};return values::build(sources,ref metadata,ref ready);}
fn Result<values::Plan,model::Problem> checked(ref u8[] text){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);return projected(ref sources,0,1);}
fn void failure(ref u8[] text,u32 code,ref u8[] at){switch(checked(text)){case .ok(_):{assert(false);}case .err(p):{assert(p.code==code && p.module_index==0 && bytes::equal(text[p.start..p.end],at));}};}

@effects(filesystem) fn bytes::Buffer sdk(){var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let usize n=switch(process::arg(1,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};return switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem,console) fn values::Plan planned(ref u8[] text){let sdk=sdk();var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref sdk))).is_ok);return switch(projected(ref sources,0,1)){case .ok(p):{p}case .err(p):{discard io::write_u32(p.code);discard io::write(" at ");discard io::write_usize(p.start);discard io::write(".. ");discard io::write_usize(p.end);discard io::write("\n");assert(false);return planned(b"module main;");}};}
fn void storage_facts(ref values::Plan p,ref mut u32 mask){var usize i=0;while(i<values::count(p)){let c=values::at(p,i);var usize j=1;while(j<=model::expression_count(c)){let e=model::expression_at(c,j);if(e.kind==6 && e.builtin.kind>=101 && e.builtin.kind<=107){assert(e.state==1 && e.type!=0 && e.builtin.element!=0 && model::frame(c).module_index==1);let u32 bit=e.builtin.kind-101;*mask=*mask | (1<<bit);assert(e.builtin.kind<=102 || e.builtin.unsafe_context);let t=values::type_at(p,e.type);if(e.builtin.kind<=102){assert(t.kind==1 && t.scalar==5 && e.place.root==0);}else if(e.builtin.kind==103){assert(e.type==e.builtin.element && e.place.root==0);}else if(e.builtin.kind==104){assert(t.kind==1 && t.scalar==7 && e.place.root==0);}else if(e.builtin.kind==105){assert(t.kind==12 && e.place.root==0);}else{assert(e.place.root==1 && e.place.indirect && !e.place.borrowable && e.place.mutable==(e.builtin.kind==107));assert(if(e.builtin.slice){t.kind==10 || t.kind==11 || t.kind==15 || t.kind==17 || t.kind==18}else{t.kind==7 || t.kind==8});}}j+=1;}i+=1;}}
@test @effects(filesystem,console) fn void scalar_storage_operations_have_canonical_types_and_original_owners(){
    let p=planned(b"module main;import std::vec as v;fn void main(){var v::Vec<i64> x=v::empty<i64>();discard v::push<i64>(ref mut x,4000000000);let ref i64 a=v::at<i64>(ref x,0);discard a;let ref mut i64 b=v::at_mut<i64>(ref mut x,0);discard b;discard v::pop<i64>(ref mut x);}");var u32 mask=0;storage_facts(ref p,ref mut mask);assert(mask==127);
}
@test @effects(filesystem,console) fn void scalar_and_nominal_views_keep_element_specializations(){
    let p=planned(b"module main;import std::vec as v;struct Token{i64[2] n;}fn void main(){var v::Vec<Token> x=v::empty<Token>();let ref Token[] a=v::view<Token>(ref x);discard a;let ref mut Token[] b=v::view_mut<Token>(ref mut x);discard b;var v::Vec<i64> y=v::empty<i64>();let ref i64[] c=v::view<i64>(ref y);discard c;let ref mut i64[] d=v::view_mut<i64>(ref mut y);discard d;}");var u32 mask=0;storage_facts(ref p,ref mut mask);assert((mask & 99)==99);var usize count=0;var usize i=0;while(i<values::count(ref p)){let c=values::at(ref p,i);var usize j=1;while(j<=model::expression_count(c)){let e=model::expression_at(c,j);if(e.kind==6 && storage::borrow(e.builtin) && e.builtin.slice){let t=values::type_at(ref p,e.type);let element=values::type_at(ref p,e.builtin.element);if(element.kind==2){assert(t.kind==17 || t.kind==18);assert(t.first==e.builtin.element);}else{assert(element.kind==1 && element.scalar==2 && t.kind==15);}count+=1;}j+=1;}i+=1;}assert(count==4);
}
@test @effects(filesystem,console) fn void moved_resource_storage_and_cleanup_take_keep_nominal_identity(){
    let p=planned(b"module main;import std::vec as v;resource Item{i32 n;cleanup{}}fn void main(){var v::Vec<Item> x=v::empty<Item>();discard v::push<Item>(ref mut x,Item{.n=1});discard v::pop<Item>(ref mut x);}");var u32 mask=0;storage_facts(ref p,ref mut mask);assert((mask & 15)==15);var usize count=0;var usize i=0;while(i<values::count(ref p)){let c=values::at(ref p,i);var usize j=1;while(j<=model::expression_count(c)){let e=model::expression_at(c,j);if(e.kind==6 && e.builtin.kind==103){assert(values::type_at(ref p,e.type).kind==3 && e.type==e.builtin.element);count+=1;}j+=1;}i+=1;}assert(count>=2);
}
@test fn void user_modules_cannot_acquire_sdk_private_storage(){failure(b"module main;fn usize main(){return storage_size<i32>();}",5,b"storage_size");failure(b"module std::vec;fn usize main(){return storage_size<i32>();}",6801,b"std::vec");}

@test @effects(filesystem) fn void storage_consumer_rejects_malformed_arity_types_and_missing_unsafe_at_original_spans(){
    let sdk=sdk();var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import std::vec as v;fn ref mut i32 main(ref mut v::Vec<i32> x){return v::at_mut<i32>(x,0);}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref sdk))).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(m):{m}case .err(_):{assert(false);return;}};assert(!signatures::sdk_vector_source(ref metadata,0) && signatures::sdk_vector_source(ref metadata,1) && !signatures::sdk_vector_source(ref metadata,2));let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return;}};let ready=switch(closure::build(ref sources,ref metadata,ref bound)){case .ok(r):{r}case .err(_):{assert(false);return;}};let p=switch(values::build(ref sources,ref metadata,ref ready)){case .ok(p):{p}case .err(_):{assert(false);return;}};
    var usize context=0;var usize call=0;var usize i=0;while(i<values::count(ref p)){let c=values::at(ref p,i);var usize j=1;while(j<=model::expression_count(c)){if(model::expression_at(c,j).kind==6 && model::expression_at(c,j).builtin.kind==107){context=i;call=j;}j+=1;}i+=1;}assert(call!=0);let c=values::at(ref p,context);let original=model::expression_at(c,call);let frame=model::frame(c);let source=v::at<syntax::Parsed>(ref sources,frame.module_index);var usize mutation=0;
    while(mutation<5){var v::Vec<model::Expression> expressions=v::empty<model::Expression>();var v::Vec<types::Type> graph=v::empty<types::Type>();i=1;while(i<=model::expression_count(c)){assert(v::push<model::Expression>(ref mut expressions,model::expression_at(c,i)).is_ok);i+=1;}i=1;while(i<=values::type_count(ref p)){assert(v::push<types::Type>(ref mut graph,values::type_at(ref p,i)).is_ok);i+=1;}let atoms=model::atoms(ref graph);
        if(mutation==0){let slot=v::at_mut<model::Expression>(ref mut expressions,call-1);slot.builtin.unsafe_context=false;}else if(mutation==1){let slot=v::at_mut<model::Expression>(ref mut expressions,call-1);slot.right=0;}else if(mutation==4){let slot=v::at_mut<model::Expression>(ref mut expressions,call-1);slot.builtin.element=model::atom(ref atoms,7);}else{let usize child=model::index(ref expressions,syntax::call_argument(source,original.source_index,if(mutation==2){1}else{0}));assert(child!=0);let slot=v::at_mut<model::Expression>(ref mut expressions,child-1);slot.type=model::atom(ref atoms,6);}
        var usize work=0;let problem=storage::evaluate(source,frame,call,original.expected,closure::imported(ref ready),ref mut graph,ref atoms,ref mut expressions,ref mut work,0);assert(problem.code==if(mutation==0){5101}else{2} && problem.start==original.start && problem.end==original.end && problem.module_index==frame.module_index);mutation+=1;
    }
}
