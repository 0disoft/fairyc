module tests::project_cache_specializations;
import project_cache_specializations as selected;
import project_compiler_core as core;
import module_public_type_text as coordinates;
import module_catalog as catalog;
import module_project_identified_ir as checked;
import module_unit_body_ir_model as ir;
import module_unit_cleanup_mir_model as clean;
import scanner as scanner;
import syntax as syntax;
import std::fs as fs;
import std::text as text;
import std::process as process;
import std::io as io;
import std::bytes as bytes;
import std::vec as v;

fn ref u8[] root(usize mode){if(mode==0){return b"module root;import helper as a;fn T unused<T>(T x){return x;}fn i32 main(){return 42;}";}if(mode==1){return b"module root;import helper as a;import helper as b;resource Owned{i32 n;cleanup{discard a::id<i64>(1);}}fn i32 constant<T>(){return 42;}fn i32 main(){discard constant<u16>();discard constant<u64>();let Owned x=Owned{.n=1};discard x;discard a::id<i32>(1);return b::id<i32>(42);}";}if(mode==3){return b"module root;import helper as a;import helper as b;import std::vec as v;resource Owned{i32 n;cleanup{discard a::id<i64>(1);}}fn i32 main(){var v::Vec<Owned> items=v::empty<Owned>();let Owned x=Owned{.n=42};discard v::push<Owned>(ref mut items,x);return b::id<i32>(42);}";}return b"module root;import helper as a;import helper as b;import std::vec as v;fn i32 main(){var v::Vec<i32> items=v::empty<i32>();discard v::push<i32>(ref mut items,a::id<i32>(1));return b::id<i32>(42);}pub fn void expose(ref v::Vec<i64> other){discard other;}";}
fn ref u8[] provider(){return b"module helper;pub fn T id<T>(T value){return value;}pub fn T never<T>(T value){return value;}";}
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(b):{b}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);return parsed(raw);}};}
fn usize number(ref u8[] data,ref mut usize at){assert(*at<=data.len && data.len-*at>=8);var usize value=0;var usize i=0;while(i<8){value=value*256+data[*at] as usize;*at+=1;i+=1;}return value;}
fn ref u8[] field(ref u8[] data,ref mut usize at){let n=number(data,at);assert(*at<=data.len && n<=data.len-*at);let start=*at;*at+=n;return data[start..*at];}
@effects(filesystem,environment)
fn bytes::Buffer fixture(){var u8[4096] raw=[0;4096];let n=switch(process::arg(1,ref mut raw)){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};let ref u8[] view=ref raw;let path=switch(text::validate_utf8(view[..n])){case .ok(p):{p}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(path)){case .ok(f):{f}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer output=bytes::empty();assert(bytes::resize_zeroed(ref mut output,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut output)[used..])){case .ok(n):{n}case .err(_):{assert(false);return output;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut output,used).is_ok);return output;}
fn coordinates::Coordinates table(usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize owner=1;while(owner<=3){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize at=0;while(at<64){assert(bytes::append(ref mut names,if(owner==1){b"1"}else if(owner==2){b"2"}else{b"3"}).is_ok);at+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=owner+shift,.start,.end=bytes::len(ref names)}).is_ok);owner+=1;}return coordinates::assemble(names,rows);}
@effects(console)
fn core::Complete complete(ref u8[] data,ref mut usize at,usize shift){let count=number(data,at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<count){let owner=number(data,at);let raw=field(data,at);assert(v::push<usize>(ref mut owners,owner+shift).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok);let n=number(data,at);var usize j=0;while(j<n){let alias=field(data,at);let target=number(data,at);let p=v::at<syntax::Parsed>(ref sources,i);let d=syntax::declaration_at(p,j+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target}).is_ok);j+=1;}i+=1;}let coords=table(shift);var usize source_work=0;var usize link_work=0;return switch(core::build_complete_sources(ref sources,ref owners,ref imports,ref coords,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("complete phase/code ");discard io::write_stderr_u32(e.phase);discard io::write_stderr("/");discard io::write_stderr_u32(e.code);discard io::write_stderr("\n");assert(false);return complete(data,at,shift);}};}
fn selected::Selection collect(ref core::Complete p,usize owner,ref mut usize work){return switch(selected::collect(p,owner,work)){case .ok(s):{s}case .err(_):{assert(false);return collect(p,owner,work);}};}
fn core::Complete simple(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();let imports=v::empty<catalog::Binding>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;fn i32 constant<T>(){return 42;}fn i32 main(){discard constant<u16>();return constant<u64>();}")).is_ok && v::push<usize>(ref mut owners,1).is_ok);let coords=table(0);var usize source_work=0;var usize link_work=0;return switch(core::build_complete_sources(ref sources,ref owners,ref imports,ref coords,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(_):{assert(false);return simple();}};}
@test @effects(filesystem,environment,console)
fn void emitted_package_specializations_match_actual_go_scalar_and_sdk_graphs(){
    let f=fixture();let data=bytes::view(ref f);assert(data.len>=16 && bytes::equal(data[..8],b"FYCSPC01"));var usize at=8;assert(number(data,ref mut at)==5);var usize mode=0;var usize compared=0;
    while(mode<5){let label=field(data,ref mut at);let p=complete(data,ref mut at,19);let n=number(data,ref mut at);var usize i=0;while(i<n){let owner=number(data,ref mut at);let expected=number(data,ref mut at);var usize work=0;let s=collect(ref p,owner+19,ref mut work);if(selected::count(ref s)!=expected){discard io::write_stderr_bytes(label);discard io::write_stderr(" owner/expected/actual ");discard io::write_stderr_usize(owner);discard io::write_stderr("/");discard io::write_stderr_usize(expected);discard io::write_stderr("/");discard io::write_stderr_usize(selected::count(ref s));discard io::write_stderr("\n");}assert(selected::owner(ref s)==owner+19 && selected::count(ref s)==expected);let copies=switch(selected::copy_ids(ref s,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(v::len<bytes::Buffer>(ref copies)==expected);var usize j=0;while(j<expected){let id=field(data,ref mut at);if(!bytes::equal(selected::at(ref s,j),id)){discard io::write_stderr_bytes(label);discard io::write_stderr_usize(owner);discard io::write_stderr_bytes(selected::at(ref s,j));discard io::write_stderr_bytes(id);}assert(bytes::equal(selected::at(ref s,j),id) && bytes::equal(bytes::view(v::at<bytes::Buffer>(ref copies,j)),id));j+=1;compared+=1;}if(mode==0){assert(expected==0);}if(mode==1 && owner==1){assert(expected==2);}i+=1;}mode+=1;}assert(at==data.len && compared>20);
}
@test
fn void detached_selection_keeps_phantom_instances_distinct(){var usize work=0;let s={let p=simple();collect(ref p,1,ref mut work)};assert(selected::count(ref s)==2 && selected::owner(ref s)==1 && !bytes::equal(selected::at(ref s,0),selected::at(ref s,1)));let copies=switch(selected::copy_ids(ref s,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(v::len<bytes::Buffer>(ref copies)==2 && bytes::equal(bytes::view(v::at<bytes::Buffer>(ref copies,0)),selected::at(ref s,0)));}
@test
fn void unknown_owners_and_exact_shared_work_reject_without_partial_selection(){let p=simple();var usize cost=0;let s=collect(ref p,1,ref mut cost);assert(cost>0 && cost<16777216);var usize work=16777216-cost;let fit=collect(ref p,1,ref mut work);assert(work==16777216 && selected::count(ref fit)==selected::count(ref s) && bytes::equal(selected::at(ref fit,0),selected::at(ref s,0)));work=16777216-cost+1;assert(switch(selected::collect(ref p,1,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});assert(work<=16777216);work=16777217;assert(switch(selected::collect(ref p,1,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});work=0;assert(switch(selected::collect(ref p,2,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});work=0;assert(switch(selected::collect(ref p,512,ref mut work)){case .ok(_):{false}case .err(code):{code==9}} && work==0);work=0;assert(switch(selected::copy_ids(ref s,ref mut work)){case .ok(_):{true}case .err(_):{false}});let copy_cost=work;work=16777216-copy_cost;assert(switch(selected::copy_ids(ref s,ref mut work)){case .ok(_):{true}case .err(_):{false}} && work==16777216);work=16777216-copy_cost+1;assert(switch(selected::copy_ids(ref s,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});}
