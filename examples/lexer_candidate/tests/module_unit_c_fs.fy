module tests::module_unit_c_fs;
import module_unit_c_emit as emit;
import module_unit_body_ir_model as ir;
import module_unit_body_ir_lower as lower;
import module_unit_body_ir_verify as proof;
import module_unit_cleanup_mir_model as clean;
import module_unit_value_model as m;
import module_unit_region_model as regions;
import module_unit_values as values;
import module_unit_moves as moves;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import scanner as scanner;
import syntax as syntax;
import file_source as files;
import std::bytes as bytes;
import std::vec as v;
import std::process as process;
import std::io as io;
import std::fs as fs;
import std::text as text;

fn syntax::Parsed parsed(ref u8[] text){let b=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(filesystem) fn bytes::Buffer input(usize index){var bytes::Buffer path=bytes::empty();assert(bytes::resize_zeroed(ref mut path,4096).is_ok);let n=switch(process::arg(index,bytes::view_mut(ref mut path))){case .ok(n):{n}case .err(_):{assert(false);return bytes::empty();}};return switch(files::load(bytes::view(ref path)[..n])){case .ok(b):{b}case .err(_):{assert(false);bytes::empty()}};}
@effects(console) fn void error(u32 code,usize start,usize end){discard io::write_u32(code);discard io::write(" at ");discard io::write_usize(start);discard io::write("..");discard io::write_usize(end);discard io::write("\n");assert(false);}
@effects(console,filesystem) fn ir::Program retained(ref u8[] root){let text=input(1);let buffer=input(2);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(root)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref text))).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(bytes::view(ref buffer))).is_ok);
    let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let bound=switch(binding::bind(ref sources,ref metadata,0,1)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let ready=switch(closure::build(ref sources,ref metadata,ref bound)){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    let typed=switch(values::build(ref sources,ref metadata,ref ready)){case .ok(p):{p}case .err(e):{discard io::write("values ");error(e.code,e.start,e.end);return retained(root);}};
    let moved=switch(moves::build(ref sources,ref typed,values::work(ref typed))){case .ok(p):{p}case .err(e):{error(e.code,e.start,e.end);return retained(root);}};
    return switch(lower::lower(ref sources,ref typed,closure::imported(ref ready),ref moved)){case .ok(p):{p}case .err(e):{discard io::write("lower ");error(e.code,e.start,e.end);retained(root)}};
}
fn usize entry(ref ir::Program p){var usize found=0;var usize i=1;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);let result=clean::type_at(ir::cleanup_ir(p),f.result);if(f.module_index==0 && f.kind==3 && result.kind==1 && result.scalar==1){let b=ir::at(p,i);var usize j=1;var bool parameter=false;while(j<=ir::local_count(b)){if(ir::local_at(b,j).kind==1){parameter=true;}j+=1;}if(!parameter){assert(found==0);found=i;}}i+=1;}assert(found!=0);return found;}
@effects(console) fn void output(ref ir::Program p){var bytes::Buffer c=bytes::empty();let result=emit::render(p,entry(p),ref mut c);if(result.code!=0){discard io::write("C ");error(result.code,result.start,result.end);}assert(io::write_bytes(bytes::view(ref c)).is_ok);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_utf8_roundtrip_seek_and_close(){let p=retained(b"module main;import std::fs as f;@effects(filesystem) fn i32 main(){var f::File out=switch(f::create_truncate_utf8(\"file-貫.bin\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(f::write_all(ref mut out,b\"A\\0貫Z\").is_ok);assert(f::sync(ref mut out).is_ok);assert(f::close(out).is_ok);var f::File input=switch(f::open_read_utf8(\"file-貫.bin\")){case .ok(v):{v}case .err(_):{assert(false);return 1;}};assert(switch(f::size(ref input)){case .ok(n):{n==5}case .err(_):{false}});var u8[5] data=[0;5];assert(switch(f::read_exact(ref mut input,ref mut data)){case .ok(n):{n==5}case .err(_):{false}});assert(data[0]==65 && data[1]==0 && data[2]==206 && data[3]==187 && data[4]==90);assert(switch(f::position(ref mut input)){case .ok(n):{n==5}case .err(_):{false}});assert(f::seek_start(ref mut input,1).is_ok);assert(switch(f::seek_current(ref mut input,1)){case .ok(n):{n==2}case .err(_):{false}});assert(switch(f::seek_end(ref mut input,-1)){case .ok(n):{n==4}case .err(_):{false}});var u8[2] tail=[0;2];assert(switch(f::read(ref mut input,ref mut tail)){case .ok(n):{n==1}case .err(_):{false}} && tail[0]==90 && tail[1]==0);assert(switch(f::read(ref mut input,ref mut tail)){case .ok(n):{n==0}case .err(_):{false}});assert(f::close(input).is_ok);assert(f::remove_file(c\"file-貫.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_partial_eof_and_scope_cleanup(){let p=retained(b"module main;import std::fs as f;@effects(filesystem) fn i32 write(usize token){var f::File value=switch(f::create_truncate(c\"short.bin\")){case .ok(v):{v}case .err(_):{return 1;}};assert(switch(f::write(ref mut value,b\"AB\")){case .ok(n):{n==2}case .err(_):{false}});assert(f::sync(ref mut value).is_ok);return 0;}@effects(filesystem) fn i32 read(usize token){var f::File value=switch(f::open_read(c\"short.bin\")){case .ok(v):{v}case .err(_):{return 1;}};var u8[4] data=[9;4];switch(f::read_exact(ref mut value,ref mut data)){case .ok(_):{assert(false);}case .err(error):{assert(f::error_status(error)==7 && f::error_os_code(error)==0 && f::error_completed(error)==2);}};assert(data[0]==65 && data[1]==66 && data[2]==9 && data[3]==9);return 0;}@effects(filesystem) fn i32 main(){assert(write(0)==0 && read(0)==0);assert(f::remove_file(c\"short.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_open_error_and_exclusive_preservation(){let p=retained(b"module main;import std::fs as f;@effects(filesystem) fn i32 main(){switch(f::open_read(c\"missing.bin\")){case .ok(_):{assert(false);}case .err(error):{assert(f::error_status(error)==1 && f::error_os_code(error)!=0 && f::error_completed(error)==0);}};switch(f::create_truncate_utf8(\"bad\\0path\")){case .ok(_):{assert(false);}case .err(error):{assert(f::error_status(error)==2 && f::error_os_code(error)==0);}};var f::File first=switch(f::create_new(c\"exclusive.bin\")){case .ok(v):{v}case .err(_):{return 1;}};assert(f::write_all(ref mut first,b\"KEEP\").is_ok);assert(f::close(first).is_ok);switch(f::create_new(c\"exclusive.bin\")){case .ok(_):{assert(false);}case .err(error):{assert(f::error_status(error)==1 && f::error_os_code(error)!=0);}};var f::File value=switch(f::open_read(c\"exclusive.bin\")){case .ok(v):{v}case .err(_):{return 1;}};var u8[4] data=[0;4];assert(f::read_exact(ref mut value,ref mut data).is_ok && data[0]==75 && data[3]==80);assert(f::close(value).is_ok && f::remove_file(c\"exclusive.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_replace_and_append(){let p=retained(b"module main;import std::fs as f;@effects(filesystem) fn i32 store(ref CStr path,ref u8[] data){var f::File value=switch(f::create_truncate(path)){case .ok(v):{v}case .err(_):{return 1;}};assert(f::write_all(ref mut value,data).is_ok && f::sync(ref mut value).is_ok);assert(f::close(value).is_ok);return 0;}@effects(filesystem) fn i32 main(){assert(store(c\"saved.bin\",b\"OLD\")==0 && store(c\"replacement.bin\",b\"NEW\")==0);assert(f::replace_file(c\"replacement.bin\",c\"saved.bin\").is_ok);var f::File append=switch(f::open_append(c\"saved.bin\")){case .ok(v):{v}case .err(_):{return 1;}};assert(f::write_all(ref mut append,b\"!\").is_ok);assert(f::close(append).is_ok);var f::File value=switch(f::open_read(c\"saved.bin\")){case .ok(v):{v}case .err(_):{return 1;}};var u8[4] data=[0;4];assert(f::read_exact(ref mut value,ref mut data).is_ok && data[0]==78 && data[1]==69 && data[2]==87 && data[3]==33);assert(f::close(value).is_ok);switch(f::open_read(c\"replacement.bin\")){case .ok(_):{assert(false);}case .err(error):{assert(f::error_status(error)==1);}};assert(f::remove_file(c\"saved.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_buffer_read_to_end(){let p=retained(b"module main;import std::fs as f;import std::bytes as b;@effects(filesystem) fn i32 main(){var f::File output=switch(f::create_truncate(c\"buffer.bin\")){case .ok(v):{v}case .err(_):{return 1;}};assert(f::write_all(ref mut output,b\"A\\0貫Z\").is_ok);assert(f::close(output).is_ok);var f::File input=switch(f::open_read(c\"buffer.bin\")){case .ok(v):{v}case .err(_):{return 1;}};var b::Buffer data=switch(b::copy(b\"P\")){case .ok(v):{v}case .err(_):{return 1;}};assert(switch(f::read_append(ref mut input,ref mut data,2)){case .ok(n):{n==2}case .err(_):{false}});assert(switch(f::read_to_end(ref mut input,ref mut data)){case .ok(n):{n==3}case .err(_):{false}});let ref u8[] view=b::view(ref data);assert(view.len==6 && view[0]==80 && view[1]==65 && view[2]==0 && view[3]==206 && view[4]==187 && view[5]==90);assert(f::close(input).is_ok && f::remove_file(c\"buffer.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_buffer_failure_preserves_cursor(){let p=retained(b"module main;import std::fs as f;import std::bytes as b;@effects(filesystem) fn i32 main(){var f::File output=switch(f::create_truncate(c\"failure.bin\")){case .ok(v):{v}case .err(_):{return 1;}};assert(f::write_all(ref mut output,b\"AB\").is_ok);assert(f::close(output).is_ok);var f::File input=switch(f::open_read(c\"failure.bin\")){case .ok(v):{v}case .err(_):{return 1;}};var b::Buffer data=switch(b::copy(b\"P\")){case .ok(v):{v}case .err(_):{return 1;}};switch(f::read_append(ref mut input,ref mut data,65536)){case .ok(_):{assert(false);}case .err(error):{assert(f::read_append_error_file_status(error)==0 && f::read_append_error_os_code(error)==0 && f::read_append_error_allocation_status(error)==1);}};assert(b::len(ref data)==1 && b::view(ref data)[0]==80);assert(switch(f::position(ref mut input)){case .ok(n):{n==0}case .err(_):{false}});var u8[2] original=[0;2];assert(f::read_exact(ref mut input,ref mut original).is_ok && original[0]==65 && original[1]==66);assert(f::close(input).is_ok && f::remove_file(c\"failure.bin\").is_ok);return 0;}");output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_rename_preserves_paths_and_live_owner(){let root=input(3);let p=retained(bytes::view(ref root));output(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_hard_link_shared_writes_and_alias_survival(){let root=input(3);let p=retained(bytes::view(ref root));output(ref p);}
// Large generated C travels through a file without changing console bounds.
@effects(console,filesystem) fn void output_file(ref ir::Program p){
    var bytes::Buffer c=bytes::empty();let result=emit::render(p,entry(p),ref mut c);
    if(result.code!=0){discard io::write("C ");error(result.code,result.start,result.end);}
    var u8[4096] path=[0;4096];let n=switch(process::arg(4,ref mut path)){case .ok(n):{n}case .err(_):{assert(false);return;}};
    let name=switch(text::validate_utf8(ref path[..n])){case .ok(s):{s}case .err(_):{assert(false);return;}};
    var file=switch(fs::create_truncate_utf8(name)){case .ok(f):{f}case .err(_):{assert(false);return;}};
    assert(switch(fs::write_all(ref mut file,bytes::view(ref c))){case .ok(n):{n==bytes::len(ref c)}case .err(_):{false}});
    assert(fs::close(file).is_ok);discard io::write_usize(bytes::len(ref c));discard io::write("\n");
}
@test @effects(console,filesystem) fn void sdk_c_executes_file_copy_bytes_count_and_destination_preservation(){let root=input(3);let p=retained(bytes::view(ref root));output_file(ref p);}
@test @effects(console,filesystem) fn void sdk_c_executes_file_metadata_readonly_links_and_allocation(){let root=input(3);let p=retained(bytes::view(ref root));output_file(ref p);}
