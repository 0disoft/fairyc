fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(){var v::Vec<usize> p=v::empty<usize>();assert(v::push<usize>(ref mut p,1).is_ok);return p;}
fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn core::Complete compiled(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;var usize linked=0;return switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);compiled(sources)}};}
@effects(console) fn identities::Snapshot snapshot(ref identified::Program program){var usize work=0;return switch(identities::extract(identified::source_identities(program),ir::cleanup_ir(identified::ir_program(program)),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);snapshot(program)}};}
@effects(console) fn planned::Plan source_plan(ref v::Vec<syntax::Parsed> sources){let owner=owners();let imports=v::empty<catalog::Binding>();let table=table();var usize work=0;return switch(planning::build_sources(sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);source_plan(sources)}};}
fn v::Vec<syntax::Parsed> inputs(bool changed){return source(if(changed){b"module main;@link_name(\"artifact_other\")unsafe extern C fn i32 host(i32 n);fn i32 same<T>(){return 42;}fn i32 read(ref i32 n){return *n;}fn i32 other(ref i32 n){return *n;}fn void clean(i32 n){}resource R{i32 n;cleanup{clean(this.n);}}fn i32 main(){let R r=R{.n=1};var i32 n=42;discard same<u16>();discard same<u64>();discard read(ref mut n);defer clean(.n = n);unsafe{discard host(n);};return n;}"}else{b"module main;@link_name(\"artifact_probe\")unsafe extern C fn i32 host(i32 n);fn i32 same<T>(){return 42;}fn i32 read(ref i32 n){return *n;}fn i32 other(ref i32 n){return *n;}fn void clean(i32 n){}resource R{i32 n;cleanup{clean(this.n);}}fn i32 main(){let R r=R{.n=1};var i32 n=42;discard same<u16>();discard same<u64>();discard read(ref mut n);defer clean(.n = n);unsafe{discard host(n);};return n;}"});}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);encoded(p)}};}
@effects(console) fn ir::Program restored(ref u8[] raw){var usize work=0;return switch(decoder::decode(raw,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);restored(raw)}};}
fn budget::Span body_span(ref u8[] raw,usize frame){var usize work=0;var c=switch(budget::cursor(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return body_span(raw,frame);}};discard budget::member_from(raw,ref mut c,8388608,b"FYCLEAN0",ref mut work);discard budget::member_from(raw,ref mut c,8388608,b"FYSDK000",ref mut work);discard budget::member_from(raw,ref mut c,8388608,b"FYMETA00",ref mut work);discard budget::member_from(raw,ref mut c,8388608,b"FYSTATE0",ref mut work);let count=budget::bodies_from(raw,ref mut c,ref mut work);assert(frame>0 && frame<=count);var usize i=1;while(i<=count){let span=budget::member_from(raw,ref mut c,16777216,b"FYBODY00",ref mut work);if(i==frame){return span;}i+=1;}assert(false);return budget::Span{.start=0,.end=0};}
struct Tables{usize calls;usize call_count;usize arguments;usize argument_count;}
fn Tables tables(ref u8[] raw,budget::Span span){var usize work=0;var budget::Cursor c=budget::Cursor{.offset=span.start+48,.code=0};let nodes=budget::number_from(raw,ref mut c,ref mut work);c.offset+=nodes*344;let statements=budget::number_from(raw,ref mut c,ref mut work);c.offset+=statements*96;let locals=budget::number_from(raw,ref mut c,ref mut work);c.offset+=locals*144;let call_count=budget::number_from(raw,ref mut c,ref mut work);let calls=c.offset;c.offset+=call_count*88;let argument_count=budget::number_from(raw,ref mut c,ref mut work);assert(c.code==0 && c.offset+argument_count*96<=span.end);return Tables{.calls,.call_count,.arguments=c.offset,.argument_count};}
fn void number(ref mut bytes::Buffer raw,usize at,usize input){assert(at+8<=bytes::len(raw));var bytes::Buffer octets=bytes::empty();var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(ref mut octets,input,ref mut status,ref mut work);assert(status.code==0 && bytes::len(ref octets)==8);var usize i=0;while(i<8){bytes::view_mut(raw)[at+i]=bytes::view(ref octets)[i];i+=1;}}
fn usize main_frame(ref ir::Program p){var usize i=1;while(i<=ir::count(p)){let f=clean::frame_at(ir::cleanup_ir(p),i);if(f.kind==3 && f.declaration==8){return i;}i+=1;}assert(false);return 0;}
@test @effects(console) fn void ordinary_generic_foreign_and_deferred_calls_preserve_arguments(){let sources=inputs(false);let owned=compiled(ref sources);let named=core::checked_program(ref owned);let payload=encoded(identified::ir_program(named));let program=restored(wire::content(ref payload));let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let map=switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};var usize calls=0;var usize shared=0;var usize labels=0;var usize i=0;while(i<mapping::unit_count(ref map)){let b=ir::at(ref program,mapping::mapped(ref map,i+1));calls+=ir::call_count(b);var usize j=0;while(j<ir::argument_count(b)){let a=ir::argument_at(b,j);if(a.shared){shared+=1;}if(a.label_end>a.label_start){labels+=1;}j+=1;}i+=1;}assert(calls>=6 && shared==1 && labels==1 && work>0);}
@test @effects(console) fn void valid_ir_call_mutations_reject_after_successful_body_comparison(){let sources=inputs(false);let owned=compiled(ref sources);let named=core::checked_program(ref owned);let original=identified::ir_program(named);let payload=encoded(original);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);let frame=main_frame(original);let b=ir::at(original,frame);let table=tables(wire::content(ref payload),body_span(wire::content(ref payload),frame));assert(table.call_count==ir::call_count(b) && table.argument_count==ir::argument_count(b));var usize specialized=16384;var usize second=0;var usize ordinary=16384;var usize shared=16384;var usize label=16384;var usize i=0;
    while(i<ir::call_count(b)){let c=ir::call_at(b,i);if(c.kind==2){if(specialized==16384){specialized=i;}else{second=c.instance;}}else if(c.argument_count==1 && ir::argument_at(b,c.argument_start).shared){ordinary=i;}i+=1;}i=0;while(i<ir::argument_count(b)){let a=ir::argument_at(b,i);if(a.shared){shared=i;}if(a.label_start!=0){label=i;}i+=1;}assert(specialized<16384 && second!=0 && ordinary<16384 && shared<16384 && label<16384 && second!=ir::call_at(b,specialized).instance);
    var u32 mode=0;while(mode<6){var bytes::Buffer changed=fixture::copied(wire::content(ref payload));if(mode==0){number(ref mut changed,table.calls+specialized*88+5*8,second);}else if(mode==1){number(ref mut changed,table.calls+ordinary*88+4*8,5);}else if(mode==2){number(ref mut changed,table.calls+ordinary*88+10*8,0);}else if(mode==3){number(ref mut changed,table.arguments+shared*96+11*8,0);}else if(mode==4){number(ref mut changed,table.arguments+shared*96+5*8,0);}else{number(ref mut changed,table.arguments+label*96+8*8,ir::argument_at(b,label).label_start+1);}let program=restored(bytes::view(ref changed));var usize work=0;assert(switch(matching_bodies::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{true}case .err(_):{false}});work=0;assert(switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;}
}
@test @effects(console) fn void foreign_link_changes_and_exact_or_exhausted_work_are_checked(){let sources=inputs(false);let owned=compiled(ref sources);let named=core::checked_program(ref owned);let ids=snapshot(named);let program=identified::ir_program(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,1);let plan=source_plan(ref sources);var usize work=0;let normal=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let required=work;work=budget::work_limit()-required;let exact=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work==budget::work_limit() && mapping::unit_count(ref normal)==mapping::unit_count(ref exact));work=budget::work_limit()-required+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);
    let changed=inputs(true);let new_metadata=get_metadata(ref changed);let new_checked=get_checked(ref changed,ref new_metadata,0,1);let new_plan=source_plan(ref changed);work=0;assert(switch(matching_bodies::match(program,ref ids,compile::checked_state(ref new_checked),ref new_plan,ref changed,ref new_metadata,ref mut work)){case .ok(_):{true}case .err(_):{false}});work=0;assert(switch(matching::match(program,ref ids,compile::checked_state(ref new_checked),ref new_plan,ref changed,ref new_metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});
}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_calls_match_current_units(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let p=switch(mapping::build(ref program,current::source_identities(ref rebound),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<u8> covered=v::empty<u8>();var usize i=0;while(i<mapping::count(ref p)){assert(v::push<u8>(ref mut covered,0).is_ok);i+=1;}var usize unit=0;var usize cleanups=0;var usize specialized=0;var usize changed=0;
    while(unit<v::len<syntax::Parsed>(fixture::sources(ref sources))){let checked=get_checked(fixture::sources(ref sources),ref metadata,unit,unit+1);work=0;let ids=switch(matching::match(ref program,current::source_identities(ref rebound),compile::checked_state(ref checked),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(mapping::unit_count(ref ids)==values::count(typed));i=0;while(i<values::count(typed)){let f=body::frame(values::at(typed,i));let target=mapping::mapped(ref ids,i+1);let saved=mapping::frame_at(ref p,target);if(f.kind==2){cleanups+=1;assert(saved.receiver!=0 && saved.receiver_type!=0);}if(f.kind==1){specialized+=1;}if(f.context!=saved.context){changed+=1;}let marked=v::at_mut<u8>(ref mut covered,target-1);*marked=1;i+=1;}unit+=1;
    }i=0;while(i<v::len<u8>(ref covered)){assert(*v::at<u8>(ref covered,i)==1);i+=1;}assert(unit>2 && cleanups>0 && specialized>0 && changed>0);
}

