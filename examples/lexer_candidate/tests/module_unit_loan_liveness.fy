fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
@effects(console) fn values::Plan primary(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(p):{discard io::write_u32(p.code);assert(false);return primary(sources,metadata);}};let ready=switch(closure::build(sources,metadata,ref bound)){case .ok(p):{p}case .err(p):{discard io::write_u32(p.code);assert(false);return primary(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(p):{discard io::write_u32(p.code);assert(false);primary(sources,metadata)}};}
@effects(console) fn inputs::Inputs checked(ref u8[] text){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return checked(text);}};let typed=primary(ref sources,ref metadata);return switch(input_factory::build(ref sources,ref metadata,ref typed)){case .ok(p):{p}case .err(p):{discard io::write("problem ");discard io::write_u32(p.code);discard io::write(" ");discard io::write_usize(p.start);discard io::write("\n");assert(false);checked(text)}};}
@effects(console) fn void n(usize value){discard io::write(" ");discard io::write_usize(value);}
@effects(console) fn void point(ref live::Plan p,live::Point at,usize kind){if(!at.checked){return;}discard io::write("point");n(kind);n(at.start);n(at.end);n(live::use_count(p,at));discard io::write("\n");var usize i=0;var usize previous=0;while(i<live::use_count(p,at)){let row=live::use_at(p,at,i);assert(row.local>previous && row.local<=live::local_count(p) && row.start<row.end);let local=live::local_at(p,row.local);assert(local.borrowed);discard io::write("use");n(local.start);n(local.end);n(row.start);n(row.end);discard io::write("\n");previous=row.local;i+=1;}}
// Frozen Go reference points, including empty maps and binding declaration spans.
// Inputs owns these facts after checked() releases the parsed source and typed plan.
fn live::Point find(ref live::Plan p,usize kind,usize start,usize end){var usize i=0;let count=if(kind==1){live::statement_count(p)}else{live::expression_count(p)};while(i<count){let point=if(kind==1){live::statement_at(p,i)}else{live::expression_at(p,i)};if(point.checked && point.start==start && point.end==end){return point;}i+=1;}assert(false);return live::Point{.source_index=0,.start=0,.end=0,.map=0,.checked=false};}
fn void golden(ref live::Plan p,ref usize[] wanted,ref mut usize cursor){assert(live::start(p)==wanted[*cursor] && live::end(p)==wanted[*cursor+1]);let count=wanted[*cursor+2];*cursor+=3;var usize i=0;while(i<count){let point=find(p,wanted[*cursor],wanted[*cursor+1],wanted[*cursor+2]);let uses=wanted[*cursor+3];assert(live::use_count(p,point)==uses);*cursor+=4;var usize j=0;while(j<uses){let row=live::use_at(p,point,j);let local=live::local_at(p,row.local);assert(local.start==wanted[*cursor] && local.end==wanted[*cursor+1] && row.start==wanted[*cursor+2] && row.end==wanted[*cursor+3]);*cursor+=4;j+=1;}i+=1;}}
@effects(console) fn void check_case(usize index,ref u8[] text,ref usize[] wanted){var usize cursor=0;let data=checked(text);discard io::write("case");n(index);discard io::write("\n");var usize f=1;while(f<=inputs::frame_count(ref data)){let frame=inputs::frame(ref data,f);let p=inputs::liveness(ref data,f);if(frame.value.module_index==0){golden(p,wanted,ref mut cursor);discard io::write("frame");n(live::start(p));n(live::end(p));n(live::rounds(p));discard io::write("\n");var usize i=0;while(i<live::statement_count(p)){point(p,live::statement_at(p,i),1);i+=1;}i=0;while(i<live::expression_count(p)){point(p,live::expression_at(p,i),2);i+=1;}}f+=1;}assert(cursor==wanted.len);}
