fn syntax::Parsed parsed(ref u8[] text){let tokens=switch(scanner::collect(fixture::copied(text),false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};return switch(syntax::parse(tokens,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(b"module empty;")}};}
fn v::Vec<syntax::Parsed> small(u32 mode){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(if(mode==1){b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=43,.ok=true};return read(ref p).n;}"}else if(mode==2){b"module main;@contract_uid(\"example.main\")state{cell u32 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=42,.ok=true};return read(ref p).n;}"}else{b"module main;@contract_uid(\"example.main\")state{cell u64 supply;}pub struct Pair{i32 n;bool ok;}pub fn ref Pair read(ref Pair p){return p;}fn i32 main(){let Pair p=Pair{.n=42,.ok=true};return read(ref p).n;}"})).is_ok);return sources;}
fn v::Vec<usize> owners(){var v::Vec<usize> rows=v::empty<usize>();assert(v::push<usize>(ref mut rows,1).is_ok);return rows;}
fn coordinates::Coordinates table(){let names=fixture::copied(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa");var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref names)}).is_ok);return coordinates::assemble(names,rows);}
fn catalog::Catalog scoped(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports){return switch(catalog::build_scoped(sources,owners,imports)){case .ok(p):{p}case .err(_):{assert(false);scoped(sources,owners,imports)}};}
fn signatures::Program make_metadata(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports){return switch(signatures::build_catalog(sources,scoped(sources,owners,imports))){case .ok(p):{p}case .err(_):{assert(false);make_metadata(sources,owners,imports)}};}
@effects(console) fn wire::Payload packet(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize source_work=0;var usize link_work=0;let complete=switch(core::build_complete_sources(sources,owners,imports,table,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return packet(sources,owners,imports,table);}};var usize work=0;return switch(encoder::encode(core::checked_program(ref complete),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);packet(sources,owners,imports,table)}};}
@effects(console) fn current::Rebound bound(ref u8[] raw,ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize work=0;return switch(current::build_sources(fixture::restored(raw),sources,owners,imports,table,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);bound(raw,sources,owners,imports,table)}};}
@effects(console) fn ir::Program rebased(ref current::Rebound selected){var usize work=0;return switch(rebase::build(selected,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);rebased(selected)}};}
@effects(console) fn admission::Admitted accepted(ir::Program program,ref current::Rebound selected,ref v::Vec<syntax::Parsed> sources,ref catalog::Catalog scope,ref signatures::Program metadata,ref coordinates::Coordinates table,ref mut usize work){return switch(admission::build(program,selected,sources,scope,metadata,table,work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("admission ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);accepted(rebased(selected),selected,sources,scope,metadata,table,work)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(program_encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);encoded(p)}};}
@effects(console) fn public::View viewed(ref admission::Admitted p,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref coordinates::Coordinates table,ref mut usize work){return switch(public::build_admitted(p,sources,metadata,table,work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("view ");discard io::write_stderr_u32(code);assert(false);viewed(p,sources,metadata,table,work)}};}
@effects(console) fn interfaces::Records records(ref admission::Admitted p,ref current::Rebound selected,ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,ref coordinates::Coordinates table){var usize work=0;return switch(interfaces::build_admitted(p,current::source_plan(selected),sources,metadata,table,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("records ");discard io::write_stderr_u32(code);assert(false);records(p,selected,sources,metadata,table)}};}
@test @effects(console) fn void admitted_public_views_preserve_exact_ir_and_current_field_signature_types(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let selected=bound(wire::content(ref data),ref sources,ref owners,ref imports,ref table);let scope=scoped(ref sources,ref owners,ref imports);let metadata=make_metadata(ref sources,ref owners,ref imports);var usize work=0;let p=accepted(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work);let before=encoded(admission::program(ref p));work=0;let view=viewed(ref p,ref sources,ref metadata,ref table,ref mut work);let after=encoded(admission::program(ref p));assert(bytes::equal(wire::content(ref before),wire::content(ref after)) && public::shape_count(ref view)==1 && public::field_count(ref view)==2 && public::callable_count(ref view)>0 && public::parameter_count(ref view)>0);var usize i=1;while(i<=signatures::type_count(ref metadata)){assert(public::type_at(ref view,i).kind==signatures::type_at(ref metadata,i).kind && public::type_at(ref view,i).first==signatures::type_at(ref metadata,i).first);i+=1;}let facts=records(ref p,ref selected,ref sources,ref metadata,ref table);assert(interfaces::count(ref facts)==1 && interfaces::ordinary_hash(interfaces::at(ref facts,0)).len>64);}
@test @effects(console) fn void stale_owner_coordinate_and_work_fail_before_publication(){let sources=small(0);let owners=owners();let imports=v::empty<catalog::Binding>();let table=table();let data=packet(ref sources,ref owners,ref imports,ref table);let selected=bound(wire::content(ref data),ref sources,ref owners,ref imports,ref table);let scope=scoped(ref sources,ref owners,ref imports);let metadata=make_metadata(ref sources,ref owners,ref imports);var usize work=0;let p=accepted(rebased(ref selected),ref selected,ref sources,ref scope,ref metadata,ref table,ref mut work);work=0;let normal=viewed(ref p,ref sources,ref metadata,ref table,ref mut work);let needed=work;work=16777216-needed;let exact=viewed(ref p,ref sources,ref metadata,ref table,ref mut work);assert(work==16777216 && public::field_count(ref normal)==public::field_count(ref exact));work=16777216-needed+1;assert(switch(public::build_admitted(ref p,ref sources,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(code):{code==10}});work=16777217;assert(switch(public::build_admitted(ref p,ref sources,ref metadata,ref table,ref mut work)){case .ok(_):{false}case .err(code):{code==10}} && work==16777217);let changed=small(1);let changed_metadata=make_metadata(ref changed,ref owners,ref imports);work=0;assert(switch(public::build_admitted(ref p,ref changed,ref changed_metadata,ref table,ref mut work)){case .ok(_):{false}case .err(code):{code==12}});var v::Vec<usize> other_owners=v::empty<usize>();assert(v::push<usize>(ref mut other_owners,2).is_ok);let other_metadata=make_metadata(ref sources,ref other_owners,ref imports);work=0;assert(switch(public::build_admitted(ref p,ref sources,ref other_metadata,ref table,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});let bad_names=fixture::copied(b"fypc1-sha256-bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb");var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref bad_names)}).is_ok);let bad_table=coordinates::assemble(bad_names,rows);work=0;assert(switch(public::build_admitted(ref p,ref sources,ref metadata,ref bad_table,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});}
@test @effects(filesystem,console) fn void reordered_generic_vec_state_package_hashes_match_cold_complete_and_reject_old_plan(){let data=fixture::packet();let original=fixture::current(0);let now=fixture::current(1);let sources=fixture::sources(ref now);let owners=fixture::owners(ref now);let imports=fixture::imports(ref now);let table=fixture::coordinate_table(ref now);let selected=bound(wire::content(ref data),sources,owners,imports,table);let scope=scoped(sources,owners,imports);let metadata=make_metadata(sources,owners,imports);var usize work=0;let p=accepted(rebased(ref selected),ref selected,sources,ref scope,ref metadata,table,ref mut work);work=0;let view=viewed(ref p,sources,ref metadata,table,ref mut work);var usize i=1;var usize vectors=0;while(i<=public::type_count(ref view)){if(public::type_at(ref view,i).kind==13){assert(public_names::name(public::type_names(ref view),i).len>67);vectors+=1;}i+=1;}assert(vectors>0);let saved=records(ref p,ref selected,sources,ref metadata,table);
    var usize source_work=0;var usize link_work=0;let fresh=switch(core::build_complete_sources(sources,owners,imports,table,ref mut source_work,ref mut link_work)){case .ok(p):{p}case .err(e):{discard io::write_stderr("cold ");discard io::write_stderr_u32(e.code);assert(false);return;}};let reference=core::public_interfaces(ref fresh);assert(interfaces::count(ref saved)==interfaces::count(reference));i=0;var usize templates=0;while(i<interfaces::count(reference)){let a=interfaces::at(ref saved,i);let b=interfaces::at(reference,i);assert(interfaces::owner(a)==interfaces::owner(b) && bytes::equal(interfaces::ordinary_hash(a),interfaces::ordinary_hash(b)) && bytes::equal(interfaces::source_hash(a),interfaces::source_hash(b)));let ids=interfaces::source_specializations(a);let golden=interfaces::source_specializations(b);assert(v::len<bytes::Buffer>(ids)==v::len<bytes::Buffer>(golden));var usize j=0;while(j<v::len<bytes::Buffer>(ids)){assert(bytes::equal(bytes::view(v::at<bytes::Buffer>(ids,j)),bytes::view(v::at<bytes::Buffer>(golden,j))));j+=1;}templates+=v::len<bytes::Buffer>(ids);i+=1;}assert(templates>0);
    let wrong=bound(wire::content(ref data),fixture::sources(ref original),fixture::owners(ref original),fixture::imports(ref original),fixture::coordinate_table(ref original));work=0;assert(switch(interfaces::build_admitted(ref p,current::source_plan(ref wrong),sources,ref metadata,table,ref mut work)){case .ok(_):{false}case .err(code):{code==9 || code==12}});
}
