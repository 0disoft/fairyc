module tests::module_unit_empty_cleanup;
import module_unit_body_ast as ast;
import module_unit_body_types as demands;
import module_signatures as signatures;
import module_types as types;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn syntax::Parsed source(usize count){var bytes::Buffer text=bytes::empty();assert(bytes::append(ref mut text,b"module root;resource Empty{i32 n;cleanup{}}fn i32 unrelated(){").is_ok);var usize i=0;while(i<count){assert(bytes::append(ref mut text,b"discard 1;").is_ok);i+=1;}assert(bytes::append(ref mut text,b"return 0;}").is_ok);return parsed(bytes::view(ref text));}
@test
fn void empty_cleanup_cost_and_owned_block_ignore_unrelated_arenas(){let small=source(1);let large=source(600);var usize a=0;var usize b=0;let first=switch(ast::build_cleanup(ref small,2,ref mut a)){case .ok(p):{p}case .err(_):{assert(false);return;}};let second=switch(ast::build_cleanup(ref large,2,ref mut b)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(a==1 && b==a && syntax::expression_count(ref large)>syntax::expression_count(ref small));let original=syntax::declaration_at(ref large,1);let d=ast::declaration(ref second);assert(d.kind==6 && d.start==original.start && d.end==original.end && d.cleanup_start==original.cleanup_start && d.cleanup_end==original.cleanup_end && d.cleanup_body==1 && d.body==0 && d.field_count==0 && d.result_type==0 && d.entry_count==0);assert(ast::statement_count(ref second)==1 && ast::expression_count(ref second)==0 && ast::type_count(ref second)==0 && ast::entry_count(ref second)==0 && ast::attribute_count(ref second)==0 && ast::argument_count(ref second)==0);let block=ast::statement_at(ref second,1);let expected=syntax::statement_at(ref large,original.cleanup_body);assert(block.kind==expected.kind && block.start==expected.start && block.end==expected.end && block.expression==0 && block.first==0 && block.second==0 && block.entry==0);assert(ast::statement_count(ref first)==1);b=1048575;assert(switch(ast::build_cleanup(ref large,2,ref mut b)){case .ok(_):{true}case .err(_):{false}} && b==1048576);assert(switch(ast::build_cleanup(ref large,2,ref mut b)){case .ok(_):{false}case .err(code):{code==10}});}
@test
fn void empty_demands_are_constant_and_do_not_change_type_prefix(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,source(600)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<types::Type> graph=v::empty<types::Type>();var usize i=1;while(i<=signatures::type_count(ref metadata)){assert(v::push<types::Type>(ref mut graph,signatures::type_at(ref metadata,i)).is_ok);i+=1;}let before=types::count(ref graph);let arguments=v::empty<usize>();let actual=switch(demands::collect(v::at<syntax::Parsed>(ref sources,0),ref metadata,0,2,2,1,ref arguments,ref mut graph)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(demands::count(ref actual)==0 && demands::work(ref actual)==1 && types::count(ref graph)==before);}
@test
fn void nonempty_and_attributed_cleanups_keep_original_projection(){let source=parsed(b"module root;@effects(console)resource Marked{i32 n;cleanup{}}resource Active{i32 n;cleanup{discard this.n;}}fn i32 unused(){return 1;}");var usize work=0;let marked=switch(ast::build_cleanup(ref source,2,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work>1 && ast::attribute_count(ref marked)==1 && ast::argument_count(ref marked)==1 && ast::statement_count(ref marked)==1);let saved=ast::attribute_at(ref marked,0);assert(saved.start==syntax::attribute_at(ref source,0).start && saved.argument_start==0);work=0;let active=switch(ast::build_cleanup(ref source,3,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work>1 && ast::expression_count(ref active)>0 && ast::statement_count(ref active)>1);let d=ast::declaration(ref active);let block=ast::statement_at(ref active,d.cleanup_body);assert(block.second==1 && d.field_count==0);let malformed=parsed(b"module root;fn i32 ordinary(){return 0;}");assert(switch(ast::build_cleanup(ref malformed,2,ref mut work)){case .ok(_):{false}case .err(code):{code==9}});}
