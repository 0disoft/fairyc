fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else if(digit==3){b"3"}else{b"4"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=1048576;return switch(templates::build_project(resolved,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn prepared::Input prepared_input(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let original=collected(sources,imports,digits,shift);var context::Budget b=context::empty();let roots=switch(requests::build(original,sources,ref mut b.work)){case .ok(value):{value}case .err(_):{assert(false);return prepared_input(sources,imports,digits,shift);}};return switch(prepared::build(roots,sources,ref mut b)){case .ok(value):{value}case .err(_):{assert(false);prepared_input(sources,imports,digits,shift)}};}
@effects(filesystem,console)
pub fn void verify(){missing_provider_keeps_original_root();let fixture=fixture();let wire=bytes::view(ref fixture);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPLAN1"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==4);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let total=number(wire,ref mut at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<total){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let count=number(wire,ref mut at);var usize j=0;while(j<count){let alias=field(wire,ref mut at);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,i),j+1);assert(bytes::equal(alias,syntax::source_view(v::at<syntax::Parsed>(ref sources,i))[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let input=prepared_input(ref sources,ref imports,ref digits,if(c==2){19}else{0});var usize work=0;let actual=switch(plan::build(input,plan::defaults(),ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);discard io::write_stderr_usize(e.template_index);assert(false);return;}};let count=number(wire,ref mut at);assert(plan::root_count(ref actual)==count && count==2);i=0;while(i<count){let selected=plan::root_at(ref actual,i);let node=plan::at(ref actual,selected-1);assert(bytes::equal(plan::text(ref actual,node.id),field(wire,ref mut at)));i+=1;}let nodes=number(wire,ref mut at);assert(plan::count(ref actual)==nodes && nodes==4);i=0;while(i<nodes){let selected=plan::ordered_at(ref actual,i);let node=plan::at(ref actual,selected-1);let expected_id=field(wire,ref mut at);if(!bytes::equal(plan::text(ref actual,node.id),expected_id)){discard io::write_stderr_bytes(label);discard io::write_stderr_bytes(plan::text(ref actual,node.key));discard io::write_stderr("\nexpected ");discard io::write_stderr_bytes(expected_id);discard io::write_stderr("\nactual ");discard io::write_stderr_bytes(plan::text(ref actual,node.id));assert(false);}let templates=prepared::templates(plan::input(ref actual));let row=templates::template_at(templates,node.template_index);assert(bytes::equal(templates::text(templates,row.id),field(wire,ref mut at)) && bytes::equal(plan::text(ref actual,node.key),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(node.count==n && node.state==2);var usize j=0;while(j<n){let param=templates::parameter_at(templates,row.first+j);let types=prepared::types(plan::input(ref actual));let type=concrete::at(types,node.arguments[j]-1);assert(bytes::equal(templates::text(templates,param.name),field(wire,ref mut at)) && bytes::equal(concrete::text(types,type.id),field(wire,ref mut at)));j+=1;}let edges=number(wire,ref mut at);assert(node.dependencies==edges);j=0;while(j<edges){let target=plan::dependency_at(ref actual,node.first+j);let child=plan::at(ref actual,target-1);assert(bytes::equal(plan::text(ref actual,child.id),field(wire,ref mut at)));var bool precedes=false;var usize k=0;while(k<i){if(plan::ordered_at(ref actual,k)==target){precedes=true;}k+=1;}assert(precedes);j+=1;}i+=1;}
    let templates=prepared::templates(plan::input(ref actual));let data=prepared::dependencies(plan::input(ref actual));work=0;let public=switch(public_templates::collect_records(templates,data,if(c==2){20}else{1},ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let n=number(wire,ref mut at);assert(public_model::count(ref public)==n);i=0;while(i<n){let row=public_model::at(ref public,i);assert(bytes::equal(public_model::text(ref public,row.name),field(wire,ref mut at)) && bytes::equal(public_model::text(ref public,row.closure),field(wire,ref mut at)));i+=1;}
    c+=1;}assert(at==wire.len);}

fn void missing_provider_keeps_original_root(){
    let raw=b"module root;import helper as h;fn i32 main(){return h::algorithm<i32>(21);}";
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(raw)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(b"module helper;@interface pub fn T transform<T>(T value){}@implements(transform,i64) fn i64 only64(i64 value){return value;}pub fn T algorithm<T>(T value){return transform<T>(value);}")).is_ok);
    var v::Vec<usize> owners=v::empty<usize>();var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut owners,0).is_ok && v::push<usize>(ref mut owners,1).is_ok && v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);let table=coords(ref digits,0);var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);var usize work=0;
    assert(switch(project::build_sources(ref sources,ref owners,ref imports,ref table,ref mut work)){case .ok(_):{false}case .err(e):{e.stage==5 && e.code==2004 && codes::code(5,e.stage,e.code)==4502 && e.module_index==0 && e.start<e.end && e.end<=raw.len && bytes::equal(raw[e.start..e.end],b"h::algorithm<i32>")}});
}
