module tests::generic_source_plan;
import generic_source_plan as plan;
import generic_source_plan_input as prepared;
import generic_concrete_types as concrete;
import generic_package_context as context;
import generic_source_requests as requests;
import generic_source_dependencies as dependencies;
import generic_source_closure as closures;
import generic_source_dependency_model as model;
import generic_source_dependency_json as json;
import generic_source_catalog as templates;
import generic_package_bindings as bindings;
import module_catalog as catalog;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::fs as fs;
import std::text as text;
import std::bytes as bytes;
import std::process as process;
import std::io as io;
import std::vec as v;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
fn coordinates::Coordinates coords(ref v::Vec<usize> digits,usize shift){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize i=0;while(i<v::len<usize>(digits)){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize n=0;while(n<64){let digit=*v::at<usize>(digits,i);assert(bytes::append(ref mut names,if(digit==1){b"1"}else if(digit==2){b"2"}else if(digit==3){b"3"}else{b"4"}).is_ok);n+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i+shift,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}return coordinates::assemble(names,rows);}
fn bindings::Bindings bound(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){var v::Vec<usize> owners=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut owners,i+shift).is_ok);i+=1;}let table=coords(digits,shift);var usize work=0;return switch(bindings::build(sources,ref owners,imports,ref table,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return bound(sources,imports,digits,shift);}};}
fn templates::Catalog collected(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let resolved=bound(sources,imports,digits,shift);var usize work=0;return switch(templates::build(resolved,sources,ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return collected(sources,imports,digits,shift);}};}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,1048577).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=1048576);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn ref u8[] root(){return b"module root;import helper as a;pub fn T api<T>(T value){return a::id<T>(value);}pub fn T cycle<T>(T value){return cycle<T>(value);}";}
fn ref u8[] provider(){return b"module helper;pub fn T id<T>(T value){return value;}fn T secret<T>(T value){return value;}";}
fn v::Vec<syntax::Parsed> small_sources(ref u8[] first,ref u8[] second){var v::Vec<syntax::Parsed> input=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut input,parsed(first)).is_ok && v::push<syntax::Parsed>(ref mut input,parsed(second)).is_ok);return input;}
fn v::Vec<catalog::Binding> small_imports(){var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);return imports;}
fn v::Vec<usize> small_digits(){var v::Vec<usize> digits=v::empty<usize>();assert(v::push<usize>(ref mut digits,1).is_ok && v::push<usize>(ref mut digits,2).is_ok);return digits;}
fn ref u8[] source(u32 mode){
if(mode==0){return b"module root;import helper as h;import helper as a;import std::vec as vec;struct Token{i32 n;}resource Owned{i32 n;cleanup{discard h::pair<i32,i64>(1,2);}}fn vec::Vec<h::Token> echo(vec::Vec<h::Token> items){return items;}pub fn T api<T>(T value){return h::id<T>(value);}fn T unused<T>(T value){return h::id<i64>(1);}fn ref u8[] producer<T>(){return b\"\";}fn void use(ref u8[] data){discard api<i32>(1);discard h::id<i32>(1);discard a::id<i32>(2);let vec::Vec<h::Token> items=vec::empty<h::Token>();discard items;for(let u8 byte in data){discard h::id<u8>(byte);}for(let u8 byte in producer<i64>()){discard h::id<u32>(1);}}";}
if(mode==1){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value;}pub fn A pair<A,B>(A first,B second){return first;}";}
if(mode==2){return b"module helper;pub struct Token{i32 value;}pub fn T id<T>(T value){return secret<T>(value);}fn T secret<T>(T value){return value+1;}pub fn A pair<A,B>(A first,B second){return first;}";}
return b"";
}
fn prepared::Input prepared_input(ref v::Vec<syntax::Parsed> sources,ref v::Vec<catalog::Binding> imports,ref v::Vec<usize> digits,usize shift){let original=collected(sources,imports,digits,shift);var context::Budget b=context::empty();let roots=switch(requests::build(original,sources,ref mut b.work)){case .ok(value):{value}case .err(_):{assert(false);return prepared_input(sources,imports,digits,shift);}};return switch(prepared::build(roots,sources,ref mut b)){case .ok(value):{value}case .err(_):{assert(false);prepared_input(sources,imports,digits,shift)}};}
@test
@effects(filesystem,console)
fn void complete_source_plan_ids_roots_and_order_match_go(){let fixture=fixture();let wire=bytes::view(ref fixture);assert(wire.len>16 && bytes::equal(wire[..8],b"FYGPLAN1"));var usize at=8;let cases=number(wire,ref mut at);assert(cases==4);var usize c=0;while(c<cases){let label=field(wire,ref mut at);let total=number(wire,ref mut at);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> digits=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var usize i=0;while(i<total){assert(v::push<usize>(ref mut digits,number(wire,ref mut at)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut at))).is_ok);let count=number(wire,ref mut at);var usize j=0;while(j<count){let alias=field(wire,ref mut at);let d=syntax::declaration_at(v::at<syntax::Parsed>(ref sources,i),j+1);assert(bytes::equal(alias,syntax::source_view(v::at<syntax::Parsed>(ref sources,i))[d.name_start..d.name_end]));assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=i,.declaration=j+2,.target=number(wire,ref mut at)}).is_ok);j+=1;}i+=1;}let input=prepared_input(ref sources,ref imports,ref digits,if(c==2){19}else{0});var usize work=0;let actual=switch(plan::build(input,plan::defaults(),ref mut work)){case .ok(value):{value}case .err(e):{discard io::write_stderr_bytes(label);discard io::write_stderr_u32(e.code);discard io::write_stderr_usize(e.template_index);assert(false);return;}};let count=number(wire,ref mut at);assert(plan::root_count(ref actual)==count && count==12);i=0;while(i<count){let selected=plan::root_at(ref actual,i);let node=plan::at(ref actual,selected-1);assert(bytes::equal(plan::text(ref actual,node.id),field(wire,ref mut at)));i+=1;}let nodes=number(wire,ref mut at);assert(plan::count(ref actual)==nodes && nodes==21);i=0;while(i<nodes){let selected=plan::ordered_at(ref actual,i);let node=plan::at(ref actual,selected-1);let expected_id=field(wire,ref mut at);if(!bytes::equal(plan::text(ref actual,node.id),expected_id)){discard io::write_stderr_bytes(label);discard io::write_stderr_bytes(plan::text(ref actual,node.key));discard io::write_stderr("\nexpected ");discard io::write_stderr_bytes(expected_id);discard io::write_stderr("\nactual ");discard io::write_stderr_bytes(plan::text(ref actual,node.id));assert(false);}let templates=prepared::templates(plan::input(ref actual));let row=templates::template_at(templates,node.template_index);assert(bytes::equal(templates::text(templates,row.id),field(wire,ref mut at)) && bytes::equal(plan::text(ref actual,node.key),field(wire,ref mut at)));let n=number(wire,ref mut at);assert(node.count==n && node.state==2);var usize j=0;while(j<n){let param=templates::parameter_at(templates,row.first+j);let types=prepared::types(plan::input(ref actual));let type=concrete::at(types,node.arguments[j]-1);assert(bytes::equal(templates::text(templates,param.name),field(wire,ref mut at)) && bytes::equal(concrete::text(types,type.id),field(wire,ref mut at)));j+=1;}let edges=number(wire,ref mut at);assert(node.dependencies==edges);j=0;while(j<edges){let target=plan::dependency_at(ref actual,node.first+j);let child=plan::at(ref actual,target-1);assert(bytes::equal(plan::text(ref actual,child.id),field(wire,ref mut at)));var bool precedes=false;var usize k=0;while(k<i){if(plan::ordered_at(ref actual,k)==target){precedes=true;}k+=1;}assert(precedes);j+=1;}i+=1;}c+=1;}assert(at==wire.len);}
fn prepared::Input small_input(ref u8[] raw){let sources=small_sources(raw,provider());let imports=small_imports();let digits=small_digits();return prepared_input(ref sources,ref imports,ref digits,0);}
fn plan::Plan detached_plan(ref mut usize work){let input=small_input(b"module root;import helper as a;pub fn T outer<T>(T value){discard a::id<T>(value);discard a::id<i32>(1);return a::id<T>(value);}pub fn T unused<T>(T value){return unused<T>(value);}fn void use(){discard outer<i32>(1);discard outer<i64>(2);}");return switch(plan::build(input,plan::defaults(),work)){case .ok(value):{value}case .err(_):{assert(false);return detached_plan(work);}};}
@test
fn void detached_plan_deduplicates_substituted_edges_and_shared_instances(){var usize work=0;let actual=detached_plan(ref mut work);assert(plan::root_count(ref actual)==2 && plan::count(ref actual)==4);let first=plan::at(ref actual,plan::root_at(ref actual,0)-1);let second=plan::at(ref actual,plan::root_at(ref actual,1)-1);assert(first.dependencies==1 && second.dependencies==2);var usize shared=0;var usize i=0;while(i<second.dependencies){if(plan::dependency_at(ref actual,second.first+i)==plan::dependency_at(ref actual,first.first)){shared+=1;}i+=1;}assert(shared==1 && bytes::equal(plan::text(ref actual,first.key)[plan::text(ref actual,first.key).len-5..],b"<i32>"));}
fn ref u8[] failure_source(u32 mode){if(mode==0){return b"module root;import helper as a;fn T cycle<T>(T value){return cycle<T>(value);}fn void use(){discard cycle<i32>(1);}";}if(mode==1){return b"module root;import helper as a;struct Token{i32 n;}fn T id<T>(T value){return value;}fn void use(){discard id<Token>(Token{.n=1});}";}return b"module root;import helper as a;fn T outer<T>(T value){return a::id<T>(value);}fn void use(){discard outer<i32>(1);discard outer<i64>(2);}";}
@test
fn void cycles_abilities_and_all_growth_limits_match_kernel_categories(){var u32 mode=0;while(mode<6){let input=small_input(failure_source(if(mode<2){mode}else{2}));var plan::Limits limits=plan::defaults();if(mode==2){limits.total=3;}if(mode==3){limits.per_template=1;}if(mode==4){limits.depth=1;}if(mode==5){limits.total=0;}var usize work=0;assert(switch(plan::build(input,limits,ref mut work)){case .ok(_):{false}case .err(e):{e.code==if(mode==0){2005}else if(mode==1){2003}else{2006} && e.root==if(mode==5){0}else{if(mode<2 || mode==4){1}else{2}}}});mode+=1;}}
@test
fn void plan_shares_exact_work_and_publishes_no_partial_success(){var usize cost=0;let actual=detached_plan(ref mut cost);assert(cost>0 && cost<16777216);var usize fit=16777216-cost;let same=detached_plan(ref mut fit);assert(fit==16777216 && plan::count(ref same)==4);let input=small_input(b"module root;import helper as a;pub fn T outer<T>(T value){discard a::id<T>(value);discard a::id<i32>(1);return a::id<T>(value);}pub fn T unused<T>(T value){return unused<T>(value);}fn void use(){discard outer<i32>(1);discard outer<i64>(2);}");var usize work=16777216-cost+1;assert(switch(plan::build(input,plan::defaults(),ref mut work)){case .ok(_):{false}case .err(e):{e.code==10 && e.root!=0}} && work<=16777216);}

fn prepared::Input empty_input(){let sources=small_sources(b"module root;import helper as a;fn i32 use(){return a::answer();}",b"module helper;pub fn i32 answer(){return 1;}");let imports=small_imports();let digits=small_digits();return prepared_input(ref sources,ref imports,ref digits,0);}
@test
fn void empty_plan_preserves_limits_and_rejects_invalid_initial_work(){let input=empty_input();var usize work=0;let empty=switch(plan::build(input,plan::defaults(),ref mut work)){case .ok(value):{value}case .err(_):{assert(false);return;}};assert(plan::count(ref empty)==0 && plan::root_count(ref empty)==0 && work==0);let other=empty_input();work=16777217;assert(switch(plan::build(other,plan::defaults(),ref mut work)){case .ok(_):{false}case .err(e):{e.code==10 && e.root==0}} && work==16777217);let third=empty_input();var plan::Limits limits=plan::defaults();limits.depth=0;work=0;assert(switch(plan::build(third,limits,ref mut work)){case .ok(_):{false}case .err(e):{e.code==2006 && e.root==0}});}
