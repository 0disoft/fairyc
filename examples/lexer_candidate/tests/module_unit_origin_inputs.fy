module tests::module_unit_origin_inputs;
import module_unit_origin_inputs as inputs;
import module_unit_values as values;
import module_unit_value_model as m;
import module_unit_bind as binding;
import module_unit_call_closure as closure;
import module_signatures as signatures;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;
fn syntax::Parsed parsed(ref u8[] text){let input=switch(bytes::copy(text)){case .ok(b):{b}case .err(_):{assert(false);return parsed(b"module empty;");}};let s=switch(scanner::collect(input,false,65536,1048576,256,16777216)){case .ok(s):{s}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(s,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn values::Plan primary(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata){let bound=switch(binding::bind(sources,metadata,0,1)){case .ok(b):{b}case .err(_):{assert(false);return primary(sources,metadata);}};let ready=switch(closure::build(sources,metadata,ref bound)){case .ok(p):{p}case .err(_):{assert(false);return primary(sources,metadata);}};return switch(values::build(sources,metadata,ref ready)){case .ok(p):{p}case .err(_):{assert(false);primary(sources,metadata)}};}
@test @effects(console) fn void imported_borrow_bodies_are_owned_once_with_private_call_links(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn i32 main(){let i32 n=7;let ref i32 a=p::relay(ref n);let ref i32 b=p::relay(ref n);return *a+*b;}")).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module provider;pub fn ref i32 relay(ref i32 n){return inner(n);}fn ref i32 inner(ref i32 n){return n;}" )).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let p=primary(ref sources,ref metadata);let observed=switch(inputs::build(ref sources,ref metadata,ref p)){case .ok(p):{p}case .err(e):{discard io::write_u32(e.code);discard io::write(" at ");discard io::write_usize(e.module_index);discard io::write("\n");assert(false);return;}};
    assert(inputs::provider_count(ref observed)==1 && inputs::frame_count(ref observed)==3 && inputs::owner_count(ref observed)==5 && inputs::work(ref observed)<1048576);let first=inputs::target(ref observed,1,0);let second=inputs::target(ref observed,1,1);assert(first!=0 && first==second && inputs::frame(ref observed,first).value.module_index==1);let nested=inputs::target(ref observed,first,0);assert(nested!=0 && nested!=first && inputs::frame(ref observed,nested).value.module_index==1);let owner=inputs::owner(ref observed,inputs::parameter(ref observed,first,0));assert(owner.frame==first && owner.local==1 && owner.kind==1 && owner.borrowed && owner.scope!=0);let frame=inputs::frame(ref observed,first);let source=v::at<syntax::Parsed>(ref sources,frame.value.module_index);assert(bytes::equal(syntax::source_view(source)[owner.start..owner.end],b"n"));let body=inputs::body(ref observed,ref p,first);assert(m::checked_completion(body) && m::checked_calls(body)==1);
}
@test fn void generic_instances_keep_separate_parameter_owners_and_unit_keys(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;fn ref T identity<T>(ref T n){return n;}fn void main(){let i32 n=1;let i64 big=4000000000;let ref i32 a=identity<i32>(ref n);let ref i64 b=identity<i64>(ref big);discard a;discard b;}" )).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let p=primary(ref sources,ref metadata);let observed=switch(inputs::build(ref sources,ref metadata,ref p)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(inputs::provider_count(ref observed)==0 && inputs::frame_count(ref observed)==3);let a=inputs::parameter(ref observed,1,0);let b=inputs::parameter(ref observed,2,0);assert(a!=b && inputs::owner(ref observed,a).start==inputs::owner(ref observed,b).start && inputs::owner(ref observed,a).frame!=inputs::owner(ref observed,b).frame);let main=inputs::frame(ref observed,3);assert(main.value.kind==3);let body=inputs::body(ref observed,ref p,3);var usize i=0;while(i<m::call_count(body)){let call=m::call_at(body,i);let target=inputs::frame(ref observed,inputs::target(ref observed,3,i));assert(call.kind==2 && target.unit==main.unit && target.value.kind==1 && target.value.context==call.instance && target.value.declaration==call.target_declaration);i+=1;}
}
@test fn void imported_body_type_errors_keep_provider_coordinates(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn void main(){let i32 n=1;let ref i32 a=p::bad(ref n);discard a;}" )).is_ok);let text=b"module provider;pub fn ref i32 bad(ref i32 n){return true;}";assert(v::push<syntax::Parsed>(ref mut sources,parsed(text)).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let p=primary(ref sources,ref metadata);switch(inputs::build(ref sources,ref metadata,ref p)){case .ok(_):{assert(false);}case .err(e):{assert(e.code==1009 && e.module_index==1 && bytes::equal(text[e.start..e.end],b"true"));}};
}

@test fn void colliding_generic_instance_numbers_keep_their_provider_unit(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module main;import provider as p;fn void main(){let i32 n=1;let i64 big=4000000000;let ref i32 a=p::identity<i32>(ref n);let ref i64 b=p::relay(ref big);discard a;discard b;}" )).is_ok);assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module provider;pub fn ref T identity<T>(ref T n){return n;}pub fn ref i64 relay(ref i64 n){return identity<i64>(n);}" )).is_ok);let metadata=switch(signatures::build(ref sources)){case .ok(p):{p}case .err(_):{assert(false);return;}};let p=primary(ref sources,ref metadata);let observed=switch(inputs::build(ref sources,ref metadata,ref p)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(inputs::provider_count(ref observed)==1 && inputs::frame_count(ref observed)==4);var usize root=0;var usize relay=0;var usize i=1;while(i<=inputs::frame_count(ref observed)){let f=inputs::frame(ref observed,i);if(f.value.kind==3 && f.value.module_index==0){root=i;}else if(f.value.kind==3 && f.value.module_index==1){relay=i;}i+=1;}assert(root!=0 && relay!=0);let root_target=inputs::target(ref observed,root,0);let provider_target=inputs::target(ref observed,relay,0);assert(root_target!=0 && provider_target!=0 && root_target!=provider_target);let first=inputs::frame(ref observed,root_target);let second=inputs::frame(ref observed,provider_target);assert(first.unit==0 && second.unit==1 && first.value.context==second.value.context && first.value.module_index==second.value.module_index && first.value.declaration==second.value.declaration);let a=inputs::parameter(ref observed,root_target,0);let b=inputs::parameter(ref observed,provider_target,0);assert(a!=b && inputs::owner(ref observed,a).start==inputs::owner(ref observed,b).start && inputs::owner(ref observed,a).frame!=inputs::owner(ref observed,b).frame);
}
