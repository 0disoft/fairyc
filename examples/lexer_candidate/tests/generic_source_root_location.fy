module tests::generic_source_root_location;
import generic_source_root_location as locations;
import generic_source_plan as plans;
import generic_source_plan_input as input;
import generic_source_requests as requests;
import generic_source_catalog as catalog;
import generic_package_bindings as bindings;
import generic_package_context as context;
import project_source_plan as project;
import module_catalog as modules;
import module_public_type_text as coordinates;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::fs as fs;
import std::text as text;
import std::process as process;
import std::io as io;
fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};let s=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(value):{value}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(s,512)){case .ok(value):{assert(syntax::problem_count(ref value)==0);value}case .err(_):{assert(false);parsed(raw)}};}
fn usize number(ref u8[] wire,ref mut usize at){assert(*at<=wire.len && wire.len-*at>=8);var usize out=0;var usize i=0;while(i<8){out=out*256+(wire[*at+i] as usize);i+=1;}*at+=8;return out;}
fn ref u8[] field(ref u8[] wire,ref mut usize at){let size=number(wire,at);assert(*at<=wire.len && size<=wire.len-*at);let start=*at;*at+=size;return wire[start..*at];}
@effects(filesystem)
fn bytes::Buffer fixture(){var u8[4096] path=[0;4096];let size=switch(process::arg(1,ref mut path)){case .ok(value):{value}case .err(_):{assert(false);0}};let ref u8[] view=ref path;let name=switch(text::validate_utf8(view[..size])){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var fs::File file=switch(fs::open_read_utf8(name)){case .ok(value):{value}case .err(_):{assert(false);return bytes::empty();}};var bytes::Buffer out=bytes::empty();assert(bytes::resize_zeroed(ref mut out,131073).is_ok);var usize used=0;while(true){let n=switch(fs::read(ref mut file,bytes::view_mut(ref mut out)[used..])){case .ok(value):{value}case .err(_):{assert(false);return out;}};used+=n;assert(used<=131072);if(n==0){break;}}assert(fs::close(file).is_ok && bytes::truncate(ref mut out,used).is_ok);return out;}
fn coordinates::Coordinates table(usize shift,bool changed,bool missing){var bytes::Buffer names=bytes::empty();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var usize digit=1;while(digit<=3 && !missing){let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut names,if(changed && digit==1){52}else if(digit==1){49}else if(digit==2){50}else{51}).is_ok);i+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=digit+shift,.start,.end=bytes::len(ref names)}).is_ok);digit+=1;}return coordinates::assemble(names,rows);}

fn input::Input prepared(ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<modules::Binding> imports,ref coordinates::Coordinates coords){var context::Budget budget=context::empty();let packages=switch(bindings::build(sources,owners,imports,coords,ref mut budget.work)){case .ok(p):{p}case .err(_):{assert(false);return prepared(sources,owners,imports,coords);}};let catalog=switch(catalog::build(packages,sources,ref mut budget.work)){case .ok(p):{p}case .err(_):{assert(false);return prepared(sources,owners,imports,coords);}};let requests=switch(requests::build(catalog,sources,ref mut budget.work)){case .ok(p):{p}case .err(_):{assert(false);return prepared(sources,owners,imports,coords);}};return switch(input::build(requests,sources,ref mut budget)){case .ok(p):{p}case .err(_):{assert(false);return prepared(sources,owners,imports,coords);}};}
@effects(console)
fn void mismatch(ref u8[] label,locations::Location actual,usize module_index,usize start,usize end){discard io::write_stderr_bytes(label);discard io::write_stderr(" code ");discard io::write_stderr_u32(actual.code);discard io::write_stderr(" module ");discard io::write_stderr_usize(actual.module_index);discard io::write_stderr(" span ");discard io::write_stderr_usize(actual.start);discard io::write_stderr("..");discard io::write_stderr_usize(actual.end);discard io::write_stderr(" expected ");discard io::write_stderr_usize(module_index);discard io::write_stderr(" ");discard io::write_stderr_usize(start);discard io::write_stderr("..");discard io::write_stderr_usize(end);}
@test @effects(filesystem,console)
fn void actual_go_cycle_growth_and_sdk_type_request_locations_match(){let data=fixture();let wire=bytes::view(ref data);assert(bytes::equal(wire[..8],b"FYGRLOC1"));var usize cursor=8;assert(number(wire,ref mut cursor)==7);var usize index=0;while(index<7){let label=field(wire,ref mut cursor);let limits=plans::Limits{.total=number(wire,ref mut cursor),.per_template=number(wire,ref mut cursor),.depth=number(wire,ref mut cursor)};let count=number(wire,ref mut cursor);var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<modules::Binding> imports=v::empty<modules::Binding>();var usize m=0;
 while(m<count){assert(v::push<usize>(ref mut owners,number(wire,ref mut cursor)).is_ok && v::push<syntax::Parsed>(ref mut sources,parsed(field(wire,ref mut cursor))).is_ok);let n=number(wire,ref mut cursor);var usize b=0;while(b<n){let alias=field(wire,ref mut cursor);let p=v::at<syntax::Parsed>(ref sources,m);let d=syntax::declaration_at(p,b+1);assert(bytes::equal(alias,syntax::source_view(p)[d.name_start..d.name_end]));assert(v::push<modules::Binding>(ref mut imports,modules::Binding{.source=m,.declaration=b+2,.target=number(wire,ref mut cursor)}).is_ok);b+=1;}m+=1;}
 let expected_code=number(wire,ref mut cursor);let module_index=number(wire,ref mut cursor);let start=number(wire,ref mut cursor);let end=number(wire,ref mut cursor);let coords=table(0,false,false);let original=prepared(ref sources,ref owners,ref imports,ref coords);var usize work=0;let attempt=plans::attempt(original,limits,ref mut work);let failed=plans::problem(ref attempt);assert(failed.code as usize==expected_code && failed.root>0);let location=locations::find(plans::attempt_input(ref attempt),ref sources,failed.root,ref mut work);if(location.code!=0 || location.module_index!=module_index || location.start!=start || location.end!=end){mismatch(label,location,module_index,start,end);assert(false);}
 if(index<4){work=0;switch(project::build_sources(ref sources,ref owners,ref imports,ref coords,ref mut work)){case .ok(_):{assert(false);}case .err(e):{assert(e.stage==5 && e.code==2005 && e.module_index==module_index && e.start==start && e.end==end);}};}index+=1;
 }assert(cursor==wire.len);}
fn v::Vec<syntax::Parsed> simple_sources(bool changed){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(if(changed){b"module root;fn T cycle<T>(T x){return cycle<T>(x);}fn void use(){discard cycle<i32>(2);}"}else{b"module root;fn T cycle<T>(T x){return cycle<T>(x);}fn void use(){discard cycle<i32>(1);}"})).is_ok);return sources;}
fn plans::Attempt detached_attempt(){let sources=simple_sources(false);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,1).is_ok);let imports=v::empty<modules::Binding>();let coords=table(0,false,false);let original=prepared(ref sources,ref owners,ref imports,ref coords);var usize work=0;return plans::attempt(original,plans::defaults(),ref mut work);}
@test fn void failed_attempt_retains_exact_input_after_source_owners_close(){let attempt=detached_attempt();let failed=plans::problem(ref attempt);assert(failed.code==2005 && failed.root==1);let sources=simple_sources(false);var usize work=0;let location=locations::find(plans::attempt_input(ref attempt),ref sources,failed.root,ref mut work);assert(location.code==0 && location.module_index==0 && location.start==73 && location.end==83);}
@test fn void recovery_honors_shared_budget_and_rejects_stale_or_invalid_roots(){let attempt=detached_attempt();let sources=simple_sources(false);var usize required=0;let expected=locations::find(plans::attempt_input(ref attempt),ref sources,1,ref mut required);assert(expected.code==0 && required>0 && required<16777216);var usize work=16777216-required;let exact=locations::find(plans::attempt_input(ref attempt),ref sources,1,ref mut work);assert(exact.code==0 && exact.start==expected.start && exact.end==expected.end && work==16777216);work=16777217-required;assert(locations::find(plans::attempt_input(ref attempt),ref sources,1,ref mut work).code==10);work=16777217;assert(locations::find(plans::attempt_input(ref attempt),ref sources,1,ref mut work).code==10 && work==16777217);work=0;assert(locations::find(plans::attempt_input(ref attempt),ref sources,0,ref mut work).code==9);work=0;assert(locations::find(plans::attempt_input(ref attempt),ref sources,2,ref mut work).code==9);let changed=simple_sources(true);work=0;assert(locations::find(plans::attempt_input(ref attempt),ref changed,1,ref mut work).code==12);}
@test fn void successful_attempt_seals_the_same_complete_plan_without_extra_work(){var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;fn T id<T>(T x){return x;}fn void use(){discard id<i32>(42);}")).is_ok);var v::Vec<usize> owners=v::empty<usize>();assert(v::push<usize>(ref mut owners,1).is_ok);let imports=v::empty<modules::Binding>();let coords=table(0,false,false);let direct=prepared(ref sources,ref owners,ref imports,ref coords);let retained=prepared(ref sources,ref owners,ref imports,ref coords);var usize old_work=0;let old=switch(plans::build(direct,plans::defaults(),ref mut old_work)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize work=0;let attempt=plans::attempt(retained,plans::defaults(),ref mut work);assert(plans::problem(ref attempt).code==0 && work==old_work);let current=plans::seal(attempt);assert(plans::count(ref current)==plans::count(ref old) && plans::root_count(ref current)==1);let a=plans::at(ref old,plans::root_at(ref old,0)-1);let b=plans::at(ref current,plans::root_at(ref current,0)-1);assert(bytes::equal(plans::text(ref old,a.id),plans::text(ref current,b.id)));}
