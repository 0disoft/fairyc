module tests::module_inline_pipeline;
import project_compiler_core as core;
import module_project_identified_ir as checked;
import module_project_interfaces as interfaces;
import module_public_type_text as coordinates;
import module_catalog as catalog;
import module_unit_c_emit as c;
import module_project_complete_c as complete_c;
import module_unit_body_ir_model as ir;
import module_unit_cleanup_mir_model as clean;
import module_program_artifact_encode as encode;
import module_project_artifact_encode as project_encode;
import module_project_artifact_decode as project_decode;
import module_program_artifact_wire as framing;
import module_program_artifact_decode as decode;
import module_body_artifact_encode as body_encode;
import module_body_artifact_decode as body_decode;
import module_inline_identity as inline;
import candidate_artifact_wire as wire;
import syntax as syntax;
import scanner as scanner;
import std::bytes as bytes;
import std::vec as v;
import std::io as io;

fn syntax::Parsed parsed(ref u8[] raw){let b=switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);return parsed(raw);}};let stream=switch(scanner::collect(b,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(raw);}};return switch(syntax::parse(stream,512)){case .ok(p):{assert(syntax::problem_count(ref p)==0);p}case .err(_):{assert(false);parsed(raw)}};}
@effects(console) fn core::Complete compiled(){
    var v::Vec<syntax::Parsed> sources=v::empty<syntax::Parsed>();var v::Vec<usize> owners=v::empty<usize>();var v::Vec<catalog::Binding> imports=v::empty<catalog::Binding>();var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();var bytes::Buffer names=bytes::empty();
    assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module root;import helper as h;fn i32 pick(ref mut i32 n){*n+=1;return *n;}fn i32 main(){var i32 n=0;assert(h::mix(pick(ref mut n),pick(ref mut n),pick(ref mut n),pick(ref mut n))==1234);assert(n==4);assert(h::add(40)==42);assert(h::minimum()==-2147483648);assert(h::divide(10,2)==5);return 23;}")).is_ok);
    assert(v::push<syntax::Parsed>(ref mut sources,parsed(b"module helper;@inline pub fn i32 mix(i32 a,i32 b,i32 c,i32 d){return a*1000+b*100+c*10+d;}@inline pub fn i32 add(i32 x){return x+2;}@inline pub fn i32 minimum(){return -2147483648;}@inline pub fn i32 divide(i32 a,i32 b){return a/b;}pub fn i32 ordinary(i32 x){return x+2;}")).is_ok);
    var usize i=0;while(i<2){assert(v::push<usize>(ref mut owners,i).is_ok);let start=bytes::len(ref names);assert(bytes::append(ref mut names,b"fypc1-sha256-").is_ok);var usize j=0;while(j<64){assert(bytes::append(ref mut names,if(i==0){b"1"}else{b"2"}).is_ok);j+=1;}assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=i,.start,.end=bytes::len(ref names)}).is_ok);i+=1;}
    assert(v::push<catalog::Binding>(ref mut imports,catalog::Binding{.source=0,.declaration=2,.target=1}).is_ok);let table=coordinates::assemble(names,rows);var usize work=0;var usize linking=0;
    return switch(core::build_complete_sources(ref sources,ref owners,ref imports,ref table,ref mut work,ref mut linking)){case .ok(p):{restore_checked(ref p,ref sources,ref owners,ref imports,ref table);p}case .err(e):{discard io::write_stderr_u32(e.phase);discard io::write_stderr_u32(e.stage);discard io::write_stderr_u32(e.code);discard io::write_stderr_usize(e.start);assert(false);compiled()}};
}

fn wire::Payload alter_program(ref u8[] raw,usize target,bool remove,u32[8] hash){var usize work=0;var c=switch(framing::cursor(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return alter_program(raw,target,remove,hash);}};var framing::Status status=framing::Status{.code=0};var out=framing::writer(ref mut status,ref mut work);var usize i=0;
    while(i<4){let magic=if(i==0){b"FYCLEAN0"}else if(i==1){b"FYSDK000"}else if(i==2){b"FYMETA00"}else{b"FYSTATE0"};let part=framing::member_from(raw,ref mut c,8388608,magic,ref mut work);framing::member(ref mut out,raw[part.start..part.end],ref mut status,ref mut work);i+=1;}let count=framing::bodies_from(raw,ref mut c,ref mut work);framing::number(ref mut out,count,ref mut status,ref mut work);i=1;
    while(i<=count){let part=framing::member_from(raw,ref mut c,16777216,b"FYBODY00",ref mut work);let body=raw[part.start..part.end];if(i==target){if(remove){assert(body.len>=64);framing::member(ref mut out,body[..body.len-64],ref mut status,ref mut work);}else{var bytes::Buffer changed=switch(bytes::copy(body)){case .ok(p):{p}case .err(_):{assert(false);return alter_program(raw,target,remove,hash);}};var usize j=0;while(j<8){framing::number(ref mut changed,hash[j] as usize,ref mut status,ref mut work);j+=1;}framing::member(ref mut out,bytes::view(ref changed),ref mut status,ref mut work);}}else{framing::member(ref mut out,body,ref mut status,ref mut work);}i+=1;}assert(framing::end(raw,ref mut c,ref mut work)==0);return switch(framing::finish(out,status)){case .ok(p):{p}case .err(_):{assert(false);alter_program(raw,target,remove,hash)}};
}
fn wire::Payload altered(ref u8[] raw,usize target,bool remove,u32[8] hash){var usize work=0;var c=switch(framing::cursor_marker(raw,b"FYPRJ000",ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return altered(raw,target,remove,hash);}};let program=framing::member_from(raw,ref mut c,framing::byte_limit(),b"FYPROG00",ref mut work);let body=alter_program(raw[program.start..program.end],target,remove,hash);var framing::Status status=framing::Status{.code=0};var out=framing::writer_marker(b"FYPRJ000",ref mut status,ref mut work);framing::member(ref mut out,wire::content(ref body),ref mut status,ref mut work);let stamps=framing::member_from(raw,ref mut c,8388608,b"FYPROV00",ref mut work);framing::member(ref mut out,raw[stamps.start..stamps.end],ref mut status,ref mut work);let ids=framing::member_from(raw,ref mut c,8388608,b"FYIDS000",ref mut work);framing::member(ref mut out,raw[ids.start..ids.end],ref mut status,ref mut work);assert(framing::end(raw,ref mut c,ref mut work)==0);return switch(framing::finish(out,status)){case .ok(p):{p}case .err(_):{assert(false);altered(raw,target,remove,hash)}};}
fn void restore_checked(ref core::Complete current,ref v::Vec<syntax::Parsed> sources,ref v::Vec<usize> owners,ref v::Vec<catalog::Binding> imports,ref coordinates::Coordinates table){var usize work=0;let encoded=switch(project_encode::encode(core::checked_program(current),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let raw=wire::content(ref encoded);work=0;let saved=switch(project_decode::decode(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize source_work=0;var usize artifact_work=0;var usize link_work=0;let restored=switch(core::restore_complete_sources(saved,sources,owners,imports,table,ref mut source_work,ref mut artifact_work,ref mut link_work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(inline::equal(interfaces::inline_hash(interfaces::at(core::public_interfaces(current),1)),interfaces::inline_hash(interfaces::at(core::public_interfaces(ref restored),1))));
    let p=checked::ir_program(core::checked_program(current));var usize marked=0;var usize ordinary=0;var u32[8] hash=[0;8];var usize i=1;while(i<=ir::count(p)){let frame=clean::frame_at(ir::cleanup_ir(p),i);if(frame.module_index==1 && frame.declaration==3){marked=i;hash=ir::inline_hash(ir::at(p,i));}if(frame.module_index==1 && frame.declaration==6){ordinary=i;}i+=1;}assert(marked!=0 && ordinary!=0 && !inline::zero(hash));i=0;while(i<2){let bad=altered(raw,if(i==0){marked}else{ordinary},i==0,hash);work=0;let saved=switch(project_decode::decode(wire::content(ref bad),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};source_work=0;artifact_work=0;link_work=0;assert(switch(core::restore_complete_sources(saved,sources,owners,imports,table,ref mut source_work,ref mut artifact_work,ref mut link_work)){case .ok(_):{false}case .err(e):{e.phase==7}});i+=1;}
}

@effects(console) fn void member(ref u8[] raw){assert(io::write_usize(raw.len).is_ok && io::write("\n").is_ok && io::write_bytes(raw).is_ok);}
@test @effects(console) fn void inline_roundtrip_and_partition(){
    let result=compiled();let program=checked::ir_program(core::checked_program(ref result));let records=core::public_interfaces(ref result);assert(interfaces::count(records)==2 && inline::zero(interfaces::inline_hash(interfaces::at(records,0))) && !inline::zero(interfaces::inline_hash(interfaces::at(records,1))));var usize entry=0;var usize i=1;var usize marked=0;
    while(i<=ir::count(program)){let frame=clean::frame_at(ir::cleanup_ir(program),i);if(frame.module_index==0 && frame.declaration==4){entry=i;}if(!inline::zero(ir::inline_hash(ir::at(program,i)))){marked+=1;var usize work=0;let encoded=switch(body_encode::encode(program,i,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let raw=wire::content(ref encoded);work=0;let restored=switch(body_decode::decode(raw,ir::cleanup_ir(program),i,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(inline::equal(ir::inline_hash(ref restored),ir::inline_hash(ir::at(program,i))));var bytes::Buffer bad=switch(bytes::copy(raw)){case .ok(p):{p}case .err(_):{assert(false);return;}};let at=bytes::len(ref bad)-1;let previous=bytes::view(ref bad)[at];bytes::view_mut(ref mut bad)[at]=previous^1;work=0;assert(switch(body_decode::decode(bytes::view(ref bad),ir::cleanup_ir(program),i,ref mut work)){case .ok(_):{false}case .err(_):{true}});}i+=1;}assert(entry!=0 && marked==4);
    var usize work=0;let packet=switch(encode::encode(program,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};work=0;let restored=switch(decode::decode(wire::content(ref packet),ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};i=1;while(i<=ir::count(program)){assert(inline::equal(ir::inline_hash(ir::at(program,i)),ir::inline_hash(ir::at(ref restored,i))));i+=1;}
    let bundle=switch(complete_c::partition_entry(result,entry,1)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.code);assert(false);return;}};assert(io::write("FYCPARTS1\n").is_ok);member(c::project_header(ref bundle));member(c::project_literals(ref bundle));assert(io::write_usize(c::project_unit_count(ref bundle)).is_ok && io::write("\n").is_ok);i=0;while(i<c::project_unit_count(ref bundle)){member(c::project_source(ref bundle,i));i+=1;}
}
