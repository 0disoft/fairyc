module tests::project_cache_disk;
import project_cache_disk as disk;
import windows_rooted_file as rooted;
import file_source as files;
import std::bytes as bytes;
import std::text as text;
import std::fs as fs;
import std::process as process;
import std::io as io;

fn bytes::Buffer path(ref u8[] root,ref u8[] leaf){var p=bytes::empty();assert(bytes::append(ref mut p,root).is_ok && bytes::append_byte(ref mut p,47).is_ok && bytes::append(ref mut p,leaf).is_ok);return p;}
fn text::CString cstr(ref u8[] raw){let p=switch(text::validate_utf8(raw)){case .ok(p):{p}case .err(_):{assert(false);return cstr(raw);}};return switch(text::cstring_from_text(p)){case .ok(p):{p}case .err(_):{assert(false);cstr(raw)}};}
@effects(filesystem) fn bytes::Buffer base(){var u8[4096] raw=[0;4096];let n=switch(process::arg(1,ref mut raw)){case .ok(p):{p}case .err(_):{assert(false);0}};let ref u8[] p=ref raw;return switch(files::manifest(p[..n])){case .ok(p):{p}case .err(_):{assert(false);bytes::empty()}};}
@effects(filesystem) fn void mkdir(ref u8[] p){let s=cstr(p);assert(fs::create_dir(text::cstring_as_cstr(ref s)).is_ok);}
@effects(filesystem) fn void rmdir(ref u8[] p){let s=cstr(p);assert(fs::remove_dir(text::cstring_as_cstr(ref s)).is_ok);}
@effects(console) fn void problem(disk::Problem e){discard io::write_stderr_u32(e.kind);discard io::write_stderr("/");discard io::write_stderr_u32(e.stage);discard io::write_stderr("/");discard io::write_stderr_u32(e.os_code);assert(false);}
fn disk::Limits policy(usize entries,usize total,usize record){return disk::Limits{.entries,.bytes=total,.record,.temporary_age=1};}
fn bytes::Buffer route(u8 digit){var p=bytes::empty();assert(bytes::append(ref mut p,b"fylookup0-sha256-").is_ok);var usize i=0;while(i<64){assert(bytes::append_byte(ref mut p,digit).is_ok);i+=1;}return p;}
@effects(filesystem,console) fn disk::Store open(ref u8[] p,disk::Limits limits){return switch(disk::open(p,limits)){case .ok(p):{p}case .err(e):{problem(e);return open(p,limits);}};}
@effects(filesystem,clock,console) fn disk::Stats put(ref disk::Store p,ref u8[] key,ref u8[] raw){var usize work=0;var usize scan=0;return switch(disk::put(p,key,raw,ref mut work,ref mut scan)){case .ok(p):{p}case .err(e):{problem(e);return put(p,key,raw);}};}
@effects(filesystem,console) fn bytes::Buffer load(ref disk::Store p,ref u8[] key){var usize work=0;var usize scan=0;return switch(disk::load(p,key,ref mut work,ref mut scan)){case .ok(p):{p}case .err(e):{problem(e);return load(p,key);}};}
@effects(filesystem,console) fn rooted::Directory directory(ref u8[] p){return switch(rooted::open(p)){case .ok(p):{p}case .err(_):{assert(false);directory(p)}};}
@effects(filesystem) fn void raw_save(ref rooted::Directory root,ref u8[] name,ref u8[] raw){var file=switch(rooted::create_new(root,b".raw-stage")){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(rooted::write_all(ref mut file,raw).is_ok);assert(rooted::sync(ref mut file).is_ok);assert(rooted::publish(root,ref mut file,name).is_ok);assert(rooted::sync(ref mut file).is_ok);assert(rooted::close(file).is_ok);}
@effects(filesystem) fn bytes::Buffer raw_read(ref rooted::Directory root,ref u8[] name){var file=switch(rooted::open_read(root,name)){case .ok(p):{p}case .err(_):{assert(false);return raw_read(root,name);}};let size=switch(rooted::size(ref file)){case .ok(p):{p}case .err(_):{assert(false);0}};var out=bytes::empty();assert(size<=20 && bytes::resize_zeroed(ref mut out,size).is_ok);let used=switch(rooted::read(ref mut file,bytes::view_mut(ref mut out))){case .ok(p):{p}case .err(_):{assert(false);0}};assert(used==size);assert(rooted::close(file).is_ok);return out;}
@effects(filesystem,console) fn void clean(ref u8[] p){{let root=directory(p);var usize work=0;let entries=switch(rooted::scan(ref root,4096,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};var usize i=0;while(i<rooted::count(ref entries)){assert(switch(rooted::erase_if(ref root,rooted::name(ref entries,i),rooted::metadata(ref entries,i))){case .ok(done):{done}case .err(_):{false}});i+=1;}}rmdir(p);}
fn bytes::Buffer generation(ref u8[] key,ref u8[] raw){var usize work=0;return switch(disk::generation(key,raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);bytes::empty()}};}
fn bytes::Buffer temporary(ref u8[] name,usize attempt){var p=bytes::empty();assert(bytes::append(ref mut p,b".stage").is_ok && bytes::append(ref mut p,name).is_ok && bytes::append_byte(ref mut p,45).is_ok && bytes::append_usize(ref mut p,attempt).is_ok);return p;}
fn void hash(ref u8[] raw,ref u8[] expected){var usize work=0;let actual=switch(disk::digest(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(bytes::equal(bytes::view(ref actual),expected));}
@test fn void content_hash_matches_independent_padding_vectors_and_exact_work(){
    hash(b"",b"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");hash(b"abc",b"ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");var u8[64] zeros=[0;64];let ref u8[] raw=ref zeros;hash(raw[..55],b"02779466cdec163811d078815c633f21901413081449002f24aa3e80f0b88ef7");hash(raw[..56],b"d4817aa5497628e7c77e6b606107042bbba3130888c5f47a375e6179be789fbb");hash(raw,b"f5a5fd42d16a20302798ef6ed309979b43003d2320d9f0e8ea9831a92759fb4b");var usize used=0;assert(disk::digest(raw,ref mut used).is_ok);var usize exact=disk::work_limit()-used;assert(disk::digest(raw,ref mut exact).is_ok && exact==disk::work_limit());exact=disk::work_limit()-used+1;assert(switch(disk::digest(raw,ref mut exact)){case .ok(_):{false}case .err(e):{e.kind==9}});assert(!disk::valid_limits(policy(0,8,8)) && !disk::valid_limits(policy(1,8,9)) && !disk::valid_route(b"../escape"));
}
@test @effects(filesystem,clock,console) fn void immutable_binary_generations_round_trip_and_preserve_collision_metadata(){
    let b=base();let p=path(bytes::view(ref b),b"cache-binary");mkdir(bytes::view(ref p));let key=route(97);var raw=bytes::empty();assert(bytes::resize_zeroed(ref mut raw,131073).is_ok);{let view=bytes::view_mut(ref mut raw);var usize i=0;let prefix=b"FYCACHE0";while(i<8){view[i]=prefix[i];i+=1;}view[65536]=42;view[131072]=255;}hash(bytes::view(ref raw),b"fb520ef494cfccbf7d0c20538ca75005fee3ab6cf7833c7686e79781c05a61f2");
    {let store=open(bytes::view(ref p),policy(2,262146,131073));let first=put(ref store,bytes::view(ref key),bytes::view(ref raw));assert(first.entries==1 && first.bytes==131073);let old=directory(bytes::view(ref p));var usize work=0;let before=switch(rooted::scan(ref old,2,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let info=rooted::metadata(ref before,0);let second=put(ref store,bytes::view(ref key),bytes::view(ref raw));assert(second.entries==1 && second.evicted==0);work=0;let after=switch(rooted::scan(ref old,2,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let current=rooted::metadata(ref after,0);assert(info.identity==current.identity && info.modified==current.modified && info.size==current.size);let loaded=load(ref store,bytes::view(ref key));assert(bytes::equal(bytes::view(ref loaded),bytes::view(ref raw)));}
    {let reopened=open(bytes::view(ref p),policy(2,262146,131073));let loaded=load(ref reopened,bytes::view(ref key));assert(bytes::equal(bytes::view(ref loaded),bytes::view(ref raw)));}clean(bytes::view(ref p));
}
@test @effects(filesystem,clock,console) fn void corruption_is_skipped_and_exact_observed_collision_is_repaired(){
    let b=base();let p=path(bytes::view(ref b),b"cache-corrupt");mkdir(bytes::view(ref p));let key=route(98);let name=generation(bytes::view(ref key),b"FYCACHE0old");
    {let store=open(bytes::view(ref p),policy(4,80,20));discard put(ref store,bytes::view(ref key),b"FYCACHE0old");discard put(ref store,bytes::view(ref key),b"FYCACHE0new");let root=directory(bytes::view(ref p));raw_save(ref root,bytes::view(ref name),b"FYCACHE0bad");let loaded=load(ref store,bytes::view(ref key));assert(bytes::equal(bytes::view(ref loaded),b"FYCACHE0new"));let bad=raw_read(ref root,bytes::view(ref name));assert(bytes::equal(bytes::view(ref bad),b"FYCACHE0bad"));assert(put(ref store,bytes::view(ref key),b"FYCACHE0old").entries==2);let actual=raw_read(ref root,bytes::view(ref name));assert(bytes::equal(bytes::view(ref actual),b"FYCACHE0old"));let wrong=route(99);var usize work=0;var usize scan=0;assert(switch(disk::load(ref store,bytes::view(ref wrong),ref mut work,ref mut scan)){case .ok(_):{false}case .err(e):{e.kind==2}});}
    clean(bytes::view(ref p));
}
@test @effects(filesystem,clock,console) fn void retention_enforces_exact_entry_byte_limits_and_preserves_data_on_early_failure(){
    let b=base();let p=path(bytes::view(ref b),b"cache-retention");mkdir(bytes::view(ref p));let a=route(97);let bkey=route(98);let c=route(99);
    {let store=open(bytes::view(ref p),policy(2,22,12));assert(put(ref store,bytes::view(ref a),b"FYCACHE0aaa").entries==1);assert(put(ref store,bytes::view(ref bkey),b"FYCACHE0bbb").bytes==22);let third=put(ref store,bytes::view(ref c),b"FYCACHE0cccc");assert(third.entries==1 && third.bytes==12 && third.evicted==2);var usize work=0;var usize scan=0;assert(switch(disk::put(ref store,bytes::view(ref c),b"FYCACHE0extra",ref mut work,ref mut scan)){case .ok(_):{false}case .err(e):{e.kind==9}});work=disk::work_limit()+1;assert(switch(disk::put(ref store,bytes::view(ref c),b"FYCACHE0cccc",ref mut work,ref mut scan)){case .ok(_):{false}case .err(e):{e.kind==9}});let kept=load(ref store,bytes::view(ref c));assert(bytes::equal(bytes::view(ref kept),b"FYCACHE0cccc"));}
    {let store=open(bytes::view(ref p),policy(1,22,12));let next=put(ref store,bytes::view(ref a),b"FYCACHE0aaa");assert(next.entries==1 && next.evicted==1);let kept=load(ref store,bytes::view(ref a));assert(bytes::equal(bytes::view(ref kept),b"FYCACHE0aaa"));}clean(bytes::view(ref p));
}
@test @effects(filesystem,clock,console) fn void orphan_recovery_skips_live_stage_and_publication_failure_preserves_previous_bytes(){
    let b=base();let p=path(bytes::view(ref b),b"cache-stage");mkdir(bytes::view(ref p));let key=route(100);let name=generation(bytes::view(ref key),b"FYCACHE0kept");let zero=temporary(bytes::view(ref name),0);let orphan=temporary(bytes::view(ref name),15);
    {let store=open(bytes::view(ref p),policy(8,160,20));let root=directory(bytes::view(ref p));var active=switch(rooted::create_new(ref root,bytes::view(ref zero))){case .ok(p):{p}case .err(_):{assert(false);return;}};raw_save(ref root,bytes::view(ref orphan),b"orphan");let saved=put(ref store,bytes::view(ref key),b"FYCACHE0kept");assert(saved.entries==2 && saved.evicted==1);assert(rooted::close(active).is_ok);let bad=generation(bytes::view(ref key),b"FYCACHE0next");var blocked=switch(rooted::create_new(ref root,bytes::view(ref bad))){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(rooted::write_all(ref mut blocked,b"block").is_ok);assert(rooted::sync(ref mut blocked).is_ok);var usize work=0;var usize scan=0;assert(!disk::put(ref store,bytes::view(ref key),b"FYCACHE0next",ref mut work,ref mut scan).is_ok);let kept=load(ref store,bytes::view(ref key));assert(bytes::equal(bytes::view(ref kept),b"FYCACHE0kept"));assert(switch(rooted::size(ref blocked)){case .ok(n):{n==5}case .err(_):{false}});assert(rooted::close(blocked).is_ok);}
    clean(bytes::view(ref p));
}
