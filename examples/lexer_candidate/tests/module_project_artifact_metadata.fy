fn syntax::Parsed parsed(ref u8[] text){let raw=switch(bytes::copy(text)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let tokens=switch(scanner::collect(raw,false,65536,1048576,256,16777216)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};let p=switch(syntax::parse(tokens,512)){case .ok(p):{p}case .err(_):{assert(false);return parsed(b"module empty;");}};assert(syntax::problem_count(ref p)==0);return p;}
fn v::Vec<syntax::Parsed> source(ref u8[] text){var v::Vec<syntax::Parsed> p=v::empty<syntax::Parsed>();assert(v::push<syntax::Parsed>(ref mut p,parsed(text)).is_ok);return p;}
fn v::Vec<usize> owners(ref v::Vec<syntax::Parsed> sources){var v::Vec<usize> p=v::empty<usize>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){assert(v::push<usize>(ref mut p,1).is_ok);i+=1;}return p;}
fn v::Vec<catalog::Binding> imports(ref v::Vec<syntax::Parsed> sources){let base=switch(catalog::build(sources)){case .ok(p):{p}case .err(_):{assert(false);return imports(sources);}};var v::Vec<catalog::Binding> rows=v::empty<catalog::Binding>();var usize i=0;while(i<v::len<syntax::Parsed>(sources)){let p=v::at<syntax::Parsed>(sources,i);var usize j=0;while(j<syntax::declaration_count(p)){let d=syntax::declaration_at(p,j);if(d.kind==2){var usize measured=0;let target=catalog::import_target_measured(ref base,i,syntax::source_view(p)[d.name_start..d.name_end],ref mut measured);assert(target.code==0 && target.item>0);assert(v::push<catalog::Binding>(ref mut rows,catalog::Binding{.source=i,.declaration=j+1,.target=target.item-1}).is_ok);}j+=1;}i+=1;}return rows;}

fn coordinates::Coordinates table(){let name=switch(bytes::copy(b"fypc1-sha256-aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")){case .ok(p):{p}case .err(_):{assert(false);return table();}};var v::Vec<coordinates::Coordinate> rows=v::empty<coordinates::Coordinate>();assert(v::push<coordinates::Coordinate>(ref mut rows,coordinates::Coordinate{.owner=1,.start=0,.end=bytes::len(ref name)}).is_ok);return coordinates::assemble(name,rows);}
fn signatures::Program get_metadata(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let catalog=switch(catalog::build_scoped(sources,ref owner,ref imports)){case .ok(p):{p}case .err(_):{assert(false);return get_metadata(sources);}};return switch(signatures::build_catalog(sources,catalog)){case .ok(p):{p}case .err(_):{assert(false);get_metadata(sources)}};}
@effects(console) fn compile::CheckedBodies get_checked(ref v::Vec<syntax::Parsed> sources,ref signatures::Program metadata,usize first,usize stop){return switch(compile::check_range(sources,metadata,first,stop)){case .ok(p):{p}case .err(e):{discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);get_checked(sources,metadata,first,stop)}};}
@effects(console) fn core::Complete compiled(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let table=table();var usize work=0;var usize linked=0;return switch(core::build_complete_sources(sources,ref owner,ref imports,ref table,ref mut work,ref mut linked)){case .ok(p):{p}case .err(e):{discard io::write_stderr("compiled ");discard io::write_stderr_u32(e.stage);discard io::write_stderr(" ");discard io::write_stderr_u32(e.code);assert(false);compiled(sources)}};}
@effects(console) fn identities::Snapshot snapshot(ref identified::Program program){var usize work=0;return switch(identities::extract(identified::source_identities(program),ir::cleanup_ir(identified::ir_program(program)),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("snapshot ");discard io::write_stderr_u32(code);assert(false);snapshot(program)}};}
@effects(console) fn planned::Plan source_plan(ref v::Vec<syntax::Parsed> sources){let owner=owners(sources);let imports=imports(sources);let table=table();var usize work=0;return switch(planning::build_sources(sources,ref owner,ref imports,ref table,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);source_plan(sources)}};}
@effects(console) fn wire::Payload encoded(ref ir::Program p){var usize work=0;return switch(encoder::encode(p,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("encoded ");discard io::write_stderr_u32(code);assert(false);encoded(p)}};}
@effects(console) fn ir::Program restored(ref u8[] raw){var usize work=0;return switch(decoder::decode(raw,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("restored ");discard io::write_stderr_u32(code);assert(false);restored(raw)}};}
fn void number(ref mut bytes::Buffer raw,usize at,usize input){assert(at+8<=bytes::len(raw));var bytes::Buffer octets=bytes::empty();var budget::Status status=budget::Status{.code=0};var usize work=0;budget::number(ref mut octets,input,ref mut status,ref mut work);assert(status.code==0 && bytes::len(ref octets)==8);var usize i=0;while(i<8){bytes::view_mut(raw)[at+i]=bytes::view(ref octets)[i];i+=1;}}
fn v::Vec<syntax::Parsed> inputs(){var p=source(b"module main;import provider as p;struct Pair{i32 n;bool flag;}enum Tag{Empty;Data{i32 a;bool b;};}@repr(C)struct Wire{i32 code;}fn i32 ignore(Pair p,Tag t,Wire w){return 42;}@must_use fn i32 annotated(){return 7;}fn i32 main(){discard annotated();return p::id<i32>(42);}");assert(v::push<syntax::Parsed>(ref mut p,parsed(b"module provider;pub fn T id<T>(T value){return value;}")).is_ok);return p;}

@effects(console) fn usize named_layout(ref ir::Program p,ref u8[] name){var usize i=0;while(i<ir::layout_count(p)){if(bytes::equal(ir::layout_name(p,i),name)){return i+1;}i+=1;}discard io::write_stderr_bytes(name);assert(false);return 0;}
@effects(console) fn usize named_callable(ref ir::Program p,ref v::Vec<syntax::Parsed> sources,ref u8[] name){var usize i=0;while(i<ir::callable_count(p)){let c=ir::callable_at(p,i);let parsed=v::at<syntax::Parsed>(sources,c.module_index);let d=syntax::declaration_at(parsed,c.declaration-1);if(bytes::equal(syntax::source_view(parsed)[d.name_start..d.name_end],name)){return i+1;}i+=1;}discard io::write_stderr_bytes(name);assert(false);return 0;}
struct Tables{budget::Span part;usize layouts;usize field_count_at;usize fields;usize callables;usize parameters;usize names;}
fn Tables tables(ref u8[] raw){var usize work=0;var c=switch(budget::cursor(raw,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return tables(raw);}};discard budget::member_from(raw,ref mut c,8388608,b"FYCLEAN0",ref mut work);discard budget::member_from(raw,ref mut c,8388608,b"FYSDK000",ref mut work);let part=budget::member_from(raw,ref mut c,8388608,b"FYMETA00",ref mut work);c.offset=part.start+24;let count=budget::number_from(raw,ref mut c,ref mut work);let layouts=c.offset;c.offset+=count*104;let field_count_at=c.offset;let fields_count=budget::number_from(raw,ref mut c,ref mut work);let fields=c.offset;c.offset+=fields_count*88;let callable_count=budget::number_from(raw,ref mut c,ref mut work);let callables=c.offset;c.offset+=callable_count*96;let parameter_count=budget::number_from(raw,ref mut c,ref mut work);let parameters=c.offset;c.offset+=parameter_count*8;let names_count=budget::number_from(raw,ref mut c,ref mut work);assert(c.code==0 && c.offset+names_count==part.end);return Tables{.part,.layouts,.field_count_at,.fields,.callables,.parameters,.names=c.offset};}
@test @effects(console) fn void source_metadata_matches_records_enum_payloads_templates_and_unused_contracts(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let payload=encoded(identified::ir_program(named));let program=restored(wire::content(ref payload));let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,v::len<syntax::Parsed>(ref sources));let plan=source_plan(ref sources);var usize work=0;let map=switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let pair=named_layout(ref program,b"Pair");let tag=named_layout(ref program,b"Tag");let foreign=named_layout(ref program,b"Wire");let c=named_callable(ref program,ref sources,b"id");assert(ir::layout_at(ref program,pair-1).value.field_count==2 && ir::layout_at(ref program,foreign-1).value.repr_c && ir::layout_at(ref program,tag-1).value.field_count==4 && ir::callable_at(ref program,c-1).template);assert(matching::layout_count(ref map)==ir::layout_count(ref program) && matching::callable_count(ref map)==ir::callable_count(ref program) && mapping::unit_count(matching::frame_mapping(ref map))==values::count(compile::checked_values(ref checked)));}
@test @effects(console) fn void structurally_valid_metadata_mutations_reject_after_recipe_comparison(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let original=identified::ir_program(named);let payload=encoded(original);let raw=wire::content(ref payload);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,v::len<syntax::Parsed>(ref sources));let plan=source_plan(ref sources);let table=tables(raw);let pair=named_layout(original,b"Pair");let s=ir::layout_at(original,pair-1);let field=ir::field_at(original,s.value.field_start+1);let template=named_callable(original,ref sources,b"id");assert(ir::callable_at(original,template-1).template);var u32 mode=0;
    while(mode<9){var bytes::Buffer changed=fixture::copied(raw);let position=table.layouts+(pair-1)*104;
        if(mode==0){number(ref mut changed,position+48,1);}
        else if(mode==1){number(ref mut changed,position+64,s.value.end-1);}
        else if(mode==2){bytes::view_mut(ref mut changed)[table.names+s.name_start]=88;}
        else if(mode==3){number(ref mut changed,table.fields+(s.value.field_start+1)*88+8,ir::field_at(original,s.value.field_start).type);}
        else if(mode==4){bytes::view_mut(ref mut changed)[table.names+field.name_start]=120;}
        else if(mode==5){number(ref mut changed,table.callables+(template-1)*96+56,1);}
        else if(mode==6){number(ref mut changed,table.callables+(template-1)*96+64,1);}
        else if(mode==7){number(ref mut changed,table.callables+(template-1)*96+48,1);}
        else{changed=bytes::empty();assert(bytes::append(ref mut changed,raw[..table.field_count_at]).is_ok && bytes::append(ref mut changed,raw[position..position+104]).is_ok && bytes::append(ref mut changed,raw[table.field_count_at..]).is_ok);number(ref mut changed,table.part.start+24,ir::layout_count(original)+1);number(ref mut changed,table.part.start-8,table.part.end-table.part.start+104);}
        var usize decoded_work=0;let program=switch(decoder::decode(bytes::view(ref changed),ref mut decoded_work)){case .ok(p):{p}case .err(code):{discard io::write_stderr("mutation ");discard io::write_stderr_u32(mode);discard io::write_stderr(" ");discard io::write_stderr_u32(code);assert(false);return;}};var usize work=0;assert(switch(matching_recipes::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{true}case .err(code):{discard io::write_stderr("prior ");discard io::write_stderr_u32(mode);discard io::write_stderr(" ");discard io::write_stderr_u32(code);false}});work=0;assert(switch(matching::match(ref program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}} && work>0);mode+=1;
    }
}
@test @effects(console) fn void exact_exhausted_invalid_and_stale_metadata_checks_publish_no_partial_map(){let sources=inputs();let owned=compiled(ref sources);let named=core::checked_program(ref owned);let program=identified::ir_program(named);let ids=snapshot(named);let metadata=get_metadata(ref sources);let checked=get_checked(ref sources,ref metadata,0,v::len<syntax::Parsed>(ref sources));let plan=source_plan(ref sources);var usize work=0;let normal=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};let required=work;work=budget::work_limit()-required;let exact=switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(p):{p}case .err(_):{assert(false);return;}};assert(work==budget::work_limit() && mapping::unit_count(matching::frame_mapping(ref normal))==mapping::unit_count(matching::frame_mapping(ref exact)));work=budget::work_limit()-required+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}});work=budget::work_limit()+1;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref sources,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1002}} && work==budget::work_limit()+1);let changed=source(b"module main;fn i32 main(){return 42;}");work=0;assert(switch(matching::match(program,ref ids,compile::checked_state(ref checked),ref plan,ref changed,ref metadata,ref mut work)){case .ok(_):{false}case .err(code):{code==1001}});}
@test @effects(filesystem,console) fn void rebased_generic_vec_state_metadata_match_each_source_unit(){let packet=fixture::packet();let sources=fixture::current(1);var usize work=0;let rebound=switch(current::build_sources(fixture::restored(wire::content(ref packet)),fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources),fixture::coordinate_table(ref sources),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let program=switch(rebase::build(ref rebound,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};work=0;let p=switch(mapping::build(ref program,current::source_identities(ref rebound),ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};
    let catalog=switch(catalog::build_scoped(fixture::sources(ref sources),fixture::owners(ref sources),fixture::imports(ref sources))){case .ok(p):{p}case .err(_):{assert(false);return;}};let metadata=switch(signatures::build_catalog(fixture::sources(ref sources),catalog)){case .ok(p):{p}case .err(_):{assert(false);return;}};var v::Vec<u8> covered=v::empty<u8>();var usize i=0;while(i<mapping::count(ref p)){assert(v::push<u8>(ref mut covered,0).is_ok);i+=1;}var usize unit=0;var usize cleanups=0;var usize specialized=0;var usize changed=0;
    while(unit<v::len<syntax::Parsed>(fixture::sources(ref sources))){let checked=get_checked(fixture::sources(ref sources),ref metadata,unit,unit+1);work=0;let ids=switch(matching::match(ref program,current::source_identities(ref rebound),compile::checked_state(ref checked),current::source_plan(ref rebound),fixture::sources(ref sources),ref metadata,ref mut work)){case .ok(p):{p}case .err(code):{discard io::write_stderr_u32(code);assert(false);return;}};let typed=compile::checked_values(ref checked);assert(matching::layout_count(ref ids)==interfaces::shape_count(compile::checked_interfaces(ref checked)) && matching::callable_count(ref ids)==interfaces::callable_count(compile::checked_interfaces(ref checked)));assert(mapping::unit_count(matching::frame_mapping(ref ids))==values::count(typed));i=0;while(i<values::count(typed)){let f=body::frame(values::at(typed,i));let target=mapping::mapped(matching::frame_mapping(ref ids),i+1);let saved=mapping::frame_at(ref p,target);if(f.kind==2){cleanups+=1;assert(saved.receiver!=0 && saved.receiver_type!=0);}if(f.kind==1){specialized+=1;}if(f.context!=saved.context){changed+=1;}let marked=v::at_mut<u8>(ref mut covered,target-1);*marked=1;i+=1;}unit+=1;
    }i=0;while(i<v::len<u8>(ref covered)){assert(*v::at<u8>(ref covered,i)==1);i+=1;}assert(unit>2 && cleanups>0 && specialized>0 && changed>0);
}
