  "contract": {
    "adr": "0471",
    "arrayLength": "1..4096",
    "element": "actual nonempty acyclic struct with scalar-only leaves; no arrays in its element graph",
    "valueOperations": [
      "explicit list/repeated construction",
      "independent whole-field reads and replacement",
      "copied-value indexing",
      "nested parent replacement",
      "copy through calls/returns/Option/outer arrays"
    ],
    "closed": [
      "repr(C) container fields",
      "resource/pointer/borrow/tagged elements",
      "nested arrays",
      "array-bearing element graph",
      "recursive element graph",
      "direct nominal-array field references/subviews/element mutation/for"
    ],
    "language": "fairyc-language/20",
    "sdk": "0.0.0-stage0.86",
