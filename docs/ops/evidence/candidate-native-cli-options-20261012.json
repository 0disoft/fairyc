    "passed": true,
    "source": "module main;\nimport native_cli_options as cli;\nimport std::bytes as bytes;\nimport std::vec as v;\nfn i32 main(){\n    let result=switch(cli::from_process(true)){case .ok(p):{p}case .err(_):{return 2;}};\n    assert(cli::locked(ref result) && cli::release(ref result));let args=cli::arguments(ref result);assert(v::len<bytes::Buffer>(args)==4);\n    assert(bytes::equal(bytes::view(v::at<bytes::Buffer>(args,0)),b\"plain\") && bytes::len(v::at<bytes::Buffer>(args,1))==0 && bytes::equal(bytes::view(v::at<bytes::Buffer>(args,2)),b\"\\xed\\x95\\x9c\\xea\\xb8\\x80\\xf0\\x9f\\xa7\\x9a\"));\n    let last=bytes::view(v::at<bytes::Buffer>(args,3));assert(last.len==8192);var usize i=0;while(i<last.len){assert(last[i]==120);i+=1;}return 0;\n}\n",
